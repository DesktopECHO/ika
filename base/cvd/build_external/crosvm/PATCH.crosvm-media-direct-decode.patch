+/// A frame in `layout` backed by DMA-BUF `fd`, for the decoder to import.
+fn direct_output_frame(fd: OwnedFd, layout: &DirectOutputLayout) -> DmabufFrame {
+    DmabufFrame {
+        fds: vec![fd],
+        layout: FrameLayout {
+            format: (cros_codecs::Fourcc::from(b"NV12"), layout.modifier),
+            size: cros_codecs::Resolution::from((layout.width, layout.height)),
+            planes: vec![
+                PlaneLayout {
+                    buffer_index: 0,
+                    offset: 0,
+                    stride: layout.stride as usize,
+                },
+                PlaneLayout {
+                    buffer_index: 0,
+                    offset: layout.chroma_offset as usize,
+                    stride: layout.stride as usize,
+                },
+            ],
+        },
+    }
+}
