+/// V4L2 pixel format of CAPTURE buffers the backend decodes into directly, private to Ika and its
+/// guest: NV12 in Intel Y tiles, laid out as `DirectOutputLayout` says, with `bytesperline` the
+/// stride and the chroma plane at `bytesperline` times the height rounded up to 32 rows.
+const PIX_FMT_NV12_Y_TILED: &[u8; 4] = b"IKYT";
+/// The same in swizzled tiles: rows `y` and `y ^ 4` of every odd 16-byte column swapped.
+const PIX_FMT_NV12_Y_TILED_SWIZZLED: &[u8; 4] = b"IKYS";
+
+/// Whether `pixelformat` is either of the formats above. The guest asks for either, and gets the
+/// one the stream is decoded in.
+fn is_direct_output_format(pixelformat: u32) -> bool {
+    [PIX_FMT_NV12_Y_TILED, PIX_FMT_NV12_Y_TILED_SWIZZLED]
+        .iter()
+        .any(|fourcc| PixelFormat::from_fourcc(fourcc).to_u32() == pixelformat)
+}
+
+/// The CAPTURE format of buffers in `layout`.
+fn direct_output_format(layout: &DirectOutputLayout) -> V4l2MplaneFormat {
+    let mut plane_fmt: [bindings::v4l2_plane_pix_format; bindings::VIDEO_MAX_PLANES as usize] =
+        Default::default();
+    plane_fmt[0] = bindings::v4l2_plane_pix_format {
+        bytesperline: layout.stride,
+        sizeimage: layout.size,
+        reserved: Default::default(),
+    };
+
+    V4l2MplaneFormat::from((
+        QueueDirection::Capture,
+        bindings::v4l2_pix_format_mplane {
+            width: layout.width,
+            height: layout.height,
+            pixelformat: PixelFormat::from_fourcc(if layout.swizzled {
+                PIX_FMT_NV12_Y_TILED_SWIZZLED
+            } else {
+                PIX_FMT_NV12_Y_TILED
+            })
+            .to_u32(),
+            field: bindings::v4l2_field_V4L2_FIELD_NONE,
+            plane_fmt,
+            num_planes: 1,
+            flags: 0,
+            ..Default::default()
+        },
+    ))
+}
