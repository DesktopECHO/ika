+            offsets: [0, self.layout.chroma_offset, 0, 0],
+            buffers: buffers.as_mut_ptr(),
+            num_buffers: 1,
+            flags: libva::constants::VA_SURFACE_EXTBUF_DESC_ENABLE_TILING,
+            private_data: std::ptr::null_mut(),
+        });
