+/// Layout of the pictures of a stream when the backend decodes them straight into CAPTURE buffers
+/// of guest memory instead of copying each one there: NV12 in the Y tiles of Intel GPUs, 128 bytes
+/// by 32 rows made of 16-byte columns, the luma plane padded to whole rows of tiles and the
+/// interleaved chroma plane after it. Haswell and older GPUs with two memory channels swizzle the
+/// tiles: bit 6 of each byte's address is flipped where bit 9 is set, which swaps rows `y` and
+/// `y ^ 4` in every odd column.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DirectOutputLayout {
+    /// Size of the pictures as decoded, the size of the backend's surfaces.
+    pub width: u32,
+    pub height: u32,
+    /// DRM format modifier the buffers are imported with.
+    pub modifier: u64,
+    /// Bytes per row of both planes, a whole number of tiles.
+    pub stride: u32,
+    /// Offset of the chroma plane, `stride` times `height` rounded up to whole rows of tiles.
+    pub chroma_offset: u32,
+    /// Size of a buffer, a whole number of pages.
+    pub size: u32,
+    /// Whether the tiles are swizzled.
+    pub swizzled: bool,
+}
+
+#[repr(C)]
+struct UdmabufCreate {
+    memfd: u32,
+    flags: u32,
+    offset: u64,
+    size: u64,
+}
+
+const UDMABUF_FLAGS_CLOEXEC: u32 = 0x01;
+base::ioctl_iow_nr!(UDMABUF_CREATE, 0x75, 0x42, UdmabufCreate);
+
+/// Makes a DMA-BUF of the whole of `shm` with the kernel's udmabuf driver, so that a device can
+/// write into the memory shared with the guest. udmabuf only takes memfds sealed against
+/// shrinking, so `shm` gets that seal.
+pub fn create_udmabuf(shm: &SharedMemory) -> anyhow::Result<SafeDescriptor> {
+    let memfd = shm.descriptor.as_raw_descriptor();
+    // SAFETY: `memfd` is a valid descriptor, and the return value is checked.
+    if unsafe { libc::fcntl(memfd, libc::F_ADD_SEALS, libc::F_SEAL_SHRINK) } < 0 {
+        bail!("sealing the memfd: {}", std::io::Error::last_os_error());
+    }
+    let udmabuf = std::fs::OpenOptions::new()
+        .read(true)
+        .open("/dev/udmabuf")
+        .context("opening /dev/udmabuf")?;
+    let create = UdmabufCreate {
+        memfd: memfd as u32,
+        flags: UDMABUF_FLAGS_CLOEXEC,
+        offset: 0,
+        size: shm.size,
+    };
+    // SAFETY: the kernel only reads `create`, and the return value is checked.
+    let fd = unsafe { base::ioctl_with_ref(&udmabuf, UDMABUF_CREATE, &create) };
+    if fd < 0 {
+        bail!("UDMABUF_CREATE: {}", std::io::Error::last_os_error());
+    }
+    // SAFETY: the ioctl returned a new descriptor that nothing else owns.
+    Ok(unsafe { SafeDescriptor::from_raw_descriptor(fd) })
+}
 
