+/// FNV-1a hash of `DIRECT_TEST_STREAM` decoded, as software decoders decode it: its luma rows,
+/// then its interleaved chroma rows.
+const DIRECT_TEST_PICTURE_HASH: u64 = 0x28a60a2d02247dda;
+
+/// FNV-1a hash of the `width`x`height` picture in `shm`, laid out as `layout`.
+fn hash_direct_picture(
+    shm: &SharedMemory,
+    layout: &DirectOutputLayout,
+    width: usize,
+    height: usize,
+) -> Result<u64> {
+    let mapping = MemoryMappingBuilder::new(layout.size as usize)
+        .from_shared_memory(shm)
+        .build()?;
+    let mut data = vec![0u8; layout.size as usize];
+    mapping.read_slice(&mut data, 0)?;
+    let stride = layout.stride as usize;
+    let swizzle = if layout.swizzled { 1 } else { 0 };
+    let tiled = move |x: usize, y: usize| {
+        let at = (y / 32) * stride * 32 + (x / 16) * 512 + (y % 32) * 16 + x % 16;
+        at ^ (((at >> 9) & swizzle) << 6)
+    };
+    let chroma = layout.chroma_offset as usize;
+    let luma_bytes = (0..height).flat_map(|y| (0..width).map(move |x| tiled(x, y)));
+    let chroma_bytes = (0..height.div_ceil(2))
+        .flat_map(|y| (0..width.next_multiple_of(2)).map(move |x| chroma + tiled(x, y)));
+    Ok(luma_bytes
+        .chain(chroma_bytes)
+        .fold(0xcbf29ce484222325, |hash, i| {
+            (hash ^ u64::from(data[i])).wrapping_mul(0x100000001b3)
+        }))
+}
+
+/// Finds how the driver decodes straight into guest memory, if it does: decodes
+/// `DIRECT_TEST_STREAM` into guest-like memory imported with DRM PRIME 2, then with DRM PRIME, and
+/// checks the picture in the layout of the driver's own surfaces, unswizzled and swizzled. The first
+/// that comes out right is how sessions decode.
+fn direct_decode_self_test(display: &Rc<Display>) -> Result<DirectDecode> {
+    let mut outcomes = Vec::new();
+    for drm_prime in [false, true] {
+        let import = if drm_prime { "DRM PRIME" } else { "DRM PRIME 2" };
+        match direct_decode_test_hashes(display, drm_prime) {
+            Ok((hash, swizzled_hash)) => {
+                if hash == DIRECT_TEST_PICTURE_HASH || swizzled_hash == DIRECT_TEST_PICTURE_HASH {
+                    return Ok(DirectDecode {
+                        drm_prime,
+                        swizzled: hash != DIRECT_TEST_PICTURE_HASH,
+                    });
+                }
+                outcomes.push(format!("{} picture wrong (hash {:#x})", import, hash));
+            }
+            Err(e) => outcomes.push(format!("{}: {:#}", import, e)),
+        }
+    }
+    bail!("its test picture came out wrong: {}", outcomes.join("; "))
+}
+
+/// Decodes `DIRECT_TEST_STREAM` into buffers of guest-like memory made and imported as a session
+/// imports the guest's when it decodes into them directly, with DRM PRIME (`drm_prime`) or DRM
+/// PRIME 2, and returns the picture's hash, read as unswizzled and as swizzled tiles.
+fn direct_decode_test_hashes(display: &Rc<Display>, drm_prime: bool) -> Result<(u64, u64)> {
+    let mut codec: Box<dyn StatelessVideoDecoder<BufferDescWithPicId>> = Box::new(
+        cros_codecs::decoder::stateless::StatelessDecoder::<H264, _>::new_vaapi(
+            Rc::clone(display),
+            cros_codecs::decoder::BlockingMode::Blocking,
+        ),
+    );
+    let mut buffers = Vec::new();
+    let mut layout = None;
+    let mut hash = None;
+    let mut offset = 0;
+    let mut flushed = false;
+    loop {
+        while let Some(event) = codec.next_event() {
+            match event {
+                cros_codecs::decoder::DecoderEvent::FormatChanged(mut format) => {
+                    let resolution = format.frame_pool().coded_resolution();
+                    let new_layout =
+                        direct_output_layout_for(display, resolution.width, resolution.height)?;
+                    let mut frames = Vec::new();
+                    for id in 0..format.stream_info().min_num_frames {
+                        let shm = SharedMemory::new("direct decode test", new_layout.size.into())?;
+                        let fd = create_udmabuf(&shm)?;
+                        // SAFETY: `fd` is a valid descriptor that nothing else owns.
+                        let fd = unsafe { OwnedFd::from_raw_fd(fd.into_raw_descriptor()) };
+                        let desc = if drm_prime {
+                            BufferDescriptor::DrmPrime(DrmPrimeFrame {
+                                fd,
+                                layout: new_layout,
+                            })
+                        } else {
+                            BufferDescriptor::Dmabuf(direct_output_frame(fd, &new_layout))
+                        };
+                        frames.push(BufferDescWithPicId {
+                            desc,
+                            picture_buffer_id: id as i32,
+                        });
+                        buffers.push(shm);
+                    }
+                    format.frame_pool().add_frames(frames)?;
+                    layout = Some(new_layout);
+                }
+                cros_codecs::decoder::DecoderEvent::FrameReady(frame) => {
+                    frame.sync()?;
+                    let id = frame.resource().picture_buffer_id as usize;
+                    let (Some(shm), Some(layout)) = (buffers.get(id), &layout) else {
+                        bail!("the decoder returned an unknown frame");
+                    };
+                    let size = frame.display_resolution();
+                    let (width, height) = (size.width as usize, size.height as usize);
+                    let swizzled = DirectOutputLayout {
+                        swizzled: true,
+                        ..*layout
+                    };
+                    hash = Some((
+                        hash_direct_picture(shm, layout, width, height)?,
+                        hash_direct_picture(shm, &swizzled, width, height)?,
+                    ));
+                }
+            }
+        }
+        if offset < DIRECT_TEST_STREAM.len() {
+            match codec.decode(0, &DIRECT_TEST_STREAM[offset..]) {
+                Ok(0) => bail!("the decoder took no data"),
+                Ok(processed) => offset += processed,
+                Err(DecodeError::CheckEvents) => (),
+                Err(e) => return Err(e.into()),
+            }
+        } else if !flushed {
+            codec.flush()?;
+            flushed = true;
+        } else {
+            break;
+        }
+    }
+    hash.ok_or_else(|| anyhow!("the test picture was not decoded"))
+}
