+/// `I915_FORMAT_MOD_Y_TILED`, the Y tiles of Intel GPUs.
+const I915_FORMAT_MOD_Y_TILED: u64 = (0x01 << 56) | 2;
+const DRM_FORMAT_NV12: u32 = u32::from_le_bytes(*b"NV12");
+
+#[repr(C)]
+struct DrmI915Getparam {
+    param: i32,
+    value: *mut i32,
+}
+
+const I915_PARAM_HAS_LLC: i32 = 17;
+base::ioctl_iowr_nr!(DRM_IOCTL_I915_GETPARAM, 0x64, 0x46, DrmI915Getparam);
+
+/// Checks that the GPU behind DRM node `node` can decode straight into guest memory that the
+/// guest then reads with its CPU: driven by i915, as the pictures of other drivers are laid out
+/// and shared in ways this does not handle, and sharing the CPU's last-level cache, so what the
+/// GPU writes to memory is what the CPU reads, without a cache flush.
+fn check_direct_decode_gpu(node: &Path) -> Result<()> {
+    let file = std::fs::File::options().read(true).write(true).open(node)?;
+    let rdev = file.metadata()?.rdev();
+    let driver = std::fs::read_link(format!(
+        "/sys/dev/char/{}:{}/device/driver",
+        libc::major(rdev),
+        libc::minor(rdev)
+    ))?;
+    let driver = driver.file_name().unwrap_or_default().to_string_lossy();
+    if driver != "i915" {
+        bail!("{} is driven by {}", node.display(), driver);
+    }
+    let mut has_llc = 0;
+    let mut param = DrmI915Getparam {
+        param: I915_PARAM_HAS_LLC,
+        value: &mut has_llc,
+    };
+    // SAFETY: `param` points to memory the kernel can write to, and the return value is checked.
+    if unsafe { base::ioctl_with_mut_ref(&file, DRM_IOCTL_I915_GETPARAM, &mut param) } < 0 {
+        bail!("I915_PARAM_HAS_LLC: {}", std::io::Error::last_os_error());
+    }
+    if has_llc == 0 {
+        bail!("the GPU does not share the CPU's last-level cache");
+    }
+    Ok(())
+}
+
+/// Returns the layout of the NV12 decoder surfaces the driver makes itself at `width`x`height`,
+/// which pictures are decoded into guest memory in, if it is a layout the guest can read. The
+/// format is explicit, as i965 only allocates a surface created without one when it decodes.
+fn direct_output_layout_for(
+    display: &Rc<Display>,
+    width: u32,
+    height: u32,
+) -> Result<DirectOutputLayout> {
+    let surfaces = display.create_surfaces(
+        libva::constants::VA_RT_FORMAT_YUV420,
+        Some(libva::constants::VA_FOURCC_NV12),
+        width,
+        height,
+        Some(libva::UsageHint::USAGE_HINT_DECODER),
+        vec![()],
+    )?;
+    let desc = surfaces[0].export_prime()?;
+    let (Some(object), Some(layer)) = (desc.objects.first(), desc.layers.first()) else {
+        bail!("the driver exported no buffer");
+    };
+    if desc.objects.len() != 1
+        || desc.layers.len() != 1
+        || layer.drm_format != DRM_FORMAT_NV12
+        || layer.num_planes != 2
+    {
+        bail!("its surfaces are not NV12 in one buffer");
+    }
+    let modifier = object.drm_format_modifier;
+    if modifier != I915_FORMAT_MOD_Y_TILED {
+        bail!("its surfaces have modifier {:#x}", modifier);
+    }
+    let stride = layer.pitch[0];
+    let chroma_offset = layer.offset[1];
+    if layer.offset[0] != 0
+        || layer.pitch[1] != stride
+        || stride % 128 != 0
+        || chroma_offset != stride * height.next_multiple_of(32)
+    {
+        bail!(
+            "its surfaces have pitches {}/{} and offsets {}/{}",
+            stride,
+            layer.pitch[1],
+            layer.offset[0],
+            chroma_offset
+        );
+    }
+    // The decoder writes the chroma plane in whole rows of tiles too.
+    let end = u64::from(chroma_offset)
+        + u64::from(stride) * u64::from(height.div_ceil(2).next_multiple_of(32));
+    let size = end
+        .max(u64::from(object.size))
+        .next_multiple_of(base::pagesize() as u64);
+    Ok(DirectOutputLayout {
+        width,
+        height,
+        modifier,
+        stride,
+        chroma_offset,
+        size: u32::try_from(size)?,
+        swizzled: false,
+    })
+}
