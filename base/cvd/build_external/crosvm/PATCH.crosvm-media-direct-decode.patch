+impl libva::SurfaceMemoryDescriptor for DrmPrimeFrame {
+    fn add_attrs(
+        &mut self,
+        attrs: &mut Vec<libva::VASurfaceAttrib>,
+    ) -> Option<Box<dyn std::any::Any>> {
+        let mut buffers = Box::new([self.fd.as_raw_fd() as usize]);
+        let mut desc = Box::new(libva::VASurfaceAttribExternalBuffers {
