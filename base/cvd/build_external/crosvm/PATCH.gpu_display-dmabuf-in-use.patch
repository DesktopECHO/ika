Tell whether the compositor still uses an imported dma-buf.

The Wayland display backend already tracks each imported dma-buf's in_use
flag (set by dwl_surface_flip_to, cleared by the compositor's wl_buffer
release) but nothing read it. Ika's compositor (ika_stream) holds the buffer
of a dma-buf frame until the console has released the frame, so a scanout
flushed into a buffer still in use would be shown while it is on screen.
dwl_surface_dmabuf_in_use() reports that, except for the buffer the surface
shows right now: the guest may flush the same buffer again (a single-buffer
scanout, or a redraw into the buffer on screen), which supersedes the hold
and must not be skipped forever. GpuDisplaySurface::import_in_use() and
GpuDisplay::import_in_use() expose it to the virtio-gpu device.

diff --git a/src/display_wl.c b/src/display_wl.c
--- a/src/display_wl.c
+++ b/src/display_wl.c
@@ -141,6 +141,8 @@ struct dwl_surface {
 	double scale;
 	bool close_requested;
 	size_t buffer_count;
+	// The dma-buf import last flipped to, 0 if none
+	uint32_t current_import_id;
 	uint64_t buffer_use_bit_mask;
 	struct wl_buffer *buffers[0];
 };
@@ -1250,6 +1252,17 @@ bool dwl_surface_buffer_in_use(struct dwl_surface *self, size_t buffer_index)
 	return (self->buffer_use_bit_mask & (1 << buffer_index)) != 0;
 }
 
+bool dwl_surface_dmabuf_in_use(struct dwl_surface *self, uint32_t import_id)
+{
+	// Ika: the compositor holds the buffer of a frame while the console
+	// shows it. The buffer on screen may be flushed again: the compositor
+	// takes the new commit as the release of the old one.
+	struct dwl_dmabuf *dmabuf = dwl_context_get_dmabuf(self->context,
+							   import_id);
+	return dmabuf && dmabuf->in_use &&
+	       import_id != self->current_import_id;
+}
+
 void dwl_surface_flip(struct dwl_surface *self, size_t buffer_index)
 {
 	if (buffer_index >= self->buffer_count)
@@ -1274,6 +1287,7 @@ void dwl_surface_flip_to(struct dwl_surface *self, uint32_t import_id)
 	wl_surface_damage(self->wl_surface, 0, 0, self->width, self->height);
 	dwl_surface_commit(self);
 	dmabuf->in_use = true;
+	self->current_import_id = import_id;
 }
 
 bool dwl_surface_close_requested(const struct dwl_surface *self)
