+++ b/src/virtio/gpu/virtio_gpu.rs
@@ -1212,7 +1212,16 @@ impl VirtioGpu {
             let export = RutabagaMagmaHandle::try_from(export)
                 .context("failed to retrieve the handle info")
                 .context(ErrUnspec)?;
-            if let Ok(vulkan_info) = self.rutabaga.vulkan_info(resource_id) {
+            if self.fixed_blob_mapping && export.handle_type == RUTABAGA_HANDLE_TYPE_MEM_DMABUF {
+                // ika: fixed blob mapping cannot import into Vulkan; map the
+                // dma-buf itself instead (e.g. cross-domain buffers that the
+                // Vulkano gralloc allocated, which also carry Vulkan info).
