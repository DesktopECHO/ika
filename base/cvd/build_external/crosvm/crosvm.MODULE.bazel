# this needs to be at parity with with build_external/crosvm/crosvm.config.toml
CROSVM_REMOTE = "https://chromium.googlesource.com/crosvm/crosvm"
CROSVM_REV = "22f6be24c5ef49f99c164bb3bd063ace509fb96a"
MINIGBM_REMOTE = "https://chromium.googlesource.com/chromiumos/platform/minigbm"
MINIGBM_REV = "a2d42f09d696b04e6ded5ad38596d8554ffd8988"

# note that this won't use the same source checkout as the git_repository directive below
#
# The following `annotation` directives modify the generated bazel rules for
# individual crates in the crosvm dependency chart.
#
# See https://bazelbuild.github.io/rules_rust/crate_universe_bzlmod.html
crosvm_bin = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crosvm_bin.spec(
    artifact = "bin",
    package = "crosvm",
    features = [
        "android-sparse",
        "android_display",
        "android_display_stub",
        "audio",
        "audio_aaudio",
        "balloon",
        "composite-disk",
        "ffmpeg",
        "fs_runtime_ugid_map",
        "gdb",
        "gfxstream",
        "gfxstream_display",
        "gpu",
        "gpu_display",
        "gunyah",
        "libaaudio_stub",
        "media",
        "net",
        "net_util",
        "pci-hotplug",
        "pvclock",
        "qcow",
        "stats",
        "tokio",
        "usb",
        "vaapi",
        "video-decoder",
        "video-encoder",
        "virgl_renderer",
        # Vulkan-based rutabaga_gralloc backend. Required on Apple Silicon
        # (Asahi): the bundled minigbm has no asahi driver backend, so
        # gbm_create_device fails on the Apple GPU render node and crosvm is
        # left with only the "system" gralloc backend, which cannot import the
        # dma-buf blobs gfxstream exports for host-visible guest memory
        # (crosvm: "invalid gralloc backend" -> guest ANGLE VK_ERROR_OUT_OF_
        # DEVICE_MEMORY -> black surfaces). The vulkano backend imports/maps
        # those blobs via VK_EXT_external_memory_dma_buf through Honeykrisp,
        # which supports it. vulkano 0.33.0 + deps are already in Cargo.lock.
        "vulkano",
        "wl-dmabuf",
        "zstd-disk",
    ],
    git = CROSVM_REMOTE,
    rev = CROSVM_REV,
)

crosvm_bin.annotation(
    crate = "crosvm",
    gen_all_binaries = True,
    patch_args = ["-p1"],
    patches = [
        # --aperfmperf: x86 guests read the host's APERF/MPERF counters, so they
        # see their vCPUs' effective frequency (needs the hypervisor and x86_64
        # crate patches below).
        "@//build_external/crosvm:PATCH.crosvm-aperfmperf.patch",
        "@//build_external/crosvm:PATCH.crosvm-composite-duplicate-components.patch",
        # Sandbox fixes also need crate-specific variants below because
        # crates_universe checks out each published crate with its own root.
        "@//build_external/crosvm:PATCH.crosvm-composite-preserve-spec-fd.patch",
        "@//build_external/crosvm:PATCH.crosvm-gpu-2d-sandbox.patch",
        "@//build_external/crosvm:PATCH.crosvm-gpu-unref-shmem-mapping.patch",
        "@//build_external/crosvm:PATCH.crosvm-resize-display.patch",
        "@//build_external/crosvm:PATCH.crosvm-flush-held-dmabuf.patch",
        "@//build_external/crosvm:PATCH.crosvm-enable-vulkano-gralloc.patch",
        "@//build_external/crosvm:PATCH.crosvm-fixed-blob-mapping-virglrenderer.patch",
        # The virtio-media decoder adapter gets no GPU resource bridge, which it
        # never used: the GPU logged errors at boot when its end closed. Made on
        # top of the aperfmperf and Vulkano gralloc patches, which sort before it.
        "@//build_external/crosvm:PATCH.crosvm-media-no-resource-bridge.patch",
        "@//build_external/crosvm:PATCH.minijail-sys_common_mk.patch",
    ],
    deps = [
        "@@//:gfxstream_backend_import",
        "@crosvm_bin__ffmpeg-0.1.0//:build_script_build",
    ],
    rustc_flags = [
        # Look for shared libraries in the same directory as the binary.
        "-Clink-arg=-Wl,-rpath,$$ORIGIN",
        # ...and in the package's lib64, where libvirglrenderer.so.1 is:
        # without it crosvm loads the system's libvirglrenderer, Debian 13's
        # 1.1.0, whose Venus capset makes the guest's Venus driver stop at
        # Vulkan 1.3.
        "-Clink-arg=-Wl,-rpath,$$ORIGIN/../lib64",
    ],
)

crosvm_bin.annotation(
    crate = "ffmpeg",
    patch_args = ["-p1"],
    patches = [
        # crate_universe applies annotation patches in sorted label order, not
        # list order. PATCH.ffmpeg-supported-config.patch edits the build.rs
        # produced by PATCH.ffmpeg-pkg-config-includes.patch, so its name must
        # keep sorting after it.
        "@//build_external/crosvm:PATCH.ffmpeg-pkg-config-includes.patch",
        "@//build_external/crosvm:PATCH.ffmpeg-supported-config.patch",
    ],
)

# The linked disk crate owns CompositeDiskFile; keep its spec fd reported to
# minijail so the sandbox's close-fds pass does not invalidate Rust-owned Files.
crosvm_bin.annotation(
    crate = "disk",
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.disk-composite-preserve-spec-fd.patch",
        # Guest discards on the qcow2 overlay (a factory reset discards all of
        # userdata) become zero clusters instead of allocated zeroed clusters.
        "@//build_external/crosvm:PATCH.disk-qcow-zero-clusters.patch",
    ],
)

# The GPU worker read the Wayland display with a blocking dispatch after its fd
# had been readable, even when a roundtrip made meanwhile (adding or removing a
# display) had already read those events: it then waited for the compositor
# forever, and the guest's GPU requests with it.
crosvm_bin.annotation(
    crate = "gpu_display",
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.gpu_display-nonblocking-dispatch.patch",
        # Whether the compositor still holds an imported dma-buf (ika_stream
        # holds the frame the console shows), for the virtio-gpu device.
        "@//build_external/crosvm:PATCH.gpu_display-dmabuf-in-use.patch",
        # From upstream crosvm f1d0ffe: release_import takes (surface_id,
        # import_id) everywhere, as the backends implement it, for
        # PATCH.crosvm-unref-display-imports-devices.patch.
        "@//build_external/crosvm:PATCH.gpu_display-release-import-order.patch",
    ],
)

crosvm_bin.annotation(
    crate = "v4l2r",
    build_script_env = {
        # v4l2r bindgen starts from /usr/include/linux/videodev2.h, which
        # includes libc headers from Debian's multiarch include directory.
        "BINDGEN_EXTRA_CLANG_ARGS": "-I/usr/include/aarch64-linux-gnu -I/usr/include/x86_64-linux-gnu",
    },
    patch_args = ["-p1"],
    patches = [
        # The --v4l2-proxy device polls through v4l2r's Poller; its EPOLLIN probe
        # starts read() streaming on host cameras whose driver supports read().
        "@//build_external/crosvm:PATCH.v4l2r-poller-no-epollin-probe.patch",
    ],
)

crosvm_bin.annotation(
    crate = "virtio-media",
    patch_args = ["-p1"],
    patches = [
        # MMAP buffers get offsets 64 KiB apart instead of 4 KiB, so a guest
        # with 16 KiB pages (Apple Silicon hosts) can mmap() every buffer, not
        # only every fourth.
        "@//build_external/crosvm:PATCH.virtio-media-mmap-offset-step.patch",
    ],
    # crosvm's virtio-media only: annotations apply to every crate_universe
    # hub of the shared extension, and vhost_user_media's virtio-media 0.0.7
    # does not take this patch.
    repositories = ["crosvm_bin"],
)

crosvm_bin.annotation(
    crate = "devices",
    patch_args = ["-p1"],
    patches = [
        # The virtio-media video decoder's input buffers hold a whole
        # compressed frame: 8 MB rather than 1 MB, so 4K and high-bitrate
        # keyframes fit (Android's V4L2 Codec2 HAL offers 4K only when they do).
        "@//build_external/crosvm:PATCH.crosvm-media-decoder-input-size.patch",
        # Its CAPTURE buffers are described at the visible size, the size the
        # VA-API backend writes pictures into them at, not the coded size:
        # otherwise 1080p shows a green band and colors shifted up 16 lines.
        "@//build_external/crosvm:PATCH.crosvm-media-decoder-visible-size.patch",
        # A decode error from the backend is logged and the VM keeps running,
        # instead of reaching a todo!() that aborted crosvm. Named to sort
        # after the two patches above, which it is made on top of.
        "@//build_external/crosvm:PATCH.crosvm-media-errors.patch",
        # On Intel GPUs that share the CPU's cache, VA-API decodes straight into
        # the guest's CAPTURE buffers, imported with udmabuf in the Y-tiled
        # layout of its own surfaces, instead of copying every picture into
        # them; a decode self-test checks the driver first. Elsewhere pictures
        # are copied as before. Made on top of the three patches above.
        "@//build_external/crosvm:PATCH.crosvm-media-direct-decode.patch",
        # The CAPTURE buffer returned with the LAST flag when a drain completes
        # is the guest's again: the next one queued is kept aside for the next
        # drain, so a buffer the backend holds is never returned. A buffer
        # queued while a drain waits for one is returned at once. Made on top
        # of the four patches above, and named to sort after them.
        "@//build_external/crosvm:PATCH.crosvm-media-last-buffer.patch",
        # An OUTPUT format without a real size (Android's HAL sets -1 x -1)
        # leaves the coded size as it is, instead of the largest supported size
        # that the CAPTURE buffers allocated before the stream's size then took.
        # Made on top of the five patches above, and named to sort after them.
        "@//build_external/crosvm:PATCH.crosvm-media-placeholder-size.patch",
        "@//build_external/crosvm:PATCH.crosvm-resize-display-devices.patch",
        # A scanout flush into a dma-buf the compositor still holds is dropped
        # instead of shown into the frame on screen.
        "@//build_external/crosvm:PATCH.crosvm-flush-held-dmabuf-devices.patch",
        # With fixed blob mapping (Venus), map dma-buf blobs that carry
        # Vulkan info directly instead of through a Vulkan import.
        "@//build_external/crosvm:PATCH.crosvm-fixed-blob-mapping-dmabuf-devices.patch",
        # From upstream crosvm f1d0ffe, without its tests: a resource keeps
        # its display import per surface and releases them when the guest
        # frees it. The Wayland display holds 64 imports and none were ever
        # released, so after 64 scanout buffers every new one fell back to a
        # copy. Named to sort after the virtio_gpu.rs patches above.
        "@//build_external/crosvm:PATCH.crosvm-unref-display-imports-devices.patch",
    ],
)

crosvm_bin.annotation(
    crate = "rutabaga_gfx",
    deps = [
        "@@//:gfxstream_backend_import",
    ],
    build_script_data = ["@@//:minigbm_sources"],
    build_script_rundir = ".",
    rustc_flags = [
        # Look for shared libraries in the same directory as this object.
        "-Clink-arg=-Wl,-rpath,$$ORIGIN",
    ],
    build_script_env = {
        # Disable the build script from trying to automatically locate
        # Gfxstream as the dep is directly provided above.
        "CARGO_FEATURE_GFXSTREAM_STUB": "blah",
        # Force rutabaga_gfx to use the system virglrenderer package instead of
        # expecting crosvm's third_party/virglrenderer source checkout.
        "CROSVM_USE_SYSTEM_VIRGLRENDERER": "1",
    },
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.rutabaga_gfx_build_rs.patch",
        # Capability gate for the vulkano backend enabled by
        # PATCH.crosvm-enable-vulkano-gralloc.patch: prefer minigbm when it
        # initializes (x86-64 and any host with a minigbm driver), start and
        # select Vulkano only when it doesn't (Apple Silicon / Asahi).
        "@//build_external/crosvm:PATCH.rutabaga_gfx-gralloc-vulkano-fallback.patch",
        # Create Vulkano's layout-query images linear, so the cross-domain
        # context (Venus mode's gralloc) can read their strides.
        "@//build_external/crosvm:PATCH.rutabaga_gfx-vulkano-linear-images.patch",
        # Drain renderer resources and contexts while the component is alive,
        # so clean VMM shutdown reaches gfxstream's normal unbind paths.
        "@//build_external/crosvm:PATCH.rutabaga_gfx-cleanup-on-drop.patch",
        # Give crosvm the format and stride of gfxstream's 3D resources, so a
        # scanout goes to the display as a dma-buf instead of a GPU-to-CPU copy.
        "@//build_external/crosvm:PATCH.rutabaga_gfx-gfxstream-3d-resource-info.patch",
        # Export gfxstream resources on demand and read their layout lazily,
        # after gfxstream gave the scanout its explicit DRM modifier.
        "@//build_external/crosvm:PATCH.rutabaga_gfx-on-demand-export-and-query.patch",
    ],
)

# ARM64 sandbox policy and GPU minijail mount fixes for guest SwiftShader.
crosvm_bin.annotation(
    crate = "jail",
    build_script_data_glob = ["seccomp/**"],
    build_script_data = ["@@//:compile_seccomp_policy_exe"],
    build_script_env = {"COMPILE_SECCOMP_POLICY": "$(execpath @@//:compile_seccomp_policy_exe)"},
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.jail-aarch64-block-pread64.patch",
        "@//build_external/crosvm:PATCH.jail-gpu-host-graphics-libs-optional.patch",
    ],
)

# minijail-sys/build.rs invokes `make` to build the minijail C library, so all
# the sources need to be made available to it at runtime in a filegroup.
# rules_rust only checks out the crate directory and the C sources are two
# directories above, so we grab them from the submodule checkout in our crosvm
# git_repository.
crosvm_bin.annotation(
    crate = "minijail-sys",
    build_script_data = ["@@//:minijail_sources"],
    build_script_rundir = ".",
    patch_args = ["-p1"],
    # crates_universe checks out only a subdirectory of the repository, so the
    # file paths in this patch are relative to that directory.
    patches = ["@//build_external/crosvm:PATCH.minijail-sys_build_rs.patch"],
)

# Disable the `path` directives for the generated code as they end up with
# temporary paths within the bazel sandbox.
crosvm_bin.annotation(
    crate = "proto_build_tools",
    patch_args = ["-p1"],
    # crates_universe checks out only a subdirectory of the repository, so the
    # file paths in this patch are relative to that directory.
    patches = ["@//build_external/crosvm:PATCH.proto_build_tools.patch"],
)

crosvm_bin.annotation(
    crate = "hypervisor",
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.hypervisor-aperfmperf.patch",
    ],
)

crosvm_bin.annotation(
    crate = "x86_64",
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.x86_64-aperfmperf.patch",
    ],
)

crosvm_bin.annotation(
    crate = "vm_control",
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.crosvm-resize-display-vm-control.patch",
    ],
)

crosvm_bin.from_specs(
    name = "crosvm_bin",
    cargo_config = "@//build_external/crosvm:crosvm.config.toml",
    cargo_lockfile = "@crosvm//:Cargo.lock",
    # Executable dependencies are an unstable cargo feature.
    host_tools = "@rust_host_tools_nightly",
)

use_repo(crosvm_bin, "crosvm_bin")

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "crosvm",
    build_file = "@//build_external/crosvm:BUILD.crosvm.bazel",
    commit = CROSVM_REV,
    remote = CROSVM_REMOTE,
    init_submodules = True,
    patch_strip = 1,
    patches = [
        "@//build_external/crosvm:PATCH.crosvm-aarch64-block-pread64-source.patch",
        "@//build_external/crosvm:PATCH.crosvm-composite-duplicate-components.patch",
        "@//build_external/crosvm:PATCH.crosvm-composite-preserve-spec-fd.patch",
        "@//build_external/crosvm:PATCH.crosvm-gpu-2d-sandbox-source.patch",
        "@//build_external/crosvm:PATCH.crosvm-resize-display.patch",
        "@//build_external/crosvm:PATCH.minijail-sys_common_mk.patch",
    ],
)

git_repository(
    name = "minigbm",
    build_file = "@//build_external/crosvm:BUILD.minigbm.bazel",
    commit = MINIGBM_REV,
    remote = MINIGBM_REMOTE,
)
