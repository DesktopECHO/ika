git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "virglrenderer",
    build_file = "@//build_external/virglrenderer:BUILD.virglrenderer.bazel",
    commit = "e0a1caf3b147bb26dfe524dbb85ded1177e7e49e",
    patch_args = ["-p1"],
    patches = [
        # Retry device creation at medium queue priority when the host driver
        # refuses a raised one (Honeykrisp), so ANGLE gets a device.
        "@//build_external/virglrenderer:PATCH.venus-global-priority-fallback.patch",
    ],
    remote = "https://gitlab.freedesktop.org/virgl/virglrenderer",
)
