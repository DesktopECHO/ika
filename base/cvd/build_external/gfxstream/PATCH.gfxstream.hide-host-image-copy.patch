 #include <unordered_map>
 #include <vector>
 
@@ -1857,6 +1858,19 @@ class VkDecoderGlobalState::Impl {
             }
         }
 
+        // Host image copy is not advertised (see on_vkEnumerateDeviceExtensionProperties), and
+        // it is an optional Vulkan 1.4 core feature too.
+        VkPhysicalDeviceHostImageCopyFeatures* hostImageCopyFeatures =
+            vk_find_struct<VkPhysicalDeviceHostImageCopyFeatures>(pFeatures);
+        if (hostImageCopyFeatures != nullptr) {
+            hostImageCopyFeatures->hostImageCopy = VK_FALSE;
+        }
+        VkPhysicalDeviceVulkan14Features* vulkan14Features =
+            vk_find_struct<VkPhysicalDeviceVulkan14Features>(pFeatures);
+        if (vulkan14Features != nullptr) {
+            vulkan14Features->hostImageCopy = VK_FALSE;
+        }
+
         if (disableSparseBindingSupport && pFeatures->features.sparseBinding) {
             pFeatures->features.sparseBinding = VK_FALSE;
             pFeatures->features.sparseResidencyBuffer = VK_FALSE;
@@ -2331,6 +2345,17 @@ class VkDecoderGlobalState::Impl {
                            }),
             properties.end());
 
+        // vkCopyMemoryToImage/vkCopyImageToMemory cannot be marshalled (their pHostPointer
+        // payload never reaches the host), so the decoder refuses them. Do not advertise host
+        // image copy either, otherwise guests such as ANGLE upload textures through it and the
+        // uploads are silently lost.
+        properties.erase(std::remove_if(properties.begin(), properties.end(),
+                                        [](const VkExtensionProperties& extension) {
+                                            return !strcmp(extension.extensionName,
+                                                           VK_EXT_HOST_IMAGE_COPY_EXTENSION_NAME);
+                                        }),
+                         properties.end());
+
         // Add in emulated extensions:
 
 #if defined(_WIN32)
@@ -11200,7 +11225,10 @@ class VkDecoderGlobalState::Impl {
         VK_FORMAT_FEATURE_2_VIDEO_ENCODE_INPUT_BIT_KHR |
         VK_FORMAT_FEATURE_2_VIDEO_ENCODE_DPB_BIT_KHR |
         VK_FORMAT_FEATURE_2_VIDEO_ENCODE_QUANTIZATION_DELTA_MAP_BIT_KHR |
-        VK_FORMAT_FEATURE_2_VIDEO_ENCODE_EMPHASIS_MAP_BIT_KHR;
+        VK_FORMAT_FEATURE_2_VIDEO_ENCODE_EMPHASIS_MAP_BIT_KHR |
