Patch summary:
Hide VK_EXT_host_image_copy until its calls are marshalled; ANGLE texture
uploads through it came out empty.
diff --git a/host/vulkan/cereal/common/vk_struct_id.h b/host/vulkan/cereal/common/vk_struct_id.h
index 94f1a08a..430bb30f 100644
--- a/host/vulkan/cereal/common/vk_struct_id.h
+++ b/host/vulkan/cereal/common/vk_struct_id.h
@@ -172,6 +172,8 @@ REGISTER_VK_STRUCT_ID(VkPhysicalDeviceVulkan13Features,
                       VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES);
 REGISTER_VK_STRUCT_ID(VkPhysicalDeviceVulkan14Features,
                       VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_4_FEATURES);
+REGISTER_VK_STRUCT_ID(VkPhysicalDeviceHostImageCopyFeatures,
+                      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_HOST_IMAGE_COPY_FEATURES);
 
 REGISTER_VK_STRUCT_ID(VkDebugMetadataGOOGLE,
                       VK_STRUCTURE_TYPE_DEBUG_METADATA_GOOGLE);
