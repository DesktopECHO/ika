+// Direct3D 12, under Mesa's Dozen on WSL2, has no three-plane YUV format, so
+// the ColorBuffer of a YV12 frame from a software video decoder could not be
+// created, and SurfaceFlinger aborted on the guest buffer it could not sample.
+// Such ColorBuffers are RGBA8 instead, written from the guest's YUV bytes;
+// sampling them needs no Y'CbCr conversion.
+bool VkEmulation::usesYuvRgbaFallback(GfxstreamFormat format) const {
+    if (format != GfxstreamFormat::YV12 && format != GfxstreamFormat::YV21 &&
+        format != GfxstreamFormat::NV12 && format != GfxstreamFormat::NV21) {
+        return false;
+    }
+    auto vkFormatOpt = ToVkFormat(format);
+    if (!vkFormatOpt) {
+        return false;
+    }
+    // ImageSupport::IsFormatSupported() assumes every color format is, and
+    // GetSupportedInfo() warns at each miss: this runs at each upload.
+    for (const ImageSupportInfo& supportInfo : mImageSupportInfo.mSupportInfos) {
+        if (supportInfo.format == *vkFormatOpt && supportInfo.supported) {
+            return false;
+        }
+    }
+    return true;
+}
