+static uint8_t clampToByte(int value) {
+    return static_cast<uint8_t>(value < 0 ? 0 : (value > 255 ? 255 : value));
+}
+
+// Converts the guest's bytes of a 4:2:0 YUV ColorBuffer, laid out as
+// getFormatTransferInfo() gives its format (a Y plane, then one interleaved
+// chroma plane or two separate ones), to RGBA8, with the BT.601 limited-range
+// matrix of the GL YUVConverter. YV12 has its V plane before its U plane, YV21
+// the reverse; NV12 interleaves U then V, NV21 V then U. Returns false when the
+// input is smaller than that layout.
+static bool convertYuv420ToRgbaPixels(void* dst, const void* src, size_t srcSize,
+                                      GfxstreamFormat format, uint32_t w, uint32_t h) {
+    auto vkFormatOpt = ToVkFormat(format);
+    TransferInfo transferInfo;
+    if (!vkFormatOpt || !getFormatTransferInfo(*vkFormatOpt, VkExtent3D{w, h, 1}, &transferInfo)) {
+        return false;
+    }
+    const std::vector<VkBufferImageCopy>& planes = transferInfo.bufferImageCopies;
+    if (planes.size() < 2 || (srcSize != 0 && srcSize < transferInfo.stagingBufferCopySize)) {
+        return false;
+    }
+
+    const uint8_t* bytes = reinterpret_cast<const uint8_t*>(src);
+    const uint8_t* yPlane = bytes + planes[0].bufferOffset;
+    const size_t yStride = planes[0].bufferRowLength;
+    const uint32_t chromaRows = planes[1].imageExtent.height;
+    const uint8_t* uPlane;
+    const uint8_t* vPlane;
+    size_t chromaStride;
+    size_t chromaStep;
+    if (planes.size() == 2) {
+        const uint8_t* uv = bytes + planes[1].bufferOffset;
+        chromaStride = static_cast<size_t>(planes[1].bufferRowLength) * 2;
+        chromaStep = 2;
+        uPlane = format == GfxstreamFormat::NV21 ? uv + 1 : uv;
+        vPlane = format == GfxstreamFormat::NV21 ? uv : uv + 1;
+    } else {
+        const uint8_t* first = bytes + planes[1].bufferOffset;
+        const uint8_t* second = bytes + planes[2].bufferOffset;
+        chromaStride = planes[1].bufferRowLength;
+        chromaStep = 1;
+        uPlane = format == GfxstreamFormat::YV12 ? second : first;
+        vPlane = format == GfxstreamFormat::YV12 ? first : second;
+    }
+    if (chromaRows == 0) {
+        return false;
+    }
+
+    uint32_t* dstPixels = reinterpret_cast<uint32_t*>(dst);
+    for (uint32_t y = 0; y < h; ++y) {
+        const uint8_t* yRow = yPlane + y * yStride;
+        const size_t chromaRow = std::min(y / 2, chromaRows - 1) * chromaStride;
+        const uint8_t* uRow = uPlane + chromaRow;
+        const uint8_t* vRow = vPlane + chromaRow;
+        for (uint32_t x = 0; x < w; ++x) {
+            const int c = 298 * (yRow[x] - 16) + 128;
+            const int d = uRow[(x / 2) * chromaStep] - 128;
+            const int e = vRow[(x / 2) * chromaStep] - 128;
+            const uint8_t r = clampToByte((c + 409 * e) >> 8);
+            const uint8_t g = clampToByte((c - 100 * d - 208 * e) >> 8);
+            const uint8_t b = clampToByte((c + 516 * d) >> 8);
+            *(dstPixels++) = 0xff000000 | (b << 16) | (g << 8) | r;
+        }
+    }
+    return true;
+}
