@@ -9068,6 +9074,49 @@ class VkDecoderGlobalState::Impl {
         return true;
     }
 
+    void on_vkCmdPushConstants(gfxstream::base::BumpPool* pool, VkSnapshotApiCallHandle,
+                               VkCommandBuffer boxed_commandBuffer, VkPipelineLayout layout,
+                               VkShaderStageFlags stageFlags, uint32_t offset, uint32_t size,
+                               const void* pValues) {
+        auto commandBuffer = unbox_VkCommandBuffer(boxed_commandBuffer);
+        auto vk = dispatch_VkCommandBuffer(boxed_commandBuffer);
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            CommandBufferInfo* cmdBufferInfo = gfxstream::base::find(mCommandBufferInfo, commandBuffer);
+            if (cmdBufferInfo && size > 0 && pValues) {
+                auto& writes = cmdBufferInfo->pushConstants;
+                // Keep writes in submission order so replaying them reproduces overlapping
+                // updates exactly. A write only becomes redundant once a later one covers all
+                // of its stages and bytes; the layout does not matter for that, and guests such
+                // as ANGLE push the same range with a different layout per program.
+                const uint64_t end = uint64_t(offset) + size;
+                writes.erase(std::remove_if(writes.begin(), writes.end(),
+                                            [&](const CommandBufferInfo::PushConstantsWrite& w) {
+                                                return (w.stageFlags & ~stageFlags) == 0 &&
+                                                       w.offset >= offset &&
+                                                       w.offset + w.values.size() <= end;
+                                            }),
+                             writes.end());
+                const uint8_t* bytes = static_cast<const uint8_t*>(pValues);
+                writes.push_back({layout, stageFlags, offset,
+                                  std::vector<uint8_t>(bytes, bytes + size)});
+            }
+        }
+        vk->vkCmdPushConstants(commandBuffer, layout, stageFlags, offset, size, pValues);
+    }
+
+    // The decompression shader binds its own compute pipeline and pushes its own constants.
+    // Drivers such as RADV keep a single push constant block per command buffer shared by all
+    // bind points, so the guest's graphics push constants (e.g. ANGLE's driver uniforms) must be
+    // restored as well, otherwise the next draw silently uses the decompression parameters.
+    void restoreGuestStateAfterDecompressionLocked(VulkanDispatch* vk, VkCommandBuffer commandBuffer,
+                                                   CommandBufferInfo* cmdBufferInfo) {
+        for (const auto& w : cmdBufferInfo->pushConstants) {
+            vk->vkCmdPushConstants(commandBuffer, w.layout, w.stageFlags, w.offset,
+                                   static_cast<uint32_t>(w.values.size()), w.values.data());
+        }
+    }
+
     void on_vkCmdBeginRenderPass(gfxstream::base::BumpPool* pool, VkSnapshotApiCallHandle,
                                  VkCommandBuffer boxed_commandBuffer,
                                  const VkRenderPassBeginInfo* pRenderPassBegin,
