diff --git a/host/virtio_gpu_frontend.cpp b/host/virtio_gpu_frontend.cpp
index 4c5c3e18..9982c1a7 100644
--- a/host/virtio_gpu_frontend.cpp
+++ b/host/virtio_gpu_frontend.cpp
@@ -825,6 +825,18 @@ int VirtioGpuFrontend::getResourceInfo(uint32_t resourceId,
         return ENOENT;
     }
     auto& resource = resourceIt->second;
+    if (resource.ResourceType() == VirtioGpuResourceType::COLOR_BUFFER) {
+        // Without the info the VMM keeps reading the scanout back instead of importing it.
+        // The feature's default is only a start: an explicit override is honored as given,
+        // otherwise the Vulkan driver must also let the display import the exported image
+        // with an implicit layout.
+        const auto& feature = mFeatures.ScanoutDmabufExport;
+        const bool overridden = feature.getReason().find("Overridden") != std::string::npos;
+        if (!feature.enabled() ||
+            (!overridden && !FrameBuffer::getFB()->supportsImplicitDmabufLayout())) {
+            return EINVAL;
+        }
+    }
     return resource.GetInfo(info);
 }
 
diff --git a/host/virtio_gpu_gfxstream_renderer.cpp b/host/virtio_gpu_gfxstream_renderer.cpp
