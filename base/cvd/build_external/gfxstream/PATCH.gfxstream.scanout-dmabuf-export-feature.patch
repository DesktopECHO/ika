diff --git a/host/virtio_gpu_frontend.cpp b/host/virtio_gpu_frontend.cpp
index 3b5eaaf1..9aaa144b 100644
--- a/host/virtio_gpu_frontend.cpp
+++ b/host/virtio_gpu_frontend.cpp
@@ -825,6 +825,18 @@ int VirtioGpuFrontend::getResourceInfo(uint32_t resourceId,
         return ENOENT;
     }
     auto& resource = resourceIt->second;
+    if (resource.ResourceType() == VirtioGpuResourceType::COLOR_BUFFER) {
+        // Without the info the VMM keeps reading the scanout back instead of importing it.
+        // The feature's default is only a start: an explicit override is honored as given,
+        // otherwise the Vulkan driver must also let the display import the exported image
+        // with an implicit layout.
+        const auto& feature = mFeatures.ScanoutDmabufExport;
+        const bool overridden = feature.getReason().find("Overridden") != std::string::npos;
+        if (!feature.enabled() ||
+            (!overridden && !FrameBuffer::getFB()->supportsImplicitDmabufLayout())) {
+            return EINVAL;
+        }
+    }
     return resource.GetInfo(info);
 }
 
diff --git a/host/virtio_gpu_gfxstream_renderer.cpp b/host/virtio_gpu_gfxstream_renderer.cpp
index f5a4d35b..626d2f31 100644
--- a/host/virtio_gpu_gfxstream_renderer.cpp
+++ b/host/virtio_gpu_gfxstream_renderer.cpp
@@ -133,6 +133,11 @@ ParseGfxstreamFeatures(const int rendererFlags,
     GFXSTREAM_SET_BOOL_FEATURE_ON_CONDITION(&features, ExternalBlob,
                                        rendererFlags & STREAM_RENDERER_FLAGS_USE_EXTERNAL_BLOB ||
                                            features.VulkanAllocateHostVisibleAsUdmabuf.enabled());
+    // The VMM's display imports exported color buffers with an implicit layout (no modifier),
+    // which RADV, Intel and the host GL drivers resolve from the buffer itself; the udmabuf
+    // path (Apple Silicon) has no such layout information, so keep its console on readback.
+    GFXSTREAM_SET_BOOL_FEATURE_ON_CONDITION(&features, ScanoutDmabufExport,
+                                            !features.VulkanAllocateHostVisibleAsUdmabuf.enabled());
     GFXSTREAM_SET_BOOL_FEATURE_ON_CONDITION(&features, VulkanEnsureCachedCoherentMemoryAvailable, true);
 
     for (const std::string& rendererFeature : gfxstream::Split(rendererFeatures, ",;")) {
