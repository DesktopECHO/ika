+    // Hosts that only offer the _non_coherent variant (Mesa on older Intel GPUs)
+    // must not advertise it: guest shaders using it fail to compile there.
+    if (hasExtension(cstring, "GL_EXT_shader_framebuffer_fetch")
             && isGles2Gles()) {
