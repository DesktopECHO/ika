@@ -1805,6 +1805,19 @@ void GLEScontext::releaseGlobalLock() {
     s_lock.unlock();
 }
 
+// Whether the space-separated extension list names |name| exactly. strstr()
+// alone also finds a name inside a longer one, such as
+// GL_EXT_shader_framebuffer_fetch in GL_EXT_shader_framebuffer_fetch_non_coherent.
+static bool hasExtension(const char* extensions, const char* name) {
+    const size_t len = strlen(name);
+    for (const char* p = extensions; (p = strstr(p, name)) != NULL; p += len) {
+        if ((p == extensions || p[-1] == ' ') && (p[len] == ' ' || p[len] == '\0')) {
+            return true;
+        }
+    }
+    return false;
+}
+
 void GLEScontext::initCapsLocked(const GLubyte * extensionString, bool nativeTextureDecompressionEnabled, GLSupport& glSupport)
 {
