                                                       (VkDependencyInfo*)(pDependencyInfo));
                 }
                 if (CC_LIKELY(vk)) {
-                    vk->vkCmdPipelineBarrier2KHR((VkCommandBuffer)dispatchHandle, pDependencyInfo);
+                    // Route through the global state like vkCmdPipelineBarrier2 so emulated
