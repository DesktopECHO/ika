+
+bool VkEmulation::prepareColorBufferForScanout(uint32_t colorBufferHandle) {
+    std::lock_guard<std::mutex> lock(mMutex);
+
+    auto info = gfxstream::base::find(mColorBuffers, colorBufferHandle);
+    if (!info || !info->initialized) {
+        return false;
+    }
+    if (info->scanoutLayout) {
+        return true;
+    }
+    if (!mDeviceInfo.supportsDrmFormatModifier) {
+        return false;
+    }
+    // The memory can only be replaced while nobody else refers to it: no guest image, no GL
+    // texture importing it, no guest mapping, not created host visible (linear, written by
+    // the host through its mapping), and a single color plane. A mapping that exists only
+    // because the device's memory is host visible anyway (unified memory, Apple Silicon) is
+    // handed out to nobody and goes away with the memory.
+    const bool hostVisible = (info->memoryProperty & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) != 0;
+    if (info->guestBound || info->vulkanMode != VkEmulation::VulkanMode::VulkanOnly ||
+        hostVisible || info->memory.gpa != 0u || IsYuvFormat(info->format)) {
+        GFXSTREAM_INFO("ColorBuffer %u keeps its layout: guest bound %d, Vulkan mode %d, host "
+                       "visible %d, guest mapped %d, YUV %d",
+                       colorBufferHandle, info->guestBound ? 1 : 0,
+                       static_cast<int>(info->vulkanMode), hostVisible ? 1 : 0,
+                       info->memory.gpa != 0u ? 1 : 0, IsYuvFormat(info->format) ? 1 : 0);
+        return false;
+    }
+    return migrateColorBufferToDrmModifierLocked(info);
+}
+
+bool VkEmulation::migrateColorBufferToDrmModifierLocked(ColorBufferInfo* info) {
+#if defined(__linux__) && !defined(__ANDROID__)
+    auto vk = mDvk;
+    const VkFormat format = info->imageCreateInfoShallow.format;
+    const uint32_t width = info->imageCreateInfoShallow.extent.width;
+    const uint32_t height = info->imageCreateInfoShallow.extent.height;
+    const VkImageUsageFlags usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                                    VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                                    VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    const VkFormatFeatureFlags requiredFeatures =
+        VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT |
+        VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+
+    auto getFormatProperties2 = mIvk->vkGetPhysicalDeviceFormatProperties2
+                                    ? mIvk->vkGetPhysicalDeviceFormatProperties2
+                                    : mIvk->vkGetPhysicalDeviceFormatProperties2KHR;
+    auto getImageFormatProperties2 = mGetImageFormatProperties2Func
+                                         ? mGetImageFormatProperties2Func
+                                         : mIvk->vkGetPhysicalDeviceImageFormatProperties2;
+    if (!getFormatProperties2 || !getImageFormatProperties2 ||
+        !vk->vkGetImageDrmFormatModifierPropertiesEXT || !vk->vkGetMemoryFdKHR) {
+        return false;
+    }
+
+    // The modifiers the driver can export the format with, for the usage the compositor and
+    // readback need.
+    VkDrmFormatModifierPropertiesListEXT modifierList = {
+        .sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT,
+        .pNext = nullptr,
+        .drmFormatModifierCount = 0,
+        .pDrmFormatModifierProperties = nullptr,
+    };
+    VkFormatProperties2 formatProperties = {
+        .sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2,
+        .pNext = &modifierList,
+    };
+    getFormatProperties2(mPhysicalDevice, format, &formatProperties);
+    std::vector<VkDrmFormatModifierPropertiesEXT> modifierProperties(
+        modifierList.drmFormatModifierCount);
+    modifierList.pDrmFormatModifierProperties = modifierProperties.data();
+    getFormatProperties2(mPhysicalDevice, format, &formatProperties);
+
+    std::vector<uint64_t> modifiers;
+    for (const VkDrmFormatModifierPropertiesEXT& properties : modifierProperties) {
+        if (properties.drmFormatModifierPlaneCount != 1 ||
+            (properties.drmFormatModifierTilingFeatures & requiredFeatures) != requiredFeatures) {
+            continue;
+        }
+        VkPhysicalDeviceExternalImageFormatInfo externalInfo = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+            .pNext = nullptr,
+            .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+        };
+        VkPhysicalDeviceImageDrmFormatModifierInfoEXT modifierInfo = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT,
+            .pNext = &externalInfo,
+            .drmFormatModifier = properties.drmFormatModifier,
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+            .queueFamilyIndexCount = 0,
+            .pQueueFamilyIndices = nullptr,
+        };
+        VkPhysicalDeviceImageFormatInfo2 imageFormatInfo = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+            .pNext = &modifierInfo,
+            .format = format,
+            .type = VK_IMAGE_TYPE_2D,
+            .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+            .usage = usage,
+            .flags = 0,
+        };
+        VkExternalImageFormatProperties externalProperties = {
+            .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+            .pNext = nullptr,
+        };
+        VkImageFormatProperties2 imageFormatProperties = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+            .pNext = &externalProperties,
+        };
+        if (getImageFormatProperties2(mPhysicalDevice, &imageFormatInfo, &imageFormatProperties) !=
+            VK_SUCCESS) {
+            continue;
+        }
+        if (!(externalProperties.externalMemoryProperties.externalMemoryFeatures &
+              VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT)) {
+            continue;
+        }
+        const VkExtent3D& maxExtent = imageFormatProperties.imageFormatProperties.maxExtent;
+        if (maxExtent.width < width || maxExtent.height < height) {
+            continue;
+        }
+        modifiers.push_back(properties.drmFormatModifier);
+    }
+    if (modifiers.empty()) {
+        GFXSTREAM_INFO("ColorBuffer %u: no exportable DRM modifier for %s, keeping its layout",
+                       info->handle, string_VkFormat(format));
+        return false;
+    }
+
+    // The image: the driver picks one of the modifiers.
+    VkExternalMemoryImageCreateInfo externalImageCi = {
+        .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+        .pNext = nullptr,
+        .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+    };
+    VkImageDrmFormatModifierListCreateInfoEXT modifierListCi = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+        .pNext = &externalImageCi,
+        .drmFormatModifierCount = static_cast<uint32_t>(modifiers.size()),
+        .pDrmFormatModifiers = modifiers.data(),
+    };
+    VkImageCreateInfo imageCi = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .pNext = &modifierListCi,
+        .flags = 0,
+        .imageType = VK_IMAGE_TYPE_2D,
+        .format = format,
+        .extent = {.width = width, .height = height, .depth = 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+        .usage = usage,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .queueFamilyIndexCount = 0,
+        .pQueueFamilyIndices = nullptr,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    VkImage image = VK_NULL_HANDLE;
+    VkResult result = vk->vkCreateImage(mDevice, &imageCi, nullptr, &image);
+    if (result != VK_SUCCESS) {
+        GFXSTREAM_ERROR("ColorBuffer %u: failed to create the DRM modifier image: %s",
+                        info->handle, string_VkResult(result));
+        return false;
+    }
+
+    // Dedicated, dma-buf exportable memory.
+    VkMemoryDedicatedRequirements dedicatedRequirements = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_REQUIREMENTS,
+        .pNext = nullptr,
+    };
+    VkMemoryRequirements2 requirements = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+        .pNext = &dedicatedRequirements,
+    };
+    const VkImageMemoryRequirementsInfo2 requirementsInfo = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+        .pNext = nullptr,
+        .image = image,
+    };
+    if (vk->vkGetImageMemoryRequirements2) {
+        vk->vkGetImageMemoryRequirements2(mDevice, &requirementsInfo, &requirements);
+    } else if (vk->vkGetImageMemoryRequirements2KHR) {
+        vk->vkGetImageMemoryRequirements2KHR(mDevice, &requirementsInfo, &requirements);
+    } else {
+        vk->vkGetImageMemoryRequirements(mDevice, image, &requirements.memoryRequirements);
+    }
+    const uint32_t memoryTypeIndex = getValidMemoryTypeIndex(
+        requirements.memoryRequirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    VkMemoryDedicatedAllocateInfo dedicatedAi = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+        .pNext = nullptr,
+        .image = image,
+        .buffer = VK_NULL_HANDLE,
+    };
+    VkExportMemoryAllocateInfo exportAi = {
+        .sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO,
+        .pNext = &dedicatedAi,
+        .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+    };
+    VkMemoryAllocateInfo allocateInfo = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .pNext = &exportAi,
+        .allocationSize = requirements.memoryRequirements.size,
+        .memoryTypeIndex = memoryTypeIndex,
+    };
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    result = vk->vkAllocateMemory(mDevice, &allocateInfo, nullptr, &memory);
+    if (result != VK_SUCCESS) {
+        GFXSTREAM_ERROR("ColorBuffer %u: failed to allocate the DRM modifier image's memory: %s",
+                        info->handle, string_VkResult(result));
+        vk->vkDestroyImage(mDevice, image, nullptr);
+        return false;
+    }
+    result = vk->vkBindImageMemory(mDevice, image, memory, 0);
+    if (result != VK_SUCCESS) {
+        GFXSTREAM_ERROR("ColorBuffer %u: failed to bind the DRM modifier image: %s", info->handle,
+                        string_VkResult(result));
+        vk->vkFreeMemory(mDevice, memory, nullptr);
+        vk->vkDestroyImage(mDevice, image, nullptr);
+        return false;
+    }
+
+    // The dma-buf and its layout.
+    const VkMemoryGetFdInfoKHR getFdInfo = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+        .pNext = nullptr,
+        .memory = memory,
+        .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+    };
+    int fd = -1;
+    result = vk->vkGetMemoryFdKHR(mDevice, &getFdInfo, &fd);
+    VkImageDrmFormatModifierPropertiesEXT chosenModifier = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_PROPERTIES_EXT,
+        .pNext = nullptr,
+        .drmFormatModifier = 0,
+    };
+    if (result == VK_SUCCESS && fd >= 0) {
+        result = vk->vkGetImageDrmFormatModifierPropertiesEXT(mDevice, image, &chosenModifier);
+    }
+    if (result != VK_SUCCESS || fd < 0) {
+        GFXSTREAM_ERROR("ColorBuffer %u: failed to export the DRM modifier image: %s",
+                        info->handle, string_VkResult(result));
+        if (fd >= 0) close(fd);
+        vk->vkFreeMemory(mDevice, memory, nullptr);
+        vk->vkDestroyImage(mDevice, image, nullptr);
+        return false;
+    }
+    const VkImageSubresource planeSubresource = {
+        .aspectMask = VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT,
+        .mipLevel = 0,
+        .arrayLayer = 0,
+    };
+    VkSubresourceLayout planeLayout = {};
+    vk->vkGetImageSubresourceLayout(mDevice, image, &planeSubresource, &planeLayout);
+
+    const VkImageViewCreateInfo imageViewCi = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .image = image,
+        .viewType = VK_IMAGE_VIEW_TYPE_2D,
+        .format = format,
+        .components =
+            {
+                .r = VK_COMPONENT_SWIZZLE_IDENTITY,
+                .g = VK_COMPONENT_SWIZZLE_IDENTITY,
+                .b = VK_COMPONENT_SWIZZLE_IDENTITY,
+                .a = VK_COMPONENT_SWIZZLE_IDENTITY,
+            },
+        .subresourceRange =
+            {
+                .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                .baseMipLevel = 0,
+                .levelCount = 1,
+                .baseArrayLayer = 0,
+                .layerCount = 1,
+            },
+    };
+    VkImageView imageView = VK_NULL_HANDLE;
+    result = vk->vkCreateImageView(mDevice, &imageViewCi, nullptr, &imageView);
+    if (result != VK_SUCCESS) {
+        GFXSTREAM_ERROR("ColorBuffer %u: failed to create the DRM modifier image view: %s",
+                        info->handle, string_VkResult(result));
+        close(fd);
+        vk->vkFreeMemory(mDevice, memory, nullptr);
+        vk->vkDestroyImage(mDevice, image, nullptr);
+        return false;
+    }
+
+    // Keep the content: copy the old image over when it has any.
+    VkImageLayout newLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (info->currentLayout != VK_IMAGE_LAYOUT_UNDEFINED &&
+        info->currentLayout != VK_IMAGE_LAYOUT_PREINITIALIZED) {
+        const VkCommandBufferBeginInfo beginInfo = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            .pNext = nullptr,
+            .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+        };
+        VK_CHECK(vk->vkBeginCommandBuffer(mCommandBuffer, &beginInfo));
+        const VkImageMemoryBarrier barriers[2] = {
+            {
+                .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+                .oldLayout = info->currentLayout,
+                .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = info->image,
+                .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+            },
+            {
+                .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = 0,
+                .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+                .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = image,
+                .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+            },
+        };
+        vk->vkCmdPipelineBarrier(mCommandBuffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                 VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2,
+                                 barriers);
+        const VkImageCopy region = {
+            .srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+            .srcOffset = {0, 0, 0},
+            .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+            .dstOffset = {0, 0, 0},
+            .extent = {width, height, 1},
+        };
+        vk->vkCmdCopyImage(mCommandBuffer, info->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                           image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+        VK_CHECK(vk->vkEndCommandBuffer(mCommandBuffer));
+        const VkSubmitInfo submitInfo = {
+            .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+            .pNext = nullptr,
+            .waitSemaphoreCount = 0,
+            .pWaitSemaphores = nullptr,
+            .pWaitDstStageMask = nullptr,
+            .commandBufferCount = 1,
+            .pCommandBuffers = &mCommandBuffer,
+            .signalSemaphoreCount = 0,
+            .pSignalSemaphores = nullptr,
+        };
+        {
+            gfxstream::base::AutoLock queueLock(*mQueueLock);
+            VK_CHECK(vk->vkQueueSubmit(mQueue, 1, &submitInfo, mCommandBufferFence));
+        }
+        static constexpr uint64_t kMaxWaitNs = 5ULL * 1000ULL * 1000ULL * 1000ULL;
+        VK_CHECK(vk->vkWaitForFences(mDevice, 1, &mCommandBufferFence, VK_TRUE, kMaxWaitNs));
+        VK_CHECK(vk->vkResetFences(mDevice, 1, &mCommandBufferFence));
+        newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    }
+
+    // Retire the old image once nothing uses it any more.
+    {
+        gfxstream::base::AutoLock queueLock(*mQueueLock);
+        VK_CHECK(vk->vkQueueWaitIdle(mQueue));
+    }
+    vk->vkDestroyImageView(mDevice, info->imageView, nullptr);
+    vk->vkDestroyImage(mDevice, info->image, nullptr);
+    freeExternalMemoryLocked(vk, &info->memory);
+    if (Compositor* c = getCompositor()) {
+        c->onImageDestroyed(info->handle);
+    }
+
+    info->image = image;
+    info->imageView = imageView;
+    info->imageCreateInfoShallow = vk_make_orphan_copy(imageCi);
+    info->imageMemReqs = requirements.memoryRequirements;
+    info->currentLayout = newLayout;
+    info->memory = ExternalMemoryInfo{};
+    info->memory.size = requirements.memoryRequirements.size;
+    info->memory.typeIndex = memoryTypeIndex;
+    info->memory.memory = memory;
+    info->memory.dedicatedAllocation = true;
+    info->memory.bindOffset = 0;
+    info->memory.handleInfo = ExternalHandleInfo{
+        .handle = static_cast<ExternalHandleType>(fd),
+        .streamHandleType = STREAM_HANDLE_TYPE_MEM_DMABUF,
+    };
+    info->externalMemoryCompatible = true;
+    info->scanoutLayout = ScanoutLayout{
+        .modifier = chosenModifier.drmFormatModifier,
+        .stride = static_cast<uint32_t>(planeLayout.rowPitch),
+        .offset = static_cast<uint32_t>(planeLayout.offset),
+    };
+    mDebugUtilsHelper.addDebugLabel(image, "ColorBuffer:%d", info->handle);
+    mDebugUtilsHelper.addDebugLabel(imageView, "ColorBuffer:%d", info->handle);
+    mDebugUtilsHelper.addDebugLabel(memory, "ColorBuffer:%d", info->handle);
+    GFXSTREAM_INFO("ColorBuffer %u (%ux%u %s) re-created for scanout: DRM modifier 0x%" PRIx64
+                   ", pitch %u, offset %u",
+                   info->handle, width, height, string_VkFormat(format),
+                   static_cast<uint64_t>(chosenModifier.drmFormatModifier),
+                   static_cast<uint32_t>(planeLayout.rowPitch),
+                   static_cast<uint32_t>(planeLayout.offset));
+    return true;
+#else
+    (void)info;
+    return false;
+#endif
+}
