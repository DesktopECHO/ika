+std::optional<VkEmulation::ScanoutLayout> VkEmulation::getColorBufferScanoutLayout(
+    uint32_t colorBufferHandle) {
+    std::lock_guard<std::mutex> lock(mMutex);
+
+    auto info = gfxstream::base::find(mColorBuffers, colorBufferHandle);
+    if (!info || info->image == VK_NULL_HANDLE) {
+        return std::nullopt;
+    }
+    if (info->scanoutLayout) {
+        return info->scanoutLayout;
+    }
+    if (!supportsImplicitDmabufLayout()) {
+        return std::nullopt;
+    }
+    auto pitch = getColorBufferRowPitchLocked(*info);
+    if (!pitch) {
