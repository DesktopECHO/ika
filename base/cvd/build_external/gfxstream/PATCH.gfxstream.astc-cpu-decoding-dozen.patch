+
+# The decompressor only, for gfxstream's ASTC CPU decoding, the default on
+# Mesa's Dozen (WSL2), whose hosts have AVX2. On x86-64 it is built for AVX2,
+# F16C, POPCNT and SSE4.1, as astc-encoder's own AVX2 build is; gfxstream
+# checks that the CPU has them before calling into it, and on older CPUs
+# decodes on the GPU instead. On aarch64 it uses NEON, which every ARM64 CPU
+# has.
+cc_library(
+    name = "gfxstream_astcenc",
+    srcs = glob(["Source/astcenc_*.cpp"]),
+    hdrs = ["Source/astcenc.h"],
+    # The library's own headers only compile included from its sources, in order.
+    textual_hdrs = glob(
+        ["Source/astcenc_*.h"],
+        exclude = ["Source/astcenc.h"],
+    ),
+    copts = [
+        "-Wno-unused-parameter",
+        "-Wno-unused-function",
+        "-Wno-unused-variable",
+    ] + select({
+        "@platforms//cpu:x86_64": [
+            "-mavx2",
+            "-mf16c",
+            "-mpopcnt",
+            "-msse4.1",
+        ],
+        "//conditions:default": [],
+    }),
+    linkopts = ["-pthread"],
+    local_defines = ["ASTCENC_DECOMPRESS_ONLY"] + select({
+        "@platforms//cpu:x86_64": [
+            "ASTCENC_AVX=2",
+            "ASTCENC_F16C=1",
+            "ASTCENC_NEON=0",
+            "ASTCENC_POPCNT=1",
+            "ASTCENC_SSE=41",
+        ],
+        "//conditions:default": [],
+    }),
+    strip_include_prefix = "Source",
+)
