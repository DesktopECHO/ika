+            reinterpret_cast<VkImage>(uintptr_t{0x4000}), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            regions.size(), regions.data(), mContext);
+    }
+
+    const std::vector<uint8_t>& staged(const std::shared_ptr<AstcStagingBuffer>& staging) {
+        return mDriver.memories.at(staging->memory);
+    }
