+    // An offset that is not block-aligned, a region outside the mip level, layers past the image,
+    // a mip level the image does not have.
+    EXPECT_EQ(copy(*tex, src, {region(0, 0, 0, 0, 0, 1, 2, 0, 4, 4)}), nullptr);
+    EXPECT_EQ(copy(*tex, src, {region(0, 0, 0, 0, 0, 1, 4, 0, 8, 8)}), nullptr);
+    EXPECT_EQ(copy(*tex, src, {region(0, 0, 0, 0, 1, 2, 0, 0, 8, 8)}), nullptr);
+    EXPECT_EQ(copy(*tex, src, {region(0, 0, 0, 1, 0, 1, 0, 0, 4, 4)}), nullptr);
+    // A row length shorter than the region.
+    EXPECT_EQ(copy(*tex, src, {region(0, 4, 0, 0, 0, 1, 0, 0, 8, 8)}), nullptr);
+    // A valid region beside an invalid one records nothing either.
+    EXPECT_EQ(copy(*tex, src,
+                   {region(0, 0, 0, 0, 0, 1, 0, 0, 8, 8), region(0, 0, 0, 0, 0, 1, 2, 0, 4, 4)}),
+              nullptr);
+    EXPECT_TRUE(mDriver.copies.empty());
+    EXPECT_TRUE(mDriver.memories.empty());
+}
+
+TEST_F(AstcTextureTest, StagingBufferIsFreedWithItsLastOwner) {
+    auto tex = texture(8, 8, 1, 1);
+    auto src = taggedBlocks(4);
+    auto staging = copy(*tex, src, {region(0, 0, 0, 0, 0, 1, 0, 0, 8, 8)});
+    ASSERT_NE(staging, nullptr);
+    tex.reset();
+    EXPECT_EQ(mDriver.buffersDestroyed, 0);
+    staging.reset();
+    EXPECT_EQ(mDriver.buffersDestroyed, 1);
+    EXPECT_EQ(mDriver.memoriesFreed, 1);
+    EXPECT_TRUE(mDriver.memories.empty());
+}
+
+// gfxstream's checkerboard from astc_cpu_decompressor_unittest.cpp: 16x16 texels in 8x8 blocks,
+// decoded by astc-encoder, in rows padded to 3 blocks.
+TEST_F(AstcTextureTest, DecodesWithAstcEncoder) {
+    auto& decoder = AstcCpuDecompressor::get();
+    if (!decoder.available()) GTEST_SKIP() << "This CPU lacks the ISA astc-encoder is built for";
+    const uint8_t block[] = {0x44, 0x05, 0x00, 0xfe, 0x01, 0x00, 0x00, 0x00,
+                             0x55, 0xaa, 0x55, 0xaa, 0x55, 0xaa, 0x55, 0xaa};
+    std::vector<uint8_t> src;
+    for (int i = 0; i < 6; ++i) src.insert(src.end(), block, block + sizeof(block));
+    auto tex = texture(16, 16, 1, 1, 8, &decoder);
+    auto staging = copy(*tex, src, {region(0, 24, 0, 0, 0, 1, 0, 0, 16, 16)});
+    ASSERT_NE(staging, nullptr);
+    const auto& texels = staged(staging);
+    for (uint32_t y = 0; y < 16; ++y) {
+        for (uint32_t x = 0; x < 16; ++x) {
+            const uint8_t expected = (x + y) % 2 ? 0 : 0xFF;
+            const uint8_t* t = &texels[(y * 16 + x) * 4];
+            ASSERT_EQ(t[0], expected) << x << "," << y;
+            ASSERT_EQ(t[1], expected) << x << "," << y;
+            ASSERT_EQ(t[2], expected) << x << "," << y;
+            ASSERT_EQ(t[3], 0xFF) << x << "," << y;
+        }
+    }
+}
