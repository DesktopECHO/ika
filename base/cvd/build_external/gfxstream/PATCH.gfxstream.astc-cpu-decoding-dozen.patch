+    ASSERT_NE(staging, nullptr);
+    const auto& texels = staged(staging);
+    EXPECT_EQ(tagAt(texels, 0), 0);
+    EXPECT_EQ(tagAt(texels, 4), 1);
+    EXPECT_EQ(tagAt(texels, 4 * 8), 3);
+    EXPECT_EQ(tagAt(texels, 7 * 8 + 7), 4);
