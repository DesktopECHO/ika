+// A Vulkan driver of host memory: buffers and their memory are heap blocks, and recorded copies
+// are kept for the test to check.
+struct FakeDriver {
+    std::map<VkDeviceMemory, std::vector<uint8_t>> memories;
+    std::map<VkBuffer, VkDeviceSize> buffers;
+    std::vector<std::vector<VkBufferImageCopy>> copies;
+    VkBuffer lastCopySource = VK_NULL_HANDLE;
+    int buffersDestroyed = 0;
+    int memoriesFreed = 0;
+    uint64_t nextHandle = 1;
+};
+FakeDriver* gDriver = nullptr;
+
+template <typename T>
+T fakeHandle() {
+    return reinterpret_cast<T>(static_cast<uintptr_t>(gDriver->nextHandle++));
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL fakeCreateBuffer(VkDevice, const VkBufferCreateInfo* info,
+                                               const VkAllocationCallbacks*, VkBuffer* buffer) {
+    *buffer = fakeHandle<VkBuffer>();
+    gDriver->buffers[*buffer] = info->size;
+    return VK_SUCCESS;
+}
+VKAPI_ATTR void VKAPI_CALL fakeDestroyBuffer(VkDevice, VkBuffer buffer,
+                                             const VkAllocationCallbacks*) {
+    gDriver->buffers.erase(buffer);
+    gDriver->buffersDestroyed++;
+}
+VKAPI_ATTR void VKAPI_CALL fakeGetBufferMemoryRequirements(VkDevice, VkBuffer buffer,
+                                                           VkMemoryRequirements* reqs) {
+    *reqs = {gDriver->buffers[buffer], 4, 1};
+}
+VKAPI_ATTR void VKAPI_CALL fakeGetPhysicalDeviceMemoryProperties(
+    VkPhysicalDevice, VkPhysicalDeviceMemoryProperties* props) {
+    *props = {};
+    props->memoryTypeCount = 1;
+    props->memoryTypes[0].propertyFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                          VK_MEMORY_PROPERTY_HOST_COHERENT_BIT |
+                                          VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+}
+VKAPI_ATTR VkResult VKAPI_CALL fakeAllocateMemory(VkDevice, const VkMemoryAllocateInfo* info,
+                                                 const VkAllocationCallbacks*,
+                                                 VkDeviceMemory* memory) {
+    *memory = fakeHandle<VkDeviceMemory>();
+    gDriver->memories[*memory].assign(info->allocationSize, 0xCD);
+    return VK_SUCCESS;
+}
+VKAPI_ATTR void VKAPI_CALL fakeFreeMemory(VkDevice, VkDeviceMemory memory,
+                                          const VkAllocationCallbacks*) {
+    gDriver->memories.erase(memory);
+    gDriver->memoriesFreed++;
+}
+VKAPI_ATTR VkResult VKAPI_CALL fakeBindBufferMemory(VkDevice, VkBuffer, VkDeviceMemory,
+                                                   VkDeviceSize) {
+    return VK_SUCCESS;
+}
+VKAPI_ATTR VkResult VKAPI_CALL fakeMapMemory(VkDevice, VkDeviceMemory memory, VkDeviceSize offset,
+                                            VkDeviceSize, VkMemoryMapFlags, void** data) {
+    *data = gDriver->memories[memory].data() + offset;
+    return VK_SUCCESS;
+}
+VKAPI_ATTR void VKAPI_CALL fakeUnmapMemory(VkDevice, VkDeviceMemory) {}
+VKAPI_ATTR void VKAPI_CALL fakeCmdCopyBufferToImage(VkCommandBuffer, VkBuffer src, VkImage,
+                                                    VkImageLayout, uint32_t count,
+                                                    const VkBufferImageCopy* regions) {
+    gDriver->lastCopySource = src;
+    gDriver->copies.emplace_back(regions, regions + count);
+}
+
+// Writes, for each texel, the 16-bit tag at the start of the block it is in, so that the test
+// can tell which source block each decoded texel came from.
+class TaggingDecompressor : public AstcCpuDecompressor {
+   public:
+    bool available() const override { return true; }
+    int32_t decompress(uint32_t width, uint32_t height, uint32_t blockWidth, uint32_t blockHeight,
+                       const uint8_t* data, size_t dataLength, uint8_t* output) override {
+        const uint32_t blocksX = (width + blockWidth - 1) / blockWidth;
+        const uint32_t blocksY = (height + blockHeight - 1) / blockHeight;
+        if (dataLength != size_t(blocksX) * blocksY * 16) return 1;
+        for (uint32_t y = 0; y < height; ++y) {
+            for (uint32_t x = 0; x < width; ++x) {
+                const uint8_t* block = data + ((y / blockHeight) * blocksX + x / blockWidth) * 16;
+                uint8_t* texel = output + (size_t(y) * width + x) * 4;
+                texel[0] = block[0];
+                texel[1] = block[1];
+                texel[2] = 0;
+                texel[3] = 0xFF;
+            }
+        }
+        return 0;
+    }
+    const char* getStatusString(int32_t) const override { return "bad length"; }
+};
+
+uint16_t tagAt(const std::vector<uint8_t>& texels, size_t texel) {
+    return texels[texel * 4] | (texels[texel * 4 + 1] << 8);
+}
