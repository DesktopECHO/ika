+TEST_F(AstcTextureTest, PackedMipLevel) {
+    auto tex = texture(8, 8, 1, 1);
+    auto src = taggedBlocks(4);
+    auto staging = copy(*tex, src, {region(0, 0, 0, 0, 0, 1, 0, 0, 8, 8)});
+    ASSERT_NE(staging, nullptr);
+    const auto& texels = staged(staging);
+    EXPECT_EQ(tagAt(texels, 0), 0);
+    EXPECT_EQ(tagAt(texels, 4), 1);
+    EXPECT_EQ(tagAt(texels, 4 * 8), 2);
+    EXPECT_EQ(tagAt(texels, 7 * 8 + 7), 3);
+    ASSERT_EQ(mDriver.copies.size(), 1u);
+    const VkBufferImageCopy& c = mDriver.copies[0][0];
+    EXPECT_EQ(c.bufferOffset, 0u);
+    EXPECT_EQ(c.bufferRowLength, 0u);
+    EXPECT_EQ(c.imageExtent.width, 8u);
+    EXPECT_EQ(mDriver.lastCopySource, staging->buffer);
+}
