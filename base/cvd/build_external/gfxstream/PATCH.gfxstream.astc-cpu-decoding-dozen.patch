+class AstcTextureTest : public ::testing::Test {
+   protected:
+    void SetUp() override {
+        gDriver = &mDriver;
+        mVk.vkCreateBuffer = fakeCreateBuffer;
+        mVk.vkDestroyBuffer = fakeDestroyBuffer;
+        mVk.vkGetBufferMemoryRequirements = fakeGetBufferMemoryRequirements;
+        mVk.vkGetPhysicalDeviceMemoryProperties = fakeGetPhysicalDeviceMemoryProperties;
+        mVk.vkAllocateMemory = fakeAllocateMemory;
+        mVk.vkFreeMemory = fakeFreeMemory;
+        mVk.vkBindBufferMemory = fakeBindBufferMemory;
+        mVk.vkMapMemory = fakeMapMemory;
+        mVk.vkUnmapMemory = fakeUnmapMemory;
+        mVk.vkCmdCopyBufferToImage = fakeCmdCopyBufferToImage;
+    }
+    void TearDown() override { gDriver = nullptr; }
+
+    std::unique_ptr<AstcTexture> texture(uint32_t width, uint32_t height, uint32_t mipLevels,
+                                         uint32_t layers, uint32_t block = 4,
+                                         AstcCpuDecompressor* decompressor = nullptr) {
+        return std::make_unique<AstcTexture>(
+            &mVk, reinterpret_cast<VkDevice>(uintptr_t{0x1000}),
+            reinterpret_cast<VkPhysicalDevice>(uintptr_t{0x2000}), VkExtent3D{width, height, 1},
+            mipLevels, layers, block, block, decompressor ? decompressor : &mDecompressor);
+    }
+
+    // A source buffer of `blocks` 16-byte blocks, each tagged with its index.
+    static std::vector<uint8_t> taggedBlocks(size_t blocks) {
+        std::vector<uint8_t> data(blocks * 16, 0);
+        for (size_t i = 0; i < blocks; ++i) {
+            data[i * 16] = i & 0xFF;
+            data[i * 16 + 1] = (i >> 8) & 0xFF;
+        }
+        return data;
+    }
+
+    static VkBufferImageCopy region(VkDeviceSize offset, uint32_t rowLength, uint32_t imageHeight,
+                                    uint32_t mip, uint32_t baseLayer, uint32_t layers, int32_t x,
+                                    int32_t y, uint32_t w, uint32_t h) {
+        return {offset,
+                rowLength,
+                imageHeight,
+                {VK_IMAGE_ASPECT_COLOR_BIT, mip, baseLayer, layers},
+                {x, y, 0},
+                {w, h, 1}};
+    }
+
+    std::shared_ptr<AstcStagingBuffer> copy(AstcTexture& tex, const std::vector<uint8_t>& src,
+                                            std::vector<VkBufferImageCopy> regions) {
+        return tex.on_vkCmdCopyBufferToImage(
