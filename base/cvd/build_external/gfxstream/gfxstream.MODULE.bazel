git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "gfxstream",
    commit = "ebe5b424e15c0816f64b97c9691060333bb43c7e",
    remote = "https://github.com/google/gfxstream.git",
    patch_strip = 1,
    patches = [
        "@//build_external/gfxstream:PATCH.gfxstream.protobuf-deprecation-warning.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.blob_page_size_runtime.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.gles1-alpha-test-core-profile.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.linux_udmabuf_creator.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.memfd_udmabuf_seals.patch",
        # Keep the advertised Vulkan feature/extension set internally
        # consistent on both RADV and Honeykrisp hosts.
        "@//build_external/gfxstream:PATCH.gfxstream.vulkan-cts-correctness.patch",
        # Sparse images cannot use the multi-image compressed-texture emulation
        # layout; retain native host sparse compressed formats when supported.
        "@//build_external/gfxstream:PATCH.gfxstream.sparse-astc-native.patch",
        # Sparse binding is device-wide. Hide it only when an advertised
        # compressed-format set depends on emulation rather than host support.
        "@//build_external/gfxstream:PATCH.gfxstream.sparse-compressed-feature-contract.patch",
        # VkImageToMemoryCopy/VkMemoryToImageCopy::pHostPointer is marshalled as a
        # single byte, so the host would hand the driver a 1-byte buffer to write a
        # whole image through. Refuse the call instead of corrupting the heap.
        "@//build_external/gfxstream:PATCH.gfxstream.host-image-copy-refuse-unmarshalled.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.opengles-3.2.patch",
        # Last-resort cleanup for Vulkan instances which survive normal
        # per-context teardown, before the renderer closes its DRM file.
        "@//build_external/gfxstream:PATCH.gfxstream.force-vulkan-cleanup-on-teardown.patch",
        # The ETC2/ASTC decompression dispatch pushes its own constants; replay
        # the guest's push constants afterwards so RADV does not run the next
        # draw with the decompression parameters (Asphalt 8 black 3D world).
        "@//build_external/gfxstream:PATCH.gfxstream.decompression-restore-push-constants.patch",
        # Guests record image barriers with vkCmdPipelineBarrier2KHR; route it
        # through the global state so emulated textures are decompressed too.
        "@//build_external/gfxstream:PATCH.gfxstream.pipeline-barrier2khr-decompression.patch",
        # Per-mip vkCmdCopyBufferToImage2 info for emulated compressed images
        # was built from an uninitialized struct (srcBuffer, layout, sType).
        "@//build_external/gfxstream:PATCH.gfxstream.copy-buffer-to-image2-init.patch",
        # Round texel row length/image height up to whole compressed blocks,
        # matching the rounded-up copy extent (e.g. 128-wide ASTC 6x6).
        "@//build_external/gfxstream:PATCH.gfxstream.compressed-row-length-round-up.patch",
    ],
)
