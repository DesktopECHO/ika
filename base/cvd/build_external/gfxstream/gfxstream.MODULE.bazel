git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "gfxstream",
    commit = "9068c3aa805e92bc7d425ad6fee6dec2af4a4024",
    remote = "https://github.com/google/gfxstream.git",
    patch_strip = 1,
    patches = [
        "@//build_external/gfxstream:PATCH.gfxstream.blob_page_size_runtime.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.gles1-alpha-test-core-profile.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.linux_udmabuf_creator.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.memfd_udmabuf_seals.patch",
        # Keep the advertised Vulkan feature/extension set internally
        # consistent on both RADV and Honeykrisp hosts.
        "@//build_external/gfxstream:PATCH.gfxstream.vulkan-cts-correctness.patch",
        # Sparse images cannot use the multi-image compressed-texture emulation
        # layout; retain native host sparse compressed formats when supported.
        "@//build_external/gfxstream:PATCH.gfxstream.sparse-astc-native.patch",
        # Sparse binding is device-wide. Hide it only when an advertised
        # compressed-format set depends on emulation rather than host support.
        "@//build_external/gfxstream:PATCH.gfxstream.sparse-compressed-feature-contract.patch",
        "@//build_external/gfxstream:PATCH.gfxstream.opengles-3.2.patch",
        # Last-resort cleanup for Vulkan instances which survive normal
        # per-context teardown, before the renderer closes its DRM file.
        "@//build_external/gfxstream:PATCH.gfxstream.force-vulkan-cleanup-on-teardown.patch",
    ],
)
