Patch summary:
Allocate a virtio-gpu resource's linear transfer buffer on first use instead
of when guest backing is attached. The zero-filled buffer is as large as the
resource (about 28 MB per 3456x2160 color buffer) and only TransferToHost /
TransferFromHost use it, which the Vulkan guest path rarely sends, so every
guest color buffer used to cost a full extra copy of host memory. The buffer
keeps its size (the attached iovs' total) and zero-filled initial contents.

diff --git a/host/virtio_gpu_resource.cpp b/host/virtio_gpu_resource.cpp
index efa18a1..fe47cce 100644
--- a/host/virtio_gpu_resource.cpp
+++ b/host/virtio_gpu_resource.cpp
@@ -342,15 +342,27 @@ void VirtioGpuResource::AttachIov(struct iovec* iov, uint32_t num_iovs) {
     mIovs.clear();
     mLinear.clear();
 
-    size_t linearSize = 0;
     if (num_iovs) {
         mIovs.reserve(num_iovs);
         for (uint32_t i = 0; i < num_iovs; ++i) {
             mIovs.push_back(iov[i]);
-            linearSize += iov[i].iov_len;
         }
     }
+}
 
+// The linear buffer stages transfers between the guest's backing pages and
+// the host resource. Most resources never see a transfer, and a zero-filled
+// copy made at attach time costs as much host memory as the resource itself
+// (about 28 MB for each 3456x2160 color buffer), so it is allocated on first
+// use instead, with the same size and initial contents.
+void VirtioGpuResource::EnsureLinear() {
+    if (!mLinear.empty()) {
+        return;
+    }
+    size_t linearSize = 0;
+    for (const struct iovec& iov : mIovs) {
+        linearSize += iov.iov_len;
+    }
     if (linearSize > 0) {
         mLinear.resize(linearSize, 0);
     }
@@ -495,6 +507,8 @@ int VirtioGpuResource::GetCaching(uint32_t* outCaching) const {
 // copy into display buffers.
 int VirtioGpuResource::TransferRead(uint64_t offset, stream_renderer_box* box,
                                     std::optional<std::vector<struct iovec>> iovs) {
+    EnsureLinear();
+
     // First, copy from the underlying backend resource to this resource's linear buffer:
     int ret = 0;
     if (mResourceType == VirtioGpuResourceType::BLOB) {
@@ -530,6 +544,8 @@ int VirtioGpuResource::TransferRead(uint64_t offset, stream_renderer_box* box,
 // Corresponds to Virtio GPU "TransferToHost" commands.
 int VirtioGpuResource::TransferWrite(uint64_t offset, stream_renderer_box* box,
                                      std::optional<std::vector<struct iovec>> iovs) {
+    EnsureLinear();
+
