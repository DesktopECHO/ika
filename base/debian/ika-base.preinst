#!/bin/sh

set -e

# ika-lineageos' postinst links each ROM etc/ entry that ika-base does not ship
# into /usr/lib/cuttlefish-common. ika-base now ships etc/cvd_config as a
# directory, and an old link to the ROM's copy would send its files into
# ika-lineageos' tree, so remove that link before the files go in.
link=/usr/lib/cuttlefish-common/etc/cvd_config
if [ -L "$link" ]; then
  case "$(readlink "$link")" in
    /usr/share/cuttlefish-common/lineageos/*) rm -f "$link" ;;
  esac
fi

#DEBHELPER#

exit 0
