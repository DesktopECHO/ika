# yad installs an icon browser with a desktop entry, which the application
# menu, and on WSL2 the Windows Start menu, shows beside Ika: set it aside
# whenever yad installs it. ika-base.install sets it aside when yad was there
# first and puts it back when ika-base is removed.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/applications/yad-icon-browser.desktop

[Action]
Description = Hiding yad's Icon Browser from the application menu...
When = PostTransaction
Exec = /usr/bin/mv -f /usr/share/applications/yad-icon-browser.desktop /usr/share/applications/yad-icon-browser.desktop.ika-hidden
