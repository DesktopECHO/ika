# Removes the desktop entry of yad's icon browser that
# ika-hide-yad-icon-browser.hook set aside, along with yad.
[Trigger]
Operation = Remove
Type = Path
Target = usr/share/applications/yad-icon-browser.desktop

[Action]
Description = Removing yad's hidden Icon Browser entry...
When = PostTransaction
Exec = /usr/bin/rm -f /usr/share/applications/yad-icon-browser.desktop.ika-hidden
