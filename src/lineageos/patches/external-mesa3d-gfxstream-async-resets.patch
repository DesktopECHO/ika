Patch summary:
gfxstream's guest encoder no longer waits for the result of vkResetCommandPool
and vkResetFences; it flushes the command and returns VK_SUCCESS. Both can only
fail for lack of memory, and 3DMark Wild Life Extreme resets about 40 command
pools and fences per frame, each a synchronous round trip to the host. Needs the
host's PATCH.gfxstream.async-reset-command-pool-fences.patch, which stops
sending those results. Takes effect together with
external-mesa3d-gfxstream-command-buffer-ring-chunks.patch: either one alone
leaves the guest waiting for the host at every command buffer.

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -3174,8 +3174,10 @@
         }
         *streamPtrPtr += 8 * fenceCount;
     }
-    VkResult vkResetFences_VkResult_return = (VkResult)0;
-    stream->read(&vkResetFences_VkResult_return, sizeof(VkResult));
+    // The host sends no result for vkResetFences: it can only fail for lack of
+    // memory, and waiting for it cost a round trip per call.
+    VkResult vkResetFences_VkResult_return = VK_SUCCESS;
+    stream->flush();
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
@@ -4607,8 +4609,10 @@
     *streamPtrPtr += 1 * 8;
     memcpy(*streamPtrPtr, (VkCommandPoolResetFlags*)&local_flags, sizeof(VkCommandPoolResetFlags));
     *streamPtrPtr += sizeof(VkCommandPoolResetFlags);
-    VkResult vkResetCommandPool_VkResult_return = (VkResult)0;
-    stream->read(&vkResetCommandPool_VkResult_return, sizeof(VkResult));
+    // The host sends no result for vkResetCommandPool: it can only fail for lack of
+    // memory, and waiting for it cost a round trip per call.
+    VkResult vkResetCommandPool_VkResult_return = VK_SUCCESS;
+    stream->flush();
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
