index d7035ca8c6cbb6d981db099a8cdc9ec2f9144828..859781bde4b53449c84a932d4c6ba64295143784 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -8112,6 +8112,47 @@ void ResourceTracker::on_vkCmdPipelineBarrier(
                               updatedImageMemoryBarriers.data(), true /* do lock */);
 }
 
+// The synchronization2 form of the AHardwareBuffer layout workaround in
+// on_vkCmdPipelineBarrier() above.
+static VkDependencyInfo preserveImportedAhbImageLayouts(
+    const VkDependencyInfo* pDependencyInfo,
+    std::vector<VkImageMemoryBarrier2>& updatedImageMemoryBarriers) {
+    VkDependencyInfo updatedDependencyInfo = *pDependencyInfo;
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+    updatedImageMemoryBarriers.assign(
+        pDependencyInfo->pImageMemoryBarriers,
+        pDependencyInfo->pImageMemoryBarriers + pDependencyInfo->imageMemoryBarrierCount);
+    for (VkImageMemoryBarrier2& barrier : updatedImageMemoryBarriers) {
+        if (barrier.srcQueueFamilyIndex != barrier.dstQueueFamilyIndex &&
+            (barrier.srcQueueFamilyIndex == VK_QUEUE_FAMILY_EXTERNAL ||
+             barrier.srcQueueFamilyIndex == VK_QUEUE_FAMILY_FOREIGN_EXT) &&
+            barrier.oldLayout == VK_IMAGE_LAYOUT_UNDEFINED) {
+            barrier.oldLayout = barrier.newLayout;
+        }
+    }
+    updatedDependencyInfo.pImageMemoryBarriers = updatedImageMemoryBarriers.data();
+#endif
+    return updatedDependencyInfo;
+}
+
+void ResourceTracker::on_vkCmdPipelineBarrier2(void* context, VkCommandBuffer commandBuffer,
+                                               const VkDependencyInfo* pDependencyInfo) {
+    VkEncoder* enc = (VkEncoder*)context;
+    std::vector<VkImageMemoryBarrier2> updatedImageMemoryBarriers;
+    VkDependencyInfo updatedDependencyInfo =
+        preserveImportedAhbImageLayouts(pDependencyInfo, updatedImageMemoryBarriers);
+    enc->vkCmdPipelineBarrier2(commandBuffer, &updatedDependencyInfo, true /* do lock */);
+}
+
+void ResourceTracker::on_vkCmdPipelineBarrier2KHR(void* context, VkCommandBuffer commandBuffer,
+                                                  const VkDependencyInfo* pDependencyInfo) {
+    VkEncoder* enc = (VkEncoder*)context;
+    std::vector<VkImageMemoryBarrier2> updatedImageMemoryBarriers;
+    VkDependencyInfo updatedDependencyInfo =
+        preserveImportedAhbImageLayouts(pDependencyInfo, updatedImageMemoryBarriers);
+    enc->vkCmdPipelineBarrier2KHR(commandBuffer, &updatedDependencyInfo, true /* do lock */);
+}
+
 void ResourceTracker::on_vkCmdClearColorImage(void* context, VkCommandBuffer commandBuffer,
                                               VkImage image, VkImageLayout imageLayout,
                                               const VkClearColorValue* pColor, uint32_t rangeCount,
