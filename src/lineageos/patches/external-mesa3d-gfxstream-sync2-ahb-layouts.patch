--- a/src/gfxstream/codegen/scripts/cereal/functable.py
+++ b/src/gfxstream/codegen/scripts/cereal/functable.py
@@ -88,6 +88,8 @@ RESOURCE_TRACKER_ENTRIES = [
     "vkAllocateCommandBuffers",
     "vkQueueSignalReleaseImageANDROID",
