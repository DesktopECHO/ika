+// Called on every pass of a loop that waits for the host: for a reply, for the
+// host to drain the ring, or for room in it. The host cannot wake the guest, so
+// a waiting thread polls. For the first kSpinNs of a wait it only yields, as a
+// fast reply comes back in microseconds; after that it sleeps between polls, in
+// steps doubling up to kMaxSleepUs. Spinning through a whole slow wait, such as
+// the composer's compose call every frame, kept a vCPU busy, and on the host the
+// core under it, for as long as the host took.
 void AddressSpaceStream::backoff() {
-    static const uint32_t kBackoffItersThreshold = 50000000;
-    static const uint32_t kBackoffFactorDoublingIncrement = 50000000;
-    ++m_backoffIters;
-
-    if (m_backoffIters > kBackoffItersThreshold) {
-        usleep(m_backoffFactor);
-        uint32_t itersSoFarAfterThreshold = m_backoffIters - kBackoffItersThreshold;
-        if (itersSoFarAfterThreshold > kBackoffFactorDoublingIncrement) {
-            m_backoffFactor = m_backoffFactor << 1;
-            if (m_backoffFactor > 1000) m_backoffFactor = 1000;
-            m_backoffIters = kBackoffItersThreshold;
-        }
+    static const uint64_t kSpinNs = 200000;
+    static const uint64_t kMaxSleepUs = 200;
+
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const uint64_t nowNs = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+
+    if (m_backoffIters++ == 0) {
+        m_backoffStartNs = nowNs;
+        return;
+    }
+    if (nowNs - m_backoffStartNs < kSpinNs) {
+        return;
+    }
+    usleep(m_backoffFactor);
+    if (m_backoffFactor < kMaxSleepUs) {
+        m_backoffFactor = m_backoffFactor * 2 < kMaxSleepUs ? m_backoffFactor * 2 : kMaxSleepUs;
     }
 }
 
