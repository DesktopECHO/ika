Patch summary:
User builds: adb key authorization; rkp_only=0.
No remote key provisioning server: Google's rejects these devices, and RKPD
retried it in the background; Keystore keeps the device's own attestation keys.

diff --git a/shared/device.mk b/shared/device.mk
--- a/shared/device.mk
+++ b/shared/device.mk
@@ -72,15 +72,9 @@ PRODUCT_PRODUCT_PROPERTIES += \
 PRODUCT_PRODUCT_PROPERTIES += \
-    remote_provisioning.hostname=preprod-remoteprovisioning.googleapis.com \
     persist.adb.tcp.port=5555 \
     ro.com.google.locationfeatures=1 \
     persist.sys.fuse.passthrough.enable=true \
-    remote_provisioning.tee.rkp_only=1
+    remote_provisioning.tee.rkp_only=0
 
-# Until we support adb keys on user builds, and fix logcat over serial,
-# spawn adbd by default without authorization for "adb logcat"
 ifeq ($(TARGET_BUILD_VARIANT),user)
-PRODUCT_PRODUCT_PROPERTIES += \
-    ro.adb.secure=0
-
 PRODUCT_PACKAGES += \
     logpersist.start
