+namespace {
+
+template <typename T>
+uint64_t bitsOf(T value) {
+    uint64_t bits = 0;
+    static_assert(sizeof(T) <= sizeof(bits));
+    memcpy(&bits, &value, sizeof(value));
+    return bits;
+}
+
+// Describes what a host composition of these layers draws: when nothing in it
+// changed and no layer has new contents, the same picture would be composed
+// and posted again.
+std::vector<uint64_t> describeHostComposition(Display* display,
+                                              const std::vector<Layer*>& layers) {
+    std::vector<uint64_t> words;
+    words.push_back(display->hasColorTransform());
+    // SurfaceFlinger draws client composition into a new client target buffer
+    words.push_back(reinterpret_cast<uintptr_t>(display->getClientTarget().getBuffer()));
+    for (auto layer : layers) {
+        const Composition type = layer->getCompositionType();
+        if (type != Composition::DEVICE && type != Composition::SOLID_COLOR) {
+            continue;
+        }
+        const common::Rect frame = layer->getDisplayFrame();
+        const common::FRect crop = layer->getSourceCrop();
+        const Color color = layer->getColor();
+        words.insert(words.end(), {
+            static_cast<uint64_t>(layer->getId()),
+            static_cast<uint64_t>(type),
+            reinterpret_cast<uintptr_t>(layer->getBuffer().getBuffer()),
+            bitsOf(frame.left), bitsOf(frame.top), bitsOf(frame.right), bitsOf(frame.bottom),
+            bitsOf(crop.left), bitsOf(crop.top), bitsOf(crop.right), bitsOf(crop.bottom),
+            static_cast<uint64_t>(layer->getBlendMode()),
+            bitsOf(layer->getPlaneAlpha()),
+            bitsOf(layer->getBrightness()),
+            bitsOf(color.r), bitsOf(color.g), bitsOf(color.b), bitsOf(color.a),
+            static_cast<uint64_t>(layer->getTransform()),
+            bitsOf(layer->getZOrder()),
+        });
+    }
+    return words;
+}
+
+bool hasModifiedContent(const std::vector<Layer*>& layers) {
+    for (auto layer : layers) {
+        if (layer->getCompositionType() == Composition::DEVICE && layer->isContentModified()) {
+            return true;
+        }
+    }
+    return false;
+}
