Patch summary:
llvmpipe: give freed memory back from the allocation memfd.

llvmpipe_free_memory() returned the range to llvmpipe's heap, but its pages
stayed allocated in the memfd, so a long-running process (SurfaceFlinger, a
compositor) kept filling up RAM. Punches a hole for the freed range.
Backport of Mesa staging/26.3 2afb036732d (main fa7270894217, "llvmpipe:
release freed memory from the allocation memfd", not in 26.3.0-rc3); drop it
when the Mesa pin includes it.

diff --git a/src/gallium/drivers/llvmpipe/lp_texture.c b/src/gallium/drivers/llvmpipe/lp_texture.c
index e35af222cc0..c8707c0ada7 100644
--- a/src/gallium/drivers/llvmpipe/lp_texture.c
+++ b/src/gallium/drivers/llvmpipe/lp_texture.c
@@ -65,6 +65,10 @@
 #include "drm-uapi/drm_fourcc.h"
 #endif
 
+#if DETECT_OS_LINUX
+#include <fcntl.h>
+#endif
+
 #if defined(HAVE_LIBDRM) && defined(HAVE_LINUX_UDMABUF_H)
 #include <fcntl.h>
 #include <sys/mman.h>
@@ -1385,6 +1389,8 @@ llvmpipe_free_memory(struct pipe_screen *pscreen,
    if (mem->fd >= 0) {
       mtx_lock(&screen->mem_mutex);
       util_vma_heap_free(&screen->mem_heap, mem->offset, mem->size);
+      fallocate(screen->fd_mem_alloc, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE,
+                mem->offset, mem->size);
       mtx_unlock(&screen->mem_mutex);
    }
 
