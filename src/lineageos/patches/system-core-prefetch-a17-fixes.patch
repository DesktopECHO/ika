Patch summary:
Android 17's boot prefetch fixes: no record or replay on the first boot after
an update or rollback (7c26e64), recovery when the fingerprint file is missing
(4093179), and a separate build fingerprint for APEX prefetching (43f6a48).

diff --git a/init/libprefetch/prefetch/prefetch.rc b/init/libprefetch/prefetch/prefetch.rc
--- a/init/libprefetch/prefetch/prefetch.rc
+++ b/init/libprefetch/prefetch/prefetch.rc
@@ -36,13 +36,13 @@
     disabled
     oneshot
 
-service prefetch_apex_record /system/bin/prefetch record --duration ${ro.prefetch_boot.duration_s:-0} --include-mount-prefix /apex --tracing-instance prefetch_apex
+service prefetch_apex_record /system/bin/prefetch record --duration ${ro.prefetch_boot.duration_s:-0} --include-mount-prefix /apex --tracing-instance prefetch_apex --build-fingerprint-path /metadata/prefetch/apex_build_fingerprint
     user root
     group root system
     disabled
     oneshot
 
-service prefetch_apex_replay /system/bin/prefetch replay --io-depth ${ro.prefetch_boot.io_depth:-2} --max-fds ${ro.prefetch_boot.max_fds:-1024} --path /metadata/prefetch/prefetch_apex.pack
+service prefetch_apex_replay /system/bin/prefetch replay --io-depth ${ro.prefetch_boot.io_depth:-2} --max-fds ${ro.prefetch_boot.max_fds:-1024} --path /metadata/prefetch/prefetch_apex.pack --build-fingerprint-path /metadata/prefetch/apex_build_fingerprint
     user root
     group root system
     disabled
