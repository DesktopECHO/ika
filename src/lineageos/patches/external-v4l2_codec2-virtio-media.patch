+// A decoder is listed under its 4K name, which media_codecs_c2.xml gives 4K
+// limits, only when a device decodes pictures up to 4096x4096 and its input
+// buffers hold a 4K keyframe. Otherwise it keeps its 1080p limits, and apps
+// play larger video with the software decoders.
+constexpr int kUhdMaxDimension = 4096;
+constexpr size_t kUhdInputBufferSize = 4 * 1024 * 1024;
+
+bool decodesUhd(VideoCodec codec) {
+    const uint32_t pixFmt = V4L2Device::videoCodecToPixFmt(codec);
+    const ui::Size maxSize = V4L2Device::getMaxDecodeResolution(pixFmt);
+    const size_t inputBufferSize =
+            V4L2Device::getDecodeInputBufferSize(pixFmt, kUhdInputBufferSize);
+    const bool uhd = maxSize.width >= kUhdMaxDimension && maxSize.height >= kUhdMaxDimension &&
+                     inputBufferSize >= kUhdInputBufferSize;
+    ALOGI("%s: device decodes up to %dx%d with %zu-byte input buffers, listing it for %s",
+          VideoCodecToString(codec), maxSize.width, maxSize.height, inputBufferSize,
+          uhd ? "4K" : "1080p");
+    return uhd;
+}
+
