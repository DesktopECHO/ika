+// Output buffers the decoder holds when the device cannot report it: the 16
+// reference frames of the largest H.264 DPB, plus the picture being decoded.
+constexpr int kDefaultMinBuffersForCapture = 17;
+
+bool isYTiledFourcc(uint32_t fourcc) {
+    return fourcc == kNV12YTiledFourcc || fourcc == kNV12YTiledSwizzledFourcc;
+}
+
+// Copies the first |rows| rows of a plane in swizzled Y tiles into a linear plane, |width| bytes
+// of each. Y tiles are columns of 16 bytes by 32 rows side by side, and swizzling swaps rows y and
+// y ^ 4 of every odd column. libyuv's Detile functions take unswizzled tiles only.
+void detileSwizzledPlane(const uint8_t* src, int srcStride, uint8_t* dst, int dstStride, int width,
+                         int rows) {
+    for (int y = 0; y < rows; ++y) {
+        // Row y of the even columns of this row of tiles, and row y ^ 4 of the odd ones.
+        const uint8_t* tileRow = src + static_cast<size_t>(y / 32) * srcStride * 32;
+        const uint8_t* even = tileRow + (y % 32) * 16;
+        const uint8_t* odd = tileRow + 512 + ((y % 32) ^ 4) * 16;
+        uint8_t* out = dst + static_cast<size_t>(y) * dstStride;
+        int x = 0;
+        // Whole pairs of columns in fixed-size copies, which the compiler inlines.
+        for (; x + 32 <= width; x += 32, even += 1024, odd += 1024) {
+            memcpy(out + x, even, 16);
+            memcpy(out + x + 16, odd, 16);
+        }
+        if (x < width) memcpy(out + x, even, std::min(16, width - x));
+        if (x + 16 < width) memcpy(out + x + 16, odd, width - x - 16);
+    }
+}
