+// static
+bool V4L2Device::hasDeviceFor(Type type, uint32_t pixFmt) {
+    for (const auto& info : getDeviceInfosForType(type)) {
+        if (std::find(info.second.begin(), info.second.end(), pixFmt) != info.second.end())
+            return true;
+    }
+    return false;
+}
+
+// static
+ui::Size V4L2Device::getMaxDecodeResolution(uint32_t pixFmt) {
+    ui::Size maxResolution(0, 0);
+    for (const auto& info : getDeviceInfosForType(Type::kDecoder)) {
+        if (std::find(info.second.begin(), info.second.end(), pixFmt) == info.second.end())
+            continue;
+
+        scoped_refptr<V4L2Device> device = V4L2Device::create();
+        if (!device->openDevicePath(info.first, Type::kDecoder)) continue;
+
+        ui::Size minSize, maxSize;
+        device->getSupportedResolution(pixFmt, &minSize, &maxSize);
+        device->closeDevice();
+        if (maxSize.width >= maxResolution.width && maxSize.height >= maxResolution.height)
+            maxResolution = maxSize;
+    }
+    return maxResolution;
+}
+
+// static
+size_t V4L2Device::getDecodeInputBufferSize(uint32_t pixFmt, size_t requestedSize) {
+    size_t bufferSize = 0;
+    for (const auto& info : getDeviceInfosForType(Type::kDecoder)) {
+        if (std::find(info.second.begin(), info.second.end(), pixFmt) == info.second.end())
+            continue;
+
+        scoped_refptr<V4L2Device> device = V4L2Device::create();
+        if (!device->openDevicePath(info.first, Type::kDecoder)) continue;
+
+        // The same request V4L2Decoder makes before it allocates input buffers.
+        struct v4l2_format format;
+        memset(&format, 0, sizeof(format));
+        format.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+        format.fmt.pix_mp.pixelformat = pixFmt;
+        format.fmt.pix_mp.num_planes = 1;
+        format.fmt.pix_mp.plane_fmt[0].sizeimage = base::checked_cast<__u32>(requestedSize);
+        if (device->ioctl(VIDIOC_S_FMT, &format) == 0) {
+            bufferSize = std::max(bufferSize,
+                                  static_cast<size_t>(format.fmt.pix_mp.plane_fmt[0].sizeimage));
+        }
+        device->closeDevice();
+    }
+    return bufferSize;
+}
