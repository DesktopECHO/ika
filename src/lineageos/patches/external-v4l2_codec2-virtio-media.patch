+bool V4L2Decoder::queueMmapInput(V4L2WritableBufferRef inputBuffer) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    auto request = std::move(mDecodeRequests.front());
+    mDecodeRequests.pop();
+
+    const int32_t bitstreamId = request.buffer->id;
+    const size_t size = request.buffer->size;
+    ALOGV("QBUF to input queue, bitstreadId=%d", bitstreamId);
+    if (size > inputBuffer.getPlaneSize(0)) {
+        ALOGE("The input size (%zu) is not enough, we need %zu", inputBuffer.getPlaneSize(0),
+              size);
+        return false;
+    }
+
+    // The view starts at the block's offset.
+    C2ReadView view = request.buffer->dmabuf.map().get();
+    void* dst = inputBuffer.getPlaneMapping(0);
+    if (view.error() != C2_OK || view.capacity() < size || dst == nullptr) {
+        ALOGE("%s(): Failed to map the bitstream or input buffer, bitstreamId=%d", __func__,
+              bitstreamId);
+        return false;
+    }
+    memcpy(dst, view.data(), size);
+
+    inputBuffer.setTimeStamp({.tv_sec = bitstreamId});
+    inputBuffer.setPlaneDataOffset(0, 0);
+    inputBuffer.setPlaneBytesUsed(0, size);
+    if (!std::move(inputBuffer).queueMMap()) {
+        ALOGE("%s(): Failed to QBUF to input queue, bitstreamId=%d", __func__, bitstreamId);
+        return false;
+    }
+
+    mPendingDecodeCbs.insert(std::make_pair(bitstreamId, std::move(request.decodeCb)));
+    mLastQueuedBitstreamId = bitstreamId;
+    return true;
+}
+
+bool V4L2Decoder::queueMmapOutputBuffers() {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    for (;;) {
+        std::optional<V4L2WritableBufferRef> buffer = mOutputQueue->getFreeBuffer();
+        if (!buffer) return true;
+        if (!std::move(*buffer).queueMMap()) {
+            ALOGE("%s(): Failed to QBUF to output queue", __func__);
+            return false;
+        }
+    }
+}
+
+void V4L2Decoder::onMmapVideoFrameReady(std::unique_ptr<VideoFrame> frame) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    // A flush dropped the picture this block was fetched for.
+    if (mDecodedMmapBuffers.empty()) return;
+
+    V4L2ReadableBufferRef buffer = std::move(mDecodedMmapBuffers.front());
+    mDecodedMmapBuffers.pop();
+    const size_t bufferId = buffer->bufferId();
+    const int32_t bitstreamId = static_cast<int32_t>(buffer->getTimeStamp().tv_sec);
+
+    if (!copyMmapPicture(buffer, *frame)) {
+        onError();
+        return;
+    }
+
+    // Give the buffer back to the device as soon as the picture is out of it.
+    buffer.reset();
+    auto outputBuffer = mOutputQueue->getFreeBuffer(bufferId);
+    if (!outputBuffer || !std::move(*outputBuffer).queueMMap()) {
+        ALOGE("%s(): Failed to QBUF to output queue, V4L2Id=%zu", __func__, bufferId);
+        onError();
+        return;
+    }
+
+    ALOGV("Send output frame(bitstreamId=%d) to client", bitstreamId);
+    frame->setBitstreamId(bitstreamId);
+    frame->setVisibleRect(mVisibleRect);
+    mOutputCb.Run(std::move(frame));
+
+    if (!mDecodedMmapBuffers.empty()) {
+        tryFetchVideoFrame();
+        return;
+    }
+    if (mMmapResolutionChangePending) {
+        mMmapResolutionChangePending = false;
+        if (!changeResolution()) {
+            onError();
+            return;
+        }
+    }
+    if (mMmapDrainPending) {
+        mMmapDrainPending = false;
+        finishDrain();
+    }
+}
+
+bool V4L2Decoder::copyMmapPicture(const V4L2ReadableBufferRef& buffer, VideoFrame& frame) {
+    ATRACE_CALL();
+
+    const bool yTiled = isYTiledFourcc(mOutputFourcc);
+    const int width = yTiled ? mVisibleRect.right : mCodedSize.width;
+    const int height = yTiled ? mVisibleRect.bottom : mCodedSize.height;
+    const int chromaWidth = (width + 1) / 2;
+    const int chromaHeight = (height + 1) / 2;
+
+    // Source planes in the V4L2 buffer. srcStep is the distance between two
+    // samples of a chroma plane: 2 when U and V are interleaved.
+    const auto* srcY = static_cast<const uint8_t*>(buffer->getPlaneMapping(0));
+    const int srcStride = static_cast<int>(mOutputBytesPerLine);
+    const uint8_t* srcU = nullptr;
+    const uint8_t* srcV = nullptr;
+    int srcChromaStride = srcStride;
+    int srcStep = 2;
+    if (srcY == nullptr) {
+        ALOGE("%s(): Failed to map V4L2 output buffer", __func__);
+        return false;
+    }
+    switch (mOutputFourcc) {
+    case V4L2_PIX_FMT_NV12:
+        srcU = srcY + srcStride * height;
+        srcV = srcU + 1;
+        break;
+    case kNV12YTiledFourcc:
+    case kNV12YTiledSwizzledFourcc:
+        // After the luma plane's whole rows of 32-row tiles.
+        srcU = srcY + srcStride * ((mCodedSize.height + 31) & ~31);
+        srcV = srcU + 1;
+        break;
+    case V4L2_PIX_FMT_NV21:
+        srcV = srcY + srcStride * height;
+        srcU = srcV + 1;
+        break;
+    case V4L2_PIX_FMT_NV12M:
+    case V4L2_PIX_FMT_NV21M: {
+        if (buffer->planesCount() < 2) break;
+        const auto* chroma = static_cast<const uint8_t*>(buffer->getPlaneMapping(1));
+        if (chroma == nullptr) break;
+        const bool uFirst = mOutputFourcc == V4L2_PIX_FMT_NV12M;
+        srcU = uFirst ? chroma : chroma + 1;
+        srcV = uFirst ? chroma + 1 : chroma;
+        break;
+    }
+    case V4L2_PIX_FMT_YUV420:
+    case V4L2_PIX_FMT_YVU420: {
+        srcChromaStride = srcStride / 2;
+        srcStep = 1;
+        const uint8_t* first = srcY + srcStride * height;
+        const uint8_t* second = first + srcChromaStride * chromaHeight;
+        const bool uFirst = mOutputFourcc == V4L2_PIX_FMT_YUV420;
+        srcU = uFirst ? first : second;
+        srcV = uFirst ? second : first;
+        break;
+    }
+    }
+    if (srcU == nullptr || srcV == nullptr) {
+        ALOGE("%s(): Cannot copy pictures in %s", __func__, fourccToString(mOutputFourcc).c_str());
+        return false;
+    }
+
+    C2GraphicView view = frame.getWritableGraphicBlock().map().get();
+    if (view.error() != C2_OK) {
+        ALOGE("%s(): Failed to map output block: %d", __func__, view.error());
+        return false;
+    }
+    const C2PlanarLayout& layout = view.layout();
+    const C2PlaneInfo& yInfo = layout.planes[C2PlanarLayout::PLANE_Y];
+    const C2PlaneInfo& uInfo = layout.planes[C2PlanarLayout::PLANE_U];
+    const C2PlaneInfo& vInfo = layout.planes[C2PlanarLayout::PLANE_V];
+    if (layout.type != C2PlanarLayout::TYPE_YUV || layout.numPlanes < 3 || yInfo.colInc != 1 ||
+        view.width() < static_cast<uint32_t>(width) ||
+        view.height() < static_cast<uint32_t>(height)) {
+        ALOGE("%s(): Unsupported output block layout", __func__);
+        return false;
+    }
+    uint8_t* const* dst = view.data();
+    uint8_t* dstY = dst[C2PlanarLayout::PLANE_Y];
+    uint8_t* dstU = dst[C2PlanarLayout::PLANE_U];
+    uint8_t* dstV = dst[C2PlanarLayout::PLANE_V];
+
+    if (yTiled) {
+        if (uInfo.colInc != 1 || vInfo.colInc != 1) {
+            ALOGE("%s(): Cannot copy Y-tiled pictures into this block", __func__);
+            return false;
+        }
+        // The chroma rows hold U and V interleaved, chromaWidth * 2 bytes.
+        if (mOutputFourcc == kNV12YTiledSwizzledFourcc) {
+            detileSwizzledPlane(srcY, srcStride, dstY, yInfo.rowInc, width, height);
+            mDetiledChroma.resize(static_cast<size_t>(chromaWidth) * 2 * chromaHeight);
+            detileSwizzledPlane(srcU, srcStride, mDetiledChroma.data(), chromaWidth * 2,
+                                chromaWidth * 2, chromaHeight);
+            libyuv::SplitUVPlane(mDetiledChroma.data(), chromaWidth * 2, dstU, uInfo.rowInc, dstV,
+                                 vInfo.rowInc, chromaWidth, chromaHeight);
+            return true;
+        }
+        // Tiles of 16 bytes by 32 rows, side by side in each row of tiles: Y tiles are made of
+        // them.
+        libyuv::DetilePlane(srcY, srcStride, dstY, yInfo.rowInc, width, height, 32);
+        libyuv::DetileSplitUVPlane(srcU, srcStride, dstU, uInfo.rowInc, dstV, vInfo.rowInc,
+                                   chromaWidth * 2, chromaHeight, 32);
+        return true;
+    }
+
+    libyuv::CopyPlane(srcY, srcStride, dstY, yInfo.rowInc, width, height);
+
+    if (srcStep == 2 && uInfo.colInc == 2 && vInfo.colInc == 2 && uInfo.rowInc == vInfo.rowInc &&
+        (dstV - dstU) == (srcV - srcU) && (dstV - dstU == 1 || dstU - dstV == 1)) {
+        // Semi-planar into the same semi-planar order, NV12 into NV12: copy the
+        // interleaved rows whole.
+        libyuv::CopyPlane(std::min(srcU, srcV), srcChromaStride, std::min(dstU, dstV),
+                          uInfo.rowInc, chromaWidth * 2, chromaHeight);
+    } else if (srcStep == 2 && uInfo.colInc == 1 && vInfo.colInc == 1) {
+        // Semi-planar into planar, the usual NV12 into YV12.
+        if (srcV == srcU + 1) {
+            libyuv::SplitUVPlane(srcU, srcChromaStride, dstU, uInfo.rowInc, dstV, vInfo.rowInc,
+                                 chromaWidth, chromaHeight);
+        } else {
+            libyuv::SplitUVPlane(srcV, srcChromaStride, dstV, vInfo.rowInc, dstU, uInfo.rowInc,
+                                 chromaWidth, chromaHeight);
+        }
+    } else if (srcStep == 1 && uInfo.colInc == 1 && vInfo.colInc == 1) {
+        libyuv::CopyPlane(srcU, srcChromaStride, dstU, uInfo.rowInc, chromaWidth, chromaHeight);
+        libyuv::CopyPlane(srcV, srcChromaStride, dstV, vInfo.rowInc, chromaWidth, chromaHeight);
+    } else {
+        for (int row = 0; row < chromaHeight; ++row) {
+            const uint8_t* su = srcU + row * srcChromaStride;
+            const uint8_t* sv = srcV + row * srcChromaStride;
+            uint8_t* du = dstU + row * uInfo.rowInc;
+            uint8_t* dv = dstV + row * vInfo.rowInc;
+            for (int col = 0; col < chromaWidth; ++col) {
+                du[col * uInfo.colInc] = su[col * srcStep];
+                dv[col * vInfo.colInc] = sv[col * srcStep];
+            }
+        }
+    }
+    return true;
+}
+
+// The format in Intel Y tiles, unswizzled or swizzled, that the device decodes the pictures of the
+// stream straight into MMAP buffers in, or 0 when it does not. Asks with TRY_FMT directly, as
+// V4L2Queue::tryFormat() logs an error when the device does not.
+uint32_t V4L2Decoder::yTiledOutputFourcc(const ui::Size& size) {
+    struct v4l2_format format;
+    memset(&format, 0, sizeof(format));
+    format.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    format.fmt.pix_mp.pixelformat = kNV12YTiledFourcc;
+    format.fmt.pix_mp.width = size.width;
+    format.fmt.pix_mp.height = size.height;
+    format.fmt.pix_mp.num_planes = 1;
+    if (mDevice->ioctl(VIDIOC_TRY_FMT, &format) != 0) return 0;
+    const uint32_t fourcc = format.fmt.pix_mp.pixelformat;
+    return isYTiledFourcc(fourcc) ? fourcc : 0;
+}
+
+void V4L2Decoder::finishDrain() {
+    ALOGV("All buffers are drained.");
+    ALOG_ASSERT(mDrainCb);
+
+    std::move(mDrainCb).Run(VideoDecoder::DecodeStatus::kOk);
+    setState(State::Idle);
+}
