Patch summary:
Digitalis writes its debug diagnostics (translation counts, dispatch watchdog,
proxy argument checks, dlopen timings) to the berberis.tracing trace only,
instead of also to logcat for every translated app.

diff --git a/base/include/berberis/base/tracing.h b/base/include/berberis/base/tracing.h
index 65b18a09..6a756a7c 100644
--- a/base/include/berberis/base/tracing.h
+++ b/base/include/berberis/base/tracing.h
@@ -107,9 +107,8 @@ class Tracing {
   ALOGI(__VA_ARGS__)
 
 // region digitalis
-#define TRACE_AND_ALOGD(...) \
-  TRACE(__VA_ARGS__);        \
-  ALOGD(__VA_ARGS__)
+// Digitalis's debug diagnostics go to the trace only (berberis.tracing), not to logcat.
+#define TRACE_AND_ALOGD(...) TRACE(__VA_ARGS__)
 // endregion
 
 #endif  // BERBERIS_BASE_TRACING_H_
