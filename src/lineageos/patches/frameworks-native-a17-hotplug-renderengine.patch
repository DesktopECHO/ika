+// Android 17 d8bf49da92: a fence that has already signaled needs no driver fence or wait, which
+// costs a host round trip on a virtual GPU.
+void SkiaRenderEngine::waitFenceIfPending(SkiaGpuContext* context, base::borrowed_fd fenceFd) {
+    if (fenceFd.get() >= 0 && sync_wait(fenceFd.get(), 0) >= 0) {
+        return;
+    }
+    waitFence(context, fenceFd);
+}
