+int ResourceTracker::exportQueueSyncFd(VkEncoder* enc, VkQueue queue, VkDevice device) {
+#if defined(VK_USE_PLATFORM_ANDROID_KHR) || DETECT_OS_LINUX
+    MESA_TRACE_SCOPE("exportQueueSyncFd");
+    // Destroy the fences the host has finished waiting on. A fence is never reset
+    // and used again: the reset and the submission reach the host through the
+    // command stream, the export through virtio-gpu, and an export that overtook
+    // them would wait on the fence's earlier, signaled use.
+    std::vector<VkFence> doneFences;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto& exportFences = mSemaphoreExportFences[device];
+        for (auto it = exportFences.begin(); it != exportFences.end();) {
+            if (mSyncHelper->wait(it->syncFd, 0) == 0) {
+                mSyncHelper->close(it->syncFd);
+                doneFences.push_back(it->fence);
+                it = exportFences.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+    for (VkFence doneFence : doneFences) {
+        enc->vkDestroyFence(device, doneFence, nullptr, true /* do lock */);
+    }
+
+    // The host has the new fence before the export arrives, as vkCreateFence waits
+    // for its reply, and waits for the submission below if the export comes first.
+    VkExportFenceCreateInfo exportInfo = {
+        .sType = VK_STRUCTURE_TYPE_EXPORT_FENCE_CREATE_INFO,
+        .pNext = nullptr,
+        .handleTypes = VK_EXTERNAL_FENCE_HANDLE_TYPE_SYNC_FD_BIT,
+    };
+    VkFenceCreateInfo createInfo = {
+        .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+        .pNext = &exportInfo,
+        .flags = 0,
+    };
+    VkFence fence = VK_NULL_HANDLE;
+    if (enc->vkCreateFence(device, &createInfo, nullptr, &fence, true /* do lock */) !=
+        VK_SUCCESS) {
+        return -1;
+    }
+
+    // Signals once everything submitted to the queue before it is done.
+    vkQueueSubmitEnc(enc, queue, 0, static_cast<const VkSubmitInfo*>(nullptr), fence);
+
+    int64_t osHandle = -1;
+    if (createFence(device, gfxstream_vk_fence_to_host_u64(fence), osHandle) != VK_SUCCESS ||
+        osHandle < 0) {
+        enc->vkDestroyFence(device, fence, nullptr, true /* do lock */);
+        return -1;
+    }
+    int fd = (int)osHandle;
+
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    mSemaphoreExportFences[device].push_back({.fence = fence, .syncFd = mSyncHelper->dup(fd)});
+    return fd;
+#else
+    (void)enc;
+    (void)queue;
+    (void)device;
+    return -1;
+#endif
+}
