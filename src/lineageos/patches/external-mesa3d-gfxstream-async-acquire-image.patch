Patch summary:
gfxstream's guest encoder no longer waits for the result of
vkAcquireImageANDROID; it flushes the command and returns VK_SUCCESS. The
host runs the acquire after the queue work submitted before it, so 3DMark
Wild Life Extreme's render thread spent half its time under WSL2 waiting for
that result before it could encode the next frame. Needs the host's
PATCH.gfxstream.async-acquire-image.patch, which stops sending the result.

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -22930,8 +22930,11 @@
     *&cgen_var_3 = gfxstream_vk_fence_to_host_u64((*&local_fence));
     memcpy(*streamPtrPtr, (uint64_t*)&cgen_var_3, 1 * 8);
     *streamPtrPtr += 1 * 8;
-    VkResult vkAcquireImageANDROID_VkResult_return = (VkResult)0;
-    stream->read(&vkAcquireImageANDROID_VkResult_return, sizeof(VkResult));
+    // The host sends no result for vkAcquireImageANDROID: it runs the acquire
+    // after the queue work submitted before it, and waiting for that cost the
+    // guest a round trip per frame.
+    VkResult vkAcquireImageANDROID_VkResult_return = VK_SUCCESS;
+    stream->flush();
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
