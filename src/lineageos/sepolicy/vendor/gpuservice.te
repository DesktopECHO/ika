# In Venus mode the Vulkan driver finds the GPU by listing /dev/dri and
# reading its sysfs entry, and asks gralloc's mapper for the front buffer's
# usage as it sets up each device. Cuttlefish's policy lets gpuservice only
# search /dev/dri, so its Vulkan queries (`cmd gpu vkjson`) found no device
# there.
allow gpuservice gpu_device:dir r_dir_perms;
allow gpuservice sysfs_gpu:file r_file_perms;
hal_client_domain(gpuservice, hal_graphics_allocator)
