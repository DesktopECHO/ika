# ika_memory.rc (prebuilts/memory) sets vm.swappiness at init, as Android 17's
# desktop devices do. AOSP's policy here leaves the file as plain proc, which
# init may not write, so it gets its own type, like the other vm files init
# tunes (proc_dirty, proc_max_map_count).
type proc_swappiness, fs_type, proc_type;
allow init proc_swappiness:file w_file_perms;

# Boot prefetch (started by ika_memory.rc) walks the partitions to map the
# files boot reads, and reads them ahead on the next boot. AOSP exempts
# prefetch from its rule against core domains reading /vendor files, but
# grants it no access there.
allow prefetch vendor_file_type:dir r_dir_perms;
allow prefetch vendor_file_type:file r_file_perms;
