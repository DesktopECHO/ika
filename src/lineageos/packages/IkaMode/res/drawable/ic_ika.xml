<?xml version="1.0" encoding="utf-8"?>
<!-- The Ika icon beside the switcher's title. The dialog draws its icon in a
     32dp box, scaled to fit, 24dp from the dialog's edge: inset, the icon stays
     22dp, no taller than the title's text, and centred 36dp from the edge, over
     the choices' radio buttons. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_ika_art"
    android:insetLeft="1dp"
    android:insetRight="9dp"
    android:insetTop="5dp"
    android:insetBottom="5dp" />
