diff --git a/src/microsoft/compiler/dxil_nir_algebraic.py b/src/microsoft/compiler/dxil_nir_algebraic.py
index 7d0010d..2a2785f 100644
--- a/src/microsoft/compiler/dxil_nir_algebraic.py
+++ b/src/microsoft/compiler/dxil_nir_algebraic.py
@@ -101,6 +101,22 @@ algebraic_ops = [
   (('b2b1', 'a'), ('ine', ('b2i32', a), 0)),
 ]
 
+# NVIDIA's FPToUI to 64 bits clamps at UINT32_MAX, FPToSI is fine.
+for sz in (32, 64):
+  algebraic_ops += [
+    (('f2u64', 'a@{}'.format(sz)),
+     ('bcsel', ('flt', a, 9223372036854775808.0), ('f2i64', a),
+      ('ior', ('f2i64', ('fadd', a, -9223372036854775808.0)), -0x8000000000000000))),
+  ]
+
+# fcanonicalize otherwise becomes fmul(a, 1.0), which drivers fold away
+# without flushing denorms, so flush explicitly.
+algebraic_ops += [
+  (('fcanonicalize', 'a@32'),
+   ('bcsel', ('flt', ('fabs', a), 1.1754943508222875e-38), ('iand', a, 0x80000000), a),
+   'nir_is_denorm_flush_to_zero(info->float_controls_execution_mode, 32)'),
+]
+
 no_16bit_conv += [
   (('f2f32', ('u2u16', 'a@32')), ('unpack_half_x_dxil', a)),
   (('u2u32', ('f2f16_rtz', 'a@32')), ('pack_half_2x16_split', 'a', 0)),
