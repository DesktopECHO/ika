+/* The aspects of mask that image's format has. Applications name stencil
+ * for a depth-only image (or depth for a stencil-only one), which other
+ * Vulkan drivers ignore. D3D12 rejects a barrier or a clear for a plane the
+ * resource lacks: the command list then fails to close, and submitting it
+ * removes the device. */
+static VkImageAspectFlags
+dzn_image_aspects(const struct dzn_image *image, VkImageAspectFlags mask)
+{
+   if (!(mask & (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)))
+      return mask;
+   return mask & vk_format_aspects(image->vk.format);
+}
