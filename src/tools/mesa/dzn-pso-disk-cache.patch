+/* Creates the PSO from the driver's compiled form in the disk cache when it
+ * has one the driver accepts, and otherwise compiles it and stores that. */
+static HRESULT
+dzn_pso_cache_create_from_disk(struct dzn_device *device,
+                               const D3D12_PIPELINE_STATE_STREAM_DESC *desc,
+                               ID3D12PipelineState **out)
+{
+   struct dzn_physical_device *pdev = container_of(device->vk.physical, struct dzn_physical_device, vk);
+   struct disk_cache *disk_cache = device->vk.physical->disk_cache;
+   ID3D12RootSignature *root_sig;
+   struct util_dynarray data;
+   cache_key disk_key;
+
+   /* A driver with a cache of its own is left to it: under WSL2, NVIDIA's
+    * GetCachedBlob frees memory it did not allocate and aborts the process. */
+   util_dynarray_init(&data, NULL);
+   if (!disk_cache ||
+       (pdev->shader_cache.SupportFlags & D3D12_SHADER_CACHE_SUPPORT_DRIVER_MANAGED_CACHE) ||
+       !dzn_pso_cache_serialize(desc, &data, &root_sig, true)) {
+      util_dynarray_fini(&data);
+      return ID3D12Device4_CreatePipelineState(device->dev, desc, &IID_ID3D12PipelineState, (void **)out);
+   }
+   disk_cache_compute_key(disk_cache, data.data, data.size, disk_key);
+   util_dynarray_fini(&data);
+
+   size_t blob_size = 0;
+   void *blob = disk_cache_get(disk_cache, disk_key, &blob_size);
+   if (blob) {
+      struct cached_pso_subobj {
+         D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type;
+         D3D12_CACHED_PIPELINE_STATE desc;
+      };
+      size_t offset = ALIGN_POT(desc->SizeInBytes, alignof(void *));
+      uint8_t *stream = malloc(offset + sizeof(struct cached_pso_subobj));
+      HRESULT hres = E_OUTOFMEMORY;
+      if (stream) {
+         memcpy(stream, desc->pPipelineStateSubobjectStream, desc->SizeInBytes);
+         memset(stream + desc->SizeInBytes, 0, offset - desc->SizeInBytes);
+         struct cached_pso_subobj *cached = (void *)(stream + offset);
+         cached->type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CACHED_PSO;
+         cached->desc.pCachedBlob = blob;
+         cached->desc.CachedBlobSizeInBytes = blob_size;
+         D3D12_PIPELINE_STATE_STREAM_DESC cached_desc = {
+            .SizeInBytes = offset + sizeof(*cached),
+            .pPipelineStateSubobjectStream = stream,
+         };
+         hres = ID3D12Device4_CreatePipelineState(device->dev, &cached_desc,
+                                                  &IID_ID3D12PipelineState, (void **)out);
+         free(stream);
+      }
+      free(blob);
+      if (SUCCEEDED(hres))
+         return hres;
+      /* Another driver or GPU, or a blob the driver no longer accepts. */
+   }
+
+   HRESULT hres = ID3D12Device4_CreatePipelineState(device->dev, desc, &IID_ID3D12PipelineState, (void **)out);
+   if (FAILED(hres))
+      return hres;
+
+   ID3DBlob *compiled = NULL;
+   if (SUCCEEDED(ID3D12PipelineState_GetCachedBlob(*out, &compiled))) {
+      disk_cache_put(disk_cache, disk_key, ID3D10Blob_GetBufferPointer(compiled),
+                     ID3D10Blob_GetBufferSize(compiled), NULL);
+      ID3D10Blob_Release(compiled);
+   }
+   return hres;
+}
