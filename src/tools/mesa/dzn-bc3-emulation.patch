+/* ---- BC3 images ----
+ *
+ * A level of a BC3 image is decoded, as an RGBA8 one is, but into an RGBA8
+ * image of the command buffer's own; a compute shader encodes the texels into
+ * BC3 blocks in a buffer, and the blocks are copied into the image (D3D12 has
+ * no unordered access to BC formats without relaxed format casting). A copy
+ * that starts or ends inside a 4x4 BC block decodes the whole block: the
+ * level's other source blocks are in its blocks image.
+ */
+
+enum dzn_texcompress_object_type {
+   DZN_TEXCOMPRESS_IMAGE,
+   DZN_TEXCOMPRESS_IMAGE_VIEW,
+   DZN_TEXCOMPRESS_BUFFER,
+   DZN_TEXCOMPRESS_MEMORY,
+   DZN_TEXCOMPRESS_DESCRIPTOR_SET,
+};
+
+struct dzn_texcompress_object {
+   enum dzn_texcompress_object_type type;
+   uint64_t handle;
+   VkDescriptorPool pool;
+};
+
+static void
+dzn_cmd_buffer_texcompress_keep(struct dzn_cmd_buffer *cmdbuf,
+                                enum dzn_texcompress_object_type type,
+                                uint64_t handle, VkDescriptorPool pool)
+{
+   const struct dzn_texcompress_object obj = { type, handle, pool };
+
+   util_dynarray_append_typed(&cmdbuf->texcompress.objects, struct dzn_texcompress_object, obj);
+}
+
+void
+dzn_cmd_buffer_texcompress_reset(struct dzn_cmd_buffer *cmdbuf)
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+   const struct vk_device_dispatch_table *disp = &device->vk.dispatch_table;
+   VkDevice dev = dzn_device_to_handle(device);
+
+   /* Views before their images, images and buffers before their memory. */
+   util_dynarray_foreach_reverse(&cmdbuf->texcompress.objects, struct dzn_texcompress_object, obj) {
+      switch (obj->type) {
+      case DZN_TEXCOMPRESS_IMAGE:
+         disp->DestroyImage(dev, (VkImage)(uintptr_t)obj->handle, NULL);
+         break;
+      case DZN_TEXCOMPRESS_IMAGE_VIEW:
+         disp->DestroyImageView(dev, (VkImageView)(uintptr_t)obj->handle, NULL);
+         break;
+      case DZN_TEXCOMPRESS_BUFFER:
+         disp->DestroyBuffer(dev, (VkBuffer)(uintptr_t)obj->handle, NULL);
+         break;
+      case DZN_TEXCOMPRESS_MEMORY:
+         disp->FreeMemory(dev, (VkDeviceMemory)(uintptr_t)obj->handle, NULL);
+         break;
+      case DZN_TEXCOMPRESS_DESCRIPTOR_SET: {
+         VkDescriptorSet set = (VkDescriptorSet)(uintptr_t)obj->handle;
+
+         mtx_lock(&device->texcompress.lock);
+         disp->FreeDescriptorSets(dev, obj->pool, 1, &set);
+         mtx_unlock(&device->texcompress.lock);
+         break;
+      }
+      }
+   }
+   util_dynarray_clear(&cmdbuf->texcompress.objects);
+
+   cmdbuf->texcompress.scratch = VK_NULL_HANDLE;
+   cmdbuf->texcompress.scratch_uint = VK_NULL_HANDLE;
+   cmdbuf->texcompress.scratch_unorm = VK_NULL_HANDLE;
+   cmdbuf->texcompress.scratch_extent = (VkExtent3D) { 0 };
+   cmdbuf->texcompress.blocks = VK_NULL_HANDLE;
+   cmdbuf->texcompress.blocks_size = 0;
+}
+
+static VkResult
+dzn_texcompress_bc3_prepare_locked(struct dzn_device *device)
+{
+   const struct vk_device_dispatch_table *disp = &device->vk.dispatch_table;
+   VkDevice dev = dzn_device_to_handle(device);
+
+   if (device->texcompress.bc3.pipeline)
+      return VK_SUCCESS;
+
+   if (!device->texcompress.bc3.ds_layout) {
+      const VkDescriptorSetLayoutBinding bindings[] = {
+         {
+            .binding = 0,
+            .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+            .descriptorCount = 1,
+            .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+         },
+         {
+            .binding = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+            .descriptorCount = 1,
+            .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+         },
+      };
+      const VkDescriptorSetLayoutCreateInfo ds_info = {
+         .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+         .bindingCount = ARRAY_SIZE(bindings),
+         .pBindings = bindings,
+      };
+      VkResult result = disp->CreateDescriptorSetLayout(dev, &ds_info, NULL,
+                                                        &device->texcompress.bc3.ds_layout);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   if (!device->texcompress.bc3.p_layout) {
+      const VkPushConstantRange range = {
+         .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+         .size = 10 * sizeof(uint32_t),
+      };
+      const VkPipelineLayoutCreateInfo p_info = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+         .setLayoutCount = 1,
+         .pSetLayouts = &device->texcompress.bc3.ds_layout,
+         .pushConstantRangeCount = 1,
+         .pPushConstantRanges = &range,
+      };
+      VkResult result = disp->CreatePipelineLayout(dev, &p_info, NULL,
+                                                   &device->texcompress.bc3.p_layout);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   const VkShaderModuleCreateInfo module_info = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = sizeof(dzn_bc3_encode_spv),
+      .pCode = dzn_bc3_encode_spv,
+   };
+   VkShaderModule module;
+   VkResult result = disp->CreateShaderModule(dev, &module_info, NULL, &module);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkComputePipelineCreateInfo pipeline_info = {
+      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+      .stage = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+         .module = module,
+         .pName = "main",
+      },
+      .layout = device->texcompress.bc3.p_layout,
+   };
+   result = disp->CreateComputePipelines(dev, VK_NULL_HANDLE, 1, &pipeline_info, NULL,
+                                         &device->texcompress.bc3.pipeline);
+   disp->DestroyShaderModule(dev, module, NULL);
+   if (result != VK_SUCCESS)
+      device->texcompress.bc3.pipeline = VK_NULL_HANDLE;
+
+   return result;
+}
+
+static VkResult
+dzn_texcompress_bind_new_memory(struct dzn_cmd_buffer *cmdbuf, VkMemoryRequirements reqs,
+                                VkDeviceMemory *mem)
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+   const struct dzn_physical_device *pdev =
+      container_of(device->vk.physical, struct dzn_physical_device, vk);
+   const struct vk_device_dispatch_table *disp = &device->vk.dispatch_table;
+   const uint32_t type_index = dzn_texcompress_memory_type(pdev, reqs.memoryTypeBits);
+
+   if (type_index == UINT32_MAX)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   const VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex = type_index,
+   };
+   VkResult result = disp->AllocateMemory(dzn_device_to_handle(device), &alloc_info, NULL, mem);
+   if (result == VK_SUCCESS)
+      dzn_cmd_buffer_texcompress_keep(cmdbuf, DZN_TEXCOMPRESS_MEMORY, (uint64_t)(uintptr_t)*mem, VK_NULL_HANDLE);
+
+   return result;
+}
+
+/* The command buffer's RGBA8 image, at least width x height x layers; fresh
+ * says it is new, its contents undefined. */
+static VkResult
+dzn_texcompress_get_scratch(struct dzn_cmd_buffer *cmdbuf, uint32_t width, uint32_t height,
+                            uint32_t layers, bool *fresh)
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+   const struct vk_device_dispatch_table *disp = &device->vk.dispatch_table;
+   VkDevice dev = dzn_device_to_handle(device);
+   VkExtent3D *extent = &cmdbuf->texcompress.scratch_extent;
+
+   *fresh = false;
+   if (cmdbuf->texcompress.scratch &&
+       width <= extent->width && height <= extent->height && layers <= extent->depth)
+      return VK_SUCCESS;
+
+   /* The ASTC decoder stores integers, the ETC2 one normalized values. */
+   const VkFormat formats[] = { VK_FORMAT_R8G8B8A8_UINT, VK_FORMAT_R8G8B8A8_UNORM };
+   const VkImageFormatListCreateInfo list = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO,
+      .viewFormatCount = ARRAY_SIZE(formats),
+      .pViewFormats = formats,
+   };
+   const VkImageCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .pNext = &list,
+      .flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_R8G8B8A8_UINT,
+      .extent = {
+         .width = MAX2(width, extent->width),
+         .height = MAX2(height, extent->height),
+         .depth = 1,
+      },
+      .mipLevels = 1,
+      .arrayLayers = MAX2(layers, extent->depth),
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   VkImage image;
+   VkResult result = disp->CreateImage(dev, &info, NULL, &image);
+   if (result != VK_SUCCESS)
+      return result;
+   dzn_cmd_buffer_texcompress_keep(cmdbuf, DZN_TEXCOMPRESS_IMAGE, (uint64_t)(uintptr_t)image, VK_NULL_HANDLE);
+
+   VkMemoryRequirements reqs;
+   VkDeviceMemory mem;
+   disp->GetImageMemoryRequirements(dev, image, &reqs);
+   result = dzn_texcompress_bind_new_memory(cmdbuf, reqs, &mem);
+   if (result != VK_SUCCESS)
+      return result;
+   result = disp->BindImageMemory(dev, image, mem, 0);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkImageView views[ARRAY_SIZE(formats)];
+   for (uint32_t i = 0; i < ARRAY_SIZE(formats); i++) {
+      const VkImageViewCreateInfo view_info = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+         .image = image,
+         .viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY,
+         .format = formats[i],
+         .subresourceRange = {
+            .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+            .levelCount = 1,
+            .layerCount = info.arrayLayers,
+         },
+      };
+      result = disp->CreateImageView(dev, &view_info, NULL, &views[i]);
+      if (result != VK_SUCCESS)
+         return result;
+      dzn_cmd_buffer_texcompress_keep(cmdbuf, DZN_TEXCOMPRESS_IMAGE_VIEW, (uint64_t)(uintptr_t)views[i],
+                                      VK_NULL_HANDLE);
+   }
+
+   cmdbuf->texcompress.scratch = image;
+   cmdbuf->texcompress.scratch_uint = views[0];
+   cmdbuf->texcompress.scratch_unorm = views[1];
+   *extent = (VkExtent3D) { info.extent.width, info.extent.height, info.arrayLayers };
+   *fresh = true;
+   return VK_SUCCESS;
+}
+
+/* The command buffer's buffer for encoded blocks, at least size bytes. */
+static VkResult
+dzn_texcompress_get_blocks_buffer(struct dzn_cmd_buffer *cmdbuf, VkDeviceSize size)
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+   const struct vk_device_dispatch_table *disp = &device->vk.dispatch_table;
+   VkDevice dev = dzn_device_to_handle(device);
+
+   if (cmdbuf->texcompress.blocks && size <= cmdbuf->texcompress.blocks_size)
+      return VK_SUCCESS;
+
+   size = MAX2(size, cmdbuf->texcompress.blocks_size);
+   const VkBufferCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = size,
+      .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkBuffer buffer;
+   VkResult result = disp->CreateBuffer(dev, &info, NULL, &buffer);
+   if (result != VK_SUCCESS)
+      return result;
+   dzn_cmd_buffer_texcompress_keep(cmdbuf, DZN_TEXCOMPRESS_BUFFER, (uint64_t)(uintptr_t)buffer, VK_NULL_HANDLE);
+
+   VkMemoryRequirements reqs;
+   VkDeviceMemory mem;
+   disp->GetBufferMemoryRequirements(dev, buffer, &reqs);
+   result = dzn_texcompress_bind_new_memory(cmdbuf, reqs, &mem);
+   if (result != VK_SUCCESS)
+      return result;
+   result = disp->BindBufferMemory(dev, buffer, mem, 0);
+   if (result != VK_SUCCESS)
+      return result;
+
+   cmdbuf->texcompress.blocks = buffer;
+   cmdbuf->texcompress.blocks_size = size;
+   return VK_SUCCESS;
+}
+
+static VkResult
+dzn_texcompress_alloc_cmd_set(struct dzn_cmd_buffer *cmdbuf, VkDescriptorSetLayout layout,
+                              VkDescriptorSet *set)
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+   VkDescriptorPool pool;
+
+   mtx_lock(&device->texcompress.lock);
+   VkResult result = dzn_texcompress_alloc_set_locked(device, layout, &pool, set);
+   mtx_unlock(&device->texcompress.lock);
+   if (result == VK_SUCCESS)
+      dzn_cmd_buffer_texcompress_keep(cmdbuf, DZN_TEXCOMPRESS_DESCRIPTOR_SET, (uint64_t)(uintptr_t)*set, pool);
+
+   return result;
+}
+
+static void
+dzn_texcompress_dependency(struct dzn_cmd_buffer *cmdbuf,
+                           VkPipelineStageFlags2 src_stage, VkAccessFlags2 src_access,
+                           VkPipelineStageFlags2 dst_stage, VkAccessFlags2 dst_access,
+                           uint32_t image_count, const VkImageMemoryBarrier2 *images)
+{
+   const VkMemoryBarrier2 memory = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+      .srcStageMask = src_stage,
+      .srcAccessMask = src_access,
+      .dstStageMask = dst_stage,
+      .dstAccessMask = dst_access,
+   };
+   const VkDependencyInfo dep = {
+      .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+      .memoryBarrierCount = 1,
+      .pMemoryBarriers = &memory,
+      .imageMemoryBarrierCount = image_count,
+      .pImageMemoryBarriers = images,
+   };
+
+   cmdbuf->vk.base.device->dispatch_table.CmdPipelineBarrier2(dzn_cmd_buffer_to_handle(cmdbuf), &dep);
+}
+
+static void
+dzn_texcompress_decode_bc3(struct dzn_cmd_buffer *cmdbuf, struct dzn_image *image,
+                           uint32_t level, VkImageLayout layout,
+                           VkOffset3D offset, VkExtent3D extent,
+                           uint32_t base_layer, uint32_t layer_count)
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+   const struct vk_device_dispatch_table *disp = &device->vk.dispatch_table;
+   VkDevice dev = dzn_device_to_handle(device);
+   VkCommandBuffer cmd = dzn_cmd_buffer_to_handle(cmdbuf);
+   struct dzn_image_texcompress_level *lvl = &image->texcompress->levels[level];
+   const VkFormat format = image->vk.format;
+   const uint32_t width = u_minify(image->vk.extent.width, level);
+   const uint32_t height = u_minify(image->vk.extent.height, level);
+   const uint32_t bw = vk_format_get_blockwidth(format);
+   const uint32_t bh = vk_format_get_blockheight(format);
+
+   if (offset.x >= width || offset.y >= height || !layer_count)
+      return;
+
+   /* The BC blocks the copy touches, and the source blocks covering them. */
+   const uint32_t x1 = MIN2(offset.x + extent.width, width);
+   const uint32_t y1 = MIN2(offset.y + extent.height, height);
+   const uint32_t bx0 = offset.x & ~3u, by0 = offset.y & ~3u;
+   const uint32_t bx1 = MIN2(ALIGN_POT(x1, 4), width), by1 = MIN2(ALIGN_POT(y1, 4), height);
+   const uint32_t dx0 = bx0 / bw * bw, dy0 = by0 / bh * bh;
+   const uint32_t dx1 = MIN2(DIV_ROUND_UP(bx1, bw) * bw, width);
+   const uint32_t dy1 = MIN2(DIV_ROUND_UP(by1, bh) * bh, height);
+   const uint32_t blocks_x = DIV_ROUND_UP(bx1 - bx0, 4), blocks_y = DIV_ROUND_UP(by1 - by0, 4);
+   /* Rows 256-byte aligned and layers 512-byte aligned, as D3D12 copies
+    * from buffers want them. */
+   const uint32_t row_blocks = ALIGN_POT(blocks_x * 16, D3D12_TEXTURE_DATA_PITCH_ALIGNMENT) / 16;
+   const uint32_t slice_rows =
+      (row_blocks * 16) % D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT ? ALIGN_POT(blocks_y, 2) : blocks_y;
+   const VkDeviceSize blocks_size = (VkDeviceSize)row_blocks * slice_rows * layer_count * 16;
+
+   mtx_lock(&device->texcompress.lock);
+   VkResult result = dzn_texcompress_bc3_prepare_locked(device);
+   mtx_unlock(&device->texcompress.lock);
+
+   bool fresh = false;
+   VkDescriptorSet decode_set = VK_NULL_HANDLE, encode_set = VK_NULL_HANDLE;
+   VkDescriptorSetLayout decode_layout = device->texcompress.etc2.ds_layout;
+#ifdef DZN_HAVE_ASTC_DECODER
+   if (dzn_format_is_astc(format))
+      decode_layout = device->texcompress.astc->ds_layout;
+#endif
+   if (result == VK_SUCCESS)
+      result = dzn_texcompress_get_scratch(cmdbuf, dx1, dy1, base_layer + layer_count, &fresh);
+   if (result == VK_SUCCESS)
+      result = dzn_texcompress_get_blocks_buffer(cmdbuf, blocks_size);
+   if (result == VK_SUCCESS)
+      result = dzn_texcompress_alloc_cmd_set(cmdbuf, decode_layout, &decode_set);
+   if (result == VK_SUCCESS)
+      result = dzn_texcompress_alloc_cmd_set(cmdbuf, device->texcompress.bc3.ds_layout, &encode_set);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmdbuf->vk, result);
+      return;
+   }
+
+#ifdef DZN_HAVE_ASTC_DECODER
+   if (dzn_format_is_astc(format)) {
+      struct vk_texcompress_astc_write_descriptor_set writes;
+
+      vk_texcompress_astc_fill_write_descriptor_sets(device->texcompress.astc, &writes,
+                                                     lvl->src_view,
+                                                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                                                     cmdbuf->texcompress.scratch_uint, format);
+      for (uint32_t i = 0; i < ARRAY_SIZE(writes.descriptor_set); i++)
+         writes.descriptor_set[i].dstSet = decode_set;
+      disp->UpdateDescriptorSets(dev, ARRAY_SIZE(writes.descriptor_set),
+                                 writes.descriptor_set, 0, NULL);
+   } else
+#endif
+   {
+      const VkDescriptorImageInfo src_info = {
+         .imageView = lvl->src_view,
+         .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+      };
+      const VkDescriptorImageInfo dst_info = {
+         .imageView = cmdbuf->texcompress.scratch_unorm,
+         .imageLayout = VK_IMAGE_LAYOUT_GENERAL,
+      };
+      const VkWriteDescriptorSet writes[] = {
+         {
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstSet = decode_set,
+            .dstBinding = 0,
+            .descriptorCount = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+            .pImageInfo = &src_info,
+         },
+         {
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstSet = decode_set,
+            .dstBinding = 1,
+            .descriptorCount = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            .pImageInfo = &dst_info,
+         },
+      };
+      disp->UpdateDescriptorSets(dev, ARRAY_SIZE(writes), writes, 0, NULL);
+   }
+
+   {
+      const VkDescriptorImageInfo texels_info = {
+         .imageView = cmdbuf->texcompress.scratch_uint,
+         .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+      };
+      const VkDescriptorBufferInfo blocks_info = {
+         .buffer = cmdbuf->texcompress.blocks,
+         .range = VK_WHOLE_SIZE,
+      };
+      const VkWriteDescriptorSet writes[] = {
+         {
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstSet = encode_set,
+            .dstBinding = 0,
+            .descriptorCount = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+            .pImageInfo = &texels_info,
+         },
+         {
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstSet = encode_set,
+            .dstBinding = 1,
+            .descriptorCount = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+            .pBufferInfo = &blocks_info,
+         },
+      };
+      disp->UpdateDescriptorSets(dev, ARRAY_SIZE(writes), writes, 0, NULL);
+   }
+
+   const VkImageMemoryBarrier2 before[] = {
+      dzn_texcompress_barrier(lvl->blocks, 0, base_layer, layer_count,
+                              VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                              VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                              VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,
+                              VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL),
+      /* Between decodes the scratch image is read-only: without enhanced
+       * barriers Dozen changes a resource's D3D12 state only on a layout
+       * change, and the encoder must not read it in the unordered-access
+       * state the decoder writes it in. */
+      dzn_texcompress_barrier(cmdbuf->texcompress.scratch, 0, 0, cmdbuf->texcompress.scratch_extent.depth,
+                              VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,
+                              fresh ? VK_IMAGE_LAYOUT_UNDEFINED : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                              VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+                              VK_IMAGE_LAYOUT_GENERAL),
+   };
+   /* The blocks buffer: the last copy out of it before the encoder writes it. */
+   dzn_texcompress_dependency(cmdbuf,
+                              VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT,
+                              VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+                              ARRAY_SIZE(before), before);
+
+   const struct dzn_cmd_buffer_bindpoint_state saved_bindpoint =
+      cmdbuf->state.bindpoint[VK_PIPELINE_BIND_POINT_COMPUTE];
+   const struct dzn_cmd_buffer_push_constant_state saved_push = cmdbuf->state.push_constant.compute;
+   const struct dxil_spirv_compute_runtime_data saved_sysvals = cmdbuf->state.sysvals.compute;
+
+#ifdef DZN_HAVE_ASTC_DECODER
+   if (dzn_format_is_astc(format)) {
+      struct vk_texcompress_astc_state *astc = device->texcompress.astc;
+      VkPipeline pipeline =
+         vk_texcompress_astc_get_decode_pipeline(&device->vk, &device->vk.alloc, astc,
+                                                 VK_NULL_HANDLE, format);
+      const int32_t push[] = { dx0 / bw, dy0 / bh, dx1, dy1, 0 };
+
+      disp->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+      disp->CmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, astc->p_layout,
+                                  0, 1, &decode_set, 0, NULL);
+      disp->CmdPushConstants(cmd, astc->p_layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                             0, sizeof(push), push);
+      disp->CmdDispatchBase(cmd, 0, 0, base_layer,
+                            DIV_ROUND_UP(dx1 - dx0, bw * 2),
+                            DIV_ROUND_UP(dy1 - dy0, bh * 2),
+                            layer_count);
+   } else
+#endif
+   {
+      struct vk_texcompress_etc2_state *etc2 = &device->texcompress.etc2;
+      const uint32_t push[] = { dx0, dy0, base_layer, format, VK_IMAGE_TYPE_2D };
+
+      disp->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, etc2->pipeline);
+      disp->CmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, etc2->pipeline_layout,
+                                  0, 1, &decode_set, 0, NULL);
+      disp->CmdPushConstants(cmd, etc2->pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                             0, sizeof(push), push);
+      disp->CmdDispatchBase(cmd, 0, 0, 0,
+                            DIV_ROUND_UP(dx1 - dx0, 8),
+                            DIV_ROUND_UP(dy1 - dy0, 8),
+                            layer_count);
+   }
+
+   const VkImageMemoryBarrier2 decoded =
+      dzn_texcompress_barrier(cmdbuf->texcompress.scratch, 0, 0, cmdbuf->texcompress.scratch_extent.depth,
+                              VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+                              VK_IMAGE_LAYOUT_GENERAL,
+                              VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,
+                              VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+   dzn_texcompress_barriers(cmdbuf, 1, &decoded);
+
+   const uint32_t push[] = {
+      bx0, by0, blocks_x, blocks_y, width, height, base_layer, row_blocks, slice_rows, 0,
+   };
+   disp->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, device->texcompress.bc3.pipeline);
+   disp->CmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, device->texcompress.bc3.p_layout,
+                               0, 1, &encode_set, 0, NULL);
+   disp->CmdPushConstants(cmd, device->texcompress.bc3.p_layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                          0, sizeof(push), push);
+   disp->CmdDispatch(cmd, DIV_ROUND_UP(blocks_x, 8), DIV_ROUND_UP(blocks_y, 8), layer_count);
+
+   cmdbuf->state.bindpoint[VK_PIPELINE_BIND_POINT_COMPUTE] = saved_bindpoint;
+   cmdbuf->state.bindpoint[VK_PIPELINE_BIND_POINT_COMPUTE].root_sig = NULL;
+   cmdbuf->state.bindpoint[VK_PIPELINE_BIND_POINT_COMPUTE].dirty |=
+      DZN_CMD_BINDPOINT_DIRTY_PIPELINE | DZN_CMD_BINDPOINT_DIRTY_HEAPS;
+   cmdbuf->state.push_constant.compute = saved_push;
+   cmdbuf->state.sysvals.compute = saved_sysvals;
+
+   const VkImageMemoryBarrier2 to_copy =
+      dzn_texcompress_barrier(dzn_image_to_handle(image), level, base_layer, layer_count,
+                              VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                              VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+                              layout,
+                              VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                              VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+   dzn_texcompress_dependency(cmdbuf,
+                              VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+                              VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT,
+                              1, &to_copy);
+
+   /* Copied with D3D12 itself: Dozen's copies take the block size from the
+    * image's Vulkan format, the ASTC or ETC2 one. */
+   VK_FROM_HANDLE(dzn_buffer, blocks, cmdbuf->texcompress.blocks);
+   /* Without enhanced barriers the buffer the encoder wrote as unordered
+    * access must be a copy source for the copy, and is unordered access again
+    * for the next encode (buffers start each submission in the common state
+    * and the first encode promotes them). */
+   D3D12_RESOURCE_BARRIER blocks_state = {
+      .Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION,
+      .Transition = {
+         .pResource = blocks->res,
+         .Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,
+         .StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+         .StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE,
+      },
+   };
+   if (!cmdbuf->enhanced_barriers)
+      ID3D12GraphicsCommandList1_ResourceBarrier(cmdbuf->cmdlist, 1, &blocks_state);
+   const DXGI_FORMAT bc3 = vk_format_is_srgb(dzn_format_get_decoded_format(format)) ?
+                           DXGI_FORMAT_BC3_UNORM_SRGB : DXGI_FORMAT_BC3_UNORM;
+   const D3D12_BOX box = {
+      .right = ALIGN_POT(bx1 - bx0, 4),
+      .bottom = ALIGN_POT(by1 - by0, 4),
+      .back = 1,
+   };
+   for (uint32_t layer = 0; layer < layer_count; layer++) {
+      const VkImageSubresourceLayers subres = {
+         .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .mipLevel = level,
+         .baseArrayLayer = base_layer,
+         .layerCount = layer_count,
+      };
+      const D3D12_TEXTURE_COPY_LOCATION dst =
+         dzn_image_get_copy_loc(image, &subres, VK_IMAGE_ASPECT_COLOR_BIT, layer);
+      const D3D12_TEXTURE_COPY_LOCATION src = {
+         .pResource = blocks->res,
+         .Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT,
+         .PlacedFootprint = {
+            .Offset = (UINT64)layer * slice_rows * row_blocks * 16,
+            .Footprint = {
+               .Format = bc3,
+               .Width = box.right,
+               .Height = box.bottom,
+               .Depth = 1,
+               .RowPitch = row_blocks * 16,
+            },
+         },
+      };
+      ID3D12GraphicsCommandList1_CopyTextureRegion(cmdbuf->cmdlist, &dst, bx0, by0, 0, &src, &box);
+   }
+   if (!cmdbuf->enhanced_barriers) {
+      blocks_state.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+      blocks_state.Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+      ID3D12GraphicsCommandList1_ResourceBarrier(cmdbuf->cmdlist, 1, &blocks_state);
+   }
+
+   const VkImageMemoryBarrier2 after[] = {
+      dzn_texcompress_barrier(dzn_image_to_handle(image), level, base_layer, layer_count,
+                              VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                              VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                              VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                              VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+                              layout),
+      dzn_texcompress_barrier(lvl->blocks, 0, base_layer, layer_count,
+                              VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_NONE,
+                              VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                              VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_NONE,
+                              VK_IMAGE_LAYOUT_GENERAL),
+   };
+   dzn_texcompress_barriers(cmdbuf, ARRAY_SIZE(after), after);
+}
