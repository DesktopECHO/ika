diff --git a/src/microsoft/vulkan/dzn_pso_cache.c b/src/microsoft/vulkan/dzn_pso_cache.c
new file mode 100644
index 0000000..6a3ce56
--- /dev/null
+++ b/src/microsoft/vulkan/dzn_pso_cache.c
@@ -0,0 +1,321 @@
