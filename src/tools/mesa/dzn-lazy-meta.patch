-VkResult
-dzn_meta_init(struct dzn_device *device)
+/* The indirect-draw and triangle-fan pipelines are only needed by draws
+ * D3D12 cannot do directly, so they are compiled the first time a command
+ * buffer records such a draw, not with every device: up to 53 compute
+ * pipelines on GPUs without triangle fans or extended ExecuteIndirect, which
+ * took about a second per vkCreateDevice. */
+const struct dzn_meta_indirect_draw *
+dzn_meta_get_indirect_draw(struct dzn_device *device, struct dzn_indirect_draw_type type)
 {
-   struct dzn_physical_device *pdev = container_of(device->vk.physical, struct dzn_physical_device, vk);
-   VkResult result = dzn_meta_blits_init(device);
-   if (result != VK_SUCCESS)
-      goto out;
+   struct dzn_meta_indirect_draw *meta = &device->indirect_draws[type.value];
 
-   for (uint32_t i = 0; i < ARRAY_SIZE(device->indirect_draws); i++) {
-      struct dzn_indirect_draw_type type = { .value = i };
-      if (type.triangle_fan_primitive_restart && !type.triangle_fan)
-         continue;
-      if (type.triangle_fan && pdev->options15.TriangleFanSupported)
-         continue;
-      if (type.draw_params && pdev->options21.ExtendedCommandInfoSupported)
-         continue;
-      if (type.draw_id && pdev->options21.ExecuteIndirectTier >= D3D12_EXECUTE_INDIRECT_TIER_1_1)
-         continue;
-      result = dzn_meta_indirect_draw_init(device, type);
-      if (result != VK_SUCCESS)
-         goto out;
-   }
+   mtx_lock(&device->meta_lock);
+   if (!meta->pipeline_state)
+      dzn_meta_indirect_draw_init(device, type);
+   mtx_unlock(&device->meta_lock);
 
-   if (!pdev->options15.TriangleFanSupported) {
-      for (uint32_t i = 0; i < ARRAY_SIZE(device->triangle_fan); i++) {
-         result = dzn_meta_triangle_fan_rewrite_index_init(device, i);
-         if (result != VK_SUCCESS)
-            goto out;
-      }
-   }
+   return meta->pipeline_state ? meta : NULL;
+}
 
-out:
-   if (result != VK_SUCCESS) {
-      dzn_meta_finish(device);
-      return result;
-   }
+const struct dzn_meta_triangle_fan_rewrite_index *
+dzn_meta_get_triangle_fan_rewrite_index(struct dzn_device *device, enum dzn_index_type index_type)
+{
+   struct dzn_meta_triangle_fan_rewrite_index *meta = &device->triangle_fan[index_type];
 
-   return VK_SUCCESS;
+   mtx_lock(&device->meta_lock);
+   if (!meta->pipeline_state)
+      dzn_meta_triangle_fan_rewrite_index_init(device, index_type);
+   mtx_unlock(&device->meta_lock);
+
+   return meta->pipeline_state ? meta : NULL;
+}
+
+VkResult
+dzn_meta_init(struct dzn_device *device)
+{
+   mtx_init(&device->meta_lock, mtx_plain);
+
+   /* On failure, dzn_device_destroy() calls dzn_meta_finish(). */
+   return dzn_meta_blits_init(device);
 }
