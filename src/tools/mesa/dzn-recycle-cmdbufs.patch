+++ b/src/microsoft/vulkan/dzn_device.c
@@ -2490,6 +2490,7 @@ dzn_device_create(struct dzn_physical_device *pdev,
     * whole struct.
     */
    device->vk.command_dispatch_table = &device->cmd_dispatch;
+   device->vk.command_buffer_ops = &dzn_cmd_buffer_ops;
    device->vk.check_status = dzn_device_check_status;
 
    device->dev = pdev->dev;
