diff --git a/src/microsoft/vulkan/dzn_image.c b/src/microsoft/vulkan/dzn_image.c
index a16e0a8..06e178b 100644
--- a/src/microsoft/vulkan/dzn_image.c
+++ b/src/microsoft/vulkan/dzn_image.c
@@ -1449,6 +1449,108 @@ dzn_image_view_finish(struct dzn_image_view *iview)
    vk_image_view_finish(&iview->vk);
 }
 
+/* Without relaxed format casting, a mutable-format image is a typeless
+ * resource, and Direct3D 12 takes only views of that format family: a view
+ * of another family (an R8G8B8A8 image seen as R32_UINT, say), which Vulkan
+ * allows for formats of the same texel size, is an invalid call, and some
+ * drivers (Intel's under WSL2) remove the device for it, taking down every
+ * other user of the device. Such a view gets the image's own format instead:
+ * the texels are read with the wrong type, but the device stays.
+ */
+static DXGI_FORMAT
+dzn_image_view_castable_format(const struct dzn_physical_device *pdev,
+                               const struct dzn_image *image,
+                               DXGI_FORMAT view_format,
+                               VkImageUsageFlags usage,
+                               VkImageAspectFlags aspects)
+{
+   DXGI_FORMAT family = image->desc.Format;
+   if (view_format == DXGI_FORMAT_UNKNOWN ||
+       dzn_get_typeless_dxgi_format(view_format) == family)
+      return view_format;
+
+   DXGI_FORMAT own = dzn_image_get_dxgi_format(pdev, image->vk.format, usage, aspects);
+   if (dzn_get_typeless_dxgi_format(own) != family)
+      return view_format;
+
+   static bool warned;
+   if (!warned) {
+      warned = true;
+      mesa_logw("dzn: this GPU's Direct3D 12 driver has no relaxed format casting; "
+                "a view in DXGI format %d of an image of format family %d uses format %d",
+                view_format, family, own);
+   }
+   return own;
+}
+
+/* The format Dozen can use for a view of an image in Direct3D 12: the
+ * view's, or the image's own when the view's is of another format family
+ * than a typeless mutable-format resource without relaxed format casting
+ * (see dzn_image_view_castable_format).
+ */
+VkFormat
+dzn_image_view_d3d12_format(const struct dzn_image_view *iview)
+{
+   const struct dzn_image *image =
+      container_of(iview->vk.image, struct dzn_image, vk);
+   const struct dzn_physical_device *pdev =
+      container_of(iview->vk.base.device->physical, struct dzn_physical_device, vk);
+
+   if (iview->vk.format == image->vk.format ||
+       pdev->options12.RelaxedFormatCastingSupported ||
+       !(image->vk.create_flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) ||
+       dzn_format_is_emulated(pdev, image->vk.format) ||
+       iview->vk.aspects != VK_IMAGE_ASPECT_COLOR_BIT ||
+       dzn_get_typeless_dxgi_format(image->desc.Format) != image->desc.Format)
+      return iview->vk.format;
+
+   DXGI_FORMAT view_dxgi =
+      dzn_image_get_dxgi_format(pdev, iview->vk.format, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+                                VK_IMAGE_ASPECT_COLOR_BIT);
+   return dzn_get_typeless_dxgi_format(view_dxgi) == image->desc.Format ?
+          iview->vk.format : image->vk.format;
+}
+
+static void
+dzn_image_view_keep_castable(struct dzn_image_view *iview,
+                             const struct dzn_image *image)
+{
+   struct dzn_physical_device *pdev =
+      container_of(iview->vk.base.device->physical, struct dzn_physical_device, vk);
+
+   if (pdev->options12.RelaxedFormatCastingSupported ||
+       !(image->vk.create_flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) ||
+       dzn_format_is_emulated(pdev, image->vk.format) ||
+       iview->vk.aspects != VK_IMAGE_ASPECT_COLOR_BIT ||
+       dzn_get_typeless_dxgi_format(image->desc.Format) != image->desc.Format)
+      return;
+
+   iview->srv_desc.Format =
+      dzn_image_view_castable_format(pdev, image, iview->srv_desc.Format,
+                                     iview->vk.usage & ~VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
+                                     iview->vk.aspects);
+   if (iview->vk.usage & VK_IMAGE_USAGE_STORAGE_BIT) {
+      iview->uav_desc.Format =
+         dzn_image_view_castable_format(pdev, image, iview->uav_desc.Format,
+                                        VK_IMAGE_USAGE_STORAGE_BIT, iview->vk.aspects);
+      DXGI_FORMAT int_format =
+         dzn_image_view_castable_format(pdev, image, iview->int_uav_desc.Format,
+                                        VK_IMAGE_USAGE_STORAGE_BIT, iview->vk.aspects);
+      if (int_format != iview->int_uav_desc.Format) {
+         /* Keep the integer view an integer one, of the image's format */
+         enum pipe_format own_int =
+            dzn_storage_image_int_format(vk_format_to_pipe_format(image->vk.format));
+         if (pdev->storage_image_int_views && own_int != PIPE_FORMAT_NONE)
+            int_format = dzn_pipe_to_dxgi_format(own_int);
+      }
+      iview->int_uav_desc.Format = int_format;
+   }
+   if (iview->vk.usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT)
+      iview->rtv_desc.Format =
+         dzn_image_view_castable_format(pdev, image, iview->rtv_desc.Format,
+                                        VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT, iview->vk.aspects);
+}
+
 void
 dzn_image_view_init(struct dzn_device *device,
                     struct dzn_image_view *iview,
@@ -1500,6 +1602,8 @@ dzn_image_view_init(struct dzn_device *device,
 
    if (iview->vk.usage & VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
       dzn_image_view_prepare_dsv_desc(iview);
+
+   dzn_image_view_keep_castable(iview, image);
 }
 
