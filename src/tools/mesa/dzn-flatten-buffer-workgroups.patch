+static bool
+uses_images(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type == nir_instr_type_tex)
+      return true;
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+   return strstr(nir_intrinsic_infos[intr->intrinsic].name, "image") != NULL;
+}
+
+static bool
+flatten_workgroup_ids(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   const uint16_t *size = data;
+
+   if (intr->intrinsic != nir_intrinsic_load_local_invocation_id &&
+       intr->intrinsic != nir_intrinsic_load_global_invocation_id &&
+       intr->intrinsic != nir_intrinsic_load_workgroup_size)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *wg_size = nir_imm_ivec3(b, size[0], size[1], size[2]);
+   nir_def *res = wg_size;
+   if (intr->intrinsic != nir_intrinsic_load_workgroup_size) {
+      nir_def *index = nir_load_local_invocation_index(b);
+      res = nir_vec3(b, nir_umod_imm(b, index, size[0]),
+                     nir_umod_imm(b, nir_udiv_imm(b, index, size[0]), size[1]),
+                     nir_udiv_imm(b, index, size[0] * size[1]));
+      if (intr->intrinsic == nir_intrinsic_load_global_invocation_id)
+         res = nir_iadd(b, nir_imul(b, nir_load_workgroup_id(b), wg_size), res);
+   }
+
+   nir_def_replace(&intr->def, nir_u2uN(b, res, intr->def.bit_size));
+   return true;
+}
