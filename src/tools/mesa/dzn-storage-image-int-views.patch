+static nir_def *
+int_texel_to_float(nir_builder *b, nir_def *v, enum pipe_format format)
+{
+   const struct util_format_description *desc = util_format_description(format);
+   unsigned n = desc->nr_channels;
+   unsigned bits[4] = { 0 };
+   nir_def *c[4];
+
+   for (unsigned i = 0; i < n; i++)
+      bits[i] = desc->channel[i].size;
+
+   nir_def *t = nir_trim_vector(b, v, n);
+   if (desc->channel[0].type == UTIL_FORMAT_TYPE_FLOAT && bits[0] == 16) {
+      for (unsigned i = 0; i < n; i++)
+         c[i] = nir_channel(b, nir_unpack_half_2x16(b, nir_channel(b, t, i)), 0);
+      t = nir_vec(b, c, n);
+   } else if (desc->channel[0].type == UTIL_FORMAT_TYPE_UNSIGNED) {
+      t = nir_format_unorm_to_float(b, t, bits);
+   } else if (desc->channel[0].type == UTIL_FORMAT_TYPE_SIGNED) {
+      t = nir_format_snorm_to_float(b, t, bits);
+   }
+
+   for (unsigned i = 0; i < 4; i++)
+      c[i] = i < n ? nir_channel(b, t, i) : nir_imm_float(b, i == 3 ? 1.0f : 0.0f);
+   return nir_vec(b, c, v->num_components);
+}
+
+static nir_def *
+float_texel_to_int(nir_builder *b, nir_def *v, enum pipe_format format)
+{
+   const struct util_format_description *desc = util_format_description(format);
+   unsigned n = desc->nr_channels;
+   unsigned bits[4] = { 0 };
+   nir_def *c[4];
+
+   for (unsigned i = 0; i < n; i++)
+      bits[i] = desc->channel[i].size;
+
+   nir_def *t = nir_trim_vector(b, v, n);
+   if (desc->channel[0].type == UTIL_FORMAT_TYPE_FLOAT && bits[0] == 16)
+      t = nir_format_float_to_half(b, t);
+   else if (desc->channel[0].type == UTIL_FORMAT_TYPE_UNSIGNED)
+      t = nir_format_float_to_unorm(b, t, bits);
+   else if (desc->channel[0].type == UTIL_FORMAT_TYPE_SIGNED)
+      t = nir_format_float_to_snorm(b, t, bits);
+
+   for (unsigned i = 0; i < 4; i++)
+      c[i] = i < n ? nir_channel(b, t, i) : nir_imm_int(b, 0);
+   return nir_vec(b, c, v->num_components);
+}
