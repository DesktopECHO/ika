+
+/* Where the Direct3D 12 driver ignores the blend factor, Dozen turns constant
+ * blend factors into dual-source (SRC1) ones, and the fragment shader writes
+ * the blend constants, from the runtime data, as its second output.
+ */
+void
+dzn_nir_write_blend_constants_src1(nir_shader *fs,
+                                   uint32_t runtime_data_register_space,
+                                   uint32_t runtime_data_base_shader_register)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(fs);
+   nir_builder builder = nir_builder_at(nir_after_impl(impl));
+   nir_builder *b = &builder;
+
+   nir_binding binding = {
+      .binding = runtime_data_base_shader_register,
+      .desc_set = runtime_data_register_space,
+      .success = true,
+   };
+   if (!nir_get_binding_variable(fs, binding)) {
+      const struct glsl_struct_field runtime_data_field = {
+         glsl_array_type(glsl_uint_type(),
+                         sizeof(struct dxil_spirv_vertex_runtime_data) / sizeof(unsigned),
+                         sizeof(unsigned)),
+         "arr"
+      };
+      nir_variable *runtime_data =
+         nir_variable_create(fs, nir_var_mem_ubo,
+                             glsl_struct_type(&runtime_data_field, 1, "runtime_data", false),
+                             "runtime_data");
+      runtime_data->data.descriptor_set = runtime_data_register_space;
+      runtime_data->data.binding = runtime_data_base_shader_register;
+      runtime_data->data.how_declared = nir_var_hidden;
+   }
+
+   nir_def *constants[4];
+   for (unsigned i = 0; i < 4; i++) {
+      constants[i] =
+         load_vertex_runtime_data(b, runtime_data_register_space,
+                                  runtime_data_base_shader_register,
+                                  offsetof(struct dxil_spirv_vertex_runtime_data, blend_constants) + i * 4);
+   }
+
+   /* A shader can write a second output that the blend does not use; the
+    * constants take its place, written last. */
+   nir_variable *out = NULL;
+   nir_foreach_shader_out_variable(var, fs) {
+      if (var->data.location == FRAG_RESULT_DATA0 && var->data.index == 1)
+         out = var;
+   }
+
+   if (out && glsl_get_bare_type(out->type) == glsl_vec4_type()) {
+      nir_store_var(b, out, nir_vec(b, constants, 4), 0xf);
+      return;
+   }
+   if (out) {
+      /* Not a vec4: keep the shader's writes, to a variable of its own */
+      out->data.mode = nir_var_shader_temp;
+      nir_fixup_deref_modes(fs);
+   }
+
+   out = nir_variable_create(fs, nir_var_shader_out, glsl_vec4_type(), "dzn_blend_constants");
+   out->data.location = FRAG_RESULT_DATA0;
+   out->data.index = 1;
+   nir_store_var(b, out, nir_vec(b, constants, 4), 0xf);
+
+   dxil_sort_ps_outputs(fs);
+}
