+static bool
+is_dual_source_blend_factor(VkBlendFactor factor)
+{
+   return factor == VK_BLEND_FACTOR_SRC1_COLOR ||
+          factor == VK_BLEND_FACTOR_ONE_MINUS_SRC1_COLOR ||
+          factor == VK_BLEND_FACTOR_SRC1_ALPHA ||
+          factor == VK_BLEND_FACTOR_ONE_MINUS_SRC1_ALPHA;
+}
+
+/* A constant blend factor as a dual-source one (blend.constants_src1) */
+static D3D12_BLEND
+translate_blend_factor_src1(VkBlendFactor in, bool is_alpha, bool support_alpha_blend_factor)
+{
+   switch (in) {
+   case VK_BLEND_FACTOR_CONSTANT_COLOR:
+      return is_alpha ? D3D12_BLEND_SRC1_ALPHA : D3D12_BLEND_SRC1_COLOR;
+   case VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR:
+      return is_alpha ? D3D12_BLEND_INV_SRC1_ALPHA : D3D12_BLEND_INV_SRC1_COLOR;
+   case VK_BLEND_FACTOR_CONSTANT_ALPHA:
+      return D3D12_BLEND_SRC1_ALPHA;
+   case VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA:
+      return D3D12_BLEND_INV_SRC1_ALPHA;
+   default:
+      return translate_blend_factor(in, is_alpha, support_alpha_blend_factor);
+   }
+}
+
+/* Whether a blend writes the alpha of its attachment: alpha is in its write
+ * mask, and its format has alpha.
+ */
+static bool
+dzn_blend_writes_alpha(const VkPipelineColorBlendAttachmentState *att, VkFormat format)
+{
+   return (att->colorWriteMask & VK_COLOR_COMPONENT_A_BIT) &&
+          (format == VK_FORMAT_UNDEFINED ||
+           util_format_has_alpha(vk_format_to_pipe_format(format)));
+}
+
+/* Intel's Direct3D 12 driver for 12th-generation and newer GPUs (32.0.101.7092
+ * on a UHD 770 under WSL2) ignores the blend factor (OMSetBlendFactor): it
+ * blends with each colour channel rounded to 0 or 1 and an alpha of 0. Where
+ * a pipeline can, it takes the constants as a second, dual-source output of
+ * its fragment shader instead: one colour attachment, no logic op and no
+ * dual-source factors of its own. Older Intel drivers blend the constants
+ * correctly, and take the dual-source path as well. Alpha factors count only
+ * where the blend writes alpha (see dzn_graphics_pipeline_translate_blend). */
+static bool
+dzn_graphics_pipeline_blend_constants_src1(const struct dzn_physical_device *pdev,
+                                           const VkPipelineColorBlendStateCreateInfo *in_blend,
+                                           VkFormat format)
+{
+   if (pdev->desc.vendor_id != 0x8086 || in_blend->logicOpEnable ||
+       in_blend->attachmentCount != 1 || !in_blend->pAttachments[0].blendEnable)
+      return false;
+
+   const VkPipelineColorBlendAttachmentState *att = &in_blend->pAttachments[0];
+   VkBlendFactor factors[4] = {
+      att->srcColorBlendFactor, att->dstColorBlendFactor,
+      att->srcAlphaBlendFactor, att->dstAlphaBlendFactor,
+   };
+   unsigned count = dzn_blend_writes_alpha(att, format) ? 4 : 2;
+   bool constant = false;
+   for (unsigned i = 0; i < count; i++) {
+      if (is_dual_source_blend_factor(factors[i]))
+         return false;
+      constant |= is_constant_color_blend_factor(factors[i]) ||
+                  is_constant_alpha_blend_factor(factors[i]);
+   }
+   return constant;
+}
