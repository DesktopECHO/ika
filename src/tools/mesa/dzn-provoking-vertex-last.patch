+/* The vertex (0 to 2) of a primitive the fragment shader reads flat inputs
+ * from, or 0 for Direct3D 12's own, the first. Vulkan's
+ * VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT, which ANGLE asks for as OpenGL ES
+ * takes flat values from the last vertex, was advertised and ignored: every
+ * flat varying and integer output came from the wrong vertex. The fragment
+ * shader now reads them with attributeAtVertex at the last vertex, which needs
+ * barycentrics support and the primitive as the vertex shader emits it. Dozen
+ * draws a triangle fan as a list of (i + 1, i + 2, 0) triangles, whose last
+ * Vulkan vertex is their second. Direct3D 12 reorders the odd triangles of a
+ * strip, so strips keep the first vertex, as do pipelines with a geometry or
+ * tessellation stage.
+ */
+static uint8_t
+dzn_graphics_pipeline_fs_provoking_vertex(const struct dzn_physical_device *pdev,
+                                          const VkGraphicsPipelineCreateInfo *info,
+                                          mesa_shader_stage last_raster_stage)
+{
+   if (!pdev->options3.BarycentricsSupported ||
+       last_raster_stage != MESA_SHADER_VERTEX ||
+       !info->pRasterizationState || !info->pInputAssemblyState)
+      return 0;
+
+   const VkPipelineRasterizationProvokingVertexStateCreateInfoEXT *pv_info =
+      vk_find_struct_const(info->pRasterizationState->pNext,
+                           PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT);
+   if (!pv_info || pv_info->provokingVertexMode != VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT)
+      return 0;
+
+   bool dynamic_topology = false;
+   for (uint32_t i = 0; info->pDynamicState && i < info->pDynamicState->dynamicStateCount; i++) {
+      if (info->pDynamicState->pDynamicStates[i] == VK_DYNAMIC_STATE_PRIMITIVE_TOPOLOGY)
+         dynamic_topology = true;
+   }
+
+   VkPrimitiveTopology topology = info->pInputAssemblyState->topology;
+   switch (to_prim_topology_type(topology)) {
+   case D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE:
+      return 1;
+   case D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE:
+      if (dynamic_topology)
+         return 2;
+      if (topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN)
+         return 1;
+      return topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP ? 0 : 2;
+   default:
+      return 0;
+   }
+}
