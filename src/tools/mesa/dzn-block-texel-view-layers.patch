+static bool
+dzn_dxgi_format_is_block_compressed(DXGI_FORMAT format)
+{
+   switch (dzn_get_typeless_dxgi_format(format)) {
+   case DXGI_FORMAT_BC1_TYPELESS:
+   case DXGI_FORMAT_BC2_TYPELESS:
+   case DXGI_FORMAT_BC3_TYPELESS:
+   case DXGI_FORMAT_BC4_TYPELESS:
+   case DXGI_FORMAT_BC5_TYPELESS:
+   case DXGI_FORMAT_BC6H_TYPELESS:
+   case DXGI_FORMAT_BC7_TYPELESS:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* Whether Direct3D 12 refuses a view in this format of the image, the view
+ * covering more than one mip level or array layer when multi is set: a view
+ * of a block-compressed resource in an uncompressed format (Vulkan's
+ * block-texel view, such as an R32G32B32A32_UINT view of a BC3 image) must
+ * cover one mip level and one layer. Direct3D 12 answers such a view by
+ * removing the device, which loses every Vulkan device on it.
+ */
+static bool
+dzn_image_view_is_refused(const struct dzn_image *image, DXGI_FORMAT format, bool multi)
+{
+   return multi && format != DXGI_FORMAT_UNKNOWN &&
+          dzn_dxgi_format_is_block_compressed(image->desc.Format) &&
+          !dzn_dxgi_format_is_block_compressed(format);
+}
+
+/* The resource to create a shader resource or unordered access view of the
+ * image view from: the image's, or NULL for a null descriptor (reads return
+ * zero, writes are dropped) when Direct3D 12 would refuse the view.
+ */
+ID3D12Resource *
+dzn_image_view_resource(const struct dzn_image_view *iview, DXGI_FORMAT format, bool uav)
+{
+   const struct dzn_image *image = container_of(iview->vk.image, struct dzn_image, vk);
+   bool multi = iview->vk.layer_count > 1 || (!uav && iview->vk.level_count > 1);
+
+   return dzn_image_view_is_refused(image, format, multi) ? NULL : image->res;
+}
+
+static void
+dzn_image_view_warn_refused(const struct dzn_image_view *iview)
+{
+   static bool warned;
+   const struct dzn_image *image = container_of(iview->vk.image, struct dzn_image, vk);
+   bool refused = dzn_image_view_resource(iview, iview->srv_desc.Format, false) == NULL && image->res;
+
+   if (iview->vk.usage & VK_IMAGE_USAGE_STORAGE_BIT)
+      refused = refused ||
+                (image->res && (dzn_image_view_resource(iview, iview->uav_desc.Format, true) == NULL ||
+                                dzn_image_view_resource(iview, iview->int_uav_desc.Format, true) == NULL));
+
+   if (refused && !warned) {
+      warned = true;
+      mesa_logw("dzn: Direct3D 12 cannot view a %s image as %s across %u mip levels and %u "
+                "layers; the view reads zeros and drops writes",
+                vk_Format_to_str(image->vk.format), vk_Format_to_str(iview->vk.format),
+                iview->vk.level_count, iview->vk.layer_count);
+   }
+}
