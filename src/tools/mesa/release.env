# The Mesa release every Ika Mesa build uses: the ROM's external/mesa3d and
# the host's Lavapipe, Dozen and D3D12 OpenGL (src/tools/mesa/Makefile). To
# move to another release, change these three lines, rerun
# src/lineageos/scripts/mesa3d/regenerate.sh (it pins the manifest's
# external/mesa3d to MESA_COMMIT), and check that the patches in
# src/lineageos/patches/series and src/tools/mesa/series still apply.
# Read by bash, make and src/tools/tests/test_ika_mesa_release.sh.
MESA_VERSION=26.3.0-rc3
# The commit of the mesa-$(MESA_VERSION) tag.
MESA_COMMIT=90a959ebba9dbb36f2ea5176091c15d6ebdd0af0
# The sha256 of https://archive.mesa3d.org/mesa-$(MESA_VERSION).tar.xz.
MESA_SHA256=3600c01f11439628d0a85de5ed9cb76f297d13e9783cdeecb91aa685055c9942
