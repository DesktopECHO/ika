+/* Whether the fences already satisfy a wait. */
+static bool
+dzn_sync_waits_satisfied(const struct vk_sync_wait *waits, uint32_t wait_count,
+                         bool any)
+{
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct dzn_sync *sync = container_of(waits[i].sync, struct dzn_sync, vk);
+      uint64_t value = (sync->vk.flags & VK_SYNC_IS_TIMELINE) ? waits[i].wait_value : 1;
+      bool done = ID3D12Fence_GetCompletedValue(sync->fence) >= value;
+      if (any && done)
+         return true;
+      if (!any && !done)
+         return false;
+   }
+   return !any;
+}
+
+#ifndef _WIN32
+/* How long dzn_sync_wait() polls before it blocks, in nanoseconds, and how it
+ * polls: yielding for the first DZN_SPIN_YIELD_US, then sleeping
+ * DZN_SPIN_SLEEP_US between polls. Under WSL2 a blocked wait is an RPC to the
+ * Windows host (the graphics kernel's wait-for-synchronization-object ioctl)
+ * that took 6 to 10 ms to return, 8 ms on average, with GPU work in flight,
+ * while the fence's completed value showed the completion within 0.15 ms of
+ * it. DZN_SPIN_US sets the time, 0 never polls; native Windows does not
+ * poll. */
+struct dzn_sync_spin {
+   uint64_t total_ns;
+   uint64_t yield_ns;
+   uint64_t sleep_ns;
+};
+
+static const struct dzn_sync_spin *
+dzn_sync_spin_config(void)
+{
+   static struct dzn_sync_spin cfg;
+   static bool init;
+   if (!init) {
+      cfg.total_ns = (uint64_t)debug_get_num_option("DZN_SPIN_US", 50000) * 1000;
+      cfg.yield_ns = (uint64_t)debug_get_num_option("DZN_SPIN_YIELD_US", 300) * 1000;
+      cfg.sleep_ns = (uint64_t)debug_get_num_option("DZN_SPIN_SLEEP_US", 50) * 1000;
+      init = true;
+   }
+   return &cfg;
+}
+#endif
