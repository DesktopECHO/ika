+#ifndef _WIN32
+   /* A wait that blocks in the kernel returns long after the fence completed
+    * (see dzn_sync_spin_config()), so poll the completed values for a while
+    * first. */
+   const struct dzn_sync_spin *spin = dzn_sync_spin_config();
+   if (spin->total_ns) {
+      uint64_t start = os_time_get_nano();
+      uint64_t now = start;
+      uint64_t spin_end = start + spin->total_ns;
+      if (abs_timeout_ns != OS_TIMEOUT_INFINITE && abs_timeout_ns < spin_end)
+         spin_end = abs_timeout_ns;
+      while (now < spin_end) {
+         if (now - start < spin->yield_ns)
+            sched_yield();
+         else
+            os_time_sleep(spin->sleep_ns / 1000);
+         if (dzn_sync_waits_satisfied(waits, wait_count, any))
+            return VK_SUCCESS;
+         now = os_time_get_nano();
+      }
+      if (abs_timeout_ns != OS_TIMEOUT_INFINITE && abs_timeout_ns <= now)
+         return VK_TIMEOUT;
+   }
+#endif
