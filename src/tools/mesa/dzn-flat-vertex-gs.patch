+         _mesa_blake3_update(&gs_hash_ctx, stages[MESA_SHADER_FRAGMENT].nir_hash, BLAKE3_KEY_LEN);
+         _mesa_blake3_update(&gs_hash_ctx, &lines, sizeof(lines));
