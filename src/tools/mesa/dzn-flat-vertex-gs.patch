+/* Without barycentrics, VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT takes a
+ * geometry shader that gives every vertex of a primitive the flat outputs of
+ * its last one (dzn_nir_flat_vertex_gs), for lines and triangles drawn by a
+ * vertex shader. The pipeline gets it only if its fragment shader has flat
+ * inputs. */
+static bool
+dzn_graphics_pipeline_wants_flat_vertex_gs(const struct dzn_physical_device *pdev,
+                                           const VkGraphicsPipelineCreateInfo *info,
+                                           mesa_shader_stage last_raster_stage)
+{
+   if (pdev->options3.BarycentricsSupported ||
+       last_raster_stage != MESA_SHADER_VERTEX ||
+       !info->pRasterizationState || !info->pInputAssemblyState)
+      return false;
+
+   const VkPipelineRasterizationProvokingVertexStateCreateInfoEXT *pv_info =
+      vk_find_struct_const(info->pRasterizationState->pNext,
+                           PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT);
+   if (!pv_info || pv_info->provokingVertexMode != VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT)
+      return false;
+
+   switch (info->pInputAssemblyState->topology) {
+   case VK_PRIMITIVE_TOPOLOGY_LINE_LIST:
+   case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN:
+      return true;
+   default:
+      return false;
+   }
+}
+
 static VkResult
 dzn_graphics_pipeline_compile_shaders(struct dzn_device *device,
                                       struct dzn_graphics_pipeline *pipeline,
@@ -1254,6 +1287,16 @@ dzn_graphics_pipeline_compile_shaders(struct dzn_device *device,
 
    uint8_t fs_provoking_vertex =
       dzn_graphics_pipeline_fs_provoking_vertex(pdev, info, last_raster_stage);
+   bool flat_vertex_gs =
+      !pipeline->use_gs_for_polygon_mode_point && !lower_view_index &&
+      dzn_graphics_pipeline_wants_flat_vertex_gs(pdev, info, last_raster_stage);
+   /* The geometry shader takes lines or triangles. The pipeline hash has no
+    * topology of its own, so it takes this, or a lines pipeline would get the
+    * cached geometry shader of a triangles one with the same shaders. */
+   bool flat_vertex_gs_lines =
+      flat_vertex_gs &&
+      to_prim_topology_type(info->pInputAssemblyState->topology) ==
+      D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE;
 
    if (cache) {
       dzn_graphics_pipeline_hash_attribs(attribs, vi_conversions, attribs_hash);
@@ -1262,6 +1305,7 @@ dzn_graphics_pipeline_compile_shaders(struct dzn_device *device,
 
       _mesa_blake3_init(&pipeline_hash_ctx);
