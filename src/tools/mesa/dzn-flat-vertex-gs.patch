+/* The vertex, in the primitive a geometry shader gets, of the last vertex of a
+ * Vulkan primitive, for the flat inputs of the fragment shader
+ * (dzn_nir_flat_vertex_gs). Direct3D 12's own triangle fans hand over
+ * (0, i + 1, i + 2); where it has none, Dozen draws a fan as a list of
+ * (i + 1, i + 2, 0) triangles. */
+static uint32_t
+dzn_flat_vertex(D3D12_PRIMITIVE_TOPOLOGY topology, bool triangle_fan)
+{
+   switch (topology) {
+   case D3D_PRIMITIVE_TOPOLOGY_LINELIST:
+   case D3D_PRIMITIVE_TOPOLOGY_LINESTRIP:
+      return 1;
+   case D3D_PRIMITIVE_TOPOLOGY_TRIANGLEFAN:
+      return 2;
+   case D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST:
+      return triangle_fan ? 1 : 2;
+   case D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP:
+      return DZN_FLAT_VERTEX_STRIP;
+   default:
+      return 0;
+   }
+}
+
 static void
 dzn_cmd_buffer_update_pipeline(struct dzn_cmd_buffer *cmdbuf, uint32_t bindpoint)
 {
@@ -4118,15 +4141,20 @@ dzn_cmd_buffer_update_pipeline(struct dzn_cmd_buffer *cmdbuf, uint32_t bindpoint
          struct dzn_graphics_pipeline *gfx =
             (struct dzn_graphics_pipeline *)pipeline;
          D3D12_PRIMITIVE_TOPOLOGY topology = gfx->ia.topology;
+         bool triangle_fan = gfx->ia.triangle_fan;
          if (gfx->dynamic & DZN_DYNAMIC_PRIMITIVE_TOPOLOGY) {
             struct dzn_physical_device *pdev =
                container_of(device->vk.physical, struct dzn_physical_device, vk);
-            bool triangle_fan;
             topology = dzn_translate_primitive_topology(pdev, cmdbuf->state.dyn.topology,
                                                         gfx->ia.patch_control_points,
                                                         &triangle_fan);
          }
          ID3D12GraphicsCommandList1_IASetPrimitiveTopology(cmdbuf->cmdlist, topology);
+         uint32_t flat_vertex = dzn_flat_vertex(topology, triangle_fan);
+         if (cmdbuf->state.sysvals.gfx.flat_vertex != flat_vertex) {
+            cmdbuf->state.sysvals.gfx.flat_vertex = flat_vertex;
+            cmdbuf->state.bindpoint[bindpoint].dirty |= DZN_CMD_BINDPOINT_DIRTY_SYSVALS;
+         }
          if (!dzn_graphics_pipeline_get_state(gfx, &cmdbuf->state.pipeline_variant)) {
             vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
             return;
diff --git a/src/microsoft/vulkan/dzn_nir.c b/src/microsoft/vulkan/dzn_nir.c
index b803a9c..10e02d0 100644
--- a/src/microsoft/vulkan/dzn_nir.c
+++ b/src/microsoft/vulkan/dzn_nir.c
@@ -982,3 +982,170 @@ dzn_nir_polygon_point_mode_gs(const nir_shader *previous_shader, struct dzn_nir_
    NIR_PASS(_, nir, nir_lower_var_copies);
    return b->shader;
 }
+
+static nir_def *
+load_vertex_runtime_data(nir_builder *b, uint32_t register_space,
+                         uint32_t base_shader_register, unsigned offset)
+{
+   nir_address_format ubo_format = nir_address_format_32bit_index_offset;
+
+   nir_def *index = nir_vulkan_resource_index(
+      b, nir_address_format_num_components(ubo_format),
+      nir_address_format_bit_size(ubo_format),
+      nir_imm_int(b, 0),
+      .desc_set = register_space,
+      .binding = base_shader_register,
+      .desc_type = nir_descriptor_type_uniform_buffer);
+
+   nir_def *load_desc = nir_load_vulkan_descriptor(
+      b, nir_address_format_num_components(ubo_format),
+      nir_address_format_bit_size(ubo_format),
+      index, .desc_type = nir_descriptor_type_uniform_buffer);
+
+   return nir_load_ubo(
+      b, 1, 32,
+      nir_channel(b, load_desc, 0),
+      nir_imm_int(b, offset),
+      .align_mul = 256,
+      .align_offset = offset);
+}
+
+/* The varying slots of the flat inputs of a fragment shader, or 0 when it
+ * has none, or reads the primitive ID, which a geometry shader would have to
+ * write.
+ */
+static uint64_t
+fs_flat_input_slots(const nir_shader *fs)
+{
+   if (BITSET_TEST(fs->info.system_values_read, SYSTEM_VALUE_PRIMITIVE_ID) ||
+       (fs->info.inputs_read & VARYING_BIT_PRIMITIVE_ID))
+      return 0;
+
+   uint64_t slots = 0;
+   nir_foreach_shader_in_variable(var, fs) {
+      int location = var->data.location;
+
+      if (location == VARYING_SLOT_PRIMITIVE_ID)
+         return 0;
+      if (var->data.interpolation != INTERP_MODE_FLAT ||
+          location < VARYING_SLOT_VAR0 || location >= 64)
+         continue;
+
+      unsigned count = MIN2(glsl_count_attribute_slots(var->type, false), 64 - location);
+      slots |= BITFIELD64_RANGE(location, count);
+   }
+
+   return slots;
+}
+
+/* A geometry shader that passes a primitive through with the flat outputs of
+ * its last vertex in every vertex, for VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT
+ * on GPUs without barycentrics: Direct3D 12 takes flat inputs from the first
+ * vertex. The vertex order, and so the rasterization and the facing, stay as
+ * they are. Which vertex is the last depends on the topology, which can be
+ * dynamic, so it comes from the runtime data (flat_vertex). NULL when the
+ * fragment shader has no flat inputs, or reads the primitive ID, or the vertex
+ * shader writes the layer or viewport.
+ */
+nir_shader *
+dzn_nir_flat_vertex_gs(const nir_shader *vs, const nir_shader *fs, bool lines,
+                       uint32_t runtime_data_register_space,
+                       uint32_t runtime_data_base_shader_register)
+{
+   if (vs->info.outputs_written & (VARYING_BIT_LAYER | VARYING_BIT_VIEWPORT))
+      return NULL;
+
+   uint64_t flat_slots = fs_flat_input_slots(fs);
+   if (!flat_slots)
+      return NULL;
+
+   unsigned vertices = lines ? 2 : 3;
+   nir_builder builder =
+      nir_builder_init_simple_shader(MESA_SHADER_GEOMETRY,
+                                     dxil_get_base_nir_compiler_options(),
+                                     "flat_vertex_gs");
+   nir_builder *b = &builder;
+   nir_shader *nir = b->shader;
+
+   nir->info.inputs_read = nir->info.outputs_written = vs->info.outputs_written;
+   nir->info.gs.input_primitive = lines ? MESA_PRIM_LINES : MESA_PRIM_TRIANGLES;
+   nir->info.gs.output_primitive = lines ? MESA_PRIM_LINE_STRIP : MESA_PRIM_TRIANGLE_STRIP;
+   nir->info.gs.vertices_in = vertices;
+   nir->info.gs.vertices_out = vertices;
+   nir->info.gs.invocations = 1;
+   nir->info.gs.active_stream_mask = 1;
+   nir->info.clip_distance_array_size = vs->info.clip_distance_array_size;
+   nir->info.cull_distance_array_size = vs->info.cull_distance_array_size;
+   BITSET_SET(nir->info.system_values_read, SYSTEM_VALUE_PRIMITIVE_ID);
+
+   unsigned num_vars = 0;
+   nir_variable *in[VARYING_SLOT_MAX];
+   nir_variable *out[VARYING_SLOT_MAX];
+   bool flat[VARYING_SLOT_MAX];
+
+   nir_foreach_shader_out_variable(var, vs) {
+      char tmp[100];
+      snprintf(tmp, ARRAY_SIZE(tmp), "in_%d", num_vars);
+      in[num_vars] = nir_variable_create(nir, nir_var_shader_in,
+                                         glsl_array_type(var->type, vertices, 0),
+                                         tmp);
+      in[num_vars]->data = var->data;
+      in[num_vars]->data.mode = nir_var_shader_in;
+
+      snprintf(tmp, ARRAY_SIZE(tmp), "out_%d", num_vars);
+      out[num_vars] = nir_variable_create(nir, nir_var_shader_out, var->type, tmp);
+      out[num_vars]->data = var->data;
+
+      int location = var->data.location;
+      flat[num_vars] = false;
+      if (location >= VARYING_SLOT_VAR0 && location < 64) {
+         unsigned count = MIN2(glsl_count_attribute_slots(var->type, false), 64 - location);
+         flat[num_vars] = (flat_slots & BITFIELD64_RANGE(location, count)) != 0;
+      }
+
+      num_vars++;
+   }
+
+   /* The runtime data CBV, for nir_to_dxil to declare */
+   const struct glsl_struct_field runtime_data_field = {
+      glsl_array_type(glsl_uint_type(),
+                      sizeof(struct dxil_spirv_vertex_runtime_data) / sizeof(unsigned),
+                      sizeof(unsigned)),
+      "arr"
+   };
+   nir_variable *runtime_data =
+      nir_variable_create(nir, nir_var_mem_ubo,
+                          glsl_struct_type(&runtime_data_field, 1, "runtime_data", false),
+                          "runtime_data");
+   runtime_data->data.descriptor_set = runtime_data_register_space;
+   runtime_data->data.binding = runtime_data_base_shader_register;
+   runtime_data->data.how_declared = nir_var_hidden;
+
+   /* The vertex the flat values come from: for a triangle strip, the third of
+    * an even triangle and the second of an odd one, which Direct3D 12 hands
+    * over as (n, n + 2, n + 1). */
+   nir_def *flat_vertex =
+      load_vertex_runtime_data(b, runtime_data_register_space,
+                               runtime_data_base_shader_register,
+                               offsetof(struct dxil_spirv_vertex_runtime_data, flat_vertex));
+   nir_def *strip_vertex =
+      nir_isub(b, nir_imm_int(b, 2), nir_iand_imm(b, nir_load_primitive_id(b), 1));
+   nir_def *flat_index =
+      nir_bcsel(b, nir_ieq_imm(b, flat_vertex, DZN_FLAT_VERTEX_STRIP),
+                strip_vertex, nir_umin(b, flat_vertex, nir_imm_int(b, vertices - 1)));
+
+   for (unsigned v = 0; v < vertices; v++) {
+      for (unsigned i = 0; i < num_vars; i++) {
+         nir_def *index = flat[i] ? flat_index : nir_imm_int(b, v);
+         copy_vars(b, nir_build_deref_var(b, out[i]),
+                   nir_build_deref_array(b, nir_build_deref_var(b, in[i]), index));
+      }
+      nir_emit_vertex(b, 0);
+   }
+   nir_end_primitive(b, 0);
+
+   nir_validate_shader(nir, "in dzn_nir_flat_vertex_gs");
+
+   NIR_PASS(_, nir, nir_lower_var_copies);
+   return nir;
+}
