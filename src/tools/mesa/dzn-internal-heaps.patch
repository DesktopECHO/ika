 };
 
+/* A heap that default-heap internal buffers are placed in: see
+ * dzn_cmd_buffer_alloc_internal_buf(). */
+struct dzn_internal_heap {
+   struct list_head link;
+   ID3D12Heap *heap;
+   uint64_t size;
+};
+
 struct dzn_cmd_buffer_gpu_work {
    struct list_head link;
    ID3D12Fence *fence;
@@ -785,6 +793,11 @@ struct dzn_cmd_buffer {
 
    struct list_head internal_bufs[DZN_INTERNAL_BUF_BUCKET_COUNT];
    struct list_head gpu_work;
+   /* The heaps the default-heap internal buffers are placed in, and the one
+    * being filled. */
+   struct list_head internal_heaps;
+   struct dzn_internal_heap *cur_default_heap;
+   uint64_t cur_default_heap_offset;
    struct dzn_internal_resource *cur_upload_buf;
    uint64_t cur_upload_buf_offset;
    /* Upload buffers kept from before the last reset, for the next recording. */
