Backport three fixes from Mesa's 26.3 branch

Mesa's staging/26.3 branch, after 26.3.1. Drop this patch when the Mesa
release moves to one that has them (26.3.2).

- 9acd867d nir/clone: preserve input attachment info of texture
  instructions, which were lost when a loop containing subpassLoad() was
  unrolled.
- a43fc87e nir/opt_varyings: clear output_equal_mask when a geometry shader
  stores outputs in a loop.
- 143dde4a vulkan: ignore pColorBlendState->attachmentCount when the color
  blend enable, equation and write mask are all dynamic, as Vulkan 1.4.368
  clarified.

diff --git a/src/compiler/nir/nir_clone.c b/src/compiler/nir/nir_clone.c
index a6dd752..533f61d 100644
--- a/src/compiler/nir/nir_clone.c
+++ b/src/compiler/nir/nir_clone.c
@@ -421,6 +421,11 @@ clone_tex(clone_state *state, const nir_tex_instr *tex)
    ntex->sampler_index = tex->sampler_index;
    ntex->can_speculate = tex->can_speculate;
 
+   ntex->texture_array_size = tex->texture_array_size;
+   ntex->input_attachment_index = tex->input_attachment_index;
+   ntex->input_attachment_depth = tex->input_attachment_depth;
+   ntex->input_attachment_stencil = tex->input_attachment_stencil;
+
    ntex->texture_non_uniform = tex->texture_non_uniform;
    ntex->sampler_non_uniform = tex->sampler_non_uniform;
    ntex->embedded_sampler = tex->embedded_sampler;
diff --git a/src/compiler/nir/nir_opt_varyings.c b/src/compiler/nir/nir_opt_varyings.c
index 73ddaf8..7470669 100644
--- a/src/compiler/nir/nir_opt_varyings.c
+++ b/src/compiler/nir/nir_opt_varyings.c
@@ -1763,6 +1763,24 @@ gather_outputs(struct nir_builder *builder, nir_intrinsic_instr *intr, void *cb_
          }
       }
 
+      /* If the store value is inside a loop, there might be multiple
+       * different store values to the output. This matters for geometry
+       * shaders because they can each be for a different vertex.
+       *
+       * TODO: This can disable uniform expression propagation and promotion
+       * of convergent varyings to flat. We should use some kind of proper
+       * loop invariance analysis to determine equility of output values.
+       */
+      if (linkage->producer_stage == MESA_SHADER_GEOMETRY && !nir_scalar_is_const(value)) {
+         for (nir_cf_node *node = &nir_def_instr(value.def)->block->cf_node;
+            node->type != nir_cf_node_function; node = node->parent) {
+            if (node->type == nir_cf_node_loop) {
+               BITSET_CLEAR(linkage->output_equal_mask, slot);
+               break;
+            }
+         }
+      }
+
       if (linkage->producer_stage == MESA_SHADER_MESH &&
           intr->intrinsic == nir_intrinsic_store_per_vertex_output) {
          nir_src *vertex_index_src = nir_get_io_arrayed_index_src(intr);
