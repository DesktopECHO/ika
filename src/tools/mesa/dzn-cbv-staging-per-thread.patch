dzn: Give each thread a staging descriptor of its own for constant buffer views

Constant buffer views meant for a shader-visible heap are created in a
CPU-only descriptor and copied across (dzn-cbv-staging.patch). There was one
such descriptor per device, under a lock, and gfxstream records a guest's
command buffers on two host threads at once: both took that lock for every
draw that follows new dynamic offsets and waited for each other.

Keep 16 staging descriptors with a lock each, and let each thread take the
next one the first time it creates such a view.
diff --git a/src/microsoft/vulkan/dzn_descriptor_set.c b/src/microsoft/vulkan/dzn_descriptor_set.c
index 432207e..2a8f023 100644
--- a/src/microsoft/vulkan/dzn_descriptor_set.c
+++ b/src/microsoft/vulkan/dzn_descriptor_set.c
@@ -23,6 +23,8 @@
 
 #include "dzn_private.h"
 
+#include "util/u_atomic.h"
+
 #include "vk_alloc.h"
 #include "vk_descriptors.h"
 #include "vk_util.h"
@@ -1119,12 +1121,20 @@ dzn_descriptor_heap_create_cbv(struct dzn_device *device,
       return;
    }
 
-   D3D12_CPU_DESCRIPTOR_HANDLE src = dzn_descriptor_heap_get_cpu_handle(&device->cbv_staging.heap, 0);
-   mtx_lock(&device->cbv_staging.lock);
+   /* Each thread takes the next slot the first time it gets here, so up to
+    * DZN_CBV_STAGING_SLOTS threads never share one. */
+   static uint32_t next_slot;
+   static thread_local int thread_slot = -1;
+   if (thread_slot < 0)
+      thread_slot = p_atomic_inc_return(&next_slot) % DZN_CBV_STAGING_SLOTS;
+   const uint32_t slot = thread_slot;
+
+   D3D12_CPU_DESCRIPTOR_HANDLE src = dzn_descriptor_heap_get_cpu_handle(&device->cbv_staging.heap, slot);
+   mtx_lock(&device->cbv_staging.lock[slot]);
    ID3D12Device1_CreateConstantBufferView(device->dev, desc, src);
    ID3D12Device1_CopyDescriptorsSimple(device->dev, 1, dst, src,
                                        D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
-   mtx_unlock(&device->cbv_staging.lock);
+   mtx_unlock(&device->cbv_staging.lock[slot]);
 }
 
