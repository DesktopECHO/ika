       D3D12_ENCODE_SHADER_4_COMPONENT_MAPPING(swz[0], swz[1], swz[2], swz[3]);
 
-   switch (iview->vk.view_type) {
+   switch (dzn_image_view_type(iview)) {
    case VK_IMAGE_VIEW_TYPE_1D_ARRAY:
    case VK_IMAGE_VIEW_TYPE_1D:
       if (use_array) {
@@ -1177,7 +1201,7 @@
