+                          glsl_image_type(GLSL_SAMPLER_DIM_BUF, false, GLSL_TYPE_UINT), NULL);
+   var->data.descriptor_set = space;
+   var->data.binding = reg;
+   var->data.image.format = PIPE_FORMAT_R8_UINT;
+   var->data.access = ACCESS_NON_READABLE;
+   return var;
+}
