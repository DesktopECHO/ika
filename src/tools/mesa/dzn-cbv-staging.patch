+/* Creates a constant buffer view at desc_offset in heap. A view meant for a
+ * shader-visible heap is created in a CPU-only descriptor first and copied
+ * there: NVIDIA's D3D12 driver under WSL2 takes 4 us to create a constant
+ * buffer view in a shader-visible heap, against 0.015 us in a CPU-only one
+ * and 0.15 us for the copy (an RTX 4080 Laptop GPU, driver 595.79), and
+ * Dozen creates one per dynamic uniform buffer for every draw that follows
+ * new dynamic offsets. Other drivers create and copy in a few nanoseconds.
+ */
+void
+dzn_descriptor_heap_create_cbv(struct dzn_device *device,
+                               const struct dzn_descriptor_heap *heap,
+                               uint32_t desc_offset,
+                               const D3D12_CONSTANT_BUFFER_VIEW_DESC *desc)
+{
+   D3D12_CPU_DESCRIPTOR_HANDLE dst = dzn_descriptor_heap_get_cpu_handle(heap, desc_offset);
+
+   if (!heap->shader_visible || !device->cbv_staging.heap.heap) {
+      ID3D12Device1_CreateConstantBufferView(device->dev, desc, dst);
+      return;
+   }
+
+   D3D12_CPU_DESCRIPTOR_HANDLE src = dzn_descriptor_heap_get_cpu_handle(&device->cbv_staging.heap, 0);
+   mtx_lock(&device->cbv_staging.lock);
+   ID3D12Device1_CreateConstantBufferView(device->dev, desc, src);
+   ID3D12Device1_CopyDescriptorsSimple(device->dev, 1, dst, src,
+                                       D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+   mtx_unlock(&device->cbv_staging.lock);
+}
+
 void
 dzn_descriptor_heap_write_buffer_desc(struct dzn_device *device,
                                       struct dzn_descriptor_heap *heap,
@@ -1119,7 +1149,7 @@
          .BufferLocation = info->buffer->gpuva + info->offset,
          .SizeInBytes = MIN2(ALIGN_POT(size, 256), D3D12_REQ_CONSTANT_BUFFER_ELEMENT_COUNT * 4 * sizeof(float)),
       };
-      ID3D12Device1_CreateConstantBufferView(device->dev, &cbv_desc, view_handle);
+      dzn_descriptor_heap_create_cbv(device, heap, desc_offset, &cbv_desc);
    } else if (writeable) {
       D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc = {
          .Format = DXGI_FORMAT_R32_TYPELESS,
@@ -1743,11 +1773,10 @@
             .SizeInBytes = ALIGN_POT(layout->bindings[b].inline_size,
                                      D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT),
          };
