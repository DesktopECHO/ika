#!/usr/bin/bash

# DPI is calculated automatically. Set manually by uncommenting the next line:
# export IKADPI=144

set -euo pipefail
exec 3>&1

# ika's code is in pieces, sourced in this order: from ika-lib beside this
# script (the source tree, or a copy for testing), or from where the package
# installs them.
IKA_LIB_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ika-lib"
[[ -d "${IKA_LIB_DIR}" ]] || IKA_LIB_DIR=/usr/lib/cuttlefish-common/ika
for ika_lib_piece in \
    config host defaults common camera-video cli display gpu gpu-args vm \
    wslg console apps app-options window ika-options app-windows app-menu \
    storage app-commands install lifecycle gsf-backup session; do
  # shellcheck source=/dev/null
  source "${IKA_LIB_DIR}/${ika_lib_piece}.sh"
done
unset ika_lib_piece

exec_start_command() {
  local fullscreen_mode="$1"
  shift
  local -a mode_args=()

  if [[ "${fullscreen_mode}" == "true" ]]; then
    mode_args+=(--fullscreen)
  fi
  if [[ "${START_CONSOLE}" != "true" ]]; then
    mode_args+=(--no-console)
  fi

  exec "$0" start "${mode_args[@]}" "$@"
}

main() {
  local command="${1:-help}"
  local fullscreen_mode
  local reset_data_gb
  local -a reset_args
  local -a start_args

  # On WSLg, Ika or an app started from the Windows Start menu or task bar
  # with Shift held down opens its Startup Options instead. Asked first, while
  # Shift is still held: Ika's before the GPU probe below takes seconds, an
  # app's in the background, answered in open_app_window once the guest
  # queries have run alongside it.
  if [[ ! -t 0 && ! -t 2 ]]; then
    if [[ "${command}" == "start" ]] && windows_shift_held; then
      edit_ika_settings
      return 0
    fi
    if [[ "${command}" == "app" && -n "${2:-}" && "${2}" != -* \
          && "${2}" != "sync" && "${2}" != "close" ]]; then
      start_windows_shift_probe
    fi
  fi

  # Before the GPU probe, which adb has no use for
  if [[ "${command}" == "adb" ]]; then
    shift
    require_executable "${CVD_ADB_BIN}" "adb"
    exec "${CVD_ADB_BIN}" "$@"
  fi
  # Before the GPU probe too: the start it runs probes the GPU itself
  if [[ "${command}" == "session" ]]; then
    shift
    run_session_command "$@"
    return
  fi

  ika_ini_warn_unknown
  setup_wsl_gpu_env
  setup_gpu_selection "${command}"

  case "${command}" in
    __launch-in-vcpu-scope)
      shift
      launch_in_vcpu_scope "$@"
      ;;
    start)
      CONSOLE_FAILURE_MESSAGE="Startup Failed."
      shift
      start_args=()
      START_KEEPS_RUNNING_VM="true"
      parse_start_options fullscreen_mode start_args "$@"
      # --no-console leaves an existing console window alone.
      if [[ "${START_CONSOLE}" == "true" ]]; then
        stop_startup_packaged_scrcpy console
      fi
      redirect_start_logs
      flush_start_log_notes
      repair_wslg_taskbar_pins
      sync_wslg_refresh_rate
      run_timed_operation "started" start_cvd "${fullscreen_mode}" "${start_args[@]}"
      ;;
    stop)
      shift
      stop_startup_packaged_scrcpy
      stop_app_menu_watcher
      unmount_android_storage
      if ! has_live_cvd_processes; then
        stop_dnsmasq
        report_udmabuf_leaks
        clear_stale_cvd_group
        respond "Android virtual device not running"
        return 0
      fi
      stop_cvd_internal false "$@"
      respond "Android virtual device stopped"
      ;;
    reset)
      shift
      stop_startup_packaged_scrcpy console
      reset_args=()
      parse_reset_options reset_data_gb reset_args "$@"
      confirm 'This will "Factory Reset" your Android virtual device' "Reset aborted." \
        || exit 1
      # Only once confirmed: an aborted reset leaves app windows and the menu
      # watcher alone.
      stop_startup_packaged_scrcpy
      stop_app_menu_watcher
      unmount_android_storage
      stop_cvd_internal true "${reset_args[@]}"
      save_data_gb_configuration "${reset_data_gb}"
      # A factory reset removes the installed apps. The menu is rebuilt from
      # the reset device on the next start unless it was turned off.
      remove_app_menu
      ;;
    restart)
      shift
      start_args=()
      # Before stopping anything: a bad option (or --camera finding no camera)
      # must leave the running VM and its console as they are
      parse_start_options fullscreen_mode start_args "$@"
      stop_startup_packaged_scrcpy
      stop_app_menu_watcher
      unmount_android_storage
      protect_overlay_resume
      if has_live_cvd_processes; then
        stop_cvd_internal false
        sleep 0.5
      else
        stop_dnsmasq
        respond "Android virtual device not running"
      fi
      if (( ${#START_LOG_NOTES[@]} > 0 )); then
        IKA_START_LOG_NOTES="$(printf '%s\n' "${START_LOG_NOTES[@]}")"
        export IKA_START_LOG_NOTES
      fi
      exec_start_command "${fullscreen_mode}" "${start_args[@]}"
      ;;
    status)
      if has_live_cvd_processes; then
        respond "Android virtual device running."
        respond_console_frame_path
      else
        respond "Android virtual device not running."
      fi
      ;;
    app)
      shift
      run_app_command "$@"
      ;;
    shell)
      shift
      open_android_shell "$@"
      ;;
    gsf)
      run_gsf_id_command
      ;;
    install)
      shift
      run_install_command "$@"
      ;;
    remove)
      shift
      run_remove_command "$@"
      ;;
    backup)
      shift
      (( $# <= 1 )) || die "usage: ${SCRIPT_NAME} backup [FILE]"
      run_backup_command "$@"
      ;;
    restore)
      shift
      (( $# <= 1 )) || die "usage: ${SCRIPT_NAME} restore [FILE]"
      run_restore_command "$@"
      ;;
    root)
      shift
      require_executable "${PACKAGED_IKA_ROOT_BIN}" "ika-root"
      exec "${PACKAGED_IKA_ROOT_BIN}" "$@"
      ;;
    __console_supervisor)
      shift
      run_scrcpy_supervisor "$@"
      ;;
    __app_supervisor)
      shift
      run_app_supervisor "$@"
      ;;
    __app_menu_watcher)
      run_app_menu_watcher
      ;;
    __storage_watcher)
      run_storage_watcher
      ;;
    options)
      edit_ika_settings
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
