# Without a terminal, IKA_NOTIFY reports progress and errors as notifications.
[Desktop Entry]
Name=Ika
GenericName=Android Virtual Desktop
Comment=Open the Ika desktop window
Exec=env IKA_NOTIFY=true ika start
Icon=ika-scrcpy
Terminal=false
Type=Application
Categories=Utility;RemoteAccess;
Keywords=adb;android;screen;mirroring;display;control;phone;device;
StartupNotify=false
StartupWMClass=ika
Actions=new-window;stop;restart;options;

# The new-window ID makes GNOME and KDE Plasma show this action in place of
# their own "New Window" / "Open New Window" item.
[Desktop Action new-window]
Name=Start Ika
Exec=env IKA_NOTIFY=true ika start

[Desktop Action stop]
Name=Stop Ika
Exec=env IKA_NOTIFY=true ika stop

[Desktop Action restart]
Name=Restart Ika
Exec=env IKA_NOTIFY=true ika restart

# Ika's most used settings of ika.ini, the camera among them, and its
# keyboard gamepad
[Desktop Action options]
Name=Startup options
Exec=env IKA_NOTIFY=true ika options
Icon=ika-scrcpy
