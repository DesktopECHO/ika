# Gives the Startup Options windows (ika's own, opened by 'ika app --options',
# --controller and 'ika options' with this app ID) the Ika icon in the dock
# and the task bar: GNOME shows a window the icon of the desktop entry its
# class names, and an unknown app's icon without one.
[Desktop Entry]
Type=Application
Name=Startup Options
NoDisplay=true
Exec=ika status
Icon=ika-scrcpy
StartupWMClass=ika-startup-options
SingleMainWindow=true
Terminal=false
