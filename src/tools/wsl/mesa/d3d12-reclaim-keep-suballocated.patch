    if (screen->fence->GetCompletedValue() < target)
       screen->fence->SetEventOnCompletion(target, nullptr);
 
-   d3d12_screen_reclaim_completed(screen);
-   return true;
+   return reclaim_completed(screen, keep_suballocated);
+}
