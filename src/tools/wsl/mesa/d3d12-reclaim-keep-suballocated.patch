+/* Waits for the oldest queued BO it may release, then releases the completed
+ * ones. Returns whether it released any.
+ */
+static bool
+reclaim_one(struct d3d12_screen *screen, bool keep_suballocated)
 {
    uint64_t target = 0;
    bool have_target = false;
 
    mtx_lock(&screen->pending_free_lock);
-   if (!list_is_empty(&screen->pending_free_list)) {
-      struct d3d12_pending_free_entry *head =
-         list_first_entry(&screen->pending_free_list,
-                          struct d3d12_pending_free_entry, link);
-      target = head->fence_value;
+   list_for_each_entry(struct d3d12_pending_free_entry, entry,
+                       &screen->pending_free_list, link) {
+      if (keep_suballocated && entry->bo->buffer)
+         continue;
+      target = entry->fence_value;
       have_target = true;
+      break;
    }
    mtx_unlock(&screen->pending_free_lock);
 
