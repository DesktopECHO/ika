-bool
-d3d12_screen_reclaim_completed(struct d3d12_screen *screen)
+/* Releases the BOs whose last use the GPU has completed. A suballocated
+ * BO holds a buffer of a pipebuffer slab manager, and releasing it takes
+ * the manager's lock; with keep_suballocated they stay queued, at the head
+ * of the list, for the next reclaim.
+ */
+static bool
+reclaim_completed(struct d3d12_screen *screen, bool keep_suballocated)
 {
    uint64_t completed = screen->fence->GetCompletedValue();
-   struct list_head retired;
+   struct list_head retired, kept;
    list_inithead(&retired);
+   list_inithead(&kept);
 
