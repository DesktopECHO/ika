       heap_pris.MemoryPoolPreference = D3D12_MEMORY_POOL_L0;
    }
-   d3d12_screen_reclaim_completed(screen);
+   /* A pipebuffer slab manager creates its slabs here with its lock held,
+    * and releasing a suballocated BO takes that lock: keep those queued.
+    */
+   reclaim_completed(screen, true);
    HRESULT hres;
    do {
       hres = dev->CreateCommittedResource(&heap_pris,
@@ -165,7 +173,7 @@
                                           D3D12_RESOURCE_STATE_COMMON,
                                           NULL,
                                           IID_PPV_ARGS(&res));
-   } while (hres == E_OUTOFMEMORY && d3d12_screen_reclaim_one(screen));
+   } while (hres == E_OUTOFMEMORY && reclaim_one(screen, true));
 
    if (FAILED(hres))
