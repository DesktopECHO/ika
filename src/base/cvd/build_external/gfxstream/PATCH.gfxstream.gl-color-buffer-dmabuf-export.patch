+std::optional<ColorBufferGl::DmabufExport> ColorBufferGl::exportDmabuf() {
+    typedef EGLBoolean(EGLAPIENTRY * ExportDmabufImageFn)(EGLDisplay, EGLImageKHR, int*,
+                                                          EGLuint64KHR*, int*, EGLint*, EGLint*);
+    static const ExportDmabufImageFn exportImage = reinterpret_cast<ExportDmabufImageFn>(
+        s_egl.eglGetProcAddress("eglExportDmabufImageANDROID"));
+    if (!exportImage || !m_eglImage) {
+        return std::nullopt;
+    }
+
+    RecursiveScopedContextBind context(m_helper);
+    if (!context.isOk()) {
+        return std::nullopt;
+    }
+
+    int fourcc = 0;
+    EGLuint64KHR modifier = 0;
+    int fd = -1;
+    EGLint stride = 0;
+    EGLint offset = 0;
+    if (!exportImage(m_display, m_eglImage, &fourcc, &modifier, &fd, &stride, &offset) ||
+        fd < 0) {
+        return std::nullopt;
+    }
+    m_exportedRowPitch = static_cast<uint32_t>(stride);
+    return DmabufExport{
+        .fd = fd,
+        .fourcc = static_cast<uint32_t>(fourcc),
+        .stride = static_cast<uint32_t>(stride),
+        .offset = static_cast<uint32_t>(offset),
+        .modifier = modifier,
+    };
+}
