+// Exports the memory behind an EGLImage as a dma-buf (EGL_MESA_image_dma_buf_export on the
+// host EGL), so that the VMM can hand a ColorBuffer to its display without a copy. An image
+// of a GL texture is exported through a native image of the texture's global name, created
+// with the native context of the current (translator) context; a native image is exported
+// as it is. The caller owns the returned fd.
+EGLAPI EGLBoolean EGLAPIENTRY eglExportDmabufImageANDROID(EGLDisplay display, EGLImageKHR image,
+                                                          int* fourcc, EGLuint64KHR* modifier,
+                                                          int* fd, EGLint* stride, EGLint* offset)
+{
+    VALIDATE_DISPLAY(display);
+    ImagePtr img = getEGLImage(SafeUIntFromPointer(image));
+    if (!img || !fourcc || !modifier || !fd || !stride || !offset) {
+        return EGL_FALSE;
+    }
+
+    EGLImage nativeImage = img->nativeImage;
+    bool ownsNativeImage = false;
+    if (!img->isNative) {
+        if (!img->globalTexObj) {
+            return EGL_FALSE;
+        }
+        ThreadInfo* thread = getThreadInfo();
+        if (!thread->eglContext) {
+            return EGL_FALSE;
+        }
+        EGLContext nativeContext = (EGLContext)thread->eglContext->nativeType()->getNative();
+        nativeImage = dpy->createNativeImage(
+            dpy->getHostDriverDisplay(), nativeContext, EGL_GL_TEXTURE_2D_KHR,
+            (EGLClientBuffer)SafePointerFromUInt(img->globalTexObj->getGlobalName()), nullptr);
+        if (nativeImage == (EGLImage)0) {
+            return EGL_FALSE;
+        }
+        ownsNativeImage = true;
+    }
+
+    uint64_t exportedModifier = 0;
+    int exportedStride = 0;
+    int exportedOffset = 0;
+    const bool exported = dpy->exportNativeDmabufImage(nativeImage, fourcc, &exportedModifier,
+                                                       fd, &exportedStride, &exportedOffset);
+    if (ownsNativeImage) {
+        dpy->destroyNativeImage(dpy->getHostDriverDisplay(), nativeImage);
+    }
+    if (!exported) {
+        return EGL_FALSE;
+    }
+    *modifier = exportedModifier;
+    *stride = exportedStride;
+    *offset = exportedOffset;
+    return EGL_TRUE;
+}
