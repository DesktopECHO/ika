+bool EglOsEglDisplay::exportDmabufImage(EGLDisplay dpy, EGLImage image, int* fourcc,
+                                        uint64_t* modifier, int* fd, int* stride,
+                                        int* offset) {
+    const char* extensions = mDispatcher.eglQueryString(dpy, EGL_EXTENSIONS);
+    if (!extensions || !strstr(extensions, "EGL_MESA_image_dma_buf_export")) {
+        return false;
+    }
+    auto query = reinterpret_cast<PFNEGLEXPORTDMABUFIMAGEQUERYMESAPROC>(
+        mDispatcher.eglGetProcAddress("eglExportDMABUFImageQueryMESA"));
+    auto exportImage = reinterpret_cast<PFNEGLEXPORTDMABUFIMAGEMESAPROC>(
+        mDispatcher.eglGetProcAddress("eglExportDMABUFImageMESA"));
+    if (!query || !exportImage) {
+        return false;
+    }
+    int planes = 0;
+    EGLuint64KHR mod = 0;
+    if (!query(dpy, image, fourcc, &planes, &mod) || planes != 1) {
+        return false;
+    }
+    int fds[1] = {-1};
+    EGLint strides[1] = {0};
+    EGLint offsets[1] = {0};
+    if (!exportImage(dpy, image, fds, strides, offsets) || fds[0] < 0) {
+        return false;
+    }
+    *modifier = mod;
+    *fd = fds[0];
+    *stride = strides[0];
+    *offset = offsets[0];
+    return true;
+}
