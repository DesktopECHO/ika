Patch summary:
Align gfxstream's host blobs to the host page size, not a hardcoded 4096. On
16K-page hosts (Apple Silicon under Asahi) the udmabuf-backed host-visible path
aligns its shared-memory size to the blob alignment before UDMABUF_CREATE; 4096
under-aligns the region (the kernel requires the system page size, 16384) and
the import or mapping fails. The blob alignment starts at the allocation
helper's host page size (upstream raises it further to the driver's
minImportedHostPointerAlignment where it imports host pointers), and the
mapping guard checks the mapped address against the real page size.
diff --git a/host/vulkan/vk_decoder_global_state.cpp b/host/vulkan/vk_decoder_global_state.cpp
index e6036f52d..31fdac5a2 100644
--- a/host/vulkan/vk_decoder_global_state.cpp
+++ b/host/vulkan/vk_decoder_global_state.cpp
@@ -7613,8 +7613,10 @@ class VkDecoderGlobalState::Impl {
         }
 
         if (info->needUnmap) {
-            constexpr uint64_t kPageSizeforBlob = 4096;
-            constexpr uint64_t kPageMaskForBlob = ~(0xfff);
+            // ika: the host page size, not 4096: on 16K-page hosts (Apple Silicon
+            // under Asahi) a 4K-aligned mapping cannot be mapped into the guest.
+            const uint64_t kPageSizeforBlob = static_cast<uint64_t>(getpagesize());
+            const uint64_t kPageMaskForBlob = ~(kPageSizeforBlob - 1);
             uint64_t hva = (uint64_t)(uintptr_t)(info->ptr);
             uint64_t alignedHva = hva & kPageMaskForBlob;
 
diff --git a/host/vulkan/vk_memory_allocation_helper.cpp b/host/vulkan/vk_memory_allocation_helper.cpp
index ebfff45fd..fe3afd663 100644
--- a/host/vulkan/vk_memory_allocation_helper.cpp
+++ b/host/vulkan/vk_memory_allocation_helper.cpp
@@ -192,7 +192,10 @@ VkResult selectHostVisibleSharedMemoryStrategy(const VkMemoryAllocationHelper& h
                                                VkMemoryAllocationPlan* outPlan) {
     // A system blob is imported as a host pointer, and a driver can ask for a
     // coarser alignment than a page: Apple silicon pages are 16KB.
-    uint64_t blobAlignment = kPageSizeforBlob;
+    // ika: never align below the host page size either; udmabuf (16K-page hosts
+    // under Asahi) rejects a size that is not a multiple of it.
+    uint64_t blobAlignment =
+        std::max<uint64_t>(kPageSizeforBlob, static_cast<uint64_t>(helper.hostPageSize));
     if (helper.supportsExternalMemoryHostProperties) {
         blobAlignment = std::max<uint64_t>(blobAlignment, helper.minImportedHostPointerAlignment);
     }
