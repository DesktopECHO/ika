diff --git a/host/vulkan/vk_utils.h b/host/vulkan/vk_utils.h
index 1ac4554d0..824cf92e6 100644
--- a/host/vulkan/vk_utils.h
+++ b/host/vulkan/vk_utils.h
@@ -159,6 +159,19 @@ void vk_struct_chain_filter(H* head) {
         }                                                                             \
     } while (0)
 
+// For a Vulkan call on a guest application's device: when the host GPU was reset and that device
+// was lost, the application gets VK_ERROR_DEVICE_LOST from its own calls and goes on or ends; it
+// must not end the VM. Any other failure stays fatal.
+#define VK_CHECK_GUEST_DEVICE(x)                                                              \
+    do {                                                                                      \
+        VkResult err = x;                                                                     \
+        if (err == VK_ERROR_DEVICE_LOST) {                                                    \
+            GFXSTREAM_ERROR("%s on a guest device: VK_ERROR_DEVICE_LOST", #x);               \
+        } else if (err != VK_SUCCESS) {                                                       \
+            GFXSTREAM_FATAL("VK_CHECK_GUEST_DEVICE(" #x ") failed with %s", string_VkResult(err)); \
+        }                                                                                     \
+    } while (0)
+
 #define VK_CHECK_MEMALLOC(x, allocateInfo)                                                     \
     do {                                                                                       \
         VkResult err = x;                                                                      \
