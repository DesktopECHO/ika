-    mIsHostCoherent = (memType.propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT);
+    mIsHostCoherent = (memType.propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
 
     VkMemoryAllocateInfo allocInfo = {
         .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
@@ -404,6 +404,28 @@ void VkEmulation::StagingBuffer::destroy(VulkanDispatch* vk, VkDevice device) {
         vk->vkFreeMemory(device, mMemory, nullptr);
         mMemory = VK_NULL_HANDLE;
     }
+    mAllocationSize = 0;
+}
+
+bool VkEmulation::ensureStagingBufferLocked(VkDeviceSize size) {
+    if (mStaging.mBuffer != VK_NULL_HANDLE && size <= mStaging.mAllocationSize) {
+        return true;
+    }
+    if (size > kDefaultStagingBufferSize) {
+        return false;
+    }
+    const VkDeviceSize steps = std::max<VkDeviceSize>(1, (size + kStagingBufferStep - 1) /
+                                                             kStagingBufferStep);
+    const VkDeviceSize newSize = std::min(steps * kStagingBufferStep, kDefaultStagingBufferSize);
+    // Every user of the staging buffer waits for its copy before it returns, so the old
+    // buffer is idle.
+    mStaging.destroy(mDvk, mDevice);
+    if (!mStaging.create(mDvk, mDevice, &mDeviceInfo.memProps, mDebugUtilsHelper, newSize)) {
+        GFXSTREAM_ERROR("Could not make a staging buffer of %" PRIu64 " bytes.", newSize);
+        mStaging.destroy(mDvk, mDevice);
+        return false;
+    }
+    return true;
 }
 
