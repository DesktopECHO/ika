+// Command buffers are recorded on worker threads (GFXSTREAM_PARALLEL_RECORD:
+// how many, 2 by default, 0 to record on the render thread as before).
+//
+// A guest thread's command buffers arrive whole (vkQueueFlushCommandsGOOGLE)
+// and each is followed by its submit. Recording one into the host driver
+// took half of the render thread's time in 3DMark under WSL2, while the
+// guest waited for ring space. Here a flushed command buffer is recorded on a
+// worker thread, after the previous one from the same command pool, and
+// asynchronous queue operations run on one thread in the order they were
+// decoded, each once the command buffers it submits are recorded, so the
+// render thread goes on decoding the next command buffer. A command that is
+// not known to be independent of pending work first waits for all of it.
+class SerialExecutor {
+   public:
+    SerialExecutor() : mThread([this] { run(); }) {}
+    ~SerialExecutor() {
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            mStop = true;
+        }
+        mWake.notify_all();
+        mThread.join();
+    }
+    void post(std::function<void()> task) {
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            mTasks.push_back(std::move(task));
+        }
+        mWake.notify_one();
+    }
+    void drain() {
+        std::unique_lock<std::mutex> lock(mMutex);
+        mIdle.wait(lock, [this] { return mTasks.empty() && !mBusy; });
+    }
+
+   private:
+    void run() {
+        std::unique_lock<std::mutex> lock(mMutex);
+        for (;;) {
+            mWake.wait(lock, [this] { return mStop || !mTasks.empty(); });
+            if (mTasks.empty()) return;
+            std::function<void()> task = std::move(mTasks.front());
+            mTasks.pop_front();
+            mBusy = true;
+            lock.unlock();
+            task();
+            lock.lock();
+            mBusy = false;
+            if (mTasks.empty()) mIdle.notify_all();
+        }
+    }
+
+    std::mutex mMutex;
+    std::condition_variable mWake;
+    std::condition_variable mIdle;
+    std::deque<std::function<void()>> mTasks;
+    bool mBusy = false;
+    bool mStop = false;
+    std::thread mThread;
+};
+
+class ParallelRecorder {
+   public:
+    static int threads() {
+        static const int sThreads = [] {
+            const char* env = getenv("GFXSTREAM_PARALLEL_RECORD");
+            return (env && *env) ? atoi(env) : 2;
+        }();
+        return sThreads;
+    }
+
+    // Each guest process records and submits on threads of its own, shared by
+    // its decoders: a command that waits for pending work waits only for its
+    // process's, and a process's submits never queue behind another process's
+    // recordings, as before parallel recording, when each render thread
+    // submitted on its own. With one recorder for everything, SurfaceFlinger
+    // composing a window over a game waited for the game's whole backlog in
+    // every vkCreateBuffer and showed about a frame a second.
+    static std::shared_ptr<ParallelRecorder> forProcess(const void* process) {
+        if (threads() <= 0) return nullptr;
+        static std::mutex sMutex;
+        static std::unordered_map<const void*, std::weak_ptr<ParallelRecorder>> sByProcess;
+        std::lock_guard<std::mutex> lock(sMutex);
+        for (auto it = sByProcess.begin(); it != sByProcess.end();) {
+            it = it->second.expired() ? sByProcess.erase(it) : std::next(it);
+        }
+        std::weak_ptr<ParallelRecorder>& entry = sByProcess[process];
+        std::shared_ptr<ParallelRecorder> recorder = entry.lock();
+        if (!recorder) {
+            recorder.reset(new ParallelRecorder(threads()));
+            entry = recorder;
+        }
+        return recorder;
+    }
+
+    void record(uint64_t pool, uint64_t commandBuffer, std::function<void()> task) {
+        auto promise = std::make_shared<std::promise<void>>();
+        std::shared_future<void> done = promise->get_future().share();
+        std::shared_future<void> previous;
+        size_t worker;
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            auto it = mByPool.find(pool);
+            if (it != mByPool.end()) previous = it->second;
+            mByPool[pool] = done;
+            mByCommandBuffer[commandBuffer] = done;
+            worker = mNextWorker++ % mWorkers.size();
+        }
+        mWorkers[worker]->post([task = std::move(task), promise, previous] {
+            if (previous.valid()) previous.wait();
+            task();
+            promise->set_value();
+        });
+    }
+
+    std::shared_future<void> pendingCommandBuffer(uint64_t commandBuffer) {
+        std::lock_guard<std::mutex> lock(mMutex);
+        auto it = mByCommandBuffer.find(commandBuffer);
+        return it == mByCommandBuffer.end() ? std::shared_future<void>() : it->second;
+    }
+
+    void waitPool(uint64_t pool) {
+        std::shared_future<void> pending;
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            auto it = mByPool.find(pool);
+            if (it != mByPool.end()) pending = it->second;
+        }
+        if (pending.valid()) pending.wait();
+    }
+
+    void waitCommandBuffer(uint64_t commandBuffer) {
+        std::shared_future<void> pending = pendingCommandBuffer(commandBuffer);
+        if (pending.valid()) pending.wait();
+    }
+
+    // Queue operations of every queue of the process run on one thread in the
+    // order they were decoded: a submit may wait in the driver for a semaphore
+    // that an earlier submit to another queue signals, so no queue may
+    // overtake another.
+    SerialExecutor* submits() { return &mSubmits; }
+
+    // Waits for every queued operation and recording of the process started so
+    // far.
+    void drainAll() {
+        mSubmits.drain();
+        for (auto& worker : mWorkers) worker->drain();
+    }
+
+   private:
+    explicit ParallelRecorder(int threads) {
+        for (int i = 0; i < threads; ++i) mWorkers.push_back(std::make_unique<SerialExecutor>());
+    }
+
+    std::mutex mMutex;
+    std::vector<std::unique_ptr<SerialExecutor>> mWorkers;
+    size_t mNextWorker = 0;
+    std::unordered_map<uint64_t, std::shared_future<void>> mByPool;
+    std::unordered_map<uint64_t, std::shared_future<void>> mByCommandBuffer;
+    SerialExecutor mSubmits;
+};
+
+// Commands that may run while earlier command buffers are still being recorded
+// or submitted: they touch no command buffer or queue, or wait for exactly the
+// work they depend on.
+bool runsAlongsidePendingWork(uint32_t opcode) {
+    switch (opcode) {
+        case OP_vkQueueFlushCommandsGOOGLE:
+        case OP_vkQueueSubmitAsyncGOOGLE:
+        case OP_vkQueueSubmitAsync2GOOGLE:
+        case OP_vkQueueSignalReleaseImageANDROIDAsyncGOOGLE:
+        case OP_vkResetCommandPool:
+        case OP_vkResetFences:
+        case OP_vkGetFenceStatus:
+        case OP_vkWaitForFences:
+        case OP_vkUpdateDescriptorSets:
+        case OP_vkAllocateDescriptorSets:
+        case OP_vkFreeDescriptorSets:
+        case OP_vkQueueCommitDescriptorSetUpdatesGOOGLE:
+            return true;
+        default:
+            return false;
+    }
+}
