+    auto rgba = texture(12, 12, 1, 1, 6);
+    EXPECT_NE(copy(*rgba, src, {region(0, 0, 0, 0, 0, 1, 6, 0, 6, 12)}), nullptr);
+    EXPECT_NE(copy(*rgba, src, {region(0, 0, 0, 0, 0, 1, 0, 0, 6, 12)}), nullptr);
+}
+
+TEST_F(AstcTextureTest, Bc3BlocksDecodeToTheTexels) {
+    // A solid color, whose BC3 blocks decode to it within 5:6:5 quantization, including the
+    // 6x6 level's partial edge blocks and its alpha.
+    SolidDecompressor solid({200, 100, 50, 128});
+    auto tex = texture(6, 6, 1, 1, 6, &solid, VK_FORMAT_BC3_UNORM_BLOCK);
+    auto src = taggedBlocks(1);
+    auto staging = copy(*tex, src, {region(0, 0, 0, 0, 0, 1, 0, 0, 6, 6)});
+    ASSERT_NE(staging, nullptr);
+    ASSERT_EQ(staging->size, 4u * 16);
+    const std::vector<uint8_t> texels = decodeBc3(staged(staging).data(), 6, 6);
+    for (size_t t = 0; t < 36; ++t) {
+        EXPECT_NEAR(texels[t * 4], 200, 8) << t;
+        EXPECT_NEAR(texels[t * 4 + 1], 100, 8) << t;
+        EXPECT_NEAR(texels[t * 4 + 2], 50, 8) << t;
+        EXPECT_NEAR(texels[t * 4 + 3], 128, 2) << t;
+    }
+}
+
+// An image-to-image copy between two ASTC images the CPU decodes copies their output images
+// when the source's output is decoded, the output formats match and, for BC3 output, the region
+// is aligned to its 4x4 blocks in both images.
+TEST_F(AstcTextureTest, OutputImagesCopyWhenAlignedAndDecoded) {
+    auto image = [&](VkFormat format, uint32_t size, uint32_t mips) {
+        VkImageCreateInfo ci = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+            .imageType = VK_IMAGE_TYPE_2D,
+            .format = format,
+            .extent = {size, size, 1},
+            .mipLevels = mips,
+            .arrayLayers = 1,
+        };
+        auto info = std::make_unique<CompressedImageInfo>(
+            reinterpret_cast<VkDevice>(uintptr_t{0x1000}), ci, nullptr);
+        info->initAstcCpuDecompression(&mVk, reinterpret_cast<VkPhysicalDevice>(uintptr_t{0x2000}));
+        return info;
+    };
+    auto region = [](int32_t sx, int32_t sy, uint32_t sMip, int32_t dx, int32_t dy, uint32_t dMip,
+                     uint32_t w, uint32_t h) {
+        return VkImageCopy{{VK_IMAGE_ASPECT_COLOR_BIT, sMip, 0, 1},
+                           {sx, sy, 0},
+                           {VK_IMAGE_ASPECT_COLOR_BIT, dMip, 0, 1},
+                           {dx, dy, 0},
+                           {w, h, 1}};
+    };
+    // 6x6 ASTC in 24x24 images, 3 mip levels (24, 12, 6), with BC3 output as on a CPU-decoding
+    // device.
+    GpuDecompressionPipelineManager::setAstcDecoder(AstcDecoder::NewBc3);
+    auto src = image(VK_FORMAT_ASTC_6x6_UNORM_BLOCK, 24, 3);
+    auto dst = image(VK_FORMAT_ASTC_6x6_UNORM_BLOCK, 24, 3);
+    ASSERT_EQ(CompressedImageInfo::getOutputFormat(VK_FORMAT_ASTC_6x6_UNORM_BLOCK),
+              VK_FORMAT_BC3_UNORM_BLOCK);
+    EXPECT_TRUE(dst->canCopyOutputFrom(*src, region(0, 0, 0, 0, 0, 0, 24, 24)));
+    EXPECT_TRUE(dst->canCopyOutputFrom(*src, region(12, 0, 0, 12, 12, 0, 12, 12)));
+    EXPECT_TRUE(dst->canCopyOutputFrom(*src, region(0, 0, 2, 0, 0, 2, 6, 6)));  // 6x6: the edge
+    EXPECT_FALSE(dst->canCopyOutputFrom(*src, region(6, 0, 0, 0, 0, 0, 6, 24)));  // from x = 6
+    EXPECT_FALSE(dst->canCopyOutputFrom(*src, region(0, 0, 0, 6, 0, 0, 6, 24)));  // to x = 6
+    EXPECT_FALSE(dst->canCopyOutputFrom(*src, region(0, 0, 0, 0, 0, 0, 6, 24)));  // 6 wide inside
+    EXPECT_FALSE(dst->canCopyOutputFrom(*src, region(0, 0, 3, 0, 0, 0, 6, 6)));   // no such mip
+    // A source whose output is not decoded, or of another output format.
+    src->requireGpuAstcDecode("test");
+    EXPECT_FALSE(dst->canCopyOutputFrom(*src, region(0, 0, 0, 0, 0, 0, 24, 24)));
+    auto srgb = image(VK_FORMAT_ASTC_6x6_SRGB_BLOCK, 24, 3);
+    EXPECT_FALSE(dst->canCopyOutputFrom(*srgb, region(0, 0, 0, 0, 0, 0, 24, 24)));
+    // With RGBA8 output, any ASTC block-aligned region can be copied.
+    GpuDecompressionPipelineManager::setAstcDecoder(AstcDecoder::NewRgb);
+    auto src8 = image(VK_FORMAT_ASTC_6x6_UNORM_BLOCK, 24, 3);
+    auto dst8 = image(VK_FORMAT_ASTC_6x6_UNORM_BLOCK, 24, 3);
+    EXPECT_TRUE(dst8->canCopyOutputFrom(*src8, region(6, 0, 0, 6, 0, 0, 6, 24)));
+}
+
+TEST_F(AstcTextureTest, DecodesWithAstcEncoderIntoBc3) {
+    // The checkerboard of DecodesWithAstcEncoder: two colors per block, which BC3 holds exactly.
+    auto& decoder = AstcCpuDecompressor::get();
+    if (!decoder.available()) GTEST_SKIP() << "This CPU lacks the ISA astc-encoder is built for";
+    const uint8_t block[] = {0x44, 0x05, 0x00, 0xfe, 0x01, 0x00, 0x00, 0x00,
+                             0x55, 0xaa, 0x55, 0xaa, 0x55, 0xaa, 0x55, 0xaa};
+    std::vector<uint8_t> src;
+    for (int i = 0; i < 6; ++i) src.insert(src.end(), block, block + sizeof(block));
+    auto tex = texture(16, 16, 1, 1, 8, &decoder, VK_FORMAT_BC3_UNORM_BLOCK);
+    auto staging = copy(*tex, src, {region(0, 24, 0, 0, 0, 1, 0, 0, 16, 16)});
+    ASSERT_NE(staging, nullptr);
+    ASSERT_EQ(staging->size, 16u * 16);
+    const std::vector<uint8_t> texels = decodeBc3(staged(staging).data(), 16, 16);
+    for (uint32_t y = 0; y < 16; ++y) {
+        for (uint32_t x = 0; x < 16; ++x) {
+            const uint8_t expected = (x + y) % 2 ? 0 : 0xFF;
+            const uint8_t* t = &texels[(y * 16 + x) * 4];
+            ASSERT_EQ(t[0], expected) << x << "," << y;
+            ASSERT_EQ(t[1], expected) << x << "," << y;
+            ASSERT_EQ(t[2], expected) << x << "," << y;
+            ASSERT_EQ(t[3], 0xFF) << x << "," << y;
+        }
+    }
+}
