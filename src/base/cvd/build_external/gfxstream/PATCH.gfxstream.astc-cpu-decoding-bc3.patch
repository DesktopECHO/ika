+// Whether a copy region of a BC3 image is aligned to its 4x4 blocks: offsets are multiples of 4,
+// and so are the extents unless they reach the edge of the mip level.
+static bool isBc3Aligned(const VkOffset3D& offset, const VkExtent3D& extent,
+                         const VkExtent3D& mip) {
+    const uint32_t x = static_cast<uint32_t>(offset.x);
+    const uint32_t y = static_cast<uint32_t>(offset.y);
+    return offset.x >= 0 && offset.y >= 0 && x % 4 == 0 && y % 4 == 0 &&
+           (extent.width % 4 == 0 || x + extent.width == mip.width) &&
+           (extent.height % 4 == 0 || y + extent.height == mip.height);
+}
+
+bool CompressedImageInfo::canCopyOutputFrom(const CompressedImageInfo& src,
+                                            const VkImageCopy& region) const {
+    if (!src.isAstc() || !src.mAstcTexture || !mAstcTexture || src.mNeedsGpuAstcDecode ||
+        src.mOutputFormat != mOutputFormat || region.extent.depth != 1 ||
+        region.srcSubresource.mipLevel >= src.mMipLevels ||
+        region.dstSubresource.mipLevel >= mMipLevels) {
+        return false;
+    }
+    if (!isCompressedFormat(mOutputFormat)) return true;
+    return isBc3Aligned(region.srcOffset, region.extent,
+                        src.mipmapExtent(region.srcSubresource.mipLevel)) &&
+           isBc3Aligned(region.dstOffset, region.extent,
+                        mipmapExtent(region.dstSubresource.mipLevel));
+}
+
 void CompressedImageInfo::requireGpuAstcDecode(const char* reason) {
     if (mNeedsGpuAstcDecode) return;
+    if (!mGpuDecodeAvailable) {
+        GFXSTREAM_WARNING(
+            "ASTC image %p: %s; this host cannot decode its output image on the GPU either, so "
+            "that data stays undecoded.",
+            mOutputImage, reason);
+        // Remembered so that the warning is printed once per image.
+        mNeedsGpuAstcDecode = true;
+        return;
+    }
     mNeedsGpuAstcDecode = true;
     GFXSTREAM_WARNING("ASTC image %p: %s; decoding it on the GPU instead of the CPU.",
                       mOutputImage, reason);
