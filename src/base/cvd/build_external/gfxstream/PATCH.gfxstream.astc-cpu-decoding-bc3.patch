+// Whether the device can create the output image the GPU ASTC decoder writes when the CPU
+// decoder's output format is BC3: a BC3 image with storage usage and the flags that let the
+// decoder view it as R32G32B32A32_UINT, bound to memory, and that view. A format query is not
+// enough: Mesa's Dozen answers it from the most capable castable format, and D3D12 refuses the
+// unordered-access flag on a BC resource unless the driver supports relaxed format casting; an
+// Intel UHD 770 reports the image's memory requirements as an impossible size and the allocation
+// fails. This creates and destroys a 4x4 image.
+static bool probeAstcGpuDecodeOutputImage(VulkanDispatch* ivk, VulkanDispatch* dvk,
+                                          VkPhysicalDevice physicalDevice, VkDevice device) {
+    VkImageCreateInfo imageCi = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .imageType = VK_IMAGE_TYPE_2D,
+        .format = VK_FORMAT_BC3_UNORM_BLOCK,
+        .extent = {4, 4, 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                 VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    // The flags and usage an emulated ASTC image's output image is created with.
+    imageCi = CompressedImageInfo(device, imageCi, nullptr).getOutputCreateInfo(imageCi);
+
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+    bool ok = false;
+    const char* step = "vkCreateImage";
+    VkResult res = dvk->vkCreateImage(device, &imageCi, nullptr, &image);
+    if (res == VK_SUCCESS) {
+        VkMemoryRequirements memReqs = {};
+        dvk->vkGetImageMemoryRequirements(device, image, &memReqs);
+        std::optional<uint32_t> memIndex = vk_util::findMemoryType(
+            ivk, physicalDevice, memReqs.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (!memIndex) {
+            memIndex = vk_util::findMemoryType(ivk, physicalDevice, memReqs.memoryTypeBits, 0);
+        }
+        // A 4x4 image takes at most a few pages, or one 64 KiB D3D12 placement unit.
+        constexpr VkDeviceSize kPlausibleSize = 1u << 20;
+        step = "vkGetImageMemoryRequirements (an impossible size or no memory type)";
+        if (memReqs.size == 0 || memReqs.size > kPlausibleSize) {
+            res = VK_ERROR_FORMAT_NOT_SUPPORTED;
+        } else if (memIndex) {
+            VkMemoryAllocateInfo allocInfo = {
+                .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+                .allocationSize = memReqs.size,
+                .memoryTypeIndex = *memIndex,
+            };
+            step = "vkAllocateMemory";
+            res = dvk->vkAllocateMemory(device, &allocInfo, nullptr, &memory);
+        } else {
+            res = VK_ERROR_FORMAT_NOT_SUPPORTED;
+        }
+    }
+    if (res == VK_SUCCESS) {
+        step = "vkBindImageMemory";
+        res = dvk->vkBindImageMemory(device, image, memory, 0);
+    }
+    if (res == VK_SUCCESS) {
+        VkImageViewCreateInfo viewCi = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+            .image = image,
+            .viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY,
+            .format = VK_FORMAT_R32G32B32A32_UINT,
+            .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+        };
+        step = "vkCreateImageView (R32G32B32A32_UINT)";
+        res = dvk->vkCreateImageView(device, &viewCi, nullptr, &view);
+    }
+    ok = res == VK_SUCCESS;
+    if (!ok) {
+        GFXSTREAM_INFO("A BC3 image for the GPU ASTC decoder failed at %s: %s", step,
+                       string_VkResult(res));
+    }
+    if (view != VK_NULL_HANDLE) dvk->vkDestroyImageView(device, view, nullptr);
+    if (image != VK_NULL_HANDLE) dvk->vkDestroyImage(device, image, nullptr);
+    if (memory != VK_NULL_HANDLE) dvk->vkFreeMemory(device, memory, nullptr);
+    return ok;
+}
