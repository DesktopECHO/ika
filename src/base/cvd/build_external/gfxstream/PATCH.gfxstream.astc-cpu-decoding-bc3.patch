+// Writes the same RGBA value to every texel.
+class SolidDecompressor : public AstcCpuDecompressor {
+   public:
+    explicit SolidDecompressor(std::array<uint8_t, 4> rgba) : mRgba(rgba) {}
+    bool available() const override { return true; }
+    int32_t decompress(uint32_t width, uint32_t height, uint32_t, uint32_t, const uint8_t*,
+                       size_t, uint8_t* output) override {
+        for (size_t i = 0; i < size_t(width) * height; ++i) {
+            memcpy(output + i * 4, mRgba.data(), 4);
+        }
+        return 0;
+    }
+    const char* getStatusString(int32_t) const override { return ""; }
+
+   private:
+    std::array<uint8_t, 4> mRgba;
+};
+
+// Decodes one 16-byte BC3 block into 16 RGBA8 texels, row-major.
+void decodeBc3Block(const uint8_t* block, uint8_t* rgba) {
+    uint8_t alpha[8] = {block[0], block[1]};
+    if (alpha[0] > alpha[1]) {
+        for (int i = 1; i < 7; ++i) alpha[i + 1] = ((7 - i) * alpha[0] + i * alpha[1]) / 7;
+    } else {
+        for (int i = 1; i < 5; ++i) alpha[i + 1] = ((5 - i) * alpha[0] + i * alpha[1]) / 5;
+        alpha[6] = 0;
+        alpha[7] = 255;
+    }
+    uint64_t alphaBits = 0;
+    for (int i = 0; i < 6; ++i) alphaBits |= uint64_t(block[2 + i]) << (8 * i);
+    const uint16_t c0 = block[8] | (block[9] << 8);
+    const uint16_t c1 = block[10] | (block[11] << 8);
+    uint8_t color[4][3];
+    auto expand = [](uint16_t c, uint8_t* out) {
+        out[0] = ((c >> 11) & 31) * 255 / 31;
+        out[1] = ((c >> 5) & 63) * 255 / 63;
+        out[2] = (c & 31) * 255 / 31;
+    };
+    expand(c0, color[0]);
+    expand(c1, color[1]);
+    for (int k = 0; k < 3; ++k) {
+        if (c0 > c1) {
+            color[2][k] = (2 * color[0][k] + color[1][k]) / 3;
+            color[3][k] = (color[0][k] + 2 * color[1][k]) / 3;
+        } else {
+            color[2][k] = (color[0][k] + color[1][k]) / 2;
+            color[3][k] = 0;
+        }
+    }
+    const uint32_t colorBits = block[12] | (block[13] << 8) | (block[14] << 16) | (block[15] << 24);
+    for (int t = 0; t < 16; ++t) {
+        memcpy(rgba + t * 4, color[(colorBits >> (2 * t)) & 3], 3);
+        rgba[t * 4 + 3] = alpha[(alphaBits >> (3 * t)) & 7];
+    }
+}
+
+// Decodes tightly packed BC3 blocks of a width x height image into RGBA8 texels.
+std::vector<uint8_t> decodeBc3(const uint8_t* blocks, uint32_t width, uint32_t height) {
+    std::vector<uint8_t> texels(size_t(width) * height * 4);
+    const uint32_t blocksX = (width + 3) / 4;
+    for (uint32_t by = 0; by < (height + 3) / 4; ++by) {
+        for (uint32_t bx = 0; bx < blocksX; ++bx) {
+            uint8_t block[64];
+            decodeBc3Block(blocks + (size_t(by) * blocksX + bx) * 16, block);
+            for (uint32_t j = 0; j < 4 && by * 4 + j < height; ++j) {
+                for (uint32_t i = 0; i < 4 && bx * 4 + i < width; ++i) {
+                    memcpy(&texels[(size_t(by * 4 + j) * width + bx * 4 + i) * 4],
+                           block + (j * 4 + i) * 4, 4);
+                }
+            }
+        }
+    }
+    return texels;
+}
