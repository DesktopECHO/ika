+// Encodes the block rows [blockRowBegin, blockRowEnd) of width x height RGBA8 texels into BC3
+// blocks. The texels of a block past the right or bottom edge repeat the edge texels.
+void encodeBc3Rows(const uint8_t* rgba, uint32_t width, uint32_t height, uint32_t blocksX,
+                   uint32_t blockRowBegin, uint32_t blockRowEnd, uint8_t* out) {
+    uint8_t block[kBc3BlockSize * kBc3BlockSize * kDecodedTexelBytes];
+    for (uint32_t by = blockRowBegin; by < blockRowEnd; ++by) {
+        for (uint32_t bx = 0; bx < blocksX; ++bx) {
+            for (uint32_t j = 0; j < kBc3BlockSize; ++j) {
+                const uint32_t y = std::min(by * kBc3BlockSize + j, height - 1);
+                for (uint32_t i = 0; i < kBc3BlockSize; ++i) {
+                    const uint32_t x = std::min(bx * kBc3BlockSize + i, width - 1);
+                    memcpy(block + (j * kBc3BlockSize + i) * kDecodedTexelBytes,
+                           rgba + (static_cast<size_t>(y) * width + x) * kDecodedTexelBytes,
+                           kDecodedTexelBytes);
+                }
+            }
+            stb_compress_dxt_block(out + (static_cast<size_t>(by) * blocksX + bx) * kBc3BlockBytes,
+                                   block, /*alpha=*/1, STB_DXT_NORMAL);
+        }
+    }
+}
+
+// Encodes width x height RGBA8 texels into tightly packed BC3 blocks.
+void encodeBc3(const uint8_t* rgba, uint32_t width, uint32_t height, uint8_t* out) {
+    const uint32_t blocksX = static_cast<uint32_t>(ceilDiv(width, kBc3BlockSize));
+    const uint32_t blocksY = static_cast<uint32_t>(ceilDiv(height, kBc3BlockSize));
+    uint32_t threads = 1;
+    if (static_cast<uint64_t>(blocksX) * blocksY >= kBc3ThreadedBlocks) {
+        threads = std::min<uint32_t>({kBc3EncodeThreads, blocksY,
+                                      std::max<uint32_t>(std::thread::hardware_concurrency(), 1)});
+    }
+    if (threads <= 1) {
+        encodeBc3Rows(rgba, width, height, blocksX, 0, blocksY, out);
+        return;
+    }
+    std::vector<std::thread> workers;
+    workers.reserve(threads);
+    for (uint32_t t = 0; t < threads; ++t) {
+        const uint32_t begin = static_cast<uint32_t>(static_cast<uint64_t>(blocksY) * t / threads);
+        const uint32_t end =
+            static_cast<uint32_t>(static_cast<uint64_t>(blocksY) * (t + 1) / threads);
+        workers.emplace_back(encodeBc3Rows, rgba, width, height, blocksX, begin, end, out);
+    }
+    for (std::thread& worker : workers) worker.join();
+}
