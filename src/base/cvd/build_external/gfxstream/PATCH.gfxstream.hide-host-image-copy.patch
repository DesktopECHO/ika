Patch summary:
Keep VK_FORMAT_FEATURE_2_HOST_IMAGE_TRANSFER_BIT out of the format features
passed to the guest. Upstream hides VK_EXT_host_image_copy and the
hostImageCopy feature itself now, but its format-feature allow-list still
passes the bit, which no format may report while host image copy is hidden
(ANGLE's texture uploads through host image copy came out empty).
diff --git a/host/vulkan/vk_decoder_global_state.cpp b/host/vulkan/vk_decoder_global_state.cpp
index 6804234a8..3f802c109 100644
--- a/host/vulkan/vk_decoder_global_state.cpp
+++ b/host/vulkan/vk_decoder_global_state.cpp
@@ -10996,8 +10996,11 @@ class VkDecoderGlobalState::Impl {
         VK_FORMAT_FEATURE_2_FRAGMENT_DENSITY_MAP_BIT_EXT |
         VK_FORMAT_FEATURE_2_STORAGE_READ_WITHOUT_FORMAT_BIT |
         VK_FORMAT_FEATURE_2_STORAGE_WRITE_WITHOUT_FORMAT_BIT |
-        VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_DEPTH_COMPARISON_BIT |
-        VK_FORMAT_FEATURE_2_HOST_IMAGE_TRANSFER_BIT;
+        VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_DEPTH_COMPARISON_BIT;
+    // ika: no VK_FORMAT_FEATURE_2_HOST_IMAGE_TRANSFER_BIT. Host image copy is hidden from the
+    // guest (the decoder refuses vkCopyMemoryToImage/vkCopyImageToMemory, whose pHostPointer
+    // payload is not marshalled), so no format may report it either, even when
+    // BypassVulkanDeviceFeatureOverrides leaves the hostImageCopy feature on.
 
     void maskFormatPropertiesForUnsupportedExtensions(VkFormatProperties* pFormatProp) {
         pFormatProp->linearTilingFeatures &= kSupportedFormatFeatureFlags;
