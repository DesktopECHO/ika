+TEST_F(ExternalFencePoolTest, poolSkipsFenceOfLostDevice) {
+    VkFenceCreateInfo createInfo{
+        .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+        .pNext = 0,
+        .flags = 0,
+    };
+    VkFence fence = reinterpret_cast<VkFence>(0x1234'0000);
+    mPool.add(fence);
+    EXPECT_CALL(mMockDispatch, vkGetFenceStatus(_, fence))
+        .WillOnce(Return(VK_ERROR_DEVICE_LOST));
+    ASSERT_EQ(VK_NULL_HANDLE, mPool.pop(&createInfo));
