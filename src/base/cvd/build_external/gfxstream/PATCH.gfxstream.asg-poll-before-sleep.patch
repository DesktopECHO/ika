Patch summary:
A render thread that finds the guest's command ring empty polls it for a
while (200 us, GFXSTREAM_ASG_POLL_US) before sleeping until the guest pings
it, instead of 30 yields: the count of empty reads that was meant to allow
several rounds first was never reset. It also looks at the ring once more
after announcing that it needs a ping, so a command the guest wrote just
before it could see that is not left waiting.
diff --git a/host/ring_stream.cpp b/host/ring_stream.cpp
--- a/host/ring_stream.cpp
+++ b/host/ring_stream.cpp
@@ -16,6 +16,9 @@
 
 #include <assert.h>
 #include <memory.h>
+#include <stdlib.h>
+
+#include <chrono>
 
 #include "gfxstream/host/dma_device.h"
 #include "gfxstream/common/logging.h"
@@ -27,6 +30,27 @@
 namespace gfxstream {
 namespace {
 
+// How long a render thread keeps polling an empty ring before it sleeps until
+// the guest pings it. Waking a sleeping thread costs tens of microseconds,
+// more under nested virtualization (WSL2), and the guest waits on the ring
+// for every command that returns a value, so poll for a while first.
+// GFXSTREAM_ASG_POLL_US overrides it; 0 sleeps at once.
+uint64_t asgPollMicros() {
+    static const uint64_t micros = [] {
+        const char* value = getenv("GFXSTREAM_ASG_POLL_US");
+        if (value && *value) return static_cast<uint64_t>(strtoull(value, nullptr, 10));
+        return static_cast<uint64_t>(200);
+    }();
+    return micros;
+}
+
+uint64_t asgNowMicros() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+
 struct asg_context CreateContext(const AsgConsumerCreateInfo& info) {
     struct asg_context context = asg_context_create(info.ring_storage, info.buffer, info.buffer_size);
 
@@ -154,8 +178,8 @@
