+std::optional<uint32_t> VkEmulation::getColorBufferRowPitch(uint32_t colorBufferHandle) {
+    std::lock_guard<std::mutex> lock(mMutex);
+
+    auto info = gfxstream::base::find(mColorBuffers, colorBufferHandle);
+    if (!info || info->image == VK_NULL_HANDLE) {
+        return std::nullopt;
+    }
+    // Multi-planar formats have no single color plane layout.
+    if (IsYuvFormat(info->format)) {
+        return std::nullopt;
+    }
+
+    const VkImageSubresource subresource = {
+        .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+        .mipLevel = 0,
+        .arrayLayer = 0,
+    };
+    VkSubresourceLayout layout = {};
+    mDvk->vkGetImageSubresourceLayout(mDevice, info->image, &subresource, &layout);
+    if (layout.rowPitch == 0 || layout.rowPitch > UINT32_MAX) {
+        return std::nullopt;
+    }
+    return static_cast<uint32_t>(layout.rowPitch);
+}
