diff --git a/host/virtio_gpu_resource.cpp b/host/virtio_gpu_resource.cpp
index 4531a514..46be30de 100644
--- a/host/virtio_gpu_resource.cpp
+++ b/host/virtio_gpu_resource.cpp
@@ -444,6 +444,15 @@ int VirtioGpuResource::GetInfo(struct stream_renderer_resource_info* outInfo) co
 
     outInfo->drm_fourcc = formatInfo->drm_fourcc;
     outInfo->stride = AlignUp(mCreateArgs->width * formatInfo->bpp, 16U);
+    if (mResourceType == VirtioGpuResourceType::COLOR_BUFFER) {
+        // The VMM exports this resource's memory to its display as a dma-buf (scanout) and
+        // describes it with this stride, so report the pitch the Vulkan driver chose for
+        // the image rather than the packed one.
+        auto pitch = FrameBuffer::getFB()->getColorBufferVkRowPitch(mId);
+        if (pitch && *pitch >= mCreateArgs->width * formatInfo->bpp) {
+            outInfo->stride = *pitch;
+        }
+    }
     outInfo->virgl_format = mCreateArgs->format;
     outInfo->handle = mCreateArgs->handle;
     outInfo->height = mCreateArgs->height;
