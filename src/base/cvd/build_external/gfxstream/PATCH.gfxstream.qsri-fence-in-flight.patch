     VK_ANB_DEBUG("enter");
     std::lock_guard<std::mutex> lock(mMutex);
+    if (!mInFlightFences.empty()) {
+        reclaimInFlightFencesLocked();
+    }
     VkFence fence = VK_NULL_HANDLE;
     if (mAvailableFences.empty()) {
         VkFenceCreateInfo fenceCreateInfo = {
@@ -61,10 +76,7 @@ VkFence AndroidNativeBufferInfo::QsriWaitFencePool::getFenceFromPool() {
     } else {
         fence = mAvailableFences.back();
         mAvailableFences.pop_back();
-        VkResult res = mVk->vkResetFences(mDevice, 1, &fence);
-        if (res != VK_SUCCESS) {
-            GFXSTREAM_FATAL("Failed to reset QSRI VkFence: %s", string_VkResult(res));
-        }
+        VK_CHECK_GUEST_DEVICE(mVk->vkResetFences(mDevice, 1, &fence));
         VK_ANB_DEBUG("existing fence in pool: %p. also reset the fence", fence);
     }
     mUsedFences.emplace(fence);
@@ -83,16 +95,35 @@ AndroidNativeBufferInfo::QsriWaitFencePool::~QsriWaitFencePool() {
         VK_ANB_DEBUG("destroy fence %p", fence);
         mVk->vkDestroyFence(mDevice, fence, nullptr);
     }
+    // A fence the GPU never signaled is destroyed only if its work is over: done since, or
+    // never to finish on a lost device. Otherwise it is left to the device.
+    size_t leaked = 0;
+    for (auto fence : mInFlightFences) {
+        const VkResult status = mVk->vkGetFenceStatus(mDevice, fence);
+        if (status == VK_SUCCESS || status == VK_ERROR_DEVICE_LOST) {
+            mVk->vkDestroyFence(mDevice, fence, nullptr);
+        } else {
+            leaked++;
+        }
+    }
+    if (leaked) {
+        VK_ANB_ERR("%zu QSRI VkFences still pending when destroying the Qsri fence pool.",
+                   leaked);
+    }
     VK_ANB_DEBUG("exit");
 }
 
