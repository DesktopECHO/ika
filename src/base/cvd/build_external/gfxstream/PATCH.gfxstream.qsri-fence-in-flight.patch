 AndroidNativeBufferInfo::QsriWaitFencePool::QsriWaitFencePool(VulkanDispatch* vk, VkDevice device)
     : mVk(vk), mDevice(device) {}
 
+void AndroidNativeBufferInfo::QsriWaitFencePool::reclaimInFlightFencesLocked() {
+    size_t kept = 0;
+    for (VkFence fence : mInFlightFences) {
+        if (mVk->vkGetFenceStatus(mDevice, fence) == VK_SUCCESS) {
+            mAvailableFences.push_back(fence);
+        } else {
+            mInFlightFences[kept++] = fence;
+        }
+    }
+    mInFlightFences.resize(kept);
+}
+
