+            vk_struct_chain_filter<VkImageFormatListCreateInfo>(&imageCreateInfo);
             // The ColorBuffer's format: RGBA8 for a YUV format the device cannot create.
             imageCreateInfo.format = colorBufferVkImageCi->format;
             if (imageCreateInfo.flags & (~colorBufferVkImageCi->flags)) {
