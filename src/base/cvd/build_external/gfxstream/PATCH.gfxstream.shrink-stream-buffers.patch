Patch summary:
A render thread's buffers shrink back after a large command. The render
thread's ReadBuffer, a Vulkan decoder's reply buffer (VulkanStream's write
buffer) and its BumpPool grew to fit the largest command or reply and kept
that size for the life of the thread: one large texture upload kept tens of
megabytes per guest thread in SurfaceFlinger or a game. Each now checks,
every few hundred uses, whether what it held since was far smaller than its
size (a quarter or less), and if so shrinks to twice that, never below its
starting size.
DSA (desktop-subsystem-for-android) shrinks the same buffers in its patches
0027 and 0028 and in its aemu patch 0003.
diff --git a/common/base/include/gfxstream/BumpPool.h b/common/base/include/gfxstream/BumpPool.h
index 6eba9220..4f73ef38 100644
--- a/common/base/include/gfxstream/BumpPool.h
+++ b/common/base/include/gfxstream/BumpPool.h
@@ -17,8 +17,9 @@
 #include "gfxstream/AlignedBuf.h"
 #include "gfxstream/Allocator.h"
 
-#include <vector>
+#include <algorithm>
 #include <unordered_set>
+#include <vector>
 
 #include <inttypes.h>
 
@@ -32,7 +33,8 @@ namespace base {
 // malloc in the first pass while we find out how much data was needed.
 class BumpPool : public Allocator {
 public:
-    BumpPool(size_t startingBytes = 4096) : mStorage(startingBytes / sizeof(uint64_t))  { }
+    BumpPool(size_t startingBytes = 4096)
+        : mStartingBytes(startingBytes), mStorage(startingBytes / sizeof(uint64_t)) {}
     // All memory allocated by this pool
     // is automatically deleted when the pool
     // is deconstructed.
@@ -66,17 +68,37 @@ public:
 
     void freeAll() {
         mAllocPos = 0;
+        mLargestGenerationSinceCheck =
+            std::max(mLargestGenerationSinceCheck, mTotalWantedThisGeneration);
         if (mNeedRealloc) {
+            // The new storage holds nothing yet: allocate it rather than copy the old.
+            mStorage.resize(0);
             mStorage.resize((mTotalWantedThisGeneration * 2) / sizeof(uint64_t));
             mNeedRealloc = false;
             for (auto ptr : mFallbackPtrs) {
                 free(ptr);
             }
             mFallbackPtrs.clear();
+        } else if (++mGenerationsSinceCheck >= kShrinkCheckInterval) {
+            // One large command grows the storage for good. Shrink it back when the
+            // generations since needed far less.
+            const size_t target = std::max({mStartingBytes, kMinShrunkBytes,
+                                            2 * mLargestGenerationSinceCheck});
+            if (mStorage.size() * sizeof(uint64_t) >= 4 * target) {
+                mStorage.resize(0);
+                mStorage.resize(target / sizeof(uint64_t));
+            }
+            mGenerationsSinceCheck = 0;
+            mLargestGenerationSinceCheck = 0;
         }
         mTotalWantedThisGeneration = 0;
     }
 private:
+    static constexpr unsigned kShrinkCheckInterval = 1024;
+    static constexpr size_t kMinShrunkBytes = 4096;
+    size_t mStartingBytes;
+    size_t mLargestGenerationSinceCheck = 0;
+    unsigned mGenerationsSinceCheck = 0;
     AlignedBuf<uint64_t, 8> mStorage;
     std::unordered_set<void*> mFallbackPtrs;
     size_t mAllocPos = 0;
diff --git a/host/read_buffer.cpp b/host/read_buffer.cpp
index 441d6eb3..b541e9f1 100644
--- a/host/read_buffer.cpp
+++ b/host/read_buffer.cpp
@@ -27,6 +27,7 @@ namespace gfxstream {
 namespace host {
 
 ReadBuffer::ReadBuffer(size_t bufsize) {
+    m_initialSize = bufsize;
     m_size = bufsize;
     m_buf = (unsigned char*)malloc(m_size);
     m_validData = 0;
@@ -45,6 +46,8 @@ int ReadBuffer::getData(IOStream* stream, size_t minSize) {
     assert(stream);
     assert(minSize > m_validData);
 
+    m_largestRequestSinceCheck = std::max(m_largestRequestSinceCheck, minSize);
+
     const size_t minSizeToRead = minSize - m_validData;
     const size_t neededFreeTailThisTime =
         std::max(minSizeToRead,
@@ -110,6 +113,32 @@ void ReadBuffer::consume(size_t amount) {
     assert(amount <= m_validData);
     m_validData -= amount;
     m_readPtr += amount;
+    if (m_validData == 0) {
+        // Nothing left to keep: start again at the front, so the next packet needs no
+        // memmove, and see whether the buffer can shrink.
+        m_readPtr = m_buf;
+        maybeShrinkWhileEmpty();
+    }
+}
+
+void ReadBuffer::maybeShrinkWhileEmpty() {
+    if (++m_emptiedSinceCheck < kShrinkCheckInterval) {
+        return;
+    }
+    const size_t target = std::max(m_initialSize, 2 * m_largestRequestSinceCheck);
+    m_emptiedSinceCheck = 0;
+    m_largestRequestSinceCheck = 0;
+    if (m_size < 4 * target) {
+        return;
+    }
+    auto* smaller = static_cast<unsigned char*>(malloc(target));
+    if (!smaller) {
+        return;
+    }
+    free(m_buf);
+    m_buf = smaller;
+    m_readPtr = m_buf;
+    m_size = target;
 }
 
 void ReadBuffer::onSave(gfxstream::Stream* stream) {
diff --git a/host/read_buffer.h b/host/read_buffer.h
index 1534678b..9a06da75 100644
--- a/host/read_buffer.h
+++ b/host/read_buffer.h
@@ -41,6 +41,16 @@ private:
     size_t m_validData;
 
     size_t m_neededFreeTailSize = 0;
+
+    // A packet larger than the buffer grows it, and nothing used to shrink it again: one
+    // large texture upload kept a render thread's buffer at twice its size for as long as
+    // the thread lived. Every kShrinkCheckInterval times the buffer runs empty, it shrinks
+    // back if the largest packet since was far smaller than the buffer.
+    static constexpr unsigned kShrinkCheckInterval = 256;
+    void maybeShrinkWhileEmpty();
+    size_t m_initialSize = 0;
+    size_t m_largestRequestSinceCheck = 0;
+    unsigned m_emptiedSinceCheck = 0;
 };
 
 }  // namespace host
diff --git a/host/vulkan/vulkan_stream.cpp b/host/vulkan/vulkan_stream.cpp
index c1bf3e78..33bc9872 100644
--- a/host/vulkan/vulkan_stream.cpp
+++ b/host/vulkan/vulkan_stream.cpp
@@ -15,6 +15,8 @@
 
 #include <inttypes.h>
 
+#include <algorithm>
+
 #include <vector>
 
 #include "gfxstream/host/iostream.h"
@@ -153,7 +155,17 @@ void VulkanStream::commitWrite() {
     if (written) {
         GFXSTREAM_FATAL("Did not write exactly %zu bytes!", mWritePos);
     }
+    mLargestWriteSinceCheck = std::max(mLargestWriteSinceCheck, mWritePos);
     mWritePos = 0;
+
+    if (++mCommitsSinceCheck >= kWriteBufferShrinkInterval) {
+        const size_t target = std::max(kWriteBufferMinSize, 2 * mLargestWriteSinceCheck);
+        if (mWriteBuffer.size() >= 4 * target) {
+            std::vector<uint8_t>(target).swap(mWriteBuffer);
+        }
+        mCommitsSinceCheck = 0;
+        mLargestWriteSinceCheck = 0;
+    }
 }
 
 void VulkanStream::clearPool() { mPool.freeAll(); }
