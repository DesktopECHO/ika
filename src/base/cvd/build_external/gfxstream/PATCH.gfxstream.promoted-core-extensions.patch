Patch summary:
Offer the extensions Vulkan promoted to core only for a device that reports the
core version that promoted them, so a Vulkan 1.4 feature is never offered by a
device that reports less. This revision's codegen list passes all of them on;
the previous one left them out, and this patch passed on the command-free ones
under the same rule (3DMark Steel Nomad checks VK_KHR_spirv_1_4 and
VK_KHR_shader_float_controls by name).
diff --git a/host/vulkan/vk_decoder_global_state.cpp b/host/vulkan/vk_decoder_global_state.cpp
index e3a7c5c8b..1dde4d13e 100644
--- a/host/vulkan/vk_decoder_global_state.cpp
+++ b/host/vulkan/vk_decoder_global_state.cpp
@@ -165,6 +165,61 @@ static constexpr const char* const kEmulatedInstanceExtensions[] = {
     VK_KHR_EXTERNAL_SEMAPHORE_CAPABILITIES_EXTENSION_NAME,
 };
 
+// ika: extensions Vulkan promoted to core. The codegen list passes them all on now; each is
+// offered only when the device reports the core version that promoted it, so a Vulkan 1.4
+// feature is never offered by a device that reports less. (3DMark's Steel Nomad needs
+// VK_KHR_spirv_1_4 and VK_KHR_shader_float_controls, which every Vulkan 1.2 device has.)
+struct PromotedCoreExtension {
+    const char* name;
+    uint32_t version;  // the core version that promoted it
+};
+
+static constexpr PromotedCoreExtension kPromotedCoreExtensions[] = {
+    // Vulkan 1.1
+    {"VK_KHR_16bit_storage", VK_MAKE_VERSION(1, 1, 0)},
+    {"VK_KHR_device_group", VK_MAKE_VERSION(1, 1, 0)},
+    {"VK_KHR_relaxed_block_layout", VK_MAKE_VERSION(1, 1, 0)},
+    {"VK_KHR_shader_draw_parameters", VK_MAKE_VERSION(1, 1, 0)},
+    {"VK_KHR_variable_pointers", VK_MAKE_VERSION(1, 1, 0)},
+    // Vulkan 1.2
+    {"VK_KHR_8bit_storage", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_depth_stencil_resolve", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_draw_indirect_count", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_driver_properties", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_sampler_mirror_clamp_to_edge", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_separate_depth_stencil_layouts", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_shader_atomic_int64", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_shader_float_controls", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_spirv_1_4", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_timeline_semaphore", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_KHR_uniform_buffer_standard_layout", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_EXT_descriptor_indexing", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_EXT_host_query_reset", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_EXT_sampler_filter_minmax", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_EXT_separate_stencil_usage", VK_MAKE_VERSION(1, 2, 0)},
+    {"VK_EXT_shader_viewport_index_layer", VK_MAKE_VERSION(1, 2, 0)},
+    // Vulkan 1.4
+    {"VK_KHR_dynamic_rendering_local_read", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_KHR_index_type_uint8", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_KHR_load_store_op_none", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_KHR_map_memory2", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_KHR_push_descriptor", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_KHR_shader_expect_assume", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_KHR_shader_float_controls2", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_KHR_shader_subgroup_rotate", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_KHR_vertex_attribute_divisor", VK_MAKE_VERSION(1, 4, 0)},
+    {"VK_EXT_pipeline_robustness", VK_MAKE_VERSION(1, 4, 0)},
+};
+
+// Whether the extension is one of the promoted ones above and the device reports an older
+// version than the one that promoted it.
+static bool isPromotedAboveDeviceVersion(const char* name, uint32_t deviceApiVersion) {
+    for (const auto& promoted : kPromotedCoreExtensions) {
+        if (!strcmp(promoted.name, name)) return deviceApiVersion < promoted.version;
+    }
+    return false;
+}
+
 // Compressed-texture emulation expands one guest image into several host images. Sparse binds
 // describe only the guest-visible image, so sparse compressed images require the native path.
 static constexpr VkImageCreateFlags kSparseImageCreateFlags =
@@ -2429,6 +2484,15 @@ class VkDecoderGlobalState::Impl {
             return result;
         }
 
+        // The version the guest sees for this device, which gates the promoted extensions below:
+        uint32_t deviceApiVersion = VK_MAKE_VERSION(1, 0, 0);
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            if (auto* physicalDeviceInfo = gfxstream::base::find(mPhysdevInfo, physicalDevice)) {
+                deviceApiVersion = physicalDeviceInfo->props.apiVersion;
+            }
+        }
+
         // Remove all extensions that are not supported by the host codegen to prevent
         // guest to host compatibility issues:
         std::unordered_set<std::string> allowedDeviceExtensions =
@@ -2449,7 +2513,9 @@ class VkDecoderGlobalState::Impl {
             std::remove_if(properties.begin(), properties.end(),
                            [&](const VkExtensionProperties& extension) {
                                return allowedDeviceExtensions.find(extension.extensionName) ==
-                                      allowedDeviceExtensions.end();
+                                          allowedDeviceExtensions.end() ||
+                                      isPromotedAboveDeviceVersion(extension.extensionName,
+                                                                   deviceApiVersion);
                            }),
             properties.end());
 
