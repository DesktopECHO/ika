+        "ScanoutDmabufExport",
+        "If enabled, resource info describes color buffers (format, layout) so the VMM can "
+        "scan them out as dma-bufs; the info is only given for layouts the host display can "
+        "import (an explicit DRM modifier, or a driver that leaves the layout in the buffer).",
+        &map,
+    };
     BoolFeatureInfo VulkanEnsureCachedCoherentMemoryAvailable = {
         "VulkanEnsureCachedCoherentMemoryAvailable",
         "If enabled, ensures that the at least one memory type that is both cached and coherent is "
