@@ -139,6 +139,10 @@ ParseGfxstreamFeatures(const int rendererFlags,
     GFXSTREAM_SET_BOOL_FEATURE_ON_CONDITION(&features, ExternalBlob,
                                        rendererFlags & STREAM_RENDERER_FLAGS_USE_EXTERNAL_BLOB ||
                                            features.VulkanAllocateHostVisibleAsUdmabuf.enabled());
+    // On by default: the resource info is only given for color buffers whose layout the VMM's
+    // display can import (VirtioGpuFrontend::getResourceInfo), so the feature itself needs no
+    // host-specific default; an explicit override is honored as given.
+    GFXSTREAM_SET_BOOL_FEATURE_ON_CONDITION(&features, ScanoutDmabufExport, true);
     GFXSTREAM_SET_BOOL_FEATURE_ON_CONDITION(&features, VulkanEnsureCachedCoherentMemoryAvailable, true);
 
     for (const std::string& rendererFeature : gfxstream::Split(rendererFeatures, ",;")) {
