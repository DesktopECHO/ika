                                 &dev->base.handle.device);
+   /* A driver may refuse a raised queue priority to an unprivileged process
+    * (Honeykrisp does), and clients such as ANGLE, asked for a high-priority
+    * context by SurfaceFlinger, do not retry. Give them medium priority
+    * rather than no device.
+    */
+   if (args->ret == VK_ERROR_NOT_PERMITTED_EXT &&
+       vkr_device_lower_queue_global_priorities(args->pCreateInfo)) {
+      vkr_log("queue global priority not permitted; using medium priority");
+      args->ret = vk->CreateDevice(args->physicalDevice, args->pCreateInfo, NULL,
+                                   &dev->base.handle.device);
+   }
