+/* Lower every requested queue global priority above medium to medium.
+ * Returns whether any was lowered.
+ */
+static bool
+vkr_device_lower_queue_global_priorities(const VkDeviceCreateInfo *create_info)
+{
+   bool lowered = false;
+   for (uint32_t i = 0; i < create_info->queueCreateInfoCount; i++) {
+      for (VkBaseOutStructure *s =
+              (VkBaseOutStructure *)create_info->pQueueCreateInfos[i].pNext;
+           s; s = s->pNext) {
+         if (s->sType != VK_STRUCTURE_TYPE_DEVICE_QUEUE_GLOBAL_PRIORITY_CREATE_INFO_EXT)
+            continue;
+         VkDeviceQueueGlobalPriorityCreateInfoEXT *priority = (void *)s;
+         if (priority->globalPriority > VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_EXT) {
+            priority->globalPriority = VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_EXT;
+            lowered = true;
+         }
+      }
+   }
+   return lowered;
+}
