+/* Whether the driver learns that work on a queue has finished only once all
+ * the work it has given the GPU on that queue has finished. Asahi's kernel
+ * driver does: the firmware signals a queue's completions when the number of
+ * jobs it has processed reaches the number handed to it (the notifier
+ * threshold in drivers/gpu/drm/asahi/queue/mod.rs), so with Honeykrisp a fence
+ * signals no earlier than the work submitted behind it while it ran.
+ */
+static bool
+vkr_physical_device_queue_reports_when_drained(struct vkr_physical_device *physical_dev)
+{
+   struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+
+   VkPhysicalDeviceDriverProperties driver_props = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES,
+   };
+   VkPhysicalDeviceProperties2 props2 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+      .pNext = &driver_props,
+   };
+   vk->GetPhysicalDeviceProperties2(physical_dev->base.handle.physical_device, &props2);
+   return driver_props.driverID == VK_DRIVER_ID_MESA_HONEYKRISP;
+}
