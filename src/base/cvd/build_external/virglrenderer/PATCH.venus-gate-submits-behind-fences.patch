+/* Makes the first of the submits with command buffers wait for a pending gate.
+ * Returns the arrays it gave that submit, to free after vkQueueSubmit, or NULL
+ * when no submit waits for the gate. The caller holds vk_mutex.
+ */
+static void *
+vkr_queue_gate_submits(struct vkr_queue *queue, uint32_t count, VkSubmitInfo *submits)
+{
+   if (!queue->gate_pending)
+      return NULL;
+
+   for (uint32_t i = 0; i < count; i++) {
+      VkSubmitInfo *info = &submits[i];
+      if (!info->commandBufferCount)
+         continue;
+
+      /* the wait semaphores, their timeline values, stages and device indices */
+      const uint32_t n = info->waitSemaphoreCount;
+      void *arrays = calloc(n + 1, sizeof(VkSemaphore) + sizeof(uint64_t) +
+                                      sizeof(VkPipelineStageFlags) + sizeof(uint32_t));
+      if (!arrays)
+         return NULL;
+      VkSemaphore *semaphores = arrays;
+      uint64_t *values = (uint64_t *)(semaphores + n + 1);
+      VkPipelineStageFlags *stages = (VkPipelineStageFlags *)(values + n + 1);
+      uint32_t *device_indices = (uint32_t *)(stages + n + 1);
+
+      if (n) {
+         memcpy(semaphores, info->pWaitSemaphores, sizeof(*semaphores) * n);
+         memcpy(stages, info->pWaitDstStageMask, sizeof(*stages) * n);
+      }
+      semaphores[n] = queue->gate;
+      stages[n] = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+      info->pWaitSemaphores = semaphores;
+      info->pWaitDstStageMask = stages;
+      info->waitSemaphoreCount = n + 1;
+
+      /* these count the wait semaphores too, when they are not empty */
+      for (VkBaseOutStructure *s = (VkBaseOutStructure *)info->pNext; s; s = s->pNext) {
+         if (s->sType == VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO) {
+            VkTimelineSemaphoreSubmitInfo *timeline = (void *)s;
+            const uint32_t value_count = MIN2(timeline->waitSemaphoreValueCount, n);
+            if (value_count) {
+               memcpy(values, timeline->pWaitSemaphoreValues,
+                      sizeof(*values) * value_count);
+            }
+            timeline->pWaitSemaphoreValues = values;
+            timeline->waitSemaphoreValueCount = n + 1;
+         } else if (s->sType == VK_STRUCTURE_TYPE_DEVICE_GROUP_SUBMIT_INFO) {
+            VkDeviceGroupSubmitInfo *group = (void *)s;
+            const uint32_t index_count = MIN2(group->waitSemaphoreCount, n);
+            if (index_count) {
+               memcpy(device_indices, group->pWaitSemaphoreDeviceIndices,
+                      sizeof(*device_indices) * index_count);
+            }
+            group->pWaitSemaphoreDeviceIndices = device_indices;
+            group->waitSemaphoreCount = n + 1;
+         }
+      }
+
+      queue->gate_pending = false;
+      return arrays;
+   }
+
+   return NULL;
+}
+
+/* vkr_queue_gate_submits for vkQueueSubmit2. */
+static void *
+vkr_queue_gate_submits2(struct vkr_queue *queue, uint32_t count, VkSubmitInfo2 *submits)
+{
+   if (!queue->gate_pending)
+      return NULL;
+
+   for (uint32_t i = 0; i < count; i++) {
+      VkSubmitInfo2 *info = &submits[i];
+      if (!info->commandBufferInfoCount)
+         continue;
+
+      const uint32_t n = info->waitSemaphoreInfoCount;
+      VkSemaphoreSubmitInfo *semaphores = calloc(n + 1, sizeof(*semaphores));
+      if (!semaphores)
+         return NULL;
+      if (n)
+         memcpy(semaphores, info->pWaitSemaphoreInfos, sizeof(*semaphores) * n);
+      semaphores[n] = (VkSemaphoreSubmitInfo){
+         .sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO,
+         .semaphore = queue->gate,
+         .stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+      };
+      info->pWaitSemaphoreInfos = semaphores;
+      info->waitSemaphoreInfoCount = n + 1;
+
+      queue->gate_pending = false;
+      return semaphores;
+   }
+
+   return NULL;
+}
