diff --git a/src/venus/vkr_device.c b/src/venus/vkr_device.c
index 25471e7..48b289d 100644
--- a/src/venus/vkr_device.c
+++ b/src/venus/vkr_device.c
@@ -339,9 +339,20 @@ vkr_device_object_destroy(struct vkr_context *ctx,
 
    /* always cleanup vkr allocs */
    switch (obj->type) {
-   case VK_OBJECT_TYPE_DEVICE_MEMORY:
-      vkr_device_memory_release((struct vkr_device_memory *)obj);
+   case VK_OBJECT_TYPE_DEVICE_MEMORY: {
+      /* the resource the VMM maps the memory through outlives it here */
+      struct vkr_device_memory *mem = (struct vkr_device_memory *)obj;
+      if (mem->map_res_id) {
+         mtx_lock(&ctx->resource_mutex);
+         struct hash_entry *entry =
+            _mesa_hash_table_search(ctx->resource_table, &mem->map_res_id);
+         if (entry && ((struct vkr_resource *)entry->data)->map_mem == mem)
+            ((struct vkr_resource *)entry->data)->map_mem = NULL;
+         mtx_unlock(&ctx->resource_mutex);
+      }
+      vkr_device_memory_release(mem);
       break;
+   }
    case VK_OBJECT_TYPE_DESCRIPTOR_POOL:
       /* Destroying VkDescriptorPool frees all VkDescriptorSet allocated inside. */
       vkr_descriptor_pool_release(ctx, (struct vkr_descriptor_pool *)obj);
diff --git a/src/venus/vkr_device_memory.c b/src/venus/vkr_device_memory.c
index f78df76..8bd48da 100644
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -447,10 +447,41 @@ vkr_dispatch_vkFreeMemory(struct vn_dispatch_context *dispatch,
    if (!mem)
       return;
 
+   /* Memory the VMM maps by pointer is freed with its resource, after the VMM
+    * unmapped it: the guest frees memory and unmaps its blob in either order,
+    * and a range the VMM still maps could otherwise be reused.
+    */
+   struct vkr_context *ctx = dispatch->data;
+   bool deferred = false;
+   mtx_lock(&ctx->resource_mutex);
+   if (mem->map_res_id) {
+      const struct hash_entry *entry =
+         _mesa_hash_table_search(ctx->resource_table, &mem->map_res_id);
+      const struct vkr_resource *res = entry ? entry->data : NULL;
+      if (res && res->map_mem == mem) {
+         mem->freed_by_guest = true;
+         deferred = true;
+      }
+   }
+   mtx_unlock(&ctx->resource_mutex);
+   if (deferred)
+      return;
+
    vkr_device_memory_release(mem);
    vkr_device_memory_destroy_and_remove(dispatch->data, args);
 }
 
+void
+vkr_device_memory_free_deferred(struct vkr_context *ctx, struct vkr_device_memory *mem)
+{
+   struct vkr_device *dev = mem->device;
+
+   vkr_device_memory_release(mem);
+   dev->proc_table.FreeMemory(dev->base.handle.device, mem->base.handle.device_memory,
+                              NULL);
+   vkr_device_remove_object(ctx, dev, &mem->base);
+}
