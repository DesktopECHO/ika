+/// On an Apple CPU, switches this thread, and the threads it creates afterwards, to the TSO memory
+/// model with Asahi Linux's PR_SET_MEM_MODEL. KVM gives a vCPU the ACTLR_EL1 of the thread that
+/// initializes or resets it: this one when the vCPUs are created, and the vCPU's own thread, which
+/// inherits the model, when the guest turns a vCPU on. So the guest runs with TSO whatever its
+/// kernel, and code that relies on x86-like memory ordering works there: without it, 3DMark's
+/// Sling Shot Extreme livelocks or crashes in its lock-free task queue.
+#[cfg(target_arch = "aarch64")]
+fn enable_apple_tso() -> Result<()> {
+    const MIDR_EL1: &str = "/sys/devices/system/cpu/cpu0/regs/identification/midr_el1";
+    const MIDR_IMPLEMENTER_APPLE: u64 = 0x61;
+    const PR_SET_MEM_MODEL: libc::c_int = 0x4d4d_444c;
+    const PR_SET_MEM_MODEL_TSO: libc::c_ulong = 1;
+
+    let midr =
+        std::fs::read_to_string(MIDR_EL1).with_context(|| format!("failed to read {MIDR_EL1}"))?;
+    let midr = u64::from_str_radix(midr.trim().trim_start_matches("0x"), 16)
+        .with_context(|| format!("failed to parse {MIDR_EL1}: {midr:?}"))?;
+    if (midr >> 24) & 0xff != MIDR_IMPLEMENTER_APPLE {
+        return Ok(());
+    }
+    // SAFETY: prctl with integer arguments only; it changes this thread's memory model.
+    let ret = unsafe { libc::prctl(PR_SET_MEM_MODEL, PR_SET_MEM_MODEL_TSO, 0, 0, 0) };
+    if ret != 0 {
+        return Err(std::io::Error::last_os_error())
+            .context("failed to switch to the TSO memory model of Apple CPUs (PR_SET_MEM_MODEL)");
+    }
+    info!("Apple CPU: the vCPUs run with the TSO memory model");
+    Ok(())
+}
+
 fn run_kvm(
     device_path: Option<&Path>,
     #[cfg_attr(not(target_arch = "x86_64"), allow(unused_mut))] mut cfg: Config,
@@ -1854,6 +1884,10 @@ fn run_kvm(
     use hypervisor::kvm::Kvm;
     use hypervisor::kvm::KvmVm;
 
+    // Before any vCPU exists, so that each one gets the memory model.
+    #[cfg(target_arch = "aarch64")]
+    enable_apple_tso()?;
+
     let device_path = device_path.unwrap_or(Path::new(KVM_PATH));
     let kvm = Kvm::new_with_path(device_path)
         .with_context(|| format!("failed to open KVM device {}", device_path.display()))?;
