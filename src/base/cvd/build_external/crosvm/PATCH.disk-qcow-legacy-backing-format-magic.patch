+    #[test]
+    fn test_legacy_backing_format_extension_opens() {
+        let temp_dir = TempDir::new().expect("failed to create temp dir");
+        let backing_path = temp_dir.path().join("backing.raw");
+        let overlay_path = temp_dir.path().join("overlay.qcow2");
+
+        // A backing file that would be probed as qcow2: it must be opened as the raw image the
+        // overlay names.
+        let mut backing_file = File::create(&backing_path).unwrap();
+        backing_file.write_all(&QCOW_MAGIC.to_be_bytes()).unwrap();
+        backing_file.set_len(1024 * 1024).unwrap();
+        drop(backing_file);
+
+        // An overlay as earlier crosvm wrote it: the backing format extension under its old
+        // type.
+        let header = QcowHeader::create_for_size_and_path(
+            1024 * 1024 * 10,
+            Some((backing_path.to_str().unwrap(), crate::ImageType::Raw)),
+        )
+        .expect("Failed to create header.");
+        let mut overlay_file = File::create(&overlay_path).unwrap();
+        header.write_to(&mut overlay_file).unwrap();
+        overlay_file
+            .seek(SeekFrom::Start(V3_BARE_HEADER_SIZE as u64))
+            .unwrap();
+        overlay_file
+            .write_all(&QCOW2_EXT_MAGIC_BACKING_FORMAT_CROSVM_LEGACY.to_be_bytes())
+            .unwrap();
+        drop(overlay_file);
+
+        let overlay_file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(&overlay_path)
+            .unwrap();
+        let mut params = test_params();
+        params.path = overlay_path.clone();
+        let qcow = QcowFile::from(overlay_file, params);
+        assert!(
+            qcow.is_ok(),
+            "Failed to open an overlay with the legacy backing format type: {:?}",
+            qcow.err()
+        );
+    }
