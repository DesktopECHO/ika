+// ika: copies between a buffer and the guest pages backing a resource, from
+// `offset` in the guest's layout.
+fn copy_to_iovecs(iovecs: &[RutabagaIovec], mut offset: usize, mut data: &[u8]) {
+    for iovec in iovecs {
+        if data.is_empty() {
+            break;
+        }
+        if offset >= iovec.len {
+            offset -= iovec.len;
+            continue;
+        }
+        let n = (iovec.len - offset).min(data.len());
+        // SAFETY: the iovecs are the guest memory crosvm checked and attached
+        // to the resource, and n stays within this one.
+        unsafe {
+            std::ptr::copy_nonoverlapping(data.as_ptr(), (iovec.base as *mut u8).add(offset), n)
+        };
+        data = &data[n..];
+        offset = 0;
+    }
+}
+
+fn copy_from_iovecs(iovecs: &[RutabagaIovec], mut offset: usize, mut out: &mut [u8]) {
+    for iovec in iovecs {
+        if out.is_empty() {
+            break;
+        }
+        if offset >= iovec.len {
+            offset -= iovec.len;
+            continue;
+        }
+        let n = (iovec.len - offset).min(out.len());
+        // SAFETY: as in copy_to_iovecs.
+        unsafe {
+            std::ptr::copy_nonoverlapping((iovec.base as *const u8).add(offset), out.as_mut_ptr(), n)
+        };
+        out = &mut out[n..];
+        offset = 0;
+    }
+}
