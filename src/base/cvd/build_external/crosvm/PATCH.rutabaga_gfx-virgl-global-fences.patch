     }
 
     fn create_fence(&mut self, fence: RutabagaFence) -> RutabagaResult<()> {
+        // ika: virglrenderer keeps the global timeline in its OpenGL renderer.
+        // Without it, the commands before the fence have all been carried out
+        // by the time the fence is created, so it is signaled at once.
+        if !self.virgl {
+            self.fence_handler.call(RutabagaFence {
+                flags: RUTABAGA_FLAG_FENCE,
+                fence_id: fence.fence_id,
+                ctx_id: 0,
+                ring_idx: 0,
+            });
+            return Ok(());
+        }
+
         // TODO(b/315870313): Add safety comment
         #[allow(clippy::undocumented_unsafe_blocks)]
         let ret = unsafe { virgl_renderer_create_fence(fence.fence_id as i32, fence.ctx_id) };
