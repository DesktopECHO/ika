+// gfxstream uses for the same buffers (PATCH.gfxstream.yuv-rgba-fallback.patch),
+// so both GPU modes show a video in the same colors. YVU420 (YV12) has its V
+// plane before its U plane; NV12 interleaves U then V.
+#[allow(clippy::too_many_arguments)]
+fn convert_yuv420_to_rgba(
+    format: DrmFormat,
+    layout: &ImageMemoryRequirements,
+    src: &[u8],
+    dst: &mut [u8],
+    stride: usize,
+    (x0, x1): (usize, usize),
+    (y0, y1): (usize, usize),
