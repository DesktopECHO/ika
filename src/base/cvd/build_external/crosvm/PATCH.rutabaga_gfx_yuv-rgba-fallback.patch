+    let nv12 = format.to_bytes() == DRM_FORMAT_NV12;
+    if src.len() < layout.size as usize {
+        return Err(MagmaGpuError::WithContext("YUV buffer smaller than its layout").into());
+    }
+    let y_plane = &src[layout.offsets[0] as usize..];
+    let y_stride = layout.strides[0] as usize;
+    let (u_plane, v_plane, chroma_stride, chroma_step) = if nv12 {
+        let uv = &src[layout.offsets[1] as usize..];
