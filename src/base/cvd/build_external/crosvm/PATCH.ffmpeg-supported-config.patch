diff --git a/build.rs b/build.rs
index 0af6387..f3877a3 100644
--- a/build.rs
+++ b/build.rs
@@ -36,6 +36,13 @@ fn main() {
         .probe("libswscale")
         .unwrap();
 
+    // FFmpeg 7.1 (libavcodec 61.13.100) added avcodec_get_supported_config()
+    // and FFmpeg 9 (libavcodec 63) removed the AVCodec.pix_fmts field it
+    // replaces, so pick the API from the libavcodec version being built against.
+    if version_at_least(&avcodec.version, &[61, 13, 100]) {
+        println!("cargo:rustc-cfg=ffmpeg_codec_supported_config");
+    }
+
     // pkg-config may select a private prefix containing a pinned static
     // FFmpeg build. Forward its include directories to bindgen instead of
     // assuming that headers are installed in a distro-specific system path.
@@ -66,3 +73,17 @@ fn main() {
         .write_to_file(out_path.join("bindings.rs"))
         .expect("writing bindings to file failed");
 }
+
+fn version_at_least(version: &str, minimum: &[u32]) -> bool {
+    let parts: Vec<u32> = version
+        .split('.')
+        .map(|part| part.parse().unwrap_or(0))
+        .collect();
+    for (index, &required) in minimum.iter().enumerate() {
+        let actual = parts.get(index).copied().unwrap_or(0);
+        if actual != required {
+            return actual > required;
+        }
+    }
+    true
+}
