+// ika: The offset in the guest memory shm, at or after `offset`, whose position within a host
+// huge page (a PMD: 2 MiB with 4 KiB pages, 32 MiB with 16 KiB pages) is that of `guest_base`.
+// The kernel maps a large shm mapping at an address with the same position within a huge page as
+// its offset, and KVM maps guest memory with huge pages only where the guest address and the host
+// address have the same position. Laid out back to back, the regions after the 1 MiB BIOS
+// region (x86's RAM above 4 GiB) sat 1 MiB off, and KVM mapped all of that memory in 4 KiB pages.
+// The gaps this leaves in the shm are never touched and take no memory.
+fn huge_page_congruent_offset(offset: u64, guest_base: GuestAddress) -> u64 {
+    let page = pagesize() as u64;
+    let huge_page = page * (page / 8);
+    let want = guest_base.offset() % huge_page;
+    let have = offset % huge_page;
+    offset + (want + huge_page - have) % huge_page
 }
 
