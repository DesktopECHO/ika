+    // valid_header uses cluster_bits = 16.
+    const TEST_CLUSTER_SIZE: usize = 0x10000;
+
+    // Returns a qcow file over a backing qcow file holding 0x55 in `len` bytes at `offset`.
+    fn backed_overlay(offset: u64, len: usize) -> QcowFile {
+        let mut backing = QcowFile::from(basic_file(&valid_header()), test_params()).unwrap();
+        write_all_at(&mut backing, &vec![0x55u8; len], offset).expect("Failed to write backing.");
+        let mut overlay = QcowFile::from(basic_file(&valid_header()), test_params()).unwrap();
+        overlay.set_backing_file(Some(Box::new(backing)));
+        overlay
+    }
+
+    // Syncs `qcow` and returns the number of clusters in use in its file: new clusters are either
+    // taken from the free ones or added at the end.
+    fn used_clusters(qcow: &mut QcowFile) -> u64 {
+        qcow.fsync().unwrap();
+        let inner = qcow.inner.lock();
+        let file_size = inner.raw_file.file().metadata().unwrap().len();
+        file_size.div_ceil(TEST_CLUSTER_SIZE as u64) - inner.avail_clusters.len() as u64
+    }
+
+    fn assert_zeroes(qcow: &mut QcowFile, offset: u64, len: usize) {
+        let mut buf = vec![0xffu8; len];
+        read_exact_at(qcow, &mut buf, offset).expect("Failed to read.");
+        assert!(buf.iter().all(|b| *b == 0), "range is not zeroed");
+    }
+
+    #[cfg_attr(windows, ignore = "TODO(b/257958782): Enable large test on windows")]
+    #[test]
+    fn punch_hole_backing_uses_zero_clusters() {
+        const LEN: usize = TEST_CLUSTER_SIZE * 64;
+        let offset = 0x1000_0000;
+        let mut overlay = backed_overlay(offset, LEN);
+        let used_before = used_clusters(&mut overlay);
+
+        overlay
+            .punch_hole(offset, LEN as u64)
+            .expect("Failed to punch hole.");
+        assert_zeroes(&mut overlay, offset, LEN);
+
+        // At most a new L2 table, not a data cluster per zeroed cluster.
+        let allocated = used_clusters(&mut overlay) - used_before;
+        assert!(allocated <= 2, "{allocated} clusters allocated");
+    }
+
+    #[cfg_attr(windows, ignore = "TODO(b/257958782): Enable large test on windows")]
+    #[test]
+    fn punch_hole_backing_frees_allocated_clusters() {
+        const LEN: usize = TEST_CLUSTER_SIZE * 16;
+        let mut overlay = backed_overlay(0, LEN);
+        write_all_at(&mut overlay, &[0xaau8; LEN], 0).expect("Failed to write overlay.");
+        let used_before = used_clusters(&mut overlay);
+
+        overlay.punch_hole(0, LEN as u64).expect("Failed to punch hole.");
+        assert_zeroes(&mut overlay, 0, LEN);
+
+        let used_after = used_clusters(&mut overlay);
+        assert!(
+            used_after + (LEN / TEST_CLUSTER_SIZE) as u64 <= used_before,
+            "{used_before} clusters in use before, {used_after} after"
+        );
+    }
