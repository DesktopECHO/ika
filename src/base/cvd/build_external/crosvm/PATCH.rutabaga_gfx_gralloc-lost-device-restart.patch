+// ika: crosvm's own Vulkan device is lost (a GPU reset; under WSL2 a removed
+// D3D12 device). Android's buffers and the display's readbacks go through it,
+// so neither works again in this process. Exit with the code crosvm uses for
+// a guest reboot, so that the VM manager restarts the VM, as gfxstream does
+// when its own device is lost.
+fn exit_for_lost_device(what: &str) -> ! {
+    log::error!(
+        "crosvm's Vulkan device was lost ({}); exiting with code 32 so that the VM restarts",
+        what
+    );
+    // SAFETY: _exit ends the process at once, as gfxstream's does.
+    unsafe { libc::_exit(32) }
+}
+
+// ika: whether `device` is lost, asked with vkDeviceWaitIdle, which reports
+// a lost device (Dozen reports a removed D3D12 device). vulkano's wait_idle
+// panics on that error.
+fn device_is_lost(device: &Device) -> bool {
+    // SAFETY: the device is valid, and crosvm's GPU thread is the only one
+    // that records work on it.
+    let result = unsafe { (device.fns().v1_0.device_wait_idle)(device.handle()) };
+    matches!(result.result().map_err(VulkanError::from), Err(VulkanError::DeviceLost))
+}
+
 // ika: an optimal image some other device rendered into, imported for
 // copies to the CPU. Its layout is GENERAL whenever it changes hands, which
 // Dozen gives the D3D12 state COMMON that resources shared between devices
@@ -1051,6 +1082,14 @@ impl Gralloc for VulkanoGralloc {
         Ok(())
     }
 
+    fn exit_if_device_lost(&self, what: &str) {
+        for device in self.devices.values() {
+            if device_is_lost(device) {
+                exit_for_lost_device(what);
+            }
+        }
+    }
+
     fn forget_image(&mut self, id: u32) {
         self.readbacks.remove(&id);
     }
