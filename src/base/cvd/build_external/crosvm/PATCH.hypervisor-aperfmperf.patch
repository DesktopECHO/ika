+    /// Let the guest read IA32_APERF and IA32_MPERF without exiting, so it can compute the
+    /// effective frequency of its vCPUs. Must be called before any vCPU is created.
+    ///
+    /// Returns false if the host kernel does not support it.
+    pub fn enable_aperfmperf_passthrough(&self) -> Result<bool> {
+        // Not in the kvm_sys bindings yet (Linux 6.17+).
+        const KVM_X86_DISABLE_EXITS_APERFMPERF: u64 = 1 << 4;
+
+        // SAFETY:
+        // Safe because we know that our file is a VM fd and KVM_CHECK_EXTENSION takes no pointer.
+        let supported =
+            unsafe { ioctl_with_val(self, KVM_CHECK_EXTENSION, KVM_CAP_X86_DISABLE_EXITS as u64) };
+        if supported < 0 || (supported as u64) & KVM_X86_DISABLE_EXITS_APERFMPERF == 0 {
+            return Ok(false);
+        }
+
+        let mut cap = kvm_enable_cap {
+            cap: KVM_CAP_X86_DISABLE_EXITS,
+            ..Default::default()
+        };
+        cap.args[0] = KVM_X86_DISABLE_EXITS_APERFMPERF;
+
+        // SAFETY:
+        // Safe because we know that our file is a VM fd, we know that the
+        // kernel will only read correct amount of memory from our pointer, and
+        // we verify the return result.
+        let ret = unsafe { ioctl_with_ref(self, KVM_ENABLE_CAP, &cap) };
+        if ret < 0 {
+            errno_result()
+        } else {
+            Ok(true)
+        }
+    }
+
