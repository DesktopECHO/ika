   auto res = MakeDrmModeResUnique(*GetFd());
   if (!res) {
     ALOGE("Failed to get DrmDevice resources");
-    return;
+    return stale_connectors;
   }
 
-  // Remove the stale connectors present in connectors_ but not in DRM resources
