-$(eval $(call mesa3d-lib,$(MESA_LIBGBM_NAME),,MESA3D_LIBGBM_BIN,$(MESA3D_TOP)/src/gbm/main))
-$(eval $(call mesa3d-lib,dri_gbm,,MESA3D_DRI_GBM_BIN))
-endif
-
-#-------------------------------------------------------------------------------
-
-endif
