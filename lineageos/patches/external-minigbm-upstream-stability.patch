Patch summary:
Backport three focused Android 17 minigbm fixes onto the pinned Android 16
QPR2 base: avoid destroying a gralloc BO twice after metadata initialization
fails (9843c4f9c0), remove hardcoded host page-size assumptions from virtgpu
mappings (109c854139), and accept lavapipe's software-rendering device identity
in cros_gralloc (8a939198fe). This deliberately avoids the Android 17
IAllocator-v3 transition while retaining the fixes relevant to Ika's 4 KiB and
16 KiB ARM64 guests and diagnostic software-rendering path.

diff --git a/cros_gralloc/cros_gralloc_driver.cc b/cros_gralloc/cros_gralloc_driver.cc
index b17c8c7..68882d9 100644
--- a/cros_gralloc/cros_gralloc_driver.cc
+++ b/cros_gralloc/cros_gralloc_driver.cc
@@ -163,7 +163,8 @@ static bool is_running_with_software_rendering()
 	const char *vulkan_driver = drv_get_os_option("ro.hardware.vulkan");
 	if (!vulkan_driver)
 		vulkan_driver = drv_get_os_option("ro.board.platform");
-	return (vulkan_driver != nullptr && strstr(vulkan_driver, "pastel") != nullptr);
+	return (vulkan_driver != nullptr && (strstr(vulkan_driver, "lvp") != nullptr ||
+					     strstr(vulkan_driver, "pastel") != nullptr));
 }
 
 cros_gralloc_driver::cros_gralloc_driver()
@@ -368,7 +369,10 @@ destroy_hnd:
 	native_handle_close(hnd);
 	native_handle_delete(hnd);
 
-	drv_bo_destroy(bo);
+	// cros_gralloc_buffer takes the bo ownership when cros_gralloc_buffer::create succeeds
+	if (!buffer)
+		drv_bo_destroy(bo);
+
 	return ret;
 }
 
