+        // Each dimension may be in range while the area is not: reject it here
+        // so configure() fails instead of every frame failing to encode.
+        uint64_t mbs = uint64_t((me.v.width + 15) / 16) * ((me.v.height + 15) / 16);
+        if (mbs > kMaxMacroblocks) {
+            res = res.plus(C2SettingResultBuilder::BadValue(me.F(me.v.width)));
+            me.set().width = oldMe.v.width;
+            me.set().height = oldMe.v.height;
+        }
         return res;
     }
 
