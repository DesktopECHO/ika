 constexpr char COMPONENT_NAME[] = "c2.android.avc.encoder";
 constexpr uint32_t kMinOutBufferSize = 524288;
+// libavc bounds the picture area by its highest level (Level 5.1 MaxFS).
+constexpr uint32_t kMaxMacroblocks = 36864;
