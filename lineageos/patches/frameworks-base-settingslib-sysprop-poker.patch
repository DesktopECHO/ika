@@ -21,9 +21,12 @@ import static org.mockito.ArgumentMatchers.anyInt;
 import static org.mockito.ArgumentMatchers.nullable;
 import static org.mockito.Mockito.atLeastOnce;
 import static org.mockito.Mockito.doReturn;
+import static org.mockito.Mockito.doThrow;
 import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.times;
 import static org.mockito.Mockito.verify;
 
+import android.os.DeadObjectException;
 import android.os.IBinder;
 import android.os.Parcel;
 
@@ -73,4 +76,42 @@ public class SystemPropPokerTest {
         verify(mMockBinder, atLeastOnce())
                 .transact(anyInt(), any(Parcel.class), nullable(Parcel.class), anyInt());
     }
+
+    @Test
+    public void testPokeSkipsStableAidlInstances() throws Exception {
+        doReturn(new String[] {"android.hardware.test.ITest/default"})
+                .when(mPokerTask).listServices();
+        mSystemPropPoker.poke();
+        verify(mPokerTask, never()).checkService("android.hardware.test.ITest/default");
+    }
+
+    @Test
+    public void testPokeSkipsServiceThatRefusedPoke() throws Exception {
+        doReturn(new String[] {"refusingService"}).when(mPokerTask).listServices();
+        doReturn(mMockBinder).when(mPokerTask).checkService("refusingService");
+        doThrow(new DeadObjectException()).when(mMockBinder)
+                .transact(anyInt(), any(Parcel.class), nullable(Parcel.class), anyInt());
+        doReturn(true).when(mMockBinder).isBinderAlive();
+
+        mSystemPropPoker.poke();
+        mSystemPropPoker.poke();
+
+        verify(mMockBinder, times(1))
+                .transact(anyInt(), any(Parcel.class), nullable(Parcel.class), anyInt());
+    }
+
+    @Test
+    public void testPokeRetriesServiceThatDied() throws Exception {
+        doReturn(new String[] {"dyingService"}).when(mPokerTask).listServices();
+        doReturn(mMockBinder).when(mPokerTask).checkService("dyingService");
+        doThrow(new DeadObjectException()).when(mMockBinder)
+                .transact(anyInt(), any(Parcel.class), nullable(Parcel.class), anyInt());
+        doReturn(false).when(mMockBinder).isBinderAlive();
+
+        mSystemPropPoker.poke();
+        mSystemPropPoker.poke();
+
+        verify(mMockBinder, times(2))
+                .transact(anyInt(), any(Parcel.class), nullable(Parcel.class), anyInt());
+    }
 }
