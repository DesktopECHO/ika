Patch summary:
Stop Settings' SystemPropPoker from sending SYSPROPS_TRANSACTION to services
its SELinux domain cannot call. After every developer-option change it pokes
every registered service; each HAL and daemon system_app may not call fails
with BR_FAILED_REPLY (EACCES), logging "!!! FAILED BINDER TRANSACTION !!!" and a
rust_binder warning per service. Skip stable AIDL instances ("pkg.IName/inst"),
and remember any other service that refuses the poke while its binder stays
alive so later pokes skip it. Services that actually died are still retried.

diff --git a/packages/SettingsLib/src/com/android/settingslib/development/SystemPropPoker.java b/packages/SettingsLib/src/com/android/settingslib/development/SystemPropPoker.java
index 3f16be184c41..5b6965dd7597 100644
--- a/packages/SettingsLib/src/com/android/settingslib/development/SystemPropPoker.java
+++ b/packages/SettingsLib/src/com/android/settingslib/development/SystemPropPoker.java
@@ -26,6 +26,9 @@ import android.util.Log;
 import androidx.annotation.NonNull;
 import androidx.annotation.VisibleForTesting;
 
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
 public class SystemPropPoker  {
     private static final String TAG = "SystemPropPoker";
 
@@ -61,6 +64,11 @@ public class SystemPropPoker  {
 
     public static class PokerTask extends AsyncTask<Void, Void, Void> {
 
+        // Services that refused a poke while their binder stayed alive, which means this
+        // process's SELinux domain may not call them. Skip them on later pokes instead of
+        // repeating the failed transactions on every developer-option change.
+        private static final Set<String> sRefusedServices = ConcurrentHashMap.newKeySet();
+
         @VisibleForTesting
         String[] listServices() {
             return ServiceManager.listServices();
@@ -79,13 +87,20 @@ public class SystemPropPoker  {
                 return null;
             }
             for (String service : services) {
+                // Stable AIDL instances ("package.IName/instance") are HAL and system daemon
+                // interfaces; the Settings domain is not allowed to call most of them.
+                if (service.indexOf('/') >= 0 || sRefusedServices.contains(service)) {
+                    continue;
+                }
                 IBinder obj = checkService(service);
                 if (obj != null) {
                     Parcel data = Parcel.obtain();
                     try {
                         obj.transact(IBinder.SYSPROPS_TRANSACTION, data, null, 0);
                     } catch (RemoteException e) {
-                        // Ignore
+                        if (obj.isBinderAlive()) {
+                            sRefusedServices.add(service);
+                        }
                     } catch (Exception e) {
                         Log.i(TAG, "Someone wrote a bad service '" + service
                                 + "' that doesn't like to be poked", e);
diff --git a/packages/SettingsLib/tests/robotests/src/com/android/settingslib/development/SystemPropPokerTest.java b/packages/SettingsLib/tests/robotests/src/com/android/settingslib/development/SystemPropPokerTest.java
