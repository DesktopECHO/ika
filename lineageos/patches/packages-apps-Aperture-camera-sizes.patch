-    private val supportedVideoFrameRates = cameraInfo.supportedFrameRateRanges.mapNotNull {
+    /**
+     * Photo aspect ratios, as [AspectRatio.Ratio], the camera captures at a size of its own. A
+     * camera with sizes of neither ratio offers both, cropped.
+     */
+    val supportedPhotoAspectRatios = camera2CameraInfo.getCameraCharacteristic(
+        CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP
+    ).let { map ->
+        val sizes = listOfNotNull(
+            map?.getOutputSizes(ImageFormat.JPEG),
+            map?.getHighResolutionOutputSizes(ImageFormat.JPEG),
+        ).flatMap { it.toList() }
+        listOf(AspectRatio.RATIO_4_3, AspectRatio.RATIO_16_9).filter { aspectRatio ->
+            sizes.any {
+                when (aspectRatio) {
+                    AspectRatio.RATIO_4_3 -> it.width * 3 == it.height * 4
+                    else -> it.width * 9 == it.height * 16
+                }
+            }
+        }.ifEmpty { listOf(AspectRatio.RATIO_4_3, AspectRatio.RATIO_16_9) }
+    }
+
+    private val supportedVideoFrameRates =cameraInfo.supportedFrameRateRanges.mapNotNull {
         FrameRate.fromRange(it.toClosedRange())
     }.toSet()
 
