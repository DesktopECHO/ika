+    /** Ika: whether FILE is an app of the interface mode Android did not boot in. */
+    private static boolean isOtherIkaModeApp(File file) {
+        final File appDir = file.getParentFile();
+        if (appDir == null) {
+            return false;
+        }
+        final String app = appDir.getName() + "/" + file.getName();
+        if (!"tv".equals(SystemProperties.get("persist.sys.ika.mode"))) {
+            return IKA_TV_ONLY_APPS.contains(app);
