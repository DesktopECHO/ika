Patch summary:
Default photos to 16:9. Preview in the captured aspect ratio (CameraController
crops every use case to the preview's), and for video no larger than the
recording, so the camera streams its own mode for it.

diff --git a/app/src/main/java/org/lineageos/aperture/CameraActivity.kt b/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
index edae6e0..c810e70 100644
--- a/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
+++ b/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
@@ -24,6 +24,7 @@ import android.os.Looper
 import android.os.Message
 import android.provider.MediaStore
 import android.util.Log
+import android.util.Size
 import android.view.GestureDetector
 import android.view.KeyEvent
 import android.view.MotionEvent
@@ -45,6 +46,7 @@ import androidx.camera.core.ImageCapture
 import androidx.camera.core.MirrorMode
 import androidx.camera.core.resolutionselector.AspectRatioStrategy
 import androidx.camera.core.resolutionselector.ResolutionSelector
+import androidx.camera.core.resolutionselector.ResolutionStrategy
 import androidx.camera.extensions.ExtensionMode
 import androidx.camera.video.Quality
 import androidx.camera.video.QualitySelector
@@ -1594,6 +1596,59 @@ open class CameraActivity : AppCompatActivity(R.layout.activity_camera) {
             }
         }
 
+        // Preview in the aspect ratio that is captured: CameraController crops every use case to
+        // the preview's. For video, the preview is also no larger than the recording, so the
+        // camera streams the recording's own mode instead of a larger one scaled down.
+        viewModel.cameraController.previewResolutionSelector = when (cameraConfiguration) {
+            is CameraConfiguration.Photo -> ResolutionSelector.Builder()
+                .setAspectRatioStrategy(
+                    AspectRatioStrategy(
+                        cameraConfiguration.photoAspectRatio,
+                        AspectRatioStrategy.FALLBACK_RULE_AUTO,
+                    )
+                )
+                .build()
+
+            is CameraConfiguration.Video -> {
+                val size = when (cameraConfiguration.videoQuality) {
+                    Quality.SD -> Size(640, 480)
+                    Quality.HD -> Size(1280, 720)
+                    Quality.FHD -> Size(1920, 1080)
+                    else -> Size(3840, 2160)
+                }
+                ResolutionSelector.Builder()
+                    .setAspectRatioStrategy(
+                        AspectRatioStrategy(
+                            if (size.width * 3 == size.height * 4) {
+                                AspectRatio.RATIO_4_3
+                            } else {
+                                AspectRatio.RATIO_16_9
+                            },
+                            AspectRatioStrategy.FALLBACK_RULE_AUTO,
+                        )
+                    )
+                    .setResolutionStrategy(
+                        ResolutionStrategy(
+                            size, ResolutionStrategy.FALLBACK_RULE_CLOSEST_LOWER_THEN_HIGHER
+                        )
+                    )
+                    .setResolutionFilter { sizes, _ ->
+                        sizes.filter {
+                            if (size.width * 3 == size.height * 4) {
+                                it.width * 3 == it.height * 4
+                            } else {
+                                it.width * 9 == it.height * 16
+                            }
+                        }
+                    }
+                    .build()
+            }
+
+            is CameraConfiguration.Qr -> ResolutionSelector.Builder()
+                .setAspectRatioStrategy(AspectRatioStrategy.RATIO_16_9_FALLBACK_AUTO_STRATEGY)
+                .build()
+        }
+
         // Get the camera selector
         val cameraSelector = viewModel.getExtensionEnabledCameraSelector(
             cameraConfiguration.camera, cameraConfiguration.extensionMode
