index d44d7e7..2ebf9a6 100644
--- a/encoder/svc/isvce_api.c
+++ b/encoder/svc/isvce_api.c
@@ -325,6 +325,13 @@ static IV_STATUS_T api_check_struct_sanity(iv_obj_t *ps_handle, void *pv_api_ip,
                 return (IV_FAIL);
             }
 
