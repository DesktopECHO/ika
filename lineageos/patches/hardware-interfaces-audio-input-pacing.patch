+void StreamAlsa::recoverPcm(size_t idx) {
+    // tinyalsa reports every failure as -1, so the EIO retries in alsa_utils never apply.
+    // A virtio-snd stream can also stall with no I/O in flight, where every transfer times
+    // out with EIO and nothing restarts it. Stopping the PCM makes the next transfer prepare
+    // and restart it, which resets the device position and requeues the I/O.
+    proxy_stop(mAlsaDeviceProxies[idx].get());
+    if (mIoThreadIsRunning) usleep(kPcmRecoveryDelayUs);
+}
