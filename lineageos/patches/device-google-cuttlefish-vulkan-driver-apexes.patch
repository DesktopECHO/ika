Patch summary:
Ship each guest Vulkan driver as its own APEX on desktop, adding Venus and
lavapipe, and let the host declare the Vulkan version the driver offers.

The desktop product installs com.google.cf.vulkan.{gfxstream,lavapipe,
swiftshader,venus} instead of the single com.google.cf.vulkan APEX
(vulkan.ranchu plus vulkan.pastel). All four keep the APEX name
com.google.cf.vulkan, so apexd activates only the one the Cuttlefish host
tools select with androidboot.vendor.apex.com.google.cf.vulkan: the one with
the driver the guest loads (gfxstream's vulkan.ranchu, guest_lavapipe's
vulkan.lvp, guest_swiftshader's vulkan.pastel, venus's vulkan.virtio, Mesa's
Venus driver), or none when it loads no Vulkan driver. The
vulkan_*_apex=supported keys in android-info.txt declare them. They share the
payload key, as multi-install APEXes must.

The driver APEXes declare no android.hardware.vulkan.version, since the
version depends on the driver and the host GPU. The product installs the 1.1,
1.3 and 1.4 feature files in /vendor/etc/permissions/sku_vulkan_1_1, _1_3 and
_1_4, which SystemConfig reads only when ro.boot.product.vendor.sku names
them: the host tools set the SKU for the version the guest's driver offers
(1.1 for a 1.2 driver; Android has no 1.2 feature file).

diff --git a/guest/hals/vulkan/Android.bp b/guest/hals/vulkan/Android.bp
index 43f359e..28c3caf 100644
--- a/guest/hals/vulkan/Android.bp
+++ b/guest/hals/vulkan/Android.bp
@@ -79,3 +79,58 @@ linker_config {
     src: "apex_linkerconfig.json",
     installable: false,
 }
+
+// Products whose android-info.txt declares vulkan_{gfxstream,lavapipe,
+// swiftshader,venus}_apex=supported install one APEX per guest Vulkan driver
+// instead of com.google.cf.vulkan. All are named com.google.cf.vulkan, so
+// apexd activates only the one the host selects for the GPU mode with
+// androidboot.vendor.apex.com.google.cf.vulkan.
+apex_defaults {
+    name: "com.google.cf.vulkan-driver-defaults",
+    manifest: "apex_manifest.json",
+    key: "com.google.cf.apex.key",
+    certificate: ":com.google.cf.apex.certificate",
+    file_contexts: "apex_file_contexts",
+    updatable: false,
+    vendor: true,
+
+    // Zygote GL preloading expects 32-bit /lib/ copies
+    // of the native_shared_libs.
+    compile_multilib: "both",
+
+    // No android.hardware.vulkan.version: the drivers offer different
+    // versions, so the product installs it per vendor SKU and the host
+    // selects the SKU.
+    prebuilts: [
+        "android.hardware.vulkan.compute-0.prebuilt.xml",
+        "android.hardware.vulkan.level-1.prebuilt.xml",
+        "android.software.opengles.deqp.level-latest.prebuilt.xml",
+        "android.software.vulkan.deqp.level-latest.prebuilt.xml",
+        "com.google.cf.vulkan-linker-config",
+        "com.google.cf.vulkan.rc",
+    ],
+}
+
+apex {
+    name: "com.google.cf.vulkan.gfxstream",
+    defaults: ["com.google.cf.vulkan-driver-defaults"],
+    native_shared_libs: ["vulkan.ranchu"],
+}
+
+apex {
+    name: "com.google.cf.vulkan.lavapipe",
+    defaults: ["com.google.cf.vulkan-driver-defaults"],
+    native_shared_libs: ["vulkan.lvp"],
+}
+
+apex {
+    name: "com.google.cf.vulkan.swiftshader",
+    defaults: ["com.google.cf.vulkan-driver-defaults"],
+    native_shared_libs: ["vulkan.pastel"],
+}
+
+apex {
+    name: "com.google.cf.vulkan.venus",
+    defaults: ["com.google.cf.vulkan-driver-defaults"],
+    native_shared_libs: ["vulkan.virtio"],
+}
diff --git a/shared/desktop/android-info.txt b/shared/desktop/android-info.txt
index b246762..8fe1fa1 100644
--- a/shared/desktop/android-info.txt
+++ b/shared/desktop/android-info.txt
@@ -1,2 +1,6 @@
 config=tablet
 gfxstream=supported
+vulkan_gfxstream_apex=supported
+vulkan_lavapipe_apex=supported
+vulkan_swiftshader_apex=supported
+vulkan_venus_apex=supported
diff --git a/shared/desktop/device_vendor.mk b/shared/desktop/device_vendor.mk
index 0796c04..657736f 100644
--- a/shared/desktop/device_vendor.mk
+++ b/shared/desktop/device_vendor.mk
@@ -20,6 +20,24 @@ SYSTEM_EXT_MANIFEST_FILES += device/google/cuttlefish/shared/config/system_ext_m
 # Extend cuttlefish common sepolicy with desktop-specific functionality.
 BOARD_SEPOLICY_DIRS += device/google/cuttlefish/shared/desktop/sepolicy
 
+# One com.google.cf.vulkan APEX per guest Vulkan driver (gfxstream, lavapipe,
+# SwiftShader, Venus), declared in android-info.txt; the host activates the
+# one the guest's Vulkan driver is in, or none. The Vulkan version feature
+# comes from the vendor SKU the host sets for the version that driver offers
+# (androidboot.product.vendor.sku=vulkan_1_1, _1_3 or _1_4), which adds the
+# files in /vendor/etc/permissions/sku_<SKU>; Android has no 1.2 feature file.
+CF_VULKAN_DRIVER_APEXES := true
+PRODUCT_PACKAGES += \
+    com.google.cf.vulkan.gfxstream \
+    com.google.cf.vulkan.lavapipe \
+    com.google.cf.vulkan.swiftshader \
+    com.google.cf.vulkan.venus \
+
+PRODUCT_COPY_FILES += \
+    frameworks/native/data/etc/android.hardware.vulkan.version-1_1.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/sku_vulkan_1_1/android.hardware.vulkan.version-1_1.xml \
+    frameworks/native/data/etc/android.hardware.vulkan.version-1_3.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/sku_vulkan_1_3/android.hardware.vulkan.version-1_3.xml \
+    frameworks/native/data/etc/android.hardware.vulkan.version-1_4.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/sku_vulkan_1_4/android.hardware.vulkan.version-1_4.xml
+
 $(call inherit-product, $(SRC_TARGET_DIR)/product/handheld_vendor.mk)
 
 $(call inherit-product, frameworks/native/build/tablet-7in-xhdpi-2048-dalvik-heap.mk)
diff --git a/shared/graphics/device_vendor.mk b/shared/graphics/device_vendor.mk
index 14ba3ea..415a848 100644
--- a/shared/graphics/device_vendor.mk
+++ b/shared/graphics/device_vendor.mk
@@ -41,10 +41,13 @@ PRODUCT_PACKAGES += \
     libGLESv2_emulation \
     libGLESv2_enc \
 
-# Gfxstream Vulkan implementation (Vulkan streamed to the host).
+# Gfxstream Vulkan implementation (Vulkan streamed to the host). Products
+# that set CF_VULKAN_DRIVER_APEXES install one APEX per driver instead.
 ifeq ($(TARGET_VULKAN_SUPPORT),true)
+ifneq ($(CF_VULKAN_DRIVER_APEXES),true)
 PRODUCT_PACKAGES += com.google.cf.vulkan
 endif
+endif
 
 #
 # Hardware Composer HAL
