index 81583aa15e2e841a0e98fe658c64ac98d80c9d96..6fafce7dc25b11fdbfb98548bba11ed7ada057b7 100644
--- a/src/gfxstream/codegen/scripts/cereal/deepcopy.py
+++ b/src/gfxstream/codegen/scripts/cereal/deepcopy.py
@@ -71,6 +71,25 @@ class DeepcopyCodegen(VulkanTypeIterator):
 
         return bytesExpr
 
+    def hasFilterGuard(self, vulkanType):
+        return vulkanType.filterVar is not None and vulkanType.filterVals is not None
+
+    def beginFilterGuard(self, vulkanType):
+        if not self.hasFilterGuard(vulkanType):
+            return
+
+        filterVarAccess = "%s->%s" % (self.inputVars[0], vulkanType.filterVar)
+        filterValsExpr = " || ".join(
+            "(%s == %s)" % (filterVal, filterVarAccess)
+            for filterVal in vulkanType.filterVals)
+        self.cgen.beginIf(filterValsExpr)
+
+    def endFilterGuard(self, vulkanType):
+        if not self.hasFilterGuard(vulkanType):
+            return
+
+        self.cgen.endIf()
+
     def onCheck(self, vulkanType):
         pass
 
@@ -95,11 +114,19 @@ class DeepcopyCodegen(VulkanTypeIterator):
 
         isPtr = vulkanType.pointerIndirectionLevels > 0
 
+        hasFilterGuard = self.hasFilterGuard(vulkanType)
+        if isPtr and hasFilterGuard:
+            # Filtered pointers may be undefined when their selector is inactive.
+            self.cgen.stmt("%s = nullptr" % accessRhs)
+
+        self.beginFilterGuard(vulkanType)
+
         if lenAccessorGuardLhs is not None:
             self.cgen.beginIf(lenAccessorGuardLhs)
 
         if isPtr:
-            self.cgen.stmt("%s = nullptr" % accessRhs)
+            if not hasFilterGuard:
+                self.cgen.stmt("%s = nullptr" % accessRhs)
             self.cgen.beginIf(accessLhs)
 
             self.cgen.stmt( \
@@ -138,6 +165,8 @@ class DeepcopyCodegen(VulkanTypeIterator):
         if lenAccessorGuardLhs is not None:
             self.cgen.endIf()
 
+        self.endFilterGuard(vulkanType)
+
     def onString(self, vulkanType):
         accessLhs = self.exprAccessorLhs(vulkanType)
         accessRhs = self.exprAccessorRhs(vulkanType)
@@ -231,6 +260,7 @@ class DeepcopyCodegen(VulkanTypeIterator):
         lenAccessLhs = self.lenAccessorLhs(vulkanType)
 
         self.cgen.stmt("%s = nullptr" % accessRhs)
+        self.beginFilterGuard(vulkanType)
         self.cgen.beginIf(accessLhs)
 
         bytesExpr = self.makeAllocBytesExpr(lenAccessLhs, vulkanType)
@@ -244,6 +274,7 @@ class DeepcopyCodegen(VulkanTypeIterator):
              bytesExpr))
 
         self.cgen.endIf()
+        self.endFilterGuard(vulkanType)
 
     def onValue(self, vulkanType):
