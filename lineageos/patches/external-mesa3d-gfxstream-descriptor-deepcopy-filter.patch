+    def hasFilterGuard(self, vulkanType):
+        return vulkanType.filterVar is not None and vulkanType.filterVals is not None
+
+    def beginFilterGuard(self, vulkanType):
+        if not self.hasFilterGuard(vulkanType):
+            return
+
+        filterVarAccess = "%s->%s" % (self.inputVars[0], vulkanType.filterVar)
+        filterValsExpr = " || ".join(
