+// Waits up to kFrameTimeoutMs for a frame to dequeue: 0, -ETIMEDOUT, or another -errno
+int ExternalCameraDeviceSession::waitForV4l2FrameLocked() {
+    pollfd pfd{.fd = mV4l2Fd.get(), .events = POLLIN};
+    const int ret = TEMP_FAILURE_RETRY(poll(&pfd, 1, kFrameTimeoutMs));
+    if (ret < 0) {
+        return -errno;
+    }
+    if (ret == 0) {
+        return -ETIMEDOUT;
+    }
+    return (pfd.revents & POLLIN) ? 0 : -EIO;
