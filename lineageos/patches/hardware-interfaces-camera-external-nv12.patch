+    {
+        std::unique_lock<std::mutex> lk(mV4l2BufferLock);
+        mV4L2BufferReturned.wait_for(lk, std::chrono::milliseconds(kRestartDrainMs),
+                                     [this] { return mNumDequeuedV4l2Buffers == 0; });
+        if (mNumDequeuedV4l2Buffers != 0) {
+            ALOGW("%s: restarting with %zu buffers still out", __FUNCTION__,
+                  mNumDequeuedV4l2Buffers);
+            mNumDequeuedV4l2Buffers = 0;
