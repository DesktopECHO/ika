+// Temporal noise reduction: a pixel that changed by less than the threshold since the previous
+// output frame is mostly sensor noise and is blended into it; a larger change is motion and is
+// kept. The new frame's weight, out of 256, rises from newWeight for an unchanged pixel to 256 at
+// the threshold. cur becomes the output and prev (tightly packed) the history for the next frame.
+void denoisePlane(uint8_t* cur, size_t curStride, uint8_t* prev, size_t width, size_t height,
+                  int threshold, int newWeight) {
+    // Weight added per level of change, in 1/65536ths
+    const int step = ((256 - newWeight) << 16) / threshold;
+    for (size_t y = 0; y < height; y++) {
+        uint8_t* c = cur + y * curStride;
+        uint8_t* p = prev + y * width;
+        for (size_t x = 0; x < width; x++) {
+            const int d = c[x] - p[x];
+            const int ad = d < 0 ? -d : d;
+            int w = newWeight + ((ad * step) >> 16);
+            w = w > 256 ? 256 : w;
+            const int v = p[x] + ((d * w + 128) >> 8);
+            c[x] = p[x] = static_cast<uint8_t>(v);
+        }
+    }
+}
+
+// Edge-preserving smoothing of chroma: each pixel becomes the mean of the pixels in its
+// (2 * R + 1)-square neighborhood that are within kChromaSigmaRange of it, so color noise is
+// averaged but color doesn't bleed across edges. rows holds the unfiltered rows around the current
+// one, each padded by R repeated edge pixels.
+constexpr int kChromaSigmaRange = 8;
+
+template <int R>
+void sigmaRow(const uint8_t* const* rows, uint8_t* __restrict out, size_t width) {
+    const uint8_t* center = rows[R] + R;
+    for (size_t x = 0; x < width; x++) {
+        const int c = center[x];
+        int sum = 0;
+        int count = 0;
+        for (int dy = 0; dy <= 2 * R; dy++) {
+            for (int dx = 0; dx <= 2 * R; dx++) {
+                const int q = rows[dy][x + dx];
+                const int d = q - c;
+                const int near = (d < 0 ? -d : d) <= kChromaSigmaRange ? 1 : 0;
+                sum += near * q;
+                count += near;
+            }
+        }
+        // Rounded mean; float division is exact enough here and vectorizes
+        out[x] = static_cast<uint8_t>(static_cast<float>(sum) / static_cast<float>(count) + 0.5f);
+    }
+}
+
+template <int R>
+void sigmaPlane(uint8_t* plane, size_t stride, size_t width, size_t height,
+                std::vector<uint8_t>& scratch) {
+    constexpr size_t kSpan = 2 * R + 1;
+    const size_t padded = width + 2 * R;
+    scratch.resize(kSpan * padded);
+    // Row y lives in slot y % kSpan until row y + kSpan replaces it
+    auto load = [&](size_t y) {
+        uint8_t* dst = &scratch[(y % kSpan) * padded];
+        const uint8_t* src = plane + y * stride;
+        memset(dst, src[0], R);
+        memcpy(dst + R, src, width);
+        memset(dst + R + width, src[width - 1], R);
+    };
+    for (size_t y = 0; y < std::min<size_t>(R, height); y++) {
+        load(y);
+    }
+    const uint8_t* rows[kSpan];
+    for (size_t y = 0; y < height; y++) {
+        if (y + R < height) {
+            load(y + R);
