<?xml version="1.0" encoding="utf-8"?>
<!-- The icon of Desktop/TV, the mode switcher: the art on white, as the other
     apps' icons are. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground>
        <!-- 51 of the 72dp the launcher shows, with white around it as Files
             (DocumentsUI) has. A fraction (28.5 of 108dp), so that the white
             stays in proportion when the icon is drawn at another size, such
             as Ika's desktop menu icons. -->
        <inset
            android:drawable="@drawable/ic_switch_art"
            android:inset="26.5%" />
    </foreground>
</adaptive-icon>
