#!/usr/bin/make -f

HOST_MACHINE := $(shell uname -m)
ifeq ($(HOST_MACHINE),aarch64)
LINEAGEOS_ARCH := arm64
else ifeq ($(HOST_MACHINE),x86_64)
LINEAGEOS_ARCH := x86_64
else
LINEAGEOS_ARCH := unsupported
endif
LINEAGEOS_SRC := $(CURDIR)/../../lineageos-$(LINEAGEOS_ARCH)
LINEAGEOS_DEST := debian/ika-lineageos/usr/share/cuttlefish-common/lineageos

%:
	dh $@

# The package version comes from packaging/VERSION, not debian/changelog.
ika_repo_root := $(abspath $(dir $(firstword $(MAKEFILE_LIST)))/../../..)
ika_version := $(shell tr -d '\n' < $(ika_repo_root)/packaging/VERSION)
ifeq ($(ika_version),)
$(error could not read $(ika_repo_root)/packaging/VERSION)
endif

.PHONY: override_dh_gencontrol
override_dh_gencontrol:
	dh_gencontrol -- -v$(ika_version)-1

override_dh_auto_build:
	@true

override_dh_auto_install:
	test "$(LINEAGEOS_ARCH)" != unsupported
	install -d $(LINEAGEOS_DEST)
	cp -a --reflink=auto --sparse=always $(LINEAGEOS_SRC)/. $(LINEAGEOS_DEST)/
	./thin-provision-images.sh $(LINEAGEOS_DEST)

override_dh_fixperms:
	dh_fixperms
	find $(LINEAGEOS_DEST) -type d ! -type l -exec chmod 755 '{}' +
	find $(LINEAGEOS_DEST) ! -type l -exec chmod u+w '{}' +
	find $(LINEAGEOS_DEST) ! -type l -exec chmod g=u '{}' +
	find $(LINEAGEOS_DEST) -type d ! -type l -exec chmod a+rx '{}' +

override_dh_makeshlibs:
	@true

override_dh_shlibdeps:
	@true

override_dh_dwz:
	@true

override_dh_strip:
	@true
