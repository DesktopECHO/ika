+static VkResult
+dzn_cmd_buffer_clear_ms_scratch_inline(struct dzn_cmd_buffer *cmdbuf,
+                                       ID3D12Resource *scratch,
+                                       const D3D12_RENDER_TARGET_VIEW_DESC *rtv_desc,
+                                       const float clear_vals[4])
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+   struct dzn_descriptor_heap *heap;
+   uint32_t slot;
+
+   VkResult result =
+      dzn_descriptor_heap_pool_alloc_slots(&cmdbuf->rtvs.pool, device, 1, &heap, &slot);
+   if (result != VK_SUCCESS)
+      return result;
+
+   D3D12_CPU_DESCRIPTOR_HANDLE rtv = dzn_descriptor_heap_get_cpu_handle(heap, slot);
+   ID3D12Device1_CreateRenderTargetView(device->dev, scratch, rtv_desc, rtv);
+   ID3D12GraphicsCommandList1_ClearRenderTargetView(cmdbuf->cmdlist, rtv, clear_vals, 0, NULL);
+   dzn_cmd_buffer_clear_ms_scratch_barrier((ID3D12GraphicsCommandList *)cmdbuf->cmdlist,
+                                           scratch, D3D12_RESOURCE_STATE_COPY_SOURCE);
+   return VK_SUCCESS;
+}
