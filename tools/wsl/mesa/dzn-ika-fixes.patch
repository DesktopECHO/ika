+static VkResult
+dzn_cmd_buffer_clear_ms_scratch_async(struct dzn_cmd_buffer *cmdbuf,
+                                      ID3D12Resource *scratch,
+                                      const D3D12_RENDER_TARGET_VIEW_DESC *rtv_desc,
+                                      const float clear_vals[4])
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+   struct dzn_cmd_buffer_gpu_work *work =
+      vk_zalloc(&cmdbuf->vk.pool->alloc, sizeof(*work), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (!work)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   VkResult result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   D3D12_DESCRIPTOR_HEAP_DESC heap_desc = {
+      .Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV,
+      .NumDescriptors = 1,
+   };
+   if (FAILED(ID3D12Device1_CreateDescriptorHeap(device->dev, &heap_desc,
+                                                 &IID_ID3D12DescriptorHeap,
+                                                 (void **)&work->heap)) ||
+       FAILED(ID3D12Device1_CreateCommandAllocator(device->dev, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                   &IID_ID3D12CommandAllocator,
+                                                   (void **)&work->alloc)) ||
+       FAILED(ID3D12Device1_CreateCommandList(device->dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                              work->alloc, NULL,
+                                              &IID_ID3D12GraphicsCommandList,
+                                              (void **)&work->list)) ||
+       FAILED(ID3D12Device1_CreateFence(device->dev, 0, D3D12_FENCE_FLAG_NONE,
+                                        &IID_ID3D12Fence, (void **)&work->fence)))
+      goto err;
+
+   D3D12_CPU_DESCRIPTOR_HANDLE rtv =
+      dzn_ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(work->heap);
+   ID3D12Device1_CreateRenderTargetView(device->dev, scratch, rtv_desc, rtv);
+   ID3D12GraphicsCommandList_ClearRenderTargetView(work->list, rtv, clear_vals, 0, NULL);
+   dzn_cmd_buffer_clear_ms_scratch_barrier(work->list, scratch, D3D12_RESOURCE_STATE_COMMON);
+   if (FAILED(ID3D12GraphicsCommandList_Close(work->list)))
+      goto err;
