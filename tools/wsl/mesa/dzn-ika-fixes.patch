+   ID3D12CommandQueue *queue = device->swapchain_queue->cmdqueue;
+   ID3D12CommandQueue_ExecuteCommandLists(queue, 1, (ID3D12CommandList **)&work->list);
+   list_addtail(&work->link, &cmdbuf->gpu_work);
+   if (FAILED(ID3D12CommandQueue_Signal(queue, work->fence, 1)))
+      return VK_ERROR_DEVICE_LOST;
+
+   return VK_SUCCESS;
+
+err:
+   dzn_cmd_buffer_gpu_work_release(cmdbuf, work, false);
+   return result;
+}
