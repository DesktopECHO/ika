+static void
+dzn_cmd_buffer_gpu_work_release(struct dzn_cmd_buffer *cmdbuf,
+                                struct dzn_cmd_buffer_gpu_work *work,
+                                bool executed)
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+
+   if (work->fence) {
+      if (executed && ID3D12Fence_GetCompletedValue(work->fence) < 1 &&
+          SUCCEEDED(ID3D12Device1_GetDeviceRemovedReason(device->dev)))
+         ID3D12Fence_SetEventOnCompletion(work->fence, 1, NULL);
+      ID3D12Fence_Release(work->fence);
+   }
+   if (work->list)
+      ID3D12GraphicsCommandList_Release(work->list);
+   if (work->alloc)
+      ID3D12CommandAllocator_Release(work->alloc);
+   if (work->heap)
+      ID3D12DescriptorHeap_Release(work->heap);
+   vk_free(&cmdbuf->vk.pool->alloc, work);
+}
+
+static void
+dzn_cmd_buffer_release_gpu_work(struct dzn_cmd_buffer *cmdbuf)
+{
+   list_for_each_entry_safe(struct dzn_cmd_buffer_gpu_work, work, &cmdbuf->gpu_work, link) {
+      list_del(&work->link);
+      dzn_cmd_buffer_gpu_work_release(cmdbuf, work, true);
+   }
+}
