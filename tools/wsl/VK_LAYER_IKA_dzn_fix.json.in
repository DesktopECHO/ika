{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_IKA_dzn_fix",
    "type": "GLOBAL",
    "library_path": "@LIBDIR@/libVkLayer_ika_dzn_fix.so",
    "api_version": "1.4.341",
    "implementation_version": "1",
    "description": "Works around Mesa Dozen bugs that crash gfxstream (Ika on WSL2)",
    "functions": {
      "vkGetInstanceProcAddr": "ika_dzn_fix_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "ika_dzn_fix_GetDeviceProcAddr"
    },
    "enable_environment": {
      "IKA_DZN_FIX": "1"
    },
    "disable_environment": {
      "DISABLE_IKA_DZN_FIX": "1"
    },
    "device_extensions": [
      {
        "name": "VK_EXT_provoking_vertex",
        "spec_version": "1",
        "entrypoints": []
      }
    ]
  }
}
