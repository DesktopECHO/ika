#!/usr/bin/bash

# Roots the Ika Android VM with the latest Magisk release.
#
# Works on user and userdebug builds without adb root:
#   1. Magisk's own boot_patch.sh patches the stock init_boot.img inside the
#      guest as the shell user, as the Magisk app does for "Select and Patch a
#      File".
#   2. A locked VM, one that has not been rooted, is unlocked once the user
#      confirms, with 'fastboot flashing unlock' in its U-Boot bootloader,
#      reachable through the Cuttlefish fastboot proxy. Unlocking
#      invalidates the KeyMint-bound keys that encrypt /data, so the data is
#      wiped, as a phone bootloader does. U-Boot reboots straight into Android
#      after unlocking, and Android's recovery would wipe /data by writing
#      zeros over the whole partition into the host overlay. Instead the VM is
#      stopped at once and its overlay deleted: every guest write lives there.
#   3. The patched init_boot is flashed from U-Boot, which refuses flashing
#      while locked. It lands in the new overlay, so 'ika reset' returns the
#      VM to stock (and relocks it).
#   4. After boot, a service embedded in the patched ramdisk finishes Magisk's
#      "additional setup" and lets 'adb shell su' through. Nothing else can
#      start it: it runs only for the token generated by this run.

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
: "${CVD_HOST_OUT:=/usr/lib/cuttlefish-common}"
: "${CVD_PRODUCT_OUT:=/usr/share/cuttlefish-common/lineageos}"
: "${CVD_HOME_DIR:=${HOME}/ika}"
: "${IKA_ROOT_BOOT_TIMEOUT_SEC:=900}"
CVD_INSTANCE_DIR="${CVD_HOME_DIR}/cuttlefish/instances/cvd-1"
CVD_CONFIG_PATH="${CVD_INSTANCE_DIR}/cuttlefish_config.json"
CHROMIUM_INSTALL_STAMP="${CVD_HOME_DIR}/chromium-installed-cvd-1"
ADB_BIN="${CVD_HOST_OUT}/bin/adb"
FASTBOOT_BIN="${CVD_HOST_OUT}/bin/fastboot"
MAGISK_RELEASES_URL="https://github.com/topjohnwu/Magisk/releases"
# The latest Magisk APK is kept in ~/ika/apps, like Chromium.apk.
MAGISK_APK_DIR="${CVD_HOME_DIR}/apps"
GUEST_STAGE_DIR="/data/local/tmp/ika-magisk"
# Installed in /data/adb/magisk, as the Magisk app's direct install does.
MAGISK_BINARIES=(busybox magisk magiskboot magiskinit magiskpolicy init-ld)
MAGISK_ASSETS=(boot_patch.sh util_functions.sh addon.d.sh stub.apk)

ADB_SERIAL=""
FASTBOOT_SERIAL=""
WORK_DIR=""

log() {
  printf '[%s] %s\n' "${SCRIPT_NAME}" "$*" >&2
}

die() {
  log "error: $*"
  exit 1
}

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME}

Roots the Ika Android VM with the latest Magisk release from GitHub.

The VM is started first if it is not running. Rooting it the first time
unlocks its bootloader and wipes it, like a phone, after asking to confirm;
later runs keep the data and update Magisk. Afterwards
'adb shell su' works, the Magisk app is installed and developer options are
enabled. 'ika reset' undoes it.
EOF
}

cleanup() {
  [[ -n "${WORK_DIR}" ]] && rm -rf "${WORK_DIR}"
}

config_value() {
  local key="$1"

  [[ -f "${CVD_CONFIG_PATH}" ]] || return 1
  grep -oE "\"${key}\"[[:space:]]*:[[:space:]]*(\"[^\"]*\"|[0-9]+)" "${CVD_CONFIG_PATH}" \
    | head -n1 | sed -E 's/^[^:]*:[[:space:]]*"?([^"]*)"?$/\1/'
}

resolve_serials() {
  local adb_ip_and_port
  local fastboot_port
  local vsock_cid=""

  adb_ip_and_port="$(config_value adb_ip_and_port || true)"
  adb_ip_and_port="${adb_ip_and_port:-127.0.0.1:6520}"
  case "${adb_ip_and_port}" in
    0.0.0.0:*|'[::]':*) adb_ip_and_port="127.0.0.1:${adb_ip_and_port##*:}" ;;
  esac
  ADB_SERIAL="${adb_ip_and_port}"
  if grep -q '"native_vsock"' "${CVD_CONFIG_PATH}" 2>/dev/null; then
    vsock_cid="$(config_value vsock_guest_cid || true)"
    if [[ "${vsock_cid}" =~ ^[0-9]+$ ]] && (( vsock_cid > 2 )); then
      ADB_SERIAL="vsock:${vsock_cid}:5555"
    fi
  fi

  fastboot_port="$(config_value fastboot_host_port || true)"
  FASTBOOT_SERIAL="tcp:127.0.0.1:${fastboot_port:-${adb_ip_and_port##*:}}"
}

adb_cmd() {
  "${ADB_BIN}" -s "${ADB_SERIAL}" "$@"
}

guest_prop() {
  timeout 10 "${ADB_BIN}" -s "${ADB_SERIAL}" shell getprop "$1" 2>/dev/null | tr -d '\r'
}

boot_completed() {
  [[ "$(guest_prop sys.boot_completed)" == "1" ]]
}

wait_for_boot() {
  local deadline=$((SECONDS + IKA_ROOT_BOOT_TIMEOUT_SEC))
  local bootloader_check=$((SECONDS + 30))

  log "waiting for Android to boot..."
  while (( SECONDS < deadline )); do
    timeout 10 "${ADB_BIN}" connect "${ADB_SERIAL}" >/dev/null 2>&1 || true
    if boot_completed; then
      return 0
    fi
    # An interrupted run can leave the VM in its bootloader, and a reboot
    # request to the bootloader also survives a VM restart.
    if (( SECONDS >= bootloader_check )); then
      bootloader_check=$((SECONDS + 30))
      if timeout 5 "${FASTBOOT_BIN}" -s "${FASTBOOT_SERIAL}" getvar current-slot >/dev/null 2>&1; then
        log "the VM is in its bootloader; rebooting to Android..."
        fastboot_cmd reboot || true
      fi
    fi
    sleep 2
  done
  die "Android did not finish booting within ${IKA_ROOT_BOOT_TIMEOUT_SEC}s"
}

# U-Boot's TCP fastboot sometimes drops a connection or stalls a transfer;
# retry each command. A flash takes well under a second, so a stall is cut
# short instead of waiting.
fastboot_cmd() {
  local attempt

  for attempt in 1 2 3 4 5; do
    if timeout 20 "${FASTBOOT_BIN}" -s "${FASTBOOT_SERIAL}" "$@"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_bootloader() {
  local deadline=$((SECONDS + 180))

  while (( SECONDS < deadline )); do
    if timeout 10 "${FASTBOOT_BIN}" -s "${FASTBOOT_SERIAL}" getvar current-slot >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  die "the bootloader's fastboot did not answer at ${FASTBOOT_SERIAL}"
}

ika_bin() {
  if [[ -x "${SCRIPT_DIR}/ika" ]]; then
    printf '%s\n' "${SCRIPT_DIR}/ika"
  else
    command -v ika || die "ika is not installed"
  fi
}

ensure_vm_booted() {
  if ! pgrep -u "${UID}" -x crosvm >/dev/null; then
    log "Ika is not running; starting it..."
    start_ika
  fi
  resolve_serials
  wait_for_boot
}

# 'ika start' fails when the VM comes up in its bootloader; wait_for_boot
# then reboots it to Android.
start_ika() {
  if ! "$(ika_bin)" start "$@"; then
    pgrep -u "${UID}" -x crosvm >/dev/null || die "Ika did not start"
  fi
}

confirm_wipe() {
  local reply

  printf 'WARNING: Rooting will wipe your Android virtual device, type "Y" to continue. ' >&2
  if ! IFS= read -r -n 1 -u 4 reply; then
    printf '\n' >&2
    die "rooting aborted"
  fi
  printf '\n' >&2
  [[ "${reply}" == "Y" || "${reply}" == "y" ]] || die "rooting aborted"
}

# Unlocks the bootloader and wipes the VM's data; see the top of this file.
unlock_and_wipe() {
  local ika

  ika="$(ika_bin)"
  log "unlocking the bootloader; this wipes the VM's data..."
  adb_cmd reboot bootloader
  wait_for_bootloader
  # Not retried: U-Boot reboots into Android as soon as it has unlocked.
  if ! timeout 30 "${FASTBOOT_BIN}" -s "${FASTBOOT_SERIAL}" flashing unlock; then
    fastboot_cmd reboot || true
    die "could not unlock the bootloader"
  fi
  "${ika}" stop
  rm -f "${CVD_INSTANCE_DIR}/overlay.img" "${CHROMIUM_INSTALL_STAMP}"
  log "starting the wiped VM..."
  # Without the stamp, this start installs Chromium again; main opens the
  # console at the end.
  start_ika --no-console
  wait_for_boot
}

latest_magisk_tag() {
  local url

  url="$(curl -fsSIL -o /dev/null -w '%{url_effective}' "${MAGISK_RELEASES_URL}/latest")" || return 1
  [[ "${url##*/}" =~ ^v[0-9][0-9.]*$ ]] || return 1
  printf '%s\n' "${url##*/}"
}

cached_magisk_apk() {
  find "${MAGISK_APK_DIR}" -maxdepth 1 -name 'Magisk-v*.apk' 2>/dev/null | sort -V | tail -n1
}

# Prints the path of the latest Magisk APK, downloading it when not cached.
fetch_magisk_apk() {
  local tag
  local apk

  mkdir -p "${MAGISK_APK_DIR}"
  if ! tag="$(latest_magisk_tag)"; then
    apk="$(cached_magisk_apk)"
    [[ -n "${apk}" ]] || die "could not look up the latest Magisk release on GitHub"
    log "could not reach GitHub; using cached $(basename "${apk}")"
    printf '%s\n' "${apk}"
    return 0
  fi

  apk="${MAGISK_APK_DIR}/Magisk-${tag}.apk"
  if [[ ! -s "${apk}" ]]; then
    log "downloading Magisk ${tag}..."
    curl -fL --retry 3 -o "${apk}.part" "${MAGISK_RELEASES_URL}/download/${tag}/Magisk-${tag}.apk" \
      || die "could not download Magisk ${tag}"
    python3 -m zipfile -t "${apk}.part" >/dev/null || die "the downloaded Magisk ${tag} APK is damaged"
    mv -f "${apk}.part" "${apk}"
  else
    log "using cached Magisk ${tag}"
  fi
  find "${MAGISK_APK_DIR}" -maxdepth 1 -name 'Magisk-v*.apk*' ! -name "Magisk-${tag}.apk" -delete
  printf '%s\n' "${apk}"
}

extract_magisk() {
  local apk="$1"
  local abi="$2"
  local dest="$3"

  python3 - "${apk}" "${abi}" "${dest}" "${MAGISK_BINARIES[@]}" -- "${MAGISK_ASSETS[@]}" <<'EOF' \
    || die "could not extract Magisk for ${abi} from $(basename "${apk}")"
import os
import sys
import zipfile

apk, abi, dest = sys.argv[1:4]
split = sys.argv.index("--")
members = {f"lib/{abi}/lib{name}.so": name for name in sys.argv[4:split]}
members.update({f"assets/{name}": name for name in sys.argv[split + 1:]})
with zipfile.ZipFile(apk) as archive:
    names = set(archive.namelist())
    for member, name in members.items():
        # Magisk 31 and later no longer ship stub.apk.
        if member not in names and name == "stub.apk":
            continue
        with archive.open(member) as src, open(os.path.join(dest, name), "wb") as out:
            out.write(src.read())
EOF
}

# Writes the files added to the patched ramdisk and the guest-side patch
# script into the payload directory.
write_payload_scripts() {
  local dest="$1"
  local token="$2"

  # Magisk appends overlay.d/*.rc to init.rc and copies overlay.d/sbin into its
  # tmpfs, substituting that directory for ${MAGISKTMP}.
  cat > "${dest}/ika-root.rc" <<EOF
service ika_root \${MAGISKTMP}/ika-root.sh ${token}
    user root
    group root
    seclabel u:r:magisk:s0
    oneshot
    disabled

on property:debug.ika.root=${token}
    start ika_root
EOF

  cat > "${dest}/ika-root.sh" <<EOF
#!/system/bin/sh
# Finishes the Magisk install that ${SCRIPT_NAME} started; runs once per token.
token="\$1"
stage=${GUEST_STAGE_DIR}
bin=/data/adb/magisk
done_file=/data/adb/ika-root.done

[ "\$(cat "\${stage}/token" 2>/dev/null)" = "\${token}" ] || exit 1
[ "\$(cat "\${done_file}" 2>/dev/null)" = "\${token}" ] && exit 0
rm -rf "\${bin}"
mkdir -p "\${bin}"
for file in ${MAGISK_BINARIES[*]} ${MAGISK_ASSETS[*]}; do
  [ "\${file}" = stub.apk ] && [ ! -e "\${stage}/\${file}" ] && continue
  cp "\${stage}/\${file}" "\${bin}/\${file}" || exit 1
done
chown -R 0:0 "\${bin}"
chmod -R 755 "\${bin}"
chmod 700 /data/adb
# Allow 'adb shell su' (uid 2000) without a prompt.
"\${0%/*}/magisk" --sqlite \\
  "REPLACE INTO policies (uid,policy,until,logging,notification) VALUES(2000,2,0,1,1)" || exit 1
echo "\${token}" > "\${done_file}"
rm -rf "\${stage}"
EOF

  cat > "${dest}/ika-patch.sh" <<'EOF'
#!/system/bin/sh
# Patches init_boot.img with Magisk's boot_patch.sh, then adds Ika's setup
# service. Runs as the shell user.
cd "${0%/*}" || exit 1
chmod 755 ./*
export ASH_STANDALONE=1 BOOTMODE=true KEEPVERITY=true KEEPFORCEENCRYPT=true \
  PATCHVBMETAFLAG=false RECOVERYMODE=false LEGACYSAR=false
./busybox sh boot_patch.sh init_boot.img || exit 1
./magiskboot cleanup
./magiskboot unpack new-boot.img || exit 1
./magiskboot cpio ramdisk.cpio \
  "add 0644 overlay.d/ika-root.rc ika-root.rc" \
  "add 0755 overlay.d/sbin/ika-root.sh ika-root.sh" || exit 1
./magiskboot repack new-boot.img ika-init_boot.img || exit 1
./magiskboot cleanup
rm -f init_boot.img new-boot.img stock_boot.img
EOF
}

# Copies the payload to the guest's staging directory.
push_payload() {
  local payload="$1"

  adb_cmd shell rm -rf "${GUEST_STAGE_DIR}" >/dev/null
  adb_cmd push "${payload}" "${GUEST_STAGE_DIR}" >/dev/null 2>&1 || die "could not copy Magisk to the guest"
}

patch_init_boot() {
  local payload="$1"
  local output="$2"
  local patch_log="${WORK_DIR}/patch.log"

  push_payload "${payload}"
  adb_cmd push "${CVD_PRODUCT_OUT}/init_boot.img" "${GUEST_STAGE_DIR}/init_boot.img" >/dev/null 2>&1 \
    || die "could not copy init_boot.img to the guest"
  log "patching init_boot.img with Magisk..."
  if ! adb_cmd shell sh "${GUEST_STAGE_DIR}/ika-patch.sh" > "${patch_log}" 2>&1; then
    cat "${patch_log}" >&2
    die "Magisk could not patch init_boot.img"
  fi
  adb_cmd pull "${GUEST_STAGE_DIR}/ika-init_boot.img" "${output}" >/dev/null 2>&1 \
    || die "could not copy the patched init_boot.img from the guest"
}

# The setup service removes the staging directory when it has finished.
wait_for_setup() {
  local deadline=$((SECONDS + 120))

  while (( SECONDS < deadline )); do
    if [[ "$(guest_prop init.svc.ika_root)" == "stopped" ]] \
        && ! timeout 10 "${ADB_BIN}" -s "${ADB_SERIAL}" shell "[ -e ${GUEST_STAGE_DIR} ]"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_root() {
  local deadline=$((SECONDS + 120))

  while (( SECONDS < deadline )); do
    if [[ "$(timeout 10 "${ADB_BIN}" -s "${ADB_SERIAL}" shell "su -c 'id -u'" 2>/dev/null | tr -d '\r')" == "0" ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Replaces the stub app that Magisk installs at boot. Retried until it sticks:
# installing fails while Magisk's own install is pending, and Magisk can
# install its stub again afterwards, so the app must stay for 30 seconds.
install_magisk_app() {
  local apk="$1"
  local version="$2"
  local attempt
  local check
  local installed

  log "installing the Magisk app..."
  for attempt in 1 2 3 4 5 6; do
    adb_cmd install -r "${apk}" >/dev/null 2>&1 || true
    for check in 1 2 3 4 5 6; do
      sleep 5
      installed="$(adb_cmd shell dumpsys package com.topjohnwu.magisk \
        | sed -n 's/^ *versionName=//p' | head -n1 | tr -d '\r')"
      [[ "${installed}" == "${version}" ]] || continue 2
    done
    return 0
  done
  log "could not install the Magisk app; Magisk's stub app is installed instead"
}

main() {
  local apk
  local abi
  local payload
  local token
  local patched
  local wipe="false"

  case "${1:-}" in
    -h|--help) usage; return 0 ;;
    "") ;;
    *) usage >&2; return 2 ;;
  esac

  # adb shell forwards stdin to the guest; keep it for confirm_wipe instead.
  exec 4<&0 </dev/null

  [[ -x "${ADB_BIN}" ]] || die "adb not found: ${ADB_BIN}"
  [[ -x "${FASTBOOT_BIN}" ]] || die "fastboot not found: ${FASTBOOT_BIN}"
  [[ -s "${CVD_PRODUCT_OUT}/init_boot.img" ]] || die "init_boot.img not found in ${CVD_PRODUCT_OUT}"
  command -v curl >/dev/null || die "curl is required"
  command -v python3 >/dev/null || die "python3 is required"

  apk="$(fetch_magisk_apk)"
  ensure_vm_booted
  # Only a VM that has not been rooted is still locked.
  if [[ "$(guest_prop ro.boot.vbmeta.device_state)" != "unlocked" ]]; then
    wipe="true"
    confirm_wipe
  fi

  abi="$(guest_prop ro.product.cpu.abi)"
  [[ -n "${abi}" ]] || die "could not read the guest ABI"
  mkdir -p "${CVD_HOME_DIR}/tmp"
  WORK_DIR="$(mktemp -d "${CVD_HOME_DIR}/tmp/ika-root.XXXXXX")"
  trap cleanup EXIT
  payload="${WORK_DIR}/payload"
  patched="${WORK_DIR}/init_boot.img"
  mkdir -p "${payload}"
  token="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  extract_magisk "${apk}" "${abi}" "${payload}"
  write_payload_scripts "${payload}" "${token}"
  printf '%s\n' "${token}" > "${payload}/token"

  patch_init_boot "${payload}" "${patched}"

  if [[ "${wipe}" == "true" ]]; then
    unlock_and_wipe
  fi

  log "rebooting to the bootloader..."
  adb_cmd reboot bootloader
  wait_for_bootloader
  log "flashing the Magisk init_boot..."
  fastboot_cmd flash init_boot "${patched}" || die "could not flash init_boot"
  fastboot_cmd reboot || die "could not reboot from the bootloader"

  wait_for_boot
  log "finishing the Magisk install..."
  push_payload "${payload}"
  adb_cmd shell setprop debug.ika.root "${token}"
  wait_for_setup || die "Magisk's setup did not finish; see 'adb logcat -s Magisk'"

  # Magisk adds su to PATH early in boot, once its files are in /data/adb.
  log "rebooting..."
  adb_cmd reboot
  timeout 120 "${ADB_BIN}" -s "${ADB_SERIAL}" wait-for-disconnect || true
  wait_for_boot
  wait_for_root || die "Magisk did not grant 'adb shell su'; see 'adb logcat -s Magisk'"
  install_magisk_app "${apk}" "$(sed -n "s/^MAGISK_VER='\(.*\)'$/\1/p" "${payload}/util_functions.sh")"
  log "enabling developer options..."
  adb_cmd shell settings put global development_settings_enabled 1 \
    || log "could not enable developer options"

  log "rooted with Magisk $(adb_cmd shell "su -c 'magisk -v'" | tr -d '\r')"
  if [[ "${wipe}" == "true" ]]; then
    "$(ika_bin)" start || log "could not open the console; run 'ika start'"
  fi
}

main "$@"
