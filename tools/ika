confirm() {
  local warning="$1"
  local aborted="$2"
  local reply=""

  printf 'WARNING: %s, type "Y" to continue. ' "${warning}" >&3
  IFS= read -r -n 1 reply || true
  printf '\n' >&3
  if [[ "${reply}" != "Y" && "${reply}" != "y" ]]; then
    respond_console "${aborted}"
    return 1
