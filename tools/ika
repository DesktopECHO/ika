  data_gb_ref=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data_gb=*)
        data_gb_ref="$(normalize_data_gb "${1#*=}")"
        shift
        ;;
      --data_gb)
        shift
        [[ $# -gt 0 ]] || die "--data_gb requires a value"
        data_gb_ref="$(normalize_data_gb "$1")"
        shift
        ;;
      *)
        reset_args_ref+=("$1")
        shift
        ;;
    esac
  done
}

