UDMABUF_DEVICE="/dev/udmabuf"

# crosvm does not start with enable_gpu_udmabuf on a kernel without udmabuf,
# such as Microsoft's WSL2 kernel; gfxstream then uses other memory.
drop_udmabuf_without_device() {
  local -n udmabuf_args_array="$1"

  [[ ! -e "${UDMABUF_DEVICE}" ]] || return 0
  [[ "$(start_arg_value enable_gpu_udmabuf false "${udmabuf_args_array[@]}")" == true ]] || return 0
  set_or_append_start_arg udmabuf_args_array enable_gpu_udmabuf false
  log "this kernel has no ${UDMABUF_DEVICE}: starting with enable_gpu_udmabuf=false"
}

# Fails start before the launcher when this user cannot open a device crosvm
# opens, which crosvm would otherwise report as "Permission denied" seconds
# into the boot, seen only in the start log. WSL2's distributions share one
# kernel and so one /dev: another distribution's udev gives the devices to its
# own kvm or cvdnetwork group, whose ID is another group, or none, here.
# Running this distribution's udev rules for them again gives them back.
check_vm_device_access() {
  local -n device_args_array="$1"
  local -a devices=(/dev/kvm /dev/vhost-vsock)
  local -a denied=()
  local -a sysnames=()
  local device
  local group

  [[ "$(start_arg_value vhost_net false "${device_args_array[@]}")" != true ]] \
    || devices+=(/dev/vhost-net)
  for device in "${devices[@]}"; do
    [[ -e "${device}" ]] || continue
    [[ ! -r "${device}" || ! -w "${device}" ]] || continue
    group="$(stat -c %G "${device}" 2>/dev/null || true)"
    [[ -n "${group}" && "${group}" != UNKNOWN ]] \
      || group="$(stat -c %g "${device}" 2>/dev/null || true), which has no name here"
    log "cannot open ${device}: it belongs to group ${group}, mode $(stat -c %a "${device}" 2>/dev/null || true)"
    denied+=("${device}")
    sysnames+=("--sysname-match=${device#/dev/}")
  done
  [[ "${#denied[@]}" -gt 0 ]] || return 0

  CONSOLE_FAILURE_MESSAGE="Startup Failed: cannot open ${denied[*]}"
  if [[ -d /proc/sys/fs/binfmt_misc/WSLInterop || -n "${WSL_DISTRO_NAME:-}" ]]; then
    CONSOLE_FAILURE_MESSAGE+=" (another WSL distribution's udev likely changed their group)"
  fi
  CONSOLE_FAILURE_MESSAGE+=". To give them back to this distribution's groups, run:
  sudo udevadm trigger --action=add --subsystem-match=misc ${sysnames[*]}"
  die_with_notification "Ika cannot open ${denied[*]}" \
    "cannot open ${denied[*]}; run: sudo udevadm trigger --action=add --subsystem-match=misc ${sysnames[*]}"
}

append_radv_gfxstream_vulkan_args() {
  local -n radv_args_array="$1"

  primary_vulkan_device_is_radv_vega_or_older || return 1
  append_or_merge_gpu_renderer_features \
    radv_args_array "${GFXSTREAM_RADV_VULKAN_RENDERER_FEATURES}"
  log "RADV Vega-or-older gfxstream: using device-only Vulkan memory to avoid AMD host-visible memory corruption"
}

append_gfxstream_vulkan_args() {
  local -n args_array="$1"
  shift
  local mode
  local selected_mode
  local gpu_mode
  local vulkan_decision
  local user_context_types
  local effective_context_types
  local passed_over

  mode="$(normalize_gfxstream_vulkan_mode "${GFXSTREAM_VULKAN_MODE}")"
  GFXSTREAM_VULKAN_MODE="${mode}"

  gpu_mode="$(start_gpu_mode_value "$@")"
  CVD_GPU_MODE="${gpu_mode}"
  if gfxstream_guest_angle_uses_host_vulkan "${gpu_mode}"; then
    CVD_GRAPHICS_DRIVER_MESSAGE="${gpu_mode} (ANGLE over gfxstream Vulkan)"
    log "gfxstream-vulkan=${mode} context toggle has no effect with gpu_mode=${gpu_mode} (Vulkan-only)"
    if append_radv_gfxstream_vulkan_args args_array; then
      CVD_GRAPHICS_DRIVER_MESSAGE="${gpu_mode} (ANGLE over gfxstream Vulkan; RADV device memory)"
    fi
    if is_apple_silicon_16k_host; then
      append_apple_16k_gfxstream_vulkan_args args_array
      CVD_GRAPHICS_DRIVER_MESSAGE="${gpu_mode} (ANGLE over gfxstream Vulkan; Apple 16K udmabuf)"
    fi
    append_host_cached_memory_args args_array
    return 0
  fi

  if [[ "${gpu_mode}" == "venus" ]]; then
    check_venus_gpu_mode
    CVD_GRAPHICS_DRIVER_MESSAGE="venus (ANGLE over Venus Vulkan)"
    log "gfxstream-vulkan=${mode} has no effect with gpu_mode=venus"
    return 0
  fi

  if [[ "${gpu_mode}" != "gfxstream" ]]; then
    CVD_GRAPHICS_DRIVER_MESSAGE="GPU: ${gpu_mode} (gfxstream-vulkan=${mode} ignored)"
    log "gfxstream-vulkan=${mode} has no effect with gpu_mode=${gpu_mode}"
    return 0
  fi

  if user_supplied_flag "gpu_context_types" "$@"; then
    user_context_types="$(merge_gpu_context_types_for_vulkan args_array \
      "${GFXSTREAM_VULKAN_CONTEXT_TYPES}")"
    effective_context_types="$(start_arg_value "gpu_context_types" "${user_context_types}" "${args_array[@]}")"
    CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (user gpu_context_types; gfxstream-vulkan=${mode})"
    log "using user supplied gpu_context_types=${effective_context_types}; gfxstream-vulkan=${mode}"
    if gfxstream_context_types_include_vulkan "${effective_context_types}" \
        && is_apple_silicon_16k_host; then
      append_apple_16k_gfxstream_vulkan_args args_array
    fi
    if gfxstream_context_types_include_vulkan "${effective_context_types}"; then
      append_radv_gfxstream_vulkan_args args_array || true
      append_host_cached_memory_args args_array
    fi
    return 0
  fi

  selected_mode="${mode}"
  vulkan_decision="gfxstream-vulkan=${mode}"
  if [[ "${selected_mode}" == "auto" ]]; then
    if primary_vulkan_device_is_llvmpipe; then
      selected_mode="off"
      vulkan_decision="gfxstream-vulkan=auto -> off (primary Vulkan device is llvmpipe)"
    elif passed_over="$(gfxstream_passes_over_hardware_vulkan)"; then
      selected_mode="off"
      vulkan_decision="gfxstream-vulkan=auto -> off (gfxstream would render with ${passed_over})"
    elif is_apple_silicon_16k_host; then
      append_apple_16k_gfxstream_vulkan_args args_array
      append_host_cached_memory_args args_array
      CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (OpenGL ES + Vulkan, Apple Silicon)"
      log "gfxstream-vulkan=auto; leaving Cuttlefish gfxstream defaults with Apple 16K udmabuf"
      return 0
    else
      append_radv_gfxstream_vulkan_args args_array || true
      append_host_cached_memory_args args_array
      CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (Default settings, vulkan=auto)"
      log "gfxstream-vulkan=auto; leaving Cuttlefish gfxstream defaults"
      return 0
    fi
  fi

  case "${selected_mode}" in
    off)
      args_array+=("--gpu_context_types=${GFXSTREAM_GLES_CONTEXT_TYPES}")
      CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (OpenGL ES)"
      log "${vulkan_decision}; context-types=${GFXSTREAM_GLES_CONTEXT_TYPES}"
      ;;
    on)
      args_array+=("--gpu_context_types=${GFXSTREAM_VULKAN_CONTEXT_TYPES}")
      CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (OpenGL ES + Vulkan; ${vulkan_decision})"
      log "${vulkan_decision}; context-types=${GFXSTREAM_VULKAN_CONTEXT_TYPES}"
      if is_apple_silicon_16k_host; then
        append_apple_16k_gfxstream_vulkan_args args_array
      fi
      append_radv_gfxstream_vulkan_args args_array || true
      append_host_cached_memory_args args_array
      ;;
  esac
}

require_executable() {
  local path="$1"
  local label="$2"
  [[ -x "${path}" ]] || die "${label} not found or not executable: ${path}"
}

instance_has_userdata_state() {
  [[ -e "${CVD_INSTANCE_DIR}/overlay.img" || -e "${CVD_INSTANCE_DIR}/userdata.img" ]]
}

composite_disk_rebuild_reason() {
  local name="$1"
  local disk="${CVD_INSTANCE_DIR}/${name}.img"
  local config="${CVD_INSTANCE_DIR}/${name}_disk_config.txt"
  local component

  if [[ ! -e "${disk}" ]]; then
    printf '%s\n' "${name}.img is missing"
    return 0
  fi

  if [[ ! -e "${config}" ]]; then
    printf '%s\n' "${name}_disk_config.txt is missing"
    return 0
  fi

  while IFS= read -r component; do
    [[ -n "${component}" ]] || continue
    [[ "${component}" != "crosvm" ]] || continue
    [[ -e "${component}" ]] || continue

    if [[ "${component}" -nt "${disk}" ]]; then
      printf '%s\n' "${component} is newer than ${name}.img"
      return 0
    fi
  done < "${config}"

  return 1
}

is_generated_os_component() {
  [[ "$1" == "${CVD_INSTANCE_DIR}/metadata" || "$1" == "${CVD_INSTANCE_DIR}/misc" ]]
}

refresh_generated_os_component_mtimes() {
  local disk="${CVD_INSTANCE_DIR}/os_composite.img"
  local config="${CVD_INSTANCE_DIR}/os_composite_disk_config.txt"
  local overlay="${CVD_INSTANCE_DIR}/overlay.img"
  local component
  local path
  local needs_refresh="false"

  [[ -e "${overlay}" && -e "${disk}" && -e "${config}" ]] || return 0

  while IFS= read -r component; do
    [[ -n "${component}" ]] || continue
    [[ "${component}" != "crosvm" ]] || continue
    [[ -e "${component}" ]] || continue
    [[ "${component}" -nt "${disk}" ]] || continue

    if ! is_generated_os_component "${component}"; then
      return 0
    fi

    needs_refresh="true"
  done < "${config}"

  [[ "${needs_refresh}" == "true" ]] || return 0

  for path in \
    "${disk}" \
    "${CVD_INSTANCE_DIR}/os_composite_gpt_header.img" \
    "${CVD_INSTANCE_DIR}/os_composite_gpt_footer.img"; do
    [[ -e "${path}" ]] && touch "${path}" 2>/dev/null || true
  done
  touch "${overlay}" 2>/dev/null || true
}

protect_overlay_resume() {
  local reason

  [[ -e "${CVD_INSTANCE_DIR}/overlay.img" ]] || return 0

  refresh_generated_os_component_mtimes

  if reason="$(composite_disk_rebuild_reason os_composite)"; then
    respond_console "Refusing to start because Cuttlefish would rebuild the OS disk and discard VM data."
    respond_console "Reason: ${reason}"
    respond_console "Run '${SCRIPT_NAME} reset' if you want to discard the current VM data."
    die "refusing to discard overlay.img: ${reason}"
  fi

  if [[ -e "${CVD_INSTANCE_DIR}/ap_composite.img" ]] \
      && reason="$(composite_disk_rebuild_reason ap_composite)"; then
    respond_console "Refusing to start because Cuttlefish would rebuild the AP disk and discard VM data."
    respond_console "Reason: ${reason}"
    respond_console "Run '${SCRIPT_NAME} reset' if you want to discard the current VM data."
    die "refusing to discard overlay.img: ${reason}"
  fi
}

append_data_storage_args() {
  local -n args_array="$1"
  shift
  local configured_data_gb=""
  local data_gb
  local data_mb
  local has_existing_userdata_state="false"
  local explicit_data_policy="false"
  local explicit_data_size="false"

  if user_supplied_flag "data_policy" "$@"; then
    explicit_data_policy="true"
  fi
  if user_supplied_flag "blank_data_image_mb" "$@"; then
    explicit_data_size="true"
  fi

  if instance_has_userdata_state; then
    has_existing_userdata_state="true"
  fi

  if [[ "${explicit_data_policy}" != "true" && "${has_existing_userdata_state}" == "true" ]]; then
    return 0
  fi

  if [[ -s "${DATA_GB_CONFIG_FILE}" ]]; then
    IFS= read -r configured_data_gb < "${DATA_GB_CONFIG_FILE}"
    configured_data_gb="$(normalize_data_gb "${configured_data_gb}")"
  fi

  data_gb="${configured_data_gb:-${DEFAULT_DATA_GB}}"
  data_mb="$(data_gb_to_mib "${data_gb}")"

  if [[ "${explicit_data_policy}" != "true" ]]; then
    args_array+=("--data_policy=always_create")
  fi

  if [[ "${explicit_data_size}" != "true" ]]; then
    args_array+=("--blank_data_image_mb=${data_mb}")
  fi

  if [[ -n "${configured_data_gb}" ]]; then
    CVD_DATA_STORAGE_MESSAGE="Provisioning ${data_gb} GB userdata..."
    log "fresh userdata target: ${data_mb} MiB"
  fi
}

apply_default_args() {
  local -n config_map="$1"
  local -n args_array="$2"
  shift 2
  local key value

  for key in "${!config_map[@]}"; do
    if ! user_supplied_flag "${key}" "$@"; then
      value="${config_map[${key}]}"
      # Handle special case for report_anonymous_usage_stats which uses single dash
      if [[ "${key}" == "report_anonymous_usage_stats" ]]; then
        args_array+=("-${key}=${value}")
      else
        args_array+=("--${key}=${value}")
      fi
    fi
  done
}

# Gives the device its own serial number, generated on first start and kept
# across updates and factory resets, instead of Cuttlefish's CUTTLEFISHCVD01,
# which is the same on every install. Letters and digits only: GMS check-in
# rejects other serials.
append_serial_number_args() {
  local -n args_array="$1"
  shift
  local serial=""

  if user_supplied_flag "serial_number" "$@" \
      || user_supplied_flag "use_random_serial" "$@"; then
    return 0
  fi

  if [[ -s "${SERIAL_NUMBER_FILE}" ]]; then
    IFS= read -r serial < "${SERIAL_NUMBER_FILE}" || true
  fi
  if [[ ! "${serial}" =~ ^[A-Z0-9]+$ ]]; then
    serial="$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n' | tr 'a-f' 'A-F')"
    printf '%s\n' "${serial}" > "${SERIAL_NUMBER_FILE}"
    log "generated device serial number ${serial}"
  fi
  args_array+=("--serial_number=${serial}")
}

apply_start_default_args() {
  local args_array_name="$1"
  shift
  local config_map

  for config_map in "${CVD_DEFAULT_ARG_MAPS[@]}"; do
    apply_default_args "${config_map}" "${args_array_name}" "$@"
  done
}

append_cuttlefish_audio_args() {
  local -n args_array="$1"
  shift

  if ! user_supplied_flag "enable_audio" "$@"; then
    args_array+=("--enable_audio=true")
    log "enabling Cuttlefish virtio-snd audio server"
  fi
}

host_timezone() {
  command -v timedatectl >/dev/null 2>&1 || return 0
  timedatectl show --property=Timezone --value 2>/dev/null || true
}

# Prints "dark" or "light" for Windows' app mode (Settings, Personalization,
# Colors), or fails without Windows interop
windows_color_scheme() {
  local reg
  local value

  reg="$(command -v reg.exe || true)"
  [[ -n "${reg}" ]] || reg="/mnt/c/Windows/System32/reg.exe"
  [[ -x "${reg}" ]] || return 1
  value="$(with_timeout 5 "${reg}" query 'HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize' \
    /v AppsUseLightTheme 2>/dev/null | tr -d '\r' | awk '$1 == "AppsUseLightTheme" { print $3 }')"
  case "${value}" in
    0x0) printf 'dark\n' ;;
    0x1) printf 'light\n' ;;
    *) return 1 ;;
  esac
}

# Prints "dark" or "light" for the desktop's color scheme, or nothing when it
# states no preference. Reads the freedesktop Settings portal, which ika-scrcpy
# window title bars follow too, then GNOME's setting. On WSLg, whose windows sit
# on the Windows desktop, Windows' app mode comes first.
host_color_scheme() {
  local value=""

  if [[ "${IKA_ON_WSLG}" == true ]] && windows_color_scheme; then
    return 0
  fi

  if command -v gdbus >/dev/null 2>&1; then
    value="$(with_timeout 3 gdbus call --session \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop \
        --method org.freedesktop.portal.Settings.Read \
        org.freedesktop.appearance color-scheme 2>/dev/null \
      | grep -oE 'uint32 [0-9]+' | awk '{ print $2 }' || true)"
  fi
  if [[ -z "${value}" ]] && command -v gsettings >/dev/null 2>&1; then
    case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
      "'prefer-dark'") value=1 ;;
      "'prefer-light'") value=2 ;;
    esac
  fi

  case "${value}" in
    1) printf 'dark\n' ;;
    2) printf 'light\n' ;;
  esac
}

append_bootconfig_args() {
  local -n args_array="$1"
  local tz
  local bootconfig_value=""

  tz="$(host_timezone)"
  if [[ -n "${tz}" ]]; then
    bootconfig_value="androidboot.timezone=\"${tz}\" androidboot.cuttlefish_service_bluetooth_checker=false"
    log "timezone: ${tz}"
  fi

  if is_user_build; then
    [[ -n "${USER_ADB_PUBLIC_KEY_VALUE:-}" ]] || {
      log "public ADB key was not prepared for ${USER_ADB_PRIVATE_KEY}"
      return 1
    }
    bootconfig_value+="${bootconfig_value:+ }androidboot.ika.adb_pubkey=${USER_ADB_PUBLIC_KEY_VALUE}"
  fi

  [[ -n "${bootconfig_value}" ]] || return 0
  args_array+=("--extra_bootconfig_args=${bootconfig_value}")
}

append_cvd_env_args() {
  local -n env_args_ref="$1"
  local config_path="${2:-}"
  local glibc_tunables
  local radv_debug
  local adb_vendor_keys

  env_args_ref+=(
    "HOME=${CVD_HOME_DIR}"
    "TMPDIR=${CVD_TMP_DIR}"
    "ANDROID_HOST_OUT=${CVD_HOST_OUT}"
    "ANDROID_SOONG_HOST_OUT=${CVD_HOST_OUT}"
    "ANDROID_PRODUCT_OUT=${CVD_PRODUCT_OUT}"
  )

  if is_user_build; then
    adb_vendor_keys="${USER_ADB_PRIVATE_KEY}"
    [[ -n "${ADB_VENDOR_KEYS:-}" ]] && adb_vendor_keys+=":${ADB_VENDOR_KEYS}"
    env_args_ref+=("ADB_VENDOR_KEYS=${adb_vendor_keys}")
  fi

  # gfxstream creates its host EGL display without a window-system surface.
  # Selecting this explicitly also avoids inheriting a broken/unavailable X11
  # platform from SSH sessions on headless and Apple Silicon hosts.
  if [[ "${CVD_GPU_MODE}" == gfxstream* ]]; then
    env_args_ref+=("EGL_PLATFORM=${EGL_PLATFORM:-surfaceless}")
  fi

  # RADV's default asynchronous shader compilation can report fence completion
  # before a transform-feedback pipeline has finished compiling. Gfxstream can
  # then execute an incomplete pipeline, producing intermittent missing
  # primitives even though the associated query result is correct. Compile
  # shaders synchronously for gfxstream on RADV, while preserving any options
  # supplied by the caller. Other Vulkan drivers are left unchanged.
  if [[ "${CVD_GPU_MODE}" == gfxstream* ]] && primary_vulkan_device_is_radv; then
    radv_debug="$(append_comma_option "${RADV_DEBUG:-}" "syncshaders")"
    env_args_ref+=("RADV_DEBUG=${radv_debug}")
    log "RADV gfxstream correctness options: ${radv_debug}"
  fi

  # gfxstream creates many short-lived render threads. On glibc's default
  # arena policy, allocations freed during guest graphics-process cleanup can
  # remain resident in dozens of per-thread arenas. This is especially costly
  # on the Apple 16K udmabuf path, where Asphalt otherwise leaves hundreds of
  # MiB of free allocator pages resident after each launch. Cap the arena count
  # and retain any caller-provided tunables.
  if [[ "${CVD_GPU_MODE}" == gfxstream* ]] && is_apple_silicon_16k_host; then
    glibc_tunables="${GLIBC_TUNABLES:-}"
    if [[ ":${glibc_tunables}:" != *":glibc.malloc.arena_max="* ]]; then
      glibc_tunables="${glibc_tunables:+${glibc_tunables}:}glibc.malloc.arena_max=4"
    fi
    if [[ ":${glibc_tunables}:" != *":glibc.malloc.trim_threshold="* ]]; then
      glibc_tunables="${glibc_tunables:+${glibc_tunables}:}glibc.malloc.trim_threshold=131072"
    fi
    env_args_ref+=("GLIBC_TUNABLES=${glibc_tunables}")
    log "Apple Silicon gfxstream allocator tunables: ${glibc_tunables}"
  fi

  if [[ -n "${config_path}" ]]; then
    env_args_ref+=("CUTTLEFISH_CONFIG_FILE=${config_path}")
  fi
}

run_with_cvd_env() {
  local config_path=""
  local -a env_args=(env)

  if [[ "${1:-}" == "--config" ]]; then
    config_path="${2:-}"
    shift 2
  fi

  append_cvd_env_args env_args "${config_path}"
  "${env_args[@]}" "$@"
}

run_stop_helper() {
  local status

  set +e
  run_with_cvd_env "$@" >/dev/null 2>&1
  status="$?"
  set -e

  return "${status}"
}

has_session_group() {
  id -nG | tr ' ' '\n' | grep -Fxq "$1"
}

has_configured_group() {
  id -nG "${USER}" | tr ' ' '\n' | grep -Fxq "$1"
}

check_required_groups() {
  local -a required_groups=(kvm video render cvdnetwork)
  local -a missing_groups=()
  local -a inactive_groups=()
  local -a add_groups=()
  local group

  for group in "${required_groups[@]}"; do
    if getent group "${group}" >/dev/null 2>&1 && ! has_session_group "${group}"; then
      missing_groups+=("${group}")
      if has_configured_group "${group}"; then
        inactive_groups+=("${group}")
      else
        add_groups+=("${group}")
      fi
    fi
  done

  if [[ "${#missing_groups[@]}" -eq 0 ]]; then
    return 0
  fi

  cat <<EOF
[${SCRIPT_NAME}] error: current shell is missing required groups.

Active groups:
  $(id -nG)

Missing groups:
  ${missing_groups[*]}

EOF

  if [[ "${#add_groups[@]}" -gt 0 ]]; then
    cat <<EOF
To add the missing account membership:
  pkexec /usr/libexec/cuttlefish/cuttlefish-add-user-to-groups

EOF
  fi

  if [[ "${#inactive_groups[@]}" -gt 0 ]]; then
    cat <<EOF
Configured on the account but not active in this login session:
  ${inactive_groups[*]}

EOF
  fi

  cat <<EOF

Log out fully and back in after updating group membership.
EOF
  exit 1
}

resolve_adb_serial() {
  local adb_ip_and_port=""
  local vsock_cid=""

  if [[ -f "${CVD_CONFIG_PATH}" ]]; then
    if grep -q '"native_vsock"' "${CVD_CONFIG_PATH}"; then
      vsock_cid="$(grep -oE '"vsock_guest_cid"[[:space:]]*:[[:space:]]*[0-9]+' "${CVD_CONFIG_PATH}" | head -n1 | grep -oE '[0-9]+$' || true)"
      if [[ -n "${vsock_cid}" ]] && (( vsock_cid > 2 )); then
        printf 'vsock:%s:5555\n' "${vsock_cid}"
        return 0
      fi
    fi
    adb_ip_and_port="$(grep -oE '"adb_ip_and_port"[[:space:]]*:[[:space:]]*"[^"]+"' "${CVD_CONFIG_PATH}" | head -n1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
  fi

  case "${adb_ip_and_port:-127.0.0.1:6520}" in
    0.0.0.0:*)
      printf '127.0.0.1:%s\n' "${adb_ip_and_port#*:}"
      ;;
    '[::]':*)
      printf '127.0.0.1:%s\n' "${adb_ip_and_port##*:}"
      ;;
    *)
      printf '%s\n' "${adb_ip_and_port:-127.0.0.1:6520}"
      ;;
  esac
}

resolve_cuttlefish_frames_socket() {
  local frame_sock_path=""
  local socket_path

  if [[ -f "${CVD_CONFIG_PATH}" ]]; then
    frame_sock_path="$(grep -oE '"frame_sock_path"[[:space:]]*:[[:space:]]*"[^"]+"' "${CVD_CONFIG_PATH}" | head -n1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
  fi

  if [[ -n "${frame_sock_path}" ]]; then
    socket_path="$(dirname "${frame_sock_path}")/ika_frames.sock"
  else
    socket_path="/tmp/cf_avd_${UID}/cvd-1/internal/ika_frames.sock"
  fi

  printf '%s\n' "${socket_path}"
}

has_live_cvd_processes() {
  pgrep -f "${CVD_PROCESS_REGEX}" >/dev/null 2>&1
}

stop_dnsmasq() {
  local pid_file
  for pid_file in /var/tmp/cvd/cuttlefish-dnsmasq-*.pid /var/run/cuttlefish-dnsmasq-*.pid; do
    [[ -f "${pid_file}" ]] || continue
    kill "$(cat "${pid_file}")" 2>/dev/null || true
    rm -f "${pid_file}"
    rm -f "${pid_file%.pid}.leases"
  done
  pkill -f 'dnsmasq.*cvd-' 2>/dev/null || true
}

cleanup_user_processes() {
  local -a pids=()
  local -a survivors=()
  local any_survivor
  local deadline
  local pid

  while read -r pid; do
    [[ -n "${pid}" ]] || continue
    [[ "${pid}" == "$$" ]] && continue
    pids+=("${pid}")
  done < <(pgrep -f "${CVD_PROCESS_REGEX}" || true)

  if [[ "${#pids[@]}" -eq 0 ]]; then
    return 0
  fi

  mapfile -t pids < <(printf '%s\n' "${pids[@]}" | sort -u)
  log "stopping leftover Cuttlefish processes: ${pids[*]}"
  kill "${pids[@]}" 2>/dev/null || true

  # SECONDS has one-second resolution. Add one tick so the configured grace
  # period is never shortened by entering this loop partway through a tick.
  deadline=$((SECONDS + IKA_STOP_GRACE_SEC + 1))
  while (( SECONDS < deadline )); do
    survivors=()
    for pid in "${pids[@]}"; do
      if cvd_pid_is_alive "${pid}"; then
        survivors+=("${pid}")
      fi
    done
    if [[ "${#survivors[@]}" -eq 0 ]]; then
      return 0
    fi
    sleep 0.2
  done

  survivors=()
  for pid in "${pids[@]}"; do
    if cvd_pid_is_alive "${pid}"; then
      survivors+=("${pid}")
    fi
  done
  if [[ "${#survivors[@]}" -gt 0 ]]; then
    log "Cuttlefish processes did not exit within ${IKA_STOP_GRACE_SEC}s; forcing termination: ${survivors[*]}"
    kill -9 "${survivors[@]}" 2>/dev/null || true

    deadline=$((SECONDS + 6))
    while (( SECONDS < deadline )); do
      any_survivor="false"
      for pid in "${survivors[@]}"; do
        if cvd_pid_is_alive "${pid}"; then
          any_survivor="true"
          break
        fi
      done
      [[ "${any_survivor}" == "true" ]] || return 0
      sleep 0.2
    done
  fi
}

cvd_pid_is_alive() {
  local pid="$1"
  local command_line
  local state

  [[ -r "/proc/${pid}/stat" ]] || return 1
  state="$(awk '{ print $3 }' "/proc/${pid}/stat" 2>/dev/null || true)"
  [[ -n "${state}" && "${state}" != "Z" ]] || return 1

  command_line="$(tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null || true)"
  [[ "${command_line}" =~ ${CVD_PROCESS_REGEX} ]]
}

normalize_stop_grace_seconds() {
  if [[ ! "${IKA_STOP_GRACE_SEC}" =~ ^[1-9][0-9]*$ ]]; then
    die "IKA_STOP_GRACE_SEC must be a positive whole number of seconds"
  fi
}

read_udmabuf_snapshot() {
  local bufinfo="/sys/kernel/debug/dma_buf/bufinfo"
  local contents

  # Some Asahi kernels can retain imported udmabufs after an unclean renderer
  # exit. Keep this probe advisory: failure to read debugfs must never prevent
  # the VM from starting or stopping.
  if [[ -r "${bufinfo}" ]]; then
    contents="$(<"${bufinfo}")"
  elif command -v sudo >/dev/null 2>&1; then
    contents="$(sudo -n cat "${bufinfo}" 2>/dev/null)" || return 1
  else
    return 1
  fi

  awk '$5 == "udmabuf" && $1 ~ /^[0-9]+$/ { count++; bytes += $1 }
       END { printf "%d %.0f\n", count, bytes }' <<<"${contents}"
}

record_udmabuf_baseline() {
  local snapshot

  host_is_apple_silicon || return 0

  snapshot="$(read_udmabuf_snapshot || true)"
  [[ "${snapshot}" =~ ^[0-9]+\ [0-9]+$ ]] || return 0

  printf '%s\n' "${snapshot}" >"${UDMABUF_BASELINE_FILE}"
  log "Asahi udmabuf baseline: $(format_udmabuf_snapshot "${snapshot}")"
}

format_udmabuf_bytes() {
  local bytes="$1"

  if command -v numfmt >/dev/null 2>&1; then
    numfmt --to=iec-i --suffix=B "${bytes}" 2>/dev/null || printf '%s bytes\n' "${bytes}"
  else
    printf '%s bytes\n' "${bytes}"
  fi
}

format_udmabuf_snapshot() {
  local snapshot="$1"
  local count bytes

  read -r count bytes <<<"${snapshot}"
  printf '%s object(s), %s' "${count}" "$(format_udmabuf_bytes "${bytes}")"
}

report_udmabuf_leaks() {
  local baseline
  local current
  local baseline_count baseline_bytes
  local current_count current_bytes
  local leaked_count leaked_bytes

  host_is_apple_silicon || return 0

  [[ -r "${UDMABUF_BASELINE_FILE}" ]] || return 0
  baseline="$(<"${UDMABUF_BASELINE_FILE}")"
  current="$(read_udmabuf_snapshot || true)"
  [[ "${baseline}" =~ ^[0-9]+\ [0-9]+$ ]] || return 0
  [[ "${current}" =~ ^[0-9]+\ [0-9]+$ ]] || return 0

  read -r baseline_count baseline_bytes <<<"${baseline}"
  read -r current_count current_bytes <<<"${current}"
  leaked_count=$((current_count - baseline_count))
  leaked_bytes=$((current_bytes - baseline_bytes))

  if (( leaked_count > 0 || leaked_bytes > 0 )); then
    (( leaked_count > 0 )) || leaked_count=0
    (( leaked_bytes > 0 )) || leaked_bytes=0
    log_file_only "WARNING: Asahi retained ${leaked_count} udmabuf object(s) ($(format_udmabuf_bytes "${leaked_bytes}")) after Cuttlefish stopped. Kernels without the deferred drm_gpuvm_bo cleanup fix (AsahiLinux/linux#548) need a host reboot to reclaim kernel-pinned memory."
  else
    log_file_only "Asahi udmabuf usage returned to baseline: $(format_udmabuf_snapshot "${current}")"
  fi
}

within_deadline() {
  local deadline="$1"
  [[ "${deadline}" -eq 0 || ${SECONDS} -lt ${deadline} ]]
}

make_deadline() {
  local timeout_sec="$1"
  if [[ "${timeout_sec}" -gt 0 ]]; then
    printf '%s\n' "$((SECONDS + timeout_sec))"
  else
    printf '0\n'
  fi
}

resolve_adb_bin() {
  if [[ -x "${CVD_ADB_BIN}" ]]; then
    printf '%s\n' "${CVD_ADB_BIN}"
  else
    command -v adb || true
  fi
}

is_user_build() {
  [[ "${CVD_BUILD_VARIANT}" == "user" ]]
}

prepare_user_adb_key() {
  is_user_build || return 0

  local adb_bin
  local public_key_tmp
  local public_key
  mkdir -p "${HOST_HOME}/.android" || return 1
  adb_bin="$(resolve_adb_bin)"
  [[ -n "${adb_bin}" ]] || {
    log "adb is required to provision the user ADB key"
    return 1
  }

  if [[ ! -s "${USER_ADB_PRIVATE_KEY}" ]]; then
    "${adb_bin}" keygen "${USER_ADB_PRIVATE_KEY}" >/dev/null || {
      log "could not generate the user ADB key: ${USER_ADB_PRIVATE_KEY}"
      return 1
    }
  fi
  public_key="$("${adb_bin}" pubkey "${USER_ADB_PRIVATE_KEY}")" || {
    log "could not derive the public user ADB key: ${USER_ADB_PRIVATE_KEY}"
    return 1
  }
  USER_ADB_PUBLIC_KEY_VALUE="${public_key%% *}"
  [[ -n "${USER_ADB_PUBLIC_KEY_VALUE}" ]] || {
    log "adb returned an empty public key for ${USER_ADB_PRIVATE_KEY}"
    return 1
  }
  if ! printf '%s\n' "${public_key}" | cmp -s - "${USER_ADB_PUBLIC_KEY}"; then
    public_key_tmp="$(mktemp "${USER_ADB_PUBLIC_KEY}.XXXXXX")" || return 1
    if ! printf '%s\n' "${public_key}" > "${public_key_tmp}"; then
      rm -f "${public_key_tmp}"
      return 1
    fi
    mv -f "${public_key_tmp}" "${USER_ADB_PUBLIC_KEY}"
  fi
  chmod 600 "${USER_ADB_PRIVATE_KEY}" || return 1
  chmod 644 "${USER_ADB_PUBLIC_KEY}" || return 1
}

host_adb() {
  local timeout_seconds="$1"
  shift
  local adb_bin

  adb_bin="$(resolve_adb_bin)"
  [[ -n "${adb_bin}" ]] || return 1
  with_timeout "${timeout_seconds}" "${adb_bin}" "$@"
}

# Drops the guest's adb transport once the VM has stopped. Otherwise the adb
# server keeps reconnecting to it about four times a second until the VM
# starts again. Starts no adb server when none is running.
disconnect_guest_adb() {
  local adb_serial="$1"

  pgrep -u "${UID}" -f '(^|/)adb .*fork-server server' >/dev/null 2>&1 || return 0
  host_adb 5 disconnect "${adb_serial}" >/dev/null 2>&1 || true
}

# Prints an epoch time in a date(1) format, with GNU or BSD date.
format_epoch() {
  date -d "@$1" "+$2" 2>/dev/null || date -r "$1" "+$2"
}

# Drops the lines of a log before line $2, or all of them when $2 is empty.
# The file is rewritten in place, so a process that keeps it open for
# appending goes on writing to it; lines written during the rewrite may be
# lost.
drop_log_lines_before() {
  local log_file="$1"
  local first_kept="$2"
  local kept

  [[ "${first_kept}" != "1" ]] || return 0
  if [[ -z "${first_kept}" ]]; then
    : > "${log_file}" || true
    return 0
  fi
  kept="$(mktemp "${log_file}.XXXXXX")" || return 0
  if tail -n "+${first_kept}" "${log_file}" > "${kept}"; then
    cat "${kept}" > "${log_file}" || true
  fi
  rm -f "${kept}"
}

# ikastart.log and madbfs.log keep this many of their last lines.
readonly LOG_MAX_LINES=1000

# Keeps the last LOG_MAX_LINES lines of a log.
trim_log_lines() {
  local log_file="$1"
  local line_count

  [[ -s "${log_file}" ]] || return 0
  line_count="$(wc -l <"${log_file}" 2>/dev/null || true)"
  line_count="${line_count//[[:space:]]/}"
  [[ "${line_count}" =~ ^[0-9]+$ ]] || return 0
  (( line_count > LOG_MAX_LINES )) || return 0
  drop_log_lines_before "${log_file}" "$(( line_count - LOG_MAX_LINES + 1 ))"
}

# Keeps the last 24 hours of the adb server's log. The server outlives VM
# restarts and never trims its log, which grows by about 1 MB a day from
# adb_connector's checks every 5 seconds; a running server keeps the file open
# for appending.
trim_adb_server_log() {
  local log_file="${ADB_SERVER_LOG}"
  local cutoff
  local first_kept

  [[ -s "${log_file}" ]] || return 0
  cutoff="$(( $(date +%s) - 86400 ))"
  # Lines start with "MM-DD HH:MM:SS.mmm", without the year: a line is recent
  # when it is from today, or from yesterday at or after the cutoff time.
  first_kept="$(awk -v yesterday="$(format_epoch "${cutoff}" '%m-%d')" \
      -v cutoff_time="$(format_epoch "${cutoff}" '%H:%M:%S')" \
      -v today="$(date +%m-%d)" '
    { day = substr($0, 1, 5) }
    day == today || (day == yesterday && substr($0, 7, 8) >= cutoff_time) {
      print NR
      exit
    }' "${log_file}" || true)"
  drop_log_lines_before "${log_file}" "${first_kept}"
}

adb_boot_completed() {
  local adb_serial="$1"
  local boot_completed

  # timeout guards against the dead-guest host proxy accepting the connection
  # and never answering, which would stall wait_for_boot's poll loop.
  boot_completed="$(host_adb 5 -s "${adb_serial}" shell getprop sys.boot_completed 2>/dev/null \
    | tr -d '\r' || true)"
  [[ "${boot_completed}" == "1" ]]
}

# True once Android has shown its first frame (SurfaceFlinger's
# sf_stop_bootanim event), seconds before sys.boot_completed on slow hosts.
adb_first_frame_shown() {
  local output

  output="$(host_adb 5 -s "$1" shell 'getprop sys.boot_completed; logcat -b events -d -m 1 -s sf_stop_bootanim' \
    2>/dev/null | tr -d '\r' || true)"
  [[ "${output}" == 1* || "${output}" == *sf_stop_bootanim* ]]
}

# Prints the mode Android booted in, tv or desktop, or nothing when the guest
# does not answer. Android's mode is switched by IkaMode's Desktop/TV entry
# and takes effect at boot, when TV mode adds the leanback feature.
guest_ui_mode() {
  local adb_serial="$1"
  local leanback

  leanback="$(guest_shell_query "${adb_serial}" "${GUEST_QUERY_LEANBACK}")"
  case "${leanback}" in
    true) printf 'tv\n' ;;
    false) printf 'desktop\n' ;;
  esac
  return 0
}

adb_guest_boot_id() {
  local adb_serial="$1"
  local boot_id

  boot_id="$(host_adb 5 -s "${adb_serial}" shell cat /proc/sys/kernel/random/boot_id 2>/dev/null \
    | tr -d '\r' || true)"
  [[ "${boot_id}" =~ ^[0-9a-fA-F-]{36}$ ]] || return 1
  printf '%s\n' "${boot_id}"
}

read_scrcpy_window_state() {
  local state_file="$1"
  local -n width_ref="$2"
  local -n height_ref="$3"
  local -n fullscreen_ref="$4"
  local key
  local value
  local version=""
  local width=""
  local height=""
  local fullscreen=""

  [[ -f "${state_file}" ]] || return 1
  while IFS='=' read -r key value; do
    case "${key}" in
      version) version="${value}" ;;
      width) width="${value}" ;;
      height) height="${value}" ;;
      fullscreen) fullscreen="${value}" ;;
    esac
  done < "${state_file}"

  [[ "${version}" == "1" ]] || return 1
  [[ "${width}" =~ ^[1-9][0-9]*$ && "${width}" -le 65535 ]] || return 1
  [[ "${height}" =~ ^[1-9][0-9]*$ && "${height}" -le 65535 ]] || return 1
  [[ "${fullscreen}" == "true" || "${fullscreen}" == "false" ]] || return 1

  width_ref="${width}"
  height_ref="${height}"
  fullscreen_ref="${fullscreen}"
}

# The window state file of the console of MODE, desktop or tv.
mode_console_window_state_file() {
  case "$1" in
    tv) printf '%s\n' "${TV_CONSOLE_WINDOW_STATE_FILE}" ;;
    *) printf '%s\n' "${DESKTOP_CONSOLE_WINDOW_STATE_FILE}" ;;
  esac
}

# Sets the array named by $1 to the options of the 'ika start' that opens the
# console after Android restarted in MODE ($2): --fullscreen when that mode's
# console was last used fullscreen, so that a mode switch brings each console
# back as it was. Its size comes from the same file when the console starts.
console_switch_start_options() {
  local -n options_ref="$1"
  local mode="$2"
  local saved_width=""
  local saved_height=""
  local saved_fullscreen=""

  options_ref=()
  if read_scrcpy_window_state "$(mode_console_window_state_file "${mode}")" \
      saved_width saved_height saved_fullscreen \
      && [[ "${saved_fullscreen}" == "true" ]]; then
    options_ref+=(--fullscreen)
  fi
}

wait_for_guest_reboot() {
  local adb_serial="$1"
  local previous_boot_id="$2"
  local timeout_sec="$3"
  local deadline
  local current_boot_id

  deadline=$((SECONDS + timeout_sec))
  while (( SECONDS < deadline )); do
    has_live_cvd_processes || return 1
    current_boot_id="$(adb_guest_boot_id "${adb_serial}" || true)"
    # An adb reconnect alone can be transient. A new kernel boot ID followed
    # by Android boot completion proves that this was an actual guest reboot.
    if [[ -n "${current_boot_id}" \
        && "${current_boot_id}" != "${previous_boot_id}" ]] \
        && adb_boot_completed "${adb_serial}"; then
      printf '%s\n' "${current_boot_id}"
      return 0
    fi
    sleep 0.5
  done
  return 1
}

# Windows' PowerShell, through WSL's interop; fails without it
windows_powershell() {
  local powershell

  powershell="$(command -v powershell.exe || true)"
  [[ -n "${powershell}" ]] || powershell="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
  [[ -x "${powershell}" ]] || return 1
  printf '%s\n' "${powershell}"
}

# WSLg gives each window the relaunch command C:\Program Files\WSL\\wslg.exe
# ... without quotes, so a task bar pin made from the window starts
# "C:\Program" and Windows offers to delete it. This repairs such pins, under
# the user's "User Pinned" folder: the target becomes wslg.exe, and the pin
# keeps the window's app ID, which puts the window on the pin's button. It also
# removes the shortcuts Windows made for WSLg windows of a distribution that is
# no longer registered: the app ID leaves the distribution out, so Ika's window
# in another one would show that distribution's name, missing icon and command.
# It runs in the background, when a window closes (after the user may have
# pinned it) and at start, and does nothing outside WSLg.
repair_wslg_taskbar_pins() {
  local powershell

  [[ "${IKA_ON_WSLG}" == true ]] || return 0
  powershell="$(windows_powershell)" || return 0
  mkdir -p "${CVD_TMP_DIR}"
  (
    flock -n 9 || exit 0
    with_timeout 60 "${powershell}" -NoProfile -NonInteractive -ExecutionPolicy Bypass \
      -EncodedCommand "$(wslg_pin_repair_script | iconv -t UTF-16LE | base64 -w 0)" \
      </dev/null 2>/dev/null | tr -d '\r' | while IFS= read -r line; do
        [[ -n "${line}" ]] && log "${line}"
      done
  ) 9>"${CVD_TMP_DIR}/wslg-pins.lock" &
  disown "$!" 2>/dev/null || true
}

# Prints the PowerShell program of repair_wslg_taskbar_pins: one line per pin
# it repaired.
wslg_pin_repair_script() {
  cat <<'EOF'
[Console]::OutputEncoding = [Text.Encoding]::UTF8
Add-Type @"
using System; using System.Text; using System.Runtime.InteropServices; using System.Runtime.InteropServices.ComTypes;
[ComImport, Guid("000214F9-0000-0000-C000-000000000046"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
public interface IShellLinkW {
  void GetPath([Out, MarshalAs(UnmanagedType.LPWStr)] StringBuilder f, int n, IntPtr fd, uint fl); void GetIDList(out IntPtr p); void SetIDList(IntPtr p);
  void GetDescription([Out, MarshalAs(UnmanagedType.LPWStr)] StringBuilder s, int n); void SetDescription([MarshalAs(UnmanagedType.LPWStr)] string s);
  void GetWorkingDirectory([Out, MarshalAs(UnmanagedType.LPWStr)] StringBuilder s, int n); void SetWorkingDirectory([MarshalAs(UnmanagedType.LPWStr)] string s);
  void GetArguments([Out, MarshalAs(UnmanagedType.LPWStr)] StringBuilder s, int n); void SetArguments([MarshalAs(UnmanagedType.LPWStr)] string s);
  void GetHotkey(out short h); void SetHotkey(short h); void GetShowCmd(out int c); void SetShowCmd(int c);
  void GetIconLocation([Out, MarshalAs(UnmanagedType.LPWStr)] StringBuilder s, int n, out int i); void SetIconLocation([MarshalAs(UnmanagedType.LPWStr)] string s, int i);
  void SetRelativePath([MarshalAs(UnmanagedType.LPWStr)] string s, uint r); void Resolve(IntPtr h, uint f);
  void SetPath([MarshalAs(UnmanagedType.LPWStr)] string s); }
public static class IkaPin {
  public static bool Repair(string file) {
    IShellLinkW l = (IShellLinkW)Activator.CreateInstance(Type.GetTypeFromCLSID(new Guid("00021401-0000-0000-C000-000000000046")));
    IPersistFile pf = (IPersistFile)l; pf.Load(file, 2);
    StringBuilder p = new StringBuilder(1024), a = new StringBuilder(4096);
    l.GetPath(p, p.Capacity, IntPtr.Zero, 0x4); l.GetArguments(a, a.Capacity);
    string cmd = p.ToString() + " " + a.ToString();
    int i = cmd.IndexOf(@"\wslg.exe ", StringComparison.OrdinalIgnoreCase);
    if (!p.ToString().Equals(@"C:\Program", StringComparison.OrdinalIgnoreCase) || !a.ToString().StartsWith(@"Files\WSL\") || i < 0) return false;
    l.SetPath(cmd.Substring(0, i + 9).Replace(@"\\", @"\")); l.SetArguments(cmd.Substring(i + 10)); pf.Save(file, true);
    return true; }
  // The distribution a wslg.exe shortcut starts, or null
  public static string Distro(string file) {
    IShellLinkW l = (IShellLinkW)Activator.CreateInstance(Type.GetTypeFromCLSID(new Guid("00021401-0000-0000-C000-000000000046")));
    ((IPersistFile)l).Load(file, 0);
    StringBuilder p = new StringBuilder(1024), a = new StringBuilder(4096);
    l.GetPath(p, p.Capacity, IntPtr.Zero, 0x4); l.GetArguments(a, a.Capacity);
    if (!p.ToString().EndsWith(@"\wslg.exe", StringComparison.OrdinalIgnoreCase)) return null;
    var m = System.Text.RegularExpressions.Regex.Match(a.ToString(), "^(?:-d|--distribution) +(?:\"([^\"]+)\"|(\\S+))");
    return m.Success ? m.Groups[1].Value + m.Groups[2].Value : null; }
}
"@
$distros = @(Get-ChildItem 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Lxss' -ErrorAction SilentlyContinue |
  ForEach-Object { $_.GetValue('DistributionName') } | Where-Object { $_ })
Get-ChildItem "$env:APPDATA\Microsoft\Internet Explorer\Quick Launch\User Pinned" -Recurse -Filter *.lnk -ErrorAction SilentlyContinue |
  ForEach-Object { try {
    if ([IkaPin]::Repair($_.FullName)) { "repaired the task bar pin $($_.BaseName)" }
    # Windows keeps the shortcut it made for a WSLg window's app ID after the
    # distribution is gone, and the task bar takes the name, icon and command
    # of another distribution's window with the same app ID from it.
    $distro = [IkaPin]::Distro($_.FullName)
    if ($distros.Count -gt 0 -and $distro -and $distros -notcontains $distro -and
        $_.FullName -like '*\ImplicitAppShortcuts\*') {
      Remove-Item -LiteralPath $_.FullName
      "removed the task bar shortcut $($_.BaseName) of the removed WSL distribution $distro"
    } } catch { } }
EOF
}

scrcpy_supervisor_cleanup() {
  if [[ -n "${scrcpy_supervisor_child_pid:-}" ]]; then
    kill "${scrcpy_supervisor_child_pid}" >/dev/null 2>&1 || true
    wait "${scrcpy_supervisor_child_pid}" 2>/dev/null || true
  fi
  remove_app_cuttlefish_display
  repair_wslg_taskbar_pins
  if [[ -f "${SCRCPY_SUPERVISOR_PID_FILE}" \
      && "$(<"${SCRCPY_SUPERVISOR_PID_FILE}")" == "$$" ]]; then
    rm -f "${SCRCPY_SUPERVISOR_PID_FILE}"
  fi
}

# scrcpy reaches its server through an "adb forward" of a local port, and adb
# rebinds a port that is already forwarded. Clients connecting at the same time
# (app windows opened together from the menu) would take over, and on failure
# remove, each other's forward, so each supervisor locks a port of its own for
# as long as it runs.
SCRCPY_FORWARD_PORT_FIRST=27183
SCRCPY_FORWARD_PORT_LAST=27299

# Sets the variables named by $1 and $2 to a free forward port and the open
# file descriptor that holds its lock.
lock_scrcpy_forward_port() {
  local -n port_ref="$1"
  local -n port_fd_ref="$2"
  local dir="${CVD_TMP_DIR}/scrcpy-ports"
  local port
  local fd

  mkdir -p "${dir}" || return 1
  for (( port = SCRCPY_FORWARD_PORT_FIRST; port <= SCRCPY_FORWARD_PORT_LAST; port++ )); do
    exec {fd}>"${dir}/${port}.lock" || continue
    if flock -n "${fd}"; then
      port_ref="${port}"
      port_fd_ref="${fd}"
      return 0
    fi
    exec {fd}>&-
  done
  return 1
}

run_scrcpy_supervisor() {
  local adb_serial="$1"
  local initial_fullscreen="$2"
  shift 2
  [[ "${1:-}" == "--" ]] || die "invalid console supervisor arguments"
  shift
  local -a base_command=("$@")
  local -a command
  local previous_boot_id
  local new_boot_id
  local window_width=""
  local window_height=""
  local fullscreen="${initial_fullscreen}"
  local status
  local started_at
  # Quick failures are retried: the guest may still be settling at the first
  # launch and right after a reboot.
  local quick_retries=4
  local quick_retry_sec=5
  local supervisor_lock_fd
  local forward_port=""
  local forward_port_fd=""
  local port_given="false"
  local arg
  local console_mode="desktop"
  local guest_mode
  local -a switch_options=()

  if [[ " ${base_command[*]} " == *" --window-state-file=${TV_CONSOLE_WINDOW_STATE_FILE} "* ]]; then
    console_mode="tv"
    SCRCPY_WINDOW_STATE_FILE="${TV_CONSOLE_WINDOW_STATE_FILE}"
  fi

  if [[ ! "${IKA_SCRCPY_REBOOT_TIMEOUT_SEC}" =~ ^[1-9][0-9]*$ ]]; then
    die "IKA_SCRCPY_REBOOT_TIMEOUT_SEC must be a positive whole number of seconds"
  fi

  exec {supervisor_lock_fd}>"${SCRCPY_SUPERVISOR_LOCK_FILE}"
  if ! flock -n "${supervisor_lock_fd}"; then
    log "another console supervisor is already active"
    return 0
  fi

  umask 077
  printf '%s\n' "$$" > "${SCRCPY_SUPERVISOR_PID_FILE}.tmp.$$"
  mv -f "${SCRCPY_SUPERVISOR_PID_FILE}.tmp.$$" "${SCRCPY_SUPERVISOR_PID_FILE}"
  scrcpy_supervisor_child_pid=""
  trap 'exit 0' INT TERM HUP
  trap scrcpy_supervisor_cleanup EXIT

  for arg in "${base_command[@]}"; do
    case "${arg}" in
      --port|--port=*|-p|-p[0-9]*) port_given="true" ;;
    esac
  done
  if [[ "${port_given}" != "true" ]]; then
    if lock_scrcpy_forward_port forward_port forward_port_fd; then
      base_command+=(--port="${forward_port}")
      log "using adb forward port ${forward_port}"
    else
      log "no free adb forward port; using the scrcpy default"
    fi
  fi

  # The boot id tells a reboot from a stop once the console is gone; an app
  # window does not reopen after either, so it skips the round trip.
  previous_boot_id=""
  if [[ "${APP_WINDOW_SUPERVISOR:-false}" != "true" ]]; then
    previous_boot_id="$(adb_guest_boot_id "${adb_serial}" || true)"
  fi
  local saved_fullscreen
  if read_scrcpy_window_state "${SCRCPY_WINDOW_STATE_FILE}" \
      window_width window_height saved_fullscreen; then
    log "restoring saved console size ${window_width}x${window_height}"
  fi
  # A normal launch obeys the requested windowed/fullscreen mode. The saved
  # fullscreen value is used only below when recovering the same console from
  # a confirmed guest reboot.
  while has_live_cvd_processes; do
    command=("${base_command[@]}")
    if [[ -n "${window_width}" && -n "${window_height}" ]]; then
      command+=(--window-width="${window_width}" --window-height="${window_height}")
    fi
    if [[ "${fullscreen}" == "true" ]]; then
      command+=(--fullscreen)
    fi

    log "starting console (fullscreen=${fullscreen})"
    started_at="${SECONDS}"
    "${command[@]}" &
    scrcpy_supervisor_child_pid="$!"
    set +e
    wait "${scrcpy_supervisor_child_pid}"
    status="$?"
    set -e
    scrcpy_supervisor_child_pid=""

    if [[ "${status}" -eq 0 ]]; then
      # Closing the window is intentional and must not create a reopen loop.
      log "console closed by user"
      return 0
    fi

    if [[ "${status}" -ne "${SCRCPY_EXIT_DISCONNECTED}" ]]; then
      if (( quick_retries > 0 && SECONDS - started_at < quick_retry_sec )) \
          && has_live_cvd_processes; then
        log "console exited quickly with status ${status}; retrying"
        quick_retries=$((quick_retries - 1))
        sleep 1
        continue
      fi
      log "console exited with status ${status}; not relaunching"
      return "${status}"
    fi

    quick_retries=0
    if [[ "${APP_WINDOW_SUPERVISOR:-false}" == "true" ]]; then
      # App windows do not reopen after a reboot: Android starts clean. The
      # display goes now, while its number cannot yet be another window's.
      log "guest disconnected; closing the app window"
      remove_app_cuttlefish_display
      return 0
    fi
    if ! read_scrcpy_window_state "${SCRCPY_WINDOW_STATE_FILE}" \
        window_width window_height fullscreen; then
      log "console window state was unavailable; retaining the previous launch size and mode"
    fi

    has_live_cvd_processes || return 0
    log "guest disconnected; waiting up to ${IKA_SCRCPY_REBOOT_TIMEOUT_SEC}s for reboot completion"
    new_boot_id="$(wait_for_guest_reboot "${adb_serial}" "${previous_boot_id}" \
      "${IKA_SCRCPY_REBOOT_TIMEOUT_SEC}" || true)"
    if [[ -z "${new_boot_id}" ]]; then
      if has_live_cvd_processes; then
        log "guest did not complete a new boot; console will remain closed"
      else
        log "Cuttlefish stopped; console will remain closed"
      fi
      return 0
    fi

    previous_boot_id="${new_boot_id}"
    # IkaMode's switcher changes Android's mode at a restart. Hand over to a
    # console for the new mode, started once this supervisor has released its
    # lock, as that mode's console was last used: fullscreen or windowed, from
    # its own window state, which the other mode's console does not touch.
    guest_mode="$(guest_ui_mode "${adb_serial}")"
    if [[ -n "${guest_mode}" && "${guest_mode}" != "${console_mode}" ]]; then
      console_switch_start_options switch_options "${guest_mode}"
      log "Android restarted in ${guest_mode} mode; opening its console${switch_options[0]:+ ${switch_options[*]}}"
      exec {supervisor_lock_fd}>&-
      if [[ -n "${forward_port_fd}" ]]; then
        exec {forward_port_fd}>&-
      fi
      setsid --fork bash -c 'while kill -0 "$1" 2>/dev/null; do sleep 0.2; done
          exec "$2" start "${@:3}"' ika-console-switch "$$" "${IKA_SCRIPT_PATH}" \
        "${switch_options[@]}" </dev/null >/dev/null 2>&1 3>&-
      return 0
    fi
    # Connecting can take scrcpy's server about 10s on a freshly booted guest.
    quick_retries=4
    quick_retry_sec=30
    log "guest reboot completed; relaunching console at ${window_width:-default}x${window_height:-default}"
  done
}

# Prints the combined size of the guest's logs, which grow while it boots.
guest_log_bytes() {
  local total=0
  local size
  local log_file

  for log_file in "${CVD_INSTANCE_DIR}"/logs/{kernel.log,logcat,launcher.log}; do
    size="$(stat -L -c '%s' "${log_file}" 2>/dev/null || echo 0)"
    total=$((total + size))
  done
  printf '%s\n' "${total}"
}

# Succeeds while process PID runs. A zombie has exited.
process_is_running() {
  local state

  state="$(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f1 || true)"
  [[ -n "${state}" && "${state}" != "Z" ]]
}

# Waits up to CVD_BOOT_TIMEOUT_SEC for Android to boot, and past it while the
# guest's logs still grow (see CVD_BOOT_MAX_SEC). LAUNCHER_PID counts as a live
# VM process: cvd_internal_start replaces itself with 'cvd create', which
# CVD_PROCESS_REGEX does not match, and run_cvd only starts after it.
wait_for_boot() {
  local launcher_log="$1"
  local min_mtime="${2:-0}"
  local launcher_pid="${3:-}"
  local adb_serial=""
  local crosvm_command_reported="false"
  local deadline
  local max_deadline
  local stall_deadline=0
  local log_bytes
  local last_log_bytes=""

  deadline="$(make_deadline "${CVD_BOOT_TIMEOUT_SEC}")"
  max_deadline="$(make_deadline "${CVD_BOOT_MAX_SEC}")"
  while within_deadline "${max_deadline}"; do
    if [[ -f "${launcher_log}" ]]; then
      local log_mtime
      log_mtime="$(stat -c '%Y' "${launcher_log}" 2>/dev/null || echo 0)"
      if [[ "${crosvm_command_reported}" != "true" ]]; then
        if maybe_respond_crosvm_command "${launcher_log}" "${min_mtime}"; then
          crosvm_command_reported="true"
        fi
      fi
    fi
    # The serial depends on this launch's adb mode, so wait for its config.
    if [[ -z "${adb_serial}" ]] \
        && (( $(stat -c '%Y' "${CVD_CONFIG_PATH}" 2>/dev/null || echo 0) >= min_mtime )); then
      adb_serial="$(resolve_adb_serial)"
    fi
    if [[ -n "${adb_serial}" ]] && adb_first_frame_shown "${adb_serial}"; then
      return 0
    fi
    if ! has_live_cvd_processes \
        && ! { [[ -n "${launcher_pid}" ]] && process_is_running "${launcher_pid}"; }; then
      return 1
    fi
    if ! within_deadline "${deadline}"; then
      log_bytes="$(guest_log_bytes)"
      if [[ -z "${last_log_bytes}" ]]; then
        log "Android has not finished booting after ${CVD_BOOT_TIMEOUT_SEC}s; waiting while it makes progress"
      fi
      if [[ "${log_bytes}" != "${last_log_bytes}" ]]; then
        last_log_bytes="${log_bytes}"
        stall_deadline="$(make_deadline "${CVD_BOOT_STALL_SEC}")"
      elif ! within_deadline "${stall_deadline}"; then
        log "the guest logs have not changed for ${CVD_BOOT_STALL_SEC}s"
        return 1
      fi
    fi
    sleep 0.1
  done

  return 1
}

# Installs Chromium until it has succeeded once for this VM. 'ika reset'
# removes the stamp, so a reset VM gets it again; one removed by the user stays
# removed.
ensure_chromium() {
  local adb_serial="$1"
  local hardware_vulkan=1

  if [[ -e "${CHROMIUM_INSTALL_STAMP}" ]]; then
    return 0
  fi

  if [[ ! -x "${PACKAGED_GETCHROMIUM_BIN}" ]]; then
    log "${PACKAGED_GETCHROMIUM_BIN} is unavailable; skipping Chromium."
    return 0
  fi

  # Without a hardware Vulkan device (none, llvmpipe first, or one gfxstream
  # passes over for a software one), getchromium turns off Chromium's
  # Vulkan-only GPU path
  load_vulkaninfo_summary
  if [[ -z "${VULKANINFO_SUMMARY}" ]] || primary_vulkan_device_is_llvmpipe \
      || gfxstream_passes_over_hardware_vulkan >/dev/null; then
    hardware_vulkan=0
  fi
  if ANDROID_SERIAL="${adb_serial}" IKA_CHROMIUM_APK="${CHROMIUM_APK}" \
      IKA_HARDWARE_VULKAN="${hardware_vulkan}" \
      "${PACKAGED_GETCHROMIUM_BIN}" >&3 2>&3; then
    mkdir -p "$(dirname "${CHROMIUM_INSTALL_STAMP}")"
    : > "${CHROMIUM_INSTALL_STAMP}"
    log "getchromium completed."
  else
    log "getchromium failed; it runs again on the next start."
  fi
}

# 'ika app --touch' exports IKA_TOUCH, which the console client reads to send
# left-button clicks and drags as real touch input. Unset, empty and 0 mean
# off, as in the client.
touch_enabled() {
  [[ -n "${IKA_TOUCH:-}" && "${IKA_TOUCH}" != "0" ]]
}

# Whether the extra scrcpy args (IKA_SCRCPY) set the gamepad themselves, as
# --gamepad=MODE, scrcpy's -G, or --gamekb (the keyboard as the gamepad).
scrcpy_extra_args_set_gamepad() {
  local -a scrcpy_extra_args=()
  local arg

  [[ -n "${IKA_SCRCPY:-}" ]] || return 1
  read -r -a scrcpy_extra_args <<<"${IKA_SCRCPY}"
  for arg in "${scrcpy_extra_args[@]}"; do
    case "${arg}" in
      --gamepad|--gamepad=*|--gamekb|--gamekb=*)
        return 0
        ;;
      -[!-]*)
        [[ "${arg}" != *G* ]] || return 0
        ;;
    esac
  done
  return 1
}

# The spec's name of a setting of [keyboard_gamepad]
keyboard_gamepad_setting_spec_name() {
  case "$1" in
    stick_ramp_ms) echo "ramp_ms" ;;
    *) echo "$1" ;;
  esac
}

# Prints the value of the keyboard gamepad setting NAME, or its default with
# a log line when VALUE is not one: stick_ramp_ms 0 to 5000, walk_percent 1
# to 100, socd last or neutral, the per-pad socd settings those or empty.
normalize_keyboard_gamepad_setting() {
  local name="$1"
  local value="${2,,}"
  local default="$3"
  local ok="false"

  case "${name}" in
    stick_ramp_ms)
      [[ "${value}" =~ ^[0-9]+$ && "${value}" -le 5000 ]] && ok="true"
      ;;
    walk_percent)
      [[ "${value}" =~ ^[0-9]+$ && "${value}" -ge 1 && "${value}" -le 100 ]] && ok="true"
      ;;
    socd)
      [[ "${value}" == last || "${value}" == neutral ]] && ok="true"
      ;;
    socd_dpad|socd_left_stick|socd_right_stick)
      [[ "${value}" == last || "${value}" == neutral || -z "${value}" ]] && ok="true"
      ;;
    mouse_stick)
      [[ "${value}" == off || "${value}" == right || "${value}" == left ]] && ok="true"
      ;;
    mouse_sensitivity)
      [[ "${value}" =~ ^[0-9]+$ && "${value}" -ge 1 && "${value}" -le 1000 ]] && ok="true"
      ;;
  esac
  if [[ "${ok}" != "true" ]]; then
    log "keyboard gamepad: ${name} must be $(keyboard_gamepad_setting_values "${name}"), not '${2}'; using '${default}'"
    value="${default}"
  fi
  printf '%s\n' "${value}"
}

keyboard_gamepad_setting_values() {
  case "$1" in
    stick_ramp_ms) echo "0 to 5000" ;;
    walk_percent) echo "1 to 100" ;;
    socd) echo "last or neutral" ;;
    mouse_stick) echo "off, right or left" ;;
    mouse_sensitivity) echo "1 to 1000" ;;
    *) echo "last, neutral or empty" ;;
  esac
}

# A game's controller mapping: ~/ika/apps/PACKAGE/controller.ini, the keys
# and settings of [keyboard_gamepad] for that game, over ika.ini's.
app_controller_mapping_file() {
  printf '%s/%s/controller.ini\n' "${IKA_APPS_DIR}" "$1"
}

# Reads PACKAGE's controller mapping into the associative arrays KEYS (control
# to its keys) and SETTINGS (setting to its value); nothing when the game has
# none. Lines that are not a control or a setting are reported and skipped.
load_app_controller_mapping() {
  local package="$1"
  local -n mapping_keys_ref="$2"
  local -n mapping_settings_ref="$3"
  local file line name value

  file="$(app_controller_mapping_file "${package}")"
  [[ -r "${file}" ]] || return 0
  while IFS= read -r line; do
    name="${line%%=*}"
    value="${line#*=}"
    if [[ " ${KEYBOARD_GAMEPAD_CONTROLS[*]} " == *" ${name} "* ]]; then
      mapping_keys_ref["${name}"]="${value}"
    elif [[ " ${KEYBOARD_GAMEPAD_SETTINGS[*]} " == *" ${name} "* ]]; then
      mapping_settings_ref["${name}"]="${value}"
    else
      log "${file}: '${name}' is not a control or a setting of the keyboard gamepad; ignored"
    fi
  done < <(awk '
    { sub(/[[:space:]]+$/, "") }
    /^[[:space:]]*[#;]/ || /^[[:space:]]*$/ { next }
    /^\[/ { in_section = (tolower($0) == "[keyboard_gamepad]"); next }
    in_section && /=/ {
      name = $0; sub(/[[:space:]]*=.*/, "", name); sub(/^[[:space:]]+/, "", name)
      value = $0; sub(/^[^=]*=[[:space:]]*/, "", value)
      print tolower(name) "=" value
    }' "${file}")
}

# Prints scrcpy's --gamekb spec from the [keyboard_gamepad] keys and settings,
# and those of PACKAGE's controller mapping over them when PACKAGE is given:
# control=key/key,control=key,setting=value, controls without keys left out.
# A key that an ika.ini line or the game's mapping gives a control is left out
# of the control it is a default of, so that moving a key takes one line
# (scrcpy keeps a key given twice for its first control).
keyboard_gamepad_spec() {
  local package="${1:-}"
  local control key keys setting value spec=""
  local -a words kept
  local -A given_keys=()
  local -A app_keys=()
  local -A app_settings=()

  if [[ -n "${package}" ]]; then
    load_app_controller_mapping "${package}" app_keys app_settings
  fi

  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    if [[ -n "${app_keys[${control}]+set}" ]]; then
      read -r -a words <<<"${app_keys[${control}]}"
    elif [[ -n "${IKA_INI[keyboard_gamepad.${control}]+set}" ]]; then
      read -r -a words <<<"${KEYBOARD_GAMEPAD_KEYS[${control}]}"
    else
      continue
    fi
    for key in "${words[@]}"; do
      given_keys["${key,,}"]=1
    done
  done

  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    if [[ -n "${app_keys[${control}]+set}" ]]; then
      read -r -a words <<<"${app_keys[${control}]}"
    else
      read -r -a words <<<"${KEYBOARD_GAMEPAD_KEYS[${control}]}"
      if [[ -z "${IKA_INI[keyboard_gamepad.${control}]+set}" ]]; then
        kept=()
        for key in "${words[@]}"; do
          [[ -n "${given_keys[${key,,}]+set}" ]] || kept+=("${key}")
        done
        words=("${kept[@]}")
      fi
    fi
    [[ "${#words[@]}" -gt 0 ]] || continue
    keys="$(IFS=/; printf '%s' "${words[*]}")"
    spec+="${spec:+,}${control}=${keys}"
  done

  for setting in "${KEYBOARD_GAMEPAD_SETTINGS[@]}"; do
    if [[ -n "${app_settings[${setting}]+set}" ]]; then
      value="${app_settings[${setting}]}"
    else
      value="${KEYBOARD_GAMEPAD_SETTING_VALUES[${setting}]}"
    fi
    value="$(normalize_keyboard_gamepad_setting "${setting}" "${value}" \
      "${KEYBOARD_GAMEPAD_SETTING_VALUES[${setting}]}")"
    [[ -n "${value}" ]] || continue
    spec+="${spec:+,}$(keyboard_gamepad_setting_spec_name "${setting}")=${value}"
  done
  printf '%s\n' "${spec}"
}

# Whether the app's start options pass INPUT through to Android as a HID
# device: keyboard, mouse, gamepad, or gamekb (the keyboard as a gamepad).
# apply_saved_app_options exports them in IKA_APP_INPUT, separated by spaces,
# for the app window it opens.
app_input_enabled() {
  [[ " ${IKA_APP_INPUT:-} " == *" $1 "* ]]
}

# Whether the TV console also makes the keyboard a gamepad
# (console.tv_keyboard_gamepad in ika.ini, IKA_TV_KEYBOARD_GAMEPAD).
tv_keyboard_gamepad_enabled() {
  case "${IKA_TV_KEYBOARD_GAMEPAD:-false}" in
    [Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]|1) return 0 ;;
    *) return 1 ;;
  esac
}

# The input of a console or app window, for MODE: "desktop" (the desktop
# console), "tv" (the TV console) or "app" (an app window). The consoles keep
# text-friendly SDK keyboard injection, and the TV console passes the gamepad
# through as the remote, with the keyboard as a gamepad too when
# tv_keyboard_gamepad_enabled. An app passes through the
# HID devices its start options tick (IKA_APP_INPUT), each a UHID device: the
# keyboard, the mouse, gamepads, and the keyboard as a gamepad (scrcpy's
# --gamekb, with the [keyboard_gamepad] keys: those keys no longer type, other
# keys still do). Extra args that set --gamepad or --gamekb themselves win.
# Touch input needs the SDK mouse, so it wins over the mouse; a finger does
# not hover.
append_scrcpy_input_args() {
  local -n input_args_ref="$1"
  local mode="$2"
  local label="$3"
  local package="${4:-}"
  local -a gamepad_args=()

  if [[ "${mode}" == "tv" ]] && tv_keyboard_gamepad_enabled; then
    log "${label} TV mode: the gamepad is the remote, and the keyboard a gamepad too: $(keyboard_gamepad_spec)"
    gamepad_args=(--gamepad=uhid "--gamekb=$(keyboard_gamepad_spec)")
  elif [[ "${mode}" == "tv" ]]; then
    log "${label} TV mode: the gamepad is the remote, desktop keyboard and mouse"
    gamepad_args=(--gamepad=uhid)
  elif [[ "${mode}" == "app" ]]; then
    log "${label} HID devices: ${IKA_APP_INPUT:-none}"
    if app_input_enabled gamekb; then
      log "${label} keyboard gamepad: $(keyboard_gamepad_spec "${package}")"
      gamepad_args=(--gamepad=uhid "--gamekb=$(keyboard_gamepad_spec "${package}")")
    elif app_input_enabled gamepad; then
      gamepad_args=(--gamepad=uhid)
    fi
  fi
  if [[ "${#gamepad_args[@]}" -gt 0 ]] && scrcpy_extra_args_set_gamepad; then
    log "${label} gamepad: set by the extra args"
    gamepad_args=()
  fi
  input_args_ref+=("${gamepad_args[@]}")

  if [[ "${mode}" == "app" ]] && app_input_enabled keyboard; then
    input_args_ref+=(--keyboard=uhid)
  else
    input_args_ref+=(--keyboard=sdk --prefer-text)
  fi
  if [[ "${mode}" != "tv" ]] && touch_enabled; then
    if [[ "${mode}" == "app" ]] && app_input_enabled mouse; then
      log "${label} touch input: the mouse is not a HID device"
    else
      log "${label} touch input"
    fi
    input_args_ref+=(--no-mouse-hover)
  elif [[ "${mode}" == "app" ]] && app_input_enabled mouse; then
    input_args_ref+=(--mouse=uhid)
  fi
}

append_scrcpy_extra_args() {
  local -n extra_args_ref="$1"
  local label="$2"
  local -a scrcpy_extra_args=()

  [[ -n "${IKA_SCRCPY:-}" ]] || return 0
  read -r -a scrcpy_extra_args <<<"${IKA_SCRCPY}"
  if [[ "${#scrcpy_extra_args[@]}" -gt 0 ]]; then
    log "using extra ${label} args: $(shell_join "${scrcpy_extra_args[@]}")"
    extra_args_ref+=("${scrcpy_extra_args[@]}")
  fi
}

# Windows' display scale, in percent, as WSLg last saw it for the primary
# monitor: weston.log records every monitor layout Windows sends it (at
# start and when the displays or their scale change). 100 when unknown.
wslg_windows_scale() {
  local weston_log="${IKA_WSLG_WESTON_LOG:-/mnt/wslg/weston.log}"
  local scale=""

  if [[ -r "${weston_log}" ]]; then
    scale="$(awk '
      /rdpMonitor\[[0-9]+\]: x:.*is_primary:/ {
        primary = ($0 ~ /is_primary:1/)
      }
      primary && match($0, /desktopScaleFactor:[0-9]+/) {
        value = substr($0, RSTART + 19, RLENGTH - 19) + 0
        if (value > 0) {
          scale = value
        }
      }
      END { print scale }
    ' "${weston_log}" 2>/dev/null || true)"
  fi
  [[ "${scale}" =~ ^[0-9]+$ ]] || scale=100
  printf '%s\n' "${scale}"
}

# Ika's copy of Windows' Segoe UI Variable, for the title bars of its windows
# on WSLg, made once (and again when Windows' changes); nothing when Windows
# has none.
wslg_caption_font() {
  local source="${IKA_WINDOWS_FONTS_DIR:-/mnt/c/Windows/Fonts}/SegUIVar.ttf"
  local copy="${CVD_HOME_DIR}/fonts/SegUIVar.ttf"

  [[ -f "${source}" ]] || return 0
  if [[ ! -f "${copy}" ]] \
      || [[ "$(stat -c %s "${source}")" != "$(stat -c %s "${copy}")" ]]; then
    mkdir -p "${copy%/*}" \
      && cp -f "${source}" "${copy}.tmp.$$" \
      && mv -f "${copy}.tmp.$$" "${copy}" \
      || { rm -f "${copy}.tmp.$$"; return 0; }
  fi
  printf '%s\n' "${copy}"
}

append_scrcpy_env() {
  local -n scrcpy_env_ref="$1"
  local caption_font

  if [[ -d "${SCRCPY_ICON_DIR_DEFAULT}" ]]; then
    scrcpy_env_ref+=("SCRCPY_ICON_DIR=${SCRCPY_ICON_DIR_DEFAULT}")
  fi

  if [[ -x "${CVD_CLI_BIN}" ]]; then
    scrcpy_env_ref+=("IKA_CVD_BIN=${CVD_CLI_BIN}")
  fi

  # The window's title bar and shadow come from libdecor's GTK plugin. WSLg
  # shows each as a window of its own and leaves it on screen once the
  # plugin unmaps it, as it does in fullscreen; Ika's build of the plugin
  # (tools/wsl/libdecor) destroys them instead. A plugin directory the user
  # set is kept.
  if [[ "${IKA_ON_WSLG}" == true && -z "${LIBDECOR_PLUGIN_DIR:-}" \
        && -f "${PACKAGED_WSL_GPU_DIR}/libdecor/libdecor-gtk.so" ]]; then
    scrcpy_env_ref+=("LIBDECOR_PLUGIN_DIR=${PACKAGED_WSL_GPU_DIR}/libdecor")
  fi

  # On WSL2 the GPU is reached only through Direct3D 12 (/dev/dxg). Mesa's
  # OpenGL then falls back to llvmpipe, drawing every frame of the window on
  # the CPU (Zink, OpenGL on Dozen, refuses without robustness2's
  # nullDescriptor); its d3d12 driver draws on the GPU. Only where the
  # distribution's Mesa has it, and unless the user set a GALLIUM_DRIVER.
  if [[ -e /dev/dxg && -z "${GALLIUM_DRIVER:-}" && "${IKA_WSL_GPU_FIX:-1}" != "0" ]] \
      && { compgen -G '/usr/lib*/dri/d3d12_dri.so' >/dev/null \
           || compgen -G '/usr/lib/*/dri/d3d12_dri.so' >/dev/null; }; then
    scrcpy_env_ref+=("GALLIUM_DRIVER=d3d12")
  fi

  # On WSLg the title bars look like Windows': scrcpy sizes them for Windows'
  # display scale, read when the window opens, and sets their title in
  # Windows' font.
  if [[ "${IKA_ON_WSLG}" == true ]]; then
    scrcpy_env_ref+=("IKA_WINDOWS_SCALE=$(wslg_windows_scale)")
    caption_font="$(wslg_caption_font)"
    if [[ -n "${caption_font}" ]]; then
      scrcpy_env_ref+=("IKA_CAPTION_FONT=${caption_font}")
    fi
  fi

  # scrcpy spawns `adb` to push the server jar and open the shell. Point it
  # at the cuttlefish-bundled adb explicitly so it doesn't rely on PATH —
  # on a stock Asahi system there's no /usr/bin/adb, and even where there
  # is one we want the cuttlefish version that's known to match the rest
  # of the cvd-host_package.
  local packaged_adb="${PACKAGED_CVD_HOST_OUT}/bin/adb"
  if [[ -x "${packaged_adb}" ]]; then
    scrcpy_env_ref+=("ADB=${packaged_adb}")
  fi

  if [[ -n "${SCRCPY_SERVER_PATH_OVERRIDE}" && -f "${SCRCPY_SERVER_PATH_OVERRIDE}" ]]; then
    scrcpy_env_ref+=("SCRCPY_SERVER_PATH=${SCRCPY_SERVER_PATH_OVERRIDE}")
  fi

  # On GNOME Wayland, GTK draws the window title bar (libdecor's GTK plugin)
  # and only goes dark when GTK_THEME says so. Match the desktop's light or
  # dark style, unless the user set a theme.
  if [[ -z "${GTK_THEME:-}" ]]; then
    if [[ "$(host_color_scheme)" == "dark" ]]; then
      scrcpy_env_ref+=("GTK_THEME=Adwaita:dark")
    else
      scrcpy_env_ref+=("GTK_THEME=Adwaita")
    fi
  fi

  # The window follows the session: Wayland on a Wayland session, X11 on an
  # X11 one. Left to itself, scrcpy's SDL opens an X11 window through
  # Xwayland on a Wayland compositor without the fifo-v1 protocol (KWin
  # before 6.4), and every frame then crosses Xwayland. A driver set in the
  # environment is kept.
  if [[ -z "${SDL_VIDEO_DRIVER:-}${SDL_VIDEODRIVER:-}" ]]; then
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
      scrcpy_env_ref+=("SDL_VIDEO_DRIVER=wayland" "SDL_VIDEODRIVER=wayland")
    elif [[ -n "${DISPLAY:-}" ]]; then
      scrcpy_env_ref+=("SDL_VIDEO_DRIVER=x11" "SDL_VIDEODRIVER=x11")
    fi
  fi
}

start_scrcpy_with_retries() {
  local adb_serial="$1"
  local fullscreen_mode="${2:-false}"
  local input_mode="desktop"
  local cuttlefish_frames_socket
  local scrcpy_log="${SCRCPY_LOG_FILE}"
  local scrcpy_lock_file="${CVD_TMP_DIR}/console-launch.lock"
  local scrcpy_lock_fd=""
  local scrcpy_window_size
  local scrcpy_window_width
  local console_dpi="${SCRCPY_DPI}"
  local scrcpy_window_height
  local -a scrcpy_env=()
  local -a scrcpy_cmd=(
    "${SCRCPY_BIN}"
    -s "${adb_serial}"
  )

  # In Android's TV mode the console is the TV screen: fullscreen, at the TV
  # density (--dpi wins in either mode), with the gamepad as the remote.
  if [[ "$(guest_ui_mode "${adb_serial}")" == "tv" ]]; then
    log "Android is in TV mode"
    fullscreen_mode="true"
    input_mode="tv"
    if [[ "${SCRCPY_DPI_GIVEN}" != "true" ]]; then
      console_dpi="$(resolve_tv_dpi)"
    fi
  fi
  exec {scrcpy_lock_fd}>"${scrcpy_lock_file}"
  if ! flock "${scrcpy_lock_fd}"; then
    log "unable to acquire console launch lock: ${scrcpy_lock_file}"
    return 1
  fi

  scrcpy_window_size="$(default_scrcpy_window_size)"
  if [[ "${scrcpy_window_size}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    scrcpy_window_width="${BASH_REMATCH[1]}"
    scrcpy_window_height="${BASH_REMATCH[2]}"
  else
    scrcpy_window_width=1280
    scrcpy_window_height=720
  fi

  if [[ -n "${console_dpi}" ]]; then
    scrcpy_cmd+=("--dpi=${console_dpi}")
  fi
  # Right, middle, 4th and 5th buttons, then the same with Shift: a right click
  # is a right click on the desktop (Back with Shift), and Back in TV mode, as
  # a remote's Back button (a right click with Shift). The middle button is
  # Home, the 4th and 5th the recent apps and the notifications.
  if [[ "${input_mode}" == "tv" ]]; then
    scrcpy_cmd+=(--mouse-bind=bhsn:++++)
  else
    scrcpy_cmd+=(--mouse-bind=+hsn:b+++)
  fi
  scrcpy_cmd+=(
    --force-adb-forward
    --render-driver=opengl
    --window-borderless
    --window-width="${scrcpy_window_width}"
    --window-height="${scrcpy_window_height}"
    --no-audio
  )

  append_scrcpy_input_args scrcpy_cmd "${input_mode}" console

  cuttlefish_frames_socket="$(resolve_cuttlefish_frames_socket)"
  scrcpy_cmd+=(--cuttlefish-frames-socket="${cuttlefish_frames_socket}")
  if [[ "${input_mode}" == "tv" ]]; then
    scrcpy_cmd+=(--window-state-file="${TV_CONSOLE_WINDOW_STATE_FILE}")
  else
    scrcpy_cmd+=(--window-state-file="${SCRCPY_WINDOW_STATE_FILE}")
  fi
  log "console video source: raw Cuttlefish frames (${cuttlefish_frames_socket})"

  append_scrcpy_extra_args scrcpy_cmd console
  append_scrcpy_env scrcpy_env
  # ika.desktop's ID, or on WSLg the distribution's (see console_app_id).
  # Otherwise SDL uses the executable name, scrcpy, which KDE's taskbar also
  # derives for app windows and would match to the console.
  write_wslg_console_entry
  scrcpy_env+=("SDL_APP_ID=$(console_app_id)")

  if [[ "${#scrcpy_env[@]}" -gt 0 ]]; then
    scrcpy_cmd=(
      env
      "${scrcpy_env[@]}"
      "${scrcpy_cmd[@]}"
    )
  fi

  mkdir -p "$(dirname "${scrcpy_log}")"
  : > "${scrcpy_log}"

  ensure_chromium "${adb_serial}"

  flock -u "${scrcpy_lock_fd}"
  exec {scrcpy_lock_fd}>&-

  log "starting supervised console for ${adb_serial}"
  setsid --fork "${IKA_SCRIPT_PATH}" __console_supervisor \
    "${adb_serial}" "${fullscreen_mode}" -- "${scrcpy_cmd[@]}" \
    </dev/null >>"${scrcpy_log}" 2>&1 3>&- &
  disown || true

  sleep 1.5
  if has_packaged_scrcpy || scrcpy_supervisor_pid >/dev/null; then
    return 0
  fi

  log "unable to start the console supervisor"
  return 1
}

schedule_scrcpy_when_launcher_ready() {
  local adb_serial="$1"
  local fullscreen_mode="${2:-false}"

  (
    while has_live_cvd_processes; do
      if adb_first_frame_shown "${adb_serial}"; then
        break
      fi
      sleep 0.1
    done

    if ! has_live_cvd_processes; then
      log "deferred console watcher stopped because Cuttlefish exited before Android's first frame."
      exit 0
    fi
    start_scrcpy_with_retries "${adb_serial}" "${fullscreen_mode}" || true
  ) &

  disown || true
  log "scheduled console launch for Android's first frame"
}

maybe_start_scrcpy() {
  local adb_serial="$1"
  local fullscreen_mode="${2:-false}"

  if [[ ! -x "${SCRCPY_BIN}" ]]; then
    log "console client not found at ${SCRCPY_BIN}; skipping launch."
    return 0
  fi

  if adb_first_frame_shown "${adb_serial}"; then
    log "Ika console ready; starting the console immediately."
    start_scrcpy_with_retries "${adb_serial}" "${fullscreen_mode}" || true
    return 0
  fi

  log "Android has not shown its first frame; deferring console launch."
  schedule_scrcpy_when_launcher_ready "${adb_serial}" "${fullscreen_mode}"
  return 0
}

# ============================================================================
# App windows (ika app)
# ============================================================================
#
# Each app window is a separate scrcpy client that shows a Cuttlefish display
# of its own (--cuttlefish-display=N), launches one app on it, and follows host
# window resizes. Like the desktop console, it shows raw Cuttlefish frames.

is_app_package_name() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$ ]]
}

validate_app_package() {
  is_app_package_name "$1" || die "invalid package name '$1'"
}

use_app_window_paths() {
  local app_dir="${IKA_APPS_DIR}/$1"

  SCRCPY_SUPERVISOR_PID_FILE="$(app_supervisor_file "$1" pid)"
  SCRCPY_SUPERVISOR_LOCK_FILE="$(app_supervisor_file "$1" lock)"
  SCRCPY_WINDOW_STATE_FILE="${app_dir}/window-state"
  SCRCPY_LOG_FILE="${app_dir}/window.log"
}

guest_adb() {
  local adb_serial="$1"
  shift
  host_adb "${GUEST_ADB_TIMEOUT:-10}" -s "${adb_serial}" "$@"
}

# Guest shell queries an app window needs, which ensure_guest_ready runs
# along with its boot check when given them, each adb round trip taking a
# tenth of a second on its own. Their answers stay in GUEST_QUERY_CACHE, keyed
# "SERIAL<TAB>QUERY", for guest_shell_query for the rest of the command.
readonly GUEST_QUERY_LEANBACK="cmd package has-feature android.software.leanback"
readonly GUEST_QUERY_DENSITY="wm density"
declare -A GUEST_QUERY_CACHE=()

guest_query_package_path() {
  printf 'pm path %s\n' "$1"
}

# Prints the output of QUERY in the guest's shell, cached or over adb now.
guest_shell_query() {
  local adb_serial="$1"
  local query="$2"
  local key="${adb_serial}"$'\t'"${query}"

  if [[ -n "${GUEST_QUERY_CACHE[${key}]+set}" ]]; then
    printf '%s\n' "${GUEST_QUERY_CACHE[${key}]}"
    return 0
  fi
  guest_adb "${adb_serial}" shell "${query}" 2>/dev/null | tr -d '\r' || true
}

# One adb round trip for the boot check and QUERY...: true once the guest has
# booted, with the queries' answers in GUEST_QUERY_CACHE.
guest_booted_with_queries() {
  local adb_serial="$1"
  shift
  local separator="--ika-query-end--"
  local command="getprop sys.boot_completed"
  local query
  local output
  local line
  local answer=""
  local -a answers=()

  for query in "$@"; do
    command+="; echo ${separator}; ${query}"
  done
  output="$(host_adb 10 -s "${adb_serial}" shell "${command}" 2>/dev/null \
    | tr -d '\r' || true)"
  while IFS= read -r line; do
    if [[ "${line}" == "${separator}" ]]; then
      answers+=("${answer}")
      answer=""
    else
      answer+="${line}"$'\n'
    fi
  done <<<"${output}"
  answers+=("${answer}")
  [[ "${answers[0]}" == 1$'\n' ]] || return 1
  for query in "$@"; do
    answer="${answers[1]-}"
    answers=("${answers[@]:1}")
    while [[ "${answer}" == *$'\n' ]]; do
      answer="${answer%$'\n'}"
    done
    GUEST_QUERY_CACHE["${adb_serial}"$'\t'"${query}"]="${answer}"
  done
}

app_is_installed() {
  local package="$1"
  local adb_serial="$2"
  local package_path

  package_path="$(guest_shell_query "${adb_serial}" "$(guest_query_package_path "${package}")")"
  [[ "${package_path}" == package:* ]]
}

# Host Bluetooth is off by default, so the guest HCI port has no controller
# behind it and com.android.bluetooth aborts on every enable attempt. Clear the
# persisted bluetooth_on setting so later boots don't try, and stop the retry
# loop on this one.
disable_guest_bluetooth() {
  local adb_serial="$1"
  shift
  local bluetooth_on

  if user_supplied_flag "enable_host_bluetooth" "$@" || user_supplied_flag "netsim_bt" "$@"; then
    return 0
  fi

  bluetooth_on="$(guest_adb "${adb_serial}" shell settings get global bluetooth_on 2>/dev/null | tr -d '\r' || true)"
  [[ "${bluetooth_on}" == "0" ]] && return 0

  guest_adb "${adb_serial}" shell settings put global bluetooth_on 0 >/dev/null 2>&1 || true
  guest_adb "${adb_serial}" shell cmd bluetooth_manager disable >/dev/null 2>&1 || true
  log "disabled guest Bluetooth (no host Bluetooth controller)"
}

# On a VM's first boot, start Android in the host's light or dark theme. The
# ika_theme_seeded marker lives in the guest, so later boots leave a theme the
# user picked in Android alone, and a wiped VM is seeded again.
seed_guest_theme() {
  local adb_serial="$1"
  local seeded
  local scheme
  local night

  # Only an explicit "null" means unset; an adb error must not re-seed.
  seeded="$(guest_adb "${adb_serial}" shell settings get global ika_theme_seeded 2>/dev/null | tr -d '\r' || true)"
  [[ "${seeded}" == "null" ]] || return 0

  # LineageOS defaults to dark, and GNOME's light style reports no preference,
  # so anything but dark is applied as light.
  scheme="$(host_color_scheme)"
  if [[ "${scheme}" == "dark" ]]; then
    night=yes
  else
    scheme="light"
    night=no
  fi
  # Through the uimode service, which applies the change at once and saves it
  # to ui_night_mode; writing the setting directly only applies after reboot.
  guest_adb "${adb_serial}" shell cmd uimode night "${night}" >/dev/null 2>&1 || true
  log "set the guest theme to ${scheme} to match the host"
  guest_adb "${adb_serial}" shell settings put global ika_theme_seeded 1 >/dev/null 2>&1 || true
}

# Applies low-CPU mode's guest settings once Android is up: window blurs
# off and animations at half their length. The values they replace are kept
# in the global setting ika_lowcpu_mode, so that a start without the
# profile puts them back.
apply_lowcpu_mode_guest_settings() {
  local adb_serial="$1"
  local saved
  local blurs
  local window
  local transition
  local animator

  saved="$(guest_adb "${adb_serial}" shell settings get global ika_lowcpu_mode 2>/dev/null | tr -d '\r' || true)"
  if [[ "${LOWCPU_MODE_ACTIVE}" == "true" ]]; then
    if [[ "${saved}" == "null" || -z "${saved}" ]]; then
      saved="$(guest_adb "${adb_serial}" shell "echo \$(settings get global disable_window_blurs),\$(settings get global window_animation_scale),\$(settings get global transition_animation_scale),\$(settings get global animator_duration_scale)" 2>/dev/null | tr -d '\r ' || true)"
      [[ "${saved}" =~ ^[^,]*,[^,]*,[^,]*,[^,]*$ ]] || return 0
    fi
    guest_adb "${adb_serial}" shell "settings put global ika_lowcpu_mode '${saved}'; \
      settings put global disable_window_blurs 1; \
      settings put global window_animation_scale 0.5; \
      settings put global transition_animation_scale 0.5; \
      settings put global animator_duration_scale 0.5" >/dev/null 2>&1 || return 0
    log "low-CPU mode: window blurs off, animations at half length"
  elif [[ "${saved}" =~ ^([^,]*),([^,]*),([^,]*),([^,]*)$ ]]; then
    blurs="${BASH_REMATCH[1]}"
    window="${BASH_REMATCH[2]}"
    transition="${BASH_REMATCH[3]}"
    animator="${BASH_REMATCH[4]}"
    guest_adb "${adb_serial}" shell "$(lowcpu_mode_restore_command disable_window_blurs "${blurs}"); \
      $(lowcpu_mode_restore_command window_animation_scale "${window}"); \
      $(lowcpu_mode_restore_command transition_animation_scale "${transition}"); \
      $(lowcpu_mode_restore_command animator_duration_scale "${animator}"); \
      settings delete global ika_lowcpu_mode" >/dev/null 2>&1 || return 0
    log "low-CPU mode off: window blurs and animations restored"
  fi
}

# The shell command that puts the global setting NAME back to VALUE, as
# 'settings get' printed it: "null" means it was unset.
lowcpu_mode_restore_command() {
  if [[ "$2" == "null" || -z "$2" ]]; then
    printf 'settings delete global %s' "$1"
  else
    printf 'settings put global %s %s' "$1" "$(shell_quote "$2")"
  fi
}

# Density of the desktop display, preferring the override that ika applies
# when the console window is resized.
guest_display_density() {
  local adb_serial="$1"
  local output
  local override
  local physical

  output="$(guest_shell_query "${adb_serial}" "${GUEST_QUERY_DENSITY}")"
  override="$(sed -n 's/^Override density: *\([0-9][0-9]*\).*/\1/p' <<<"${output}")"
  physical="$(sed -n 's/^Physical density: *\([0-9][0-9]*\).*/\1/p' <<<"${output}")"
  printf '%s\n' "${override:-${physical}}"
}

# The size of an app window in native host pixels rather than logical window
# points, so that on HiDPI hosts the app draws at native resolution instead of
# being upscaled: the logical window size scaled by the host's native/logical
# ratio, rounded to the nearest pixel as SDL does, then down to an even size.
app_window_display_size() {
  local window_size="$1"
  local native
  local logical
  local native_max
  local logical_max
  local width
  local height

  [[ "${window_size}" =~ ^([0-9]+)x([0-9]+)$ ]] || return 1
  width="${BASH_REMATCH[1]}"
  height="${BASH_REMATCH[2]}"

  native="$(host_display_size || true)"
  logical="$(host_display_logical_size || true)"
  if [[ "${native}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    native_max=$(( BASH_REMATCH[1] > BASH_REMATCH[2] ? BASH_REMATCH[1] : BASH_REMATCH[2] ))
    if [[ "${logical}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
      logical_max=$(( BASH_REMATCH[1] > BASH_REMATCH[2] ? BASH_REMATCH[1] : BASH_REMATCH[2] ))
      if (( native_max > 0 && logical_max > 0 )); then
        width=$(( (width * native_max + logical_max / 2) / logical_max ))
        height=$(( (height * native_max + logical_max / 2) / logical_max ))
      fi
    fi
  fi

  width=$(( width / 2 * 2 ))
  height=$(( height / 2 * 2 ))
  (( width > 0 && height > 0 )) || return 1
  printf '%sx%s\n' "${width}" "${height}"
}

# App windows show a Cuttlefish display of their own, added to crosvm's GPU
# device while the VM runs, through ika_stream's raw frames (scrcpy
# --cuttlefish-display), as the console shows the main display.

# The control socket of crosvm's GPU device, which adds and removes displays:
# the vhost-user GPU's own socket when the GPU runs in its own process, else the
# VM's control socket. ('cvd display' always sends to the VM's control socket,
# which cannot reach a vhost-user GPU.)
cuttlefish_gpu_control_socket() {
  local dir
  dir="$(dirname "$(resolve_cuttlefish_frames_socket)")"
  if [[ -S "${dir}/vhost-user-gpu-control" ]]; then
    printf '%s/vhost-user-gpu-control\n' "${dir}"
  else
    printf '%s/crosvm_control.sock\n' "${dir}"
  fi
}

# Prints the numbers of the Cuttlefish displays, one per line.
cuttlefish_display_numbers() {
  with_timeout 10 "${CVD_HOST_OUT}/bin/crosvm" gpu list-displays "$1" 2>/dev/null \
    | tr -d ' \n' | grep -o '"[0-9][0-9]*":{' | tr -dc '0-9\n'
}

# Adds a Cuttlefish display of WIDTHxHEIGHT pixels at DPI and prints its
# number, which crosvm picks.
add_cuttlefish_display() {
  local size="$1"
  local dpi="$2"
  local socket
  local lock_fd
  local before
  local number
  local added=""

  socket="$(cuttlefish_gpu_control_socket)"
  exec {lock_fd}>"${CVD_TMP_DIR}/cuttlefish-displays.lock"
  if flock -w 10 "${lock_fd}"; then
    before="$(cuttlefish_display_numbers "${socket}")"
    local app_refresh_hz
    if [[ "${LOWCPU_MODE_ACTIVE:-false}" == "true" ]]; then
      app_refresh_hz="${IKA_LOWCPU_REFRESH_RATE_HZ}"
    else
      read -r app_refresh_hz _ < <(resolve_display_refresh_hz)
    fi
    if with_timeout 10 "${CVD_HOST_OUT}/bin/crosvm" gpu add-displays \
        "--gpu-display=mode=windowed[${size/x/,}],dpi=[${dpi},${dpi}],refresh-rate=${app_refresh_hz}" \
        "${socket}" >/dev/null 2>&1; then
      while read -r number; do
        if [[ -n "${number}" ]] && ! grep -qx "${number}" <<<"${before}"; then
          added="${number}"
          break
        fi
      done < <(cuttlefish_display_numbers "${socket}")
    fi
  fi
  exec {lock_fd}>&-
  [[ -n "${added}" ]] || return 1
  printf '%s\n' "${added}"
}

remove_cuttlefish_display() {
  with_timeout 10 "${CVD_HOST_OUT}/bin/crosvm" gpu remove-displays --display-id="$1" \
    "$(cuttlefish_gpu_control_socket)" >/dev/null 2>&1
}

# The size of an app window's Cuttlefish display: the host screen, the largest
# the window can get (else the window's own size in pixels). Like the
# console's display, the app is drawn at the window size inside it.
app_cuttlefish_display_size() {
  host_display_size || printf '%s\n' "$1"
}

# Limits a window size in logical points to the host screen: a size saved
# under another desktop or scale can be larger.
clamp_app_window_size() {
  local width
  local height

  [[ "$1" =~ ^([0-9]+)x([0-9]+)$ ]] || return 1
  width="${BASH_REMATCH[1]}"
  height="${BASH_REMATCH[2]}"
  if [[ "$(host_display_logical_size || true)" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    (( width <= BASH_REMATCH[1] )) || width="${BASH_REMATCH[1]}"
    (( height <= BASH_REMATCH[2] )) || height="${BASH_REMATCH[2]}"
  fi
  printf '%sx%s\n' "${width}" "${height}"
}

# 16:9 at 60% of the host's logical width, capped at 75% of its height.
default_app_window_size() {
  local size
  local host_width
  local host_height
  local width=1280
  local height=720
  local max_height

  size="$(host_display_logical_size || true)"
  if [[ "${size}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    host_width="${BASH_REMATCH[1]}"
    host_height="${BASH_REMATCH[2]}"
    width=$(( host_width * 60 / 100 ))
    height=$(( width * 9 / 16 ))
    max_height=$(( host_height * 75 / 100 ))
    if (( height > max_height )); then
      height="${max_height}"
      width=$(( height * 16 / 9 ))
    fi
  fi

  printf '%sx%s\n' "$(( width / 8 * 8 ))" "$(( height / 8 * 8 ))"
}

# Apps kept out of the app list, name matching and the desktop menu. They can
# still be opened by giving their full package name.
IKA_HIDDEN_APPS=(
  com.google.android.apps.restore
  com.google.android.googlequicksearchbox
  com.android.calculator2
  org.lineageos.etar
  com.android.deskclock
  com.android.contacts
  org.lineageos.recorder
  org.lineageos.audiofx
)
ika_ini_list IKA_HIDDEN_APPS apps hidden_apps

# Apps treated as games even though they do not declare
# android:appCategory="game", which Android uses to identify games.
IKA_GAME_APPS=(
)
ika_ini_list IKA_GAME_APPS apps game_apps

# Games are apps that declare themselves as such (recorded by the last sync in
# APP_GAMES_FILE, see IkaAppIcons) or that are listed in IKA_GAME_APPS. Given
# an adb serial, a game installed since the last sync is also recognized, by
# asking the guest's game mode service, which only accepts games.
is_game_app() {
  local package="$1"
  local adb_serial="${2:-}"
  local game

  for game in "${IKA_GAME_APPS[@]}"; do
    [[ "${package}" == "${game}" ]] && return 0
  done
  if [[ -f "${APP_GAMES_FILE}" ]] && grep -qxF "${package}" "${APP_GAMES_FILE}"; then
    return 0
  fi
  [[ -n "${adb_serial}" ]] || return 1
  guest_adb "${adb_serial}" shell cmd game list-modes "${package}" </dev/null 2>/dev/null \
    | grep -q 'current mode'
}

is_hidden_app() {
  local hidden

  for hidden in "${IKA_HIDDEN_APPS[@]}"; do
    [[ "$1" == "${hidden}" ]] && return 0
  done
  return 1
}

# Prints "LABEL<TAB>PACKAGE" for every enabled app with a launcher entry,
# except hidden apps, and caches the result for name lookups.
list_guest_apps() {
  local apps

  apps="$(query_guest_apps "$1")"
  [[ -n "${apps}" ]] || return 0
  mkdir -p "${IKA_APPS_DIR}"
  if printf '%s\n' "${apps}" > "${APP_LIST_CACHE}.$$"; then
    mv -f "${APP_LIST_CACHE}.$$" "${APP_LIST_CACHE}"
  fi
  printf '%s\n' "${apps}"
}

# Queries the launchable apps from scrcpy's app list, which prints each app as
# " * LABEL  PACKAGE" (system) or " - LABEL  PACKAGE", but moves the package to
# an indented continuation line when the label is 30 characters or longer.
query_guest_apps() {
  local adb_serial="$1"
  local output
  local -a scrcpy_env=()

  append_scrcpy_env scrcpy_env
  # Nothing unless the query succeeded: a partial list would make the menu sync
  # remove the launchers of the apps missing from it.
  output="$(with_timeout 30 env "${scrcpy_env[@]}" "${SCRCPY_BIN}" -s "${adb_serial}" --list-apps 2>&1)" \
    || return 0
  printf '%s\n' "${output}" \
    | tr -d '\r' \
    | awk '
        function is_package(s) {
          return s ~ /^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$/
        }
        function emit_same_line(    name, package) {
          name = pending
          package = name
          sub(/.*[[:space:]]/, "", package)
          sub(/[[:space:]]+[^[:space:]]+[[:space:]]*$/, "", name)
          if (is_package(package) && name != "") {
            printf "%s\t%s\n", name, package
          }
          pending = ""
        }
        /^ [*-] / {
          if (pending != "") {
            emit_same_line()
          }
          pending = substr($0, 4)
          # The app list is tab-separated, so a tab in a label would split it.
          gsub(/\t/, " ", pending)
          next
        }
        pending != "" && /^[[:space:]]+[^[:space:]]+[[:space:]]*$/ && is_package($1) {
          sub(/[[:space:]]+$/, "", pending)
          printf "%s\t%s\n", pending, $1
          pending = ""
          next
        }
        pending != "" {
          emit_same_line()
        }
        END {
          if (pending != "") {
            emit_same_line()
          }
        }' \
    | IKA_HIDDEN="${IKA_HIDDEN_APPS[*]}" awk -F '\t' '
        BEGIN {
          n = split(ENVIRON["IKA_HIDDEN"], packages, " ")
          for (i = 1; i <= n; i++) {
            hidden[packages[i]] = 1
          }
        }
        !($2 in hidden)' || true
}

# Resolves the app's label, cached per package because listing apps is slow.
# Falls back to the package name.
app_window_title() {
  local package="$1"
  local adb_serial="$2"
  local title_file="${IKA_APPS_DIR}/${package}/title"
  local title=""

  if [[ -s "${title_file}" ]]; then
    title="$(<"${title_file}")"
  else
    title="$(list_guest_apps "${adb_serial}" \
      | awk -F '\t' -v pkg="${package}" '$2 == pkg { print $1; exit }' || true)"
    if [[ -n "${title}" ]]; then
      printf '%s\n' "${title}" > "${title_file}"
    fi
  fi

  printf '%s\n' "${title:-${package}}"
}

# Prints an app window's app ID, which its launcher's file name repeats:
# ika-PACKAGE. WSLg keeps a desktop entry under the last dot-separated part of
# its name only, and finds no entry, and so no icon, for an app ID with dots;
# there the dots become dashes, which package names cannot have, and the
# distribution's name comes first (see wslg_distro_id): ika-DISTRIBUTION-PACKAGE.
app_window_id() {
  local id="ika-$1"
  local distro

  if [[ "${IKA_ON_WSLG}" == true ]]; then
    distro="$(wslg_distro_id)"
    id="ika-${distro:+${distro}-}$1"
    id="${id//./-}"
  fi
  printf '%s\n' "${id}"
}

# Prints the app's name as its menu launcher shows it, without the game/app
# marker (see app_launcher_name), for messages and notifications. It comes from
# the launcher, the cached app list, or the cached window title, without asking
# the guest, and falls back to the package name.
app_display_name() {
  local package="$1"
  local launcher
  local name=""

  launcher="$(app_menu_data_dir)/applications/$(app_window_id "${package}").desktop"
  if [[ -f "${launcher}" ]]; then
    name="$(sed -n '/^Name=/{s///p;q}' "${launcher}")"
    # The game or app marker, or the app marker of older launchers
    name="${name#🎮 ∙ }"
    name="${name#ᗩ ∙ }"
    name="${name#∙ }"
    name="${name//\\\\/\\}"
  fi
  if [[ -z "${name}" && -s "${APP_LIST_CACHE}" ]]; then
    name="$(awk -F '\t' -v pkg="${package}" '$2 == pkg { print $1; exit }' "${APP_LIST_CACHE}")"
  fi
  if [[ -z "${name}" && -s "${IKA_APPS_DIR}/${package}/title" ]]; then
    name="$(<"${IKA_APPS_DIR}/${package}/title")"
  fi
  printf '%s\n' "${name:-${package}}"
}

# Resolves NAME to "LABEL<TAB>PACKAGE" among the launchable apps. The app list
# cached by the last listing or sync answers most lookups without the live
# query, which takes over half a second; a miss, an ambiguous name, or an app
# that is no longer installed falls back to the live list.
resolve_launchable_app() {
  local name="$1"
  local adb_serial="$2"
  local matches

  if [[ -s "${APP_LIST_CACHE}" ]]; then
    matches="$(match_app_name "${name}" < "${APP_LIST_CACHE}")"
    if [[ -n "${matches}" && "$(grep -c . <<<"${matches}")" -eq 1 ]] \
        && app_is_installed "${matches#*$'\t'}" "${adb_serial}"; then
      printf '%s\n' "${matches}"
      return 0
    fi
  fi
  resolve_app_name "${name}" "$(list_guest_apps "${adb_serial}")" "launchable app"
}

# Android's mode switch ("Desktop/TV" in the app menu, IkaMode in Android) is a
# list and a question, so like any app it opens in a window of its own. The
# window is sized to that list (in dp, at the guest's density) rather than to
# 60% of the screen; a size saved from resizing it wins.
IKA_MODE_PACKAGE="org.lineageos.desktop.mode"
IKA_MODE_WINDOW_DP_WIDTH=480
IKA_MODE_WINDOW_DP_HEIGHT=560

# Prints the size of the Desktop/TV window in logical points, as
# default_app_window_size does, for a guest display density of DPI: the dp
# size in the guest's pixels, then in logical points by the host's
# native/logical ratio (the app is drawn at native resolution), and no larger
# than the host screen.
mode_app_window_size() {
  local dpi="$1"
  local width
  local height
  local native
  local logical
  local native_width

  [[ "${dpi}" =~ ^[1-9][0-9]*$ ]] || return 1
  width=$(( IKA_MODE_WINDOW_DP_WIDTH * dpi / 160 ))
  height=$(( IKA_MODE_WINDOW_DP_HEIGHT * dpi / 160 ))
  native="$(host_display_size || true)"
  logical="$(host_display_logical_size || true)"
  if [[ "${native}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    native_width="${BASH_REMATCH[1]}"
    if [[ "${logical}" =~ ^([0-9]+)x([0-9]+)$ ]] && (( native_width > 0 )); then
      width=$(( width * BASH_REMATCH[1] / native_width ))
      height=$(( height * BASH_REMATCH[1] / native_width ))
    fi
  fi
  (( width >= 320 )) || width=320
  (( height >= 320 )) || height=320
  clamp_app_window_size "$(( width / 8 * 8 ))x$(( height / 8 * 8 ))"
}

# Starts the VM without its console when it is not running, so that menu
# launchers work while Ika is stopped, then waits for the guest to boot.
# QUERY... are guest shell commands the caller needs next, answered in the boot
# check's adb round trip when the guest has booted (see guest_shell_query).
ensure_guest_ready() {
  local -a queries=("$@")
  local adb_serial
  local deadline
  local autostart_lock_fd

  # Serialize concurrent launches, so only one of them starts the VM.
  exec {autostart_lock_fd}>"${CVD_TMP_DIR}/autostart.lock"
  flock -w "$((CVD_BOOT_MAX_SEC + 60))" "${autostart_lock_fd}" \
    || die "timed out waiting for Ika to start"
  if ! has_live_cvd_processes; then
    log "Android virtual device not running; starting it without the console"
    notify_progress "Starting Android, one moment..."
    # Close the lock for the child: the VM processes it starts outlive this
    # command and would otherwise hold the lock for as long as the VM runs.
    IKA_NOTIFY=false "${IKA_SCRIPT_PATH}" start --no-console </dev/null >/dev/null 2>&1 \
      {autostart_lock_fd}>&- \
      || die "could not start the Android virtual device; see ${START_LOG_FILE}"
  fi
  exec {autostart_lock_fd}>&-

  adb_serial="$(resolve_adb_serial)"
  if (( ${#queries[@]} )) && guest_booted_with_queries "${adb_serial}" "${queries[@]}"; then
    return 0
  fi
  deadline="$(make_deadline "${CVD_BOOT_MAX_SEC}")"
  until adb_boot_completed "${adb_serial}"; do
    has_live_cvd_processes || die "the Android virtual device stopped while booting"
    within_deadline "${deadline}" || die "the Android virtual device did not finish booting"
    sleep 1
  done
}

# Filters "LABEL<TAB>PACKAGE" lines on stdin to the apps NAME refers to: an
# exact package or case-insensitive label match, otherwise every label that
# contains NAME case-insensitively.
match_app_name() {
  IKA_APP_NAME="$1" awk -F '\t' '
    BEGIN { name = tolower(ENVIRON["IKA_APP_NAME"]) }
    { labels[NR] = $1; packages[NR] = $2 }
    tolower($1) == name || tolower($2) == name { exact[++n_exact] = NR }
    index(tolower($1), name) { partial[++n_partial] = NR }
    END {
      if (n_exact) {
        for (i = 1; i <= n_exact; i++) print labels[exact[i]] "\t" packages[exact[i]]
      } else {
        for (i = 1; i <= n_partial; i++) print labels[partial[i]] "\t" packages[partial[i]]
      }
    }'
}

# Resolves NAME to exactly one "LABEL<TAB>PACKAGE" line from the LIST of apps,
# or dies naming the candidates when NAME is unknown or ambiguous.
resolve_app_name() {
  local name="$1"
  local list="$2"
  local what="$3"
  local matches
  local count
  local label
  local package

  matches="$(match_app_name "${name}" <<<"${list}")"
  count="$(grep -c . <<<"${matches}" || true)"
  if [[ "${count}" -eq 1 ]]; then
    printf '%s\n' "${matches}"
    return 0
  fi

  if [[ "${count}" -eq 0 ]]; then
    # Menu launchers pass the package of an app that may since have been removed.
    if is_app_package_name "${name}"; then
      die "$(app_display_name "${name}") is not installed in Android; see '${SCRIPT_NAME} app'"
    fi
    die "no ${what} matches '${name}'; see '${SCRIPT_NAME} app'"
  fi
  log "'${name}' matches several ${what}s:"
  while IFS=$'\t' read -r label package; do
    log "  ${label}  (${package})"
  done <<<"${matches}"
  die "use a longer name or the package name"
}

# ============================================================================
# App start options (ika app --options NAME)
# ============================================================================
#
# "Startup options" on an app's launcher opens a window with the app
# window's display density and a checkbox for each of the app's start options,
# and its controller mapping on a second tab. "Apply settings"
# saves them in APP_OPTIONS_FILE, one [PACKAGE] section per app, "Apply and
# start" saves them and starts the app, Cancel changes nothing, and 'ika app'
# adds the saved options to the options it is given, from the menu or a
# terminal.

# The start options an app can save, in the order the window lists them and
# they are saved in: a fullscreen window, the HID devices passed through to
# Android (see app_input_enabled), and touch input.
APP_START_OPTIONS=(fullscreen keyboard mouse gamepad gamekb touch)

# Prints the value of KEY in PACKAGE's section, or nothing.
saved_app_setting() {
  [[ -r "${APP_OPTIONS_FILE}" ]] || return 0
  awk -v section="[$1]" -v key="$2" '
    { sub(/[[:space:]]+$/, "") }
    /^\[/ { in_section = ($0 == section); next }
    in_section && $0 ~ ("^[[:space:]]*" key "[[:space:]]*=") {
      sub(/^[^=]*=[[:space:]]*/, "")
      print
      exit
    }' "${APP_OPTIONS_FILE}"
}

# Prints the options saved for PACKAGE, or nothing.
saved_app_options() {
  saved_app_setting "$1" options
}

# Prints the display density DPI as an app window takes it: nothing for auto
# (empty, 0 or auto), 96 for 1 to 95, the number itself up to 999. yad
# prints a number with decimals, which are dropped. Fails for anything else.
app_dpi_value() {
  local dpi="${1,,}"

  dpi="${dpi%%[.,]*}"
  [[ -n "${dpi}" && "${dpi}" != "auto" ]] || return 0
  [[ "${dpi}" =~ ^[0-9]+$ ]] || return 1
  dpi=$((10#${dpi}))
  (( dpi != 0 )) || return 0
  (( dpi >= 96 )) || dpi=96
  (( dpi <= 999 )) || return 1
  printf '%s\n' "${dpi}"
}

# Prints the display density saved for PACKAGE, as app_dpi_value takes it:
# nothing for auto. A value it does not take, from a file edited by hand, is
# reported and left out.
saved_app_dpi() {
  local saved
  local dpi

  saved="$(saved_app_setting "$1" dpi)"
  if ! dpi="$(app_dpi_value "${saved}")"; then
    log "${APP_OPTIONS_FILE}: dpi '${saved}' of $1 is not auto or 96 to 999; ignored"
    return 0
  fi
  [[ -z "${dpi}" ]] || printf '%s\n' "${dpi}"
}

# Whether PACKAGE has a section, even an empty one: its options were set
# once, by the start options window or as a new game's default.
app_options_saved() {
  [[ -r "${APP_OPTIONS_FILE}" ]] \
    && awk -v section="[$1]" '
      { sub(/[[:space:]]+$/, "") }
      $0 == section { found = 1; exit }
      END { exit !found }' "${APP_OPTIONS_FILE}"
}

# Replaces the options saved for PACKAGE with the OPTIONS given, an empty
# section when there are none, so that a game whose options were all
# unticked does not get the new game's default again. Its display density is
# kept.
save_app_options() {
  local package="$1"
  shift

  save_app_options_with_dpi "${package}" "$(saved_app_dpi "${package}")" "$@"
}

# Replaces PACKAGE's section with the OPTIONS given and the display density
# DPI, none (auto) when empty. Other apps' sections and comments are kept, as
# in the launcher's action groups, without leaving blank lines behind.
save_app_options_with_dpi() {
  local package="$1"
  local dpi="$2"
  shift 2

  mkdir -p "$(dirname "${APP_OPTIONS_FILE}")"
  {
    if [[ -s "${APP_OPTIONS_FILE}" ]]; then
      awk -v section="[${package}]" '
        /^\[/ { line = $0; sub(/[[:space:]]+$/, "", line); skip = (line == section) }
        skip { next }
        /^[[:space:]]*$/ { blanks = blanks $0 "\n"; next }
        { printf "%s", blanks; blanks = ""; print }' "${APP_OPTIONS_FILE}"
    else
      cat <<'EOF'
# Start options of Android apps, one section per app, named by its package.
# "Startup options" on an app's launcher in the desktop's app menu sets
# them ('ika app --options NAME' from a terminal), and they apply whenever the
# app starts, from the menu or 'ika app': fullscreen, keyboard, mouse, gamepad,
# gamekb and touch, separated by spaces. A game added to the menu starts with
# fullscreen. dpi, 96 to 999, gives the app's window a display density of its
# own; without it, the window has the console's.
EOF
    fi
    printf '\n[%s]\noptions =%s\n' "${package}" "${*:+ $*}"
    [[ -z "${dpi}" ]] || printf 'dpi = %s\n' "${dpi}"
  } > "${APP_OPTIONS_FILE}.tmp"
  mv -f "${APP_OPTIONS_FILE}.tmp" "${APP_OPTIONS_FILE}"
}

# Adds the options saved for PACKAGE to those 'ika app' was given: fullscreen
# sets the named variable to true, touch exports IKA_TOUCH as --touch does, and
# the HID devices are exported in IKA_APP_INPUT, replacing any it inherited.
# Anything else, from a file edited by hand, is reported and skipped.
apply_saved_app_options() {
  local package="$1"
  local -n saved_fullscreen_ref="$2"
  local -a options=()
  local -a inputs=()
  local option

  read -r -a options <<<"$(saved_app_options "${package}")"
  if [[ "${#options[@]}" -gt 0 ]]; then
    log "start options saved for ${package}: ${options[*]}"
  fi
  for option in "${options[@]}"; do
    case "${option}" in
      fullscreen)
        saved_fullscreen_ref="true"
        ;;
      touch)
        export IKA_TOUCH=1
        ;;
      keyboard|mouse|gamepad|gamekb)
        inputs+=("${option}")
        ;;
      *)
        log "${APP_OPTIONS_FILE}: '${option}' is not a start option; ignored"
        ;;
    esac
  done
  IKA_APP_INPUT="${inputs[*]}"
  export IKA_APP_INPUT
}

# Prints the start options window's text for option KEY.
app_start_option_text() {
  case "$1" in
    fullscreen)
      echo "Fullscreen mode (F11, Cmd+F or Left-Alt+F exits)"
      ;;
    keyboard)
      echo "Send the keyboard straight to Android (many games need this)"
      ;;
    mouse)
      echo "Send the mouse straight to Android (Cmd or Left-Alt releases pointer)"
      ;;
    gamepad)
      echo "Use gamepads, including ones plugged in later"
      ;;
    gamekb)
      echo "Keyboard as a gamepad (keys on the Gamepad Emulation tab)"
      ;;
    touch)
      echo "Mouse as touch: clicks tap, drags swipe"
      ;;
  esac
}

# Prints TEXT escaped for the markup of yad's dialog text and field labels,
# which also read backslash escapes.
yad_markup_escape() {
  printf '%s' "$1" \
    | sed -e 's/\\/\\\\/g' -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# Sets the variables named PACKAGE_VAR and LABEL_VAR to the app NAME's package
# and label, for the windows below. A package name is used as given, so that
# a launcher opens a window without starting the VM; a label is looked up
# among the launchable apps.
resolve_settings_app() {
  local name="$1"
  local -n settings_package_ref="$2"
  local -n settings_label_ref="$3"
  local resolved
  local adb_serial

  if is_app_package_name "${name}"; then
    settings_package_ref="${name}"
    settings_label_ref="$(app_display_name "${name}")"
  else
    ensure_guest_ready
    adb_serial="$(resolve_adb_serial)"
    resolved="$(resolve_launchable_app "${name}" "${adb_serial}")" || exit 1
    settings_package_ref="${resolved#*$'\t'}"
    settings_label_ref="${resolved%%$'\t'*}"
  fi
  validate_app_package "${settings_package_ref}"
}

# Sets the array named ENV_VAR to the environment of the windows' yad: GTK 3
# windows on GNOME stay light in a dark session unless GTK_THEME says
# otherwise, as for the console's title bar.
set_yad_env() {
  local -n yad_env_ref="$1"

  yad_env_ref=()
  if [[ -z "${GTK_THEME:-}" && "$(host_color_scheme)" == "dark" ]]; then
    yad_env_ref=(GTK_THEME=Adwaita:dark)
  fi
}

# GTK's options giving the Startup Options windows a class of their own (and
# on Wayland an app ID), which ika-startup-options.desktop names, so that the
# dock and the task bar show them with the Ika icon: GNOME goes by the
# desktop entry a window's class names, and yad's own, "yad", names none.
# WSLg skips desktop entries with NoDisplay, as ika-startup-options.desktop
# has, and shows the generic Linux icon for their windows; there they take
# the console's (see console_app_id).
APP_SETTINGS_WINDOW_CLASS="ika-startup-options"
[[ "${IKA_ON_WSLG}" != true ]] || APP_SETTINGS_WINDOW_CLASS="$(console_app_id)"
APP_SETTINGS_WINDOW_OPTIONS=(--name="${APP_SETTINGS_WINDOW_CLASS}" --class="${APP_SETTINGS_WINDOW_CLASS}")

# Whether yad has --css, which gives its CSS to every widget of the window.
# Older ones, such as Debian's 0.40, have --gtkrc only, whose CSS reaches the
# window itself and none of the fields in it, and ignore a --css.
yad_has_css_option() {
  local help

  if [[ -z "${YAD_CSS_OPTION:-}" ]]; then
    help="$(yad --help-all 2>/dev/null)" || true
    if [[ "${help}" != *"--css="* && "${help}" == *"--gtkrc="* ]]; then
      YAD_CSS_OPTION=no
    else
      YAD_CSS_OPTION=yes
    fi
  fi
  [[ "${YAD_CSS_OPTION}" == "yes" ]]
}

# Sets the arrays named ENV_VAR and OPTIONS_VAR to what a yad window, run
# with the environment YAD_ENV_VAR (set_yad_env's), needs for the extra CSS
# given, which goes in CVD_TMP_DIR under NAME: --css=FILE, or, for a yad
# without --css, a theme of the window's own, ika-NAME: Adwaita (dark when
# YAD_ENV_VAR or the session asks for Adwaita:dark) and then the CSS, in a
# data directory ahead of XDG_DATA_DIRS. A GTK_THEME of the user's other than
# Adwaita is kept, and the CSS given to the window alone (--gtkrc=FILE). With
# no CSS a yad with --css needs nothing, and an older one still gets the
# theme, so that its window looks like the others'.
yad_css() {
  local -n yad_css_env_ref="$1"
  local -n yad_css_options_ref="$2"
  local -n yad_css_base_env_ref="$3"
  local name="$4"
  local css="$5"
  local dir="${CVD_TMP_DIR}/yad-css"
  local theme="${GTK_THEME:-}"
  local entry
  local variant
  local file

  yad_css_env_ref=()
  yad_css_options_ref=()
  mkdir -p "${dir}"
  if yad_has_css_option; then
    if [[ -n "${css}" ]]; then
      printf '%s\n' "${css}" >"${dir}/${name}.css.$$"
      mv -f "${dir}/${name}.css.$$" "${dir}/${name}.css"
      yad_css_options_ref=(--css="${dir}/${name}.css")
    fi
    return 0
  fi
  for entry in "${yad_css_base_env_ref[@]}"; do
    [[ "${entry}" != GTK_THEME=* ]] || theme="${entry#GTK_THEME=}"
  done
  if [[ -n "${theme}" && "${theme}" != "Adwaita" && "${theme}" != "Adwaita:dark" ]]; then
    printf '%s\n' "${css}" >"${dir}/${name}.css.$$"
    mv -f "${dir}/${name}.css.$$" "${dir}/${name}.css"
    yad_css_options_ref=(--gtkrc="${dir}/${name}.css")
    return 0
  fi
  mkdir -p "${dir}/themes/ika-${name}/gtk-3.0"
  for variant in "" -dark; do
    file="${dir}/themes/ika-${name}/gtk-3.0/gtk${variant}.css"
    printf '@import url("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained%s.css");\n%s\n' \
      "${variant}" "${css}" >"${file}.$$"
    mv -f "${file}.$$" "${file}"
  done
  if [[ "${theme}" == "Adwaita:dark" ]]; then
    yad_css_env_ref=(GTK_THEME="ika-${name}:dark")
  else
    yad_css_env_ref=(GTK_THEME="ika-${name}")
  fi
  yad_css_env_ref+=(XDG_DATA_DIRS="${dir}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}")
}

# yad stretches a form's fields across their column, the display density's
# spin box too. A margin on its right keeps it about as wide as three digits
# and its buttons in the start options window of its own, as wide as its
# checkboxes.
APP_DPI_FIELD_MARGIN_PX=330
# The Startup Options tab's border, about two characters: its fields start
# that far in from the tab's frame, as the window's start in from its edge.
APP_OPTIONS_TAB_BORDER_PX=20
# The Gamepad Emulation tab's, smaller: its rows are closer as well (--compact)
# for the window to fit on a screen 768 pixels high.
CONTROLLER_MAPPING_TAB_BORDER_PX=8
# The gamepad's controls and settings in a smaller font, in lower rows, so
# that their window of its own fits on a screen 768 pixels high (ika's
# window has the same as --compact).
CONTROLLER_MAPPING_FORM_CSS='window { font-size: 85%; }
entry, spinbutton, combobox button { min-height: 20px; padding-top: 1px; padding-bottom: 1px; }
spinbutton button { min-height: 0; padding-top: 0; padding-bottom: 0; }'

# Sets the array named FIELDS_VAR to the start options form of PACKAGE,
# labelled LABEL, for yad: the display density (0 for auto), then a checkbox
# for each start option, ticked as TICKED_VAR (an associative array) says,
# with DPI, a number or empty for auto.
app_options_form_fields() {
  local label="$1"
  local dpi="$2"
  local -n options_ticked_ref="$3"
  local -n options_fields_ref="$4"
  local option

  # A blank label under the density, the line above the checkboxes with a half
  # line of space under it, as a smaller blank line, and a blank label between
  # the checkboxes and the buttons.
  options_fields_ref=(--field="Display density, 0=Auto  :NUM" "${dpi:-0}!0..999!8")
  options_fields_ref+=(--field="<span font_size='8pt'> </span>:LBL" "")
  options_fields_ref+=(--field="Start $(yad_markup_escape "${label}") with:"$'\n'"<span font_size='5pt'> </span>:LBL" "")
  for option in "${APP_START_OPTIONS[@]}"; do
    options_fields_ref+=(--field="  $(app_start_option_text "${option}"):CHK")
    options_fields_ref+=("$([[ -n "${options_ticked_ref[${option}]:-}" ]] && echo TRUE || echo FALSE)")
  done
  options_fields_ref+=(--field="<span font_size='8pt'> </span>:LBL" "")
}

# Reads the start options form's OUTPUT, one value per field: the density,
# the two labels' empty values, TRUE or FALSE for each checkbox, then the
# blank label's. Sets the array named OPTIONS_VAR to the ticked options, in
# their usual order, and the variable named DPI_VAR to the density as
# app_dpi_value prints it (1 to 95 is 96; 0 is auto, empty).
read_app_options_form() {
  local output="$1"
  local -n read_options_ref="$2"
  local -n read_dpi_ref="$3"
  local -a values=()
  local i

  IFS='|' read -r -a values <<<"${output}"
  read_options_ref=()
  for i in "${!APP_START_OPTIONS[@]}"; do
    if [[ "${values[i + 3]:-}" == "TRUE" ]]; then
      read_options_ref+=("${APP_START_OPTIONS[i]}")
    fi
  done
  read_dpi_ref="$(app_dpi_value "${values[0]:-}")" || read_dpi_ref=""
}

# Saves PACKAGE's start OPTIONS and display density DPI, as the start options
# windows read them, and says so for the app named LABEL.
save_app_options_form() {
  local package="$1"
  local label="$2"
  local dpi="$3"
  shift 3

  save_app_options_with_dpi "${package}" "${dpi}" "$@"
  if [[ "$#" -gt 0 ]]; then
    respond "${label} starts with $*${dpi:+ at ${dpi} DPI}"
  else
    respond "${label} starts without saved options${dpi:+, at ${dpi} DPI}"
  fi
}

# The start options window for the app NAME, drawn by yad: a form, which is as
# high as its fields need on any theme, titled "Startup Options · LABEL" (the
# app's package when its label is unknown). "Apply settings" saves the ticked
# options and the display density, "Apply and start" saves them and starts the
# app with them, and Cancel, or closing the window, leaves the saved ones as
# they are. edit_app_settings' window has it as a tab; this one is for hosts
# without python3's GTK 3 bindings.
edit_app_options() {
  local name="$1"
  local package
  local label
  local output
  local status=0
  local option
  local dpi
  local -a saved=()
  local -a fields=()
  local -a options=()
  local -a yad_env=()
  local -A ticked=()
  local -a density_env=()
  local -a density_options=()

  resolve_settings_app "${name}" package label
  command -v yad >/dev/null 2>&1 \
    || die "the start options window needs yad; install it"

  read -r -a saved <<<"$(saved_app_options "${package}")"
  for option in "${saved[@]}"; do
    ticked[${option}]="true"
  done
  app_options_form_fields "${label}" "$(saved_app_dpi "${package}")" ticked fields
  set_yad_env yad_env
  yad_css density_env density_options yad_env density-window \
    "spinbutton { margin-right: ${APP_DPI_FIELD_MARGIN_PX}px; }"
  # yad's buttons are all as wide as the widest, which spaces widen until
  # their row is the window's widest part, so that the window, as wide as its
  # contents, has them fill its bottom. Escape closes it, as Cancel does.
  output="$(env "${yad_env[@]}" "${density_env[@]}" yad \
    "${APP_SETTINGS_WINDOW_OPTIONS[@]}" --form \
    --title="Startup Options · ${label}" --window-icon="${IKA_MENU_ICON}" \
    --center --borders=12 --separator="|" "${density_options[@]}" \
    "${fields[@]}" \
    --buttons-layout=spread --button="Apply settings:2" \
    --button="        Apply and start        :0" --button=Cancel:1)" \
    || status=$?
  case "${status}" in
    0|2)
      ;;
    1|252)
      respond "Start options of ${label} left as they were"
      return 0
      ;;
    *)
      die "could not open the start options window (yad exited with ${status})"
      ;;
  esac

  read_app_options_form "${output}" options dpi
  save_app_options_form "${package}" "${label}" "${dpi}" "${options[@]}"
  if [[ "${status}" -eq 0 ]]; then
    open_app_window "${package}" false "" ""
  fi
}

# The label of a control of the keyboard gamepad in the controller mapping
# window
keyboard_gamepad_control_text() {
  case "$1" in
    left_stick_up) echo "Left stick up" ;;
    left_stick_down) echo "Left stick down" ;;
    left_stick_left) echo "Left stick left" ;;
    left_stick_right) echo "Left stick right" ;;
    dpad_up) echo "D-pad up" ;;
    dpad_down) echo "D-pad down" ;;
    dpad_left) echo "D-pad left" ;;
    dpad_right) echo "D-pad right" ;;
    right_stick_up) echo "Right stick up" ;;
    right_stick_down) echo "Right stick down" ;;
    right_stick_left) echo "Right stick left" ;;
    right_stick_right) echo "Right stick right" ;;
    a) echo "A" ;;
    b) echo "B" ;;
    x) echo "X" ;;
    y) echo "Y" ;;
    start) echo "Start" ;;
    back) echo "Back" ;;
    guide) echo "Guide (Home)" ;;
    left_shoulder) echo "Left shoulder" ;;
    right_shoulder) echo "Right shoulder" ;;
    left_stick) echo "Left stick click" ;;
    right_stick) echo "Right stick click" ;;
    left_trigger) echo "Left trigger" ;;
    right_trigger) echo "Right trigger" ;;
    walk) echo "Hold to walk" ;;
    *) echo "$1" ;;
  esac
}

# Writes PACKAGE's controller mapping from the associative arrays KEYS and
# SETTINGS: every control and setting, so that the game's mapping stands on
# its own, over whatever ika.ini says.
save_controller_mapping() {
  local package="$1"
  local -n saved_keys_ref="$2"
  local -n saved_settings_ref="$3"
  local file control setting

  file="$(app_controller_mapping_file "${package}")"
  mkdir -p "$(dirname "${file}")"
  {
    cat <<EOF
# Controller mapping of ${package}: the keyboard gamepad's keys and settings
# for this game, over [keyboard_gamepad] in ika.ini. 'ika app --controller
# NAME' edits it; delete the file, or press "Reset to default" there, to go
# back to ika.ini. The keys
# are SDL's key names, with _ for a space; an empty value leaves the control
# without a key.

[keyboard_gamepad]
EOF
    for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
      printf '%s = %s\n' "${control}" "${saved_keys_ref[${control}]:-}"
    done
    for setting in "${KEYBOARD_GAMEPAD_SETTINGS[@]}"; do
      printf '%s = %s\n' "${setting}" "${saved_settings_ref[${setting}]:-}"
    done
  } > "${file}.tmp"
  mv -f "${file}.tmp" "${file}"
}

# Prints the start options PACKAGE has by default: fullscreen for a game, as
# a game added to the menu gets, none for another app.
default_app_options() {
  if is_game_app "$1"; then
    printf 'fullscreen\n'
  fi
}

# "Reset to default" once confirmed: PACKAGE's start options go back to its
# default ones, at the console's density, and its controller mapping is
# deleted, so that it uses ika.ini's [keyboard_gamepad] again.
reset_app_to_default() {
  local package="$1"

  rm -f "$(app_controller_mapping_file "${package}")"
  # shellcheck disable=SC2046 # one word per option
  save_app_options_with_dpi "${package}" "" $(default_app_options "${package}")
}

# Asks whether the app named LABEL is to have its default start options and
# controller mapping again (reset_app_to_default), or what MESSAGE says
# instead: true if so
confirm_reset_to_default() {
  local label="$1"
  local message="${2:-This will reset your app options and gamepad emulation mappings.}"
  local text
  local -a yad_env=()

  set_yad_env yad_env
  text="<span font_size='13pt' weight='bold'>Apply defaults to $(yad_markup_escape "${label}")</span>"
  text+=$'\n\n'"$(yad_markup_escape "${message}")"
  # Some space between the text and the buttons: a tall transparent dot, as
  # yad drops a last line of spaces, and a short line only fills the room
  # the window has at its least height
  text+=$'\n'"<span font_size='16pt' alpha='1'>.</span>"
  env "${yad_env[@]}" yad "${APP_SETTINGS_WINDOW_OPTIONS[@]}" \
    --title="" --window-icon="${IKA_MENU_ICON}" \
    --undecorated --center --borders=24 --text="${text}" --text-align=center \
    --buttons-layout=spread --button=Ok:0 --button=Cancel:1 \
    >/dev/null
}

# The controller mapping form's explanation, above its fields: in two lines,
# no wider than the fields, since as a label among them it widened its column,
# and the window, to its whole length; then a small blank line, which keeps
# the fields up from the buttons as the form's last row does.
controller_mapping_form_text() {
  printf "%s\n%s\n<span font_size='4pt'> </span>" \
    "One or more keys per control, separated by spaces: Space, Return, Left_Shift," \
    "Keypad_Enter, Mouse_Left, Mouse_Right, Mouse_Middle, Wheel_Up, Wheel_Down"
}

# The settings the controller mapping form shows, besides the controls' keys.
CONTROLLER_MAPPING_FORM_SETTINGS=(stick_ramp_ms walk_percent socd mouse_stick mouse_sensitivity)

# The controller mapping form's fields as the hands have them: the first
# column has the left half of the pad, the left stick and its click, the
# D-pad, the left shoulder and trigger and Back, then the walk key, its
# speed and the sticks' other settings; after the "|", the second has the
# right half, the face buttons, the right stick and its click, the right
# shoulder and trigger and Start, then Guide and the mouse's settings. Each control and setting is
# there once; ika.ini, the mappings and the spec keep their own order.
CONTROLLER_MAPPING_FORM_LAYOUT=(
  left_stick_up left_stick_down left_stick_left left_stick_right left_stick
  dpad_up dpad_down dpad_left dpad_right left_shoulder left_trigger back
  walk walk_percent stick_ramp_ms socd
  "|"
  a b x y right_stick_up right_stick_down right_stick_left right_stick_right
  right_stick right_shoulder right_trigger start guide
  mouse_stick mouse_sensitivity)

# Sets the associative arrays named KEYS_VAR and SETTINGS_VAR to the controller
# mapping the form shows for PACKAGE: its own, else ika.ini's keys and
# settings, and APP_SETTINGS_VAR to the settings of its own mapping.
load_controller_mapping_form() {
  local package="$1"
  local -n form_keys_ref="$2"
  local -n form_settings_ref="$3"
  local -n form_app_settings_ref="$4"
  local -A own_keys=()
  local -A own_settings=()
  local control
  local setting
  local value

  load_app_controller_mapping "${package}" own_keys own_settings
  form_keys_ref=()
  form_settings_ref=()
  form_app_settings_ref=()
  for setting in "${!own_settings[@]}"; do
    form_app_settings_ref[${setting}]="${own_settings[${setting}]}"
  done
  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    if [[ -n "${own_keys[${control}]+set}" ]]; then
      form_keys_ref[${control}]="${own_keys[${control}]}"
    else
      form_keys_ref[${control}]="${KEYBOARD_GAMEPAD_KEYS[${control}]}"
    fi
  done
  for setting in "${KEYBOARD_GAMEPAD_SETTINGS[@]}"; do
    if [[ -n "${own_settings[${setting}]+set}" ]]; then
      value="${own_settings[${setting}]}"
    else
      value="${KEYBOARD_GAMEPAD_SETTING_VALUES[${setting}]}"
    fi
    form_settings_ref[${setting}]="$(normalize_keyboard_gamepad_setting "${setting}" \
      "${value}" "${KEYBOARD_GAMEPAD_SETTING_VALUES[${setting}]}")"
  done
}

# Prints what the controller mapping form shows of the associative arrays
# named KEYS_VAR and SETTINGS_VAR, a line per control and setting, to tell an
# edited mapping from the one the window opened with.
controller_mapping_form_signature() {
  local -n signature_keys_ref="$1"
  local -n signature_settings_ref="$2"
  local control
  local setting

  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    printf '%s=%s\n' "${control}" "${signature_keys_ref[${control}]:-}"
  done
  for setting in "${CONTROLLER_MAPPING_FORM_SETTINGS[@]}"; do
    printf '%s=%s\n' "${setting}" "${signature_settings_ref[${setting}]:-}"
  done
}

# Sets the array named FIELDS_VAR to the controller mapping form of the
# associative arrays named KEYS_VAR and SETTINGS_VAR, for yad, in the two
# columns of CONTROLLER_MAPPING_FORM_LAYOUT, and BLANKS_VAR (an associative
# array) to the indexes of its blank rows, whose values reading the form
# leaves out. The shorter column ends with blank rows, to be as high as the
# longer; each column ends with one more, which leaves space between the
# fields and the buttons: a line's worth with BLANK_ROWS true, as a window of
# its own, and a small one as a tab, whose frame adds to it.
controller_mapping_form_fields() {
  local -n fields_keys_ref="$1"
  local -n fields_settings_ref="$2"
  local -n mapping_fields_ref="$3"
  local -n mapping_blanks_ref="$4"
  local blank_rows="$5"
  local entry
  local column=1
  local label
  local half_space
  local socd_choice
  local mouse_choice
  local rows=0
  local shown
  local indent
  local gap
  local field
  local i
  local -a items=()
  local -a item_values=()
  local -a item_columns=()
  local -a column_rows=([1]=0 [2]=0)

  # A narrow no-break space (U+202F), about half a space, on each side of "="
  half_space=$'\xe2\x80\xaf'
  if [[ "${fields_settings_ref[socd]}" == "neutral" ]]; then
    socd_choice="Last pressed wins!^Cancel out"
  else
    socd_choice="^Last pressed wins!Cancel out"
  fi
  case "${fields_settings_ref[mouse_stick]}" in
    right) mouse_choice="Off!^Right stick!Left stick" ;;
    left) mouse_choice="Off!Right stick!^Left stick" ;;
    *) mouse_choice="^Off!Right stick!Left stick" ;;
  esac
  for entry in "${CONTROLLER_MAPPING_FORM_LAYOUT[@]}"; do
    case "${entry}" in
      "|")
        column=2
        continue
        ;;
      stick_ramp_ms)
        items+=("Full tilt, ms (0${half_space}=${half_space}Instant):NUM")
        item_values+=("${fields_settings_ref[stick_ramp_ms]}!0..5000!10")
        ;;
      walk_percent)
        items+=("Walk speed, %:NUM")
        item_values+=("${fields_settings_ref[walk_percent]}!1..100!5")
        ;;
      socd)
        items+=("Opposite directions:CB")
        item_values+=("${socd_choice}")
        ;;
      mouse_stick)
        items+=("Mouse → Analog stick:CB")
        item_values+=("${mouse_choice}")
        ;;
      mouse_sensitivity)
        items+=("Mouse sensitivity, %:NUM")
        item_values+=("${fields_settings_ref[mouse_sensitivity]}!1..1000!10")
        ;;
      *)
        # A control's label has no colon, as the settings' have none
        label="$(keyboard_gamepad_control_text "${entry}")"
        items+=("${label}")
        item_values+=("${fields_keys_ref[${entry}]}")
        ;;
    esac
    item_columns+=("${column}")
    column_rows[${column}]=$(( column_rows[${column}] + 1 ))
  done
  # yad fills the first of the two columns with half the fields, then the
  # second: both columns are as high, blank rows included.
  # The second column's labels start two figure spaces (U+2007, a digit's
  # width) in: with yad's own spacing, about four characters between them
  # and the first column's fields. Every label ends with a no-break space,
  # to set it off its field, as close as a colon and a space would. yad
  # takes what follows a field's last colon as its type, so a key field's
  # label ("Up") gets a colon and a no-break space as a type after the
  # space, which yad does not know and shows as a text field, as it does
  # without a type.
  for column in 1 2; do
    (( column_rows[${column}] <= rows )) || rows="${column_rows[${column}]}"
  done
  [[ "${blank_rows}" != "true" ]] || rows=$(( rows + 1 ))
  indent=$'\xe2\x80\x87\xe2\x80\x87'
  gap=$'\xc2\xa0'
  mapping_fields_ref=()
  mapping_blanks_ref=()
  for column in 1 2; do
    shown=0
    for i in "${!items[@]}"; do
      (( item_columns[i] == column )) || continue
      case "${items[i]}" in
        *:NUM|*:CB) field="${items[i]%:*}${gap}:${items[i]##*:}" ;;
        *) field="${items[i]}${gap}:"$'\xc2\xa0' ;;
      esac
      (( column == 1 )) || field="${indent}${field}"
      mapping_fields_ref+=(--field="${field}" "${item_values[i]}")
      shown=$((shown + 1))
    done
    for (( ; shown < rows; shown++ )); do
      mapping_blanks_ref[$(( ${#mapping_fields_ref[@]} / 2 ))]=1
      mapping_fields_ref+=(--field=" :LBL" "")
    done
    # As a tab, a small blank row, a little space between the last fields
    # and the frame above the buttons
    if [[ "${blank_rows}" != "true" ]]; then
      mapping_blanks_ref[$(( ${#mapping_fields_ref[@]} / 2 ))]=1
      mapping_fields_ref+=(--field="<span font_size='6pt'> </span>:LBL" "")
    fi
  done
}

# Reads the controller mapping form's OUTPUT, the blank rows of BLANKS_VAR left
# out: a value per field of CONTROLLER_MAPPING_FORM_LAYOUT, in its order, a
# control's keys or a setting, into the associative arrays named KEYS_VAR
# and SETTINGS_VAR, which hold the mapping the form showed. The settings the
# form does not show come from APP_SETTINGS_VAR, the game's own mapping.
read_controller_mapping_form() {
  local output="$1"
  local -n read_blanks_ref="$2"
  local -n read_keys_ref="$3"
  local -n read_settings_ref="$4"
  local -n read_app_settings_ref="$5"
  local i
  local entry
  local control
  local other
  local key
  local value
  local -a words=()
  local -a values=()
  local -a kept=()
  local -A shown=()
  local -A form_values=()

  IFS='|' read -r -a words <<<"${output}"
  for i in "${!words[@]}"; do
    [[ -n "${read_blanks_ref[${i}]+set}" ]] || values+=("${words[i]}")
  done
  i=0
  for entry in "${CONTROLLER_MAPPING_FORM_LAYOUT[@]}"; do
    [[ "${entry}" != "|" ]] || continue
    form_values[${entry}]="${values[i]:-}"
    i=$((i + 1))
  done
  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    shown[${control}]="${read_keys_ref[${control}]}"
    value="${form_values[${control}]:-}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    read_keys_ref[${control}]="${value}"
  done
  # A key given to a control in the window leaves the controls that still
  # have it as they were shown, so that moving a key takes one edit (scrcpy
  # keeps a key given twice for its first control)
  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    [[ "${read_keys_ref[${control}]}" != "${shown[${control}]}" ]] || continue
    for other in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
      [[ "${other}" != "${control}" && "${read_keys_ref[${other}]}" == "${shown[${other}]}" ]] || continue
      read -r -a words <<<"${read_keys_ref[${other}]}"
      kept=()
      for key in "${words[@]}"; do
        [[ " ${read_keys_ref[${control}],,} " == *" ${key,,} "* ]] || kept+=("${key}")
      done
      read_keys_ref[${other}]="${kept[*]}"
    done
  done
  # yad prints numbers with decimals, and the choices as shown
  value="${form_values[stick_ramp_ms]:-}"
  read_settings_ref[stick_ramp_ms]="${value%%[.,]*}"
  value="${form_values[walk_percent]:-}"
  read_settings_ref[walk_percent]="${value%%[.,]*}"
  case "${form_values[socd]:-}" in
    "Cancel out") read_settings_ref[socd]="neutral" ;;
    *) read_settings_ref[socd]="last" ;;
  esac
  case "${form_values[mouse_stick]:-}" in
    "Right stick") read_settings_ref[mouse_stick]="right" ;;
    "Left stick") read_settings_ref[mouse_stick]="left" ;;
    *) read_settings_ref[mouse_stick]="off" ;;
  esac
  value="${form_values[mouse_sensitivity]:-}"
  read_settings_ref[mouse_sensitivity]="${value%%[.,]*}"
  read_settings_ref[socd_dpad]="${read_app_settings_ref[socd_dpad]:-}"
  read_settings_ref[socd_left_stick]="${read_app_settings_ref[socd_left_stick]:-}"
  read_settings_ref[socd_right_stick]="${read_app_settings_ref[socd_right_stick]:-}"
}

# ika app --controller NAME without the tabbed window (see edit_app_settings):
# a window (yad) of its own, "Gamepad Emulation · LABEL", with the keyboard
# gamepad's keys and settings for the game, from its mapping, else from
# ika.ini. "Apply settings" saves them in the game's mapping and ticks "Use the
# keyboard to emulate a gamepad" in the game's start options if it is not,
# "Apply and start" does that and starts the game, "Reset to default" asks
# whether to reset the app's start options and remove the game's mapping
# (reset_app_to_default) and, if so, shows ika.ini's in the window, and
# Cancel leaves the rest as it was.
edit_controller_mapping() {
  local name="$1"
  local package
  local label
  local output
  local status=0
  local default_used=false
  local -a fields=()
  local -a saved=()
  local -a yad_env=()
  local -A blank_at=()
  local -A keys=()
  local -A settings=()
  local -A app_settings=()
  local -a mapping_env=()
  local -a mapping_options=()

  resolve_settings_app "${name}" package label
  command -v yad >/dev/null 2>&1 \
    || die "the controller mapping window needs yad; install it"
  set_yad_env yad_env
  yad_css mapping_env mapping_options yad_env gamepad "${CONTROLLER_MAPPING_FORM_CSS}"

  load_controller_mapping_form "${package}" keys settings app_settings
  # The window is shown again after "Reset to default", with the default
  # mapping once confirmed, else with the edits as they were
  while true; do
    controller_mapping_form_fields keys settings fields blank_at true
    status=0
    output="$(env "${yad_env[@]}" "${mapping_env[@]}" yad \
      "${APP_SETTINGS_WINDOW_OPTIONS[@]}" --form \
      --title="Gamepad Emulation · ${label}" --window-icon="${IKA_MENU_ICON}" \
      --center --borders=12 --text="$(controller_mapping_form_text)" \
      --text-align=center --separator="|" --columns=2 "${mapping_options[@]}" \
      --align=right "${fields[@]}" \
      --buttons-layout=spread --button="Reset to default:4" \
      --button="Apply settings:2" --button="        Apply and start        :0" \
      --button=Cancel:1)" \
      || status=$?
    # yad prints the fields for even exit codes only: "Reset to default" is 4
    # so that the window can come back with the edits
    case "${status}" in
      0|2|4)
        ;;
      1|252)
        if [[ "${default_used}" == "true" ]]; then
          respond "${label} has its default start options and ika.ini's controller mapping again"
        else
          respond "Controller mapping of ${label} left as it was"
        fi
        return 0
        ;;
      *)
        die "could not open the controller mapping window (yad exited with ${status})"
        ;;
    esac

    read_controller_mapping_form "${output}" blank_at keys settings app_settings
    [[ "${status}" -eq 4 ]] || break
    if confirm_reset_to_default "${label}"; then
      reset_app_to_default "${package}"
      default_used=true
      load_controller_mapping_form "${package}" keys settings app_settings
    fi
  done
  save_controller_mapping "${package}" keys settings

  # The mapping is of use with the keyboard as a gamepad
  read -r -a saved <<<"$(saved_app_options "${package}")"
  if [[ " ${saved[*]} " != *" gamekb "* ]]; then
    save_app_options "${package}" "${saved[@]}" gamekb
    respond "Controller mapping of ${label} saved; it starts with the keyboard as a gamepad"
  else
    respond "Controller mapping of ${label} saved"
  fi
  if [[ "${status}" -eq 0 ]]; then
    open_app_window "${package}" false "" ""
  fi
}

# The program of ika's window, in Python: yad's form fields in the tabs of a
# GTK 3 window (Gtk.Notebook), native on Wayland as on X11, where yad's own
# tabbed window (--notebook) needs X11 and so XWayland. Its arguments are
# described at its start; ika_window runs it.
ika_window_py() {
  cat <<'PYTHON'
import json
import sys

# yad's form fields, in tabs of a GTK 3 window of its own (Gtk.Notebook), which
# runs natively on Wayland and X11 alike, unlike yad's notebook (XEmbed).
#
#   --title=TEXT --icon=NAME --app-id=ID --active-tab=N
#   --button=LABEL:CODE ...
#   then, per tab: --tab=NAME --output=FILE [--columns=N] [--align=right]
#   [--text=MARKUP] [--border=PX] [--compact] [--field=LABEL:TYPE VALUE]...
#
# A field's TYPE is NUM (VALUE "N!MIN..MAX!STEP"), CB ("a!^b!c", ^ the chosen
# one), CHK (TRUE or FALSE), LBL (LABEL is markup), or anything else for a
# text entry; yad splits LABEL from TYPE at the last colon. Fields fill the
# columns in turn, the first ceil(n / N) the first column. A button, or
# closing the window (252, as Escape), writes each tab's values to its
# output as yad prints them, each followed by "|", and exits with its code.
# --parse-only prints what was parsed, as JSON, and --print-defaults writes
# the outputs as the window would show them, then exits with
# --test-status=CODE: neither needs a display.


def parse(argv):
    window = {"title": "", "icon": "", "app_id": "", "active_tab": 1,
              "buttons": [], "tabs": [], "mode": "", "test_status": 0}
    tab = None
    i = 0
    while i < len(argv):
        arg = argv[i]
        name, _, value = arg.partition("=")
        if name == "--field":
            if tab is None:
                raise SystemExit("ika window: --field before --tab")
            label, colon, ftype = value.rpartition(":")
            if not colon:
                label, ftype = value, ""
            field_value = argv[i + 1] if i + 1 < len(argv) else ""
            tab["fields"].append({"label": label, "type": ftype, "value": field_value})
            i += 2
            continue
        i += 1
        if name == "--tab":
            tab = {"name": value, "output": "", "columns": 1, "align": "left",
                   "text": "", "border": 0, "compact": False, "fields": []}
            window["tabs"].append(tab)
        elif tab is not None and name in ("--output", "--align", "--text"):
            tab[name[2:]] = value
        elif tab is not None and name in ("--columns", "--border"):
            tab[name[2:]] = max(int(value or 0), 1 if name == "--columns" else 0)
        elif tab is not None and name == "--compact":
            tab["compact"] = True
        elif name == "--button":
            label, _, code = value.rpartition(":")
            window["buttons"].append({"label": label.strip(), "code": int(code)})
        elif name == "--active-tab":
            window["active_tab"] = int(value or 1)
        elif name == "--test-status":
            window["test_status"] = int(value or 0)
        elif name in ("--title", "--icon", "--app-id"):
            window[name[2:].replace("-", "_")] = value
        elif name in ("--parse-only", "--print-defaults"):
            window["mode"] = name[2:]
        else:
            raise SystemExit("ika window: unknown argument " + arg)
    return window


def number_spec(value):
    """N!MIN..MAX!STEP as numbers, yad's defaults where missing."""
    parts = value.split("!")
    number = float(parts[0] or 0)
    low, high, step = 0.0, 65535.0, 1.0
    if len(parts) > 1 and ".." in parts[1]:
        low_text, _, high_text = parts[1].partition("..")
        low, high = float(low_text or 0), float(high_text or 0)
    if len(parts) > 2 and parts[2]:
        step = float(parts[2])
    return number, low, high, step


def choices(value):
    """The choices of CB's VALUE, and the index of the one marked with ^."""
    items = []
    active = 0
    for item in value.split("!"):
        if item.startswith("^"):
            active = len(items)
            item = item[1:]
        items.append(item)
    return items, active


def default_value(field):
    """What the window shows for FIELD before it is changed, as yad prints it."""
    ftype = field["type"]
    if ftype == "LBL":
        return ""
    if ftype == "NUM":
        return str(int(number_spec(field["value"])[0]))
    if ftype == "CB":
        items, active = choices(field["value"])
        return items[active] if items else ""
    if ftype == "CHK":
        return "TRUE" if field["value"].upper() == "TRUE" else "FALSE"
    return field["value"]


def write_outputs(window, values):
    for tab, tab_values in zip(window["tabs"], values):
        if tab["output"]:
            with open(tab["output"], "w", encoding="utf-8") as output:
                output.write("".join(value + "|" for value in tab_values) + "\n")


CSS = b"""
.ika-compact { font-size: 85%; }
.ika-compact entry, .ika-compact spinbutton, .ika-compact combobox button {
  min-height: 20px; padding-top: 1px; padding-bottom: 1px; }
.ika-compact spinbutton button { min-height: 0; padding-top: 0; padding-bottom: 0; }
"""


def run(window):
    from gi.repository import GLib
    if window["app_id"]:
        # The app ID on Wayland, the class on X11: the desktop entry of that
        # name gives the window its icon in the dock and the task bar
        GLib.set_prgname(window["app_id"])
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gtk
    if window["app_id"]:
        Gdk.set_program_class(window["app_id"])

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    readers = []
    result = {"code": 252}

    def finish(code):
        write_outputs(window, [[read() for read in tab_readers] for tab_readers in readers])
        result["code"] = code
        Gtk.main_quit()

    gtk_window = Gtk.Window(title=window["title"])
    if window["icon"]:
        gtk_window.set_icon_name(window["icon"])
        Gtk.Window.set_default_icon_name(window["icon"])
    gtk_window.set_position(Gtk.WindowPosition.CENTER)
    gtk_window.connect("delete-event", lambda *_: finish(252) or True)
    gtk_window.connect(
        "key-press-event",
        lambda _, event: (finish(252) or True) if event.keyval == Gdk.KEY_Escape else False)

    notebook = Gtk.Notebook()
    if len(window["tabs"]) < 2:
        notebook.set_show_tabs(False)
        notebook.set_show_border(False)
    for tab in window["tabs"]:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        page.set_border_width(tab["border"])
        if tab["compact"]:
            page.get_style_context().add_class("ika-compact")
        if tab["text"]:
            text = Gtk.Label()
            text.set_markup(tab["text"])
            text.set_justify(Gtk.Justification.CENTER)
            page.pack_start(text, False, False, 0)
        fields = tab["fields"]
        columns = tab["columns"]
        rows = -(-len(fields) // columns) if fields else 0
        stretch = columns > 1
        # Several columns are a grid, as yad's; one is rows of their own, a
        # label and its field beside it, the labels as wide as the widest,
        # so that a checkbox or a label across the row widens no column
        row_spacing = 3 if tab["compact"] else 5
        grid = Gtk.Grid(row_spacing=row_spacing, column_spacing=8)
        rows_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=row_spacing)
        captions = Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)
        page.pack_start(grid if stretch else rows_box, False, False, 0)

        def place(widget, row, x, width, caption=None):
            if stretch:
                if caption is not None:
                    grid.attach(caption, x, row, 1, 1)
                    grid.attach(widget, x + 1, row, 1, 1)
                else:
                    grid.attach(widget, x, row, width, 1)
            elif caption is not None:
                line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                captions.add_widget(caption)
                line.pack_start(caption, False, False, 0)
                line.pack_start(widget, widget.get_hexpand(), widget.get_hexpand(), 0)
                rows_box.pack_start(line, False, False, 0)
            else:
                rows_box.pack_start(widget, False, False, 0)

        tab_readers = []
        for index, field in enumerate(fields):
            row, column = index % rows, index // rows
            x = column * 2
            label, ftype, value = field["label"], field["type"], field["value"]
            if ftype == "LBL":
                widget = Gtk.Label()
                widget.set_markup(label)
                widget.set_xalign(0)
                place(widget, row, x, 2)
                tab_readers.append(lambda: "")
                continue
            if ftype == "CHK":
                widget = Gtk.CheckButton(label=label)
                widget.set_active(value.upper() == "TRUE")
                place(widget, row, x, 2)
                tab_readers.append(lambda w=widget: "TRUE" if w.get_active() else "FALSE")
                continue
            caption = Gtk.Label(label=label)
            caption.set_xalign(1 if tab["align"] == "right" else 0)
            if ftype == "NUM":
                number, low, high, step = number_spec(value)
                widget = Gtk.SpinButton.new_with_range(low, high, step)
                widget.set_digits(0)
                widget.set_value(number)
                widget.set_width_chars(max(len(str(int(high))), 3))
                tab_readers.append(lambda w=widget: str(w.get_value_as_int()))
            elif ftype == "CB":
                items, active = choices(value)
                widget = Gtk.ComboBoxText()
                for item in items:
                    widget.append_text(item)
                widget.set_active(active)
                tab_readers.append(lambda w=widget: w.get_active_text() or "")
            else:
                widget = Gtk.Entry()
                widget.set_text(value)
                widget.set_width_chars(18)
                widget.set_activates_default(True)
                tab_readers.append(lambda w=widget: w.get_text())
            if stretch or ftype not in ("NUM", "CB"):
                widget.set_hexpand(True)
            else:
                widget.set_halign(Gtk.Align.START)
            # The second column's labels a little apart from the first's fields
            if column:
                caption.set_margin_start(24)
            place(widget, row, x, 1, caption)
        readers.append(tab_readers)
        notebook.append_page(page, Gtk.Label(label=tab["name"]))

    # The buttons as wide as each other, across the window's width
    buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, homogeneous=True)
    for button in window["buttons"]:
        widget = Gtk.Button(label=button["label"])
        widget.connect("clicked", lambda _, code=button["code"]: finish(code))
        buttons.pack_start(widget, True, True, 0)

    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    content.set_border_width(12)
    content.pack_start(notebook, True, True, 0)
    content.pack_start(buttons, False, False, 0)
    gtk_window.add(content)
    gtk_window.show_all()
    notebook.set_current_page(max(window["active_tab"], 1) - 1)
    Gtk.main()
    return result["code"]


def main(argv):
    window = parse(argv)
    if window["mode"] == "parse-only":
        print(json.dumps(window, indent=1, ensure_ascii=False))
        return 0
    if window["mode"] == "print-defaults":
        write_outputs(window, [[default_value(field) for field in tab["fields"]]
                               for tab in window["tabs"]])
        return window["test_status"]
    return run(window)


sys.exit(main(sys.argv[1:]))
PYTHON
}

# Whether ika's window can open: python3 with GTK 3's bindings (python3-gobject
# and gtk3 on Fedora, python3-gi and gir1.2-gtk-3.0 on Debian), which the
# packages depend on.
ika_window_available() {
  if [[ -z "${IKA_WINDOW_AVAILABLE:-}" ]]; then
    if python3 -I -c 'import gi; gi.require_version("Gtk", "3.0")' >/dev/null 2>&1; then
      IKA_WINDOW_AVAILABLE=yes
    else
      IKA_WINDOW_AVAILABLE=no
    fi
  fi
  [[ "${IKA_WINDOW_AVAILABLE}" == "yes" ]]
}

# Runs ika's window (ika_window_py) with the environment of the array named
# ENV_VAR and the arguments that follow; its exit status is the code of the
# button that closed it, 252 when it was closed otherwise. The program comes
# on its standard input, which keeps its command line short in ps.
ika_window() {
  local -n ika_window_env_ref="$1"
  shift
  ika_window_py | env "${ika_window_env_ref[@]}" python3 -I - "$@"
}

# "Startup options" on a launcher (ika app --options NAME: TAB 1) and ika
# app --controller NAME (TAB 2): an app's start options and controller mapping
# in one window, "Startup Options · LABEL", with a tab for each, Startup
# Options and Gamepad Emulation, opened on TAB, the same for games and other
# apps: ika's window (ika_window), native on Wayland and X11. Without
# python3's GTK 3 bindings each tab opens as a window of its own (yad).
#
# "Apply settings" saves the start options and the display density, and the
# mapping when it was edited or the app has one of its own: an untouched
# mapping would become the app's own copy of ika.ini's. An edited mapping
# ticks "Keyboard as a gamepad", unless the window unticked
# it. "Apply and start" also starts the app. "Reset to default" asks whether
# to reset the app's start options and remove the app's mapping
# (reset_app_to_default) and, if so, shows the default start options and
# ika.ini's mapping, on the Startup Options tab. Cancel, or closing the
# window, leaves everything else as it was.
edit_app_settings() {
  local name="$1"
  local tab="${2:-1}"
  local package
  local label
  local status=0
  local option
  local dpi
  local tab_dir
  local mapping_file
  local shown_mapping
  local mapping_edited=false
  local mapping_saved=false
  local default_used=false
  local -a saved=()
  local -a options=()
  local -a kept=()
  local -a fields1=()
  local -a fields2=()
  local -a yad_env=()
  local -A ticked=()
  local -A blank_at=()
  local -A keys=()
  local -A settings=()
  local -A app_settings=()

  resolve_settings_app "${name}" package label
  if ! ika_window_available; then
    log "python3's GTK 3 bindings are missing (python3-gobject, or python3-gi and gir1.2-gtk-3.0); opening the tab as a window of its own"
    if [[ "${tab}" == "1" ]]; then
      edit_app_options "${package}"
    else
      edit_controller_mapping "${package}"
    fi
    return 0
  fi

  read -r -a saved <<<"$(saved_app_options "${package}")"
  for option in "${saved[@]}"; do
    ticked[${option}]="true"
  done
  dpi="$(saved_app_dpi "${package}")"
  mapping_file="$(app_controller_mapping_file "${package}")"
  load_controller_mapping_form "${package}" keys settings app_settings
  shown_mapping="$(controller_mapping_form_signature keys settings)"
  set_yad_env yad_env
  mkdir -p "${CVD_TMP_DIR}"
  tab_dir="$(mktemp -d "${CVD_TMP_DIR}/app-settings.XXXXXX")"

  # The window is shown again after "Reset to default", on the Startup
  # Options tab, with the defaults once confirmed, else with the edits as
  # they were
  while true; do
    app_options_form_fields "${label}" "${dpi}" ticked fields1
    controller_mapping_form_fields keys settings fields2 blank_at false
    status=0
    ika_window yad_env --title="Startup Options · ${label}" \
      --icon="${IKA_MENU_ICON}" --app-id="${APP_SETTINGS_WINDOW_CLASS}" \
      --active-tab="${tab}" --button="Reset to default:4" \
      --button="Apply settings:2" --button="Apply and start:0" --button="Cancel:1" \
      --tab="Startup Options" --output="${tab_dir}/1" \
      --border="${APP_OPTIONS_TAB_BORDER_PX}" "${fields1[@]}" \
      --tab="Gamepad Emulation" --output="${tab_dir}/2" --compact --columns=2 \
      --border="${CONTROLLER_MAPPING_TAB_BORDER_PX}" --align=right \
      --text="$(controller_mapping_form_text)" "${fields2[@]}" \
      || status=$?
    case "${status}" in
      0|2|4)
        ;;
      1|252)
        rm -rf "${tab_dir}"
        if [[ "${default_used}" == "true" ]]; then
          respond "${label} has its default start options and ika.ini's controller mapping again"
        else
          respond "Start options and controller mapping of ${label} left as they were"
        fi
        return 0
        ;;
      *)
        rm -rf "${tab_dir}"
        die "could not open the start options window (it exited with ${status})"
        ;;
    esac

    read_app_options_form "$(<"${tab_dir}/1")" options dpi
    ticked=()
    for option in "${options[@]}"; do
      ticked[${option}]="true"
    done
    read_controller_mapping_form "$(<"${tab_dir}/2")" blank_at keys settings app_settings
    [[ "${status}" -eq 4 ]] || break
    tab=1
    if confirm_reset_to_default "${label}"; then
      reset_app_to_default "${package}"
      default_used=true
      read -r -a saved <<<"$(default_app_options "${package}")"
      ticked=()
      for option in "${saved[@]}"; do
        ticked[${option}]="true"
      done
      dpi=""
      load_controller_mapping_form "${package}" keys settings app_settings
      shown_mapping="$(controller_mapping_form_signature keys settings)"
    fi
  done
  rm -rf "${tab_dir}"

  if [[ "$(controller_mapping_form_signature keys settings)" != "${shown_mapping}" ]]; then
    mapping_edited=true
  fi
  if [[ "${mapping_edited}" == "true" || -e "${mapping_file}" ]]; then
    save_controller_mapping "${package}" keys settings
    mapping_saved=true
  fi
  # An edited mapping is of use with the keyboard as a gamepad, unless that
  # was unticked in the window; the options keep their usual order
  if [[ "${mapping_edited}" == "true" && " ${saved[*]} " != *" gamekb "* ]]; then
    ticked[gamekb]="true"
  fi
  kept=()
  for option in "${APP_START_OPTIONS[@]}"; do
    [[ -z "${ticked[${option}]:-}" ]] || kept+=("${option}")
  done
  save_app_options_form "${package}" "${label}" "${dpi}" "${kept[@]}"
  if [[ "${mapping_saved}" == "true" ]]; then
    respond "Controller mapping of ${label} saved"
  elif [[ "${default_used}" == "true" ]]; then
    respond "${label} uses the controller mapping of ika.ini again"
  fi
  if [[ "${status}" -eq 0 ]]; then
    open_app_window "${package}" false "" ""
  fi
}

# ============================================================================
# Ika's own start options (ika options): "Startup options" on Ika's launcher
# ============================================================================

# The ika.ini settings of the Startup Options tab of Ika's window, as
# SECTION.KEY, in its order, and their built-in values, as ika.ini's template
# has them.
IKA_OPTIONS_SETTINGS=(compute.cpus compute.memory_mb console.dpi console.tv_dpi
  console.refresh_rate_hz gpu.gpu_mode gpu.gfxstream_vulkan gpu.hw_video_decode
  lowcpu.mode camera.device console.tv_keyboard_gamepad)
declare -A IKA_OPTIONS_DEFAULTS=(
  [console.dpi]="auto" [console.tv_dpi]="auto" [console.refresh_rate_hz]="auto"
  [compute.cpus]="auto" [compute.memory_mb]="auto"
  [gpu.gpu_mode]="auto" [gpu.gfxstream_vulkan]="auto"
  [gpu.hw_video_decode]="auto" [lowcpu.mode]="auto" [camera.device]="off"
  [console.tv_keyboard_gamepad]="false"
)
# The GPU modes the window offers, as ika.ini spells them, two of which are
# two settings: IKA_OPTIONS_GLES_ONLY is gfxstream with gfxstream_vulkan = off,
# and gfxstream, or IKA_OPTIONS_AUTO (gpu_mode = auto), chosen from another is
# that mode with gfxstream_vulkan = auto. ika.ini's own GPU mode, when
# another, is offered too.
IKA_OPTIONS_AUTO="auto"
IKA_OPTIONS_GLES_ONLY="gfxstream, OpenGL ES only"
IKA_OPTIONS_GPU_CHOICES=("${IKA_OPTIONS_AUTO}" gfxstream_guest_angle gfxstream
  "${IKA_OPTIONS_GLES_ONLY}" venus guest_swiftshader guest_lavapipe)
# In the Startup Options window of its own (yad, without ika's window) the
# number boxes and choices stretch across their column; a margin on their
# right keeps a number box about as wide as four digits and its buttons, and
# a choice as wide as the longest GPU mode.
IKA_OPTIONS_TAB_CSS='spinbutton { margin-right: 420px; }
combobox { margin-right: 320px; }'

# Prints VALUE, ika.ini's value of SETTING (SECTION.KEY of the Startup Options
# tab), as the window shows it: auto or a number for the numbers (a density
# under 96 is 96), the choices in lowercase, true or false; a value the window
# cannot show is shown as its built-in one.
ika_option_value() {
  local setting="$1"
  local value="${2,,}"

  case "${setting}" in
    console.dpi|console.tv_dpi)
      value="$(app_dpi_value "${value}" 2>/dev/null)" || value=""
      printf '%s\n' "${value:-auto}"
      ;;
    console.refresh_rate_hz|compute.cpus|compute.memory_mb)
      if [[ "${value}" =~ ^[1-9][0-9]*$ ]]; then
        printf '%s\n' "${value}"
      else
        printf 'auto\n'
      fi
      ;;
    gpu.gpu_mode)
      printf '%s\n' "${value:-${IKA_OPTIONS_DEFAULTS[${setting}]}}"
      ;;
    gpu.gfxstream_vulkan)
      case "${value}" in
        1|true|yes|on|enable|enabled) printf 'on\n' ;;
        0|false|no|off|disable|disabled) printf 'off\n' ;;
        *) printf 'auto\n' ;;
      esac
      ;;
    gpu.hw_video_decode)
      case "${value}" in
        0|false|no|off|disable|disabled) printf 'off\n' ;;
        *) printf 'auto\n' ;;
      esac
      ;;
    lowcpu.mode)
      case "${value}" in
        1|true|yes|on|enable|enabled) printf 'on\n' ;;
        0|false|no|off|disable|disabled) printf 'off\n' ;;
        *) printf 'auto\n' ;;
      esac
      ;;
    camera.device)
      case "${value}" in
        auto|on|true|yes|1) printf 'auto\n' ;;
        video[0-9]*|/dev/video[0-9]*) printf '%s\n' "${2}" ;;
        *) printf 'off\n' ;;
      esac
      ;;
    console.tv_keyboard_gamepad)
      case "${value}" in
        1|true|yes|on) printf 'true\n' ;;
        *) printf 'false\n' ;;
      esac
      ;;
  esac
}

# Sets the associative array named VALUES_VAR to the Startup Options tab's
# settings as ika.ini has them, else their built-in values, each as
# ika_option_value prints it.
load_ika_options_form() {
  local -n ika_values_ref="$1"
  local setting
  local value

  ika_values_ref=()
  for setting in "${IKA_OPTIONS_SETTINGS[@]}"; do
    ika_ini_get value "${setting%%.*}" "${setting#*.}" "${IKA_OPTIONS_DEFAULTS[${setting}]}"
    ika_values_ref[${setting}]="$(ika_option_value "${setting}" "${value}")"
  done
}

# Sets the associative arrays named KEYS_VAR and SETTINGS_VAR to the keyboard
# gamepad of ika.ini, as keyboard_gamepad_spec gives it to the TV console and
# to apps without a mapping of their own: a key an ika.ini line gives a
# control is gone from the control it is a default of.
load_ika_mapping_form() {
  local -n ika_keys_ref="$1"
  local -n ika_settings_ref="$2"
  local control
  local setting
  local key
  local -a words=()
  local -a kept=()
  local -A given_keys=()

  ika_keys_ref=()
  ika_settings_ref=()
  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    [[ -n "${IKA_INI[keyboard_gamepad.${control}]+set}" ]] || continue
    read -r -a words <<<"${KEYBOARD_GAMEPAD_KEYS[${control}]}"
    for key in "${words[@]}"; do
      given_keys["${key,,}"]=1
    done
  done
  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    read -r -a words <<<"${KEYBOARD_GAMEPAD_KEYS[${control}]}"
    if [[ -z "${IKA_INI[keyboard_gamepad.${control}]+set}" ]]; then
      kept=()
      for key in "${words[@]}"; do
        [[ -n "${given_keys[${key,,}]+set}" ]] || kept+=("${key}")
      done
      words=("${kept[@]}")
    fi
    ika_keys_ref[${control}]="${words[*]}"
  done
  for setting in "${KEYBOARD_GAMEPAD_SETTINGS[@]}"; do
    ika_settings_ref[${setting}]="$(normalize_keyboard_gamepad_setting "${setting}" \
      "${KEYBOARD_GAMEPAD_SETTING_VALUES[${setting}]}" \
      "${KEYBOARD_GAMEPAD_DEFAULT_SETTING_VALUES[${setting}]}")"
  done
}

# Prints the GPU mode choice of the associative array named VALUES_VAR:
# IKA_OPTIONS_GLES_ONLY for gfxstream with gfxstream_vulkan = off,
# IKA_OPTIONS_AUTO for auto, else the GPU mode.
ika_gpu_choice() {
  local -n choice_values_ref="$1"

  if [[ "${choice_values_ref[gpu.gpu_mode]}" == "gfxstream" \
      && "${choice_values_ref[gpu.gfxstream_vulkan]}" == "off" ]]; then
    printf '%s\n' "${IKA_OPTIONS_GLES_ONLY}"
  elif [[ "${choice_values_ref[gpu.gpu_mode]}" == "auto" ]]; then
    printf '%s\n' "${IKA_OPTIONS_AUTO}"
  else
    printf '%s\n' "${choice_values_ref[gpu.gpu_mode]}"
  fi
}

# Prints the number box value of SETTING in the associative array named
# VALUES_VAR: its number, or 0 for auto.
ika_option_number() {
  local -n number_values_ref="$1"
  local value="${number_values_ref[$2]}"

  [[ "${value}" =~ ^[0-9]+$ ]] || value=0
  printf '%s\n' "${value}"
}

# Sets the array named FIELDS_VAR to the Startup Options tab of Ika's window
# for the associative array named VALUES_VAR, for yad: the vCPUs and the
# memory, the densities and the refresh rate, 0 for auto; the GPU mode, hardware
# video decoding and low-CPU mode; then the camera at every start and the
# keyboard gamepad in TV mode.
ika_options_form_fields() {
  local -n form_values_ref="$1"
  local -n ika_fields_ref="$2"
  local host_cpus
  local host_mb
  local value
  local mode
  local current
  local choices=""
  local -a modes=()

  for mode in "${IKA_OPTIONS_GPU_CHOICES[@]}"; do
    modes+=("${mode}")
  done
  host_cpus="$(nproc 2>/dev/null)" || host_cpus=64
  host_mb="$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null)"
  [[ "${host_mb}" =~ ^[0-9]+$ ]] || host_mb=65536
  # A value of ika.ini's above the host's stays as it is
  value="$(ika_option_number form_values_ref compute.cpus)"
  (( value <= host_cpus )) || host_cpus="${value}"
  value="$(ika_option_number form_values_ref compute.memory_mb)"
  (( value <= host_mb )) || host_mb="${value}"
  current="$(ika_gpu_choice form_values_ref)"
  for mode in "${modes[@]}"; do
    [[ "${mode}" != "${current}" ]] || current=""
  done
  [[ -z "${current}" ]] || modes+=("${current}")
  current="$(ika_gpu_choice form_values_ref)"
  for mode in "${modes[@]}"; do
    [[ "${mode}" != "${current}" ]] || choices+="^"
    choices+="${mode}!"
  done

  ika_fields_ref=(--field="CPUs, 0=Auto  :NUM" "$(ika_option_number form_values_ref compute.cpus)!0..${host_cpus}!1")
  ika_fields_ref+=(--field="RAM, MB, 0=Auto  :NUM" "$(ika_option_number form_values_ref compute.memory_mb)!0..${host_mb}!1024")
  ika_fields_ref+=(--field="Desktop display density, 0=Auto  :NUM" "$(ika_option_number form_values_ref console.dpi)!0..999!8")
  ika_fields_ref+=(--field="TV display density, 0=Auto  :NUM" "$(ika_option_number form_values_ref console.tv_dpi)!0..999!8")
  ika_fields_ref+=(--field="Refresh rate, Hz, 0=Auto  :NUM" "$(ika_option_number form_values_ref console.refresh_rate_hz)!0..360!1")
  ika_fields_ref+=(--field="GPU mode  :CB" "${choices%!}")
  case "${form_values_ref[gpu.hw_video_decode]}" in
    off) ika_fields_ref+=(--field="Hardware video decoding  :CB" "Auto!^Off") ;;
    *) ika_fields_ref+=(--field="Hardware video decoding  :CB" "^Auto!Off") ;;
  esac
  case "${form_values_ref[lowcpu.mode]}" in
    on) ika_fields_ref+=(--field="Low-CPU mode  :CB" "Auto!^On!Off") ;;
    off) ika_fields_ref+=(--field="Low-CPU mode  :CB" "Auto!On!^Off") ;;
    *) ika_fields_ref+=(--field="Low-CPU mode  :CB" "^Auto!On!Off") ;;
  esac
  ika_fields_ref+=(--field="<span font_size='8pt'> </span>:LBL" "")
  ika_fields_ref+=(--field="  Start with the camera:CHK")
  if [[ "${form_values_ref[camera.device]}" == "off" ]]; then
    ika_fields_ref+=(FALSE)
  else
    ika_fields_ref+=(TRUE)
  fi
  ika_fields_ref+=(--field="  Enable gamepad emulation in TV mode:CHK")
  if [[ "${form_values_ref[console.tv_keyboard_gamepad]}" == "true" ]]; then
    ika_fields_ref+=(TRUE)
  else
    ika_fields_ref+=(FALSE)
  fi
  ika_fields_ref+=(--field="<span font_size='8pt'> </span>:LBL" "")
}

# Reads the Startup Options tab's OUTPUT, a value per field in the order of
# ika_options_form_fields, over the values it showed, into the
# associative array named VALUES_VAR, as ika_option_value prints them.
read_ika_options_form() {
  local output="$1"
  local -n read_values_ref="$2"
  local -a words=()
  local value
  local choice
  local i=0
  local setting

  IFS='|' read -r -a words <<<"${output}"
  for setting in compute.cpus compute.memory_mb console.dpi console.tv_dpi console.refresh_rate_hz; do
    value="${words[i]%%[.,]*}"
    [[ "${value}" =~ ^[1-9][0-9]*$ ]] || value="auto"
    read_values_ref[${setting}]="$(ika_option_value "${setting}" "${value}")"
    i=$((i + 1))
  done
  # The GPU mode choice, read only when it changed, so that a gfxstream_vulkan
  # of ika.ini's stays as it is otherwise
  choice="${words[5]:-}"
  if [[ -n "${choice}" && "${choice}" != "$(ika_gpu_choice read_values_ref)" ]]; then
    case "${choice}" in
      "${IKA_OPTIONS_GLES_ONLY}")
        read_values_ref[gpu.gpu_mode]="gfxstream"
        read_values_ref[gpu.gfxstream_vulkan]="off"
        ;;
      gfxstream)
        read_values_ref[gpu.gpu_mode]="gfxstream"
        read_values_ref[gpu.gfxstream_vulkan]="auto"
        ;;
      "${IKA_OPTIONS_AUTO}")
        read_values_ref[gpu.gpu_mode]="auto"
        read_values_ref[gpu.gfxstream_vulkan]="auto"
        ;;
      *)
        read_values_ref[gpu.gpu_mode]="${choice}"
        ;;
    esac
  fi
  read_values_ref[gpu.hw_video_decode]="$(ika_option_value gpu.hw_video_decode "${words[6]:-}")"
  read_values_ref[lowcpu.mode]="$(ika_option_value lowcpu.mode "${words[7]:-}")"
  # Ticked, the camera is the first usable one, unless ika.ini names one
  if [[ "${words[9]:-}" != "TRUE" ]]; then
    read_values_ref[camera.device]="off"
  elif [[ "${read_values_ref[camera.device]}" == "off" ]]; then
    read_values_ref[camera.device]="auto"
  fi
  if [[ "${words[10]:-}" == "TRUE" ]]; then
    read_values_ref[console.tv_keyboard_gamepad]="true"
  else
    read_values_ref[console.tv_keyboard_gamepad]="false"
  fi
}

# Writes the Startup Options tab's settings of the associative array named
# VALUES_VAR, and the keyboard gamepad of KEYS_VAR and SETTINGS_VAR, in
# ika.ini: those that differ from what the window showed, SHOWN_VALUES_VAR,
# SHOWN_KEYS_VAR and SHOWN_SETTINGS_VAR, so that the lines left alone stay as
# they are. Sets the array named CHANGED_VAR to "KEY = VALUE" for each.
save_ika_settings_form() {
  local -n save_values_ref="$1"
  local -n save_keys_ref="$2"
  local -n save_settings_ref="$3"
  local -n shown_values_ref="$4"
  local -n shown_keys_ref="$5"
  local -n shown_settings_ref="$6"
  local -n changed_ref="$7"
  local setting
  local control

  changed_ref=()
  for setting in "${IKA_OPTIONS_SETTINGS[@]}"; do
    [[ "${save_values_ref[${setting}]}" != "${shown_values_ref[${setting}]}" ]] || continue
    ika_ini_set "${setting%%.*}" "${setting#*.}" "${save_values_ref[${setting}]}" \
      || die "could not write ${IKA_INI_FILE}"
    changed_ref+=("${setting#*.} = ${save_values_ref[${setting}]}")
  done
  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    [[ "${save_keys_ref[${control}]}" != "${shown_keys_ref[${control}]}" ]] || continue
    ika_ini_set keyboard_gamepad "${control}" "${save_keys_ref[${control}]}" \
      || die "could not write ${IKA_INI_FILE}"
    changed_ref+=("${control} = ${save_keys_ref[${control}]}")
  done
  for setting in "${CONTROLLER_MAPPING_FORM_SETTINGS[@]}"; do
    [[ "${save_settings_ref[${setting}]}" != "${shown_settings_ref[${setting}]}" ]] || continue
    ika_ini_set keyboard_gamepad "${setting}" "${save_settings_ref[${setting}]}" \
      || die "could not write ${IKA_INI_FILE}"
    changed_ref+=("${setting} = ${save_settings_ref[${setting}]}")
  done
}

# "Reset to default" in Ika's window, once confirmed: ika.ini gets the
# built-in value of each of the window's settings, and the built-in keys and
# settings of the keyboard gamepad.
reset_ika_settings_to_default() {
  local setting
  local control

  for setting in "${IKA_OPTIONS_SETTINGS[@]}"; do
    ika_ini_set "${setting%%.*}" "${setting#*.}" "${IKA_OPTIONS_DEFAULTS[${setting}]}" \
      || die "could not write ${IKA_INI_FILE}"
  done
  for control in "${KEYBOARD_GAMEPAD_CONTROLS[@]}"; do
    ika_ini_set keyboard_gamepad "${control}" "${KEYBOARD_GAMEPAD_DEFAULT_KEYS[${control}]}" \
      || die "could not write ${IKA_INI_FILE}"
    KEYBOARD_GAMEPAD_KEYS[${control}]="${KEYBOARD_GAMEPAD_DEFAULT_KEYS[${control}]}"
  done
  for setting in "${CONTROLLER_MAPPING_FORM_SETTINGS[@]}"; do
    ika_ini_set keyboard_gamepad "${setting}" "${KEYBOARD_GAMEPAD_DEFAULT_SETTING_VALUES[${setting}]}" \
      || die "could not write ${IKA_INI_FILE}"
    KEYBOARD_GAMEPAD_SETTING_VALUES[${setting}]="${KEYBOARD_GAMEPAD_DEFAULT_SETTING_VALUES[${setting}]}"
  done
}

# ika options, and "Startup options" on Ika's launcher: Ika's window, as an
# app's ("Startup Options · Ika", the same size and buttons), with two tabs:
# Startup Options, the common settings of ika.ini (the vCPUs and memory, the
# densities, the refresh rate, the GPU mode, hardware video decoding, low-CPU
# mode, the camera, and the keyboard gamepad in TV mode), and Gamepad
# Emulation,
# ika.ini's keyboard gamepad, which TV mode and apps without a mapping of
# their own use. "Apply settings" writes in ika.ini what was changed, "Apply
# and restart" also restarts Ika, so that they apply, "Reset to default"
# asks, then writes the built-in values and shows them, and Cancel leaves
# ika.ini as it was. Without python3's GTK 3 bindings the Startup Options tab
# opens as a window of its own (yad).
edit_ika_settings() {
  local tabs=true
  local key
  local status=0
  local tab_dir
  local joined=""
  local default_used=false
  local -a fields1=()
  local -a fields2=()
  local -a changed=()
  local -a yad_env=()
  local -a options_env=()
  local -a options_options=()
  local -A values=()
  local -A shown_values=()
  local -A keys=()
  local -A settings=()
  local -A shown_keys=()
  local -A shown_settings=()
  local -A ini_settings=()
  local -A blank_at=()

  command -v yad >/dev/null 2>&1 \
    || die "the start options window needs yad; install it"
  if ! ika_window_available; then
    log "python3's GTK 3 bindings are missing (python3-gobject, or python3-gi and gir1.2-gtk-3.0); opening the Startup Options tab as a window of its own"
    tabs=false
  fi

  set_yad_env yad_env
  if [[ "${tabs}" != "true" ]]; then
    yad_css options_env options_options yad_env ika-options "${IKA_OPTIONS_TAB_CSS}"
  fi
  mkdir -p "${CVD_TMP_DIR}"
  tab_dir="$(mktemp -d "${CVD_TMP_DIR}/ika-settings.XXXXXX")"

  # The window is shown again after "Reset to default", on the Startup Options
  # tab, with the defaults once confirmed, else with the edits as they were
  load_ika_options_form values
  load_ika_mapping_form keys settings
  while true; do
    for key in "${!values[@]}"; do shown_values[${key}]="${values[${key}]}"; done
    for key in "${!keys[@]}"; do shown_keys[${key}]="${keys[${key}]}"; done
    for key in "${!settings[@]}"; do shown_settings[${key}]="${settings[${key}]}"; done
    for key in "${!settings[@]}"; do ini_settings[${key}]="${settings[${key}]}"; done
    ika_options_form_fields values fields1
    controller_mapping_form_fields keys settings fields2 blank_at false
    status=0
    if [[ "${tabs}" == "true" ]]; then
      ika_window yad_env --title="Startup Options · Ika" \
        --icon="${IKA_MENU_ICON}" --app-id="${APP_SETTINGS_WINDOW_CLASS}" \
        --active-tab=1 --button="Reset to default:4" \
        --button="Apply settings:2" --button="Apply and restart:0" --button="Cancel:1" \
        --tab="Startup Options" --output="${tab_dir}/1" \
        --border="${APP_OPTIONS_TAB_BORDER_PX}" "${fields1[@]}" \
        --tab="Gamepad Emulation" --output="${tab_dir}/2" --compact --columns=2 \
        --border="${CONTROLLER_MAPPING_TAB_BORDER_PX}" --align=right \
        --text="$(controller_mapping_form_text)" "${fields2[@]}" \
        || status=$?
    else
      env "${yad_env[@]}" "${options_env[@]}" yad \
        "${APP_SETTINGS_WINDOW_OPTIONS[@]}" --form \
        --title="Startup Options · Ika" --window-icon="${IKA_MENU_ICON}" \
        --center --borders=12 --separator="|" "${options_options[@]}" \
        "${fields1[@]}" \
        --buttons-layout=spread --button="Reset to default:4" \
        --button="Apply settings:2" --button="      Apply and restart      :0" \
        --button=Cancel:1 >"${tab_dir}/1" \
        || status=$?
      printf '' >"${tab_dir}/2"
    fi
    case "${status}" in
      0|2|4)
        ;;
      1|252)
        rm -rf "${tab_dir}"
        if [[ "${default_used}" == "true" ]]; then
          respond "ika.ini has Ika's default start options and keyboard gamepad again"
        else
          respond "ika.ini left as it was"
        fi
        return 0
        ;;
      *)
        rm -rf "${tab_dir}"
        die "could not open the start options window (it exited with ${status})"
        ;;
    esac

    read_ika_options_form "$(<"${tab_dir}/1")" values
    if [[ "${tabs}" == "true" ]]; then
      read_controller_mapping_form "$(<"${tab_dir}/2")" blank_at keys settings ini_settings
    fi
    [[ "${status}" -eq 4 ]] || break
    if confirm_reset_to_default "Ika" \
        "This will reset Ika's startup options and gamepad emulation mappings."; then
      reset_ika_settings_to_default
      default_used=true
      load_ika_options_form values
      load_ika_mapping_form keys settings
    fi
  done
  rm -rf "${tab_dir}"

  save_ika_settings_form values keys settings shown_values shown_keys shown_settings changed
  for key in "${changed[@]}"; do
    joined+="${joined:+, }${key}"
  done
  if [[ "${#changed[@]}" -gt 0 ]]; then
    respond "ika.ini: ${joined}; they apply the next time Ika starts"
  elif [[ "${default_used}" == "true" ]]; then
    respond "ika.ini has Ika's default start options and keyboard gamepad again"
  else
    respond "ika.ini left as it was"
  fi
  if [[ "${status}" -eq 0 ]]; then
    respond "Restarting Ika"
    IKA_NOTIFY=true setsid --fork "${IKA_SCRIPT_PATH}" restart \
      </dev/null >/dev/null 2>&1
  fi
}

# open_app_window NAME FULLSCREEN TITLE SIZE [START_APP [DPI]]: DPI is the
# display density 'ika app --dpi' gives, as app_dpi_value prints it, or auto.
open_app_window() {
  local name="$1"
  local fullscreen_mode="$2"
  local title="$3"
  local window_size="$4"
  local start_app="${5:-}"
  local dpi_given="${6:-}"
  local app_dpi=""
  local package=""
  local label=""
  local resolved
  local adb_serial
  local guest_dpi
  local dpi
  local display_size
  local cuttlefish_display
  local app_icon
  local saved_width=""
  local saved_height=""
  local saved_fullscreen=""
  local window_size_is_default="false"
  local attempt
  local -a scrcpy_env=()
  local -a scrcpy_cmd=()
  local -a guest_queries=()

  require_executable "${SCRCPY_BIN}" "console client"
  # Shift held at a menu launch opens the app's Startup Options instead
  # (APP_SHIFT_CHECK): answered now when Ika would first have to start, else
  # below, once the guest queries have run alongside the probe.
  if [[ "${APP_SHIFT_CHECK:-}" == "true" ]] && ! has_live_cvd_processes \
      && windows_shift_held; then
    edit_app_settings "${name}" 1
    return 0
  fi
  # The guest answers the queries below along with the boot check, in the one
  # adb round trip, instead of one of a tenth of a second each.
  if is_app_package_name "${name}"; then
    guest_queries+=("$(guest_query_package_path "${name}")")
  fi
  guest_queries+=("${GUEST_QUERY_LEANBACK}" "${GUEST_QUERY_DENSITY}")
  # wayland-info, read once here for the host display probes below, which run
  # in subshells that could not share it.
  wayland_info_output >/dev/null 2>&1 || true
  ensure_guest_ready "${guest_queries[@]}"
  adb_serial="$(resolve_adb_serial)"

  # A package name is used as given (menu launchers pass one); anything else is
  # looked up by label.
  if is_app_package_name "${name}" \
      && app_is_installed "${name}" "${adb_serial}"; then
    package="${name}"
    label="$(app_display_name "${package}")"
    [[ "${label}" != "${package}" ]] || label=""
  else
    resolved="$(resolve_launchable_app "${name}" "${adb_serial}")" || exit 1
    package="${resolved#*$'\t'}"
    label="${resolved%%$'\t'*}"
  fi
  if [[ -z "${title}" ]]; then
    title="${label}"
  fi
  validate_app_package "${package}"
  if [[ "${APP_SHIFT_CHECK:-}" == "true" ]] && windows_shift_held; then
    edit_app_settings "${name}" 1
    return 0
  fi
  apply_saved_app_options "${package}" fullscreen_mode
  scrcpy_env=("IKA_APP_PACKAGE=${package}")

  use_app_window_paths "${package}"
  (umask 077 && mkdir -p "${IKA_APPS_DIR}/${package}")
  # Cache the label so the window can later be matched by name.
  if [[ -n "${label}" ]]; then
    printf '%s\n' "${label}" > "${IKA_APPS_DIR}/${package}/title"
  fi

  if supervisor_pid_from_file "${SCRCPY_SUPERVISOR_PID_FILE}" __app_supervisor >/dev/null; then
    respond "${label:-${package}} is already open in its own window"
    return 0
  fi

  if [[ -z "${title}" ]]; then
    title="$(app_window_title "${package}" "${adb_serial}")"
  fi

  if [[ -z "${window_size}" ]]; then
    if read_scrcpy_window_state "${SCRCPY_WINDOW_STATE_FILE}" \
        saved_width saved_height saved_fullscreen; then
      window_size="${saved_width}x${saved_height}"
    else
      window_size="$(default_app_window_size)"
      window_size_is_default="true"
    fi
  fi
  [[ "${window_size}" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]] \
    || die "--size must be WIDTHxHEIGHT (example: 1600x900)"
  window_size="$(clamp_app_window_size "${window_size}")"

  # App windows are desktop windows: at the console's density on the desktop,
  # and in TV mode, where the console runs at the TV density, at the desktop's.
  if [[ "$(guest_ui_mode "${adb_serial}")" == "tv" ]]; then
    dpi="$(resolve_scrcpy_dpi "")"
  else
    guest_dpi="$(guest_display_density "${adb_serial}")"
    [[ "${guest_dpi}" =~ ^[1-9][0-9]*$ ]] || die "could not read the guest display density"
    dpi="${guest_dpi}"
  fi
  # A density of the app's own goes over that: given to 'ika app' (--dpi=auto
  # keeps the one above), else saved in its start options.
  if [[ -n "${dpi_given}" ]]; then
    [[ "${dpi_given}" == "auto" ]] || dpi="${dpi_given}"
  else
    app_dpi="$(saved_app_dpi "${package}")"
    [[ -z "${app_dpi}" ]] || dpi="${app_dpi}"
  fi
  if [[ "${window_size_is_default}" == "true" && "${package}" == "${IKA_MODE_PACKAGE}" ]]; then
    window_size="$(mode_app_window_size "${dpi}")" || window_size="$(default_app_window_size)"
  fi
  display_size="$(app_window_display_size "${window_size}")" \
    || die "could not size the app window display for ${window_size}"

  # The app gets a Cuttlefish display of its own, as large as the host screen;
  # --dpi enables flex resizing: the app is drawn at the window size inside it,
  # as the console is. "+" force-stops the app first so it starts on that
  # display instead of resurfacing an existing task on the desktop. The
  # supervisor removes the display when the window closes. START_APP replaces
  # the app's own start (Settings' "+info:PACKAGE" opens an App info page).
  cuttlefish_display="$(add_cuttlefish_display \
    "$(app_cuttlefish_display_size "${display_size}")" "${dpi}")" \
    || die "could not add a Cuttlefish display for ${label:-${package}}"
  scrcpy_cmd=(
    "${SCRCPY_BIN}"
    -s "${adb_serial}"
    --cuttlefish-frames-socket="$(resolve_cuttlefish_frames_socket)"
    --cuttlefish-display="${cuttlefish_display}"
    --dpi="${dpi}"
    --start-app="${start_app:-+${package}}"
    --window-title="${title}"
    --window-state-file="${SCRCPY_WINDOW_STATE_FILE}"
    --window-width="${window_size%x*}"
    --window-height="${window_size#*x}"
    --mouse-bind=++++:b+++
    --force-adb-forward
    --render-driver=opengl
    --no-audio
  )
  append_scrcpy_input_args scrcpy_cmd app "app window" "${package}"
  append_scrcpy_extra_args scrcpy_cmd "app window"

  # A distinct app ID lets the host desktop treat each app as its own window
  # group instead of stacking it under the Ika console.
  append_scrcpy_env scrcpy_env
  scrcpy_env+=("SDL_APP_ID=$(app_window_id "${package}")")
  # Without the app's own icon, the window would set the generic Ika icon,
  # which taskbars prefer over the launcher's.
  app_icon="$(app_menu_icon "${package}")"
  if [[ -f "${app_icon}" ]]; then
    scrcpy_env+=("IKA_WINDOW_ICON=${app_icon}")
  fi
  # The title bar starts in the color the app's content gave it last time.
  scrcpy_env+=("IKA_TITLEBAR_COLOR_FILE=${IKA_APPS_DIR}/${package}/titlebar-color")
  scrcpy_cmd=(env "${scrcpy_env[@]}" "${scrcpy_cmd[@]}")

  : > "${SCRCPY_LOG_FILE}"
  log "opening ${package} (${window_size}/${dpi}) on Cuttlefish display ${cuttlefish_display} as \"${title}\""
  setsid --fork "${IKA_SCRIPT_PATH}" __app_supervisor "${package}" \
    "${adb_serial}" "${fullscreen_mode}" -- "${scrcpy_cmd[@]}" \
    </dev/null >>"${SCRCPY_LOG_FILE}" 2>&1 3>&- &
  disown || true

  # Return as soon as the supervisor has registered, instead of a fixed wait.
  for attempt in {1..30}; do
    if supervisor_pid_from_file "${SCRCPY_SUPERVISOR_PID_FILE}" __app_supervisor >/dev/null; then
      respond "Opened ${title} in its own window"
      return 0
    fi
    sleep 0.05
  done

  remove_cuttlefish_display "${cuttlefish_display}" || true
  die "could not open a window for ${label:-${title}}; see ${SCRCPY_LOG_FILE}"
}

# Opens Android's App info page for NAME in the Settings app window: a new
# window starts with the page, an open one gets it on its display.
open_app_info() {
  local name="$1"
  local settings="com.android.settings"
  local adb_serial
  local resolved
  local package
  local label
  local log_file
  local display_id
  local output

  require_executable "${SCRCPY_BIN}" "console client"
  ensure_guest_ready
  adb_serial="$(resolve_adb_serial)"

  if is_app_package_name "${name}" \
      && app_is_installed "${name}" "${adb_serial}"; then
    package="${name}"
    label="$(app_display_name "${package}")"
  else
    resolved="$(resolve_launchable_app "${name}" "${adb_serial}")" || exit 1
    package="${resolved#*$'\t'}"
    label="${resolved%%$'\t'*}"
  fi
  validate_app_package "${package}"

  # The scrcpy server opens the page as the window's first page, so the
  # Settings home page never shows.
  if ! app_window_is_open "${settings}"; then
    ( open_app_window "${settings}" false "" "" "+info:${package}" ) >/dev/null || exit 1
    respond "Opened App info for ${label}"
    return 0
  fi

  log_file="${IKA_APPS_DIR}/${settings}/window.log"
  display_id="$(sed -n 's/.*Starting app .* on display \([0-9][0-9]*\)\.\.\..*/\1/p' \
    "${log_file}" 2>/dev/null | tail -n1)"
  [[ -n "${display_id}" ]] || die "could not find the Settings window's display"

  # App info alone in the window, without Settings' list beside it, as the
  # server opens it: it replaces the window's Settings pages
  # (FLAG_ACTIVITY_NEW_TASK and FLAG_ACTIVITY_CLEAR_TASK), and opens as a
  # subpage, which Settings does not turn into its two-pane deep link, as it
  # does a task's first page on a large screen.
  output="$(guest_adb "${adb_serial}" shell am start --display "${display_id}" \
    -a android.settings.APPLICATION_DETAILS_SETTINGS -d "package:${package}" \
    --ez :settings:show_fragment_as_subsetting true \
    -f 0x10008000 2>&1 | tr -d '\r' || true)"
  if [[ "${output}" == *Error* || "${output}" == *Exception* ]]; then
    die "could not open App info for ${label}: ${output}"
  fi
  respond "Opened App info for ${label}"
}

run_app_supervisor() {
  local package="$1"
  local arg
  local status=0
  shift

  validate_app_package "${package}"
  use_app_window_paths "${package}"
  APP_WINDOW_SUPERVISOR="true"
  for arg in "$@"; do
    if [[ "${arg}" =~ ^--cuttlefish-display=([0-9]+)$ ]]; then
      APP_CUTTLEFISH_DISPLAY="${BASH_REMATCH[1]}"
    fi
  done
  run_scrcpy_supervisor "$@" || status="$?"
  remove_app_cuttlefish_display
  return "${status}"
}

# Removes the Cuttlefish display of the app window this supervisor runs, once.
remove_app_cuttlefish_display() {
  if [[ -n "${APP_CUTTLEFISH_DISPLAY:-}" ]]; then
    remove_cuttlefish_display "${APP_CUTTLEFISH_DISPLAY}" || true
    APP_CUTTLEFISH_DISPLAY=""
  fi
}

app_window_is_open() {
  supervisor_pid_from_file "$(app_supervisor_file "$1" pid)" __app_supervisor >/dev/null
}

# Lists launchable apps sorted by label. Apps already open in their own window
# are shown in bold on a terminal, or marked "(open)" when the output is not a
# terminal or NO_COLOR is set.
list_launchable_apps() {
  local adb_serial
  local -a labels=()
  local -a packages=()
  local label
  local package
  local width=0
  local max_width=40
  local bold=""
  local plain=""
  local i

  require_executable "${SCRCPY_BIN}" "console client"
  has_live_cvd_processes || die "Android virtual device not running; start it with '${SCRIPT_NAME} start'"
  adb_serial="$(resolve_adb_serial)"
  adb_boot_completed "${adb_serial}" || die "Android virtual device has not finished booting"

  while IFS=$'\t' read -r label package; do
    [[ -n "${label}" && -n "${package}" ]] || continue
    labels+=("${label}")
    packages+=("${package}")
    if (( ${#label} > width )); then
      width="${#label}"
    fi
  done < <(list_guest_apps "${adb_serial}" | sort -f -t $'\t' -k1,1 -k2,2)

  if [[ "${#packages[@]}" -eq 0 ]]; then
    die "could not list apps from the Android virtual device"
  fi
  if (( width > max_width )); then
    width="${max_width}"
  fi

  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    bold=$'\e[1m'
    plain=$'\e[0m'
  fi

  for i in "${!packages[@]}"; do
    label="${labels[i]}"
    package="${packages[i]}"
    if app_window_is_open "${package}"; then
      if [[ -n "${bold}" ]]; then
        printf '%s%-*s  %s%s\n' "${bold}" "${width}" "${label}" "${package}" "${plain}"
      else
        printf '%-*s  %s  (open)\n' "${width}" "${label}" "${package}"
      fi
    else
      printf '%-*s  %s\n' "${width}" "${label}" "${package}"
    fi
  done
}

# ============================================================================
# Desktop menu entries for guest apps (ika app sync)
# ============================================================================
#
# Each launchable app gets ~/.local/share/applications/ika-PACKAGE.desktop.
# Its file name matches the app window's Wayland app ID (SDL_APP_ID), so
# GNOME Shell and KWin associate open app windows with their launcher. The
# launchers are grouped as "Android Apps (Ika)": KDE Plasma, XFCE, Cinnamon
# and MATE read a freedesktop menu-merge file, while GNOME Shell, which
# ignores menu files, gets an app-grid folder matching the same category.

IKA_MENU_NAME="Android Apps (Ika)"
IKA_MENU_ID="ika-android-apps"
IKA_MENU_CATEGORY="X-Ika-Android"
IKA_MENU_ICON="ika-scrcpy"
IKA_MENU_ICON_SIZE="192"
IKA_MENU_VERSION="5"

app_menu_icon_dir() {
  printf '%s/icons\n' "${IKA_APPS_DIR}"
}

# Renders every launchable app's icon inside the guest with the IkaAppIcons
# helper in the scrcpy-server jar, and stores them as ICON_DIR/PACKAGE-HASH.png.
# The content hash changes the launcher's Icon path whenever an app's icon
# changes, so desktop icon caches never show a stale one. On success, icons of
# apps that are no longer launchable are removed.
export_app_icons() {
  local adb_serial="$1"
  local icon_dir
  local server_jar="${SCRCPY_SERVER_PATH_OVERRIDE:-${PACKAGED_SCRCPY_SERVER}}"
  local remote_jar="/data/local/tmp/ika-app-icons.jar"
  local remote_dir="/data/local/tmp/ika-app-icons"
  local staging
  local png
  local package
  local hash
  local dest
  local -A keep=()

  if [[ ! -f "${server_jar}" ]]; then
    log "scrcpy-server not found at ${server_jar}; keeping existing app icons"
    return 1
  fi

  icon_dir="$(app_menu_icon_dir)"
  staging="$(mktemp -d "${CVD_TMP_DIR}/app-icons.XXXXXX")"
  if ! guest_adb "${adb_serial}" push -q "${server_jar}" "${remote_jar}" >/dev/null \
      || ! GUEST_ADB_TIMEOUT=60 guest_adb "${adb_serial}" shell \
          "rm -rf ${remote_dir} && CLASSPATH=${remote_jar} app_process / com.genymobile.scrcpy.IkaAppIcons ${remote_dir} ${IKA_MENU_ICON_SIZE}" >/dev/null \
      || ! GUEST_ADB_TIMEOUT=60 guest_adb "${adb_serial}" pull -q "${remote_dir}" "${staging}/icons" >/dev/null; then
    guest_adb "${adb_serial}" shell "rm -rf ${remote_dir} ${remote_jar}" >/dev/null 2>&1 || true
    rm -rf "${staging}"
    log "could not render app icons in the guest; keeping existing app icons"
    return 1
  fi
  guest_adb "${adb_serial}" shell "rm -rf ${remote_dir} ${remote_jar}" >/dev/null 2>&1 || true

  if [[ -f "${staging}/icons/games.list" ]]; then
    mkdir -p "${IKA_APPS_DIR}"
    mv -f "${staging}/icons/games.list" "${APP_GAMES_FILE}"
  fi

  mkdir -p "${icon_dir}"
  for png in "${staging}/icons"/*.png; do
    [[ -f "${png}" ]] || continue
    package="$(basename "${png}" .png)"
    is_app_package_name "${package}" || continue
    is_hidden_app "${package}" && continue
    hash="$(sha256sum < "${png}" | cut -c1-12)"
    dest="${icon_dir}/${package}-${hash}.png"
    if [[ ! -f "${dest}" ]]; then
      mv -f "${png}" "${dest}"
    fi
    keep["${dest}"]=1
  done
  rm -rf "${staging}"

  for png in "${icon_dir}"/*.png; do
    [[ -f "${png}" && -z "${keep[${png}]:-}" ]] && rm -f "${png}"
  done
  return 0
}

# Prints the icon for PACKAGE: its rendered PNG when there is one, otherwise
# the generic Ika icon.
app_menu_icon() {
  local package="$1"
  local -a icons=("$(app_menu_icon_dir)/${package}"-*.png)

  if [[ -f "${icons[0]}" ]]; then
    printf '%s\n' "${icons[0]}"
  else
    printf '%s\n' "${IKA_MENU_ICON}"
  fi
}

app_menu_data_dir() {
  printf '%s\n' "${XDG_DATA_HOME:-${HOME}/.local/share}"
}

app_menu_config_dir() {
  printf '%s\n' "${XDG_CONFIG_HOME:-${HOME}/.config}"
}

# Writes stdin to PATH only when the content differs, so menus that watch
# these directories are not refreshed needlessly.
write_file_if_changed() {
  local path="$1"
  local content

  content="$(cat)"
  if [[ -f "${path}" ]] && [[ "$(<"${path}")" == "${content}" ]]; then
    return 1
  fi
  mkdir -p "$(dirname "${path}")"
  printf '%s\n' "${content}" > "${path}"
}

# On WSLg, gives the console the desktop entry of its app ID (see
# console_app_id), ika-DISTRIBUTION.desktop, a copy of ika.desktop, in the
# user's applications directory, where WSLg reads it once ika-wsl-setup has
# linked it. An ika.desktop there with Hidden=true takes ika.desktop's own out
# of the Windows Start menu, which WSLg reads first; both are named Ika, and
# WSLg names a Start menu shortcut after the entry's Name. When ika-base is
# installed again, WSLg reads ika.desktop anew, and its shortcut takes the
# console entry's place: hiding it again removes that shortcut, so the console
# entry is written again after it. An entry for another name of the
# distribution, since renamed, goes first. Does nothing outside WSLg, or when
# WSLg does not read the user's entries.
write_wslg_console_entry() {
  local system_entry="${IKA_DESKTOP_ENTRY}"
  local dir="${XDG_DATA_HOME:-${HOME}/.local/share}/applications"
  local distro
  local entry
  local hidden
  local file

  distro="$(wslg_distro_id)"
  [[ -n "${distro}" && -f "${system_entry}" ]] || return 0
  wslg_reads_user_applications || return 0
  entry="${dir}/ika-${distro}.desktop"
  hidden="${dir}/ika.desktop"
  mkdir -p "${dir}"

  for file in "${dir}"/ika-*.desktop; do
    if [[ "${file}" != "${entry}" ]] && grep -qx 'X-Ika-Console=true' "${file}" 2>/dev/null; then
      rm -f "${file}"
    fi
  done
  # dpkg gives an installed file the time it has in the package; the time of
  # its last change of status is that of its installation.
  if [[ ! -f "${hidden}" ]] \
      || (( $(stat -c %Z "${system_entry}") > $(stat -c %Y "${hidden}") )); then
    printf '[Desktop Entry]\nType=Application\nName=Ika\nHidden=true\n' > "${hidden}"
    rm -f "${entry}"
  fi
  sed "s/^StartupWMClass=.*/StartupWMClass=ika-${distro}\nX-Ika-Console=true/" "${system_entry}" \
    | write_file_if_changed "${entry}" || true
}

# Rewrites APP_GAMES_FILE from the guest's game mode service, for the apps in
# LIST (LABEL<TAB>PACKAGE lines). Keeps the old file if the guest can't answer.
refresh_app_games_file() {
  local adb_serial="$1"
  local list="$2"
  local label
  local package
  local packages=""
  local output

  while IFS=$'\t' read -r label package; do
    is_app_package_name "${package}" && packages+=" ${package}"
  done <<<"${list}"
  [[ -n "${packages}" ]] || return 0

  output="$(GUEST_ADB_TIMEOUT=60 guest_adb "${adb_serial}" shell \
    "for p in${packages}; do cmd game list-modes \$p 2>/dev/null | grep -q 'current mode' && echo \$p; done; echo ika-games-done" \
    </dev/null 2>/dev/null)" || return 0
  [[ "${output}" == *ika-games-done* ]] || return 0
  mkdir -p "${IKA_APPS_DIR}"
  grep -v '^ika-games-done' <<<"${output//$'\r'/}" | grep -v '^$' > "${APP_GAMES_FILE}" || true
}

# Prints the launcher's menu name: the app label, marked as a game or an app.
app_launcher_name() {
  local label="$1"
  local package="$2"

  if is_game_app "${package}"; then
    printf '🎮 ∙ %s\n' "${label}"
  else
    printf '∙ %s\n' "${label}"
  fi
}

# Prints a desktop entry string value as desktop-file-edit writes it: with each
# backslash doubled. Launcher keys are compared in that form.
desktop_entry_escape() {
  printf '%s\n' "${1//\\/\\\\}"
}

# Prints the value of KEY in the [Desktop Action ID] group of the launcher
# FILE, if it has one.
launcher_action_value() {
  awk -v group="[Desktop Action $2]" -v key="$3" '
    /^\[/ { in_group = ($0 == group); next }
    in_group && index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }' "$1"
}

# Whether the launcher of PACKAGE in APPS_DIR is as write_app_launcher writes
# it for LABEL and ICON.
app_launcher_is_current() {
  local apps_dir="$1"
  local label="$2"
  local package="$3"
  local icon="$4"
  local file="${apps_dir}/$(app_window_id "${package}").desktop"

  [[ -f "${file}" ]] \
    && grep -qxF "Name=$(desktop_entry_escape "$(app_launcher_name "${label}" "${package}")")" "${file}" \
    && grep -qxF "Icon=${icon}" "${file}" \
    && grep -qxF "Actions=$(app_launcher_actions "${package}")" "${file}" \
    && ! grep -qxF "[Desktop Action controller]" "${file}" \
    && grep -qxF "SingleMainWindow=true" "${file}" \
    && grep -qxF "[Desktop Action new-window]" "${file}" \
    && grep -qxF "Name=Launch app" "${file}" \
    && grep -qxF "Name=Startup options" "${file}" \
    && grep -qxF "Name=App info" "${file}" \
    && grep -qxF "Exec=ika app --options ${package}" "${file}" \
    && grep -qxF "Exec=ika app --info ${package}" "${file}" \
    && grep -qxF "Icon=$(app_menu_icon com.android.settings)" "${file}" \
    && [[ "$(launcher_action_value "${file}" new-window Icon)" == "${IKA_MENU_ICON}" ]] \
    && [[ "$(launcher_action_value "${file}" options Icon)" == "${IKA_MENU_ICON}" ]] \
    && grep -qxF "X-Ika-Package=${package}" "${file}" \
    && grep -qxF "X-Ika-Version=${IKA_MENU_VERSION}" "${file}" \
    && grep -qE "^Categories=(.*;)?${IKA_MENU_CATEGORY}(;|$)" "${file}"
}

# The launcher's actions, the same for games and other apps.
app_launcher_actions() {
  printf 'new-window;options;app-settings;\n'
}

# Creates or updates one launcher and returns 1 when it was already current.
# Existing launchers are edited in place, keeping any keys the user added.
write_app_launcher() {
  local apps_dir="$1"
  local label="$2"
  local package="$3"
  local icon="$4"
  local file="${apps_dir}/$(app_window_id "${package}").desktop"
  local name
  local keywords="${label//;/ };${package};Android;Ika;"
  local settings_icon
  local actions

  actions="$(app_launcher_actions "${package}")"

  if app_launcher_is_current "${apps_dir}" "${label}" "${package}" "${icon}"; then
    return 1
  fi
  name="$(app_launcher_name "${label}" "${package}")"
  settings_icon="$(app_menu_icon com.android.settings)"

  if command -v desktop-file-edit >/dev/null 2>&1; then
    if [[ ! -f "${file}" ]]; then
      printf '[Desktop Entry]\nType=Application\n' > "${file}"
    fi
    # The action groups must exist before desktop-file-edit validates the
    # Actions key.
    set_launcher_actions "${file}" "${package}" "${settings_icon}"
    desktop-file-edit \
      --set-name="${name}" \
      --set-key=Exec --set-value="ika app ${package}" \
      --set-icon="${icon}" \
      --set-key=Terminal --set-value=false \
      --set-key=StartupWMClass --set-value="$(app_window_id "${package}")" \
      --set-key=SingleMainWindow --set-value=true \
      --set-key=Keywords --set-value="${keywords}" \
      --set-key=Actions --set-value="${actions}" \
      --add-category="${IKA_MENU_CATEGORY}" \
      --set-key=X-Ika-Package --set-value="${package}" \
      --set-key=X-Ika-Version --set-value="${IKA_MENU_VERSION}" \
      "${file}"
  else
    cat > "${file}" <<EOF
[Desktop Entry]
Type=Application
Name=$(desktop_entry_escape "${name}")
Exec=ika app ${package}
Icon=${icon}
Terminal=false
StartupWMClass=$(app_window_id "${package}")
SingleMainWindow=true
Keywords=$(desktop_entry_escape "${keywords}")
Actions=${actions}
Categories=${IKA_MENU_CATEGORY};
X-Ika-Package=${package}
X-Ika-Version=${IKA_MENU_VERSION}
EOF
    set_launcher_actions "${file}" "${package}" "${settings_icon}"
  fi
}

# Writes the launcher's right-click actions: "Launch app", which opens the
# app, "Startup options", which opens the app's start options window, both
# with the Ika icon, and "App info", which opens Android's App info page for
# the app, with the Settings app's (KDE Plasma's menu shows an action's icon
# beside it, GNOME Shell's none). An app has one
# window (SingleMainWindow), and GNOME Shell offers "New Window" for an app
# that is not running whatever the launcher says, unless it has an action of
# its own with that ID: "Launch app" is that action. It also removes the
# "touch" action, since touch input is a start option, and the "Controller
# mapping..." action games had ('ika app --controller NAME' opens it).
set_launcher_actions() {
  local file="$1"
  local package="$2"
  local settings_icon="$3"

  set_launcher_action "${file}" touch "" ""
  set_launcher_action "${file}" controller "" ""
  set_launcher_action "${file}" new-window "Launch app" "ika app ${package}" \
    "${IKA_MENU_ICON}"
  set_launcher_action "${file}" options "Startup options" \
    "ika app --options ${package}" "${IKA_MENU_ICON}"
  set_launcher_action "${file}" app-settings "App info" \
    "ika app --info ${package}" "${settings_icon}"
}

# Writes the launcher's action ID, named NAME, running EXEC, with ICON if given,
# or removes it when EXEC is empty. desktop-file-edit only edits the main
# group, so the action group is replaced here, at the end of the file, without
# leaving blank lines behind.
set_launcher_action() {
  local file="$1"
  local id="$2"
  local name="$3"
  local exec="$4"
  local icon="${5:-}"

  {
    awk -v group="[Desktop Action ${id}]" '
      /^\[/ { skip = ($0 == group) }
      skip { next }
      /^[[:space:]]*$/ { blanks = blanks $0 "\n"; next }
      { printf "%s", blanks; blanks = ""; print }' "${file}"
    if [[ -n "${exec}" ]]; then
      printf '\n[Desktop Action %s]\nName=%s\nExec=%s\n' "${id}" "${name}" "${exec}"
      if [[ -n "${icon}" ]]; then
        printf 'Icon=%s\n' "${icon}"
      fi
    fi
  } > "${file}.tmp"
  mv -f "${file}.tmp" "${file}"
}

# Prints the launchers created by ika, identified by their X-Ika-Version key.
list_app_launchers() {
  local file

  for file in "$(app_menu_data_dir)"/applications/ika-*.desktop; do
    [[ -f "${file}" ]] || continue
    grep -q '^X-Ika-Version=' "${file}" && printf '%s\n' "${file}"
  done
  return 0
}

app_menu_merge_file() {
  printf '%s/menus/applications-merged/%s.menu\n' "$(app_menu_config_dir)" "${IKA_MENU_ID}"
}

app_menu_directory_file() {
  printf '%s/desktop-directories/%s.directory\n' "$(app_menu_data_dir)" "${IKA_MENU_ID}"
}

install_xdg_app_menu() {
  write_file_if_changed "$(app_menu_directory_file)" <<EOF || true
[Desktop Entry]
Type=Directory
Name=${IKA_MENU_NAME}
Icon=${IKA_MENU_ICON}
EOF

  write_file_if_changed "$(app_menu_merge_file)" <<EOF || true
<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>${IKA_MENU_NAME}</Name>
    <Directory>${IKA_MENU_ID}.directory</Directory>
    <Include>
      <Category>${IKA_MENU_CATEGORY}</Category>
    </Include>
  </Menu>
</Menu>
EOF
}

# Prints the desktop session's bus. The app menu watcher and commands run over
# SSH lack DBUS_SESSION_BUS_ADDRESS, so fall back to the user bus socket.
app_menu_session_bus() {
  local socket="${XDG_RUNTIME_DIR:-/run/user/${UID}}/bus"

  if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    printf '%s\n' "${DBUS_SESSION_BUS_ADDRESS}"
  elif [[ -S "${socket}" ]]; then
    printf 'unix:path=%s\n' "${socket}"
  else
    return 1
  fi
}

# GNOME Shell settings are only usable inside a desktop session. grep reads
# the whole schema list: with -q it could exit first, and gsettings' SIGPIPE
# would fail the pipeline under pipefail, skipping the folder setup.
gnome_app_folders_available() {
  [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] || return 1
  command -v gsettings >/dev/null 2>&1 || return 1
  gsettings list-schemas 2>/dev/null | grep -x 'org.gnome.desktop.app-folders' >/dev/null
}

gnome_app_folder_schema() {
  printf 'org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/%s/\n' \
    "${1:-${IKA_MENU_ID}}"
}

# Prints the items of a gsettings string array ("['a', 'b']" or "@as []"), one
# per line. Desktop file IDs contain neither quotes nor commas.
gsettings_strv_items() {
  local value="$1"
  local item
  local -a items=()

  value="${value#@as }"
  value="${value#[}"
  value="${value%]}"
  IFS=',' read -r -a items <<<"${value}"
  for item in "${items[@]+"${items[@]}"}"; do
    item="${item# }"
    item="${item#\'}"
    item="${item%\'}"
    [[ -z "${item}" ]] || printf '%s\n' "${item}"
  done
}

# Formats the lines read from stdin as a gsettings string array.
gsettings_strv() {
  local item
  local value=""

  while IFS= read -r item; do
    [[ -n "${item}" ]] && value+="${value:+, }'${item}'"
  done
  if [[ -n "${value}" ]]; then
    printf '[%s]\n' "${value}"
  else
    printf '@as []\n'
  fi
}

# Prints a folder's string array key without the Ika launchers in it.
gsettings_strv_without_launchers() {
  gsettings_strv_items "$(gsettings get "$1" "$2")" \
    | { grep -v '^ika-.*\.desktop$' || true; }
}

# Creates the GNOME Shell app-grid folder and puts the given launchers
# (desktop file IDs) in it. Matching on the category alone is not enough:
# when an app is installed, GNOME Shell refreshes its folders from the app
# list it had before the install (js/ui/appDisplay.js, AppDisplay._redisplay),
# so a new launcher would appear in the main grid. Listing the launchers in the
# folder's 'apps' key, before they are written, avoids that. Launchers dragged
# out of the folder, or into another folder, are moved back.
install_gnome_app_folder() {
  local bus
  local schema
  local children
  local folder
  local folder_schema
  local current
  local wanted

  bus="$(app_menu_session_bus)" || return 0
  local -x DBUS_SESSION_BUS_ADDRESS="${bus}"
  gnome_app_folders_available || return 0
  schema="$(gnome_app_folder_schema)"

  if [[ "$(gsettings get "${schema}" name)" != "'${IKA_MENU_NAME}'" ]]; then
    gsettings set "${schema}" name "'${IKA_MENU_NAME}'"
  fi
  if [[ "$(gsettings get "${schema}" categories)" != "['${IKA_MENU_CATEGORY}']" ]]; then
    gsettings set "${schema}" categories "['${IKA_MENU_CATEGORY}']"
  fi
  if [[ "$(gsettings get "${schema}" translate)" != "false" ]]; then
    gsettings set "${schema}" translate false
  fi

  children="$(gsettings get org.gnome.desktop.app-folders folder-children)"
  if [[ "${children}" != *"'${IKA_MENU_ID}'"* ]]; then
    if [[ "${children}" == "@as []" || "${children}" == "[]" ]]; then
      children="['${IKA_MENU_ID}']"
    else
      children="${children%]}, '${IKA_MENU_ID}']"
    fi
    gsettings set org.gnome.desktop.app-folders folder-children "${children}"
  fi

  current="$(gsettings_strv_items "$(gsettings get "${schema}" apps)" | gsettings_strv)"
  wanted="$( { gsettings_strv_without_launchers "${schema}" apps; printf '%s\n' "$@"; } \
    | gsettings_strv)"
  if [[ "${wanted}" != "${current}" ]]; then
    gsettings set "${schema}" apps "${wanted}"
  fi
  current="$(gsettings_strv_items "$(gsettings get "${schema}" excluded-apps)" | gsettings_strv)"
  wanted="$(gsettings_strv_without_launchers "${schema}" excluded-apps | gsettings_strv)"
  if [[ "${wanted}" != "${current}" ]]; then
    gsettings set "${schema}" excluded-apps "${wanted}"
  fi

  for folder in $(gsettings_strv_items "${children}"); do
    [[ "${folder}" != "${IKA_MENU_ID}" ]] || continue
    folder_schema="$(gnome_app_folder_schema "${folder}")"
    current="$(gsettings get "${folder_schema}" apps 2>/dev/null)" || continue
    if [[ "${current}" == *"'ika-"*".desktop'"* ]]; then
      gsettings set "${folder_schema}" apps \
        "$(gsettings_strv_without_launchers "${folder_schema}" apps | gsettings_strv)"
    fi
  done
}

# Seconds GNOME Shell gets to destroy a folder that was taken out of the app
# grid, before the folder's settings are reset.
GNOME_APP_FOLDER_SETTLE_SEC=2

gnome_shell_running() {
  pgrep -u "${UID}" -x gnome-shell >/dev/null 2>&1
}

# Takes the folder out of the app grid, and resets its settings.
#
# The shell's folder dialog (AppFolderDialog) saves the name typed in its entry
# when it closes, and a folder icon that turns invisible closes it (vfunc_unmap
# -> popdown() -> _maybeUpdateFolderName()). With the dialog open, resetting the
# folder's settings in one go empties the folder and resets its name: the icon
# hides, the dialog writes its old name back, the write runs the icon's change
# handler inside the unmap, and the shell destroys the grid under it
# ("clutter_actor_set_mapped: assertion '!CLUTTER_ACTOR_IN_MAP_UNMAP'", then
# gnome-shell aborts, ending the session). The dialog also never disconnects
# from the folder's name setting, so a name changed after the folder is gone
# is written into destroyed labels.
#
# So the folder leaves 'folder-children' first, with its settings as they are,
# and is given a moment to be destroyed; the settings are reset afterwards, the
# name excepted. Without a running shell nothing reacts, and all of it goes.
remove_gnome_app_folder() {
  local bus
  local children
  local key
  local schema
  local item="'${IKA_MENU_ID}'"
  local removed=false

  bus="$(app_menu_session_bus)" || return 0
  local -x DBUS_SESSION_BUS_ADDRESS="${bus}"
  gnome_app_folders_available || return 0
  schema="$(gnome_app_folder_schema)"

  children="$(gsettings get org.gnome.desktop.app-folders folder-children)"
  if [[ "${children}" == *"${item}"* ]]; then
    children="${children//", ${item}"/}"
    children="${children//"${item}, "/}"
    children="${children//"${item}"/}"
    if [[ "${children}" == "[]" ]]; then
      children="@as []"
    fi
    gsettings set org.gnome.desktop.app-folders folder-children "${children}"
    removed=true
  fi

  if gnome_shell_running; then
    [[ "${removed}" == false ]] || sleep "${GNOME_APP_FOLDER_SETTLE_SEC}"
    while IFS= read -r key; do
      [[ -n "${key}" && "${key}" != "name" ]] || continue
      gsettings reset "${schema}" "${key}"
    done < <(gsettings list-keys "${schema}")
  elif command -v dconf >/dev/null 2>&1; then
    dconf reset -f "/org/gnome/desktop/app-folders/folders/${IKA_MENU_ID}/"
  else
    gsettings reset-recursively "${schema}"
  fi
}

# Rebuilds desktop caches: the MIME cache, and KDE's ksycoca, which Plasma's
# menus read instead of rescanning launcher files.
refresh_app_menu_caches() {
  local kbuildsycoca

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q "$(app_menu_data_dir)/applications" || true
  fi
  for kbuildsycoca in kbuildsycoca6 kbuildsycoca5; do
    if command -v "${kbuildsycoca}" >/dev/null 2>&1; then
      "${kbuildsycoca}" >/dev/null 2>&1 || true
      break
    fi
  done
}

# GNOME Shell keeps an app-grid icon, label included, for as long as its app
# stays installed, and reloads a launcher changed in place only when its name,
# command or icon changes, so a launcher updated in place would keep showing
# its old name, or its old right-click actions. Launchers that change are
# therefore moved out of the applications directory until GNOME Shell has
# dropped them, updated there, and moved back as new apps. WSLg likewise
# names a Windows Start menu shortcut once, when the launcher appears, and
# updates it in place. Prints the number of launchers updated.
refresh_changed_launchers() {
  local apps_dir="$1"
  local list="$2"
  local label
  local package
  local file
  local parked
  local -a labels=()
  local -a packages=()
  local i

  if [[ "${IKA_ON_WSLG}" != true ]] && ! pgrep -u "${UID}" -x gnome-shell >/dev/null 2>&1; then
    printf '0\n'
    return 0
  fi

  while IFS=$'\t' read -r label package; do
    is_app_package_name "${package}" || continue
    file="${apps_dir}/$(app_window_id "${package}").desktop"
    if [[ -f "${file}" ]] && grep -q '^X-Ika-Version=' "${file}" \
        && ! app_launcher_is_current "${apps_dir}" "${label}" "${package}" \
          "$(app_menu_icon "${package}")"; then
      labels+=("${label}")
      packages+=("${package}")
    fi
  done <<<"${list}"

  if [[ "${#packages[@]}" -eq 0 ]]; then
    printf '0\n'
    return 0
  fi

  parked="$(mktemp -d "${CVD_TMP_DIR}/changed-launchers.XXXXXX")"
  for package in "${packages[@]}"; do
    mv -f "${apps_dir}/$(app_window_id "${package}").desktop" "${parked}/"
  done
  refresh_app_menu_caches
  # GNOME Shell processes app changes asynchronously and rate-limits them.
  sleep 3
  for i in "${!packages[@]}"; do
    write_app_launcher "${parked}" "${labels[i]}" "${packages[i]}" \
      "$(app_menu_icon "${packages[i]}")" || true
    mv -f "${parked}/$(app_window_id "${packages[i]}").desktop" "${apps_dir}/"
  done
  rmdir "${parked}" 2>/dev/null || true
  printf '%s\n' "${#packages[@]}"
}

sync_app_menu() {
  local adb_serial
  local apps_dir
  local list
  local label
  local package
  local file
  local updated=0
  local removed=0
  local icons="unchanged"
  local sync_lock_fd
  local -A current=()
  local -a desktop_ids=()

  require_executable "${SCRCPY_BIN}" "console client"
  has_live_cvd_processes || die "Android virtual device not running; start it with '${SCRIPT_NAME} start'"
  adb_serial="$(resolve_adb_serial)"
  adb_boot_completed "${adb_serial}" || die "Android virtual device has not finished booting"

  # The app menu watcher and a manual sync must not write the same files.
  exec {sync_lock_fd}>"${APP_MENU_SYNC_LOCK_FILE}"
  flock -w 120 "${sync_lock_fd}" || die "another app menu sync is still running"

  list="$(list_guest_apps "${adb_serial}")"
  [[ -n "${list}" ]] || die "could not list apps from the Android virtual device"

  if export_app_icons "${adb_serial}"; then
    icons="rendered"
  else
    # The icon helper also lists the games; without it, a game installed since
    # its last run would be named as an app.
    refresh_app_games_file "${adb_serial}" "${list}"
  fi

  apps_dir="$(app_menu_data_dir)/applications"
  mkdir -p "${apps_dir}"
  # A launcher named for the other side of WSLg (see app_window_id) goes
  # before its replacement is written: WSLg names the Windows Start menu
  # shortcut after the launcher's Name, which both have, and removing the old
  # launcher afterwards would take the new one's shortcut with it.
  while read -r file; do
    package="$(sed -n 's/^X-Ika-Package=//p' "${file}" | head -n1)"
    if [[ -n "${package}" && "${file##*/}" != "$(app_window_id "${package}").desktop" ]]; then
      rm -f "${file}"
      removed=$((removed + 1))
    fi
  done < <(list_app_launchers)
  # Set up the group, with every launcher in it, before any launcher is
  # written: an app whose launcher appears first can end up outside it.
  # Launchers the user hid stay out of the GNOME folder's explicit list.
  while IFS=$'\t' read -r label package; do
    is_app_package_name "${package}" || continue
    file="${apps_dir}/$(app_window_id "${package}").desktop"
    if [[ ! -f "${file}" ]] || ! grep -qx 'NoDisplay=true' "${file}"; then
      desktop_ids+=("$(app_window_id "${package}").desktop")
    fi
  done <<<"${list}"
  install_xdg_app_menu
  install_gnome_app_folder "${desktop_ids[@]+"${desktop_ids[@]}"}"

  updated="$(refresh_changed_launchers "${apps_dir}" "${list}")"
  while IFS=$'\t' read -r label package; do
    is_app_package_name "${package}" || continue
    current["${package}"]=1
    # A game added to the menu starts with Fullscreen ticked in its start
    # options, unless they were set before.
    if [[ ! -f "${apps_dir}/$(app_window_id "${package}").desktop" ]] && is_game_app "${package}" \
        && ! app_options_saved "${package}"; then
      save_app_options "${package}" fullscreen
      log "${label}: a new game, starting fullscreen"
    fi
    if write_app_launcher "${apps_dir}" "${label}" "${package}" \
        "$(app_menu_icon "${package}")"; then
      updated=$((updated + 1))
    fi
  done <<<"${list}"

  while read -r file; do
    [[ -n "${file}" ]] || continue
    package="$(sed -n 's/^X-Ika-Package=//p' "${file}" | head -n1)"
    if [[ -z "${package}" || -z "${current[${package}]:-}" ]]; then
      rm -f "${file}"
      removed=$((removed + 1))
    fi
  done < <(list_app_launchers)

  refresh_app_menu_caches
  # Release the lock now: a watcher started after this would inherit the
  # descriptor and block on it.
  exec {sync_lock_fd}>&-

  respond "${IKA_MENU_NAME}: ${#current[@]} apps (${updated} added or updated, ${removed} removed, icons ${icons})"
}

remove_app_menu() {
  local file
  local removed=0
  local sync_lock_fd

  exec {sync_lock_fd}>"${APP_MENU_SYNC_LOCK_FILE}"
  flock -w 120 "${sync_lock_fd}" || die "an app menu sync is still running"

  while read -r file; do
    [[ -n "${file}" ]] || continue
    rm -f "${file}"
    removed=$((removed + 1))
  done < <(list_app_launchers)

  rm -f "$(app_menu_merge_file)" "$(app_menu_directory_file)" "${APP_LIST_CACHE}" \
    "${APP_GAMES_FILE}"
  rm -rf "$(app_menu_icon_dir)"
  remove_gnome_app_folder
  refresh_app_menu_caches
  exec {sync_lock_fd}>&-

  respond "Removed ${IKA_MENU_NAME} (${removed} launchers)"
}

# Prints a fingerprint of the guest's enabled packages and their versions,
# which changes whenever an app is installed, updated, removed, enabled or
# disabled.
guest_package_fingerprint() {
  local packages

  packages="$(guest_adb "$1" shell cmd package list packages -e --show-versioncode 2>/dev/null \
    | tr -d '\r' || true)"
  [[ -n "${packages}" ]] || return 1
  sort <<<"${packages}" | sha256sum | cut -c1-16
}

app_menu_watcher_cleanup() {
  if [[ -f "${APP_MENU_WATCHER_PID_FILE}" \
      && "$(<"${APP_MENU_WATCHER_PID_FILE}")" == "$$" ]]; then
    rm -f "${APP_MENU_WATCHER_PID_FILE}"
  fi
}

# Seconds after Android completes a boot before the app menu watcher syncs:
# the app list is served by scrcpy's server in the guest, which cannot connect
# while Android runs its boot-completed work.
APP_MENU_BOOT_GRACE_SEC=10

# Keeps the desktop menu in sync while the VM runs: syncs once the guest has
# booted and settled, then whenever its packages change. Polling one package
# listing costs a few tens of milliseconds and needs nothing running in the
# guest. Exits when the VM stops or the menu is removed with
# 'ika app sync --remove'.
run_app_menu_watcher() {
  local adb_serial
  local fingerprint
  local synced=""
  local booted_at=""
  local watcher_lock_fd

  exec {watcher_lock_fd}>"${APP_MENU_WATCHER_LOCK_FILE}"
  flock -n "${watcher_lock_fd}" || return 0
  printf '%s\n' "$$" > "${APP_MENU_WATCHER_PID_FILE}"
  trap 'exit 0' INT TERM HUP
  trap app_menu_watcher_cleanup EXIT
  # A failed sync is logged and retried, never reported as a notification:
  # the watcher inherits IKA_NOTIFY from the menu launcher's 'ika start', and
  # its failures (a guest that stops answering) are the log's business.
  IKA_NOTIFY=false

  adb_serial="$(resolve_adb_serial)"
  log "app menu watcher started"
  while has_live_cvd_processes && [[ ! -f "${APP_MENU_DISABLED_FILE}" ]]; do
    # The adb calls go without the watcher's lock, like the sync below: one
    # may start the adb server, which would otherwise keep the lock after this
    # watcher exits and stop every later one from starting.
    if ! ( exec {watcher_lock_fd}>&-; adb_boot_completed "${adb_serial}" ); then
      # Not booted, or restarting: a mode switch restarts Android with other
      # packages, and the sync waits for the new boot to settle.
      booted_at=""
    elif [[ -z "${booted_at}" ]]; then
      booted_at="${SECONDS}"
    fi
    if [[ -n "${booted_at}" ]] \
        && (( SECONDS - booted_at >= APP_MENU_BOOT_GRACE_SEC )) \
        && fingerprint="$(exec {watcher_lock_fd}>&-; guest_package_fingerprint "${adb_serial}")" \
        && [[ "${fingerprint}" != "${synced}" ]]; then
      if [[ -n "${synced}" ]]; then
        log "guest packages changed; updating the app menu"
      fi
      # Wait in the background so that a stop request is handled at once
      # instead of after the running command.
      # Without the watcher's lock, which a daemon started during the sync
      # (such as an adb server) would otherwise keep.
      ( exec {watcher_lock_fd}>&-; sync_app_menu ) &
      if wait "$!"; then
        synced="${fingerprint}"
      else
        log "app menu sync failed; retrying in 30s"
        sleep 30 &
        wait "$!"
      fi
    fi
    sleep "${IKA_APP_MENU_POLL_SEC}" &
    wait "$!"
  done
  log "app menu watcher stopped"
}

start_app_menu_watcher() {
  [[ ! -f "${APP_MENU_DISABLED_FILE}" ]] || return 0
  supervisor_pid_from_file "${APP_MENU_WATCHER_PID_FILE}" __app_menu_watcher >/dev/null && return 0

  setsid --fork "${IKA_SCRIPT_PATH}" __app_menu_watcher \
    </dev/null >>"${APP_MENU_LOG_FILE}" 2>&1 3>&- &
  disown || true
}

stop_app_menu_watcher() {
  stop_supervisor_from_file "${APP_MENU_WATCHER_PID_FILE}" __app_menu_watcher
}

android_storage_mounted() {
  findmnt -rn -M "${1:-${ANDROID_STORAGE_DIR}}" >/dev/null 2>&1
}

# Whether 'su' gives root in the guest, as after 'ika root'.
guest_is_rooted() {
  local adb_serial="$1"

  [[ "$(guest_adb "${adb_serial}" shell "su -c 'id -u'" 2>/dev/null | tr -d '\r')" == "0" ]]
}

fuse_allows_other() {
  grep -qE '^[[:space:]]*user_allow_other[[:space:]]*$' /etc/fuse.conf 2>/dev/null
}

# Mounts Android's /sdcard on ANDROID_STORAGE_DIR with madbfs, which runs
# madbfs-server from the ROM and goes on in the background. On a rooted ROM
# (ika root) it mounts the whole filesystem, /, with the server run as root.
# Ika's adb comes first on PATH: an adb of another version would restart the
# adb server under the console.
mount_android_storage() {
  local adb_serial="$1"
  local -a root_args=(--root=/sdcard)
  local server_pkill="pkill -x madbfs-server"
  local deadline
  local mount_options

  [[ -x "${PACKAGED_MADBFS_BIN}" ]] || return 0
  android_storage_mounted && return 0
  if [[ "${LEGACY_ANDROID_STORAGE_DIR}" != "${ANDROID_STORAGE_DIR}" ]]; then
    unmount_android_storage_at "${LEGACY_ANDROID_STORAGE_DIR}"
  fi
  mkdir -p "${ANDROID_STORAGE_DIR}"
  if guest_is_rooted "${adb_serial}"; then
    root_args=(--root=/ --su)
    server_pkill="su -c '${server_pkill}'"
  else
    # Android mounts /sdcard some seconds after its first frame, when the
    # console opens: 6 s later on a 2-vCPU guest. madbfs gives up at once on a
    # missing root, so wait for it, for up to 30 s.
    deadline=$((SECONDS + 30))
    until guest_adb "${adb_serial}" shell 'test -d /sdcard/' >/dev/null 2>&1 \
        || (( SECONDS >= deadline )); do
      sleep 0.5
    done
    # Another start may have mounted it during the wait.
    android_storage_mounted && return 0
  fi
  # A madbfs that did not exit cleanly leaves its control socket behind, and
  # its server on Android holding the port.
  rm -f "${XDG_RUNTIME_DIR:-/tmp}/madbfs@${adb_serial}.sock"
  guest_adb "${adb_serial}" shell "${server_pkill}" >/dev/null 2>&1 || true
  trim_log_lines "${MADBFS_LOG_FILE}"
  mount_options="uid=$(id -u),gid=$(id -g),umask=022"
  # WSL serves its files to Windows as root, which FUSE keeps out of another
  # user's mount unless allowed (it needs user_allow_other in /etc/fuse.conf,
  # which ika-wsl-setup sets)
  if [[ "${IKA_ON_WSLG}" == true ]] && fuse_allows_other; then
    mount_options+=",allow_root"
  fi
  # Files show as the user's, as Android's owners mean nothing on the host and
  # file managers would treat the folders as read-only. File details are
  # re-read after 2 seconds instead of 60, so files Android apps add or change
  # show up promptly. madbfs's cache of file pages holds 64 MiB instead of 256
  # (72 MiB of memory with its dirty maps, taken as files are read): 288 MiB
  # was 7% of a 4 GB host.
  if PATH="${CVD_HOST_OUT}/bin:${PATH}" "${PACKAGED_MADBFS_BIN}" --serial="${adb_serial}" \
      "${root_args[@]}" --ttl=2 --cache-size=64 --log-file="${MADBFS_LOG_FILE}" \
      -o "${mount_options}" "${ANDROID_STORAGE_DIR}" \
      </dev/null >>"${MADBFS_LOG_FILE}" 2>&1 3>&-; then
    log "Android storage mounted on ${ANDROID_STORAGE_DIR} (${root_args[0]#--root=})"
    edit_android_storage_place add
  else
    log "warning: could not mount Android storage on ${ANDROID_STORAGE_DIR}; see ${MADBFS_LOG_FILE}"
  fi
}

kde_places_file() {
  printf '%s\n' "${XDG_DATA_HOME:-${HOST_HOME}/.local/share}/user-places.xbel"
}

gtk_bookmarks_file() {
  printf '%s\n' "${XDG_CONFIG_HOME:-${HOST_HOME}/.config}/gtk-3.0/bookmarks"
}

# Adds ("add") or removes ("remove") $2, or ANDROID_STORAGE_DIR, named
# "Android", in the file manager's sidebar: Dolphin and GNOME's Files list only
# disks, network shares and mounts in the home folder by themselves. On GNOME
# it goes in GTK's bookmarks. KDE's places file is only edited once it exists:
# creating it would keep KDE from adding its default places. Removing takes the
# entry out of both, whatever the desktop.
edit_android_storage_place() {
  local action="$1"
  local dir="${2:-${ANDROID_STORAGE_DIR}}"
  local places
  local bookmarks
  local kept
  local uri

  edit_windows_android_storage_shortcut "${action}" "${dir}"
  uri="$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).as_uri())' \
    "${dir}")" || return 0
  bookmarks="$(gtk_bookmarks_file)"
  if [[ "${action}" == "remove" ]]; then
    if grep -qxF "${uri} Android" "${bookmarks}" 2>/dev/null \
        && kept="$(mktemp "${bookmarks}.XXXXXX")"; then
      # Rewritten in place, keeping the file's mode.
      if grep -vxF "${uri} Android" "${bookmarks}" >"${kept}" || [[ ! -s "${kept}" ]]; then
        cat "${kept}" >"${bookmarks}" || true
      fi
      rm -f "${kept}"
    fi
  elif [[ ":${XDG_CURRENT_DESKTOP:-}:" == *:GNOME:* ]] \
      && ! grep -qxF "${uri} Android" "${bookmarks}" 2>/dev/null; then
    mkdir -p "$(dirname "${bookmarks}")" \
      && printf '%s Android\n' "${uri}" >>"${bookmarks}" || true
  fi

  places="$(kde_places_file)"
  [[ -f "${places}" ]] || return 0
  python3 - "${action}" "${places}" "${uri}" <<'PY' || true
import re
import sys
action, path, uri = sys.argv[1:]
text = open(path, encoding="utf-8").read()
entry_re = re.compile(
    r'[ \t]*<bookmark href="' + re.escape(uri) + r'">.*?</bookmark>\n?', re.DOTALL)
if action == "remove":
    text, count = entry_re.subn("", text)
    if count == 0:
        sys.exit(0)
elif not entry_re.search(text):
    end = text.rindex("</xbel>")
    text = text[:end] + (
        f' <bookmark href="{uri}">\n'
        '  <title>Android</title>\n'
        '  <info>\n'
        '   <metadata owner="http://freedesktop.org">\n'
        '    <bookmark:icon name="smartphone"/>\n'
        '   </metadata>\n'
        '  </info>\n'
        ' </bookmark>\n'
    ) + text[end:]
else:
    sys.exit(0)
with open(path, "w", encoding="utf-8") as f:
    f.write(text)
PY
}

# On WSLg, adds ("add") or removes ("remove") "Android (Ika)" under This PC in
# Windows' Explorer: a network shortcut to $2 as Windows reaches it
# (\\wsl.localhost\DISTRO\...). Removing takes it out only when it leads to
# $2. PowerShell runs in the background, as it takes a second or two.
edit_windows_android_storage_shortcut() {
  local action="$1"
  local dir="$2"
  local powershell
  local target

  [[ "${IKA_ON_WSLG}" == true ]] || return 0
  powershell="$(windows_powershell)" || return 0
  target="$(wslpath -w "${dir}" 2>/dev/null)" || return 0
  mkdir -p "${CVD_TMP_DIR}"
  (
    flock -w 30 9 || exit 0
    with_timeout 60 "${powershell}" -NoProfile -NonInteractive -ExecutionPolicy Bypass \
      -EncodedCommand "$(windows_storage_shortcut_script "${action}" "${target}" \
        | iconv -t UTF-16LE | base64 -w 0)" </dev/null >/dev/null 2>&1
  ) 9>"${CVD_TMP_DIR}/windows-storage-shortcut.lock" &
  disown "$!" 2>/dev/null || true
}

# Prints the PowerShell program of edit_windows_android_storage_shortcut for
# action $1 and target $2. A network shortcut is a read-only folder holding
# target.lnk and a desktop.ini that makes Explorer show it as the target.
windows_storage_shortcut_script() {
  local action="$1"
  local target="${2//\'/\'\'}"

  printf "\$action = '%s'\n\$target = '%s'\n" "${action}" "${target}"
  cat <<'EOF'
$dir = Join-Path $env:APPDATA 'Microsoft\Windows\Network Shortcuts\Android (Ika)'
$link = Join-Path $dir 'target.lnk'
$shell = New-Object -ComObject WScript.Shell
if ($action -eq 'remove') {
  if ((Test-Path -LiteralPath $link) -and $shell.CreateShortcut($link).TargetPath -eq $target) {
    Remove-Item -LiteralPath $dir -Recurse -Force
  }
  exit
}
New-Item -ItemType Directory -Force -Path $dir | Out-Null
$shortcut = $shell.CreateShortcut($link)
$shortcut.TargetPath = $target
$shortcut.Save()
$ini = Join-Path $dir 'desktop.ini'
