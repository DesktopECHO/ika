#!/usr/bin/bash

# DPI is calculated automatically. Set manually by uncommenting the next line:
# export IKADPI=144

set -euo pipefail
exec 3>&1

SCRIPT_NAME="$(basename "$0")"
PACKAGED_CVD_HOST_OUT="/usr/lib/cuttlefish-common"
DEFAULT_CVD_PRODUCT_OUT="/usr/share/cuttlefish-common/lineageos"
PACKAGED_SCRCPY_BIN="/usr/lib/cuttlefish-common/bin/scrcpy"
PACKAGED_SCRCPY_SERVER="/usr/lib/cuttlefish-common/share/scrcpy/scrcpy-server"
PACKAGED_GETCHROMIUM_BIN="/usr/lib/cuttlefish-common/bin/getchromium"
PACKAGED_IKA_ROOT_BIN="/usr/lib/cuttlefish-common/bin/ika-root"
PACKAGED_MADBFS_BIN="/usr/lib/cuttlefish-common/bin/madbfs"
SCRCPY_ICON_DIR_DEFAULT="/usr/lib/cuttlefish-common/share/icons/hicolor/256x256/apps"
IKA_SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"

# ============================================================================
# Settings file (~/ika/ika.ini)
# ============================================================================
# The defaults below can be changed in ~/ika/ika.ini, which ika_ini_write_default
# generates when it is missing. Precedence: command line, then environment
# variable, then ika.ini, then the default in this script. Runs before log()
# exists, so it writes to stderr itself.
IKA_INI_FILE="${CVD_HOME_DIR:-${HOME}/ika}/ika.ini"
declare -A IKA_INI=()
declare -A IKA_INI_USED=()

ika_ini_warn() {
  printf '[%s] %s\n' "${SCRIPT_NAME}" "$*" >&2
}

# Reads "[section]" headers and "key = value" lines into IKA_INI as
# "section.key". Lines starting with # or ; are comments; values are literal.
ika_ini_load() {
  local file="$1"
  local line section="" key value
  local line_number=0

  [[ -r "${file}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_number=$((line_number + 1))
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "${line}" in
      ""|"#"*|";"*)
        ;;
      "["*"]")
        section="${line:1:${#line}-2}"
        section="${section#"${section%%[![:space:]]*}"}"
        section="${section%"${section##*[![:space:]]}"}"
        section="${section,,}"
        ;;
      *=*)
        if [[ -z "${section}" ]]; then
          ika_ini_warn "${file}:${line_number}: setting outside a [section]; ignored"
          continue
        fi
        key="${line%%=*}"
        value="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        IKA_INI["${section}.${key,,}"]="${value}"
        ;;
      *)
        ika_ini_warn "${file}:${line_number}: not a setting; ignored"
        ;;
    esac
  done <"${file}"
}

# ika_ini_get VAR SECTION KEY DEFAULT [uint]: sets VAR to the ika.ini value, or
# to DEFAULT when the file has none. With "uint" a value that is not a positive
# whole number is reported and replaced by DEFAULT. Not a command substitution,
# so that IKA_INI_USED records the key.
ika_ini_get() {
  local -n _ika_out="$1"
  local _ika_key="$2.$3"
  local _ika_val="$4"

  IKA_INI_USED["${_ika_key}"]=1
  if [[ -n "${IKA_INI[${_ika_key}]+set}" ]]; then
    _ika_val="${IKA_INI[${_ika_key}]}"
    if [[ "${5:-}" == "uint" && ! "${_ika_val}" =~ ^[1-9][0-9]*$ ]]; then
      ika_ini_warn "${IKA_INI_FILE}: ${2}.${3} must be a positive whole number, not '${_ika_val}'; using $4"
      _ika_val="$4"
    fi
  fi
  _ika_out="${_ika_val}"
}

# ika_ini_default VAR SECTION KEY DEFAULT [uint]: like ika_ini_get, but an
# environment variable VAR that is already set wins.
ika_ini_default() {
  local ini_value

  IKA_INI_USED["$2.$3"]=1
  [[ -z "${!1:-}" ]] || return 0
  ika_ini_get ini_value "$2" "$3" "$4" "${5:-}"
  printf -v "$1" '%s' "${ini_value}"
}

# ika_ini_list ARRAY SECTION KEY: replaces ARRAY with the words of the ika.ini
# value, when the file has the key.
ika_ini_list() {
  local -n _ika_list="$1"
  local ini_key="$2.$3"
  local words

  IKA_INI_USED["${ini_key}"]=1
  [[ -n "${IKA_INI[${ini_key}]+set}" ]] || return 0
  words="${IKA_INI[${ini_key}]//,/ }"
  _ika_list=()
  read -r -a _ika_list <<<"${words}"
}

# ika_ini_apply_map MAP SECTION: overrides each entry of an associative array of
# cvd_internal_start defaults with the same key in ika.ini.
ika_ini_apply_map() {
  local -n _ika_map="$1"
  local section="$2"
  local key value

  for key in "${!_ika_map[@]}"; do
    ika_ini_get value "${section}" "${key}" "${_ika_map[${key}]}"
    case "${section}.${key}" in
      compute.cpus|compute.memory_mb)
        # "auto" keeps the value calculated from the host.
        if [[ "${value}" == "auto" ]]; then
          continue
        elif [[ ! "${value}" =~ ^[1-9][0-9]*$ ]]; then
          ika_ini_warn "${IKA_INI_FILE}: ${section}.${key} must be auto or a positive whole number, not '${value}'; using auto"
          continue
        fi
        ;;
    esac
    _ika_map["${key}"]="${value}"
  done
}

ika_ini_warn_unknown() {
  local ini_key

  for ini_key in "${!IKA_INI[@]}"; do
    [[ -n "${IKA_INI_USED[${ini_key}]+set}" ]] \
      || ika_ini_warn "${IKA_INI_FILE}: unknown setting '${ini_key}'; ignored"
  done
}

# Keep the values here equal to the defaults in this script; the test
# tools/tests/test_ika_settings.sh checks that they are.
ika_ini_write_default() {
  cat <<'EOF'
# Ika settings. Ika writes this file the first time it runs; edit it to change
# Ika's defaults. Delete it to get a fresh copy, or delete a line to use the
# built-in default for that setting.
#
# A line starting with # or ; is a comment. Values are written as they are,
# without quotes, and a # after a value is part of the value. Command-line
# options override this file, and an environment variable named in a
# comment below overrides its setting. Changes apply the next time Ika starts
# the VM (or the console, for [console] and [apps]).


# ----------------------------------------------------------------------------
[compute]
# Virtual CPUs and guest memory. "auto" sizes them from the host: half the
# performance cores, counting each hardware thread (at most cpu_cap), and a
# quarter of the host's memory rounded up to a multiple of memory_step_mb (at
# most memory_cap_mb). Each vCPU is pinned to a host CPU, from the highest CPU
# number down. Command-line equivalents: --cpus=, --memory_mb=
cpus = auto
memory_mb = auto
cpu_cap = 12
memory_step_mb = 2048
memory_cap_mb = 32768
# Used when the host's memory cannot be read.
memory_fallback_mb = 4096
enable_bootanimation = false
enable_sandbox = false


# ----------------------------------------------------------------------------
[gpu]
# gfxstream_guest_angle, gfxstream, guest_swiftshader, ... Command-line
# equivalent: --gpu_mode=. Hosts with only software Vulkan devices use
# gfxstream whatever is set here.
gpu_mode = gfxstream_guest_angle
gpu_vhost_user_mode = auto
enable_gpu_udmabuf = true
use_cvdalloc = true
# Features of gfxstream's renderer, separated by semicolons.
gpu_renderer_features = MinimalLogging:disabled;VulkanBatchedDescriptorSetUpdate:disabled
# auto, on or off. With gfxstream_guest_angle this is ignored.
# Command-line equivalent: --gfxstream_vulkan=. Environment variable:
# GFXSTREAM_VULKAN
gfxstream_vulkan = auto
# auto or off. auto gives Android a video decoder backed by the host's VA-API
# (H.264, HEVC, VP8 and VP9, as far as the host decodes them) when vainfo
# finds a working VA-API driver. Command-line equivalent: --hw_video_decode=.
# Environment variable: IKA_HW_VIDEO_DECODE
hw_video_decode = auto


# ----------------------------------------------------------------------------
[lowcpu]
# Low-CPU mode for weak hosts: the display refreshes at refresh_rate_hz
# instead of 60 Hz, window blurs are off and animations run at half their
# length; the display's size and density stay as they are. auto, on or off.
# auto turns it on when vulkaninfo finds no hardware Vulkan device on the
# host, when the GPU mode is guest_swiftshader, when the guest gets 2 vCPUs
# or fewer, or when the host has less than 8 GB of memory. Command-line
# equivalents: --lowcpu, --no-lowcpu. Environment variable: IKA_LOWCPU
mode = auto
# Display refresh rate in low-CPU mode, in Hz. A --display= option wins.
refresh_rate_hz = 30


# ----------------------------------------------------------------------------
[camera]
# Anti-flicker of the camera passed to Android with --camera: auto, 50, 60 or
# off. Lights flicker at twice the mains frequency; a camera set for the wrong
# one shows bands and in dim light can run slower. auto takes the mains
# frequency of the country of the host's timezone, and leaves the camera's own
# setting where that country has two (Japan). Command-line equivalent:
# --camera_power_line_frequency=. Environment variable:
# IKA_CAMERA_POWER_LINE_FREQUENCY
power_line_frequency = auto


# ----------------------------------------------------------------------------
[network]
vhost_net = true
vhost_user_vsock = false
# Native vsock carries adb; the half tunnel keeps TCP 6520 for fastboot.
adb_mode = native_vsock,vsock_half_tunnel
enable_wifi = false
enable_host_bluetooth = false
netsim_bt = false
enable_host_nfc = false
netsim_nfc = false
casimir_instance_num = 1
enable_host_uwb = false
netsim_uwb = false
pica_instance_num = 1
start_gnss_proxy = false
enable_modem_simulator = false


# ----------------------------------------------------------------------------
[storage]
# Size of the data partition in decimal GB for a new VM. 'ika reset
# --data_gb=N' sets a different size and remembers it.
data_gb = 64
use_overlay = true
use_sdcard = false


# ----------------------------------------------------------------------------
[logging]
# VERBOSE, DEBUG, INFO, WARNING, ERROR or FATAL.
file_verbosity = WARNING
verbosity = WARNING


# ----------------------------------------------------------------------------
[reporting]
# y or n: send anonymous usage statistics to Google.
report_anonymous_usage_stats = n


# ----------------------------------------------------------------------------
[launcher]
daemon = true
start_webrtc = false


# ----------------------------------------------------------------------------
[boot]
# Seconds to wait for Android to finish booting. Past them, a start keeps
# waiting while Android still makes progress, for up to four times as long.
# Environment variable: CVD_BOOT_TIMEOUT_SEC
boot_timeout_sec = 150


# ----------------------------------------------------------------------------
[console]
# Display density. "auto" calculates it from the host's display.
# Command-line equivalent: --dpi=. Environment variable: IKADPI
dpi = auto
# Display density in Android's TV mode. "auto" is 1.5 times the density "auto"
# calculates for dpi, so that the TV interface is larger.
# Command-line equivalent: --dpi=, in either mode. Environment variable:
# IKA_TV_DPI
tv_dpi = auto
# Extra arguments for the console, separated by spaces, for example
# --keyboard=uhid --no-clipboard-autosync
# Command-line equivalent: --ika_scrcpy=. Environment variable: IKA_SCRCPY
scrcpy_args =
# Seconds to wait for the guest to reboot before leaving the console closed.
# Environment variable: IKA_SCRCPY_REBOOT_TIMEOUT_SEC
reboot_timeout_sec = 120


# ----------------------------------------------------------------------------
[apps]
# Seconds between checks for installed or removed apps while the app menu
# watcher runs. Environment variable: IKA_APP_MENU_POLL_SEC
menu_poll_sec = 5
# Apps kept out of the app list, name matching and the desktop menu, as package
# names separated by spaces. They can still be opened by their package name.
hidden_apps = com.google.android.apps.restore com.google.android.googlequicksearchbox com.android.calculator2 org.lineageos.etar com.android.deskclock com.android.contacts org.lineageos.recorder org.lineageos.audiofx
# Apps opened as games, in a fullscreen game session, even though they do not
# declare themselves as games. Package names separated by spaces.
game_apps =


# ----------------------------------------------------------------------------
[timeouts]
# Seconds 'ika install' allows for each APK. Environment variable:
# IKA_INSTALL_TIMEOUT_SEC
install_timeout_sec = 1800
# Seconds 'ika gsf' waits for Google Play Services to assign the ID.
# Environment variable: IKA_GSF_ID_TIMEOUT_SEC
gsf_id_timeout_sec = 120
# Seconds 'ika backup' and 'ika restore' allow for listing apps, and for
# copying one app's files.
backup_list_timeout_sec = 120
backup_copy_timeout_sec = 3600


# ----------------------------------------------------------------------------
[system]
# Seconds to allow Cuttlefish and gfxstream to clean up before forcing
# surviving processes to exit. Environment variable: IKA_STOP_GRACE_SEC
stop_grace_sec = 30
# Open-file limit Ika raises its processes to when it is lower.
# Environment variable: IKA_MIN_OPEN_FILES
min_open_files = 65536
# Page size of the guest kernel on ARM64 hosts: auto, 4k or 16k.
# Environment variable: IKA_KERNEL_PAGE_SIZE
kernel_page_size = auto
EOF
}

if [[ ! -e "${IKA_INI_FILE}" ]]; then
  if mkdir -p "${IKA_INI_FILE%/*}" 2>/dev/null \
      && ika_ini_write_default >"${IKA_INI_FILE}.$$" 2>/dev/null; then
    mv -n -- "${IKA_INI_FILE}.$$" "${IKA_INI_FILE}" 2>/dev/null || true
  fi
  rm -f -- "${IKA_INI_FILE}.$$"
fi
ika_ini_load "${IKA_INI_FILE}"

# Prints the pid recorded in a supervisor pid file if it is still a live
# supervisor of the given kind (__console_supervisor or __app_supervisor).
supervisor_pid_from_file() {
  local pid_file="$1"
  local marker="$2"
  local pid
  local command_line

  [[ -n "${pid_file}" && -f "${pid_file}" ]] || return 1
  pid="$(<"${pid_file}")"
  [[ "${pid}" =~ ^[0-9]+$ && -r "/proc/${pid}/cmdline" ]] || return 1
  [[ "$(stat -c '%u' "/proc/${pid}" 2>/dev/null || true)" == "${UID}" ]] || return 1
  command_line="$(tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null || true)"
  [[ "${command_line}" == *" ${marker} "* ]] || return 1
  printf '%s\n' "${pid}"
}

stop_supervisor_from_file() {
  local pid_file="$1"
  local marker="$2"
  local pid
  local deadline

  pid="$(supervisor_pid_from_file "${pid_file}" "${marker}" || true)"
  if [[ -z "${pid}" ]]; then
    rm -f "${pid_file}"
    return 0
  fi

  kill "${pid}" >/dev/null 2>&1 || true
  deadline=$((SECONDS + 5))
  while kill -0 "${pid}" >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      printf '[%s] supervisor pid %s did not exit cleanly; forcing termination\n' "${SCRIPT_NAME}" "${pid}" >&2
      kill -9 "${pid}" >/dev/null 2>&1 || true
      break
    fi
    sleep 0.2
  done
  rm -f "${pid_file}"
}

scrcpy_supervisor_pid() {
  supervisor_pid_from_file "${SCRCPY_SUPERVISOR_PID_FILE:-}" __console_supervisor
}

stop_scrcpy_supervisor() {
  stop_supervisor_from_file "${SCRCPY_SUPERVISOR_PID_FILE:-}" __console_supervisor
}

stop_app_supervisors() {
  local pid_file

  for pid_file in "${CVD_TMP_DIR}"/app-supervisor-*.pid; do
    [[ -f "${pid_file}" ]] || continue
    stop_supervisor_from_file "${pid_file}" __app_supervisor
  done
}

# Checks if a flag was supplied by the user in the arguments
user_supplied_flag() {
  local flag="$1"
  shift
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --${flag}=*|--${flag}|-${flag}=*|-${flag})
        return 0
        ;;
    esac
  done
  return 1
}

# App windows opened by `ika app` carry IKA_APP_PACKAGE in their environment.
is_app_window_process() {
  tr '\0' '\n' <"$1/environ" 2>/dev/null | grep -q '^IKA_APP_PACKAGE='
}

# Lists packaged scrcpy processes owned by this user. Scope "console" skips
# app windows and app list queries; "all" includes them. Candidates come from
# pgrep by process name, since checking every process costs over a second.
packaged_scrcpy_pids() {
  local scope="${1:-all}"
  local pid
  local proc
  local argv0
  local exe_path
  local matched
  local name
  local -A names=()

  names["$(basename "${SCRCPY_BIN:-${PACKAGED_SCRCPY_BIN}}")"]=1
  names["$(basename "${PACKAGED_SCRCPY_BIN}")"]=1
  for name in "${!names[@]}"; do
    # The kernel keeps only the first 15 characters of a process name.
    pgrep -u "${UID}" -x "${name:0:15}" || true
  done | sort -u | while read -r pid; do
    proc="/proc/${pid}"
    matched="false"
    argv0="$(tr '\0' '\n' <"${proc}/cmdline" 2>/dev/null | head -n1 || true)"
    if [[ "${argv0}" == "${SCRCPY_BIN:-${PACKAGED_SCRCPY_BIN}}" \
        || "${argv0}" == "${PACKAGED_SCRCPY_BIN}" ]]; then
      matched="true"
    else
      exe_path="$(readlink -f "${proc}/exe" 2>/dev/null || true)"
      exe_path="${exe_path% (deleted)}"
      if [[ "${exe_path}" == "${SCRCPY_BIN:-${PACKAGED_SCRCPY_BIN}}" \
          || "${exe_path}" == "${PACKAGED_SCRCPY_BIN}" ]]; then
        matched="true"
      fi
    fi
    [[ "${matched}" == "true" ]] || continue

    if [[ "${scope}" == "console" ]] \
        && { is_app_window_process "${proc}" \
             || tr '\0' '\n' <"${proc}/cmdline" 2>/dev/null | grep -qx -- '--list-apps'; }; then
      continue
    fi
    printf '%s\n' "${pid}"
  done
}

has_packaged_scrcpy() {
  local pids

  pids="$(packaged_scrcpy_pids console)"
  [[ -n "${pids}" ]]
}

# Scope "console" closes only the desktop console, leaving app windows open;
# "all" also closes app windows and stops their supervisors first so they do
# not relaunch the windows.
stop_startup_packaged_scrcpy() {
  local scope="${1:-all}"
  local pid
  local deadline

  stop_scrcpy_supervisor
  if [[ "${scope}" == "all" ]]; then
    stop_app_supervisors
  fi

  while read -r pid; do
    [[ -n "${pid}" ]] || continue

    kill "${pid}" >/dev/null 2>&1 || true

    deadline=$((SECONDS + 5))
    while kill -0 "${pid}" >/dev/null 2>&1; do
      if (( SECONDS >= deadline )); then
        printf '[%s] console process pid %s did not exit cleanly; forcing termination\n' "${SCRIPT_NAME}" "${pid}" >&2
        kill -9 "${pid}" >/dev/null 2>&1 || true
        sleep 0.5
        break
      fi
      sleep 0.2
    done
  done < <(packaged_scrcpy_pids "${scope}" | sort -u)
}

# Prints "<cpu> <cpu_capacity>" for each online host CPU: the kernel's own
# measure of each CPU's performance, which its scheduler uses, with the
# difference in work per cycle as well as in frequency (Apple, Intel P and E
# cores, AMD Zen 5 and 5c).
host_cpu_performance() {
  local path
  for path in /sys/devices/system/cpu/cpu[0-9]*; do
    if [[ -r "${path}/online" && "$(<"${path}/online")" != 1 ]]; then
      continue
    fi
    printf '%s %s\n' "${path##*/cpu}" "$(<"${path}/cpu_capacity")"
  done
}

# Performance cores are those within 85% of the fastest: a hybrid CPU's
# efficiency cores are well below that, while the few percent between the
# preferred cores of other CPUs are not.
performance_core_ids() {
  host_cpu_performance | awk '
    { cpu[NR] = $1; perf[NR] = $2; if ($2 > max) max = $2 }
    END { for (i = 1; i <= NR; i++) if (perf[i] * 100 >= max * 85) print cpu[i] }' | sort -n
}

count_performance_cores() {
  performance_core_ids | wc -l
}

# The host CPUs the vCPUs are pinned to, in vCPU order: the performance cores
# from the highest CPU number down, then any other CPUs the same way. Linux
# numbers a core's second hardware thread after every core's first, so the
# top half of the performance CPUs is one thread on each of the upper cores,
# and the lower ones are left to the host.
host_cpus_for_vcpus() {
  local -A performance=()
  local cpu

  for cpu in $(performance_core_ids); do
    performance["${cpu}"]=1
  done
  for cpu in $(host_cpu_performance | awk '{ print $1 }' | sort -nr); do
    if [[ -n "${performance[${cpu}]:-}" ]]; then
      echo "${cpu}"
    fi
  done
  for cpu in $(host_cpu_performance | awk '{ print $1 }' | sort -nr); do
    if [[ -z "${performance[${cpu}]:-}" ]]; then
      echo "${cpu}"
    fi
  done
}

# Upstream Cuttlefish's Virtual Cpufreq configuration (--vcpu_config_path)
# pins each vCPU to a host CPU (host_cpus_for_vcpus). On arm64 the guest also
# sees that CPU's capacity, frequencies and frequency domain, and its frequency
# requests reach the host scheduler as uclamp on the vCPU threads. crosvm has
# no Virtual Cpufreq on x86, where it only takes the pinning.

# Writes the configuration for CPUS vCPUs, whose cgroup is CGROUP, to OUT.
write_vcpu_config() {
  local cpus="$1"
  local cgroup="$2"
  local out="$3"
  local -a order
  local -A domains=()
  local max_khz
  local cpu
  local vcpu
  local path
  local khz
  local freqs
  local capacity
  local policy
  local domain
  local separator=""

  mapfile -t order < <(host_cpus_for_vcpus)
  if host_is_arm64; then
    max_khz="$(sort -n /sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq | tail -n1)"
  fi

  {
    printf '{\n  "guest_soc": "ika",\n  "cgroup_path": "%s",\n  "cpus": {' "${cgroup}"
    for (( vcpu = 0; vcpu < cpus; vcpu++ )); do
      cpu="${order[vcpu % ${#order[@]}]}"
      path="/sys/devices/system/cpu/cpu${cpu}"
      if host_is_arm64; then
        khz="$(<"${path}/cpufreq/cpuinfo_max_freq")"
        policy="$(readlink -f "${path}/cpufreq")"
        [[ -n "${domains[${policy}]:-}" ]] || domains["${policy}"]="${#domains[@]}"
        domain="${domains[${policy}]}"
        freqs="$(tr ' ' '\n' < "${path}/cpufreq/scaling_available_frequencies" | grep . | sort -n | paste -sd,)"
        # crosvm's capacity is per MHz (capacity-dmips-mhz), which the guest
        # scales by the frequencies: take them out of the kernel's capacity.
        capacity="$(( ($(<"${path}/cpu_capacity") * max_khz + khz / 2) / khz ))"
      else
        # Not passed to crosvm on x86, which takes only the pinning.
        freqs=0
        capacity=1024
        domain=0
      fi
      printf '%s\n    "cpu%d": { "affinity": %d, "frequencies": "%s", "capacity": %d, "ipc_ratio": 1024, "freq_domain": %d }' \
        "${separator}" "${vcpu}" "${cpu}" "${freqs}" "${capacity}" "${domain}"
      separator=","
    done
    printf '\n  }\n}\n'
  } > "${out}"
}

# Runs in the systemd scope that start_cvd launches Cuttlefish in, with the
# cgroup delegated to the user: moves itself to a leaf, so that the scope can
# give the cpu controller to "android", where the launcher and crosvm run.
# "android" is a threaded domain: crosvm adds a threaded vcpu-domainN for each
# frequency domain, and the launcher moves the other threads to "workers" once
# Android has booted. Then writes the configuration and runs the launcher.
launch_in_vcpu_scope() {
  local cpus="$1"
  shift
  local scope
  local cgroup
  local config="${CVD_TMP_DIR}/vcpu-config.json"

  scope="/sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup)"
  cgroup="${scope}/android"
  mkdir "${scope}/launcher" "${cgroup}" "${cgroup}/workers" \
    && echo "$$" > "${scope}/launcher/cgroup.procs" \
    && echo threaded > "${cgroup}/workers/cgroup.type" \
    && echo +cpu > "${scope}/cgroup.subtree_control" \
    && echo +cpu > "${cgroup}/cgroup.subtree_control" \
    || die "could not set up the vCPU cgroup in ${scope}"
  mkdir -p "${CVD_TMP_DIR}"
  write_vcpu_config "${cpus}" "${cgroup}" "${config}" \
    || die "could not write ${config} from the host's cpufreq"
  exec "$@" "--vcpu_config_path=${config}"
}

# Upper bound on the auto-selected guest vCPU count. The default heuristic
# never exceeds this; pass --cpus= to request more.
ika_ini_get DEFAULT_GUEST_CPU_CAP compute cpu_cap 12 uint
ika_ini_get DEFAULT_GUEST_MEMORY_STEP_MB compute memory_step_mb 2048 uint
ika_ini_get DEFAULT_GUEST_MEMORY_CAP_MB compute memory_cap_mb 32768 uint
ika_ini_get DEFAULT_GUEST_MEMORY_FALLBACK_MB compute memory_fallback_mb 4096 uint
readonly DEFAULT_GUEST_CPU_CAP DEFAULT_GUEST_MEMORY_STEP_MB \
  DEFAULT_GUEST_MEMORY_CAP_MB DEFAULT_GUEST_MEMORY_FALLBACK_MB

default_guest_cpus() {
  local guest_cpus

  # Half the performance cores (counting each hardware thread), the rest for
  # the host; at least 1, at most cpu_cap. --cpus= bypasses this.
  guest_cpus=$(( $(count_performance_cores) / 2 ))
  (( guest_cpus >= 1 )) || guest_cpus=1
  (( guest_cpus <= DEFAULT_GUEST_CPU_CAP )) || guest_cpus=${DEFAULT_GUEST_CPU_CAP}
  echo "${guest_cpus}"
}

host_physical_memory_mb() {
  local block_size_hex block_size_bytes block_count state path
  local mem_kb

  if [[ -r /sys/devices/system/memory/block_size_bytes ]]; then
    block_size_hex="$(</sys/devices/system/memory/block_size_bytes)"
    block_size_hex="${block_size_hex#0x}"
    if [[ "${block_size_hex}" =~ ^[0-9A-Fa-f]+$ ]]; then
      block_size_bytes=$((16#${block_size_hex}))
      block_count=0
      for path in /sys/devices/system/memory/memory[0-9]*; do
        [[ -d "${path}" ]] || continue
        if [[ -r "${path}/state" ]]; then
          state="$(<"${path}/state")"
          [[ "${state}" == "online" ]] || continue
        fi
        ((block_count += 1))
      done
      if (( block_size_bytes > 0 && block_count > 0 )); then
        echo $(((block_size_bytes * block_count) / 1024 / 1024))
        return 0
      fi
    fi
  fi

  mem_kb="$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null || true)"
  mem_kb="${mem_kb//[!0-9]/}"
  if [[ -n "${mem_kb}" ]] && (( mem_kb > 0 )); then
    echo $((mem_kb / 1024))
  fi
}

default_guest_memory_mb() {
  local mem_mb target_mb rounded_mb

  mem_mb="$(host_physical_memory_mb)"
  mem_mb="${mem_mb//[!0-9]/}"
  if [[ -z "${mem_mb}" ]] || (( mem_mb <= 0 )); then
    echo "${DEFAULT_GUEST_MEMORY_FALLBACK_MB}"
    return 0
  fi

  target_mb=$((mem_mb / 4))
  rounded_mb=$((((target_mb + DEFAULT_GUEST_MEMORY_STEP_MB - 1) / DEFAULT_GUEST_MEMORY_STEP_MB) * DEFAULT_GUEST_MEMORY_STEP_MB))

  (( rounded_mb >= DEFAULT_GUEST_MEMORY_STEP_MB )) || rounded_mb=${DEFAULT_GUEST_MEMORY_STEP_MB}
  (( rounded_mb <= DEFAULT_GUEST_MEMORY_CAP_MB )) || rounded_mb=${DEFAULT_GUEST_MEMORY_CAP_MB}

  echo "${rounded_mb}"
}

