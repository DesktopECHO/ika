# ============================================================================
# Host camera passthrough (--camera)
# ============================================================================
#
# '--camera' passes a host V4L2 camera to the guest with crosvm virtio-media
# (cvd --media=v4l2_proxy:device=...). The guest's external camera HAL
# serves it as the front camera. Without a value, the first video capture
# device offering MJPEG, NV12 or YUYV is used: USB (UVC) webcams, the FaceTime
# camera of Apple Silicon Macs (Asahi apple-isp) and of older Intel Macs
# (facetimehd). Virtual cameras (v4l2loopback and vivid) are used only when
# there is no other.

# True when DEVICE is a camera the guest can use: a video capture node offering
# MJPEG, NV12 or YUYV. Without v4l2-ctl, accepts the first node of each device
# (sysfs index 0), as UVC cameras add metadata nodes after their capture node.
is_usable_camera_device() {
  local device="$1"
  local info
  local caps
  local formats

  if ! command -v v4l2-ctl >/dev/null 2>&1; then
    [[ "$(cat "/sys/class/video4linux/${device##*/}/index" 2>/dev/null)" == "0" ]]
    return
  fi

  info="$(v4l2-ctl -d "${device}" --info 2>/dev/null)" || return 1
  caps="$(awk '/Device Caps/ { print $NF; exit }' <<<"${info}")"
  [[ "${caps}" =~ ^0x[0-9a-fA-F]+$ ]] || return 1
  # V4L2_CAP_VIDEO_CAPTURE
  (( caps & 0x1 )) || return 1
  formats="$(v4l2-ctl -d "${device}" --list-formats 2>/dev/null)" || return 1
  [[ "${formats}" =~ \'(MJPG|NV12|YUYV)\' ]]
}

# Prints the V4L2 driver name of DEVICE (e.g. "uvcvideo", "v4l2 loopback").
camera_v4l2_driver() {
  v4l2-ctl -d "$1" --info 2>/dev/null \
    | sed -n 's/^[[:space:]]*Driver name[[:space:]]*:[[:space:]]*//p' | head -n 1
}

# True when DEVICE is a virtual camera: v4l2loopback or the vivid test driver.
# These have no parent device in sysfs.
is_virtual_camera_device() {
  local device="$1"

  case "$(camera_v4l2_driver "${device}")" in
    "v4l2 loopback"|vivid) return 0 ;;
  esac
  [[ ! -e "/sys/class/video4linux/${device##*/}/device" ]]
}

# Prints the host's video nodes as /dev/videoN, in number order.
list_video_devices() {
  local node

  while IFS= read -r node; do
    [[ -c "/dev/${node}" ]] && printf '/dev/%s\n' "${node}"
  done < <(find /sys/class/video4linux -maxdepth 1 -name 'video*' -printf '%f\n' 2>/dev/null | sort -V)
}

# Prints the first usable host camera in /dev/videoN order, preferring a
# physical camera over a virtual one.
detect_host_camera() {
  local device
  local virtual=""

  while IFS= read -r device; do
    is_usable_camera_device "${device}" || continue
    if ! is_virtual_camera_device "${device}"; then
      printf '%s\n' "${device}"
      return 0
    fi
    [[ -n "${virtual}" ]] || virtual="${device}"
  done < <(list_video_devices)
  [[ -n "${virtual}" ]] || return 1
  printf '%s\n' "${virtual}"
}

# Prints the host camera for --camera: "auto" (or empty) detects one,
# "videoN" or "/dev/videoN" names one.
resolve_camera_device() {
  local requested="${1:-auto}"
  local device
  local sysfs
  local name
  local driver

  case "${requested}" in
    auto)
      device="$(detect_host_camera)" \
        || die_with_notification "No usable camera found." \
          "no usable camera found (a video capture device offering MJPEG, NV12 or YUYV); name one with --camera=videoN"
      ;;
    *)
      [[ "${requested}" =~ ^(/dev/)?video[0-9]+$ ]] \
        || die "--camera expects videoN or /dev/videoN, got '${requested}'"
      device="/dev/${requested#/dev/}"
      [[ -c "${device}" ]] || die "camera ${device} does not exist"
      is_usable_camera_device "${device}" \
        || log "warning: ${device} does not look like a camera (a video capture device offering MJPEG, NV12 or YUYV); Android may show none"
      ;;
  esac

  [[ -r "${device}" && -w "${device}" ]] \
    || die "no access to camera ${device}; add your user to the video group and log in again"
  sysfs="/sys/class/video4linux/${device##*/}"
  name="$(cat "${sysfs}/name" 2>/dev/null || true)"
  # uvcvideo names nodes "PRODUCT: ENTITY" (cut at 31 characters); keep PRODUCT
  name="${name%: *}"
  driver="$(readlink -f "${sysfs}/device/driver" 2>/dev/null || true)"
  driver="${driver##*/}"
  # Virtual cameras have no parent device in sysfs
  [[ -n "${driver}" ]] || driver="$(camera_v4l2_driver "${device}")"
  # The Asahi driver names the Apple Silicon FaceTime HD camera after itself
  [[ "${driver}" == "apple-isp" ]] && name="FaceTime HD Camera (Built-in)"
  log "camera${driver:+ ${driver}}: ${name:+${name} at }${device}"
  printf '%s\n' "${device}"
}

normalize_camera_power_line_frequency() {
  case "${1,,}" in
    ""|auto) echo "auto" ;;
    50|50hz) echo "50" ;;
    60|60hz) echo "60" ;;
    0|off|no|false|disable|disabled) echo "off" ;;
    *) die "invalid camera power line frequency '${1}' (expected auto, 50, 60 or off)" ;;
  esac
}

# Prints the ISO 3166 code of the country of timezone ZONE, from tzdata.
timezone_country() {
  awk -v zone="$1" '!/^#/ && $3 == zone { print $1; exit }' \
    "${IKA_ZONE_TAB:-/usr/share/zoneinfo/zone.tab}" 2>/dev/null
}

# Prints the mains frequency of COUNTRY, 50 or 60, or nothing where it differs
# within the country (Japan, French Polynesia) or the country is unknown.
country_mains_frequency() {
  case "$1" in
    "") ;;
    JP|PF) ;;
    AG|AI|AS|AW|BM|BR|BS|BZ|CA|CO|CR|CU|DO|EC|FM|GT|GU|GY|HN|HT|KN|KR|KY|LR|MF|MS|MX|NI|PA|PE|PH|PR|PW|SA|SR|SV|SX|TT|TW|US|VE|VG|VI)
      echo "60" ;;
    *) echo "50" ;;
  esac
}

# Sets the anti-flicker (power line frequency) control of camera DEVICE to the
# mains frequency of the host's lights: IKA_CAMERA_POWER_LINE_FREQUENCY, or with
# "auto" that of the country of the host's timezone (the one Android gets).
# Lights flicker at twice the mains frequency; set for the wrong one, a camera
# shows bands, and in dim light it can lower its frame rate further than needed
# (a 2011 MacBook Pro camera: 14 fps at 50 Hz, 17 fps at 60 Hz, in the same
# room). Nothing in Android sets the control, and it stays set until the camera
# is reset.
apply_camera_power_line_frequency() {
  local device="$1"
  local mode
  local hz
  local reason=""
  local zone
  local country
  local value
  local label

  mode="$(normalize_camera_power_line_frequency "${IKA_CAMERA_POWER_LINE_FREQUENCY}")"
  command -v v4l2-ctl >/dev/null 2>&1 || return 0
  if ! v4l2-ctl -d "${device}" --list-ctrls 2>/dev/null | grep -qw power_line_frequency; then
    log "camera anti-flicker: the camera has no such control"
    return 0
  fi

  case "${mode}" in
    auto)
      zone="$(host_timezone)"
      country="$(timezone_country "${zone}")"
      hz="$(country_mains_frequency "${country}")"
      if [[ -z "${hz}" ]]; then
        log "camera anti-flicker: left as the camera has it (no single mains frequency for timezone '${zone:-unknown}'); set camera.power_line_frequency in ${IKA_INI_FILE}"
        return 0
      fi
      reason=" (timezone ${zone})"
      ;;
    off) hz="" ;;
    *) hz="${mode}" ;;
  esac

  # V4L2_CID_POWER_LINE_FREQUENCY: 0 disabled, 1 50 Hz, 2 60 Hz
  case "${hz}" in
    50) value=1; label="50 Hz" ;;
    60) value=2; label="60 Hz" ;;
    *) value=0; label="off" ;;
  esac
  if v4l2-ctl -d "${device}" -c "power_line_frequency=${value}" 2>/dev/null; then
    log "camera anti-flicker: ${label}${reason}"
  else
    log "warning: could not set the anti-flicker of camera ${device} to ${label}"
  fi
}

# Prints the VA-API driver names libva would try for the GPU behind render
# node NODE, from its kernel driver. Prints nothing for a GPU without VA-API
# video decoding.
vaapi_driver_names() {
  local node="$1"
  local kernel_driver

  kernel_driver="$(readlink -f "/sys/class/drm/$(basename "${node}")/device/driver" 2>/dev/null)"
  case "$(basename "${kernel_driver}")" in
    i915) printf '%s\n' iHD i965 ;;
    xe) printf '%s\n' iHD ;;
    amdgpu) printf '%s\n' radeonsi ;;
    radeon) printf '%s\n' radeonsi r600 ;;
    nouveau) printf '%s\n' nouveau ;;
  esac
}

# True when one of the VA-API drivers named on stdin is installed where libva
# looks for it (LIBVA_DRIVERS_PATH, or the distribution's driver directories).
vaapi_driver_installed() {
  local name
  local dir
  local -a dirs=()

  if [[ -n "${LIBVA_DRIVERS_PATH:-}" ]]; then
    IFS=: read -r -a dirs <<<"${LIBVA_DRIVERS_PATH}"
  else
    dirs=(/usr/lib64/dri /usr/lib64/dri-freeworld /usr/lib64/dri-nonfree
      "/usr/lib/$(uname -m)-linux-gnu/dri" /usr/lib/dri)
  fi
  while IFS= read -r name; do
    for dir in "${dirs[@]}"; do
      [[ -e "${dir}/${name}_drv_video.so" ]] && return 0
    done
  done
  return 1
}

# Checks whether crosvm's VA-API decoder backend can be used. On success sets
# CODECS_REF to the codecs it would decode (H.264, HEVC, VP8, VP9) that the
# host's VA-API driver also decodes. Otherwise sets REASON_REF to why not and
# fails. Like crosvm's libva, uses the first render node whose VA driver
# loads, and sets NODE_REF to it.
vaapi_decoder_check() {
  local -n codecs_ref="$1"
  local -n reason_ref="$2"
  local -n node_ref="$3"
  local node
  local profiles
  local capable="false"
  local driver_installed="false"
  local have_vainfo="false"

  codecs_ref=""
  reason_ref=""
  node_ref=""
  command -v vainfo >/dev/null 2>&1 && have_vainfo="true"
  for node in /dev/dri/renderD*; do
    [[ -c "${node}" ]] || continue
    if [[ -n "$(vaapi_driver_names "${node}")" ]]; then
      capable="true"
      vaapi_driver_names "${node}" | vaapi_driver_installed && driver_installed="true"
    fi
    [[ "${have_vainfo}" == "true" ]] || continue
    profiles="$(timeout 10 vainfo --display drm --device "${node}" 2>/dev/null)" || continue
    node_ref="${node}"
    codecs_ref="$(sed -n 's/^[[:space:]]*VAProfile\([A-Za-z0-9_]*\)[[:space:]]*:[[:space:]]*VAEntrypointVLD.*/\1/p' \
        <<<"${profiles}" \
      | sed -n -e 's/^H264\(Baseline\|Main\|High\|StereoHigh\|MultiviewHigh\)$/H.264/p' \
        -e 's/^HEVC\(Main\|Main10\)$/HEVC/p' \
        -e 's/^VP8Version0_3$/VP8/p' \
        -e 's/^VP9Profile[0-3]$/VP9/p' \
      | sort -u | paste -sd ' ')"
    [[ -n "${codecs_ref}" ]] && return 0
    reason_ref="the VA-API driver for ${node} decodes none of H.264, HEVC, VP8 or VP9"
    return 1
  done

  if [[ "${capable}" != "true" ]]; then
    reason_ref="no VA-API capable GPU found"
  elif [[ "${driver_installed}" != "true" || "${have_vainfo}" == "true" ]]; then
    # No driver, or vainfo could not initialize the one that is there.
    reason_ref="VA-API Capable device but drivers are not installed"
  else
    reason_ref="vainfo not found; install libva-utils so Ika can check VA-API decoding"
  fi
  return 1
}

# Fedora's own VA-API drivers leave out H.264 and HEVC, which every GPU they
# drive decodes; RPM Fusion's builds put them back, installed beside Fedora's
# in directories libva searches first. Prints a warning naming the RPM Fusion
# package when the driver for render node NODE decodes CODECS without H.264,
# and nothing otherwise.
vaapi_rpmfusion_warning() {
  local node="$1"
  local codecs="$2"
  local package
  local driver

  [[ -n "${node}" && " ${codecs} " != *" H.264 "* ]] || return 0
  grep -qsE '^(ID|ID_LIKE)=.*fedora' /etc/os-release || return 0
  case "$(vaapi_driver_names "${node}" | head -n 1)" in
    radeonsi) package="mesa-va-drivers-freeworld" driver="/usr/lib64/dri-freeworld/radeonsi_drv_video.so" ;;
    iHD) package="intel-media-driver" driver="/usr/lib64/dri-nonfree/iHD_drv_video.so" ;;
    *) return 0 ;;
  esac
  [[ -e "${driver}" ]] && return 0
  printf '%s\n' "H.264/HEVC hardware video decoding needs the VA-API driver from RPM Fusion: sudo dnf install ${package}"
}

# Attaches the virtio-media video decoder when the host's VA-API driver
# decodes video Android would use it for, unless hw_video_decode is off or the
# start args name a decoder. Android only uses it with a V4L2 Codec2 HAL in the
# ROM; without one it decodes in software as before. Runs once the start log
# is set up, so what it finds is logged there.
append_hw_video_decode_args() {
  local -n args_array="$1"
  shift
  local vaapi_codecs
  local vaapi_reason
  local vaapi_node
  local vaapi_warning

  [[ "$(normalize_hw_video_decode_mode "${IKA_HW_VIDEO_DECODE}")" == "auto" ]] || return 0
  user_supplied_flag "crosvm_media_decoder" "$@" && return 0
  if vaapi_decoder_check vaapi_codecs vaapi_reason vaapi_node; then
    log "hardware video decoding: VA-API ${vaapi_codecs}"
    args_array+=("--crosvm_media_decoder=vaapi")
  else
    [[ "${vaapi_reason}" == "VA-API Capable device but drivers are not installed" ]] \
      && respond_console "${vaapi_reason}"
    log "hardware video decoding: ${vaapi_reason}; decoding in software"
  fi
  vaapi_warning="$(vaapi_rpmfusion_warning "${vaapi_node}" "${vaapi_codecs}")"
  if [[ -n "${vaapi_warning}" ]]; then
    respond_console "${vaapi_warning}"
    log "${vaapi_warning}"
  fi
}

parse_start_options() {
  local -n fullscreen_mode_ref="$1"
  local -n game_mode_ref="$2"
  local -n start_args_ref="$3"
  local camera_device=""
  local hw_video_decode_mode
  shift 3

  hw_video_decode_mode="$(normalize_hw_video_decode_mode "${IKA_HW_VIDEO_DECODE}")"
  IKA_CAMERA_POWER_LINE_FREQUENCY="$(normalize_camera_power_line_frequency \
    "${IKA_CAMERA_POWER_LINE_FREQUENCY}")"

  fullscreen_mode_ref="false"
  game_mode_ref="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--fullscreen)
        fullscreen_mode_ref="true"
        shift
        ;;
      --game)
        fullscreen_mode_ref="true"
        game_mode_ref="true"
        shift
        ;;
      --no-console)
        START_CONSOLE="false"
        shift
        ;;
      # Exported, as restart runs start again
      --lowcpu)
        export IKA_LOWCPU="on"
        shift
        ;;
      --lowcpu=*)
        export IKA_LOWCPU="$(normalize_lowcpu_mode "${1#*=}")"
        shift
        ;;
      --no-lowcpu)
        export IKA_LOWCPU="off"
        shift
        ;;
      --game-session)
        # Internal, used by 'ika app <game>': the console ends the game
        # session when it leaves fullscreen or is closed.
        START_GAME_SESSION="true"
        shift
        ;;
      --gfxstream_vulkan=*)
        GFXSTREAM_VULKAN_MODE="$(normalize_gfxstream_vulkan_mode "${1#*=}")"
        export GFXSTREAM_VULKAN="${GFXSTREAM_VULKAN_MODE}"
        shift
        ;;
      --gfxstream_vulkan)
        shift
        [[ $# -gt 0 ]] || die "--gfxstream_vulkan requires a value: auto, on, or off"
        GFXSTREAM_VULKAN_MODE="$(normalize_gfxstream_vulkan_mode "$1")"
        export GFXSTREAM_VULKAN="${GFXSTREAM_VULKAN_MODE}"
        shift
        ;;
      --data_gb=*|--data_gb)
        respond_console "Use '${SCRIPT_NAME} reset --data_gb=GB' to change userdata size."
        die "--data_gb is only valid with '${SCRIPT_NAME} reset'"
        ;;
      --camera|--camera=*)
        [[ -z "${camera_device}" ]] || die "--camera given more than once"
        camera_device="auto"
        if [[ "$1" == --camera=* ]]; then
          camera_device="${1#--camera=}"
        elif [[ $# -gt 1 && "$2" =~ ^(/dev/)?video[0-9]+$ ]]; then
          camera_device="$2"
          shift
        fi
        # The camera is attached when the VM starts
        if [[ "${START_KEEPS_RUNNING_VM}" == "true" ]] && has_live_cvd_processes; then
          [[ "${camera_device}" == "auto" ]] && camera_device=""
          die "Unable to add camera to a powered-on instance, try '${SCRIPT_NAME} restart --camera${camera_device:+=${camera_device}}'"
        fi
        camera_device="$(resolve_camera_device "${camera_device}")" || exit 1
        start_args_ref+=("--media=v4l2_proxy:device=${camera_device}")
        shift
        ;;
      --camera_power_line_frequency=*)
        IKA_CAMERA_POWER_LINE_FREQUENCY="$(normalize_camera_power_line_frequency "${1#*=}")"
        shift
        ;;
      --camera_power_line_frequency)
        shift
        [[ $# -gt 0 ]] || die "--camera_power_line_frequency requires a value: auto, 50, 60 or off"
        IKA_CAMERA_POWER_LINE_FREQUENCY="$(normalize_camera_power_line_frequency "$1")"
        shift
        ;;
      --hw_video_decode=*)
        hw_video_decode_mode="$(normalize_hw_video_decode_mode "${1#*=}")"
        # 'restart' hands its options to 'start' without this one.
        export IKA_HW_VIDEO_DECODE="${hw_video_decode_mode}"
        shift
        ;;
      --hw_video_decode)
        shift
        [[ $# -gt 0 ]] || die "--hw_video_decode requires a value: auto or off"
        hw_video_decode_mode="$(normalize_hw_video_decode_mode "$1")"
        export IKA_HW_VIDEO_DECODE="${hw_video_decode_mode}"
        shift
        ;;
      --ika_scrcpy=*)
        IKA_SCRCPY="${1#*=}"
        export IKA_SCRCPY
        shift
        ;;
      --ika_scrcpy)
        shift
        [[ $# -gt 0 ]] || die "--ika_scrcpy requires a value"
        IKA_SCRCPY="$1"
        export IKA_SCRCPY
        shift
        ;;
      *)
        start_args_ref+=("$1")
        shift
        ;;
    esac
  done

  # After all options, as --camera_power_line_frequency may follow --camera
  [[ -z "${camera_device}" ]] || apply_camera_power_line_frequency "${camera_device}"
}

console_notify() {
  local action="$1"
  local elapsed_sec="$2"
  local launcher_log_path
  if [[ "${action}" == "started" ]]; then
    launcher_log_path="${CVD_LAUNCHER_LOG}"
    if [[ "${launcher_log_path}" == "${HOME}/"* ]]; then
      launcher_log_path="~/${launcher_log_path#"${HOME}/"}"
    fi
    printf 'Device online in %ss: %s\n' "${elapsed_sec}" "${launcher_log_path}" >&3
    return 0
  fi
  printf 'Android virtual device %s in %ss.\n' "${action}" "${elapsed_sec}" >&3
}

run_timed_operation() {
  local action="$1"
  shift

  local start_epoch
  local elapsed_sec

  start_epoch="$(date +%s)"
  "$@"
  elapsed_sec="$(( $(date +%s) - start_epoch ))"

  console_notify "${action}" "${elapsed_sec}"
}

# Each 'ika start' adds its output to the start log under a dated header line.
readonly START_LOG_RUN_PREFIX="==== "

redirect_start_logs() {
  mkdir -p "$(dirname "${START_LOG_FILE}")"
  trim_log_lines "${START_LOG_FILE}"
  exec >>"${START_LOG_FILE}" 2>&1
  printf '%s%s %s start\n' "${START_LOG_RUN_PREFIX}" "$(date '+%Y-%m-%d %H:%M:%S')" \
    "${SCRIPT_NAME}"
}

usage() {
  local output_fd="${1:-1}"
  cat >&"${output_fd}" <<EOF

Usage:

  ${SCRIPT_NAME} start [-f|--fullscreen|--game|--no-console] [--lowcpu|--no-lowcpu] [--camera[=videoN]] [--gfxstream_vulkan=auto|on|off] [--ika_scrcpy=ARGS] [--setting=arg] ...
  ${SCRIPT_NAME} stop
  ${SCRIPT_NAME} restart [-f|--fullscreen|--game|--no-console] [--lowcpu|--no-lowcpu] [--camera[=videoN]] [--gfxstream_vulkan=auto|on|off] [--ika_scrcpy=ARGS] ...
  ${SCRIPT_NAME} reset [--data_gb=GB]
  ${SCRIPT_NAME} root
  ${SCRIPT_NAME} gsf
  ${SCRIPT_NAME} backup [FILE]
  ${SCRIPT_NAME} restore [FILE]
  ${SCRIPT_NAME} status
  ${SCRIPT_NAME} app NAME|PACKAGE [-f|--fullscreen] [--game] [--touch] [--window] [--title=TEXT] [--size=WxH] [--ika_scrcpy=ARGS]
  ${SCRIPT_NAME} app --info NAME|PACKAGE
  ${SCRIPT_NAME} app
  ${SCRIPT_NAME} app close NAME|PACKAGE|--all
  ${SCRIPT_NAME} app sync [--remove]
  ${SCRIPT_NAME} install FILE.apk...
  ${SCRIPT_NAME} remove NAME|PACKAGE
  ${SCRIPT_NAME} help

Example:

  ${SCRIPT_NAME} start --gpu_mode=guest_swiftshader --cpus=2 --memory_mb=2048 --dpi=240 --fullscreen
  ${SCRIPT_NAME} start --gpu_mode=gfxstream_guest_angle
  ${SCRIPT_NAME} reset --data_gb=128
  ${SCRIPT_NAME} restart --gpu_mode=gfxstream --gfxstream_vulkan=on
  ${SCRIPT_NAME} restart --ika_scrcpy="--no-clipboard-autosync"
  ${SCRIPT_NAME} start --game
  ${SCRIPT_NAME} restart --camera
  ${SCRIPT_NAME} restart --camera=video2
  ${SCRIPT_NAME} app com.gameloft.android.ANMP.GloftA8HM --game
  ${SCRIPT_NAME} app Asphalt 8 --touch

Options:

  --game                 Start the console fullscreen, passing the gamepad,
                         keyboard and mouse through as HID devices (UHID).
                         With app, use UHID input but keep the window unless
                         -f is given.
  --touch                With app, send left-button clicks and drags as real
                         touch input instead of mouse input, for games that
                         ignore the mouse. The right and middle buttons and
                         the wheel stay mouse input, Ctrl or Shift with the
                         left button still simulates a pinch, and the gamepad
                         and keyboard are still forwarded in game mode. A game
                         session already running in the other input mode is
                         restarted. The menu entries of games offer it as
                         "Play with Touch Input". IKA_TOUCH=1 does the same for
                         '${SCRIPT_NAME} start --game'.
  --no-console           With start or restart, run the VM without opening the
                         desktop console window (app windows still work).
  --lowcpu, --no-lowcpu  With start or restart, run low-CPU mode for
                         weak hosts, or not: the display refreshes at 30 Hz
                         (refresh_rate_hz in ika.ini), window blurs are off
                         and animations are shorter; the display's size and
                         density stay as they are. By default it is on when
                         the host has no hardware Vulkan driver, gives the
                         guest 2 vCPUs or fewer, or has less than 8 GB of
                         memory (IKA_LOWCPU=auto|on|off does the same).
  --camera[=videoN]      With start or restart, pass a host camera to Android
                         as its front camera. Without a value, the first
                         video capture device offering MJPEG, NV12 or YUYV
                         is used (USB webcams, the Mac FaceTime camera), and
                         a virtual camera only when there is no other; videoN
                         or /dev/videoN picks one. Applies until the next
                         start or restart without it. Needs the video group.
                         start only adds a camera when Android is off; use
                         restart while it runs.
  --camera_power_line_frequency=auto|50|60|off
                         With --camera, set the camera's anti-flicker to the
                         mains frequency of the room's lights (default auto:
                         that of the country of the host's timezone; ika.ini
                         camera.power_line_frequency).
  --dpi=N                With start or restart, set the display density
                         in either mode (default: from the host display, or
                         144 when no display size can be read, and 1.5 times
                         that in TV mode; IKADPI does the same, and
                         IKA_TV_DPI in TV mode).
  --memory_mb=MB         Override the default guest RAM setting.
                         Normally ~25% of host RAM, capped at 32 GB.
  --data_gb=GB           With reset, configure the userdata size used by the
                         next start and subsequent factory resets.
  --title=TEXT           With app, override the window title (default: the
                         app's label).
  --size=WxH             With app, set the initial window size in logical
                         points (default: last size, or 60% of the screen).

TV mode:

  "Desktop/TV", in the desktop's app menu and the TV launcher's apps, lists
  Desktop Mode and each TV launcher; nothing else changes the mode. Switching
  modes asks, then Android restarts in the other mode; in TV mode, a TV
  launcher becomes the Home app at once. '${SCRIPT_NAME} app Desktop/TV' opens
  it in the console. In TV mode the console opens fullscreen, at 1.5 times the
  desktop's automatic density (tv_dpi in ika.ini; --dpi overrides it), and
  passes the gamepad through as the remote: the D-pad or left stick moves, A selects, B goes back
  and the guide button goes Home. The keyboard and mouse work as on the
  desktop, except that a right click goes back (Shift and right-click for a
  right click). Apps opened from the desktop's app menu or with
  '${SCRIPT_NAME} app' still open in their own windows.

App windows:

  '${SCRIPT_NAME} app NAME' opens one app in its own resizable, titled
  window backed by a Cuttlefish display of its own, added while the VM runs
  and shown with raw frames like the console. The app is restarted on that
  display if it was already running, and closing the window closes the app
  and removes the display. 'stop', 'reset', and 'restart' close all app
  windows; 'start' leaves them open.

  Games (apps declaring android:appCategory="game", or listed in
  IKA_GAME_APPS in this script) start in a game session instead: fullscreen
  on the primary display in the console, with gamepad, keyboard and mouse
  passthrough. Leaving fullscreen or closing that window ends the session:
  the window closes, the game is sent to the background (it keeps its state
  and resumes next time), and the desktop console comes back if it was open
  before. '--window' opens a game in its own window instead. '--game' passes
  the gamepad, keyboard and mouse through as HID devices in an app window.

  '${SCRIPT_NAME} app' alone lists the apps that can be launched, with apps
  already open in their own window in bold (marked "(open)" when the output
  is not a terminal or NO_COLOR is set).

  NAME is a package name or an app label from that list. Labels match
  case-insensitively, exactly or by a unique part ('app setti' opens
  Settings), and need no quotes when they contain spaces.

  '${SCRIPT_NAME} app sync' adds each launchable app to the desktop's app
  menu, as "🎮 ∙ LABEL" for games or "ᗩ ∙ LABEL" for other apps, with its own
  icon, in an "Android Apps (Ika)" group (a GNOME app-grid folder, or a
  submenu on KDE Plasma, XFCE, Cinnamon and MATE), and removes entries for
  apps that were uninstalled. While the VM runs, a watcher started by 'start'
  keeps the menu in sync as apps are installed or removed (log:
  ~/ika/app-menu.log). '--remove' deletes the entries and the group and turns
  the automatic sync off until 'app sync' is run again. 'reset' removes the
  entries as well; the next 'start' rebuilds them.

Installing and removing apps:

  '${SCRIPT_NAME} install FILE.apk...' installs each APK in Android, replacing
  an installed version of the same app and keeping its data. The file manager
  offers it as "Ika APK installer" for APK files. '${SCRIPT_NAME} remove NAME'
  uninstalls an app and deletes its data; NAME is a package name or an app
  label, matched as for 'app'. Apps that come with Android cannot be removed.
  If the VM is not running, either command starts it without the console
  first.

Root:

  '${SCRIPT_NAME} root' runs ika-root, which roots the VM with the latest Magisk
  release and enables developer options. Rooting a VM the first time unlocks
  and wipes it, after asking to confirm; later runs update Magisk and keep the
  data. 'reset' undoes it.

GSF ID:

  '${SCRIPT_NAME} gsf' prints the Google Services Framework ID, copies it to
  the clipboard (wl-copy, xclip or xsel) and opens Google's uncertified device
  page in the default browser. Register the ID there if Google blocks sign-in
  because the device is not Play Protect certified; it does not make the
  device certified. A factory reset gives the device a new ID. If the VM is
  not running, it is started first.

Android files:

  While the VM runs, Android's shared storage (/sdcard) is mounted on
  \$XDG_RUNTIME_DIR/ika/Android (~/ika/Android without one), where host
  programs can open, change and delete its files; the file manager's sidebar
  lists it as Android. 'start' mounts it; 'stop', 'restart' and 'reset'
  unmount it. Its log is ~/ika/madbfs.log.

Backup:

  '${SCRIPT_NAME} backup [FILE]' saves to FILE, a gzip-compressed tar archive
  (default: ~/ika/ika-backup-YYYYMMDDHHMMSS.tgz), the apps you installed,
  with their split APKs, their files in /sdcard/Android/data and game downloads in
  /sdcard/Android/obb, the DCIM, Pictures, Download, Documents, Music, Movies
  and Recordings folders, and your choices: granted app permissions, special
  app access, default apps, apps you disabled, the dark theme, and settings
  such as font size, keyboard, pointer speed and accessibility. App-private
  data such as logins and saved games is not included, nor are files an app
  keeps readable only to itself. Each app is stopped while its files are
  copied. '${SCRIPT_NAME} restore [FILE]' reinstalls the apps, copies the
  files back and reapplies your choices, for example after 'reset'; without
  FILE it restores the latest backup in ~/ika. It asks before it starts, as
  it replaces what is on the device. If the VM is not running, it is started
  first.

Settings:

  Ika's defaults are in ~/ika/ika.ini, which Ika writes the first time it
  runs. Edit it to change them: it has a section for each area ([compute],
  [gpu], [network], [apps] and others) and a comment for each setting.
  Command-line options override it, and so do the environment variables below.
  Delete the file to get a fresh copy.

Environment variables:

  GFXSTREAM_VULKAN       auto, on, or off. With --gpu_mode=gfxstream, auto
                         disables Vulkan only when the primary host Vulkan
                         device is llvmpipe; on forces GLES+Vulkan, and off
                         forces GLES-only. The setting is ignored by the
                         Vulkan-only gfxstream_guest_angle mode. On Apple
                         Silicon hosts with 16 KiB pages, gfxstream modes route
                         host-visible guest Vulkan memory through udmabuf-backed
                         dma-bufs (the path the Apple GPU supports).
  IKADPI                 Display density, as --dpi.
  IKA_LOWCPU             auto, on or off: low-CPU mode, as --lowcpu and
                         --no-lowcpu.
  IKA_TV_DPI             Display density in TV mode (default: 1.5 times the
                         automatic density).
  IKA_SCRCPY             Extra whitespace-separated args appended to the console.
                         Equivalent command-line option: --ika_scrcpy=ARGS
                         (example: --keyboard=uhid --no-clipboard-autosync)
  IKA_APP_MENU_POLL_SEC  Seconds between checks for installed or removed
                         apps while the app menu watcher runs (default: 5).
  IKA_INSTALL_TIMEOUT_SEC
                         Seconds 'install' allows for each APK (default: 1800).
  IKA_GSF_ID_TIMEOUT_SEC Seconds 'gsf' waits for Google Play Services to
                         assign the ID (default: 120).
  IKA_STOP_GRACE_SEC     Seconds to allow Cuttlefish and gfxstream to clean up
                         before forcing surviving processes to exit (default: 30).
  IKA_SCRCPY_REBOOT_TIMEOUT_SEC
                         Seconds to wait for a guest reboot before leaving the
                         console closed (default: 120).

  NOTE: All other parameters will be passed directly to Cuttlefish.

EOF
}

shell_join() {
  local joined
  printf -v joined '%q ' "$@"
  printf '%s' "${joined% }"
}

latest_launcher_log_message() {
  local launcher_log="$1"
  local min_mtime="$2"
  local pattern="$3"
  local log_mtime

  [[ -f "${launcher_log}" ]] || return 1

  log_mtime="$(stat -c '%Y' "${launcher_log}" 2>/dev/null || echo 0)"
  [[ "${log_mtime}" -ge "${min_mtime}" ]] || return 1

  grep -F "${pattern}" "${launcher_log}" | tail -n 1 || true
}

maybe_respond_crosvm_command() {
  local launcher_log="$1"
  local min_mtime="$2"
  local line
  local command

  line="$(latest_launcher_log_message "${launcher_log}" "${min_mtime}" "crosvm launch command:")"
  [[ -n "${line}" ]] || return 1

  command="${line#*"crosvm launch command: "}"
  respond "[${SCRIPT_NAME}] crosvm launch command: ${command}"
  return 0
}

emit_launch_command() {
  local launch_command
  local -a env_args=(env)

  append_cvd_env_args env_args

  launch_command="$(
    shell_join \
      "${env_args[@]}" \
      "${CVD_BIN}" \
      "$@"
  )"

  log "launch command: cd $(printf '%q' "${CVD_PRODUCT_OUT}") && ${launch_command}"
}

# resolve_scrcpy_dpi [DPI]: DPI when given, else IKADPI, else auto_scrcpy_dpi.
resolve_scrcpy_dpi() {
  local explicit_dpi="${1:-}"

  if [[ -n "${explicit_dpi}" ]]; then
    printf '%s\n' "${explicit_dpi}"
    return 0
  fi

  if [[ "${IKADPI:-}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "${IKADPI}"
    return 0
  fi

  auto_scrcpy_dpi
}

# resolve_tv_dpi: the console's density in Android's TV mode, IKA_TV_DPI when it
# is a number, else 1.5 times auto_scrcpy_dpi, so that the TV interface is
# larger than the desktop.
resolve_tv_dpi() {
  local dpi

  if [[ "${IKA_TV_DPI:-}" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' "${IKA_TV_DPI}"
    return 0
  fi

  dpi="$(auto_scrcpy_dpi)"
  printf '%s\n' "$(( dpi * 3 / 2 / 8 * 8 ))"
}

# auto_scrcpy_dpi: a density from the host display's width.
auto_scrcpy_dpi() {
  local size
  local width
  local dpi

  size="$(host_display_size || true)"
  if [[ ! "${size}" =~ ^([0-9]+)x[0-9]+$ ]]; then
    log "could not determine host display width; defaulting to 144 DPI"
    printf '%s\n' 144
    return 0
  fi

  # Heuristic: DPI = (native display width / 10)
  width="${BASH_REMATCH[1]}"
  dpi=$(( width / 10 - 24 ))
  dpi=$(( dpi / 8 * 8 ))
  if (( dpi < 96 )); then
    dpi=96
  fi

  printf '%s\n' "${dpi}"
}

split_start_args() {
  local -n args_array="$1"
  local -n scrcpy_dpi_ref="$2"
  shift 2
  local dpi_user_supplied="false"

  scrcpy_dpi_ref=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dpi=*)
        scrcpy_dpi_ref="${1#*=}"
        dpi_user_supplied="true"
        args_array+=("$1")
        shift
        ;;
      --dpi)
        args_array+=("$1")
        shift
        [[ $# -gt 0 ]] || die "--dpi requires a value"
        scrcpy_dpi_ref="$1"
        dpi_user_supplied="true"
        args_array+=("$1")
        shift
        ;;
      *)
        args_array+=("$1")
        shift
        ;;
    esac
  done

  scrcpy_dpi_ref="$(resolve_scrcpy_dpi "${scrcpy_dpi_ref}")"
  SCRCPY_DPI_GIVEN="${dpi_user_supplied}"
  if [[ "${dpi_user_supplied}" != "true" ]]; then
    args_array+=("--dpi=${scrcpy_dpi_ref}")
  fi
}

# Largest enabled, connected DRM connector's preferred (native) mode as WxH,
# read from sysfs. Used when wayland-info finds nothing, e.g. in an X11 session.
drm_display_size() {
  local connector
  local mode
  local width
  local height
  local best_area=0
  local best=""

  for connector in /sys/class/drm/card*-*; do
    [[ "$(cat "${connector}/status" 2>/dev/null)" == "connected" ]] || continue
    [[ "$(cat "${connector}/enabled" 2>/dev/null)" == "enabled" ]] || continue
    mode="$(head -n 1 "${connector}/modes" 2>/dev/null || true)"
    [[ "${mode}" =~ ^([0-9]+)x([0-9]+) ]] || continue
    width="${BASH_REMATCH[1]}"
    height="${BASH_REMATCH[2]}"
    if (( width * height > best_area )); then
      best_area=$(( width * height ))
      best="${width}x${height}"
    fi
  done

  [[ -n "${best}" ]] || return 0
  printf '%s\n' "${best}"
}

# Largest "current" Wayland output mode as WxH, falling back to the DRM
# connectors in sysfs. Probed at most once per run and cached: a single start
# queries it more than once (DPI heuristic + display ceiling) and spawning
# wayland-info is comparatively expensive.
_host_display_size_probed=""
_host_display_size_value=""
host_display_size() {
  if [[ -z "${_host_display_size_probed}" ]]; then
    _host_display_size_probed="yes"
    if command -v wayland-info >/dev/null 2>&1; then
      _host_display_size_value="$(
        wayland-info 2>/dev/null | awk '
          /mode:/ { in_mode = 1; width = 0; height = 0; next }
          in_mode && /width:/ {
            w = $0; sub(/.*width:[[:space:]]*/, "", w);  width  = int(w)
            h = $0; sub(/.*height:[[:space:]]*/, "", h); height = int(h)
          }
          in_mode && /flags:/ {
            if (/current/ && width && height) {
              area = width * height
              if (area > best_area) {
                best_area = area; best_width = width; best_height = height
              }
            }
            in_mode = 0
          }
          END { if (best_width && best_height) printf "%sx%s\n", best_width, best_height }
        ' || true
      )"
    fi
    if [[ -z "${_host_display_size_value}" ]]; then
      _host_display_size_value="$(drm_display_size)"
    fi
  fi

  [[ -n "${_host_display_size_value}" ]] || return 1
  printf '%s\n' "${_host_display_size_value}"
}

_host_display_logical_size_probed=""
_host_display_logical_size_value=""
host_display_logical_size() {
  if [[ -z "${_host_display_logical_size_probed}" ]]; then
    _host_display_logical_size_probed="yes"
    if command -v wayland-info >/dev/null 2>&1; then
      _host_display_logical_size_value="$(
        wayland-info 2>/dev/null | awk '
          /logical_width:/ {
            line = $0
            sub(/.*logical_width:[[:space:]]*/, "", line)
            split(line, width_parts, ",")
            width = int(width_parts[1])

            line = $0
            sub(/.*logical_height:[[:space:]]*/, "", line)
            height = int(line)

            if (width && height) {
              area = width * height
              if (area > best_area) {
                best_area = area; best_width = width; best_height = height
              }
            }
          }
          END { if (best_width && best_height) printf "%sx%s\n", best_width, best_height }
        ' || true
      )"
    fi
    # X11 has no output scaling, so the native size is the logical size.
    if [[ -z "${_host_display_logical_size_value}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
      _host_display_logical_size_value="$(host_display_size || true)"
    fi
  fi

  [[ -n "${_host_display_logical_size_value}" ]] || return 1
  printf '%s\n' "${_host_display_logical_size_value}"
}

default_scrcpy_window_size() {
  local size
  local width
  local height
  local host_width
  local host_height

  size="$(host_display_logical_size || true)"
  if [[ "${size}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    host_width="${BASH_REMATCH[1]}"
    host_height="${BASH_REMATCH[2]}"
    width=$(( host_width * 85 / 100 ))
    height=$(( host_height * 85 / 100 ))
  else
    width=1280
    height=720
  fi

  printf '%sx%s\n' "${width}" "${height}"
}

has_display_size_override() {
  local flag

  for flag in display display0 display1 display2 display3 \
              displays_textproto displays_binproto x_res y_res; do
    if user_supplied_flag "${flag}" "$@"; then
      return 0
    fi
  done

  return 1
}

# Decides whether this start runs low-CPU mode, from IKA_LOWCPU (auto, on
# or off) and, for auto, the host: no hardware Vulkan driver, guest_swiftshader,
# 2 vCPUs or fewer, or less than 8 GB of host memory. Sets
# LOWCPU_MODE_ACTIVE and LOWCPU_MODE_REASON.
resolve_lowcpu_mode() {
  local mode
  local gpu_mode
  local cpus
  local mem_mb
  local summary
  local reason=""

  mode="$(normalize_lowcpu_mode "${IKA_LOWCPU:-auto}")"
  case "${mode}" in
    on)
      reason="requested"
      ;;
    auto)
      gpu_mode="$(start_gpu_mode_value "$@")"
      cpus="$(start_arg_value "cpus" "${CVD_COMPUTE_DEFAULTS[cpus]}" "$@")"
      mem_mb="$(host_physical_memory_mb || true)"
      summary="$(vulkaninfo_summary || true)"
      if [[ "${gpu_mode}" == "guest_swiftshader" ]]; then
        reason="software rendering"
      elif [[ -n "${summary}" ]] && vulkan_summary_has_only_software_devices "${summary}"; then
        reason="no hardware Vulkan driver"
      elif [[ "${cpus}" =~ ^[0-9]+$ ]] && (( cpus <= 2 )); then
        reason="$(count_noun "${cpus}" vCPU vCPUs)"
      elif [[ "${mem_mb}" =~ ^[0-9]+$ ]] && (( mem_mb > 0 && mem_mb < 8192 )); then
        reason="${mem_mb} MB of host memory"
      fi
      ;;
  esac

  LOWCPU_MODE_REASON="${reason}"
  if [[ -n "${reason}" ]]; then
    LOWCPU_MODE_ACTIVE="true"
    log "low-CPU mode: on (${reason})"
  else
    LOWCPU_MODE_ACTIVE="false"
  fi
}

append_default_display_arg() {
  local -n args_array="$1"
  local dpi="$2"
  shift 2
  local size
  local width
  local height
  local refresh_rate_hz=60

  if has_display_size_override "$@"; then
    return 0
  fi

  size="$(host_display_size || true)"
  if [[ ! "${size}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    log "could not determine host display size; leaving Cuttlefish display defaults unchanged"
    return 0
  fi

  width="${BASH_REMATCH[1]}"
  height="${BASH_REMATCH[2]}"

  if [[ "${LOWCPU_MODE_ACTIVE}" == "true" ]]; then
    refresh_rate_hz="${IKA_LOWCPU_REFRESH_RATE_HZ}"
  fi

  args_array+=("--display=width=${width},height=${height},dpi=${dpi},refresh_rate_hz=${refresh_rate_hz}")
  log "display ceiling: ${width}x${height}/${dpi} at ${refresh_rate_hz} Hz"
}

host_is_apple_silicon() {
  host_is_arm64 || return 1

  [[ -r /proc/device-tree/compatible ]] || return 1
  tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | grep -q '^apple,'
}

is_apple_silicon_16k_host() {
  local page_size

  host_is_apple_silicon || return 1

  page_size="$(getconf PAGESIZE 2>/dev/null || echo 0)"
  [[ "${page_size}" =~ ^[0-9]+$ ]] || return 1
  (( page_size > 4096 ))
}

host_is_arm64() {
  local arch
  arch="$(uname -m 2>/dev/null || true)"
  [[ "${arch}" == "aarch64" || "${arch}" == "arm64" ]]
}

host_page_size() {
  local page_size
  page_size="$(getconf PAGESIZE 2>/dev/null || true)"
  if [[ ! "${page_size}" =~ ^[0-9]+$ ]]; then
    page_size=0
  fi
  printf '%s\n' "${page_size}"
}

normalize_kernel_page_size_mode() {
  local mode="${1:-auto}"
  mode="${mode,,}"

  case "${mode}" in
    ""|auto)
      printf '%s\n' "auto"
      ;;
    4|4k|4096)
      printf '%s\n' "4k"
      ;;
    16|16k|16384)
      printf '%s\n' "16k"
      ;;
    *)
      die "invalid IKA_KERNEL_PAGE_SIZE='${1}' (expected auto, 4k, or 16k)"
      ;;
  esac
}

arm64_kernel_page_size() {
  local mode
  local page_size

  host_is_arm64 || return 1

  mode="$(normalize_kernel_page_size_mode "${IKA_KERNEL_PAGE_SIZE:-auto}")"
  case "${mode}" in
    4k|16k)
      printf '%s\n' "${mode}"
      ;;
    auto)
      page_size="$(host_page_size)"
      if (( page_size > 4096 )); then
        printf '%s\n' "16k"
      else
        printf '%s\n' "4k"
      fi
      ;;
  esac
}

cvd_product_out_has_arm64_16k_artifacts() {
  [[ -s "${CVD_PRODUCT_OUT}/boot_16k.img" || -s "${CVD_PRODUCT_OUT}/kernel_16k" ]]
}

append_arm64_kernel_page_args() {
  local -n args_array="$1"
  shift
  local selected_page_size
  local page_size
  local boot_16k

  host_is_arm64 || return 0
  cvd_product_out_has_arm64_16k_artifacts || return 0

  if user_supplied_flag "use_16k" "$@" \
      || user_supplied_flag "boot_image" "$@" \
      || user_supplied_flag "kernel_path" "$@" \
      || user_supplied_flag "initramfs_path" "$@" \
      || user_supplied_flag "vendor_boot_image" "$@"; then
    log "arm64 kernel page-size auto-selection skipped because boot/kernel args were supplied"
    return 0
  fi

  selected_page_size="$(arm64_kernel_page_size)"
  page_size="$(host_page_size)"

  case "${selected_page_size}" in
    16k)
      boot_16k="${CVD_PRODUCT_OUT}/boot_16k.img"
      [[ -s "${boot_16k}" ]] || \
        die "ARM64 host page size is ${page_size} bytes, but ${boot_16k} is missing"

      args_array+=("--boot_image=${boot_16k}")
      log "arm64 kernel page-size: ${page_size} byte host pages -> boot_16k.img"
      ;;
    4k)
      log "arm64 kernel page-size: ${page_size} byte host pages -> boot.img"
      ;;
  esac
}

VULKANINFO_SUMMARY=""
# Empty until load_vulkaninfo_summary has run; then "ok" or "none".
VULKANINFO_SUMMARY_STATE=""

probe_vulkaninfo_summary() {
  command -v vulkaninfo >/dev/null 2>&1 || return 1

  # GPU classification does not need a presentation surface. Keep the probe
  # independent of X11/Wayland authentication, especially for SSH launches
  # that inherit DISPLAY without a usable authorization cookie.
  env -u DISPLAY -u WAYLAND_DISPLAY vulkaninfo --summary 2>/dev/null
}

# Runs vulkaninfo once and keeps its summary for the GPU checks that follow,
# which each took a tenth of a second to run it again. Call it outside a
# command substitution, which would keep the result in a subshell.
load_vulkaninfo_summary() {
  [[ -z "${VULKANINFO_SUMMARY_STATE}" ]] || return 0
  if VULKANINFO_SUMMARY="$(probe_vulkaninfo_summary)"; then
    VULKANINFO_SUMMARY_STATE="ok"
  else
    VULKANINFO_SUMMARY=""
    VULKANINFO_SUMMARY_STATE="none"
  fi
}

vulkaninfo_summary() {
  load_vulkaninfo_summary
  [[ "${VULKANINFO_SUMMARY_STATE}" == "ok" ]] || return 1
  printf '%s\n' "${VULKANINFO_SUMMARY}"
}

vulkan_summary_has_only_software_devices() {
  local summary="$1"

  awk '
    function finish_device() {
      if (!in_device) {
        return
      }
      device_count++
      if (software_device) {
        software_count++
      }
    }
    /^GPU[0-9]+:/ {
      finish_device()
      in_device = 1
      software_device = 0
      next
    }
    in_device {
      line = tolower($0)
      if (line ~ /(llvmpipe|lavapipe|swiftshader|software rasterizer|software device)/) {
        software_device = 1
      }
    }
    END {
      finish_device()
      exit !(device_count > 0 && device_count == software_count)
    }
  ' <<<"${summary}"
}

default_gpu_mode_for_start() {
  local summary

  if user_supplied_flag "gpu_mode" "$@"; then
    start_arg_value "gpu_mode" "${CVD_GPU_DEFAULTS[gpu_mode]}" "$@"
    return 0
  fi

  summary="$(vulkaninfo_summary || true)"
  if [[ -n "${summary}" ]] && vulkan_summary_has_only_software_devices "${summary}"; then
    log "only software Vulkan devices detected; defaulting gpu_mode=gfxstream"
    printf '%s\n' "gfxstream"
    return 0
  fi

  printf '%s\n' "${CVD_GPU_DEFAULTS[gpu_mode]}"
}

primary_vulkan_device_is_llvmpipe() {
  local summary
  local primary_device

  summary="$(vulkaninfo_summary || true)"
  [[ -n "${summary}" ]] || return 1

  primary_device="$(
    awk '
      /^GPU[0-9]+:/ {
        if (seen) {
          exit
        }
        seen = 1
        next
      }
      seen {
        print
      }
    ' <<<"${summary}"
  )"
  [[ -n "${primary_device}" ]] || return 1

  grep -Eiq '(^[[:space:]]*(deviceName|driverName|driverID)[[:space:]]*=.*llvmpipe|DRIVER_ID_MESA_LLVMPIPE)' <<<"${primary_device}"
}

primary_vulkan_device_is_radv() {
  local summary
  local primary_device

  summary="$(vulkaninfo_summary || true)"
  [[ -n "${summary}" ]] || return 1

  primary_device="$(
    awk '
      /^GPU[0-9]+:/ {
        if (seen) {
          exit
        }
        seen = 1
        next
      }
      seen {
        print
      }
    ' <<<"${summary}"
  )"
  [[ -n "${primary_device}" ]] || return 1

  grep -Eiq '(^[[:space:]]*(deviceName|driverName|driverID)[[:space:]]*=.*radv|DRIVER_ID_MESA_RADV)' <<<"${primary_device}"
}

vulkan_device_summary_is_radv_vega_or_older() {
  local device_summary="$1"

  grep -Eiq '(^[[:space:]]*(deviceName|driverName|driverID)[[:space:]]*=.*radv|DRIVER_ID_MESA_RADV)' \
    <<<"${device_summary}" || return 1
  grep -Eiq "RADV[[:space:]_-]*${RADV_VEGA_OR_OLDER_FAMILY_REGEX}([^[:alnum:]_]|$)" \
    <<<"${device_summary}"
}

primary_vulkan_device_is_radv_vega_or_older() {
  local summary
  local primary_device

  summary="$(vulkaninfo_summary || true)"
  [[ -n "${summary}" ]] || return 1

  primary_device="$(
    awk '
      /^GPU[0-9]+:/ {
        if (seen) {
          exit
        }
        seen = 1
        next
      }
      seen {
        print
      }
    ' <<<"${summary}"
  )"
  [[ -n "${primary_device}" ]] || return 1

  vulkan_device_summary_is_radv_vega_or_older "${primary_device}"
}

append_comma_option() {
  local existing="$1"
  local required="$2"
  local option
  local -a options=()

  IFS=',' read -r -a options <<<"${existing}"
  for option in "${options[@]}"; do
    if [[ "${option}" == "${required}" ]]; then
      printf '%s\n' "${existing}"
      return 0
    fi
  done

  printf '%s\n' "${existing}${existing:+,}${required}"
}

start_arg_value() {
  local flag="$1"
  local default_value="${2:-}"
  shift 2
  local value=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --${flag}=*|-${flag}=*)
        value="${1#*=}"
        ;;
      --${flag}|-${flag})
        shift
        [[ $# -gt 0 ]] || die "--${flag} requires a value"
        value="$1"
        ;;
    esac
    shift || true
  done

  printf '%s\n' "${value:-${default_value}}"
}

start_gpu_mode_value() {
  start_arg_value "gpu_mode" "${CVD_GPU_DEFAULTS[gpu_mode]}" "$@"
}

merge_gfxstream_renderer_features() {
  local existing="$1"
  local required="$2"
  local result=""
  local feature
  local name
  local -a existing_features=()

  IFS=';' read -r -a existing_features <<<"${existing}"
  for feature in "${existing_features[@]}"; do
    [[ -n "${feature}" ]] || continue
    name="${feature%%:*}"
    case "${name}" in
      ExternalBlob|SystemBlob|VulkanAllocateHostVisibleAsUdmabuf|VulkanUseDedicatedAhbMemoryType)
        continue
        ;;
    esac
    result+="${result:+;}${feature}"
  done

  result+="${result:+;}${required}"
  printf '%s\n' "${result}"
}

append_or_merge_gpu_renderer_features() {
  local -n renderer_args_array="$1"
  local required="$2"
  local i
  local existing

  for i in "${!renderer_args_array[@]}"; do
    case "${renderer_args_array[${i}]}" in
      --gpu_renderer_features=*|-gpu_renderer_features=*)
        existing="${renderer_args_array[${i}]#*=}"
        renderer_args_array[${i}]="--gpu_renderer_features=$(merge_gfxstream_renderer_features "${existing}" "${required}")"
        return 0
        ;;
      --gpu_renderer_features|-gpu_renderer_features)
        (( i + 1 < ${#renderer_args_array[@]} )) || die "--gpu_renderer_features requires a value"
        existing="${renderer_args_array[$((i + 1))]}"
        renderer_args_array[$((i + 1))]="$(merge_gfxstream_renderer_features "${existing}" "${required}")"
        return 0
        ;;
    esac
  done

  renderer_args_array+=("--gpu_renderer_features=${required}")
}

gfxstream_context_types_include_vulkan() {
  local context_types="$1"
  local contexts="${context_types%%,*}"

  [[ ":${contexts}:" == *":gfxstream-vulkan:"* ]]
}

gfxstream_guest_angle_uses_host_vulkan() {
  local gpu_mode="$1"

  [[ "${gpu_mode}" == "gfxstream_guest_angle" ]]
}

merge_gpu_context_types_for_vulkan() {
  local -n context_args_array="$1"
  local default_context_types="$2"
  local i
  local existing

  for i in "${!context_args_array[@]}"; do
    case "${context_args_array[${i}]}" in
      --gpu_context_types=*|-gpu_context_types=*)
        existing="${context_args_array[${i}]#*=}"
        printf '%s\n' "${existing}"
        return 0
        ;;
      --gpu_context_types|-gpu_context_types)
        (( i + 1 < ${#context_args_array[@]} )) || die "--gpu_context_types requires a value"
        existing="${context_args_array[$((i + 1))]}"
        printf '%s\n' "${existing}"
        return 0
        ;;
    esac
  done

  context_args_array+=("--gpu_context_types=${default_context_types}")
  printf '%s\n' "${default_context_types}"
}

set_or_append_start_arg() {
  local -n set_args_array="$1"
  local flag="$2"
  local value="$3"
  local i

  for i in "${!set_args_array[@]}"; do
    case "${set_args_array[${i}]}" in
      --${flag}=*|-${flag}=*)
        set_args_array[${i}]="--${flag}=${value}"
        return 0
        ;;
      --${flag}|-${flag})
        if (( i + 1 < ${#set_args_array[@]} )); then
          set_args_array[$((i + 1))]="${value}"
        else
          set_args_array+=("${value}")
        fi
        return 0
        ;;
    esac
  done

  set_args_array+=("--${flag}=${value}")
}

append_apple_16k_gfxstream_vulkan_args() {
  local -n apple_args_array="$1"

  append_or_merge_gpu_renderer_features \
    apple_args_array "${GFXSTREAM_APPLE_16K_VULKAN_RENDERER_FEATURES}"
  set_or_append_start_arg apple_args_array "enable_gpu_udmabuf" "true"
  log "Apple Silicon 16K host: using udmabuf-backed ExternalBlob with Vulkano gralloc; disabling SystemBlob"
}

append_radv_gfxstream_vulkan_args() {
  local -n radv_args_array="$1"

  primary_vulkan_device_is_radv_vega_or_older || return 1
  append_or_merge_gpu_renderer_features \
    radv_args_array "${GFXSTREAM_RADV_VULKAN_RENDERER_FEATURES}"
  log "RADV Vega-or-older gfxstream: using device-only Vulkan memory to avoid AMD host-visible memory corruption"
}

append_gfxstream_vulkan_args() {
  local -n args_array="$1"
  shift
  local mode
  local selected_mode
  local gpu_mode
  local vulkan_decision
  local user_context_types
  local effective_context_types

  mode="$(normalize_gfxstream_vulkan_mode "${GFXSTREAM_VULKAN_MODE}")"
  GFXSTREAM_VULKAN_MODE="${mode}"

  gpu_mode="$(start_gpu_mode_value "$@")"
  CVD_GPU_MODE="${gpu_mode}"
  if gfxstream_guest_angle_uses_host_vulkan "${gpu_mode}"; then
    CVD_GRAPHICS_DRIVER_MESSAGE="${gpu_mode} (ANGLE over gfxstream Vulkan)"
    log "gfxstream-vulkan=${mode} context toggle has no effect with gpu_mode=${gpu_mode} (Vulkan-only)"
    if append_radv_gfxstream_vulkan_args args_array; then
      CVD_GRAPHICS_DRIVER_MESSAGE="${gpu_mode} (ANGLE over gfxstream Vulkan; RADV device memory)"
    fi
    if is_apple_silicon_16k_host; then
      append_apple_16k_gfxstream_vulkan_args args_array
      CVD_GRAPHICS_DRIVER_MESSAGE="${gpu_mode} (ANGLE over gfxstream Vulkan; Apple 16K udmabuf)"
    fi
    return 0
  fi

  if [[ "${gpu_mode}" != "gfxstream" ]]; then
    CVD_GRAPHICS_DRIVER_MESSAGE="GPU: ${gpu_mode} (gfxstream-vulkan=${mode} ignored)"
    log "gfxstream-vulkan=${mode} has no effect with gpu_mode=${gpu_mode}"
    return 0
  fi

  if user_supplied_flag "gpu_context_types" "$@"; then
    user_context_types="$(merge_gpu_context_types_for_vulkan args_array \
      "${GFXSTREAM_VULKAN_CONTEXT_TYPES}")"
    effective_context_types="$(start_arg_value "gpu_context_types" "${user_context_types}" "${args_array[@]}")"
    CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (user gpu_context_types; gfxstream-vulkan=${mode})"
    log "using user supplied gpu_context_types=${effective_context_types}; gfxstream-vulkan=${mode}"
    if gfxstream_context_types_include_vulkan "${effective_context_types}" \
        && is_apple_silicon_16k_host; then
      append_apple_16k_gfxstream_vulkan_args args_array
    fi
    if gfxstream_context_types_include_vulkan "${effective_context_types}"; then
      append_radv_gfxstream_vulkan_args args_array || true
    fi
    return 0
  fi

  selected_mode="${mode}"
  vulkan_decision="gfxstream-vulkan=${mode}"
  if [[ "${selected_mode}" == "auto" ]]; then
    if primary_vulkan_device_is_llvmpipe; then
      selected_mode="off"
      vulkan_decision="gfxstream-vulkan=auto -> off (primary Vulkan device is llvmpipe)"
    elif is_apple_silicon_16k_host; then
      append_apple_16k_gfxstream_vulkan_args args_array
      CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (OpenGL ES + Vulkan, Apple Silicon)"
      log "gfxstream-vulkan=auto; leaving Cuttlefish gfxstream defaults with Apple 16K udmabuf"
      return 0
    else
      append_radv_gfxstream_vulkan_args args_array || true
      CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (Default settings, vulkan=auto)"
      log "gfxstream-vulkan=auto; leaving Cuttlefish gfxstream defaults"
      return 0
    fi
  fi

  case "${selected_mode}" in
    off)
      args_array+=("--gpu_context_types=${GFXSTREAM_GLES_CONTEXT_TYPES}")
      CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (OpenGL ES)"
      log "${vulkan_decision}; context-types=${GFXSTREAM_GLES_CONTEXT_TYPES}"
      ;;
    on)
      args_array+=("--gpu_context_types=${GFXSTREAM_VULKAN_CONTEXT_TYPES}")
      CVD_GRAPHICS_DRIVER_MESSAGE="gfxstream (OpenGL ES + Vulkan; ${vulkan_decision})"
      log "${vulkan_decision}; context-types=${GFXSTREAM_VULKAN_CONTEXT_TYPES}"
      if is_apple_silicon_16k_host; then
        append_apple_16k_gfxstream_vulkan_args args_array
      fi
      append_radv_gfxstream_vulkan_args args_array || true
      ;;
  esac
}

require_executable() {
  local path="$1"
  local label="$2"
  [[ -x "${path}" ]] || die "${label} not found or not executable: ${path}"
}

instance_has_userdata_state() {
  [[ -e "${CVD_INSTANCE_DIR}/overlay.img" || -e "${CVD_INSTANCE_DIR}/userdata.img" ]]
}

composite_disk_rebuild_reason() {
  local name="$1"
  local disk="${CVD_INSTANCE_DIR}/${name}.img"
  local config="${CVD_INSTANCE_DIR}/${name}_disk_config.txt"
  local component

  if [[ ! -e "${disk}" ]]; then
    printf '%s\n' "${name}.img is missing"
    return 0
  fi

  if [[ ! -e "${config}" ]]; then
    printf '%s\n' "${name}_disk_config.txt is missing"
    return 0
  fi

  while IFS= read -r component; do
    [[ -n "${component}" ]] || continue
    [[ "${component}" != "crosvm" ]] || continue
    [[ -e "${component}" ]] || continue

    if [[ "${component}" -nt "${disk}" ]]; then
      printf '%s\n' "${component} is newer than ${name}.img"
      return 0
    fi
  done < "${config}"

  return 1
}

is_generated_os_component() {
  [[ "$1" == "${CVD_INSTANCE_DIR}/metadata" || "$1" == "${CVD_INSTANCE_DIR}/misc" ]]
}

refresh_generated_os_component_mtimes() {
  local disk="${CVD_INSTANCE_DIR}/os_composite.img"
  local config="${CVD_INSTANCE_DIR}/os_composite_disk_config.txt"
  local overlay="${CVD_INSTANCE_DIR}/overlay.img"
  local component
  local path
  local needs_refresh="false"

  [[ -e "${overlay}" && -e "${disk}" && -e "${config}" ]] || return 0

  while IFS= read -r component; do
    [[ -n "${component}" ]] || continue
    [[ "${component}" != "crosvm" ]] || continue
    [[ -e "${component}" ]] || continue
    [[ "${component}" -nt "${disk}" ]] || continue

    if ! is_generated_os_component "${component}"; then
      return 0
    fi

    needs_refresh="true"
  done < "${config}"

  [[ "${needs_refresh}" == "true" ]] || return 0

  for path in \
    "${disk}" \
    "${CVD_INSTANCE_DIR}/os_composite_gpt_header.img" \
    "${CVD_INSTANCE_DIR}/os_composite_gpt_footer.img"; do
    [[ -e "${path}" ]] && touch "${path}" 2>/dev/null || true
  done
  touch "${overlay}" 2>/dev/null || true
}

protect_overlay_resume() {
  local reason

  [[ -e "${CVD_INSTANCE_DIR}/overlay.img" ]] || return 0

  refresh_generated_os_component_mtimes

  if reason="$(composite_disk_rebuild_reason os_composite)"; then
    respond_console "Refusing to start because Cuttlefish would rebuild the OS disk and discard VM data."
    respond_console "Reason: ${reason}"
    respond_console "Run '${SCRIPT_NAME} reset' if you want to discard the current VM data."
    die "refusing to discard overlay.img: ${reason}"
  fi

  if [[ -e "${CVD_INSTANCE_DIR}/ap_composite.img" ]] \
      && reason="$(composite_disk_rebuild_reason ap_composite)"; then
    respond_console "Refusing to start because Cuttlefish would rebuild the AP disk and discard VM data."
    respond_console "Reason: ${reason}"
    respond_console "Run '${SCRIPT_NAME} reset' if you want to discard the current VM data."
    die "refusing to discard overlay.img: ${reason}"
  fi
}

append_data_storage_args() {
  local -n args_array="$1"
  shift
  local configured_data_gb=""
  local data_gb
  local data_mb
  local has_existing_userdata_state="false"
  local explicit_data_policy="false"
  local explicit_data_size="false"

  if user_supplied_flag "data_policy" "$@"; then
    explicit_data_policy="true"
  fi
  if user_supplied_flag "blank_data_image_mb" "$@"; then
    explicit_data_size="true"
  fi

  if instance_has_userdata_state; then
    has_existing_userdata_state="true"
  fi

  if [[ "${explicit_data_policy}" != "true" && "${has_existing_userdata_state}" == "true" ]]; then
    return 0
  fi

  if [[ -s "${DATA_GB_CONFIG_FILE}" ]]; then
    IFS= read -r configured_data_gb < "${DATA_GB_CONFIG_FILE}"
    configured_data_gb="$(normalize_data_gb "${configured_data_gb}")"
  fi

  data_gb="${configured_data_gb:-${DEFAULT_DATA_GB}}"
  data_mb="$(data_gb_to_mib "${data_gb}")"

  if [[ "${explicit_data_policy}" != "true" ]]; then
    args_array+=("--data_policy=always_create")
  fi

  if [[ "${explicit_data_size}" != "true" ]]; then
    args_array+=("--blank_data_image_mb=${data_mb}")
  fi

  if [[ -n "${configured_data_gb}" ]]; then
    CVD_DATA_STORAGE_MESSAGE="Provisioning ${data_gb} GB userdata..."
    log "fresh userdata target: ${data_mb} MiB"
  fi
}

apply_default_args() {
  local -n config_map="$1"
  local -n args_array="$2"
  shift 2
  local key value

  for key in "${!config_map[@]}"; do
    if ! user_supplied_flag "${key}" "$@"; then
      value="${config_map[${key}]}"
      # Handle special case for report_anonymous_usage_stats which uses single dash
      if [[ "${key}" == "report_anonymous_usage_stats" ]]; then
        args_array+=("-${key}=${value}")
      else
        args_array+=("--${key}=${value}")
      fi
    fi
  done
}

# Gives the device its own serial number, generated on first start and kept
# across updates and factory resets, instead of Cuttlefish's CUTTLEFISHCVD01,
# which is the same on every install. Letters and digits only: GMS check-in
# rejects other serials.
append_serial_number_args() {
  local -n args_array="$1"
  shift
  local serial=""

  if user_supplied_flag "serial_number" "$@" \
      || user_supplied_flag "use_random_serial" "$@"; then
    return 0
  fi

  if [[ -s "${SERIAL_NUMBER_FILE}" ]]; then
    IFS= read -r serial < "${SERIAL_NUMBER_FILE}" || true
  fi
  if [[ ! "${serial}" =~ ^[A-Z0-9]+$ ]]; then
    serial="$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n' | tr 'a-f' 'A-F')"
    printf '%s\n' "${serial}" > "${SERIAL_NUMBER_FILE}"
    log "generated device serial number ${serial}"
  fi
  args_array+=("--serial_number=${serial}")
}

apply_start_default_args() {
  local args_array_name="$1"
  shift
  local config_map

  for config_map in "${CVD_DEFAULT_ARG_MAPS[@]}"; do
    apply_default_args "${config_map}" "${args_array_name}" "$@"
  done
}

append_cuttlefish_audio_args() {
  local -n args_array="$1"
  shift

  if ! user_supplied_flag "enable_audio" "$@"; then
    args_array+=("--enable_audio=true")
    log "enabling Cuttlefish virtio-snd audio server"
  fi
}

host_timezone() {
  command -v timedatectl >/dev/null 2>&1 || return 0
  timedatectl show --property=Timezone --value 2>/dev/null || true
}

# Prints "dark" or "light" for the desktop's color scheme, or nothing when it
# states no preference. Reads the freedesktop Settings portal, which ika-scrcpy
# window title bars follow too, then GNOME's setting.
host_color_scheme() {
  local value=""

  if command -v gdbus >/dev/null 2>&1; then
    value="$(timeout 3 gdbus call --session \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop \
        --method org.freedesktop.portal.Settings.Read \
        org.freedesktop.appearance color-scheme 2>/dev/null \
      | grep -oE 'uint32 [0-9]+' | awk '{ print $2 }' || true)"
  fi
  if [[ -z "${value}" ]] && command -v gsettings >/dev/null 2>&1; then
    case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
      "'prefer-dark'") value=1 ;;
      "'prefer-light'") value=2 ;;
    esac
  fi

  case "${value}" in
    1) printf 'dark\n' ;;
    2) printf 'light\n' ;;
  esac
}

append_bootconfig_args() {
  local -n args_array="$1"
  local tz
  local bootconfig_value=""

  tz="$(host_timezone)"
  if [[ -n "${tz}" ]]; then
    bootconfig_value="androidboot.timezone=\"${tz}\" androidboot.cuttlefish_service_bluetooth_checker=false"
    log "timezone: ${tz}"
  fi

  if is_user_build; then
    [[ -n "${USER_ADB_PUBLIC_KEY_VALUE:-}" ]] || {
      log "public ADB key was not prepared for ${USER_ADB_PRIVATE_KEY}"
      return 1
    }
    bootconfig_value+="${bootconfig_value:+ }androidboot.ika.adb_pubkey=${USER_ADB_PUBLIC_KEY_VALUE}"
  fi

  [[ -n "${bootconfig_value}" ]] || return 0
  args_array+=("--extra_bootconfig_args=${bootconfig_value}")
}

append_cvd_env_args() {
  local -n env_args_ref="$1"
  local config_path="${2:-}"
  local glibc_tunables
  local radv_debug
  local adb_vendor_keys

  env_args_ref+=(
    "HOME=${CVD_HOME_DIR}"
    "TMPDIR=${CVD_TMP_DIR}"
    "ANDROID_HOST_OUT=${CVD_HOST_OUT}"
    "ANDROID_SOONG_HOST_OUT=${CVD_HOST_OUT}"
    "ANDROID_PRODUCT_OUT=${CVD_PRODUCT_OUT}"
  )

  if is_user_build; then
    adb_vendor_keys="${USER_ADB_PRIVATE_KEY}"
    [[ -n "${ADB_VENDOR_KEYS:-}" ]] && adb_vendor_keys+=":${ADB_VENDOR_KEYS}"
    env_args_ref+=("ADB_VENDOR_KEYS=${adb_vendor_keys}")
  fi

  # gfxstream creates its host EGL display without a window-system surface.
  # Selecting this explicitly also avoids inheriting a broken/unavailable X11
  # platform from SSH sessions on headless and Apple Silicon hosts.
  if [[ "${CVD_GPU_MODE}" == gfxstream* ]]; then
    env_args_ref+=("EGL_PLATFORM=${EGL_PLATFORM:-surfaceless}")
  fi

  # RADV's default asynchronous shader compilation can report fence completion
  # before a transform-feedback pipeline has finished compiling. Gfxstream can
  # then execute an incomplete pipeline, producing intermittent missing
  # primitives even though the associated query result is correct. Compile
  # shaders synchronously for gfxstream on RADV, while preserving any options
  # supplied by the caller. Other Vulkan drivers are left unchanged.
  if [[ "${CVD_GPU_MODE}" == gfxstream* ]] && primary_vulkan_device_is_radv; then
    radv_debug="$(append_comma_option "${RADV_DEBUG:-}" "syncshaders")"
    env_args_ref+=("RADV_DEBUG=${radv_debug}")
    log "RADV gfxstream correctness options: ${radv_debug}"
  fi

  # gfxstream creates many short-lived render threads. On glibc's default
  # arena policy, allocations freed during guest graphics-process cleanup can
  # remain resident in dozens of per-thread arenas. This is especially costly
  # on the Apple 16K udmabuf path, where Asphalt otherwise leaves hundreds of
  # MiB of free allocator pages resident after each launch. Cap the arena count
  # and retain any caller-provided tunables.
  if [[ "${CVD_GPU_MODE}" == gfxstream* ]] && is_apple_silicon_16k_host; then
    glibc_tunables="${GLIBC_TUNABLES:-}"
    if [[ ":${glibc_tunables}:" != *":glibc.malloc.arena_max="* ]]; then
      glibc_tunables="${glibc_tunables:+${glibc_tunables}:}glibc.malloc.arena_max=4"
    fi
    if [[ ":${glibc_tunables}:" != *":glibc.malloc.trim_threshold="* ]]; then
      glibc_tunables="${glibc_tunables:+${glibc_tunables}:}glibc.malloc.trim_threshold=131072"
    fi
    env_args_ref+=("GLIBC_TUNABLES=${glibc_tunables}")
    log "Apple Silicon gfxstream allocator tunables: ${glibc_tunables}"
  fi

  if [[ -n "${config_path}" ]]; then
    env_args_ref+=("CUTTLEFISH_CONFIG_FILE=${config_path}")
  fi
}

run_with_cvd_env() {
  local config_path=""
  local -a env_args=(env)

  if [[ "${1:-}" == "--config" ]]; then
    config_path="${2:-}"
    shift 2
  fi

  append_cvd_env_args env_args "${config_path}"
  "${env_args[@]}" "$@"
}

run_stop_helper() {
  local status

  set +e
  run_with_cvd_env "$@" >/dev/null 2>&1
  status="$?"
  set -e

  return "${status}"
}

has_session_group() {
  id -nG | tr ' ' '\n' | grep -Fxq "$1"
}

has_configured_group() {
  id -nG "${USER}" | tr ' ' '\n' | grep -Fxq "$1"
}

check_required_groups() {
  local -a required_groups=(kvm video render cvdnetwork)
  local -a missing_groups=()
  local -a inactive_groups=()
  local -a add_groups=()
  local group

  for group in "${required_groups[@]}"; do
    if getent group "${group}" >/dev/null 2>&1 && ! has_session_group "${group}"; then
      missing_groups+=("${group}")
      if has_configured_group "${group}"; then
        inactive_groups+=("${group}")
      else
        add_groups+=("${group}")
      fi
    fi
  done

  if [[ "${#missing_groups[@]}" -eq 0 ]]; then
    return 0
  fi

  cat <<EOF
[${SCRIPT_NAME}] error: current shell is missing required groups.

Active groups:
  $(id -nG)

Missing groups:
  ${missing_groups[*]}

EOF

  if [[ "${#add_groups[@]}" -gt 0 ]]; then
    cat <<EOF
To add the missing account membership:
  pkexec /usr/libexec/cuttlefish/cuttlefish-add-user-to-groups

EOF
  fi

  if [[ "${#inactive_groups[@]}" -gt 0 ]]; then
    cat <<EOF
Configured on the account but not active in this login session:
  ${inactive_groups[*]}

EOF
  fi

  cat <<EOF

Log out fully and back in after updating group membership.
EOF
  exit 1
}

resolve_adb_serial() {
  local adb_ip_and_port=""
  local vsock_cid=""

  if [[ -f "${CVD_CONFIG_PATH}" ]]; then
    if grep -q '"native_vsock"' "${CVD_CONFIG_PATH}"; then
      vsock_cid="$(grep -oE '"vsock_guest_cid"[[:space:]]*:[[:space:]]*[0-9]+' "${CVD_CONFIG_PATH}" | head -n1 | grep -oE '[0-9]+$' || true)"
      if [[ -n "${vsock_cid}" ]] && (( vsock_cid > 2 )); then
        printf 'vsock:%s:5555\n' "${vsock_cid}"
        return 0
      fi
    fi
    adb_ip_and_port="$(grep -oE '"adb_ip_and_port"[[:space:]]*:[[:space:]]*"[^"]+"' "${CVD_CONFIG_PATH}" | head -n1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
  fi

  case "${adb_ip_and_port:-127.0.0.1:6520}" in
    0.0.0.0:*)
      printf '127.0.0.1:%s\n' "${adb_ip_and_port#*:}"
      ;;
    '[::]':*)
      printf '127.0.0.1:%s\n' "${adb_ip_and_port##*:}"
      ;;
    *)
      printf '%s\n' "${adb_ip_and_port:-127.0.0.1:6520}"
      ;;
  esac
}

resolve_cuttlefish_frames_socket() {
  local frame_sock_path=""
  local socket_path

  if [[ -f "${CVD_CONFIG_PATH}" ]]; then
    frame_sock_path="$(grep -oE '"frame_sock_path"[[:space:]]*:[[:space:]]*"[^"]+"' "${CVD_CONFIG_PATH}" | head -n1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
  fi

  if [[ -n "${frame_sock_path}" ]]; then
    socket_path="$(dirname "${frame_sock_path}")/ika_frames.sock"
  else
    socket_path="/tmp/cf_avd_${UID}/cvd-1/internal/ika_frames.sock"
  fi

  printf '%s\n' "${socket_path}"
}

has_live_cvd_processes() {
  pgrep -f "${CVD_PROCESS_REGEX}" >/dev/null 2>&1
}

stop_dnsmasq() {
  local pid_file
  for pid_file in /var/tmp/cvd/cuttlefish-dnsmasq-*.pid /var/run/cuttlefish-dnsmasq-*.pid; do
    [[ -f "${pid_file}" ]] || continue
    kill "$(cat "${pid_file}")" 2>/dev/null || true
    rm -f "${pid_file}"
    rm -f "${pid_file%.pid}.leases"
  done
  pkill -f 'dnsmasq.*cvd-' 2>/dev/null || true
}

cleanup_user_processes() {
  local -a pids=()
  local -a survivors=()
  local any_survivor
  local deadline
  local pid

  while read -r pid; do
    [[ -n "${pid}" ]] || continue
    [[ "${pid}" == "$$" ]] && continue
    pids+=("${pid}")
  done < <(pgrep -f "${CVD_PROCESS_REGEX}" || true)

  if [[ "${#pids[@]}" -eq 0 ]]; then
    return 0
  fi

  mapfile -t pids < <(printf '%s\n' "${pids[@]}" | sort -u)
  log "stopping leftover Cuttlefish processes: ${pids[*]}"
  kill "${pids[@]}" 2>/dev/null || true

  # SECONDS has one-second resolution. Add one tick so the configured grace
  # period is never shortened by entering this loop partway through a tick.
  deadline=$((SECONDS + IKA_STOP_GRACE_SEC + 1))
  while (( SECONDS < deadline )); do
    survivors=()
    for pid in "${pids[@]}"; do
      if cvd_pid_is_alive "${pid}"; then
        survivors+=("${pid}")
      fi
    done
    if [[ "${#survivors[@]}" -eq 0 ]]; then
      return 0
    fi
    sleep 0.2
  done

  survivors=()
  for pid in "${pids[@]}"; do
    if cvd_pid_is_alive "${pid}"; then
      survivors+=("${pid}")
    fi
  done
  if [[ "${#survivors[@]}" -gt 0 ]]; then
    log "Cuttlefish processes did not exit within ${IKA_STOP_GRACE_SEC}s; forcing termination: ${survivors[*]}"
    kill -9 "${survivors[@]}" 2>/dev/null || true

    deadline=$((SECONDS + 6))
    while (( SECONDS < deadline )); do
      any_survivor="false"
      for pid in "${survivors[@]}"; do
        if cvd_pid_is_alive "${pid}"; then
          any_survivor="true"
          break
        fi
      done
      [[ "${any_survivor}" == "true" ]] || return 0
      sleep 0.2
    done
  fi
}

cvd_pid_is_alive() {
  local pid="$1"
  local command_line
  local state

  [[ -r "/proc/${pid}/stat" ]] || return 1
  state="$(awk '{ print $3 }' "/proc/${pid}/stat" 2>/dev/null || true)"
  [[ -n "${state}" && "${state}" != "Z" ]] || return 1

  command_line="$(tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null || true)"
  [[ "${command_line}" =~ ${CVD_PROCESS_REGEX} ]]
}

normalize_stop_grace_seconds() {
  if [[ ! "${IKA_STOP_GRACE_SEC}" =~ ^[1-9][0-9]*$ ]]; then
    die "IKA_STOP_GRACE_SEC must be a positive whole number of seconds"
  fi
}

read_udmabuf_snapshot() {
  local bufinfo="/sys/kernel/debug/dma_buf/bufinfo"
  local contents

  # Some Asahi kernels can retain imported udmabufs after an unclean renderer
  # exit. Keep this probe advisory: failure to read debugfs must never prevent
  # the VM from starting or stopping.
  if [[ -r "${bufinfo}" ]]; then
    contents="$(<"${bufinfo}")"
  elif command -v sudo >/dev/null 2>&1; then
    contents="$(sudo -n cat "${bufinfo}" 2>/dev/null)" || return 1
  else
    return 1
  fi

  awk '$5 == "udmabuf" && $1 ~ /^[0-9]+$/ { count++; bytes += $1 }
       END { printf "%d %.0f\n", count, bytes }' <<<"${contents}"
}

record_udmabuf_baseline() {
  local snapshot

  host_is_apple_silicon || return 0

  snapshot="$(read_udmabuf_snapshot || true)"
  [[ "${snapshot}" =~ ^[0-9]+\ [0-9]+$ ]] || return 0

  printf '%s\n' "${snapshot}" >"${UDMABUF_BASELINE_FILE}"
  log "Asahi udmabuf baseline: $(format_udmabuf_snapshot "${snapshot}")"
}

format_udmabuf_bytes() {
  local bytes="$1"

  if command -v numfmt >/dev/null 2>&1; then
    numfmt --to=iec-i --suffix=B "${bytes}" 2>/dev/null || printf '%s bytes\n' "${bytes}"
  else
    printf '%s bytes\n' "${bytes}"
  fi
}

format_udmabuf_snapshot() {
  local snapshot="$1"
  local count bytes

  read -r count bytes <<<"${snapshot}"
  printf '%s object(s), %s' "${count}" "$(format_udmabuf_bytes "${bytes}")"
}

report_udmabuf_leaks() {
  local baseline
  local current
  local baseline_count baseline_bytes
  local current_count current_bytes
  local leaked_count leaked_bytes

  host_is_apple_silicon || return 0

  [[ -r "${UDMABUF_BASELINE_FILE}" ]] || return 0
  baseline="$(<"${UDMABUF_BASELINE_FILE}")"
  current="$(read_udmabuf_snapshot || true)"
  [[ "${baseline}" =~ ^[0-9]+\ [0-9]+$ ]] || return 0
  [[ "${current}" =~ ^[0-9]+\ [0-9]+$ ]] || return 0

  read -r baseline_count baseline_bytes <<<"${baseline}"
  read -r current_count current_bytes <<<"${current}"
  leaked_count=$((current_count - baseline_count))
  leaked_bytes=$((current_bytes - baseline_bytes))

  if (( leaked_count > 0 || leaked_bytes > 0 )); then
    (( leaked_count > 0 )) || leaked_count=0
    (( leaked_bytes > 0 )) || leaked_bytes=0
    log_file_only "WARNING: Asahi retained ${leaked_count} udmabuf object(s) ($(format_udmabuf_bytes "${leaked_bytes}")) after Cuttlefish stopped. Kernels without the deferred drm_gpuvm_bo cleanup fix (AsahiLinux/linux#548) need a host reboot to reclaim kernel-pinned memory."
  else
    log_file_only "Asahi udmabuf usage returned to baseline: $(format_udmabuf_snapshot "${current}")"
  fi
}

within_deadline() {
  local deadline="$1"
  [[ "${deadline}" -eq 0 || ${SECONDS} -lt ${deadline} ]]
}

make_deadline() {
  local timeout_sec="$1"
  if [[ "${timeout_sec}" -gt 0 ]]; then
    printf '%s\n' "$((SECONDS + timeout_sec))"
  else
    printf '0\n'
  fi
}

resolve_adb_bin() {
  if [[ -x "${CVD_ADB_BIN}" ]]; then
    printf '%s\n' "${CVD_ADB_BIN}"
  else
    command -v adb || true
  fi
}

is_user_build() {
  [[ "${CVD_BUILD_VARIANT}" == "user" ]]
}

prepare_user_adb_key() {
  is_user_build || return 0

  local adb_bin
  local public_key_tmp
  local public_key
  mkdir -p "${HOST_HOME}/.android" || return 1
  adb_bin="$(resolve_adb_bin)"
  [[ -n "${adb_bin}" ]] || {
    log "adb is required to provision the user ADB key"
    return 1
  }

  if [[ ! -s "${USER_ADB_PRIVATE_KEY}" ]]; then
    "${adb_bin}" keygen "${USER_ADB_PRIVATE_KEY}" >/dev/null || {
      log "could not generate the user ADB key: ${USER_ADB_PRIVATE_KEY}"
      return 1
    }
  fi
  public_key="$("${adb_bin}" pubkey "${USER_ADB_PRIVATE_KEY}")" || {
    log "could not derive the public user ADB key: ${USER_ADB_PRIVATE_KEY}"
    return 1
  }
  USER_ADB_PUBLIC_KEY_VALUE="${public_key%% *}"
  [[ -n "${USER_ADB_PUBLIC_KEY_VALUE}" ]] || {
    log "adb returned an empty public key for ${USER_ADB_PRIVATE_KEY}"
    return 1
  }
  if ! printf '%s\n' "${public_key}" | cmp -s - "${USER_ADB_PUBLIC_KEY}"; then
    public_key_tmp="$(mktemp "${USER_ADB_PUBLIC_KEY}.XXXXXX")" || return 1
    if ! printf '%s\n' "${public_key}" > "${public_key_tmp}"; then
      rm -f "${public_key_tmp}"
      return 1
    fi
    mv -f "${public_key_tmp}" "${USER_ADB_PUBLIC_KEY}"
  fi
  chmod 600 "${USER_ADB_PRIVATE_KEY}" || return 1
  chmod 644 "${USER_ADB_PUBLIC_KEY}" || return 1
}

host_adb() {
  local timeout_seconds="$1"
  shift
  local adb_bin

  adb_bin="$(resolve_adb_bin)"
  [[ -n "${adb_bin}" ]] || return 1
  timeout "${timeout_seconds}" "${adb_bin}" "$@"
}

# Drops the guest's adb transport once the VM has stopped. Otherwise the adb
# server keeps reconnecting to it about four times a second until the VM
# starts again. Starts no adb server when none is running.
disconnect_guest_adb() {
  local adb_serial="$1"

  pgrep -u "${UID}" -f '(^|/)adb .*fork-server server' >/dev/null 2>&1 || return 0
  host_adb 5 disconnect "${adb_serial}" >/dev/null 2>&1 || true
}

# Prints an epoch time in a date(1) format, with GNU or BSD date.
format_epoch() {
  date -d "@$1" "+$2" 2>/dev/null || date -r "$1" "+$2"
}

# Drops the lines of a log before line $2, or all of them when $2 is empty.
# The file is rewritten in place, so a process that keeps it open for
# appending goes on writing to it; lines written during the rewrite may be
# lost.
drop_log_lines_before() {
  local log_file="$1"
  local first_kept="$2"
  local kept

  [[ "${first_kept}" != "1" ]] || return 0
  if [[ -z "${first_kept}" ]]; then
    : > "${log_file}" || true
    return 0
  fi
  kept="$(mktemp "${log_file}.XXXXXX")" || return 0
  if tail -n "+${first_kept}" "${log_file}" > "${kept}"; then
    cat "${kept}" > "${log_file}" || true
  fi
  rm -f "${kept}"
}

# ikastart.log and madbfs.log keep this many of their last lines.
readonly LOG_MAX_LINES=1000

# Keeps the last LOG_MAX_LINES lines of a log.
trim_log_lines() {
  local log_file="$1"
  local line_count

  [[ -s "${log_file}" ]] || return 0
  line_count="$(wc -l <"${log_file}" 2>/dev/null || true)"
  line_count="${line_count//[[:space:]]/}"
  [[ "${line_count}" =~ ^[0-9]+$ ]] || return 0
  (( line_count > LOG_MAX_LINES )) || return 0
  drop_log_lines_before "${log_file}" "$(( line_count - LOG_MAX_LINES + 1 ))"
}

# Keeps the last 24 hours of the adb server's log. The server outlives VM
# restarts and never trims its log, which grows by about 1 MB a day from
# adb_connector's checks every 5 seconds; a running server keeps the file open
# for appending.
trim_adb_server_log() {
  local log_file="${ADB_SERVER_LOG}"
  local cutoff
  local first_kept

  [[ -s "${log_file}" ]] || return 0
  cutoff="$(( $(date +%s) - 86400 ))"
  # Lines start with "MM-DD HH:MM:SS.mmm", without the year: a line is recent
  # when it is from today, or from yesterday at or after the cutoff time.
  first_kept="$(awk -v yesterday="$(format_epoch "${cutoff}" '%m-%d')" \
      -v cutoff_time="$(format_epoch "${cutoff}" '%H:%M:%S')" \
      -v today="$(date +%m-%d)" '
    { day = substr($0, 1, 5) }
    day == today || (day == yesterday && substr($0, 7, 8) >= cutoff_time) {
      print NR
      exit
    }' "${log_file}" || true)"
  drop_log_lines_before "${log_file}" "${first_kept}"
}

adb_boot_completed() {
  local adb_serial="$1"
  local boot_completed

  # timeout guards against the dead-guest host proxy accepting the connection
  # and never answering, which would stall wait_for_boot's poll loop.
  boot_completed="$(host_adb 5 -s "${adb_serial}" shell getprop sys.boot_completed 2>/dev/null \
    | tr -d '\r' || true)"
  [[ "${boot_completed}" == "1" ]]
}

# True once Android has shown its first frame (SurfaceFlinger's
# sf_stop_bootanim event), seconds before sys.boot_completed on slow hosts.
adb_first_frame_shown() {
  local output

  output="$(host_adb 5 -s "$1" shell 'getprop sys.boot_completed; logcat -b events -d -m 1 -s sf_stop_bootanim' \
    2>/dev/null | tr -d '\r' || true)"
  [[ "${output}" == 1* || "${output}" == *sf_stop_bootanim* ]]
}

# Prints the mode Android booted in, tv or desktop, or nothing when the guest
# does not answer. Android's mode is switched by IkaMode's Desktop/TV entry
# and takes effect at boot, when TV mode adds the leanback feature.
guest_ui_mode() {
  local adb_serial="$1"
  local leanback

  leanback="$(host_adb 10 -s "${adb_serial}" shell cmd package has-feature \
    android.software.leanback 2>/dev/null | tr -d '\r' || true)"
  case "${leanback}" in
    true) printf 'tv\n' ;;
    false) printf 'desktop\n' ;;
  esac
  return 0
}

adb_guest_boot_id() {
  local adb_serial="$1"
  local boot_id

  boot_id="$(host_adb 5 -s "${adb_serial}" shell cat /proc/sys/kernel/random/boot_id 2>/dev/null \
    | tr -d '\r' || true)"
  [[ "${boot_id}" =~ ^[0-9a-fA-F-]{36}$ ]] || return 1
  printf '%s\n' "${boot_id}"
}

read_scrcpy_window_state() {
  local state_file="$1"
  local -n width_ref="$2"
  local -n height_ref="$3"
  local -n fullscreen_ref="$4"
  local key
  local value
  local version=""
  local width=""
  local height=""
  local fullscreen=""

  [[ -f "${state_file}" ]] || return 1
  while IFS='=' read -r key value; do
    case "${key}" in
      version) version="${value}" ;;
      width) width="${value}" ;;
      height) height="${value}" ;;
      fullscreen) fullscreen="${value}" ;;
    esac
  done < "${state_file}"

  [[ "${version}" == "1" ]] || return 1
  [[ "${width}" =~ ^[1-9][0-9]*$ && "${width}" -le 65535 ]] || return 1
  [[ "${height}" =~ ^[1-9][0-9]*$ && "${height}" -le 65535 ]] || return 1
  [[ "${fullscreen}" == "true" || "${fullscreen}" == "false" ]] || return 1

  width_ref="${width}"
  height_ref="${height}"
  fullscreen_ref="${fullscreen}"
}

# The window state file of the console of MODE, desktop or tv.
mode_console_window_state_file() {
  case "$1" in
    tv) printf '%s\n' "${TV_CONSOLE_WINDOW_STATE_FILE}" ;;
    *) printf '%s\n' "${DESKTOP_CONSOLE_WINDOW_STATE_FILE}" ;;
  esac
}

# Sets the array named by $1 to the options of the 'ika start' that opens the
# console after Android restarted in MODE ($2): --fullscreen when that mode's
# console was last used fullscreen, so that a mode switch brings each console
# back as it was. Its size comes from the same file when the console starts.
console_switch_start_options() {
  local -n options_ref="$1"
  local mode="$2"
  local saved_width=""
  local saved_height=""
  local saved_fullscreen=""

  options_ref=()
  if read_scrcpy_window_state "$(mode_console_window_state_file "${mode}")" \
      saved_width saved_height saved_fullscreen \
      && [[ "${saved_fullscreen}" == "true" ]]; then
    options_ref+=(--fullscreen)
  fi
}

wait_for_guest_reboot() {
  local adb_serial="$1"
  local previous_boot_id="$2"
  local timeout_sec="$3"
  local deadline
  local current_boot_id

  deadline=$((SECONDS + timeout_sec))
  while (( SECONDS < deadline )); do
    has_live_cvd_processes || return 1
    current_boot_id="$(adb_guest_boot_id "${adb_serial}" || true)"
    # An adb reconnect alone can be transient. A new kernel boot ID followed
    # by Android boot completion proves that this was an actual guest reboot.
    if [[ -n "${current_boot_id}" \
        && "${current_boot_id}" != "${previous_boot_id}" ]] \
        && adb_boot_completed "${adb_serial}"; then
      printf '%s\n' "${current_boot_id}"
      return 0
    fi
    sleep 0.5
  done
  return 1
}

scrcpy_supervisor_cleanup() {
  if [[ -n "${scrcpy_supervisor_child_pid:-}" ]]; then
    kill "${scrcpy_supervisor_child_pid}" >/dev/null 2>&1 || true
    wait "${scrcpy_supervisor_child_pid}" 2>/dev/null || true
  fi
  remove_app_cuttlefish_display
  if [[ -f "${SCRCPY_SUPERVISOR_PID_FILE}" \
      && "$(<"${SCRCPY_SUPERVISOR_PID_FILE}")" == "$$" ]]; then
    rm -f "${SCRCPY_SUPERVISOR_PID_FILE}"
  fi
}

# scrcpy reaches its server through an "adb forward" of a local port, and adb
# rebinds a port that is already forwarded. Clients connecting at the same time
# (app windows opened together from the menu) would take over, and on failure
# remove, each other's forward, so each supervisor locks a port of its own for
# as long as it runs.
SCRCPY_FORWARD_PORT_FIRST=27183
SCRCPY_FORWARD_PORT_LAST=27299

# Sets the variables named by $1 and $2 to a free forward port and the open
# file descriptor that holds its lock.
lock_scrcpy_forward_port() {
  local -n port_ref="$1"
  local -n port_fd_ref="$2"
  local dir="${CVD_TMP_DIR}/scrcpy-ports"
  local port
  local fd

  mkdir -p "${dir}" || return 1
  for (( port = SCRCPY_FORWARD_PORT_FIRST; port <= SCRCPY_FORWARD_PORT_LAST; port++ )); do
    exec {fd}>"${dir}/${port}.lock" || continue
    if flock -n "${fd}"; then
      port_ref="${port}"
      port_fd_ref="${fd}"
      return 0
    fi
    exec {fd}>&-
  done
  return 1
}

run_scrcpy_supervisor() {
  local adb_serial="$1"
  local initial_fullscreen="$2"
  shift 2
  [[ "${1:-}" == "--" ]] || die "invalid console supervisor arguments"
  shift
  local -a base_command=("$@")
  local -a command
  local previous_boot_id
  local new_boot_id
  local window_width=""
  local window_height=""
  local fullscreen="${initial_fullscreen}"
  local status
  local started_at
  # Quick failures are retried: the guest may still be settling at the first
  # launch and right after a reboot.
  local quick_retries=4
  local quick_retry_sec=5
  local supervisor_lock_fd
  local forward_port=""
  local forward_port_fd=""
  local port_given="false"
  local arg
  local game_session="false"
  local session_watch_pid=""
  local console_mode="desktop"
  local guest_mode
  local -a switch_options=()

  if [[ " ${base_command[*]} " == *" --ika-game-session "* ]]; then
    game_session="true"
    SCRCPY_WINDOW_STATE_FILE="${GAME_CONSOLE_WINDOW_STATE_FILE}"
  elif [[ " ${base_command[*]} " == *" --window-state-file=${TV_CONSOLE_WINDOW_STATE_FILE} "* ]]; then
    console_mode="tv"
    SCRCPY_WINDOW_STATE_FILE="${TV_CONSOLE_WINDOW_STATE_FILE}"
  fi

  if [[ ! "${IKA_SCRCPY_REBOOT_TIMEOUT_SEC}" =~ ^[1-9][0-9]*$ ]]; then
    die "IKA_SCRCPY_REBOOT_TIMEOUT_SEC must be a positive whole number of seconds"
  fi

  exec {supervisor_lock_fd}>"${SCRCPY_SUPERVISOR_LOCK_FILE}"
  if ! flock -n "${supervisor_lock_fd}"; then
    log "another console supervisor is already active"
    return 0
  fi

  umask 077
  printf '%s\n' "$$" > "${SCRCPY_SUPERVISOR_PID_FILE}.tmp.$$"
  mv -f "${SCRCPY_SUPERVISOR_PID_FILE}.tmp.$$" "${SCRCPY_SUPERVISOR_PID_FILE}"
  scrcpy_supervisor_child_pid=""
  trap 'exit 0' INT TERM HUP
  trap scrcpy_supervisor_cleanup EXIT

  for arg in "${base_command[@]}"; do
    case "${arg}" in
      --port|--port=*|-p|-p[0-9]*) port_given="true" ;;
    esac
  done
  if [[ "${port_given}" != "true" ]]; then
    if lock_scrcpy_forward_port forward_port forward_port_fd; then
      base_command+=(--port="${forward_port}")
      log "using adb forward port ${forward_port}"
    else
      log "no free adb forward port; using the scrcpy default"
    fi
  fi

  previous_boot_id="$(adb_guest_boot_id "${adb_serial}" || true)"
  local saved_fullscreen
  if read_scrcpy_window_state "${SCRCPY_WINDOW_STATE_FILE}" \
      window_width window_height saved_fullscreen; then
    log "restoring saved console size ${window_width}x${window_height}"
  fi
  # A normal launch obeys the requested windowed/fullscreen mode. The saved
  # fullscreen value is used only below when recovering the same console from
  # a confirmed guest reboot.
  while has_live_cvd_processes; do
    command=("${base_command[@]}")
    if [[ -n "${window_width}" && -n "${window_height}" ]]; then
      command+=(--window-width="${window_width}" --window-height="${window_height}")
    fi
    if [[ "${fullscreen}" == "true" ]]; then
      command+=(--fullscreen)
    fi

    log "starting console (fullscreen=${fullscreen})"
    started_at="${SECONDS}"
    "${command[@]}" &
    scrcpy_supervisor_child_pid="$!"
    if [[ "${game_session}" == "true" ]]; then
      ( exec {supervisor_lock_fd}>&-
        watch_game_session "${adb_serial}" "${scrcpy_supervisor_child_pid}" ) &
      session_watch_pid="$!"
    fi
    set +e
    wait "${scrcpy_supervisor_child_pid}"
    status="$?"
    set -e
    scrcpy_supervisor_child_pid=""
    if [[ -n "${session_watch_pid}" ]]; then
      kill "${session_watch_pid}" >/dev/null 2>&1 || true
      session_watch_pid=""
    fi

    if [[ "${game_session}" == "true" ]] \
        && [[ "${status}" -eq "${SCRCPY_EXIT_GAME_SESSION_ENDED}" \
              || -f "${GAME_SESSION_EXITED_FILE}" ]]; then
      # Release this console's lock and pid file first: the desktop console
      # restored by end_game_session must not find them held.
      exec {supervisor_lock_fd}>&-
      if [[ -n "${forward_port_fd}" ]]; then
        exec {forward_port_fd}>&-
      fi
      trap - EXIT
      lock_game_session || log "game session lock timed out; ending the session anyway"
      scrcpy_supervisor_cleanup
      end_game_session "${adb_serial}"
      unlock_game_session
      return 0
    fi

    if [[ "${status}" -eq 0 ]]; then
      # Closing the window is intentional and must not create a reopen loop.
      log "console closed by user"
      return 0
    fi

    if [[ "${status}" -ne "${SCRCPY_EXIT_DISCONNECTED}" ]]; then
      if (( quick_retries > 0 && SECONDS - started_at < quick_retry_sec )) \
          && has_live_cvd_processes; then
        log "console exited quickly with status ${status}; retrying"
        quick_retries=$((quick_retries - 1))
        sleep 1
        continue
      fi
      log "console exited with status ${status}; not relaunching"
      return "${status}"
    fi

    quick_retries=0
    if [[ "${APP_WINDOW_SUPERVISOR:-false}" == "true" ]]; then
      # App windows do not reopen after a reboot: Android starts clean. The
      # display goes now, while its number cannot yet be another window's.
      log "guest disconnected; closing the app window"
      remove_app_cuttlefish_display
      return 0
    fi
    if ! read_scrcpy_window_state "${SCRCPY_WINDOW_STATE_FILE}" \
        window_width window_height fullscreen; then
      log "console window state was unavailable; retaining the previous launch size and mode"
    fi

    has_live_cvd_processes || return 0
    log "guest disconnected; waiting up to ${IKA_SCRCPY_REBOOT_TIMEOUT_SEC}s for reboot completion"
    new_boot_id="$(wait_for_guest_reboot "${adb_serial}" "${previous_boot_id}" \
      "${IKA_SCRCPY_REBOOT_TIMEOUT_SEC}" || true)"
    if [[ -z "${new_boot_id}" ]]; then
      if has_live_cvd_processes; then
        log "guest did not complete a new boot; console will remain closed"
      else
        log "Cuttlefish stopped; console will remain closed"
      fi
      return 0
    fi

    previous_boot_id="${new_boot_id}"
    # IkaMode's switcher changes Android's mode at a restart. Hand over to a
    # console for the new mode, started once this supervisor has released its
    # lock, as that mode's console was last used: fullscreen or windowed, from
    # its own window state, which the other mode's console does not touch.
    guest_mode="$(guest_ui_mode "${adb_serial}")"
    if [[ "${game_session}" != "true" && -n "${guest_mode}" \
        && "${guest_mode}" != "${console_mode}" ]]; then
      console_switch_start_options switch_options "${guest_mode}"
      log "Android restarted in ${guest_mode} mode; opening its console${switch_options[0]:+ ${switch_options[*]}}"
      exec {supervisor_lock_fd}>&-
      if [[ -n "${forward_port_fd}" ]]; then
        exec {forward_port_fd}>&-
      fi
      setsid --fork bash -c 'while kill -0 "$1" 2>/dev/null; do sleep 0.2; done
          exec "$2" start "${@:3}"' ika-console-switch "$$" "${IKA_SCRIPT_PATH}" \
        "${switch_options[@]}" </dev/null >/dev/null 2>&1 3>&-
      return 0
    fi
    # Connecting can take scrcpy's server about 10s on a freshly booted guest.
    quick_retries=4
    quick_retry_sec=30
    log "guest reboot completed; relaunching console at ${window_width:-default}x${window_height:-default}"
  done
}

# Prints the combined size of the guest's logs, which grow while it boots.
guest_log_bytes() {
  local total=0
  local size
  local log_file

  for log_file in "${CVD_INSTANCE_DIR}"/logs/{kernel.log,logcat,launcher.log}; do
    size="$(stat -L -c '%s' "${log_file}" 2>/dev/null || echo 0)"
    total=$((total + size))
  done
  printf '%s\n' "${total}"
}

# Succeeds while process PID runs. A zombie has exited.
process_is_running() {
  local state

  state="$(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f1 || true)"
  [[ -n "${state}" && "${state}" != "Z" ]]
}

# Waits up to CVD_BOOT_TIMEOUT_SEC for Android to boot, and past it while the
# guest's logs still grow (see CVD_BOOT_MAX_SEC). LAUNCHER_PID counts as a live
# VM process: cvd_internal_start replaces itself with 'cvd create', which
# CVD_PROCESS_REGEX does not match, and run_cvd only starts after it.
wait_for_boot() {
  local launcher_log="$1"
  local min_mtime="${2:-0}"
  local launcher_pid="${3:-}"
  local adb_serial=""
  local crosvm_command_reported="false"
  local deadline
  local max_deadline
  local stall_deadline=0
  local log_bytes
  local last_log_bytes=""

  deadline="$(make_deadline "${CVD_BOOT_TIMEOUT_SEC}")"
  max_deadline="$(make_deadline "${CVD_BOOT_MAX_SEC}")"
  while within_deadline "${max_deadline}"; do
    if [[ -f "${launcher_log}" ]]; then
      local log_mtime
      log_mtime="$(stat -c '%Y' "${launcher_log}" 2>/dev/null || echo 0)"
      if [[ "${crosvm_command_reported}" != "true" ]]; then
        if maybe_respond_crosvm_command "${launcher_log}" "${min_mtime}"; then
          crosvm_command_reported="true"
        fi
      fi
    fi
    # The serial depends on this launch's adb mode, so wait for its config.
    if [[ -z "${adb_serial}" ]] \
        && (( $(stat -c '%Y' "${CVD_CONFIG_PATH}" 2>/dev/null || echo 0) >= min_mtime )); then
      adb_serial="$(resolve_adb_serial)"
    fi
    if [[ -n "${adb_serial}" ]] && adb_first_frame_shown "${adb_serial}"; then
      return 0
    fi
    if ! has_live_cvd_processes \
        && ! { [[ -n "${launcher_pid}" ]] && process_is_running "${launcher_pid}"; }; then
      return 1
    fi
    if ! within_deadline "${deadline}"; then
      log_bytes="$(guest_log_bytes)"
      if [[ -z "${last_log_bytes}" ]]; then
        log "Android has not finished booting after ${CVD_BOOT_TIMEOUT_SEC}s; waiting while it makes progress"
      fi
      if [[ "${log_bytes}" != "${last_log_bytes}" ]]; then
        last_log_bytes="${log_bytes}"
        stall_deadline="$(make_deadline "${CVD_BOOT_STALL_SEC}")"
      elif ! within_deadline "${stall_deadline}"; then
        log "the guest logs have not changed for ${CVD_BOOT_STALL_SEC}s"
        return 1
      fi
    fi
    sleep 0.1
  done

  return 1
}

# Installs Chromium until it has succeeded once for this VM. 'ika reset'
# removes the stamp, so a reset VM gets it again; one removed by the user stays
# removed. Runs before the console opens: getchromium drives the guest UI.
ensure_chromium() {
  local adb_serial="$1"

  if [[ -e "${CHROMIUM_INSTALL_STAMP}" ]]; then
    return 0
  fi

  if [[ ! -x "${PACKAGED_GETCHROMIUM_BIN}" ]]; then
    log "${PACKAGED_GETCHROMIUM_BIN} is unavailable; skipping Chromium."
    return 0
  fi

  if ANDROID_SERIAL="${adb_serial}" IKA_CHROMIUM_APK="${CHROMIUM_APK}" \
      "${PACKAGED_GETCHROMIUM_BIN}" >&3 2>&3; then
    mkdir -p "$(dirname "${CHROMIUM_INSTALL_STAMP}")"
    : > "${CHROMIUM_INSTALL_STAMP}"
    log "getchromium completed."
  else
    log "getchromium failed; it runs again on the next start."
  fi
}

# 'ika app --touch' exports IKA_TOUCH, which the console client reads to send
# left-button clicks and drags as real touch input. Unset, empty and 0 mean
# off, as in the client.
touch_enabled() {
  [[ -n "${IKA_TOUCH:-}" && "${IKA_TOUCH}" != "0" ]]
}

# Game mode uses UHID for all input devices; normal mode keeps text-friendly
# SDK keyboard injection, and TV mode ("tv") adds the UHID gamepad to it.
# Touch needs the SDK mouse, so in game mode only the mouse leaves UHID and the
# gamepad and keyboard are still forwarded as HID devices. A finger does not
# hover.
append_scrcpy_input_args() {
  local -n input_args_ref="$1"
  local game_mode="$2"
  local label="$3"

  if [[ "${game_mode}" == "true" ]] && touch_enabled; then
    log "${label} game mode: UHID gamepad and keyboard, touch input"
    input_args_ref+=(
      --gamepad=uhid
      --keyboard=uhid
      --mouse=sdk
      --no-mouse-hover
    )
  elif [[ "${game_mode}" == "true" ]]; then
    log "${label} game mode: UHID gamepad, keyboard, and mouse"
    input_args_ref+=(
      --gamepad=uhid
      --keyboard=uhid
      --mouse=uhid
    )
  elif [[ "${game_mode}" == "tv" ]]; then
    # The gamepad is the remote; the keyboard and mouse stay as on the desktop.
    log "${label} TV mode: UHID gamepad"
    input_args_ref+=(
      --gamepad=uhid
      --keyboard=sdk
      --prefer-text
    )
  else
    input_args_ref+=(
      --keyboard=sdk
      --prefer-text
    )
    if touch_enabled; then
      log "${label} touch input"
      input_args_ref+=(--no-mouse-hover)
    fi
  fi
}

append_scrcpy_extra_args() {
  local -n extra_args_ref="$1"
  local label="$2"
  local -a scrcpy_extra_args=()

  [[ -n "${IKA_SCRCPY:-}" ]] || return 0
  read -r -a scrcpy_extra_args <<<"${IKA_SCRCPY}"
  if [[ "${#scrcpy_extra_args[@]}" -gt 0 ]]; then
    log "using extra ${label} args: $(shell_join "${scrcpy_extra_args[@]}")"
    extra_args_ref+=("${scrcpy_extra_args[@]}")
  fi
}

append_scrcpy_env() {
  local -n scrcpy_env_ref="$1"

  if [[ -d "${SCRCPY_ICON_DIR_DEFAULT}" ]]; then
    scrcpy_env_ref+=("SCRCPY_ICON_DIR=${SCRCPY_ICON_DIR_DEFAULT}")
  fi

  if [[ -x "${CVD_CLI_BIN}" ]]; then
    scrcpy_env_ref+=("IKA_CVD_BIN=${CVD_CLI_BIN}")
  fi

  # scrcpy spawns `adb` to push the server jar and open the shell. Point it
  # at the cuttlefish-bundled adb explicitly so it doesn't rely on PATH —
  # on a stock Asahi system there's no /usr/bin/adb, and even where there
  # is one we want the cuttlefish version that's known to match the rest
  # of the cvd-host_package.
  local packaged_adb="${PACKAGED_CVD_HOST_OUT}/bin/adb"
  if [[ -x "${packaged_adb}" ]]; then
    scrcpy_env_ref+=("ADB=${packaged_adb}")
  fi

  if [[ -n "${SCRCPY_SERVER_PATH_OVERRIDE}" && -f "${SCRCPY_SERVER_PATH_OVERRIDE}" ]]; then
    scrcpy_env_ref+=("SCRCPY_SERVER_PATH=${SCRCPY_SERVER_PATH_OVERRIDE}")
  fi

  # On GNOME Wayland, GTK draws the window title bar (libdecor's GTK plugin)
  # and only goes dark when GTK_THEME says so. Match the desktop's light or
  # dark style, unless the user set a theme.
  if [[ -z "${GTK_THEME:-}" ]]; then
    if [[ "$(host_color_scheme)" == "dark" ]]; then
      scrcpy_env_ref+=("GTK_THEME=Adwaita:dark")
    else
      scrcpy_env_ref+=("GTK_THEME=Adwaita")
    fi
  fi

  # The window follows the session: Wayland on a Wayland session, X11 on an
  # X11 one. Left to itself, scrcpy's SDL opens an X11 window through
  # Xwayland on a Wayland compositor without the fifo-v1 protocol (KWin
  # before 6.4), and every frame then crosses Xwayland. A driver set in the
  # environment is kept.
  if [[ -z "${SDL_VIDEO_DRIVER:-}${SDL_VIDEODRIVER:-}" ]]; then
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
      scrcpy_env_ref+=("SDL_VIDEO_DRIVER=wayland" "SDL_VIDEODRIVER=wayland")
    elif [[ -n "${DISPLAY:-}" ]]; then
      scrcpy_env_ref+=("SDL_VIDEO_DRIVER=x11" "SDL_VIDEODRIVER=x11")
    fi
  fi
}

start_scrcpy_with_retries() {
  local adb_serial="$1"
  local fullscreen_mode="${2:-false}"
  local game_mode="${3:-false}"
  local cuttlefish_frames_socket
  local scrcpy_log="${SCRCPY_LOG_FILE}"
  local scrcpy_lock_file="${CVD_TMP_DIR}/console-launch.lock"
  local scrcpy_lock_fd=""
  local scrcpy_window_size
  local scrcpy_window_width
  local console_dpi="${SCRCPY_DPI}"
  local scrcpy_window_height
  local -a scrcpy_env=()
  local -a scrcpy_cmd=(
    "${SCRCPY_BIN}"
    -s "${adb_serial}"
  )

  # In Android's TV mode the console is the TV screen: fullscreen, at the TV
  # density (--dpi wins in either mode), with the gamepad as the remote. A game
  # session keeps its input.
  if [[ "$(guest_ui_mode "${adb_serial}")" == "tv" ]]; then
    log "Android is in TV mode"
    fullscreen_mode="true"
    [[ "${game_mode}" == "true" ]] || game_mode="tv"
    if [[ "${SCRCPY_DPI_GIVEN}" != "true" ]]; then
      console_dpi="$(resolve_tv_dpi)"
    fi
  fi
  exec {scrcpy_lock_fd}>"${scrcpy_lock_file}"
  if ! flock "${scrcpy_lock_fd}"; then
    log "unable to acquire console launch lock: ${scrcpy_lock_file}"
    return 1
  fi

  scrcpy_window_size="$(default_scrcpy_window_size)"
  if [[ "${scrcpy_window_size}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    scrcpy_window_width="${BASH_REMATCH[1]}"
    scrcpy_window_height="${BASH_REMATCH[2]}"
  else
    scrcpy_window_width=1280
    scrcpy_window_height=720
  fi

  if [[ -n "${console_dpi}" ]]; then
    scrcpy_cmd+=("--dpi=${console_dpi}")
  fi
  # Right, middle, 4th and 5th buttons, then the same with Shift: a right click
  # is a right click on the desktop (Back with Shift), and Back in TV mode, as
  # a remote's Back button (a right click with Shift). The middle button is
  # Home, the 4th and 5th the recent apps and the notifications.
  if [[ "${game_mode}" == "tv" ]]; then
    scrcpy_cmd+=(--mouse-bind=bhsn:++++)
  else
    scrcpy_cmd+=(--mouse-bind=+hsn:b+++)
  fi
  scrcpy_cmd+=(
    --force-adb-forward
    --render-driver=opengl
    --window-borderless
    --window-width="${scrcpy_window_width}"
    --window-height="${scrcpy_window_height}"
    --no-audio
  )

  append_scrcpy_input_args scrcpy_cmd "${game_mode}" console

  cuttlefish_frames_socket="$(resolve_cuttlefish_frames_socket)"
  scrcpy_cmd+=(--cuttlefish-frames-socket="${cuttlefish_frames_socket}")
  if [[ "${START_GAME_SESSION}" == "true" ]]; then
    # The fullscreen game console keeps its own window state, so that it does
    # not replace the desktop console's size.
    scrcpy_cmd+=(--ika-game-session)
    scrcpy_cmd+=(--window-state-file="${GAME_CONSOLE_WINDOW_STATE_FILE}")
  elif [[ "${game_mode}" == "tv" ]]; then
    scrcpy_cmd+=(--window-state-file="${TV_CONSOLE_WINDOW_STATE_FILE}")
  else
    scrcpy_cmd+=(--window-state-file="${SCRCPY_WINDOW_STATE_FILE}")
  fi
  log "console video source: raw Cuttlefish frames (${cuttlefish_frames_socket})"

  append_scrcpy_extra_args scrcpy_cmd console
  append_scrcpy_env scrcpy_env
  # ika.desktop's ID. Otherwise SDL uses the executable name, scrcpy, which
  # KDE's taskbar also derives for app windows and would match to the console.
  scrcpy_env+=("SDL_APP_ID=ika")

  if [[ "${#scrcpy_env[@]}" -gt 0 ]]; then
    scrcpy_cmd=(
      env
      "${scrcpy_env[@]}"
      "${scrcpy_cmd[@]}"
    )
  fi

  mkdir -p "$(dirname "${scrcpy_log}")"
  : > "${scrcpy_log}"

  ensure_chromium "${adb_serial}"

  flock -u "${scrcpy_lock_fd}"
  exec {scrcpy_lock_fd}>&-

  log "starting supervised console for ${adb_serial}"
  setsid --fork "${IKA_SCRIPT_PATH}" __console_supervisor \
    "${adb_serial}" "${fullscreen_mode}" -- "${scrcpy_cmd[@]}" \
    </dev/null >>"${scrcpy_log}" 2>&1 3>&- &
  disown || true

  sleep 1.5
  if has_packaged_scrcpy || scrcpy_supervisor_pid >/dev/null; then
    return 0
  fi

  log "unable to start the console supervisor"
  return 1
}

schedule_scrcpy_when_launcher_ready() {
  local adb_serial="$1"
  local fullscreen_mode="${2:-false}"
  local game_mode="${3:-false}"

  (
    while has_live_cvd_processes; do
      if adb_first_frame_shown "${adb_serial}"; then
        break
      fi
      sleep 0.1
    done

    if ! has_live_cvd_processes; then
      log "deferred console watcher stopped because Cuttlefish exited before Android's first frame."
      exit 0
    fi
    start_scrcpy_with_retries "${adb_serial}" "${fullscreen_mode}" "${game_mode}" || true
  ) &

  disown || true
  log "scheduled console launch for Android's first frame"
}

maybe_start_scrcpy() {
  local adb_serial="$1"
  local fullscreen_mode="${2:-false}"
  local game_mode="${3:-false}"

  if [[ ! -x "${SCRCPY_BIN}" ]]; then
    log "console client not found at ${SCRCPY_BIN}; skipping launch."
    return 0
  fi

  if adb_first_frame_shown "${adb_serial}"; then
    log "Ika console ready; starting the console immediately."
    start_scrcpy_with_retries "${adb_serial}" "${fullscreen_mode}" "${game_mode}" || true
    return 0
  fi

  log "Android has not shown its first frame; deferring console launch."
  schedule_scrcpy_when_launcher_ready "${adb_serial}" "${fullscreen_mode}" "${game_mode}"
  return 0
}

# ============================================================================
# App windows (ika app)
# ============================================================================
#
# Each app window is a separate scrcpy client that creates its own Android
# virtual display (--new-display), launches one app on it, and follows host
# window resizes. Unlike the desktop console, these windows use scrcpy's
# encoded video path rather than raw Cuttlefish frames.

is_app_package_name() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$ ]]
}

validate_app_package() {
  is_app_package_name "$1" || die "invalid package name '$1'"
}

use_app_window_paths() {
  local app_dir="${IKA_APPS_DIR}/$1"

  SCRCPY_SUPERVISOR_PID_FILE="$(app_supervisor_file "$1" pid)"
  SCRCPY_SUPERVISOR_LOCK_FILE="$(app_supervisor_file "$1" lock)"
  SCRCPY_WINDOW_STATE_FILE="${app_dir}/window-state"
  SCRCPY_LOG_FILE="${app_dir}/window.log"
}

guest_adb() {
  local adb_serial="$1"
  shift
  host_adb "${GUEST_ADB_TIMEOUT:-10}" -s "${adb_serial}" "$@"
}

app_is_installed() {
  local package="$1"
  local adb_serial="$2"
  local package_path

  package_path="$(guest_adb "${adb_serial}" shell pm path "${package}" 2>/dev/null | tr -d '\r' || true)"
  [[ "${package_path}" == package:* ]]
}

# Host Bluetooth is off by default, so the guest HCI port has no controller
# behind it and com.android.bluetooth aborts on every enable attempt. Clear the
# persisted bluetooth_on setting so later boots don't try, and stop the retry
# loop on this one.
disable_guest_bluetooth() {
  local adb_serial="$1"
  shift
  local bluetooth_on

  if user_supplied_flag "enable_host_bluetooth" "$@" || user_supplied_flag "netsim_bt" "$@"; then
    return 0
  fi

  bluetooth_on="$(guest_adb "${adb_serial}" shell settings get global bluetooth_on 2>/dev/null | tr -d '\r' || true)"
  [[ "${bluetooth_on}" == "0" ]] && return 0

  guest_adb "${adb_serial}" shell settings put global bluetooth_on 0 >/dev/null 2>&1 || true
  guest_adb "${adb_serial}" shell cmd bluetooth_manager disable >/dev/null 2>&1 || true
  log "disabled guest Bluetooth (no host Bluetooth controller)"
}

# On a VM's first boot, start Android in the host's light or dark theme. The
# ika_theme_seeded marker lives in the guest, so later boots leave a theme the
# user picked in Android alone, and a wiped VM is seeded again.
seed_guest_theme() {
  local adb_serial="$1"
  local seeded
  local scheme
  local night

  # Only an explicit "null" means unset; an adb error must not re-seed.
  seeded="$(guest_adb "${adb_serial}" shell settings get global ika_theme_seeded 2>/dev/null | tr -d '\r' || true)"
  [[ "${seeded}" == "null" ]] || return 0

  # LineageOS defaults to dark, and GNOME's light style reports no preference,
  # so anything but dark is applied as light.
  scheme="$(host_color_scheme)"
  if [[ "${scheme}" == "dark" ]]; then
    night=yes
  else
    scheme="light"
    night=no
  fi
  # Through the uimode service, which applies the change at once and saves it
  # to ui_night_mode; writing the setting directly only applies after reboot.
  guest_adb "${adb_serial}" shell cmd uimode night "${night}" >/dev/null 2>&1 || true
  log "set the guest theme to ${scheme} to match the host"
  guest_adb "${adb_serial}" shell settings put global ika_theme_seeded 1 >/dev/null 2>&1 || true
}

# Applies low-CPU mode's guest settings once Android is up: window blurs
# off and animations at half their length. The values they replace are kept
# in the global setting ika_lowcpu_mode, so that a start without the
# profile puts them back.
apply_lowcpu_mode_guest_settings() {
  local adb_serial="$1"
  local saved
  local blurs
  local window
  local transition
  local animator

  saved="$(guest_adb "${adb_serial}" shell settings get global ika_lowcpu_mode 2>/dev/null | tr -d '\r' || true)"
  if [[ "${LOWCPU_MODE_ACTIVE}" == "true" ]]; then
    if [[ "${saved}" == "null" || -z "${saved}" ]]; then
      saved="$(guest_adb "${adb_serial}" shell "echo \$(settings get global disable_window_blurs),\$(settings get global window_animation_scale),\$(settings get global transition_animation_scale),\$(settings get global animator_duration_scale)" 2>/dev/null | tr -d '\r ' || true)"
      [[ "${saved}" =~ ^[^,]*,[^,]*,[^,]*,[^,]*$ ]] || return 0
    fi
    guest_adb "${adb_serial}" shell "settings put global ika_lowcpu_mode '${saved}'; \
      settings put global disable_window_blurs 1; \
      settings put global window_animation_scale 0.5; \
      settings put global transition_animation_scale 0.5; \
      settings put global animator_duration_scale 0.5" >/dev/null 2>&1 || return 0
    log "low-CPU mode: window blurs off, animations at half length"
  elif [[ "${saved}" =~ ^([^,]*),([^,]*),([^,]*),([^,]*)$ ]]; then
    blurs="${BASH_REMATCH[1]}"
    window="${BASH_REMATCH[2]}"
    transition="${BASH_REMATCH[3]}"
    animator="${BASH_REMATCH[4]}"
    guest_adb "${adb_serial}" shell "$(lowcpu_mode_restore_command disable_window_blurs "${blurs}"); \
      $(lowcpu_mode_restore_command window_animation_scale "${window}"); \
      $(lowcpu_mode_restore_command transition_animation_scale "${transition}"); \
      $(lowcpu_mode_restore_command animator_duration_scale "${animator}"); \
      settings delete global ika_lowcpu_mode" >/dev/null 2>&1 || return 0
    log "low-CPU mode off: window blurs and animations restored"
  fi
}

# The shell command that puts the global setting NAME back to VALUE, as
# 'settings get' printed it: "null" means it was unset.
lowcpu_mode_restore_command() {
  if [[ "$2" == "null" || -z "$2" ]]; then
    printf 'settings delete global %s' "$1"
  else
    printf 'settings put global %s %s' "$1" "$(shell_quote "$2")"
  fi
}

# Density of the desktop display, preferring the override that ika applies
# when the console window is resized.
guest_display_density() {
  local adb_serial="$1"
  local output
  local override
  local physical

  output="$(guest_adb "${adb_serial}" shell wm density 2>/dev/null | tr -d '\r' || true)"
  override="$(sed -n 's/^Override density: *\([0-9][0-9]*\).*/\1/p' <<<"${output}")"
  physical="$(sed -n 's/^Physical density: *\([0-9][0-9]*\).*/\1/p' <<<"${output}")"
  printf '%s\n' "${override:-${physical}}"
}

# The size of an app window in native host pixels rather than logical window
# points, so that on HiDPI hosts the app draws at native resolution instead of
# being upscaled: the logical window size scaled by the host's native/logical
# ratio, rounded to the nearest pixel as SDL does, then down to an even size.
app_window_display_size() {
  local window_size="$1"
  local native
  local logical
  local native_max
  local logical_max
  local width
  local height

  [[ "${window_size}" =~ ^([0-9]+)x([0-9]+)$ ]] || return 1
  width="${BASH_REMATCH[1]}"
  height="${BASH_REMATCH[2]}"

  native="$(host_display_size || true)"
  logical="$(host_display_logical_size || true)"
  if [[ "${native}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    native_max=$(( BASH_REMATCH[1] > BASH_REMATCH[2] ? BASH_REMATCH[1] : BASH_REMATCH[2] ))
    if [[ "${logical}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
      logical_max=$(( BASH_REMATCH[1] > BASH_REMATCH[2] ? BASH_REMATCH[1] : BASH_REMATCH[2] ))
      if (( native_max > 0 && logical_max > 0 )); then
        width=$(( (width * native_max + logical_max / 2) / logical_max ))
        height=$(( (height * native_max + logical_max / 2) / logical_max ))
      fi
    fi
  fi

  width=$(( width / 2 * 2 ))
  height=$(( height / 2 * 2 ))
  (( width > 0 && height > 0 )) || return 1
  printf '%sx%s\n' "${width}" "${height}"
}

# App windows show a Cuttlefish display of their own, added to crosvm's GPU
# device while the VM runs, through ika_stream's raw frames (scrcpy
# --cuttlefish-display), as the console shows the main display.

# The control socket of crosvm's GPU device, which adds and removes displays:
# the vhost-user GPU's own socket when the GPU runs in its own process, else the
# VM's control socket. ('cvd display' always sends to the VM's control socket,
# which cannot reach a vhost-user GPU.)
cuttlefish_gpu_control_socket() {
  local dir
  dir="$(dirname "$(resolve_cuttlefish_frames_socket)")"
  if [[ -S "${dir}/vhost-user-gpu-control" ]]; then
    printf '%s/vhost-user-gpu-control\n' "${dir}"
  else
    printf '%s/crosvm_control.sock\n' "${dir}"
  fi
}

# Prints the numbers of the Cuttlefish displays, one per line.
cuttlefish_display_numbers() {
  timeout 10 "${CVD_HOST_OUT}/bin/crosvm" gpu list-displays "$1" 2>/dev/null \
    | tr -d ' \n' | grep -o '"[0-9][0-9]*":{' | tr -dc '0-9\n'
}

# Adds a Cuttlefish display of WIDTHxHEIGHT pixels at DPI and prints its
# number, which crosvm picks.
add_cuttlefish_display() {
  local size="$1"
  local dpi="$2"
  local socket
  local lock_fd
  local before
  local number
  local added=""

  socket="$(cuttlefish_gpu_control_socket)"
  exec {lock_fd}>"${CVD_TMP_DIR}/cuttlefish-displays.lock"
  if flock -w 10 "${lock_fd}"; then
    before="$(cuttlefish_display_numbers "${socket}")"
    if timeout 10 "${CVD_HOST_OUT}/bin/crosvm" gpu add-displays \
        "--gpu-display=mode=windowed[${size/x/,}],dpi=[${dpi},${dpi}],refresh-rate=60" \
        "${socket}" >/dev/null 2>&1; then
      while read -r number; do
        if [[ -n "${number}" ]] && ! grep -qx "${number}" <<<"${before}"; then
          added="${number}"
          break
        fi
      done < <(cuttlefish_display_numbers "${socket}")
    fi
  fi
  exec {lock_fd}>&-
  [[ -n "${added}" ]] || return 1
  printf '%s\n' "${added}"
}

remove_cuttlefish_display() {
  timeout 10 "${CVD_HOST_OUT}/bin/crosvm" gpu remove-displays --display-id="$1" \
    "$(cuttlefish_gpu_control_socket)" >/dev/null 2>&1
}

# The size of an app window's Cuttlefish display: the host screen, the largest
# the window can get (else the window's own size in pixels). Like the
# console's display, the app is drawn at the window size inside it.
app_cuttlefish_display_size() {
  host_display_size || printf '%s\n' "$1"
}

# Limits a window size in logical points to the host screen: a size saved
# under another desktop or scale can be larger.
clamp_app_window_size() {
  local width
  local height

  [[ "$1" =~ ^([0-9]+)x([0-9]+)$ ]] || return 1
  width="${BASH_REMATCH[1]}"
  height="${BASH_REMATCH[2]}"
  if [[ "$(host_display_logical_size || true)" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    (( width <= BASH_REMATCH[1] )) || width="${BASH_REMATCH[1]}"
    (( height <= BASH_REMATCH[2] )) || height="${BASH_REMATCH[2]}"
  fi
  printf '%sx%s\n' "${width}" "${height}"
}

# 16:9 at 60% of the host's logical width, capped at 75% of its height.
default_app_window_size() {
  local size
  local host_width
  local host_height
  local width=1280
  local height=720
  local max_height

  size="$(host_display_logical_size || true)"
  if [[ "${size}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    host_width="${BASH_REMATCH[1]}"
    host_height="${BASH_REMATCH[2]}"
    width=$(( host_width * 60 / 100 ))
    height=$(( width * 9 / 16 ))
    max_height=$(( host_height * 75 / 100 ))
    if (( height > max_height )); then
      height="${max_height}"
      width=$(( height * 16 / 9 ))
    fi
  fi

  printf '%sx%s\n' "$(( width / 8 * 8 ))" "$(( height / 8 * 8 ))"
}

# Apps kept out of the app list, name matching and the desktop menu. They can
# still be opened by giving their full package name.
IKA_HIDDEN_APPS=(
  com.google.android.apps.restore
  com.google.android.googlequicksearchbox
  com.android.calculator2
  org.lineageos.etar
  com.android.deskclock
  com.android.contacts
  org.lineageos.recorder
  org.lineageos.audiofx
)
ika_ini_list IKA_HIDDEN_APPS apps hidden_apps

# Apps treated as games even though they do not declare
# android:appCategory="game", which Android uses to identify games.
IKA_GAME_APPS=(
)
ika_ini_list IKA_GAME_APPS apps game_apps

# Games are apps that declare themselves as such (recorded by the last sync in
# APP_GAMES_FILE, see IkaAppIcons) or that are listed in IKA_GAME_APPS. Given
# an adb serial, a game installed since the last sync is also recognized, by
# asking the guest's game mode service, which only accepts games.
is_game_app() {
  local package="$1"
  local adb_serial="${2:-}"
  local game

  for game in "${IKA_GAME_APPS[@]}"; do
    [[ "${package}" == "${game}" ]] && return 0
  done
  if [[ -f "${APP_GAMES_FILE}" ]] && grep -qxF "${package}" "${APP_GAMES_FILE}"; then
    return 0
  fi
  [[ -n "${adb_serial}" ]] || return 1
  guest_adb "${adb_serial}" shell cmd game list-modes "${package}" </dev/null 2>/dev/null \
    | grep -q 'current mode'
}

is_hidden_app() {
  local hidden

  for hidden in "${IKA_HIDDEN_APPS[@]}"; do
    [[ "$1" == "${hidden}" ]] && return 0
  done
  return 1
}

# Prints "LABEL<TAB>PACKAGE" for every enabled app with a launcher entry,
# except hidden apps, and caches the result for name lookups.
list_guest_apps() {
  local apps

  apps="$(query_guest_apps "$1")"
  [[ -n "${apps}" ]] || return 0
  mkdir -p "${IKA_APPS_DIR}"
  if printf '%s\n' "${apps}" > "${APP_LIST_CACHE}.$$"; then
    mv -f "${APP_LIST_CACHE}.$$" "${APP_LIST_CACHE}"
  fi
  printf '%s\n' "${apps}"
}

# Queries the launchable apps from scrcpy's app list, which prints each app as
# " * LABEL  PACKAGE" (system) or " - LABEL  PACKAGE", but moves the package to
# an indented continuation line when the label is 30 characters or longer.
query_guest_apps() {
  local adb_serial="$1"
  local output
  local -a scrcpy_env=()

  append_scrcpy_env scrcpy_env
  # Nothing unless the query succeeded: a partial list would make the menu sync
  # remove the launchers of the apps missing from it.
  output="$(timeout 30 env "${scrcpy_env[@]}" "${SCRCPY_BIN}" -s "${adb_serial}" --list-apps 2>&1)" \
    || return 0
  printf '%s\n' "${output}" \
    | tr -d '\r' \
    | awk '
        function is_package(s) {
          return s ~ /^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$/
        }
        function emit_same_line(    name, package) {
          name = pending
          package = name
          sub(/.*[[:space:]]/, "", package)
          sub(/[[:space:]]+[^[:space:]]+[[:space:]]*$/, "", name)
          if (is_package(package) && name != "") {
            printf "%s\t%s\n", name, package
          }
          pending = ""
        }
        /^ [*-] / {
          if (pending != "") {
            emit_same_line()
          }
          pending = substr($0, 4)
          # The app list is tab-separated, so a tab in a label would split it.
          gsub(/\t/, " ", pending)
          next
        }
        pending != "" && /^[[:space:]]+[^[:space:]]+[[:space:]]*$/ && is_package($1) {
          sub(/[[:space:]]+$/, "", pending)
          printf "%s\t%s\n", pending, $1
          pending = ""
          next
        }
        pending != "" {
          emit_same_line()
        }
        END {
          if (pending != "") {
            emit_same_line()
          }
        }' \
    | IKA_HIDDEN="${IKA_HIDDEN_APPS[*]}" awk -F '\t' '
        BEGIN {
          n = split(ENVIRON["IKA_HIDDEN"], packages, " ")
          for (i = 1; i <= n; i++) {
            hidden[packages[i]] = 1
          }
        }
        !($2 in hidden)' || true
}

# Resolves the app's label, cached per package because listing apps is slow.
# Falls back to the package name.
app_window_title() {
  local package="$1"
  local adb_serial="$2"
  local title_file="${IKA_APPS_DIR}/${package}/title"
  local title=""

  if [[ -s "${title_file}" ]]; then
    title="$(<"${title_file}")"
  else
    title="$(list_guest_apps "${adb_serial}" \
      | awk -F '\t' -v pkg="${package}" '$2 == pkg { print $1; exit }' || true)"
    if [[ -n "${title}" ]]; then
      printf '%s\n' "${title}" > "${title_file}"
    fi
  fi

  printf '%s\n' "${title:-${package}}"
}

# Prints the app's name as its menu launcher shows it, without the game/app
# marker (see app_launcher_name), for messages and notifications. It comes from
# the launcher, the cached app list, or the cached window title, without asking
# the guest, and falls back to the package name.
app_display_name() {
  local package="$1"
  local launcher
  local name=""

  launcher="$(app_menu_data_dir)/applications/ika-${package}.desktop"
  if [[ -f "${launcher}" ]]; then
    name="$(sed -n '/^Name=/{s///p;q}' "${launcher}")"
    name="${name#* ∙ }"
    name="${name//\\\\/\\}"
  fi
  if [[ -z "${name}" && -s "${APP_LIST_CACHE}" ]]; then
    name="$(awk -F '\t' -v pkg="${package}" '$2 == pkg { print $1; exit }' "${APP_LIST_CACHE}")"
  fi
  if [[ -z "${name}" && -s "${IKA_APPS_DIR}/${package}/title" ]]; then
    name="$(<"${IKA_APPS_DIR}/${package}/title")"
  fi
  printf '%s\n' "${name:-${package}}"
}

# Resolves NAME to "LABEL<TAB>PACKAGE" among the launchable apps. The app list
# cached by the last listing or sync answers most lookups without the live
# query, which takes over half a second; a miss, an ambiguous name, or an app
# that is no longer installed falls back to the live list.
resolve_launchable_app() {
  local name="$1"
  local adb_serial="$2"
  local matches

  if [[ -s "${APP_LIST_CACHE}" ]]; then
    matches="$(match_app_name "${name}" < "${APP_LIST_CACHE}")"
    if [[ -n "${matches}" && "$(grep -c . <<<"${matches}")" -eq 1 ]] \
        && app_is_installed "${matches#*$'\t'}" "${adb_serial}"; then
      printf '%s\n' "${matches}"
      return 0
    fi
  fi
  resolve_app_name "${name}" "$(list_guest_apps "${adb_serial}")" "launchable app"
}

# ============================================================================
# Game sessions (ika app <game>)
# ============================================================================
#
# A game started with 'ika app' runs in a game session instead of an app
# window: fullscreen on the primary display, in the console started with
# --game (gamepad, keyboard and mouse passthrough) and --game-session. The
# session ends when that console leaves fullscreen or is closed, or when the
# game quits: the game is sent Home (backgrounded, not killed), the session
# console closes, and the desktop console is restored if it was open before
# the session. Games started any other way are not affected.

read_game_session_value() {
  [[ -f "${GAME_SESSION_FILE}" ]] || return 0
  sed -n "s/^$1=//p" "${GAME_SESSION_FILE}" | head -n1
}

write_game_session() {
  local package="$1"
  local label="$2"
  local console_was_open="$3"
  local touch_mode="$4"

  printf 'package=%s\nlabel=%s\nconsole_was_open=%s\ntouch=%s\n' \
    "${package}" "${label}" "${console_was_open}" "${touch_mode}" > "${GAME_SESSION_FILE}.$$"
  mv -f "${GAME_SESSION_FILE}.$$" "${GAME_SESSION_FILE}"
  rm -f "${GAME_SESSION_EXITED_FILE}"
}

clear_game_session() {
  rm -f "${GAME_SESSION_FILE}" "${GAME_SESSION_EXITED_FILE}"
}

# Starting a game and ending a session hold this lock, so that a game launched
# while a session ends waits and then sees the console the end left behind.
# Commands that outlive the holder must close game_session_lock_fd.
lock_game_session() {
  exec {game_session_lock_fd}>"${GAME_SESSION_LOCK_FILE}"
  flock -w 120 "${game_session_lock_fd}"
}

unlock_game_session() {
  [[ -n "${game_session_lock_fd}" ]] || return 0
  exec {game_session_lock_fd}>&-
  game_session_lock_fd=""
}

# True when the console running now is a game session console.
game_session_console_running() {
  local pid

  pid="$(scrcpy_supervisor_pid || true)"
  [[ -n "${pid}" ]] || return 1
  [[ " $(tr '\0' ' ' </proc/"${pid}"/cmdline 2>/dev/null) " == *" --ika-game-session "* ]]
}

# Whether the desktop console should come back when a game session ends: it
# was open before the session. A session started from within another one
# keeps the original answer.
desktop_console_was_open() {
  if [[ -f "${GAME_SESSION_FILE}" ]] && game_session_console_running; then
    printf '%s\n' "$(read_game_session_value console_was_open)"
  elif has_live_cvd_processes && scrcpy_supervisor_pid >/dev/null; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

# Prints the package of the activity in front on the primary display.
primary_display_top_package() {
  local package

  package="$(guest_adb "$1" shell dumpsys activity activities 2>/dev/null \
    | tr -d '\r' \
    | awk '
        /^Display #0/ { primary = 1; next }
        /^Display #/ { primary = 0 }
        primary && /topResumedActivity=/ {
          for (i = 1; i <= NF; i++) {
            if ($i ~ /\//) {
              split($i, component, "/")
              print component[1]
              exit
            }
          }
        }' || true)"
  [[ -n "${package}" ]] || return 1
  printf '%s\n' "${package}"
}

guest_home_package() {
  guest_adb "$1" shell cmd package resolve-activity --brief \
    -a android.intent.action.MAIN -c android.intent.category.HOME 2>/dev/null \
    | tr -d '\r' | tail -n1 | cut -d/ -f1
}

# Runs next to a game session console and stops it once the session's game
# has quit: after the game was seen in front, the home screen is in front of
# the primary display or the game's process is gone, on two checks in a row.
# A game that never comes to the front within two minutes ends the session
# too. Leaves GAME_SESSION_EXITED_FILE so that the supervisor ends the session.
watch_game_session() {
  local adb_serial="$1"
  local console_pid="$2"
  local home
  local package
  local watched=""
  local top
  local seen="false"
  local misses=0
  local since="${SECONDS}"

  home="$(guest_home_package "${adb_serial}" || true)"
  while kill -0 "${console_pid}" 2>/dev/null; do
    sleep 3
    package="$(read_game_session_value package)"
    [[ -n "${package}" ]] || continue
    if [[ "${package}" != "${watched}" ]]; then
      # A new game replaced the previous one in this session.
      watched="${package}"
      seen="false"
      misses=0
      since="${SECONDS}"
    fi

    top="$(primary_display_top_package "${adb_serial}" || true)"
    if [[ "${top}" == "${package}" ]]; then
      seen="true"
      misses=0
      continue
    fi
    if [[ "${seen}" != "true" ]]; then
      if (( SECONDS - since > 120 )); then
        log "game ${package} did not come to the front; ending the session"
        break
      fi
      continue
    fi

    if { [[ -n "${home}" && "${top}" == "${home}" ]] \
          || ! guest_adb "${adb_serial}" shell pidof "${package}" </dev/null >/dev/null 2>&1; }; then
      misses=$((misses + 1))
      if (( misses >= 2 )); then
        log "game ${package} quit; ending the session"
        break
      fi
    else
      misses=0
    fi
  done

  if kill -0 "${console_pid}" 2>/dev/null; then
    : > "${GAME_SESSION_EXITED_FILE}"
    kill "${console_pid}" >/dev/null 2>&1 || true
  fi
}

# Prints the home screen's state as Launcher3 reports it (Normal, Background,
# ...), or nothing for another launcher.
launcher_state() {
  guest_adb "$1" shell dumpsys activity "$2" </dev/null 2>/dev/null \
    | tr -d '\r' | grep -a -m1 -o 'mState:[A-Za-z]*' | cut -d: -f2
}

# Returns the primary display to the home screen with the Home key. On Ika's
# desktop, Home from an app can leave Launcher3 in its Background state, which
# shows the app's snapshot in front of the desktop, and a further press
# settles it on the home screen. Pressing Home on the home screen itself goes
# the other way, so each press waits for the state it produced.
go_home() {
  local adb_serial="$1"
  local home
  local state=""
  local press
  local poll

  home="$(guest_home_package "${adb_serial}" || true)"
  for press in 1 2; do
    guest_adb "${adb_serial}" shell input -d 0 keyevent KEYCODE_HOME </dev/null >/dev/null 2>&1 || true
    [[ -n "${home}" ]] || return 0
    for poll in {1..6}; do
      sleep 0.5
      state="$(launcher_state "${adb_serial}" "${home}" || true)"
      [[ -z "${state}" || "${state}" == "Normal" ]] && return 0
    done
  done
  log "home screen still in its ${state} state"
}

# Called by the game session console's supervisor once the session is over.
end_game_session() {
  local adb_serial="$1"
  local package
  local console_was_open

  package="$(read_game_session_value package)"
  console_was_open="$(read_game_session_value console_was_open)"

  # If the game is still in front, background it with the Home key, which
  # pauses and stops it as a phone does (the point where games save their
  # state). It is never force-stopped. A key press rather than a HOME intent:
  # the intent leaves the launcher in its app-transition state, showing the
  # game's snapshot in front of the desktop. Skip this if something else is
  # in front by now, for example after the game quit by itself.
  if [[ -n "${package}" ]] \
      && [[ "$(primary_display_top_package "${adb_serial}" || true)" == "${package}" ]]; then
    go_home "${adb_serial}"
  fi
  clear_game_session
  log "game session for ${package:-unknown} ended"

  # Restored before the session lock is released, so that a game launched
  # meanwhile finds the desktop console open.
  if [[ "${console_was_open}" == "true" ]] && has_live_cvd_processes; then
    log "restoring the desktop console"
    "${IKA_SCRIPT_PATH}" start </dev/null >/dev/null 2>&1 3>&- {game_session_lock_fd}>&- \
      || log "could not restore the desktop console; see ${START_LOG_FILE}"
  fi

}

# Starts PACKAGE in a game session (see above).
start_game_session() {
  local package="$1"
  local label="$2"
  local console_was_open
  local adb_serial
  local component
  local output
  local autostart_lock_fd
  local touch_mode="false"
  local session_touch

  if touch_enabled; then
    touch_mode="true"
  fi
  lock_game_session || die "timed out waiting for another game session to start or end"
  console_was_open="$(desktop_console_was_open)"

  # A game runs in one place only: close its app window if it has one.
  if app_window_is_open "${package}"; then
    stop_supervisor_from_file "$(app_supervisor_file "${package}" pid)" __app_supervisor
  fi

  # The input mode of the session console running now, read before it is
  # overwritten with this game's.
  session_touch="$(read_game_session_value touch)"
  write_game_session "${package}" "${label}" "${console_was_open}" "${touch_mode}"

  # A session console already running in the requested input mode (mouse or
  # touch) is kept, and the new game replaces the current one. Any other
  # console is relaunched as a session console, which inherits IKA_TOUCH.
  if ! game_session_console_running \
      || [[ "${session_touch:-false}" != "${touch_mode}" ]]; then
    notify_progress "Starting ${label}…"
    exec {autostart_lock_fd}>"${CVD_TMP_DIR}/autostart.lock"
    flock -w "$((CVD_BOOT_MAX_SEC + 60))" "${autostart_lock_fd}" \
      || die "timed out waiting for Ika to start"
    IKA_NOTIFY=false "${IKA_SCRIPT_PATH}" start --game --game-session </dev/null >/dev/null 2>&1 \
      {autostart_lock_fd}>&- {game_session_lock_fd}>&- \
      || die "could not start the game session; see ${START_LOG_FILE}"
    exec {autostart_lock_fd}>&-
  fi

  adb_serial="$(resolve_adb_serial)"
  component="$(guest_adb "${adb_serial}" shell cmd package resolve-activity --brief \
    -a android.intent.action.MAIN -c android.intent.category.LAUNCHER "${package}" \
    </dev/null 2>/dev/null | tr -d '\r' | tail -n1)"
  [[ "${component}" == */* ]] || die "${label} has no launcher activity"

  # Launch like the home screen does (an existing task is brought back rather
  # than restarted), on the primary display, forced fullscreen rather than
  # into the desktop's freeform windowing.
  output="$(guest_adb "${adb_serial}" shell am start --display 0 --windowingMode 1 \
    -a android.intent.action.MAIN -c android.intent.category.LAUNCHER \
    -f 0x10200000 -n "${component}" </dev/null 2>&1 | tr -d '\r' || true)"
  if [[ "${output}" == *Error* || "${output}" == *Exception* ]]; then
    die "could not start ${label}: ${output}"
  fi
  unlock_game_session
  close_progress_notifications
  respond "Started ${label} in a game session; leave fullscreen to end it"
}

# Android's mode switch ("Desktop/TV" in the app menu, IkaMode in Android)
# asks whether to switch the whole interface, so it opens on the primary
# display, in the console, rather than in a window of its own.
IKA_MODE_PACKAGE="org.lineageos.desktop.mode"

open_in_console() {
  local package="$1"
  local label="$2"
  local adb_serial
  local component
  local output

  if ! scrcpy_supervisor_pid >/dev/null; then
    IKA_NOTIFY=false "${IKA_SCRIPT_PATH}" start </dev/null >/dev/null 2>&1 3>&- \
      || die "could not open the console; see ${START_LOG_FILE}"
  fi
  adb_serial="$(resolve_adb_serial)"
  component="$(guest_adb "${adb_serial}" shell cmd package resolve-activity --brief \
    -a android.intent.action.MAIN -c android.intent.category.LAUNCHER "${package}" \
    </dev/null 2>/dev/null | tr -d '\r' | tail -n1)"
  [[ "${component}" == */* ]] || die "${label} has no launcher activity"
  output="$(guest_adb "${adb_serial}" shell am start --display 0 \
    -a android.intent.action.MAIN -c android.intent.category.LAUNCHER \
    -f 0x10000000 -n "${component}" </dev/null 2>&1 | tr -d '\r' || true)"
  if [[ "${output}" == *Error* || "${output}" == *Exception* ]]; then
    die "could not start ${label}: ${output}"
  fi
  respond "Opened ${label} in the console"
}

# Starts the VM without its console when it is not running, so that menu
# launchers work while Ika is stopped, then waits for the guest to boot.
ensure_guest_ready() {
  local adb_serial
  local deadline
  local autostart_lock_fd

  # Serialize concurrent launches, so only one of them starts the VM.
  exec {autostart_lock_fd}>"${CVD_TMP_DIR}/autostart.lock"
  flock -w "$((CVD_BOOT_MAX_SEC + 60))" "${autostart_lock_fd}" \
    || die "timed out waiting for Ika to start"
  if ! has_live_cvd_processes; then
    log "Android virtual device not running; starting it without the console"
    notify_progress "Starting Android, one moment..."
    # Close the lock for the child: the VM processes it starts outlive this
    # command and would otherwise hold the lock for as long as the VM runs.
    IKA_NOTIFY=false "${IKA_SCRIPT_PATH}" start --no-console </dev/null >/dev/null 2>&1 \
      {autostart_lock_fd}>&- \
      || die "could not start the Android virtual device; see ${START_LOG_FILE}"
  fi
  exec {autostart_lock_fd}>&-

  adb_serial="$(resolve_adb_serial)"
  deadline="$(make_deadline "${CVD_BOOT_MAX_SEC}")"
  until adb_boot_completed "${adb_serial}"; do
    has_live_cvd_processes || die "the Android virtual device stopped while booting"
    within_deadline "${deadline}" || die "the Android virtual device did not finish booting"
    sleep 1
  done
}

# Filters "LABEL<TAB>PACKAGE" lines on stdin to the apps NAME refers to: an
# exact package or case-insensitive label match, otherwise every label that
# contains NAME case-insensitively.
match_app_name() {
  IKA_APP_NAME="$1" awk -F '\t' '
    BEGIN { name = tolower(ENVIRON["IKA_APP_NAME"]) }
    { labels[NR] = $1; packages[NR] = $2 }
    tolower($1) == name || tolower($2) == name { exact[++n_exact] = NR }
    index(tolower($1), name) { partial[++n_partial] = NR }
    END {
      if (n_exact) {
        for (i = 1; i <= n_exact; i++) print labels[exact[i]] "\t" packages[exact[i]]
      } else {
        for (i = 1; i <= n_partial; i++) print labels[partial[i]] "\t" packages[partial[i]]
      }
    }'
}

# Resolves NAME to exactly one "LABEL<TAB>PACKAGE" line from the LIST of apps,
# or dies naming the candidates when NAME is unknown or ambiguous.
resolve_app_name() {
  local name="$1"
  local list="$2"
  local what="$3"
  local matches
  local count
  local label
  local package

  matches="$(match_app_name "${name}" <<<"${list}")"
  count="$(grep -c . <<<"${matches}" || true)"
  if [[ "${count}" -eq 1 ]]; then
    printf '%s\n' "${matches}"
    return 0
  fi

  if [[ "${count}" -eq 0 ]]; then
    # Menu launchers pass the package of an app that may since have been removed.
    if is_app_package_name "${name}"; then
      die "$(app_display_name "${name}") is not installed in Android; see '${SCRIPT_NAME} app'"
    fi
    die "no ${what} matches '${name}'; see '${SCRIPT_NAME} app'"
  fi
  log "'${name}' matches several ${what}s:"
  while IFS=$'\t' read -r label package; do
    log "  ${label}  (${package})"
  done <<<"${matches}"
  die "use a longer name or the package name"
}

open_app_window() {
  local name="$1"
  local fullscreen_mode="$2"
  local game_mode="$3"
  local title="$4"
  local window_size="$5"
  local window_mode="${6:-false}"
  local package=""
  local label=""
  local resolved
  local adb_serial
  local guest_dpi
  local dpi
  local display_size
  local cuttlefish_display
  local app_icon
  local saved_width=""
  local saved_height=""
  local saved_fullscreen=""
  local attempt
  local -a scrcpy_env=()
  local -a scrcpy_cmd=()

  require_executable "${SCRCPY_BIN}" "console client"
  ensure_guest_ready
  adb_serial="$(resolve_adb_serial)"

  # A package name is used as given (menu launchers pass one); anything else is
  # looked up by label.
  if is_app_package_name "${name}" \
      && app_is_installed "${name}" "${adb_serial}"; then
    package="${name}"
    label="$(app_display_name "${package}")"
    [[ "${label}" != "${package}" ]] || label=""
  else
    resolved="$(resolve_launchable_app "${name}" "${adb_serial}")" || exit 1
    package="${resolved#*$'\t'}"
    label="${resolved%%$'\t'*}"
  fi
  if [[ -z "${title}" ]]; then
    title="${label}"
  fi
  validate_app_package "${package}"
  scrcpy_env=("IKA_APP_PACKAGE=${package}")

  # Before use_app_window_paths, which repoints the supervisor paths from the
  # console to this app's window.
  if [[ "${package}" == "${IKA_MODE_PACKAGE}" ]]; then
    open_in_console "${package}" "${label:-${package}}"
    return 0
  fi
  if [[ "${window_mode}" != "true" ]] && is_game_app "${package}" "${adb_serial}"; then
    start_game_session "${package}" "${label:-${package}}"
    return 0
  fi

  use_app_window_paths "${package}"
  (umask 077 && mkdir -p "${IKA_APPS_DIR}/${package}")
  # Cache the label so the window can later be matched by name.
  if [[ -n "${label}" ]]; then
    printf '%s\n' "${label}" > "${IKA_APPS_DIR}/${package}/title"
  fi

  if supervisor_pid_from_file "${SCRCPY_SUPERVISOR_PID_FILE}" __app_supervisor >/dev/null; then
    respond "${label:-${package}} is already open in its own window"
    return 0
  fi

  if [[ -z "${title}" ]]; then
    title="$(app_window_title "${package}" "${adb_serial}")"
  fi

  if [[ -z "${window_size}" ]]; then
    if read_scrcpy_window_state "${SCRCPY_WINDOW_STATE_FILE}" \
        saved_width saved_height saved_fullscreen; then
      window_size="${saved_width}x${saved_height}"
    else
      window_size="$(default_app_window_size)"
    fi
  fi
  [[ "${window_size}" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]] \
    || die "--size must be WIDTHxHEIGHT (example: 1600x900)"
  window_size="$(clamp_app_window_size "${window_size}")"

  # App windows are desktop windows: at the console's density on the desktop,
  # and in TV mode, where the console runs at the TV density, at the desktop's.
  if [[ "$(guest_ui_mode "${adb_serial}")" == "tv" ]]; then
    dpi="$(resolve_scrcpy_dpi "")"
  else
    guest_dpi="$(guest_display_density "${adb_serial}")"
    [[ "${guest_dpi}" =~ ^[1-9][0-9]*$ ]] || die "could not read the guest display density"
    dpi="${guest_dpi}"
  fi
  display_size="$(app_window_display_size "${window_size}")" \
    || die "could not size the app window display for ${window_size}"

  # The app gets a Cuttlefish display of its own, as large as the host screen;
  # --dpi enables flex resizing: the app is drawn at the window size inside it,
  # as the console is. "+" force-stops the app first so it starts on that
  # display instead of resurfacing an existing task on the desktop. The
  # supervisor removes the display when the window closes.
  cuttlefish_display="$(add_cuttlefish_display \
    "$(app_cuttlefish_display_size "${display_size}")" "${dpi}")" \
    || die "could not add a Cuttlefish display for ${label:-${package}}"
  scrcpy_cmd=(
    "${SCRCPY_BIN}"
    -s "${adb_serial}"
    --cuttlefish-frames-socket="$(resolve_cuttlefish_frames_socket)"
    --cuttlefish-display="${cuttlefish_display}"
    --dpi="${dpi}"
    --start-app="+${package}"
    --window-title="${title}"
    --window-state-file="${SCRCPY_WINDOW_STATE_FILE}"
    --window-width="${window_size%x*}"
    --window-height="${window_size#*x}"
    --mouse-bind=++++:b+++
    --force-adb-forward
    --render-driver=opengl
    --no-audio
  )
  append_scrcpy_input_args scrcpy_cmd "${game_mode}" "app window"
  append_scrcpy_extra_args scrcpy_cmd "app window"

  # A distinct app ID lets the host desktop treat each app as its own window
  # group instead of stacking it under the Ika console.
  append_scrcpy_env scrcpy_env
  scrcpy_env+=("SDL_APP_ID=ika-${package}")
  # Without the app's own icon, the window would set the generic Ika icon,
  # which taskbars prefer over the launcher's.
  app_icon="$(app_menu_icon "${package}")"
  if [[ -f "${app_icon}" ]]; then
    scrcpy_env+=("IKA_WINDOW_ICON=${app_icon}")
  fi
  scrcpy_cmd=(env "${scrcpy_env[@]}" "${scrcpy_cmd[@]}")

  : > "${SCRCPY_LOG_FILE}"
  log "opening ${package} (${window_size}/${dpi}) on Cuttlefish display ${cuttlefish_display} as \"${title}\""
  setsid --fork "${IKA_SCRIPT_PATH}" __app_supervisor "${package}" \
    "${adb_serial}" "${fullscreen_mode}" -- "${scrcpy_cmd[@]}" \
    </dev/null >>"${SCRCPY_LOG_FILE}" 2>&1 3>&- &
  disown || true

  # Return as soon as the supervisor has registered, instead of a fixed wait.
  for attempt in {1..30}; do
    if supervisor_pid_from_file "${SCRCPY_SUPERVISOR_PID_FILE}" __app_supervisor >/dev/null; then
      respond "Opened ${title} in its own window"
      return 0
    fi
    sleep 0.05
  done

  remove_cuttlefish_display "${cuttlefish_display}" || true
  die "could not open a window for ${label:-${title}}; see ${SCRCPY_LOG_FILE}"
}

# Opens Android's App info page for NAME in the Settings app window: the page
# is started on the display of that window, opening the window first if needed.
open_app_info() {
  local name="$1"
  local settings="com.android.settings"
  local adb_serial
  local resolved
  local package
  local label
  local log_file
  local display_id=""
  local deadline
  local output

  require_executable "${SCRCPY_BIN}" "console client"
  ensure_guest_ready
  adb_serial="$(resolve_adb_serial)"

  if is_app_package_name "${name}" \
      && app_is_installed "${name}" "${adb_serial}"; then
    package="${name}"
    label="$(app_display_name "${package}")"
  else
    resolved="$(resolve_launchable_app "${name}" "${adb_serial}")" || exit 1
    package="${resolved#*$'\t'}"
    label="${resolved%%$'\t'*}"
  fi
  validate_app_package "${package}"

  log_file="${IKA_APPS_DIR}/${settings}/window.log"
  if ! app_window_is_open "${settings}"; then
    ( open_app_window "${settings}" false false "" "" ) >/dev/null || exit 1
    # Let Settings finish starting, so that the App info page opens on top.
    deadline="$(make_deadline 20)"
    until [[ -n "${display_id}" ]]; do
      display_id="$(sed -n 's/.*Starting app .* on display \([0-9][0-9]*\)\.\.\..*/\1/p' \
        "${log_file}" 2>/dev/null | tail -n1)"
      [[ -n "${display_id}" ]] && break
      within_deadline "${deadline}" || die "the Settings window did not start"
      sleep 0.5
    done
    sleep 1.5
  else
    display_id="$(sed -n 's/.*Starting app .* on display \([0-9][0-9]*\)\.\.\..*/\1/p' \
      "${log_file}" 2>/dev/null | tail -n1)"
    [[ -n "${display_id}" ]] || die "could not find the Settings window's display"
  fi

  output="$(guest_adb "${adb_serial}" shell am start --display "${display_id}" \
    -a android.settings.APPLICATION_DETAILS_SETTINGS -d "package:${package}" \
    -f 0x10000000 2>&1 | tr -d '\r' || true)"
  if [[ "${output}" == *Error* || "${output}" == *Exception* ]]; then
    die "could not open App info for ${label}: ${output}"
  fi
  respond "Opened App info for ${label}"
}

run_app_supervisor() {
  local package="$1"
  local arg
  local status=0
  shift

  validate_app_package "${package}"
  use_app_window_paths "${package}"
  APP_WINDOW_SUPERVISOR="true"
  for arg in "$@"; do
    if [[ "${arg}" =~ ^--cuttlefish-display=([0-9]+)$ ]]; then
      APP_CUTTLEFISH_DISPLAY="${BASH_REMATCH[1]}"
    fi
  done
  run_scrcpy_supervisor "$@" || status="$?"
  remove_app_cuttlefish_display
  return "${status}"
}

# Removes the Cuttlefish display of the app window this supervisor runs, once.
remove_app_cuttlefish_display() {
  if [[ -n "${APP_CUTTLEFISH_DISPLAY:-}" ]]; then
    remove_cuttlefish_display "${APP_CUTTLEFISH_DISPLAY}" || true
    APP_CUTTLEFISH_DISPLAY=""
  fi
}

app_window_is_open() {
  supervisor_pid_from_file "$(app_supervisor_file "$1" pid)" __app_supervisor >/dev/null
}

# Lists launchable apps sorted by label. Apps already open in their own window
# are shown in bold on a terminal, or marked "(open)" when the output is not a
# terminal or NO_COLOR is set.
list_launchable_apps() {
  local adb_serial
  local -a labels=()
  local -a packages=()
  local label
  local package
  local width=0
  local max_width=40
  local bold=""
  local plain=""
  local i

  require_executable "${SCRCPY_BIN}" "console client"
  has_live_cvd_processes || die "Android virtual device not running; start it with '${SCRIPT_NAME} start'"
  adb_serial="$(resolve_adb_serial)"
  adb_boot_completed "${adb_serial}" || die "Android virtual device has not finished booting"

  while IFS=$'\t' read -r label package; do
    [[ -n "${label}" && -n "${package}" ]] || continue
    labels+=("${label}")
    packages+=("${package}")
    if (( ${#label} > width )); then
      width="${#label}"
    fi
  done < <(list_guest_apps "${adb_serial}" | sort -f -t $'\t' -k1,1 -k2,2)

  if [[ "${#packages[@]}" -eq 0 ]]; then
    die "could not list apps from the Android virtual device"
  fi
  if (( width > max_width )); then
    width="${max_width}"
  fi

  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    bold=$'\e[1m'
    plain=$'\e[0m'
  fi

  for i in "${!packages[@]}"; do
    label="${labels[i]}"
    package="${packages[i]}"
    if app_window_is_open "${package}"; then
      if [[ -n "${bold}" ]]; then
        printf '%s%-*s  %s%s\n' "${bold}" "${width}" "${label}" "${package}" "${plain}"
      else
        printf '%-*s  %s  (open)\n' "${width}" "${label}" "${package}"
      fi
    else
      printf '%-*s  %s\n' "${width}" "${label}" "${package}"
    fi
  done
}

# ============================================================================
# Desktop menu entries for guest apps (ika app sync)
# ============================================================================
#
# Each launchable app gets ~/.local/share/applications/ika-PACKAGE.desktop.
# Its file name matches the app window's Wayland app ID (SDL_APP_ID), so
# GNOME Shell and KWin associate open app windows with their launcher. The
# launchers are grouped as "Android Apps (Ika)": KDE Plasma, XFCE, Cinnamon
# and MATE read a freedesktop menu-merge file, while GNOME Shell, which
# ignores menu files, gets an app-grid folder matching the same category.

IKA_MENU_NAME="Android Apps (Ika)"
IKA_MENU_ID="ika-android-apps"
IKA_MENU_CATEGORY="X-Ika-Android"
IKA_MENU_ICON="ika-scrcpy"
IKA_MENU_ICON_SIZE="192"
IKA_MENU_VERSION="4"

app_menu_icon_dir() {
  printf '%s/icons\n' "${IKA_APPS_DIR}"
}

# Renders every launchable app's icon inside the guest with the IkaAppIcons
# helper in the scrcpy-server jar, and stores them as ICON_DIR/PACKAGE-HASH.png.
# The content hash changes the launcher's Icon path whenever an app's icon
# changes, so desktop icon caches never show a stale one. On success, icons of
# apps that are no longer launchable are removed.
export_app_icons() {
  local adb_serial="$1"
  local icon_dir
  local server_jar="${SCRCPY_SERVER_PATH_OVERRIDE:-${PACKAGED_SCRCPY_SERVER}}"
  local remote_jar="/data/local/tmp/ika-app-icons.jar"
  local remote_dir="/data/local/tmp/ika-app-icons"
  local staging
  local png
  local package
  local hash
  local dest
  local -A keep=()

  if [[ ! -f "${server_jar}" ]]; then
    log "scrcpy-server not found at ${server_jar}; keeping existing app icons"
    return 1
  fi

  icon_dir="$(app_menu_icon_dir)"
  staging="$(mktemp -d "${CVD_TMP_DIR}/app-icons.XXXXXX")"
  if ! guest_adb "${adb_serial}" push -q "${server_jar}" "${remote_jar}" >/dev/null \
      || ! GUEST_ADB_TIMEOUT=60 guest_adb "${adb_serial}" shell \
          "rm -rf ${remote_dir} && CLASSPATH=${remote_jar} app_process / com.genymobile.scrcpy.IkaAppIcons ${remote_dir} ${IKA_MENU_ICON_SIZE}" >/dev/null \
      || ! GUEST_ADB_TIMEOUT=60 guest_adb "${adb_serial}" pull -q "${remote_dir}" "${staging}/icons" >/dev/null; then
    guest_adb "${adb_serial}" shell "rm -rf ${remote_dir} ${remote_jar}" >/dev/null 2>&1 || true
    rm -rf "${staging}"
    log "could not render app icons in the guest; keeping existing app icons"
    return 1
  fi
  guest_adb "${adb_serial}" shell "rm -rf ${remote_dir} ${remote_jar}" >/dev/null 2>&1 || true

  if [[ -f "${staging}/icons/games.list" ]]; then
    mkdir -p "${IKA_APPS_DIR}"
    mv -f "${staging}/icons/games.list" "${APP_GAMES_FILE}"
  fi

  mkdir -p "${icon_dir}"
  for png in "${staging}/icons"/*.png; do
    [[ -f "${png}" ]] || continue
    package="$(basename "${png}" .png)"
    is_app_package_name "${package}" || continue
    is_hidden_app "${package}" && continue
    hash="$(sha256sum < "${png}" | cut -c1-12)"
    dest="${icon_dir}/${package}-${hash}.png"
    if [[ ! -f "${dest}" ]]; then
      mv -f "${png}" "${dest}"
    fi
    keep["${dest}"]=1
  done
  rm -rf "${staging}"

  for png in "${icon_dir}"/*.png; do
    [[ -f "${png}" && -z "${keep[${png}]:-}" ]] && rm -f "${png}"
  done
  return 0
}

# Prints the icon for PACKAGE: its rendered PNG when there is one, otherwise
# the generic Ika icon.
app_menu_icon() {
  local package="$1"
  local -a icons=("$(app_menu_icon_dir)/${package}"-*.png)

  if [[ -f "${icons[0]}" ]]; then
    printf '%s\n' "${icons[0]}"
  else
    printf '%s\n' "${IKA_MENU_ICON}"
  fi
}

app_menu_data_dir() {
  printf '%s\n' "${XDG_DATA_HOME:-${HOME}/.local/share}"
}

app_menu_config_dir() {
  printf '%s\n' "${XDG_CONFIG_HOME:-${HOME}/.config}"
}

# Writes stdin to PATH only when the content differs, so menus that watch
# these directories are not refreshed needlessly.
write_file_if_changed() {
  local path="$1"
  local content

  content="$(cat)"
  if [[ -f "${path}" ]] && [[ "$(<"${path}")" == "${content}" ]]; then
    return 1
  fi
  mkdir -p "$(dirname "${path}")"
  printf '%s\n' "${content}" > "${path}"
}

# Rewrites APP_GAMES_FILE from the guest's game mode service, for the apps in
# LIST (LABEL<TAB>PACKAGE lines). Keeps the old file if the guest can't answer.
refresh_app_games_file() {
  local adb_serial="$1"
  local list="$2"
  local label
  local package
  local packages=""
  local output

  while IFS=$'\t' read -r label package; do
    is_app_package_name "${package}" && packages+=" ${package}"
  done <<<"${list}"
  [[ -n "${packages}" ]] || return 0

  output="$(GUEST_ADB_TIMEOUT=60 guest_adb "${adb_serial}" shell \
    "for p in${packages}; do cmd game list-modes \$p 2>/dev/null | grep -q 'current mode' && echo \$p; done; echo ika-games-done" \
    </dev/null 2>/dev/null)" || return 0
  [[ "${output}" == *ika-games-done* ]] || return 0
  mkdir -p "${IKA_APPS_DIR}"
  grep -v '^ika-games-done' <<<"${output//$'\r'/}" | grep -v '^$' > "${APP_GAMES_FILE}" || true
}

# Prints the launcher's menu name: the app label, marked as a game or an app.
app_launcher_name() {
  local label="$1"
  local package="$2"

  if is_game_app "${package}"; then
    printf '🎮 ∙ %s\n' "${label}"
  else
    printf 'ᗩ ∙ %s\n' "${label}"
  fi
}

# Prints a desktop entry string value as desktop-file-edit writes it: with each
# backslash doubled. Launcher keys are compared in that form.
desktop_entry_escape() {
  printf '%s\n' "${1//\\/\\\\}"
}

# Creates or updates one launcher and returns 1 when it was already current.
# Existing launchers are edited in place, keeping any keys the user added.
write_app_launcher() {
  local apps_dir="$1"
  local label="$2"
  local package="$3"
  local icon="$4"
  local file="${apps_dir}/ika-${package}.desktop"
  local name
  local keywords="${label//;/ };${package};Android;Ika;"
  local settings_icon
  local actions="app-settings;"
  local touch_exec=""

  name="$(app_launcher_name "${label}" "${package}")"
  settings_icon="$(app_menu_icon com.android.settings)"
  # Games also get a "Play with Touch Input" action, for games that ignore the
  # mouse: it starts the game with 'ika app --touch'.
  if is_game_app "${package}"; then
    actions="touch;app-settings;"
    touch_exec="ika app --touch ${package}"
  fi
  if [[ -f "${file}" ]] \
      && grep -qxF "Name=$(desktop_entry_escape "${name}")" "${file}" \
      && grep -qxF "Icon=${icon}" "${file}" \
      && grep -qxF "Actions=${actions}" "${file}" \
      && { [[ -z "${touch_exec}" ]] || grep -qxF "Exec=${touch_exec}" "${file}"; } \
      && grep -qxF "Exec=ika app --info ${package}" "${file}" \
      && grep -qxF "Icon=${settings_icon}" "${file}" \
      && grep -qxF "X-Ika-Package=${package}" "${file}" \
      && grep -qxF "X-Ika-Version=${IKA_MENU_VERSION}" "${file}" \
      && grep -qE "^Categories=(.*;)?${IKA_MENU_CATEGORY}(;|$)" "${file}"; then
    return 1
  fi

  if command -v desktop-file-edit >/dev/null 2>&1; then
    if [[ ! -f "${file}" ]]; then
      printf '[Desktop Entry]\nType=Application\n' > "${file}"
    fi
    # The action groups must exist before desktop-file-edit validates the
    # Actions key.
    set_launcher_touch_action "${file}" "${touch_exec}"
    set_launcher_settings_action "${file}" "${package}" "${settings_icon}"
    desktop-file-edit \
      --set-name="${name}" \
      --set-key=Exec --set-value="ika app ${package}" \
      --set-icon="${icon}" \
      --set-key=Terminal --set-value=false \
      --set-key=StartupWMClass --set-value="ika-${package}" \
      --set-key=Keywords --set-value="${keywords}" \
      --set-key=Actions --set-value="${actions}" \
      --add-category="${IKA_MENU_CATEGORY}" \
      --set-key=X-Ika-Package --set-value="${package}" \
      --set-key=X-Ika-Version --set-value="${IKA_MENU_VERSION}" \
      "${file}"
  else
    cat > "${file}" <<EOF
[Desktop Entry]
Type=Application
Name=$(desktop_entry_escape "${name}")
Exec=ika app ${package}
Icon=${icon}
Terminal=false
StartupWMClass=ika-${package}
Keywords=$(desktop_entry_escape "${keywords}")
Actions=${actions}
Categories=${IKA_MENU_CATEGORY};
X-Ika-Package=${package}
X-Ika-Version=${IKA_MENU_VERSION}
EOF
    set_launcher_touch_action "${file}" "${touch_exec}"
    set_launcher_settings_action "${file}" "${package}" "${settings_icon}"
  fi
}

# Writes the launcher's "Play with Touch Input" action for a game, or removes
# it when TOUCH_EXEC is empty. Like the settings action below, its group is
# replaced without leaving blank lines behind.
set_launcher_touch_action() {
  local file="$1"
  local touch_exec="$2"

  {
    awk '
      /^\[/ { skip = ($0 == "[Desktop Action touch]") }
      skip { next }
      /^[[:space:]]*$/ { blanks = blanks $0 "\n"; next }
      { printf "%s", blanks; blanks = ""; print }' "${file}"
    if [[ -n "${touch_exec}" ]]; then
      printf '\n[Desktop Action touch]\nName=Play with Touch Input\nExec=%s\n' \
        "${touch_exec}"
    fi
  } > "${file}.tmp"
  mv -f "${file}.tmp" "${file}"
}

# Writes the launcher's "App Settings" action, which opens Android's App info
# page for the app. desktop-file-edit only edits the main group, so the action
# group is replaced here, without leaving blank lines behind.
set_launcher_settings_action() {
  local file="$1"
  local package="$2"
  local settings_icon="$3"

  {
    awk '
      /^\[/ { skip = ($0 == "[Desktop Action app-settings]") }
      skip { next }
      /^[[:space:]]*$/ { blanks = blanks $0 "\n"; next }
      { printf "%s", blanks; blanks = ""; print }' "${file}"
    printf '\n[Desktop Action app-settings]\nName=App Settings\nExec=ika app --info %s\nIcon=%s\n' \
      "${package}" "${settings_icon}"
  } > "${file}.tmp"
  mv -f "${file}.tmp" "${file}"
}

# Prints the launchers created by ika, identified by their X-Ika-Version key.
list_app_launchers() {
  local file

  for file in "$(app_menu_data_dir)"/applications/ika-*.desktop; do
    [[ -f "${file}" ]] || continue
    grep -q '^X-Ika-Version=' "${file}" && printf '%s\n' "${file}"
  done
  return 0
}

app_menu_merge_file() {
  printf '%s/menus/applications-merged/%s.menu\n' "$(app_menu_config_dir)" "${IKA_MENU_ID}"
}

app_menu_directory_file() {
  printf '%s/desktop-directories/%s.directory\n' "$(app_menu_data_dir)" "${IKA_MENU_ID}"
}

install_xdg_app_menu() {
  write_file_if_changed "$(app_menu_directory_file)" <<EOF || true
[Desktop Entry]
Type=Directory
Name=${IKA_MENU_NAME}
Icon=${IKA_MENU_ICON}
EOF

  write_file_if_changed "$(app_menu_merge_file)" <<EOF || true
<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>${IKA_MENU_NAME}</Name>
    <Directory>${IKA_MENU_ID}.directory</Directory>
    <Include>
      <Category>${IKA_MENU_CATEGORY}</Category>
    </Include>
  </Menu>
</Menu>
EOF
}

# Prints the desktop session's bus. The app menu watcher and commands run over
# SSH lack DBUS_SESSION_BUS_ADDRESS, so fall back to the user bus socket.
app_menu_session_bus() {
  local socket="${XDG_RUNTIME_DIR:-/run/user/${UID}}/bus"

  if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    printf '%s\n' "${DBUS_SESSION_BUS_ADDRESS}"
  elif [[ -S "${socket}" ]]; then
    printf 'unix:path=%s\n' "${socket}"
  else
    return 1
  fi
}

# GNOME Shell settings are only usable inside a desktop session. grep reads
# the whole schema list: with -q it could exit first, and gsettings' SIGPIPE
# would fail the pipeline under pipefail, skipping the folder setup.
gnome_app_folders_available() {
  [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] || return 1
  command -v gsettings >/dev/null 2>&1 || return 1
  gsettings list-schemas 2>/dev/null | grep -x 'org.gnome.desktop.app-folders' >/dev/null
}

gnome_app_folder_schema() {
  printf 'org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/%s/\n' \
    "${1:-${IKA_MENU_ID}}"
}

# Prints the items of a gsettings string array ("['a', 'b']" or "@as []"), one
# per line. Desktop file IDs contain neither quotes nor commas.
gsettings_strv_items() {
  local value="$1"
  local item
  local -a items=()

  value="${value#@as }"
  value="${value#[}"
  value="${value%]}"
  IFS=',' read -r -a items <<<"${value}"
  for item in "${items[@]+"${items[@]}"}"; do
    item="${item# }"
    item="${item#\'}"
    item="${item%\'}"
    [[ -z "${item}" ]] || printf '%s\n' "${item}"
  done
}

# Formats the lines read from stdin as a gsettings string array.
gsettings_strv() {
  local item
  local value=""

  while IFS= read -r item; do
    [[ -n "${item}" ]] && value+="${value:+, }'${item}'"
  done
  if [[ -n "${value}" ]]; then
    printf '[%s]\n' "${value}"
  else
    printf '@as []\n'
  fi
}

# Prints a folder's string array key without the Ika launchers in it.
gsettings_strv_without_launchers() {
  gsettings_strv_items "$(gsettings get "$1" "$2")" \
    | { grep -v '^ika-.*\.desktop$' || true; }
}

# Creates the GNOME Shell app-grid folder and puts the given launchers
# (desktop file IDs) in it. Matching on the category alone is not enough:
# when an app is installed, GNOME Shell refreshes its folders from the app
# list it had before the install (js/ui/appDisplay.js, AppDisplay._redisplay),
# so a new launcher would appear in the main grid. Listing the launchers in the
# folder's 'apps' key, before they are written, avoids that. Launchers dragged
# out of the folder, or into another folder, are moved back.
install_gnome_app_folder() {
  local bus
  local schema
  local children
  local folder
  local folder_schema
  local current
  local wanted

  bus="$(app_menu_session_bus)" || return 0
  local -x DBUS_SESSION_BUS_ADDRESS="${bus}"
  gnome_app_folders_available || return 0
  schema="$(gnome_app_folder_schema)"

  if [[ "$(gsettings get "${schema}" name)" != "'${IKA_MENU_NAME}'" ]]; then
    gsettings set "${schema}" name "'${IKA_MENU_NAME}'"
  fi
  if [[ "$(gsettings get "${schema}" categories)" != "['${IKA_MENU_CATEGORY}']" ]]; then
    gsettings set "${schema}" categories "['${IKA_MENU_CATEGORY}']"
  fi
  if [[ "$(gsettings get "${schema}" translate)" != "false" ]]; then
    gsettings set "${schema}" translate false
  fi

  children="$(gsettings get org.gnome.desktop.app-folders folder-children)"
  if [[ "${children}" != *"'${IKA_MENU_ID}'"* ]]; then
    if [[ "${children}" == "@as []" || "${children}" == "[]" ]]; then
      children="['${IKA_MENU_ID}']"
    else
      children="${children%]}, '${IKA_MENU_ID}']"
    fi
    gsettings set org.gnome.desktop.app-folders folder-children "${children}"
  fi

  current="$(gsettings_strv_items "$(gsettings get "${schema}" apps)" | gsettings_strv)"
  wanted="$( { gsettings_strv_without_launchers "${schema}" apps; printf '%s\n' "$@"; } \
    | gsettings_strv)"
  if [[ "${wanted}" != "${current}" ]]; then
    gsettings set "${schema}" apps "${wanted}"
  fi
  current="$(gsettings_strv_items "$(gsettings get "${schema}" excluded-apps)" | gsettings_strv)"
  wanted="$(gsettings_strv_without_launchers "${schema}" excluded-apps | gsettings_strv)"
  if [[ "${wanted}" != "${current}" ]]; then
    gsettings set "${schema}" excluded-apps "${wanted}"
  fi

  for folder in $(gsettings_strv_items "${children}"); do
    [[ "${folder}" != "${IKA_MENU_ID}" ]] || continue
    folder_schema="$(gnome_app_folder_schema "${folder}")"
    current="$(gsettings get "${folder_schema}" apps 2>/dev/null)" || continue
    if [[ "${current}" == *"'ika-"*".desktop'"* ]]; then
      gsettings set "${folder_schema}" apps \
        "$(gsettings_strv_without_launchers "${folder_schema}" apps | gsettings_strv)"
    fi
  done
}

remove_gnome_app_folder() {
  local bus
  local children
  local item="'${IKA_MENU_ID}'"

  bus="$(app_menu_session_bus)" || return 0
  local -x DBUS_SESSION_BUS_ADDRESS="${bus}"
  gnome_app_folders_available || return 0

  # Reset the folder's settings while it is still in the app grid, then remove
  # it. GNOME Shell's folder dialog never disconnects from the folder's name
  # setting: changing the name after the folder (and its dialog) is gone makes
  # the shell write to a destroyed label and crash, ending a Wayland session.
  if command -v dconf >/dev/null 2>&1; then
    dconf reset -f "/org/gnome/desktop/app-folders/folders/${IKA_MENU_ID}/"
  else
    gsettings reset-recursively "$(gnome_app_folder_schema)"
  fi

  children="$(gsettings get org.gnome.desktop.app-folders folder-children)"
  if [[ "${children}" == *"${item}"* ]]; then
    children="${children//", ${item}"/}"
    children="${children//"${item}, "/}"
    children="${children//"${item}"/}"
    if [[ "${children}" == "[]" ]]; then
      children="@as []"
    fi
    gsettings set org.gnome.desktop.app-folders folder-children "${children}"
  fi
}

# Rebuilds desktop caches: the MIME cache, and KDE's ksycoca, which Plasma's
# menus read instead of rescanning launcher files.
refresh_app_menu_caches() {
  local kbuildsycoca

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q "$(app_menu_data_dir)/applications" || true
  fi
  for kbuildsycoca in kbuildsycoca6 kbuildsycoca5; do
    if command -v "${kbuildsycoca}" >/dev/null 2>&1; then
      "${kbuildsycoca}" >/dev/null 2>&1 || true
      break
    fi
  done
}

# GNOME Shell keeps an app-grid icon, label included, for as long as its app
# stays installed, so a launcher renamed in place would keep showing its old
# name. Launchers whose name changes are therefore moved out of the
# applications directory until GNOME Shell has dropped them, updated there,
# and moved back as new apps. Prints the number of launchers updated.
refresh_renamed_launchers() {
  local apps_dir="$1"
  local list="$2"
  local label
  local package
  local file
  local parked
  local -a labels=()
  local -a packages=()
  local i

  if ! pgrep -u "${UID}" -x gnome-shell >/dev/null 2>&1; then
    printf '0\n'
    return 0
  fi

  while IFS=$'\t' read -r label package; do
    is_app_package_name "${package}" || continue
    file="${apps_dir}/ika-${package}.desktop"
    if [[ -f "${file}" ]] && grep -q '^X-Ika-Version=' "${file}" \
        && ! grep -qxF "Name=$(desktop_entry_escape "$(app_launcher_name "${label}" "${package}")")" \
          "${file}"; then
      labels+=("${label}")
      packages+=("${package}")
    fi
  done <<<"${list}"

  if [[ "${#packages[@]}" -eq 0 ]]; then
    printf '0\n'
    return 0
  fi

  parked="$(mktemp -d "${CVD_TMP_DIR}/renamed-launchers.XXXXXX")"
  for package in "${packages[@]}"; do
    mv -f "${apps_dir}/ika-${package}.desktop" "${parked}/"
  done
  refresh_app_menu_caches
  # GNOME Shell processes app changes asynchronously and rate-limits them.
  sleep 3
  for i in "${!packages[@]}"; do
    write_app_launcher "${parked}" "${labels[i]}" "${packages[i]}" \
      "$(app_menu_icon "${packages[i]}")" || true
    mv -f "${parked}/ika-${packages[i]}.desktop" "${apps_dir}/"
  done
  rmdir "${parked}" 2>/dev/null || true
  printf '%s\n' "${#packages[@]}"
}

sync_app_menu() {
  local adb_serial
  local apps_dir
  local list
  local label
  local package
  local file
  local updated=0
  local removed=0
  local icons="unchanged"
  local sync_lock_fd
  local -A current=()
  local -a desktop_ids=()

  require_executable "${SCRCPY_BIN}" "console client"
  has_live_cvd_processes || die "Android virtual device not running; start it with '${SCRIPT_NAME} start'"
  adb_serial="$(resolve_adb_serial)"
  adb_boot_completed "${adb_serial}" || die "Android virtual device has not finished booting"

  # The app menu watcher and a manual sync must not write the same files.
  exec {sync_lock_fd}>"${APP_MENU_SYNC_LOCK_FILE}"
  flock -w 120 "${sync_lock_fd}" || die "another app menu sync is still running"

  list="$(list_guest_apps "${adb_serial}")"
  [[ -n "${list}" ]] || die "could not list apps from the Android virtual device"

  if export_app_icons "${adb_serial}"; then
    icons="rendered"
  else
    # The icon helper also lists the games; without it, a game installed since
    # its last run would be named as an app.
    refresh_app_games_file "${adb_serial}" "${list}"
  fi

  apps_dir="$(app_menu_data_dir)/applications"
  mkdir -p "${apps_dir}"
  # Set up the group, with every launcher in it, before any launcher is
  # written: an app whose launcher appears first can end up outside it.
  # Launchers the user hid stay out of the GNOME folder's explicit list.
  while IFS=$'\t' read -r label package; do
    is_app_package_name "${package}" || continue
    file="${apps_dir}/ika-${package}.desktop"
    if [[ ! -f "${file}" ]] || ! grep -qx 'NoDisplay=true' "${file}"; then
      desktop_ids+=("ika-${package}.desktop")
    fi
  done <<<"${list}"
  install_xdg_app_menu
  install_gnome_app_folder "${desktop_ids[@]+"${desktop_ids[@]}"}"

  updated="$(refresh_renamed_launchers "${apps_dir}" "${list}")"
  while IFS=$'\t' read -r label package; do
    is_app_package_name "${package}" || continue
    current["${package}"]=1
    if write_app_launcher "${apps_dir}" "${label}" "${package}" \
        "$(app_menu_icon "${package}")"; then
      updated=$((updated + 1))
    fi
  done <<<"${list}"

  while read -r file; do
    [[ -n "${file}" ]] || continue
    package="$(sed -n 's/^X-Ika-Package=//p' "${file}" | head -n1)"
    if [[ -z "${package}" || -z "${current[${package}]:-}" ]]; then
      rm -f "${file}"
      removed=$((removed + 1))
    fi
  done < <(list_app_launchers)

  refresh_app_menu_caches
  # Release the lock now: a watcher started after this would inherit the
  # descriptor and block on it.
  exec {sync_lock_fd}>&-

  respond "${IKA_MENU_NAME}: ${#current[@]} apps (${updated} added or updated, ${removed} removed, icons ${icons})"
}

remove_app_menu() {
  local file
  local removed=0
  local sync_lock_fd

  exec {sync_lock_fd}>"${APP_MENU_SYNC_LOCK_FILE}"
  flock -w 120 "${sync_lock_fd}" || die "an app menu sync is still running"

  while read -r file; do
    [[ -n "${file}" ]] || continue
    rm -f "${file}"
    removed=$((removed + 1))
  done < <(list_app_launchers)

  rm -f "$(app_menu_merge_file)" "$(app_menu_directory_file)" "${APP_LIST_CACHE}" \
    "${APP_GAMES_FILE}"
  rm -rf "$(app_menu_icon_dir)"
  remove_gnome_app_folder
  refresh_app_menu_caches
  exec {sync_lock_fd}>&-

  respond "Removed ${IKA_MENU_NAME} (${removed} launchers)"
}

# Prints a fingerprint of the guest's enabled packages and their versions,
# which changes whenever an app is installed, updated, removed, enabled or
# disabled.
guest_package_fingerprint() {
  local packages

  packages="$(guest_adb "$1" shell cmd package list packages -e --show-versioncode 2>/dev/null \
    | tr -d '\r' || true)"
  [[ -n "${packages}" ]] || return 1
  sort <<<"${packages}" | sha256sum | cut -c1-16
}

app_menu_watcher_cleanup() {
  if [[ -f "${APP_MENU_WATCHER_PID_FILE}" \
      && "$(<"${APP_MENU_WATCHER_PID_FILE}")" == "$$" ]]; then
    rm -f "${APP_MENU_WATCHER_PID_FILE}"
  fi
}

# Seconds after Android completes a boot before the app menu watcher syncs:
# the app list is served by scrcpy's server in the guest, which cannot connect
# while Android runs its boot-completed work.
APP_MENU_BOOT_GRACE_SEC=10

# Keeps the desktop menu in sync while the VM runs: syncs once the guest has
# booted and settled, then whenever its packages change. Polling one package
# listing costs a few tens of milliseconds and needs nothing running in the
# guest. Exits when the VM stops or the menu is removed with
# 'ika app sync --remove'.
run_app_menu_watcher() {
  local adb_serial
  local fingerprint
  local synced=""
  local booted_at=""
  local watcher_lock_fd

  exec {watcher_lock_fd}>"${APP_MENU_WATCHER_LOCK_FILE}"
  flock -n "${watcher_lock_fd}" || return 0
  printf '%s\n' "$$" > "${APP_MENU_WATCHER_PID_FILE}"
  trap 'exit 0' INT TERM HUP
  trap app_menu_watcher_cleanup EXIT
  # A failed sync is logged and retried, never reported as a notification:
  # the watcher inherits IKA_NOTIFY from the menu launcher's 'ika start', and
  # its failures (a guest that stops answering) are the log's business.
  IKA_NOTIFY=false

  adb_serial="$(resolve_adb_serial)"
  log "app menu watcher started"
  while has_live_cvd_processes && [[ ! -f "${APP_MENU_DISABLED_FILE}" ]]; do
    # The adb calls go without the watcher's lock, like the sync below: one
    # may start the adb server, which would otherwise keep the lock after this
    # watcher exits and stop every later one from starting.
    if ! ( exec {watcher_lock_fd}>&-; adb_boot_completed "${adb_serial}" ); then
      # Not booted, or restarting: a mode switch restarts Android with other
      # packages, and the sync waits for the new boot to settle.
      booted_at=""
    elif [[ -z "${booted_at}" ]]; then
      booted_at="${SECONDS}"
    fi
    if [[ -n "${booted_at}" ]] \
        && (( SECONDS - booted_at >= APP_MENU_BOOT_GRACE_SEC )) \
        && fingerprint="$(exec {watcher_lock_fd}>&-; guest_package_fingerprint "${adb_serial}")" \
        && [[ "${fingerprint}" != "${synced}" ]]; then
      if [[ -n "${synced}" ]]; then
        log "guest packages changed; updating the app menu"
      fi
      # Wait in the background so that a stop request is handled at once
      # instead of after the running command.
      # Without the watcher's lock, which a daemon started during the sync
      # (such as an adb server) would otherwise keep.
      ( exec {watcher_lock_fd}>&-; sync_app_menu ) &
      if wait "$!"; then
        synced="${fingerprint}"
      else
        log "app menu sync failed; retrying in 30s"
        sleep 30 &
        wait "$!"
      fi
    fi
    sleep "${IKA_APP_MENU_POLL_SEC}" &
    wait "$!"
  done
  log "app menu watcher stopped"
}

start_app_menu_watcher() {
  [[ ! -f "${APP_MENU_DISABLED_FILE}" ]] || return 0
  supervisor_pid_from_file "${APP_MENU_WATCHER_PID_FILE}" __app_menu_watcher >/dev/null && return 0

  setsid --fork "${IKA_SCRIPT_PATH}" __app_menu_watcher \
    </dev/null >>"${APP_MENU_LOG_FILE}" 2>&1 3>&- &
  disown || true
}

stop_app_menu_watcher() {
  stop_supervisor_from_file "${APP_MENU_WATCHER_PID_FILE}" __app_menu_watcher
}

android_storage_mounted() {
  findmnt -rn -M "${1:-${ANDROID_STORAGE_DIR}}" >/dev/null 2>&1
}

# Whether 'su' gives root in the guest, as after 'ika root'.
guest_is_rooted() {
  local adb_serial="$1"

  [[ "$(guest_adb "${adb_serial}" shell "su -c 'id -u'" 2>/dev/null | tr -d '\r')" == "0" ]]
}

# Mounts Android's /sdcard on ANDROID_STORAGE_DIR with madbfs, which runs
# madbfs-server from the ROM and goes on in the background. On a rooted ROM
# (ika root) it mounts the whole filesystem, /, with the server run as root.
# Ika's adb comes first on PATH: an adb of another version would restart the
# adb server under the console.
mount_android_storage() {
  local adb_serial="$1"
  local -a root_args=(--root=/sdcard)
  local server_pkill="pkill -x madbfs-server"
  local deadline

  [[ -x "${PACKAGED_MADBFS_BIN}" ]] || return 0
  android_storage_mounted && return 0
  if [[ "${LEGACY_ANDROID_STORAGE_DIR}" != "${ANDROID_STORAGE_DIR}" ]]; then
    unmount_android_storage_at "${LEGACY_ANDROID_STORAGE_DIR}"
  fi
  mkdir -p "${ANDROID_STORAGE_DIR}"
  if guest_is_rooted "${adb_serial}"; then
    root_args=(--root=/ --su)
    server_pkill="su -c '${server_pkill}'"
  else
    # Android mounts /sdcard some seconds after its first frame, when the
    # console opens: 6 s later on a 2-vCPU guest. madbfs gives up at once on a
    # missing root, so wait for it, for up to 30 s.
    deadline=$((SECONDS + 30))
    until guest_adb "${adb_serial}" shell 'test -d /sdcard/' >/dev/null 2>&1 \
        || (( SECONDS >= deadline )); do
      sleep 0.5
    done
    # Another start may have mounted it during the wait.
    android_storage_mounted && return 0
  fi
  # A madbfs that did not exit cleanly leaves its control socket behind, and
  # its server on Android holding the port.
  rm -f "${XDG_RUNTIME_DIR:-/tmp}/madbfs@${adb_serial}.sock"
  guest_adb "${adb_serial}" shell "${server_pkill}" >/dev/null 2>&1 || true
  trim_log_lines "${MADBFS_LOG_FILE}"
  # Files show as the user's, as Android's owners mean nothing on the host and
  # file managers would treat the folders as read-only. File details are
  # re-read after 2 seconds instead of 60, so files Android apps add or change
  # show up promptly.
  if PATH="${CVD_HOST_OUT}/bin:${PATH}" "${PACKAGED_MADBFS_BIN}" --serial="${adb_serial}" \
      "${root_args[@]}" --ttl=2 --log-file="${MADBFS_LOG_FILE}" \
      -o "uid=$(id -u),gid=$(id -g),umask=022" "${ANDROID_STORAGE_DIR}" \
      </dev/null >>"${MADBFS_LOG_FILE}" 2>&1 3>&-; then
    log "Android storage mounted on ${ANDROID_STORAGE_DIR} (${root_args[0]#--root=})"
    edit_android_storage_place add
  else
    log "warning: could not mount Android storage on ${ANDROID_STORAGE_DIR}; see ${MADBFS_LOG_FILE}"
  fi
}

kde_places_file() {
  printf '%s\n' "${XDG_DATA_HOME:-${HOST_HOME}/.local/share}/user-places.xbel"
}

gtk_bookmarks_file() {
  printf '%s\n' "${XDG_CONFIG_HOME:-${HOST_HOME}/.config}/gtk-3.0/bookmarks"
}

# Adds ("add") or removes ("remove") $2, or ANDROID_STORAGE_DIR, named
# "Android", in the file manager's sidebar: Dolphin and GNOME's Files list only
# disks, network shares and mounts in the home folder by themselves. On GNOME
# it goes in GTK's bookmarks. KDE's places file is only edited once it exists:
# creating it would keep KDE from adding its default places. Removing takes the
# entry out of both, whatever the desktop.
edit_android_storage_place() {
  local action="$1"
  local dir="${2:-${ANDROID_STORAGE_DIR}}"
  local places
  local bookmarks
  local kept
  local uri

  uri="$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).as_uri())' \
    "${dir}")" || return 0
  bookmarks="$(gtk_bookmarks_file)"
  if [[ "${action}" == "remove" ]]; then
    if grep -qxF "${uri} Android" "${bookmarks}" 2>/dev/null \
        && kept="$(mktemp "${bookmarks}.XXXXXX")"; then
      # Rewritten in place, keeping the file's mode.
      if grep -vxF "${uri} Android" "${bookmarks}" >"${kept}" || [[ ! -s "${kept}" ]]; then
        cat "${kept}" >"${bookmarks}" || true
      fi
      rm -f "${kept}"
    fi
  elif [[ ":${XDG_CURRENT_DESKTOP:-}:" == *:GNOME:* ]] \
      && ! grep -qxF "${uri} Android" "${bookmarks}" 2>/dev/null; then
    mkdir -p "$(dirname "${bookmarks}")" \
      && printf '%s Android\n' "${uri}" >>"${bookmarks}" || true
  fi

  places="$(kde_places_file)"
  [[ -f "${places}" ]] || return 0
  python3 - "${action}" "${places}" "${uri}" <<'PY' || true
import re
import sys
action, path, uri = sys.argv[1:]
text = open(path, encoding="utf-8").read()
entry_re = re.compile(
    r'[ \t]*<bookmark href="' + re.escape(uri) + r'">.*?</bookmark>\n?', re.DOTALL)
if action == "remove":
    text, count = entry_re.subn("", text)
    if count == 0:
        sys.exit(0)
elif not entry_re.search(text):
    end = text.rindex("</xbel>")
    text = text[:end] + (
        f' <bookmark href="{uri}">\n'
        '  <title>Android</title>\n'
        '  <info>\n'
        '   <metadata owner="http://freedesktop.org">\n'
        '    <bookmark:icon name="smartphone"/>\n'
        '   </metadata>\n'
        '  </info>\n'
        ' </bookmark>\n'
    ) + text[end:]
else:
    sys.exit(0)
with open(path, "w", encoding="utf-8") as f:
    f.write(text)
PY
}

# Unmounts Android's storage from $1: lazily when a program still has a file
# open there, so that does not hold the VM up. madbfs then gets a few seconds to
# write out what it has cached and exit; one kept alive by such a program is
# ended, as the device it serves is going away.
unmount_android_storage_at() {
  local dir="$1"
  local pattern="^${PACKAGED_MADBFS_BIN} .* ${dir}\$"
  local deadline

  if android_storage_mounted "${dir}"; then
    fusermount3 -u "${dir}" >/dev/null 2>&1 \
      || fusermount3 -u -z "${dir}" >/dev/null 2>&1 \
      || log "warning: could not unmount ${dir}"
  fi
  deadline="$(make_deadline 5)"
  while pgrep -f "${pattern}" >/dev/null && within_deadline "${deadline}"; do
    sleep 0.2
  done
  pkill -KILL -f "${pattern}" 2>/dev/null || true
  edit_android_storage_place remove "${dir}"
}

# Also from where an older Ika mounted it, and removes that folder once empty.
unmount_android_storage() {
  unmount_android_storage_at "${ANDROID_STORAGE_DIR}"
  if [[ "${LEGACY_ANDROID_STORAGE_DIR}" != "${ANDROID_STORAGE_DIR}" ]]; then
    unmount_android_storage_at "${LEGACY_ANDROID_STORAGE_DIR}"
    rmdir "${LEGACY_ANDROID_STORAGE_DIR}" 2>/dev/null || true
  fi
}

# Prints "LABEL<TAB>PACKAGE" for each open app window, using the cached title.
list_open_app_windows() {
  local pid_file
  local app_dir
  local package
  local title

  for pid_file in "${CVD_TMP_DIR}"/app-supervisor-*.pid; do
    [[ -f "${pid_file}" ]] || continue
    supervisor_pid_from_file "${pid_file}" __app_supervisor >/dev/null || continue
    package="${pid_file##*/app-supervisor-}"
    package="${package%.pid}"
    app_dir="${IKA_APPS_DIR}/${package}"
    title="${package}"
    if [[ -s "${app_dir}/title" ]]; then
      title="$(<"${app_dir}/title")"
    fi
    printf '%s\t%s\n' "${title}" "${package}"
  done
}

close_app_window() {
  local name="$1"
  local open_windows
  local resolved
  local package

  open_windows="$(list_open_app_windows)"
  if [[ -z "${open_windows}" ]]; then
    respond "No app windows are open"
    return 0
  fi
  resolved="$(resolve_app_name "${name}" "${open_windows}" "open app window")" || exit 1
  package="${resolved#*$'\t'}"
  validate_app_package "${package}"

  stop_supervisor_from_file "$(app_supervisor_file "${package}" pid)" __app_supervisor
  respond "Closed ${resolved%%$'\t'*}"
}

run_app_command() {
  local name=""
  local info_mode="false"
  local window_mode="false"
  local fullscreen_mode="false"
  local game_mode="false"
  local title=""
  local window_size=""

  # Without a terminal (a menu launcher), report errors as notifications.
  if [[ ! -t 0 && ! -t 2 ]]; then
    IKA_NOTIFY="true"
  fi

  case "${1:-}" in
    "")
      list_launchable_apps
      return 0
      ;;
    sync)
      shift
      case "${1:-}" in
        "")
          rm -f "${APP_MENU_DISABLED_FILE}"
          sync_app_menu
          start_app_menu_watcher
          ;;
        --remove)
          : > "${APP_MENU_DISABLED_FILE}"
          stop_app_menu_watcher
          remove_app_menu
          ;;
        *)
          die "usage: ${SCRIPT_NAME} app sync [--remove]"
          ;;
      esac
      return 0
      ;;
    close)
      shift
      [[ $# -gt 0 ]] || die "usage: ${SCRIPT_NAME} app close NAME|PACKAGE|--all"
      if [[ "$1" == "--all" ]]; then
        stop_app_supervisors
        respond "Closed all app windows"
      else
        # Unquoted multi-word labels arrive as separate arguments.
        close_app_window "$*"
      fi
      return 0
      ;;
  esac

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--fullscreen)
        fullscreen_mode="true"
        shift
        ;;
      --game)
        game_mode="true"
        shift
        ;;
      --touch)
        # Read by the console client, which the app window or game session
        # console started below inherits it from.
        export IKA_TOUCH=1
        shift
        ;;
      --info)
        info_mode="true"
        shift
        ;;
      --window)
        window_mode="true"
        shift
        ;;
      --title=*)
        title="${1#*=}"
        shift
        ;;
      --title)
        shift
        [[ $# -gt 0 ]] || die "--title requires a value"
        title="$1"
        shift
        ;;
      --size=*)
        window_size="${1#*=}"
        shift
        ;;
      --size)
        shift
        [[ $# -gt 0 ]] || die "--size requires a value"
        window_size="$1"
        shift
        ;;
      --ika_scrcpy=*)
        IKA_SCRCPY="${1#*=}"
        shift
        ;;
      --ika_scrcpy)
        shift
        [[ $# -gt 0 ]] || die "--ika_scrcpy requires a value"
        IKA_SCRCPY="$1"
        shift
        ;;
      -*)
        die "unknown app option: $1"
        ;;
      *)
        # Unquoted multi-word labels arrive as separate arguments.
        name="${name:+${name} }$1"
        shift
        ;;
    esac
  done

  [[ -n "${name}" ]] || die "usage: ${SCRIPT_NAME} app NAME|PACKAGE [options]"
  if [[ "${info_mode}" == "true" ]]; then
    open_app_info "${name}"
    return 0
  fi
  open_app_window "${name}" "${fullscreen_mode}" "${game_mode}" \
    "${title}" "${window_size}" "${window_mode}"
}

# ============================================================================
# Installing and removing apps (ika install, ika remove)
# ============================================================================

# Prints the package Android installed or updated last, which is the app an
# install has just added or replaced.
last_updated_package() {
  local adb_serial="$1"

  host_adb 30 -s "${adb_serial}" shell \
    "dumpsys package packages | grep -E '^  Package \\[|^    lastUpdateTime='" \
    </dev/null 2>/dev/null \
    | tr -d '\r' \
    | awk '
        /^  Package \[/ {
          package = $0
          sub(/^  Package \[/, "", package)
          sub(/\].*/, "", package)
          next
        }
        /lastUpdateTime=/ {
          updated = $0
          sub(/.*lastUpdateTime=/, "", updated)
          if (updated > newest) {
            newest = updated
            result = package
          }
        }
        END { if (result != "") print result }'
}

run_install_command() {
  local file
  local adb_serial
  local output
  local reason
  local package
  local label
  local failed=0
  local message
  local -a installed=()

  [[ $# -gt 0 ]] || die "usage: ${SCRIPT_NAME} install FILE.apk..."
  # Without a terminal (a file manager's "Ika APK installer"), report progress
  # and errors as notifications.
  if [[ ! -t 0 && ! -t 2 ]]; then
    IKA_NOTIFY="true"
  fi
  for file in "$@"; do
    [[ -f "${file}" ]] || die "${file}: no such file"
  done

  ensure_guest_ready
  adb_serial="$(resolve_adb_serial)"

  for file in "$@"; do
    log "installing ${file}"
    notify_progress "Installing $(basename -- "${file}")…"
    output="$(host_adb "${IKA_INSTALL_TIMEOUT_SEC:-1800}" -s "${adb_serial}" \
      install -r "${file}" </dev/null 2>&1 | tr -d '\r' || true)"
    close_progress_notifications
    if [[ "${output}" != *Success* ]]; then
      reason="$(grep -o 'Failure \[[^]]*\]' <<<"${output}" | head -n1 || true)"
      message="could not install $(basename -- "${file}")${reason:+ (${reason})}"
      log "error: ${message}"
      notify_user "${message}"
      failed=$((failed + 1))
      continue
    fi
    package="$(last_updated_package "${adb_serial}" || true)"
    label=""
    if [[ -n "${package}" ]]; then
      label="$(list_guest_apps "${adb_serial}" \
        | awk -F '\t' -v pkg="${package}" '$2 == pkg { print $1; exit }' || true)"
    fi
    installed+=("${label:-${package:-$(basename -- "${file}")}}")
  done

  if [[ "${#installed[@]}" -eq 1 ]]; then
    message="Installed ${installed[0]}"
  elif [[ "${#installed[@]}" -gt 1 ]]; then
    message="Installed ${#installed[@]} apps: $(printf '%s, ' "${installed[@]}")"
    message="${message%, }"
  fi
  if [[ -n "${message:-}" && "${#installed[@]}" -gt 0 ]]; then
    respond "${message}"
    notify_user "${message}"
  fi
  (( failed == 0 )) || exit 1
}

run_remove_command() {
  local name="$*"
  local adb_serial
  local resolved
  local package
  local label
  local output
  local reason

  [[ -n "${name}" ]] || die "usage: ${SCRIPT_NAME} remove NAME|PACKAGE"
  if [[ ! -t 0 && ! -t 2 ]]; then
    IKA_NOTIFY="true"
  fi

  ensure_guest_ready
  adb_serial="$(resolve_adb_serial)"

  # A package name is used as given; anything else is looked up by label.
  if is_app_package_name "${name}" && app_is_installed "${name}" "${adb_serial}"; then
    package="${name}"
    label="$(app_display_name "${package}")"
  else
    resolved="$(resolve_launchable_app "${name}" "${adb_serial}")" || exit 1
    package="${resolved#*$'\t'}"
    label="${resolved%%$'\t'*}"
  fi
  validate_app_package "${package}"

  if app_window_is_open "${package}"; then
    stop_supervisor_from_file "$(app_supervisor_file "${package}" pid)" __app_supervisor
  fi
  output="$(host_adb 120 -s "${adb_serial}" uninstall "${package}" </dev/null 2>&1 \
    | tr -d '\r' || true)"
  if [[ "${output}" != *Success* ]]; then
    if guest_adb "${adb_serial}" shell pm list packages -s "${package}" </dev/null 2>/dev/null \
        | tr -d '\r' | grep -qxF "package:${package}"; then
      die "${label} comes with Android and cannot be removed"
    fi
    reason="$(grep -o 'Failure \[[^]]*\]' <<<"${output}" | head -n1 || true)"
    die "could not remove ${label}${reason:+ (${reason})}"
  fi

  rm -rf "${IKA_APPS_DIR:?}/${package}"
  respond "Removed ${label}"
  notify_user "Removed ${label}"
}

log_start_context() {
  local launcher_log="$1"
  shift
  local scrcpy_dpi
  local cpu_count
  local memory_mb
  local start_message
  scrcpy_dpi="${SCRCPY_DPI:-unknown}"
  cpu_count="$(start_arg_value "cpus" "${CVD_COMPUTE_DEFAULTS[cpus]}" "$@")"
  memory_mb="$(start_arg_value "memory_mb" "${CVD_COMPUTE_DEFAULTS[memory_mb]}" "$@")"

  start_message="Starting Cuttlefish: ${cpu_count} Cores, ${memory_mb} MB"
  if [[ -n "${CVD_GRAPHICS_DRIVER_MESSAGE}" ]]; then
    start_message+=", ${CVD_GRAPHICS_DRIVER_MESSAGE}"
  fi
  if [[ "${LOWCPU_MODE_ACTIVE}" == "true" ]]; then
    start_message+=", low-CPU mode (${IKA_LOWCPU_REFRESH_RATE_HZ} Hz)"
  fi
  start_message+=" ${scrcpy_dpi} DPI"
  log "${start_message}"
  printf '%s\n' "${start_message}" >&3
  if [[ -n "${CVD_DATA_STORAGE_MESSAGE}" ]]; then
    log "${CVD_DATA_STORAGE_MESSAGE}"
    printf '%s\n' "${CVD_DATA_STORAGE_MESSAGE}" >&3
  fi
  log "HOME=${CVD_HOME_DIR}"
  log "TMPDIR=${CVD_TMP_DIR}"
  log "ANDROID_HOST_OUT=${CVD_HOST_OUT}"
  log "ANDROID_PRODUCT_OUT=${CVD_PRODUCT_OUT}"
  log "gpu_mode=${CVD_GPU_MODE}"
  log "launcher_log=${launcher_log}"
  emit_launch_command "$@"
}

# After a VM stops, its cvdalloc may still be removing the VM's network
# interfaces (cvd-pi-*); a new cvdalloc fails to create them while they exist.
# Gives it time to finish. Interfaces of a VM that was killed, with no cvdalloc
# left to remove them, are removed by the next cvdalloc itself.
wait_for_cvdalloc_teardown() {
  local deadline

  pgrep -u "$(id -u)" -x cvdalloc >/dev/null 2>&1 || return 0
  log "waiting for the previous VM's network interfaces to be removed"
  deadline="$(make_deadline 15)"
  while pgrep -u "$(id -u)" -x cvdalloc >/dev/null 2>&1; do
    if ! within_deadline "${deadline}"; then
      log "warning: cvdalloc of the previous VM is still running; starting anyway"
      return 0
    fi
    sleep 0.5
  done
}

# cvd records each instance group's state in its own database. A VM that stops
# without 'cvd stop' (ika stops it with cvd_internal_stop, and it also exits by
# itself when Android powers off or fails to boot) stays recorded as Running,
# or as Unreachable once cvd fails to reach it, and cvd_internal_start, which
# runs 'cvd create --reuse', then refuses to start it again with "Group is
# already running". 'cvd stop' records it as stopped; disks are kept.
clear_stale_cvd_group() {
  local states

  has_live_cvd_processes && return 0
  states="$(run_with_cvd_env timeout 30 "${CVD_CLI_BIN}" ps 2>/dev/null \
    | awk 'NR > 1 { print $4 }' || true)"
  grep -qxE 'Running|Starting|Stopping|Preparing|Unreachable' <<<"${states}" || return 0
  log_file_only "clearing the state cvd kept for the stopped VM:$(tr '\n' ' ' <<<"${states}")"
  run_with_cvd_env timeout 60 "${CVD_CLI_BIN}" stop --wait_for_launcher=0 >/dev/null 2>&1 \
    || log "warning: cvd stop could not clear the state of the stopped VM"
}

# Whether a cuttlefish_config.json holds a JSON object. An empty file, or one
# cut short, does not.
cvd_config_is_readable() {
  local path="$1"

  [[ -s "${path}" ]] || return 1
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json, sys
with open(sys.argv[1]) as config:
    sys.exit(0 if isinstance(json.load(config), dict) else 1)' "${path}" \
      >/dev/null 2>&1
    return
  fi
  [[ "$(LC_ALL=C tr -d '[:space:]\000' < "${path}" | tail -c 1)" == "}" ]]
}

# A host that crashes or loses power while assemble_cvd writes the VM's
# configuration leaves an empty or truncated cuttlefish_config.json behind:
# the file's size reached the disk, its contents did not. Every start then
# fails in cvd_internal_start, which finds the file, cannot parse it and aborts
# ("Check failed: previous_config"), and 'cvd stop' cannot read it either.
# Removes such files so that assemble_cvd writes them again. The disks stay:
# assemble_cvd keeps overlay.img whenever the OS disk is unchanged, which
# protect_overlay_resume checks before every start.
remove_unreadable_cvd_config() {
  local path

  for path in "${CVD_ASSEMBLY_CONFIG_PATH}" "${CVD_CONFIG_PATH}"; do
    [[ -e "${path}" ]] || continue
    cvd_config_is_readable "${path}" && continue
    log "removing the unreadable VM configuration ${path}, left by an unclean shutdown; it is written again at start"
    rm -f "${path}"
  done
}

start_cvd() {
  local fullscreen_mode="${1:-false}"
  local game_mode="${2:-false}"
  shift 2 || true
  local -a args=()
  local launcher_log
  local adb_serial
  local launcher_pid
  local start_epoch
  local scrcpy_dpi
  local -a cvd_env_args=(env)

  require_executable "${CVD_BIN}" "cvd launcher"
  check_required_groups
  ensure_open_file_limit
  launcher_log="${CVD_LAUNCHER_LOG}"
  adb_serial="$(resolve_adb_serial)"
  start_epoch="$(date +%s)"
  split_start_args args scrcpy_dpi "$@"
  SCRCPY_DPI="${scrcpy_dpi}"

  if has_live_cvd_processes; then
    log "Cuttlefish is already running under ${CVD_HOME_DIR}"
    if [[ "${START_CONSOLE}" == "true" ]]; then
      respond_console "Instance already running, local console will be restarted"
    fi
    respond "Android virtual device running"
    if [[ "${START_CONSOLE}" == "true" ]]; then
      maybe_start_scrcpy "${adb_serial}" "${fullscreen_mode}" "${game_mode}" || true
    else
      ensure_chromium "${adb_serial}"
    fi
    mount_android_storage "${adb_serial}"
    start_app_menu_watcher
    return 0
  fi

  notify_progress "Starting Android, one moment..."
  # A mount left from a VM that stopped by itself points at a device that is
  # gone.
  unmount_android_storage
  wait_for_cvdalloc_teardown
  remove_unreadable_cvd_config
  clear_stale_cvd_group
  record_udmabuf_baseline
  protect_overlay_resume
  trim_adb_server_log

  load_vulkaninfo_summary
  if ! user_supplied_flag "gpu_mode" "$@"; then
    CVD_GPU_DEFAULTS[gpu_mode]="$(default_gpu_mode_for_start)"
  fi
  resolve_lowcpu_mode "$@"

  apply_start_default_args args "$@"
  append_cuttlefish_audio_args args "$@"
  append_data_storage_args args "$@"
  append_serial_number_args args "$@"
  append_arm64_kernel_page_args args "$@"
  append_gfxstream_vulkan_args args "$@"
  append_hw_video_decode_args args "$@"
  append_default_display_arg args "${scrcpy_dpi}" "$@"
  prepare_user_adb_key || return 1
  append_bootconfig_args args
  append_cvd_env_args cvd_env_args

  log_start_context "${launcher_log}" "${args[@]}"

  (
    cd "${CVD_PRODUCT_OUT}"
    exec 3>&-
    # systemd-run --scope runs the command in this process: launcher_pid stays
    # the launcher's.
    exec systemd-run --user --scope --quiet --collect -p Delegate=yes \
      --unit="ika-android-$(date +%s)" -- \
      "${IKA_SCRIPT_PATH}" __launch-in-vcpu-scope \
      "$(start_arg_value "cpus" "${CVD_COMPUTE_DEFAULTS[cpus]}" "$@")" \
      "${cvd_env_args[@]}" "${CVD_BIN}" "${args[@]}"
  ) &
  launcher_pid="$!"
  disown "${launcher_pid}" || true

  log "launcher pid: ${launcher_pid}"

  if ! wait_for_boot "${launcher_log}" "${start_epoch}" "${launcher_pid}"; then
    if [[ -f "${launcher_log}" ]]; then
      tail -n 80 "${launcher_log}" >&2 || true
    fi
    die "Cuttlefish did not reach boot completion"
  fi
  adb_serial="$(resolve_adb_serial)"

  log "Ika console ready"
  # Alongside the console, which they would otherwise hold up.
  {
    disable_guest_bluetooth "${adb_serial}" "$@"
    seed_guest_theme "${adb_serial}"
    apply_lowcpu_mode_guest_settings "${adb_serial}"
  } 3>&- &
  respond "Android virtual device running"
  if [[ "${START_CONSOLE}" == "true" ]]; then
    maybe_start_scrcpy "${adb_serial}" "${fullscreen_mode}" "${game_mode}" || true
  else
    ensure_chromium "${adb_serial}"
  fi
  # In the background, as it waits for Android to mount /sdcard.
  mount_android_storage "${adb_serial}" 3>&- &
  start_app_menu_watcher
  close_progress_notifications
}

stop_cvd_internal() {
  local clear_instance_dirs="${1:-false}"
  shift || true
  local stop_ok="false"
  local adb_serial
  local -a run_with_args=()
  local -a stop_args=()

  normalize_stop_grace_seconds
  # Before the stop, which can clear the config the serial comes from.
  adb_serial="$(resolve_adb_serial)"

  if [[ "${clear_instance_dirs}" == "true" ]]; then
    stop_args+=("--clear_instance_dirs")
  fi
  if ! user_supplied_flag "wait_for_launcher" "$@"; then
    stop_args+=("--wait_for_launcher=${IKA_STOP_GRACE_SEC}")
  fi
  stop_args+=("$@")

  require_executable "${CVD_STOP_BIN}" "cvd stop helper"

  if [[ -f "${CVD_CONFIG_PATH}" ]]; then
    run_with_args+=(--config "${CVD_CONFIG_PATH}")
  fi

  if run_stop_helper "${run_with_args[@]}" "${CVD_STOP_BIN}" "${stop_args[@]}"; then
    stop_ok="true"
  else
    log "primary stop helper returned non-zero"
  fi

  if [[ "${stop_ok}" != "true" ]]; then
    log "retrying stop via $(basename "${CVD_CLI_BIN}") stop"
    run_stop_helper "${CVD_CLI_BIN}" stop "${stop_args[@]}" && stop_ok="true" || true
  fi

  if [[ "${clear_instance_dirs}" == "true" ]]; then
    run_with_cvd_env "${CVD_CLI_BIN}" clear >/dev/null 2>&1 || true
    rm -f "${CHROMIUM_INSTALL_STAMP}"
  fi

  stop_dnsmasq
  cleanup_user_processes
  disconnect_guest_adb "${adb_serial}"
  report_udmabuf_leaks

  if has_live_cvd_processes; then
    die "Cuttlefish processes are still running after stop attempt"
  fi
  clear_stale_cvd_group

  if [[ "${stop_ok}" != "true" ]]; then
    log "stop helper reported no active device; no live Cuttlefish processes remain"
  fi

}

# ============================================================================
# GSF ID (ika gsf)
# ============================================================================
#
# Google may block sign-in on devices that are not Play Protect certified until
# their Google Services Framework (GSF) Android ID is registered on Google's
# uncertified device page. IkaGsfId publishes that ID, in decimal, as
# sys.ika.gsf_android_id once GMS check-in has assigned it. In older images,
# IkaGsfId only finds it on userdebug builds, so when the property is not set
# 'gsf' reads it here from the dump of GMS's GCM service, as IkaGsfId now does.

readonly GSF_REGISTRATION_URL="https://www.google.com/android/uncertified"
readonly GCM_SERVICE="com.google.android.gms/.gcm.GcmService"
ika_ini_default IKA_GSF_ID_TIMEOUT_SEC timeouts gsf_id_timeout_sec 120 uint

# Copies stdin to the desktop clipboard. Returns 1 without a graphical session
# or a clipboard tool. The tools stay in the background to serve the clipboard,
# so their output goes to /dev/null rather than to a pipe a caller may read.
copy_to_clipboard() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
    wl-copy >/dev/null 2>&1
  elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard >/dev/null 2>&1
  elif [[ -n "${DISPLAY:-}" ]] && command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --input >/dev/null 2>&1
  else
    return 1
  fi
}

# Opens a URL in the default browser, detached: xdg-open can wait for a browser
# it starts until the browser exits.
open_in_browser() {
  [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]] || return 1
  command -v xdg-open >/dev/null 2>&1 || return 1
  setsid xdg-open "$1" </dev/null >/dev/null 2>&1 &
}

run_gsf_id_command() {
  local adb_serial
  local deadline
  local gsf_id=""
  local waited="false"

  ensure_guest_ready
  adb_serial="$(resolve_adb_serial)"

  if ! app_is_installed com.google.android.gms "${adb_serial}"; then
    die "this Android image has no Google Play Services, so it has no GSF ID"
  fi

  # GMS check-in assigns the ID shortly after Android first reaches the network.
  deadline="$(make_deadline "${IKA_GSF_ID_TIMEOUT_SEC}")"
  while true; do
    gsf_id="$(guest_adb "${adb_serial}" shell getprop sys.ika.gsf_android_id 2>/dev/null \
      | tr -d '\r' || true)"
    if ! [[ "${gsf_id}" =~ ^[1-9][0-9]*$ ]]; then
      gsf_id="$(guest_adb "${adb_serial}" shell dumpsys activity service "${GCM_SERVICE}" 2>/dev/null \
        | tr -d '\r' | sed -n 's/^[[:space:]]*DeviceID:[[:space:]]*\([0-9]*\).*/\1/p' | head -n1 || true)"
    fi
    [[ "${gsf_id}" =~ ^[1-9][0-9]*$ ]] && break
    within_deadline "${deadline}" \
      || die "Google Play Services has not assigned a GSF ID yet; check that Android is online and try again"
    if [[ "${waited}" != "true" ]]; then
      printf 'Waiting for Google Play Services to assign the GSF ID...\n' >&2
      waited="true"
    fi
    sleep 2
  done

  if printf '%s' "${gsf_id}" | copy_to_clipboard; then
    respond "Copied GSF ID ${gsf_id} to the clipboard."
  else
    respond "GSF ID ${gsf_id}"
  fi
  if open_in_browser "${GSF_REGISTRATION_URL}"; then
    printf 'Paste it on the registration page opened in your browser:\n' >&2
  else
    printf 'Register it on:\n' >&2
  fi
  printf '  %s\n' "${GSF_REGISTRATION_URL}" >&2
  printf "Then wait a few minutes and run '%s restart'.\n" "${SCRIPT_NAME}" >&2
}

# ============================================================================
# Backup (ika backup / ika restore)
# ============================================================================
#
# 'backup' copies what adb can reach: the APKs of the apps the user installed
# (with the installer that installed them), each app's files in
# /sdcard/Android/data and game downloads in /sdcard/Android/obb, the shared
# storage folders, and the user's choices: granted app permissions, special
# app access, default apps, apps the user disabled, the dark theme and a
# curated list of settings. App-private data in /data/data is out of adb's
# reach and left out. Because it holds APKs, files and settings rather than
# disk images, a backup survives 'reset' and ROM updates.

# Backups are named by when they were made, so the latest sorts last.
readonly BACKUP_FILE_GLOB="${CVD_HOME_DIR}/ika-backup-*.tgz"
readonly BACKUP_INFO_FILE="backup-info"
readonly -a BACKUP_STORAGE_DIRS=(DCIM Pictures Download Documents Music Movies Recordings)
# Apps not carried over: Ika installs Chromium on every new device, so a
# backed-up copy would only replace a newer one, and Magisk's app is not
# carried over to the restored device.
readonly -a BACKUP_SKIPPED_PACKAGES=(org.chromium.chrome com.topjohnwu.magisk)
# Special app access saved when an app is allowed it.
readonly -a BACKUP_APP_OPS=(
  SYSTEM_ALERT_WINDOW GET_USAGE_STATS REQUEST_INSTALL_PACKAGES
  MANAGE_EXTERNAL_STORAGE WRITE_SETTINGS SCHEDULE_EXACT_ALARM
)
readonly -a BACKUP_ROLES=(BROWSER HOME ASSISTANT DIALER SMS)
# The user's preferences, as namespace:key. Device state, IDs, timestamps and
# the desktop settings Ika applies at every boot are left out on purpose.
readonly -a BACKUP_SETTINGS=(
  system:font_scale system:time_12_24 system:pointer_speed system:screen_off_timeout
  secure:default_input_method secure:enabled_input_methods
  secure:selected_spell_checker secure:spell_checker_enabled
  secure:show_ime_with_hard_keyboard secure:long_press_timeout
  secure:accessibility_enabled secure:enabled_accessibility_services
  secure:enabled_notification_listeners
  global:window_animation_scale global:transition_animation_scale
  global:animator_duration_scale
)
# Listing and dumping every package is slow on small hosts; copies of large
# games take minutes.
ika_ini_get BACKUP_LIST_ADB_TIMEOUT_SEC timeouts backup_list_timeout_sec 120 uint
ika_ini_get BACKUP_COPY_ADB_TIMEOUT_SEC timeouts backup_copy_timeout_sec 3600 uint
readonly BACKUP_LIST_ADB_TIMEOUT_SEC BACKUP_COPY_ADB_TIMEOUT_SEC

# Prints COUNT with the singular or plural NOUN, e.g. "1 app", "3 apps".
count_noun() {
  if [[ "$1" == 1 ]]; then
    printf '%s %s\n' "$1" "$2"
  else
    printf '%s %s\n' "$1" "$3"
  fi
}

backup_adb() {
  local adb_serial="$1"
  shift
  host_adb "${BACKUP_COPY_ADB_TIMEOUT_SEC}" -s "${adb_serial}" "$@"
}

# Prints WORD quoted for a POSIX shell.
shell_quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

# True when PATH is a non-empty directory on the device.
guest_dir_has_files() {
  local adb_serial="$1"
  local path="$2"

  [[ -n "$(guest_adb "${adb_serial}" shell "ls -A '${path}' 2>/dev/null" | tr -d '\r')" ]]
}

# Appends the device path PARENT/NAME to ARCHIVE as PREFIX/NAME: the device's
# tar streams it, renaming as it goes, and pigz adds it as one more gzip
# member. Files an app keeps readable only to itself are skipped, each
# reported; on any other error ARCHIVE is cut back to where it was and the
# copy fails. Adds the files copied, other than APKs, to BACKUP_FILE_COUNT.
append_guest_path() {
  local adb_serial="$1"
  local archive="$2"
  local prefix="$3"
  local parent="$4"
  local name="$5"
  local remote_err="/data/local/tmp/ika-backup-tar.err"
  local size
  local errors=""
  local skipped

  size="$(stat -c '%s' -- "${archive}")"
  if backup_adb "${adb_serial}" exec-out \
      "tar -cvf - -C '${parent}' --xform 's,^,${prefix}/,' '${name}' 2>${remote_err}; echo \"exit \$?\" >>${remote_err}" \
      </dev/null | pigz -1 >>"${archive}"; then
    errors="$(guest_adb "${adb_serial}" shell "cat ${remote_err}; rm -f ${remote_err}" \
      </dev/null | tr -d '\r')" || errors=""
  fi
  # The device's tar lists what it copied, then its exit status: 1 when it
  # skipped files, saying why.
  if ! grep -qx 'exit [01]' <<<"${errors}" \
      || grep -v -e "^${prefix}/" -e ": Permission denied$" -e "^tar: had errors$" \
        -e "^exit [01]$" <<<"${errors}" | grep -q .; then
    truncate -s "${size}" -- "${archive}"
    return 1
  fi
  while IFS= read -r skipped; do
    log "skipping ${parent}/${skipped}"
  done < <(sed -n "s/^tar: can't open '\(.*\)': Permission denied$/\1/p" <<<"${errors}")
  [[ "${prefix}" == apps/* || "${prefix}" == libs/* ]] \
    || BACKUP_FILE_COUNT=$((BACKUP_FILE_COUNT + $(grep -c "^${prefix}/.*[^/]$" <<<"${errors}" || true)))
}

# Appends DIR/NAME, written on the host, to ARCHIVE as NAME.
append_host_path() {
  local archive="$1"
  local dir="$2"
  local name="$3"

  tar -cf - -C "${dir}" "${name}" | pigz -1 >>"${archive}"
}

# Removes the temporary folder and archive of a backup or restore, however the
# command ends.
cleanup_backup_temp() {
  [[ -n "${BACKUP_STAGING_DIR:-}" ]] && rm -rf -- "${BACKUP_STAGING_DIR}"
  [[ -n "${BACKUP_ARCHIVE_TMP:-}" ]] && rm -f -- "${BACKUP_ARCHIVE_TMP}"
  return 0
}

# Prints the device's package dump: every package's state, permissions and the
# libraries it uses.
guest_package_dump() {
  local adb_serial="$1"
  local dump

  dump="$(GUEST_ADB_TIMEOUT="${BACKUP_LIST_ADB_TIMEOUT_SEC}" guest_adb "${adb_serial}" \
    shell dumpsys package packages | tr -d '\r')" || return 1
  [[ "${dump}" == *"Package ["* ]] || return 1
  printf '%s\n' "${dump}"
}

# Prints "LIBRARY<TAB>CODE_PATH" for each static shared library the packages
# in APPS (space-separated) use, from DUMP, the output of guest_package_dump.
# Android keeps such a library, Trichrome's for Chrome, as the package
# NAME_VERSION, which 'pm list packages' leaves out, and refuses to install an
# app without it.
static_libraries_used() {
  local dump="$1"
  local apps="$2"

  awk -v apps=" ${apps} " '
    /^Hidden system packages:/ { exit }
    /^  Package \[/ { pkg = $2; gsub(/[][]/, "", pkg); libs = 0; next }
    /^    codePath=/ { path[pkg] = $0; sub(/^ *codePath=/, "", path[pkg]); next }
    /^    usesStaticLibraries:/ { libs = index(apps, " " pkg " "); next }
    libs && /^      [^ ]+ version:[0-9]+$/ {
      version = $2; sub(/^version:/, "", version); used[$1 "_" version] = 1; next
    }
    { libs = 0 }
    END { for (lib in used) if (lib in path) print lib "\t" path[lib] }
  ' <<<"${dump}" | sort
}

# Writes the user's Android choices into DEST: runtime permissions granted to
# the backed-up apps (any) and to built-in apps (only those the user set),
# special app access, default apps, apps the user disabled, the dark theme and
# BACKUP_SETTINGS. APPS lists the backed-up packages, space-separated; DUMP is
# the output of guest_package_dump.
backup_device_settings() {
  local adb_serial="$1"
  local dest="$2"
  local apps="$3"
  local dump="$4"
  local op
  local pkg
  local role
  local entry
  local value

  mkdir -p "${dest}"

  awk -v apps=" ${apps} " '
    /^  Package \[/ { pkg = $2; gsub(/[][]/, "", pkg); runtime = 0; next }
    /runtime permissions:/ { runtime = 1; next }
    runtime && /^ +[A-Za-z0-9_.]+: granted=/ {
      perm = $1; sub(/:$/, "", perm)
      if ($0 !~ /granted=true/ || $0 ~ /SYSTEM_FIXED|POLICY_FIXED/) next
      if (index(apps, " " pkg " ") || $0 ~ /USER_SET/) print pkg "\t" perm
      next
    }
    runtime { runtime = 0 }
  ' <<<"${dump}" | sort -u > "${dest}/permissions.tsv"

  # Only what the user disabled (enabled=3); packages the ROM ships disabled
  # are left to the ROM.
  awk '
    /^  Package \[/ { pkg = $2; gsub(/[][]/, "", pkg); next }
    /^    User 0: / && / enabled=3 / { print pkg }
  ' <<<"${dump}" | sort -u > "${dest}/disabled.txt"

  : > "${dest}/appops.tsv"
  for op in "${BACKUP_APP_OPS[@]}"; do
    while IFS= read -r pkg; do
      [[ "${pkg}" =~ ^[A-Za-z0-9_.]+$ ]] && printf '%s\t%s\n' "${pkg}" "${op}"
    done < <(guest_adb "${adb_serial}" shell appops query-op "${op}" allow 2>/dev/null | tr -d '\r')
  done >> "${dest}/appops.tsv"

  : > "${dest}/roles.tsv"
  for role in "${BACKUP_ROLES[@]}"; do
    while IFS= read -r pkg; do
      [[ "${pkg}" =~ ^[A-Za-z0-9_.]+$ ]] && printf 'android.app.role.%s\t%s\n' "${role}" "${pkg}"
    done < <(guest_adb "${adb_serial}" shell cmd role get-role-holders "android.app.role.${role}" \
      2>/dev/null | tr -d '\r' | tr ';' '\n')
  done >> "${dest}/roles.tsv"

  guest_adb "${adb_serial}" shell cmd uimode night 2>/dev/null | tr -d '\r' \
    | sed -n 's/^Night mode: //p' > "${dest}/night-mode"

  : > "${dest}/settings.tsv"
  for entry in "${BACKUP_SETTINGS[@]}"; do
    value="$(guest_adb "${adb_serial}" shell settings get "${entry%%:*}" "${entry#*:}" | tr -d '\r')"
    [[ -n "${value}" && "${value}" != "null" ]] || continue
    printf '%s\t%s\t%s\n' "${entry%%:*}" "${entry#*:}" "${value}"
  done >> "${dest}/settings.tsv"
}

# Applies the choices saved by backup_device_settings from SRC in one adb
# shell: the commands go to a script on the device, so every value is quoted
# once and there is no round trip per entry. Entries for apps that are not
# installed, or that Android refuses, are skipped.
restore_device_settings() {
  local adb_serial="$1"
  local src="$2"
  local script
  local remote_script="/data/local/tmp/ika-restore-settings.sh"
  local pkg
  local perm
  local op
  local role
  local namespace
  local key
  local value
  local night=""

  script="${BACKUP_STAGING_DIR}/restore-settings.sh"
  {
    while IFS=$'\t' read -r role pkg; do
      printf 'cmd role add-role-holder %s %s\n' "$(shell_quote "${role}")" "$(shell_quote "${pkg}")"
    done < "${src}/roles.tsv"
    while IFS=$'\t' read -r pkg perm; do
      printf 'pm grant %s %s\n' "$(shell_quote "${pkg}")" "$(shell_quote "${perm}")"
    done < "${src}/permissions.tsv"
    while IFS=$'\t' read -r pkg op; do
      printf 'appops set %s %s allow\n' "$(shell_quote "${pkg}")" "$(shell_quote "${op}")"
    done < "${src}/appops.tsv"
    while IFS= read -r pkg; do
      printf 'pm disable-user --user 0 %s\n' "$(shell_quote "${pkg}")"
    done < "${src}/disabled.txt"
    while IFS=$'\t' read -r namespace key value; do
      printf 'settings put %s %s %s\n' \
        "$(shell_quote "${namespace}")" "$(shell_quote "${key}")" "$(shell_quote "${value}")"
    done < "${src}/settings.tsv"
    IFS= read -r night < "${src}/night-mode" || true
    case "${night}" in
      yes|no|auto) printf 'cmd uimode night %s\n' "${night}" ;;
    esac
  } | sed 's/$/ >\/dev\/null 2>\&1/' > "${script}"

  guest_adb "${adb_serial}" push "${script}" "${remote_script}" >/dev/null 2>&1 \
    && backup_adb "${adb_serial}" shell "sh ${remote_script}; rm -f ${remote_script}" >/dev/null 2>&1 \
    || log "warning: could not restore permissions and settings"
}

run_backup_command() {
  local file="${1:-${CVD_HOME_DIR}/ika-backup-$(date +%Y%m%d%H%M%S).tgz}"
  local adb_serial
  local staging
  local archive
  local listing
  local dump
  local pkg
  local installer
  local apk
  local area
  local name
  local lib
  local path
  local backed_up=0
  local -a apks=()
  local -a saved=()

  ensure_guest_ready
  adb_serial="$(resolve_adb_serial)"

  listing="$(GUEST_ADB_TIMEOUT="${BACKUP_LIST_ADB_TIMEOUT_SEC}" guest_adb "${adb_serial}" \
    shell pm list packages -3 -i | tr -d '\r')" \
    || die "could not list the installed apps"

  # Everything streams straight into the archive, one gzip member per piece,
  # each holding a tar stream; only the small files written here are staged.
  # The archive gets its name once it is complete.
  BACKUP_STAGING_DIR="$(mktemp -d "${CVD_TMP_DIR}/ika-backup.XXXXXX")"
  BACKUP_ARCHIVE_TMP="${file}.partial"
  trap cleanup_backup_temp EXIT
  staging="${BACKUP_STAGING_DIR}"
  archive="${BACKUP_ARCHIVE_TMP}"
  BACKUP_FILE_COUNT=0

  # BACKUP_INFO_FILE first, so the archive identifies itself at its start.
  {
    printf 'created\t%s\n' "$(date -Is)"
    printf 'build\t%s\n' "$(guest_adb "${adb_serial}" shell getprop ro.build.fingerprint | tr -d '\r')"
  } > "${staging}/${BACKUP_INFO_FILE}"
  : > "${archive}"
  append_host_path "${archive}" "${staging}" "${BACKUP_INFO_FILE}"

  while read -r pkg installer; do
    pkg="${pkg#package:}"
    installer="${installer#installer=}"
    [[ " ${BACKUP_SKIPPED_PACKAGES[*]} " == *" ${pkg} "* ]] && continue
    log "backing up ${pkg}"
    mapfile -t apks < <(guest_adb "${adb_serial}" shell pm path "${pkg}" </dev/null \
      | tr -d '\r' | sed -n 's/^package://p')
    (( ${#apks[@]} > 0 )) || die "could not find the APKs of ${pkg}"
    for apk in "${apks[@]}"; do
      append_guest_path "${adb_serial}" "${archive}" "apps/${pkg}" "${apk%/*}" "${apk##*/}" \
        || die "could not copy ${pkg}"
    done
    if [[ "${installer}" != "null" ]]; then
      mkdir -p "${staging}/apps/${pkg}"
      printf '%s\n' "${installer}" > "${staging}/apps/${pkg}/installer"
      append_host_path "${archive}" "${staging}" "apps/${pkg}/installer"
    fi
    for area in data obb; do
      guest_dir_has_files "${adb_serial}" "/sdcard/Android/${area}/${pkg}" </dev/null || continue
      # A running app may be writing these files; stop it so they are copied
      # whole.
      guest_adb "${adb_serial}" shell am force-stop "${pkg}" </dev/null >/dev/null 2>&1 || true
      append_guest_path "${adb_serial}" "${archive}" "${area}" "/sdcard/Android/${area}" "${pkg}" \
        && continue
      # An app's own files are a nice-to-have: the app recreates them. Game
      # downloads in obb are large to fetch again.
      [[ "${area}" == data ]] || die "could not copy /sdcard/Android/${area}/${pkg}"
      log "skipping /sdcard/Android/data/${pkg}"
    done
    saved+=("${pkg}")
    backed_up=$((backed_up + 1))
  done <<<"$(sort <<<"${listing}")"

  dump="$(guest_package_dump "${adb_serial}")" \
    || die "could not read the installed packages"

  # Saved apart from the apps, as libs/LIBRARY, so a restore installs them
  # first.
  while IFS=$'\t' read -r lib path; do
    [[ -n "${lib}" ]] || continue
    log "backing up ${lib}"
    mapfile -t apks < <(guest_adb "${adb_serial}" shell "ls $(shell_quote "${path}")" </dev/null \
      | tr -d '\r' | grep '\.apk$')
    (( ${#apks[@]} > 0 )) || die "could not find the APKs of ${lib}"
    for apk in "${apks[@]}"; do
      append_guest_path "${adb_serial}" "${archive}" "libs/${lib}" "${path}" "${apk}" \
        || die "could not copy ${lib}"
    done
  done <<<"$(static_libraries_used "${dump}" "${saved[*]}")"

  for name in "${BACKUP_STORAGE_DIRS[@]}"; do
    guest_dir_has_files "${adb_serial}" "/sdcard/${name}" || continue
    log "backing up /sdcard/${name}"
    append_guest_path "${adb_serial}" "${archive}" storage /sdcard "${name}" \
      || die "could not copy /sdcard/${name}"
  done

  log "backing up permissions and settings"
  backup_device_settings "${adb_serial}" "${staging}/settings" "${saved[*]}" "${dump}" \
    || die "could not read the permissions and settings"
  append_host_path "${archive}" "${staging}" settings

  mv -f -- "${archive}" "${file}"
  BACKUP_ARCHIVE_TMP=""

  respond "Backed up $(count_noun "${backed_up}" app apps) and $(count_noun "${BACKUP_FILE_COUNT}" file files) to ${file}."
}

run_restore_command() {
  local source="${1:-}"
  local dir
  local files
  local adb_serial
  local pkg_dir
  local pkg
  local lib_dir
  local lib
  local installer
  local area
  local src
  local installed=0
  local -a install_args=()

  if [[ -z "${source}" ]]; then
    source="$(ls -1 ${BACKUP_FILE_GLOB} 2>/dev/null | tail -n1)" || true
    [[ -n "${source}" ]] || die "no backup in ${CVD_HOME_DIR}; create one with '${SCRIPT_NAME} backup'"
  fi
  confirm "This will restore ${source}, replacing the apps, files and settings it holds on your Android virtual device" \
    "Restore aborted." || exit 1

  BACKUP_STAGING_DIR="$(mktemp -d "${CVD_TMP_DIR}/ika-restore.XXXXXX")"
  trap cleanup_backup_temp EXIT
  dir="${BACKUP_STAGING_DIR}"
  log "unpacking ${source}"
  # --ignore-zeros reads on past the end of each tar stream in the archive.
  tar -xizf "${source}" -C "${dir}" && [[ -f "${dir}/${BACKUP_INFO_FILE}" ]] \
    || die "${source} is not an Ika backup"
  # A backup has only the folders it found files for.
  files="$( { find "${dir}/data" "${dir}/obb" "${dir}/storage" -type f 2>/dev/null || true; } | wc -l)"

  ensure_guest_ready
  adb_serial="$(resolve_adb_serial)"

  # The static libraries first: Android refuses an app whose library is
  # missing. Backups made before these were saved have none.
  for lib_dir in "${dir}"/libs/*/; do
    [[ -d "${lib_dir}" ]] || continue
    lib="$(basename -- "${lib_dir}")"
    log "installing ${lib}"
    backup_adb "${adb_serial}" install-multiple -r "${lib_dir}"*.apk >/dev/null 2>&1 \
      || log "warning: could not install ${lib}"
  done

  for pkg_dir in "${dir}"/apps/*/; do
    [[ -d "${pkg_dir}" ]] || continue
    pkg="$(basename -- "${pkg_dir}")"
    # Keep the app's installer, so the store that installed it keeps updating it.
    install_args=(-r)
    installer=""
    [[ -f "${pkg_dir}installer" ]] && IFS= read -r installer < "${pkg_dir}installer"
    if [[ -n "${installer}" ]] && app_is_installed "${installer}" "${adb_serial}"; then
      install_args+=(-i "${installer}")
    fi
    log "installing ${pkg}"
    if backup_adb "${adb_serial}" install-multiple "${install_args[@]}" "${pkg_dir}"*.apk >/dev/null 2>&1; then
      installed=$((installed + 1))
    else
      log "warning: could not install ${pkg}"
    fi
  done

  # After the apps are installed, so their folders already exist.
  for area in data obb; do
    for src in "${dir}/${area}"/*/; do
      [[ -d "${src}" ]] || continue
      backup_adb "${adb_serial}" push "${src%/}" "/sdcard/Android/${area}/" >/dev/null 2>&1 \
        || log "warning: could not restore /sdcard/Android/${area}/$(basename -- "${src}")"
    done
  done
  for src in "${dir}/storage"/*/; do
    [[ -d "${src}" ]] || continue
    log "restoring /sdcard/$(basename -- "${src}")"
    backup_adb "${adb_serial}" push "${src%/}" /sdcard/ >/dev/null 2>&1 \
      || log "warning: could not restore /sdcard/$(basename -- "${src}")"
  done
  log "restoring permissions and settings"
  restore_device_settings "${adb_serial}" "${dir}/settings"
  # Let Gallery and other media apps see the restored files.
  guest_adb "${adb_serial}" shell content call --uri content://media --method scan_volume \
    --arg external_primary >/dev/null 2>&1 || true

  respond "Restored $(count_noun "${installed}" app apps) and $(count_noun "${files}" file files) from ${source}."
}

exec_start_command() {
  local fullscreen_mode="$1"
  local game_mode="$2"
  shift 2
  local -a mode_args=()

  if [[ "${game_mode}" == "true" ]]; then
    mode_args+=(--game)
  elif [[ "${fullscreen_mode}" == "true" ]]; then
    mode_args+=(--fullscreen)
  fi
  if [[ "${START_CONSOLE}" != "true" ]]; then
    mode_args+=(--no-console)
  fi

  exec "$0" start "${mode_args[@]}" "$@"
}

main() {
  local command="${1:-help}"
  local fullscreen_mode
  local game_mode
  local reset_data_gb
  local -a reset_args
  local -a start_args

  ika_ini_warn_unknown

  case "${command}" in
    __launch-in-vcpu-scope)
      shift
      launch_in_vcpu_scope "$@"
      ;;
    start)
      CONSOLE_FAILURE_MESSAGE="Startup Failed."
      shift
      start_args=()
      START_KEEPS_RUNNING_VM="true"
      parse_start_options fullscreen_mode game_mode start_args "$@"
      if [[ "${START_GAME_SESSION}" != "true" ]]; then
        clear_game_session
      fi
      # --no-console leaves an existing console window alone.
      if [[ "${START_CONSOLE}" == "true" ]]; then
        stop_startup_packaged_scrcpy console
      fi
      redirect_start_logs
      run_timed_operation "started" start_cvd "${fullscreen_mode}" "${game_mode}" "${start_args[@]}"
      ;;
    stop)
      shift
      stop_startup_packaged_scrcpy
      stop_app_menu_watcher
      unmount_android_storage
      clear_game_session
      if ! has_live_cvd_processes; then
        stop_dnsmasq
        report_udmabuf_leaks
        clear_stale_cvd_group
        respond "Android virtual device not running"
        return 0
      fi
      stop_cvd_internal false "$@"
      respond "Android virtual device stopped"
      ;;
    reset)
      shift
      stop_startup_packaged_scrcpy console
      reset_args=()
      parse_reset_options reset_data_gb reset_args "$@"
      confirm 'This will "Factory Reset" your Android virtual device' "Reset aborted." \
        || exit 1
      # Only once confirmed: an aborted reset leaves app windows, the menu
      # watcher and a game session alone.
      stop_startup_packaged_scrcpy
      stop_app_menu_watcher
      unmount_android_storage
      clear_game_session
      stop_cvd_internal true "${reset_args[@]}"
      save_data_gb_configuration "${reset_data_gb}"
      # A factory reset removes the installed apps. The menu is rebuilt from
      # the reset device on the next start unless it was turned off.
      remove_app_menu
      ;;
    restart)
      shift
      start_args=()
      # Before stopping anything: a bad option (or --camera finding no camera)
      # must leave the running VM and its console as they are
      parse_start_options fullscreen_mode game_mode start_args "$@"
      stop_startup_packaged_scrcpy
      stop_app_menu_watcher
      unmount_android_storage
      clear_game_session
      protect_overlay_resume
      if has_live_cvd_processes; then
        stop_cvd_internal false
        sleep 0.5
      else
        stop_dnsmasq
        respond "Android virtual device not running"
      fi
      exec_start_command "${fullscreen_mode}" "${game_mode}" "${start_args[@]}"
      ;;
    status)
      if has_live_cvd_processes; then
        respond "Android virtual device running."
      else
        respond "Android virtual device not running."
      fi
      ;;
    app)
      shift
      run_app_command "$@"
      ;;
    gsf)
      run_gsf_id_command
      ;;
    install)
      shift
      run_install_command "$@"
      ;;
    remove)
      shift
      run_remove_command "$@"
      ;;
    backup)
      shift
      (( $# <= 1 )) || die "usage: ${SCRIPT_NAME} backup [FILE]"
      run_backup_command "$@"
      ;;
    restore)
      shift
      (( $# <= 1 )) || die "usage: ${SCRIPT_NAME} restore [FILE]"
      run_restore_command "$@"
      ;;
    root)
      shift
      require_executable "${PACKAGED_IKA_ROOT_BIN}" "ika-root"
      exec "${PACKAGED_IKA_ROOT_BIN}" "$@"
      ;;
    __console_supervisor)
      shift
      run_scrcpy_supervisor "$@"
      ;;
    __app_supervisor)
      shift
      run_app_supervisor "$@"
      ;;
    __app_menu_watcher)
      run_app_menu_watcher
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
