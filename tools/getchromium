#!/usr/bin/python3
import subprocess
import requests
import zipfile
import io
import os
import glob
import re
import sys
import time
import xml.etree.ElementTree as ET

STORAGE_URL = "https://commondatastorage.googleapis.com/chromium-browser-snapshots"
# The browser APK (~0.4 GB) is cached on disk, in the user's cache directory.
DOWNLOAD_CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "ika",
    "chromium",
)
DOWNLOAD_CHUNK_BYTES = 1024 * 1024
DOWNLOAD_PROGRESS_DOT_PERCENT = 20
DOWNLOAD_PROGRESS_UNKNOWN_CHUNKS = 2
ARCH_DETECT_ATTEMPTS = 10
ARCH_DETECT_RETRY_SECONDS = 0.5
INSTALLED_CHECK_ATTEMPTS = 10
INSTALLED_CHECK_RETRY_SECONDS = 0.5
CHROME_PACKAGE = "org.chromium.chrome"
CHROME_COMMAND_LINE_FILES = (
    "/data/local/chrome-command-line",
    "/data/local/tmp/chrome-command-line",
)
CHROMIUM_STAMP = os.environ.get("IKA_CHROMIUM_STAMP", "")
# Without hardware Vulkan, Android-desktop Chromium has no OpenGL fallback unless
# SkipVulkanBlocklist is off, and its GPU process aborts at startup.
NO_HARDWARE_VULKAN_CHROMIUM_FLAGS = (
    "_ --disable-features=SkipVulkanBlocklist,DefaultANGLEVulkan,VulkanFromANGLE,SkiaGraphite"
)
LLVMPIPE_DRIVER_RE = re.compile(r"^\s*driverName\s*=\s*llvmpipe\b", re.MULTILINE)
VULKANINFO_TIMEOUT_SECONDS = 30
BROWSER_APK_PRIORITY = (
    "Chromium.apk",
    "ChromePublic.apk",
    "MonochromePublic.apk",
)
BROWSER_APK_NAME_MARKERS = ("Chromium", "Chrome", "Monochrome")
EXCLUDED_APK_NAME_MARKERS = ("ContentShell", "Test", "Instrumentation", "WebView")
STOCK_BROWSER_PACKAGES = (
    "org.lineageos.jelly",
    "com.android.browser",
    "org.chromium.content_shell_apk",
    "org.chromium.webview_shell",
)
UI_DUMP_PATH = "/sdcard/chromium-provision-ui.xml"
FIRST_RUN_SIGNED_OUT_TEXT = "Stay signed out"
DEFAULT_BROWSER_CANCEL_TEXT = "Cancel"
CHROMIUM_RELAUNCH_CYCLES = 1
CHROMIUM_RESUMED_CHECK_ATTEMPTS = 60
CHROMIUM_RESUMED_CHECK_RETRY_SECONDS = 0.5
CHROMIUM_SETTLE_SECONDS = 3

# Always use the cuttlefish-bundled adb shipped next to this script.
ADB_BIN = os.path.join(os.path.dirname(os.path.realpath(__file__)), "adb")

def _adb(args, check):
    try:
        return subprocess.run([ADB_BIN] + args, capture_output=True, text=True, check=check)
    except FileNotFoundError:
        print(f"!!! Error: bundled adb not found at '{ADB_BIN}'.")
        sys.exit(1)

def run_adb(args):
    try:
        return _adb(args, check=True).stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"!!! ADB Error: {e.stderr}")
        sys.exit(1)

def run_adb_best_effort(args):
    _adb(args, check=False)

def run_adb_optional(args):
    return _adb(args, check=False)

def poll_until(predicate, attempts, interval_seconds):
    for attempt in range(attempts):
        if predicate():
            return True
        if attempt < attempts - 1:
            time.sleep(interval_seconds)
    return False

def set_chromium_default_browser():
    verify_chromium_installed()
    for package_name in STOCK_BROWSER_PACKAGES:
        run_adb_best_effort(
            [
                "shell",
                "cmd",
                "role",
                "remove-role-holder",
                "--user",
                "0",
                "android.app.role.BROWSER",
                package_name,
                "0",
            ]
        )
    run_adb(
        [
            "shell",
            "cmd",
            "role",
            "add-role-holder",
            "--user",
            "0",
            "android.app.role.BROWSER",
            CHROME_PACKAGE,
            "0",
        ]
    )

def disable_stock_browsers():
    for package_name in STOCK_BROWSER_PACKAGES:
        run_adb_best_effort(["shell", "pm", "disable-user", "--user", "0", package_name])

def verify_chromium_installed():
    result = run_adb_optional(["shell", "pm", "path", CHROME_PACKAGE])
    if result.returncode == 0 and result.stdout.strip():
        return

    print(f"!!! Error: {CHROME_PACKAGE} was not installed by the selected APK.")
    sys.exit(1)

def chromium_installed(wait=False):
    # With wait, retry only while the package service is unavailable; once it
    # answers, "not installed" is final.
    answer = None

    def answered():
        nonlocal answer
        result = run_adb_optional(["shell", "pm", "path", CHROME_PACKAGE])
        if result.returncode == 0 and result.stdout.strip():
            answer = True
        elif "Can't find service" not in result.stderr + result.stdout:
            answer = False
        return answer is not None

    attempts = INSTALLED_CHECK_ATTEMPTS if wait else 1
    poll_until(answered, attempts, INSTALLED_CHECK_RETRY_SECONDS)
    return bool(answer)

def write_chromium_stamp():
    if not CHROMIUM_STAMP:
        return

    stamp_dir = os.path.dirname(CHROMIUM_STAMP)
    if stamp_dir:
        os.makedirs(stamp_dir, exist_ok=True)
    with open(CHROMIUM_STAMP, "w", encoding="utf-8") as stamp_file:
        stamp_file.write(f"{CHROME_PACKAGE}\n")

def is_browser_candidate(apk):
    apk_name = os.path.basename(apk)
    if any(marker in apk_name for marker in EXCLUDED_APK_NAME_MARKERS):
        return False
    return any(marker in apk_name for marker in BROWSER_APK_NAME_MARKERS)

def parse_bounds(bounds):
    match = re.fullmatch(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", bounds or "")
    if not match:
        return None

    left, top, right, bottom = (int(group) for group in match.groups())
    return ((left + right) // 2, (top + bottom) // 2)

def find_ui_text_center(text):
    dump_result = run_adb_optional(["shell", "uiautomator", "dump", "--compressed", UI_DUMP_PATH])
    if dump_result.returncode != 0:
        return None

    xml_result = run_adb_optional(["exec-out", "cat", UI_DUMP_PATH])
    if xml_result.returncode != 0:
        return None

    try:
        root = ET.fromstring(xml_result.stdout)
    except ET.ParseError:
        return None

    for node in root.iter("node"):
        if node.attrib.get("text") == text:
            return parse_bounds(node.attrib.get("bounds"))

    return None

def tap_ui_text(text, timeout_seconds):
    # Always looks at least once, so a timeout of 0 means a single check.
    deadline = time.monotonic() + timeout_seconds
    while True:
        center = find_ui_text_center(text)
        if center:
            x, y = center
            run_adb(["shell", "input", "tap", str(x), str(y)])
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(1)

def launch_chromium():
    run_adb(["shell", "monkey", "-p", CHROME_PACKAGE, "-c", "android.intent.category.LAUNCHER", "1"])

def close_chromium():
    run_adb_best_effort(["shell", "am", "force-stop", CHROME_PACKAGE])

def chromium_resumed():
    result = run_adb_optional(["shell", "dumpsys", "activity", "activities"])
    # The foreground activity is reported as (m|top)ResumedActivity across
    # Android versions; the negative lookbehind skips stale mLastResumedActivity.
    pattern = r"(?<!Last)ResumedActivity[:=].*" + re.escape(CHROME_PACKAGE)
    return result.returncode == 0 and re.search(pattern, result.stdout) is not None

def provision_chromium_first_run():
    close_chromium()
    launch_chromium()

    if tap_ui_text(FIRST_RUN_SIGNED_OUT_TEXT, 20):
        print("Finalizing setup...")
        # Chromium already holds the browser role, so its default-browser
        # prompt rarely appears: check once instead of waiting for it.
        tap_ui_text(DEFAULT_BROWSER_CANCEL_TEXT, 0)
        return

def relaunch_chromium_cycles():
    close_chromium()
    for _ in range(CHROMIUM_RELAUNCH_CYCLES):
        launch_chromium()
        poll_until(chromium_resumed, CHROMIUM_RESUMED_CHECK_ATTEMPTS, CHROMIUM_RESUMED_CHECK_RETRY_SECONDS)
        # Resuming only means it foregrounded; dwell so Chromium actually
        # writes its first-run state before we stop it.
        time.sleep(CHROMIUM_SETTLE_SECONDS)
        close_chromium()

def sync_device_storage():
    run_adb(["shell", "sync"])

def chromium_snapshot_prefix_for_abi(abi):
    if "arm64" in abi:
        return "AndroidDesktop_arm64"
    if "x86_64" in abi:
        return "AndroidDesktop_x64"
    return None

def detect_prefix():
    abi = ""
    last_error = ""
    prefix = None

    for attempt in range(ARCH_DETECT_ATTEMPTS):
        result = run_adb_optional(["shell", "getprop", "ro.product.cpu.abi"])
        if result.returncode == 0:
            abi = result.stdout.strip()
            prefix = chromium_snapshot_prefix_for_abi(abi)
            if prefix:
                break
        else:
            last_error = result.stderr.strip() or result.stdout.strip()

        if attempt < ARCH_DETECT_ATTEMPTS - 1:
            time.sleep(ARCH_DETECT_RETRY_SECONDS)

    if not prefix:
        print(f"!!! Error: Could not detect supported device architecture after {ARCH_DETECT_ATTEMPTS} attempts.")
        if abi:
            print(f"Last ABI: {abi}")
        elif last_error:
            print(f"Last error: {last_error}")
        sys.exit(1)

    return prefix

def fetch_latest_revision(prefix):
    r = requests.get(f"{STORAGE_URL}/{prefix}/LAST_CHANGE")
    r.raise_for_status()
    revision = r.text.strip()

    return revision

def has_hardware_vulkan_device():
    # Probe without a display so SSH launches with a stale DISPLAY still work.
    env = {k: v for k, v in os.environ.items() if k not in ("DISPLAY", "WAYLAND_DISPLAY")}
    try:
        summary = subprocess.run(
            ["vulkaninfo", "--summary"],
            capture_output=True,
            text=True,
            env=env,
            timeout=VULKANINFO_TIMEOUT_SECONDS,
        ).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False

    if not summary.strip():
        return False

    # Only the first device (GPU0, "GPUn:" plus indented properties) decides.
    first_device = re.search(r"^GPU\d+:\n(?:[ \t].*\n?)*", summary, flags=re.MULTILINE)
    return not LLVMPIPE_DRIVER_RE.search(first_device.group(0) if first_device else summary)

def apply_chromium_gpu_flags():
    if has_hardware_vulkan_device():
        return

    print("No hardware Vulkan device found; disabling Chromium's Vulkan-only GPU path.")
    for path in CHROME_COMMAND_LINE_FILES:
        run_adb_best_effort(
            ["shell", f"echo '{NO_HARDWARE_VULKAN_CHROMIUM_FLAGS}' > {path} && chmod 644 {path}"]
        )

class HttpRangeReader(io.RawIOBase):
    """Seekable read-only view of a remote file, fetched with HTTP Range requests.

    Sequential reads share one streaming response, so reading a zip member is a
    single download of just that member's bytes.
    """

    def __init__(self, url):
        self._url = url
        self._session = requests.Session()
        response = self._session.head(url, allow_redirects=True)
        response.raise_for_status()
        if response.headers.get("accept-ranges") != "bytes":
            raise RuntimeError(f"{url} does not support range requests")
        self._size = int(response.headers["content-length"])
        self._pos = 0
        self._response = None
        self._chunks = None
        self._buffer = b""
        self._stream_pos = None

    def readable(self):
        return True

    def seekable(self):
        return True

    def tell(self):
        return self._pos

    def seek(self, offset, whence=io.SEEK_SET):
        if whence == io.SEEK_SET:
            self._pos = offset
        elif whence == io.SEEK_CUR:
            self._pos += offset
        elif whence == io.SEEK_END:
            self._pos = self._size + offset
        else:
            raise ValueError(f"invalid whence {whence}")
        return self._pos

    def _close_stream(self):
        if self._response is not None:
            self._response.close()
        self._response = None
        self._chunks = None
        self._buffer = b""
        self._stream_pos = None

    def readinto(self, buffer):
        if self._pos >= self._size:
            return 0
        if self._stream_pos != self._pos:
            self._close_stream()
            self._response = self._session.get(
                self._url,
                headers={"Range": f"bytes={self._pos}-"},
                stream=True,
            )
            self._response.raise_for_status()
            self._chunks = self._response.iter_content(chunk_size=DOWNLOAD_CHUNK_BYTES)
            self._stream_pos = self._pos
        while not self._buffer:
            self._buffer = next(self._chunks, b"")
            if not self._buffer:
                self._close_stream()
                return 0
        count = min(len(buffer), len(self._buffer))
        buffer[:count] = self._buffer[:count]
        self._buffer = self._buffer[count:]
        self._pos += count
        self._stream_pos = self._pos
        return count

    def close(self):
        self._close_stream()
        self._session.close()
        super().close()

def select_browser_apk(names):
    apks = [name for name in names if name.endswith(".apk")]
    # ContentShell is an APK, but it is not a browser role candidate.
    candidates = [apk for apk in apks if is_browser_candidate(apk)]
    # Prefer the unbranded APK, which avoids ChromePublic's Google account
    # first-run path when the snapshot includes both APKs.
    for preferred_apk in BROWSER_APK_PRIORITY:
        for apk in candidates:
            if os.path.basename(apk) == preferred_apk:
                return apk
    if candidates:
        return candidates[0]
    print("!!! Error: Could not find the correct browser APK in the package.")
    print(f"Found files: {apks}")
    sys.exit(1)

def cached_apk_path(prefix, revision, member):
    return os.path.join(
        DOWNLOAD_CACHE_DIR, f"{prefix}-{revision}-{os.path.basename(member)}"
    )

def cache_revision(path):
    revision = os.path.basename(path).split("-")[1].split(".")[0]
    return int(revision) if revision.isdigit() else -1

def find_cached_apk(prefix):
    # Reuse an existing APK for this arch, preferring the newest revision on
    # disk; an older cached revision is fine and avoids a download. An APK only
    # gets its final name once it is complete and its CRC checked.
    cached = glob.glob(os.path.join(DOWNLOAD_CACHE_DIR, f"{prefix}-*-*.apk"))
    for apk_path in sorted(cached, key=cache_revision, reverse=True):
        if zipfile.is_zipfile(apk_path):
            return apk_path
    return None

def find_cached_zip(prefix):
    # A whole snapshot zip downloaded by an earlier version.
    cached = glob.glob(os.path.join(DOWNLOAD_CACHE_DIR, f"{prefix}-*.zip"))
    for zip_path in sorted(cached, key=cache_revision, reverse=True):
        if zipfile.is_zipfile(zip_path):
            return zip_path
    return None

def copy_with_progress(source, apk_path, total_bytes):
    partial_apk = f"{apk_path}.part"
    next_progress_percent = DOWNLOAD_PROGRESS_DOT_PERCENT
    copied_bytes = 0
    with open(partial_apk, "wb") as output:
        while chunk := source.read(DOWNLOAD_CHUNK_BYTES):
            output.write(chunk)
            copied_bytes += len(chunk)
            progress_percent = copied_bytes * 100 // max(total_bytes, 1)
            while progress_percent >= next_progress_percent:
                sys.stdout.write(".")
                sys.stdout.flush()
                next_progress_percent += DOWNLOAD_PROGRESS_DOT_PERCENT
    # Reading the member to its end checks its CRC, so a complete file is good.
    os.replace(partial_apk, apk_path)

def extract_browser_apk(snapshot_zip, prefix, revision):
    member = select_browser_apk(snapshot_zip.namelist())
    apk_path = cached_apk_path(prefix, revision, member)
    with snapshot_zip.open(member) as source:
        copy_with_progress(source, apk_path, snapshot_zip.getinfo(member).file_size)
    print(f" {apk_path}")
    return apk_path

def download_browser_apk(prefix, revision):
    # Fetch only the browser APK out of the snapshot zip: the zip also carries
    # WebView and ContentShell, more than half of its size.
    download_url = f"{STORAGE_URL}/{prefix}/{revision}/chrome-android-desktop.zip"
    sys.stdout.write("Downloading Chromium for Android desktop")
    sys.stdout.flush()
    with HttpRangeReader(download_url) as remote:
        reader = io.BufferedReader(remote, buffer_size=DOWNLOAD_CHUNK_BYTES)
        with zipfile.ZipFile(reader) as snapshot_zip:
            return extract_browser_apk(snapshot_zip, prefix, revision)

def apk_from_cached_zip(zip_path, prefix):
    sys.stdout.write("Extracting Chromium from the cached download")
    sys.stdout.flush()
    with zipfile.ZipFile(zip_path) as snapshot_zip:
        return extract_browser_apk(snapshot_zip, prefix, cache_revision(zip_path))

def prune_cache(prefix, keep_path):
    for path in glob.glob(os.path.join(DOWNLOAD_CACHE_DIR, f"{prefix}-*")):
        if path != keep_path:
            os.remove(path)

def browser_apk(prefix):
    os.makedirs(DOWNLOAD_CACHE_DIR, exist_ok=True)
    apk_path = find_cached_apk(prefix)
    if not apk_path:
        zip_path = find_cached_zip(prefix)
        if zip_path:
            apk_path = apk_from_cached_zip(zip_path, prefix)
        else:
            apk_path = download_browser_apk(prefix, fetch_latest_revision(prefix))
    prune_cache(prefix, apk_path)
    return apk_path

def main():
    try:
        if chromium_installed(wait=True):
            apply_chromium_gpu_flags()
            write_chromium_stamp()
            return

        target_apk = browser_apk(detect_prefix())

        # -r: replace, -d: allow downgrade, -g: grant all permissions
        install_output = run_adb(["install", "-r", "-d", "-g", target_apk])
        install_lines = install_output.splitlines()
        if not (install_lines and install_lines[-1] == "Success"):
            if install_output:
                print(install_output)
        verify_chromium_installed()
        write_chromium_stamp()
        set_chromium_default_browser()
        disable_stock_browsers()
        apply_chromium_gpu_flags()
        provision_chromium_first_run()
        relaunch_chromium_cycles()
        sync_device_storage()

    except Exception as e:
        print(f"\n!!! An unexpected error occurred: {e}")
        return 1

if __name__ == "__main__":
    sys.exit(main())
