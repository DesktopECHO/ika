#!/usr/bin/python3
# Installs Chromium for Android desktop in the guest, as its default browser,
# and writes its command-line flags. The APK comes from Chromium's snapshot
# storage and is kept on disk, so a factory reset reinstalls it.
import io
import os
import subprocess
import sys
import time
import zipfile

import requests

STORAGE_URL = "https://commondatastorage.googleapis.com/chromium-browser-snapshots"
CHROMIUM_APK = os.environ.get("IKA_CHROMIUM_APK") or os.path.expanduser("~/ika/apps/Chromium.apk")
CHROME_PACKAGE = "org.chromium.chrome"
# The snapshot's browser APKs, best first: the unbranded one avoids
# ChromePublic's Google account first-run path.
BROWSER_APKS = ("Chromium.apk", "ChromePublic.apk", "MonochromePublic.apk")
# On a user build, Chromium reads it as the debug app
CHROME_COMMAND_LINE_FILE = "/data/local/tmp/chrome-command-line"
# Skips Chromium's first-run screens.
CHROMIUM_FLAGS = "_ --disable-fre"
# Without hardware Vulkan (IKA_HARDWARE_VULKAN=0, from ika's own vulkaninfo
# probe), Android-desktop Chromium has no OpenGL fallback unless
# SkipVulkanBlocklist is off, and its GPU process aborts at startup.
NO_HARDWARE_VULKAN_CHROMIUM_FLAGS = (
    " --disable-features=SkipVulkanBlocklist,DefaultANGLEVulkan,VulkanFromANGLE,SkiaGraphite"
)
CHUNK_BYTES = 1024 * 1024

# Always use the cuttlefish-bundled adb shipped next to this script.
ADB_BIN = os.path.join(os.path.dirname(os.path.realpath(__file__)), "adb")


def adb(*args, check=False):
    result = subprocess.run([ADB_BIN, *args], capture_output=True, text=True)
    if check and result.returncode != 0:
        sys.exit(f"!!! ADB Error: {result.stderr.strip()}")
    return result


def chromium_installed():
    # Retry only while the package service is not up yet; once it answers,
    # "not installed" is final.
    for _ in range(10):
        result = adb("shell", "pm", "path", CHROME_PACKAGE)
        if result.returncode == 0 and result.stdout.strip():
            return True
        if "Can't find service" not in result.stderr + result.stdout:
            return False
        time.sleep(0.5)
    return False


def write_chromium_flags():
    flags = CHROMIUM_FLAGS
    if os.environ.get("IKA_HARDWARE_VULKAN") == "0":
        print("No hardware Vulkan device found; disabling Chromium's Vulkan-only GPU path.")
        flags += NO_HARDWARE_VULKAN_CHROMIUM_FLAGS
    path = CHROME_COMMAND_LINE_FILE
    adb("shell", f"echo '{flags}' > {path} && chmod 644 {path}", check=True)
    adb("shell", "am", "set-debug-app", "--persistent", CHROME_PACKAGE, check=True)


class HttpRangeReader(io.RawIOBase):
    """Seekable read-only view of a remote file, fetched with HTTP Range requests.

    Sequential reads share one streaming response, so reading a zip member is a
    single download of just that member's bytes.
    """

    def __init__(self, url):
        self._url = url
        self._session = requests.Session()
        response = self._session.head(url, allow_redirects=True)
        response.raise_for_status()
        if response.headers.get("accept-ranges") != "bytes":
            raise RuntimeError(f"{url} does not support range requests")
        self._size = int(response.headers["content-length"])
        self._pos = 0
        self._response = None
        self._buffer = b""

    def readable(self):
        return True

    def seekable(self):
        return True

    def tell(self):
        return self._pos

    def seek(self, offset, whence=io.SEEK_SET):
        base = {io.SEEK_SET: 0, io.SEEK_CUR: self._pos, io.SEEK_END: self._size}[whence]
        if base + offset != self._pos:
            # A new position needs a new request
            self._close_stream()
        self._pos = base + offset
        return self._pos

    def _close_stream(self):
        if self._response is not None:
            self._response.close()
        self._response = None
        self._buffer = b""

    def readinto(self, buffer):
        if self._pos >= self._size:
            return 0
        if self._response is None:
            self._response = self._session.get(
                self._url, headers={"Range": f"bytes={self._pos}-"}, stream=True)
            self._response.raise_for_status()
            self._chunks = self._response.iter_content(chunk_size=CHUNK_BYTES)
        while not self._buffer:
            self._buffer = next(self._chunks, None)
            if self._buffer is None:
                self._close_stream()
                return 0
        count = min(len(buffer), len(self._buffer))
        buffer[:count] = self._buffer[:count]
        self._buffer = self._buffer[count:]
        self._pos += count
        return count

    def close(self):
        self._close_stream()
        self._session.close()
        super().close()


def download_browser_apk():
    abi = adb("shell", "getprop", "ro.product.cpu.abi", check=True).stdout.strip()
    if "arm64" in abi:
        prefix = "AndroidDesktop_arm64"
    elif "x86_64" in abi:
        prefix = "AndroidDesktop_x64"
    else:
        sys.exit(f"!!! Error: unsupported device architecture '{abi}'.")
    revision = requests.get(f"{STORAGE_URL}/{prefix}/LAST_CHANGE")
    revision.raise_for_status()

    # Fetch only the browser APK out of the snapshot zip: the zip also carries
    # WebView and ContentShell, more than half of its size.
    url = f"{STORAGE_URL}/{prefix}/{revision.text.strip()}/chrome-android-desktop.zip"
    sys.stdout.write("Downloading Chromium for Android desktop")
    sys.stdout.flush()
    with zipfile.ZipFile(io.BufferedReader(HttpRangeReader(url), CHUNK_BYTES)) as snapshot:
        names = {os.path.basename(name): name for name in snapshot.namelist()}
        member = next((names[apk] for apk in BROWSER_APKS if apk in names), None)
        if member is None:
            sys.exit(f"!!! Error: no browser APK in the snapshot: {sorted(names)}")
        # The APK only gets its final name once it is complete: reading the
        # member to its end checks its CRC.
        os.makedirs(os.path.dirname(CHROMIUM_APK), exist_ok=True)
        size, done, dots = snapshot.getinfo(member).file_size, 0, 0
        with snapshot.open(member) as source, open(f"{CHROMIUM_APK}.part", "wb") as output:
            while chunk := source.read(CHUNK_BYTES):
                output.write(chunk)
                done += len(chunk)
                # A dot every 20%
                while dots < done * 5 // max(size, 1):
                    dots += 1
                    sys.stdout.write(".")
                    sys.stdout.flush()
        os.replace(f"{CHROMIUM_APK}.part", CHROMIUM_APK)
    print(" OK")


# Errors exit with a status other than 0 (an exception with its traceback),
# which ika reports, and it runs getchromium again on the next start
def main():
    if not chromium_installed():
        if not zipfile.is_zipfile(CHROMIUM_APK):
            download_browser_apk()
        # -r: replace, -d: allow downgrade, -g: grant all permissions
        adb("install", "-r", "-d", "-g", CHROMIUM_APK, check=True)
        # Chromium is the browser (the ROM has no other; Jelly is left out),
        # and this fails if it is not installed
        adb("shell", "cmd", "role", "add-role-holder", "--user", "0",
            "android.app.role.BROWSER", CHROME_PACKAGE, "0", check=True)
    write_chromium_flags()


if __name__ == "__main__":
    sys.exit(main())
